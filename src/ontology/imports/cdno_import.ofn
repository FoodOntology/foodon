# Class: obo:CHEBI_190521 (napin)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_190521 "A group of small molecular weight albumins (15-17 kDa) that are one of the two major kinds of storage proteins synthesized in the seeds of mustard and rapeseed during its maturation. Its heterodimer structure is composed of two polypeptide chains that are held together by disulfide bonds. The proteins are soluble in a wide pH range and show high heat stability.")
AnnotationAssertion(obo:IAO_0000412 obo:CHEBI_190521 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CHEBI_190521 "napin")
AnnotationAssertion(rdfs:label obo:CHEBI_190521 "napin"^^xsd:string)
SubClassOf(obo:CHEBI_190521 obo:CDNO_0000009)

# Class: obo:CHEBI_190522 (gliadin)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_190522 "A prolamin present in wheat and several other cereals within the grass genus Triticum. It is made up of single-chain polypeptides with an average molecular weight of 25-100 kDa linked by intramolecular disulfide bonds and classified based on its primary amino acid sequence into the alpha/beta-, gamma- and omega-type.")
AnnotationAssertion(obo:IAO_0000412 obo:CHEBI_190522 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CHEBI_190522 "gliadin")
AnnotationAssertion(rdfs:label obo:CHEBI_190522 "gliadin"^^xsd:string)
SubClassOf(obo:CHEBI_190522 obo:CHEBI_36080)

# Class: obo:CHEBI_192499 (anthoxanthin)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_192499 "are a type of flavonoid pigments in plants. Anthoxanthins are water-soluble pigments which range in color from white or colorless to a creamy to yellow, often on petals of flowers.")
AnnotationAssertion(obo:IAO_0000412 obo:CHEBI_192499 obo:cdno.owl)
