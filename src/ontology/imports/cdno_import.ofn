AnnotationAssertion(rdfs:label obo:CHEBI_75632 "procyanidin B2"^^xsd:string)
SubClassOf(obo:CHEBI_75632 obo:CHEBI_166895)

# Class: obo:CHEBI_75633 (procyanidin B1)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_75633 "A proanthocyanidin consisting of (-)-epicatechin and (+)-catechin units joined by a bond between positions 4 and 8' respectively  in a beta-configuration.. Procyanidin B1 can be found in Cinnamomum verum (Ceylon cinnamon, in the rind, bark or cortex), in Uncaria guianensis (cat's claw, in the root), and in Vitis vinifera (common grape vine, in the leaf) or in peach.")
