############################
#   Annotation Properties
############################

# Annotation Property: obo:IAO_0000115 (definition)

AnnotationAssertion(obo:IAO_0000114 obo:IAO_0000115 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000115 "The official definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions."@en)
AnnotationAssertion(obo:IAO_0000119 obo:IAO_0000115 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en)
AnnotationAssertion(rdfs:label obo:IAO_0000115 "definition")
AnnotationAssertion(rdfs:label obo:IAO_0000115 "definition"@en)

# Annotation Property: obo:IAO_0000412 (imported from)

AnnotationAssertion(rdfs:label obo:IAO_0000412 "imported from"@en)

# Annotation Property: obo:IAO_0100001 (term replaced by)

AnnotationAssertion(obo:IAO_0000114 obo:IAO_0100001 obo:IAO_0000125)
AnnotationAssertion(obo:IAO_0000115 obo:IAO_0100001 "Use on obsolete terms, relating the term to another term that can be used as a substitute"@en)
AnnotationAssertion(obo:IAO_0000119 obo:IAO_0100001 "Person:Alan Ruttenberg"@en)
AnnotationAssertion(rdfs:label obo:IAO_0100001 "term replaced by")
AnnotationAssertion(rdfs:label obo:IAO_0100001 "term replaced by"@en)



############################
#   Classes
############################

# Class: obo:BFO_0000023 (role)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000023 "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en)
AnnotationAssertion(obo:IAO_0000412 obo:BFO_0000023 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000023 "role"@en)

# Class: obo:BFO_0000040 (material entity)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000040 "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en)
AnnotationAssertion(obo:IAO_0000412 obo:BFO_0000040 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000040 "material entity"@en)

# Class: obo:CDNO_0000001 (dietary chemical component)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000001 "A material entity that is ingested and contributes to survival, growth and development"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000001 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000001 "dietary chemical component"^^xsd:string)
SubClassOf(obo:CDNO_0000001 obo:BFO_0000040)

# Class: obo:CDNO_0000002 (dry plant matter)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000002 "Material which remains after the removal of water from plant matter."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000002 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000002 "dry plant matter"^^xsd:string)
SubClassOf(obo:CDNO_0000002 obo:CDNO_0000001)

# Class: obo:CDNO_0000003 (available carbohydrate)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000003 "Carbohydrates that are absorbed in the small intestine and provide carbohydrate for metabolism in monogastric animals."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000003 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000003 "available carbohydrate"^^xsd:string)
SubClassOf(obo:CDNO_0000003 obo:CHEBI_16646)

# Class: obo:CDNO_0000004 (free sugar)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000004 "Available carbohydrate in monosaccharide and disaccharide form"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000004 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000004 "free sugar"^^xsd:string)
SubClassOf(obo:CDNO_0000004 obo:CDNO_0000003)

# Class: obo:CDNO_0000005 (dietary fibre)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000005 "A carbohydrate or associated lignin that resists hydrolytic digestion in the small intestine of humans and other monogastric species, with fermentative digestion in the large intestine"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000005 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000005 "dietary fibre"^^xsd:string)
SubClassOf(obo:CDNO_0000005 obo:CDNO_0000001)

# Class: obo:CDNO_0000006 (soluble dietary fibre)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000006 "Dietary fibre which dissolves in water and is partially or completely fermented in the colon of monogastric animals by gut bacteria."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000006 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000006 "soluble dietary fibre"^^xsd:string)
SubClassOf(obo:CDNO_0000006 obo:CDNO_0000005)
SubClassOf(obo:CDNO_0000006 obo:CHEBI_16646)

# Class: obo:CDNO_0000007 (resistant starch)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000007 "A portion of starch that cannot be digested by amylases in the small intestine"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000007 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000007 "resistant starch"^^xsd:string)
SubClassOf(obo:CDNO_0000007 obo:CDNO_0000006)

# Class: obo:CDNO_0000008 (insoluble dietary fibre)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000008 "Dietary fibre which does not dissolve in water and is inert to digestive enzymes in the upper gastrointestinal tract of monogastric animals, with variable fermentability in the large bowel."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000008 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000008 "insoluble dietary fibre"^^xsd:string)
SubClassOf(obo:CDNO_0000008 obo:CDNO_0000005)

# Class: obo:CDNO_0000009 (seed storage protein)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000009 "A protein that accumulates in developing seeds or grains."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000009 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000009 "seed storage protein"^^xsd:string)
SubClassOf(obo:CDNO_0000009 obo:CHEBI_36080)

# Class: obo:CDNO_0000011 (macro element)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000011 "A mineral nutrient that represents a major proportion of the minerals required in the diet"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000011 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000011 "macro element"^^xsd:string)
SubClassOf(obo:CDNO_0000011 obo:CHEBI_167164)

# Class: obo:CDNO_0000012 (trace element)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000012 "Mineral nutrient that is present in a very low concentration within the diet"@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000012 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000012 "trace element"^^xsd:string)
SubClassOf(obo:CDNO_0000012 obo:CHEBI_167164)

# Class: obo:CDNO_0000013 (plant secondary metabolite)

AnnotationAssertion(obo:IAO_0000115 obo:CDNO_0000013 "A plant metabolite that is not essential for growth or division of plant cells."@en)
AnnotationAssertion(obo:IAO_0000412 obo:CDNO_0000013 obo:cdno.owl)
AnnotationAssertion(rdfs:label obo:CDNO_0000013 "plant secondary metabolite"^^xsd:string)
