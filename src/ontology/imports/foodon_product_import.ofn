AnnotationAssertion(dcterms:contributor obo:FOODON_03307365 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03307365 siren:F7365)
AnnotationAssertion(rdfs:comment obo:FOODON_03307365 "SIREN DB annotation:
* liquid, low viscosity, with no visible particles FOODON:03430123
* fruit, peel present, core, pit or seed present FOODON:03420140
* alcohol-acetic acid fermentation process FOODON:03460123
* curing or aging process FOODON:03460253
* preservation by heat treatment FOODON:03470120"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03307365 "grape vinegar"@en)
