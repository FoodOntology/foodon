# Class: obo:FOODON_00002489 (fowl food product)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002489 "Fowl are birds belonging to one of two biological orders, namely the gamefowl or landfowl (Galliformes) and the waterfowl (Anseriformes). Studies of anatomical and molecular similarities suggest these two groups are close evolutionary relatives; together, they form the fowl clade which is scientifically known as Galloanserae (initially termed Galloanseri)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002489 "https://en.wikipedia.org/wiki/Fowl"^^xsd:anyURI)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002489 "Anseriformes"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002489 "Galliformes"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002489 "gamefowl"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002489 "landfowl"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002489 "waterfowl"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_00002489 "Galloanserae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002489 "fowl food product"@en)
SubClassOf(obo:FOODON_00002489 obo:FOODON_00001251)

