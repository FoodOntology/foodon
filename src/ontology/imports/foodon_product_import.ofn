AnnotationAssertion(schema:image obo:FOODON_03316078 <https://upload.wikimedia.org/wikipedia/commons/2/29/Ben_W_Bell_Soda_Bread_Farl_05_June_2007.jpg>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03316078 siren:F16078)
AnnotationAssertion(rdfs:comment obo:FOODON_03316078 "SIREN DB annotation:
* whole, shape achieved by forming FOODON:03430147
* fully heat-treated FOODON:03440014
* seed (anatomical part) FOODON:03420155
* ingredient: ingredient added (TO BE REVISED) FOODON:03460225
* ingredient: chemical leavening agent added FOODON:03460351"@en)
