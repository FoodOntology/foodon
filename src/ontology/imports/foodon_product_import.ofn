AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03411361 "lima beans and corn"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411361 "langual:B1361")
AnnotationAssertion(rdfs:label obo:FOODON_03411361 "succotash"@en)
SubClassOf(obo:FOODON_03411361 obo:FOODON_03316579)

