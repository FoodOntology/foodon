# Class: obo:FOODON_00001332 (rice powder (roasted))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001332 "A rice powder derived from toasted rice."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00001332 "Toasted-rice powder is a common pantry ingredient in Northern Thai and Lao cuisines, made by slowly toasting raw sticky rice to a deep golden brown, then grinding it into a coarse powder using a mortar and pestle or spice grinder. [https://www.seriouseats.com/recipes/2019/05/toasted-rice-powder-recipe.html]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001332 "rice powder (roasted)"@en)
