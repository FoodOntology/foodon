# Class: obo:FOODON_00002484 (harissa chili paste)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002484 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002484 "Harissa (Arabic: هريسة‎ harīsa, from Maghrebi Arabic) is a Maghrebi hot chili pepper paste, the main ingredients of which are roasted red peppers, Baklouti (بقلوطي) pepper, serrano peppers, and other hot chili peppers, spices and herbs such as garlic paste, coriander seed, saffron, rose, or caraway, as well as some vegetable or olive oil for preservation"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002484 "https://en.wikipedia.org/wiki/Harissa"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002484 "Damion Dooley"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002484 "harissa chili paste"@en)
SubClassOf(obo:FOODON_00002484 obo:FOODON_00001956)

