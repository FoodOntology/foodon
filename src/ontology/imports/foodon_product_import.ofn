AnnotationAssertion(rdfs:label obo:FOODON_03460755 "wheat malt"@en)
SubClassOf(obo:FOODON_03460755 obo:FOODON_00001141)

# Class: obo:FOODON_03460848 (guarana seed)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460848 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460848 "Guarana seed is the seed of a guarana plant.  Used as a dietary supplement or herb, it is an effective stimulant: it contains about twice the concentration of caffeine found in coffee seeds (about 2–4.5% caffeine in guarana seeds, compared to 1–2% for coffee seeds)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03460848 "https://en.wikipedia.org/wiki/Guarana"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_03460848 "Damion Dooley")
