SubClassOf(obo:FOODON_00002935 obo:FOODON_00002477)

# Class: obo:FOODON_00002936 (asafoetida)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002936 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002936 "Asafoetida is the dried latex (gum oleoresin) (Perumkayam) exuded from the rhizome or tap root of several species of Ferula (F. foetida and F. assa-foetida), perennial herbs growing 1 to 1.5 m (3.3 to 4.9 ft) tall. They are part of the celery family, Umbelliferae. The species are native to the deserts of Iran and mountains of Afghanistan, but are mainly cultivated in nearby Pakistan and India. Asafoetida has a pungent smell, lending it the trivial name of stinking gum, but in cooked dishes it delivers a smooth flavour reminiscent of leeks or other onion relatives."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002936 wikipedia:Asafoetida)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002936 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002936 "Emma Griffiths"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00002936 "2019-08-10T15:50:03Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "hengu"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "hing"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "inguva"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "jowani badian"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "kayam"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002936 "ting"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002936 "asafoetida"@en)
SubClassOf(obo:FOODON_00002936 obo:FOODON_03303380)
SubClassOf(obo:FOODON_00002936 obo:FOODON_03315655)
SubClassOf(obo:FOODON_00002936 ObjectSomeValuesFrom(obo:RO_0001000 obo:NCBITaxon_52471))

