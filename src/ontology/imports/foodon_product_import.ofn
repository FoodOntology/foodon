# Class: obo:FOODON_03307069 (rock cornish game bird (raw))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03307069 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03307069 "In the United States, a Cornish game hen, also sometimes called a Cornish hen, poussin, Rock Cornish hen, or simply Rock Cornish, is a hybrid chicken sold whole. Despite the name, it is not a game bird. Rather, it is a broiler chicken, the most common strain of commercially raised meat chickens. Though the bird is called a \"hen\", it can be either male or female. [https://en.wikipedia.org/wiki/Cornish_game_hen]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03307069 siren:F7069)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307069 "cornish game hen"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307069 "cornish hen"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307069 "poussin"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307069 "rock cornish"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307069 "rock cornish hen"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03307069 "rock cornish game bird (raw)"@en)
