# Class: obo:FOODON_03307033 (idaho potato (raw))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03307033 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03307033 "A raw potato certified by “Idaho® potato” and the “Grown in Idaho®” identifiers which are federally registered Certification Marks that belong to the Idaho Potato Commission (IPC). These Marks ensure that consumers are purchasing potatoes that have been grown in the state of Idaho.  The Certification mark pertains to over 25 potato varieties grown in Idaho, including the russet potato."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03307033 "https://idahopotato.com/dr-potato/the-difference-between-idaho-potatoes-and-russet"^^xsd:anyURI)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03307033 siren:F7033)
AnnotationAssertion(rdfs:comment obo:FOODON_03307033 "SIREN DB annotation:
* whole, natural shape FOODON:03430150
* not heat-treated FOODON:03440003
* root, tuber or bulb, with peel FOODON:03420239"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03307033 "idaho potato (raw)"@en)
SubClassOf(obo:FOODON_03307033 obo:FOODON_03301449)

