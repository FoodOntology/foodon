# Class: obo:FOODON_03307020 (poppadum)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03307020 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03307020 "Papadum is an Indian and Sri Lankan flatbread. Typically, it is prepared using black gram bean flour, rice flour, or lentil flour with salt and peanut oil added. The ingredients are made into a dough and formed into a thin, round shape similar to a tortilla. As the dough is prepared, the papadum can be seasoned with a variety of different ingredients such as chilies, cumin, garlic, black pepper, or other spices."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03307020 "https://en.wikibooks.org/wiki/Cookbook:Papadum"^^xsd:anyURI)
AnnotationAssertion(schema:image obo:FOODON_03307020 <https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Stack_of_papadums.jpg/640px-Stack_of_papadums.jpg>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03307020 siren:F7020)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "appadam"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "appalam"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "happala"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "pampad"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "papad"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "papadam"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "papadum"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "papar"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "pappadam"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "popadom"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "poppadom"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "puppodum"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "udad papad"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307020 "urad papad"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03307020 "SIREN DB annotation:
* whole, shape achieved by forming, thickness 0.3-1.5 cm. FOODON:03430140
