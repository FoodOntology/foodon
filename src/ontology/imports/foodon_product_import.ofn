# Class: obo:FOODON_00002575 (Arborio rice)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002575 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002575 "An Italian short-grain rice."@en)
