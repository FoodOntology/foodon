# Class: obo:FOODON_03304758 (tamale)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03304758 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03304758 "A traditional Mesoamerican dish, probably from modern-day Mexico, made of masa or dough (starchy, and usually corn-based), which is steamed in a corn husk or banana leaf. The wrapping can either be discarded prior to eating, or be used as a plate, the tamale eaten from within. Tamales can be filled with meats, cheeses, fruits, vegetables, chilies or any preparation according to taste, and both the filling and the cooking liquid may be seasoned."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03304758 wikipedia:Tamale)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03304758 siren:F4758)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03304758 "tamal"@es)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03304758 "tamalli"@nah)
AnnotationAssertion(rdfs:label obo:FOODON_03304758 "tamale"@en)
SubClassOf(obo:FOODON_03304758 obo:FOODON_00003395)
SubClassOf(obo:FOODON_03304758 ObjectSomeValuesFrom(obo:FOODON_00002420 ObjectUnionOf(obo:FOODON_00002529 obo:FOODON_03302500)))
