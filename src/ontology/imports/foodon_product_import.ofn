# Class: obo:FOODON_00001201 (dry bean food product)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001201 "A dry bean food product refers to a bean product made from a Phaseolus species plant whose seeds are harvested at complete maturity."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001201 "https://en.wikipedia.org/wiki/Phaseolus_vulgaris"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001201 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00001201 "kidney, haricot bean (Ph. vulgaris); 
lima, butter bean (Ph. lunatus); 
adzuki bean (Ph. angularis); 
mungo bean, golden, green gram (Ph. aureus); 
black gram, urd (Ph. mungo); 
scarlet runner bean (Ph. coccineus); 
rice bean (Ph. calcaratus); 
moth bean (Ph. aconitifolius); 
tepary bean (Ph. acutifolius)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00001201 "FAO notes: \"Only species of Phaseolus should be included, though several countries also include certain types of beans. Commonly classified as Vigna (angularis, mungo, radiata, aconitifolia). In the past, these species were also classified as Phaseolus.\""@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001201 "dry bean food product"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00001201 "http://www.fao.org/WAICENT/faoinfo/economic/faodef/fdef04e.htm#4.02"^^xsd:anyURI)
SubClassOf(obo:FOODON_00001201 obo:FOODON_00001209)
SubClassOf(obo:FOODON_00001201 obo:FOODON_00001757)
SubClassOf(obo:FOODON_00001201 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_03411061))

