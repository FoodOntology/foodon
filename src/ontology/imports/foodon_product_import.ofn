# Class: obo:FOODON_03303119 (cellulose sausage casing (edible))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03303119 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03303119 "Cellulose sausage casings include those made from cotton bags and those derived from processed cotton linters. The cloth bags give a high degree of uniformity to the encased sausage product. Cotton linters are a fine fuzz-like material that is removed from cottonseed after the cotton fiber and seed have been separated at the cotton gin."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03303119 <https://www.smokingmeatforums.com/ams/sausage-casing-information.9727/>)
AnnotationAssertion(dcterms:contributor obo:FOODON_03303119 "Damion Dooley")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03303119 siren:F3119)
AnnotationAssertion(rdfs:comment obo:FOODON_03303119 "SIREN DB annotation:
* whole, shape achieved by forming, thickness <0.3 cm. FOODON:03430153
* fully heat-treated FOODON:03440014
* cellulose FOODON:03420220
* demineralizing process FOODON:03460137
* acidified FOODON:03460200
* food alkalization process FOODON:03460206"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03303119 "cellulose sausage casing (edible)"@en)
SubClassOf(obo:FOODON_03303119 obo:FOODON_00001767)

