# Class: obo:FOODON_03411224 (oyster)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411224 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411224 "Oyster is the common name for a number of different families of salt-water bivalve molluscs that live in marine or brackish habitats. In some species the valves are highly calcified, and many are somewhat irregular in shape. 
True oysters are members of the family *Ostreidae*. This family includes the edible oysters, which mainly belong to the genera *Ostrea, Crassostrea, Ostreola, Magallana, Saccostrea*.  Pearl oysters are not closely related to true oysters, being members of a distinct family, the feathered oysters (*Pteriidae*)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411224 "https://en.wikipedia.org/wiki/Oyster"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_03411224 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411224 "eolife:2267")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411224 "langual:B1224")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411224 "ostreidae"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411224 "crassostrea spp."@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411224 "ostrea spp."@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411224 "pteriidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411224 "oyster"@en)

# Class: obo:FOODON_03411242 (turtle)

AnnotationAssertion(obo:IAO_0000600 obo:FOODON_03411242 "Turtles are reptiles of the order *Testudines* (the crown group of the superorder *Chelonia*), characterised by a special bony or cartilaginous shell developed from their ribs that acts as a shield.Species of the zoological order *Chelonia*."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411242 "chelonia"@en)
