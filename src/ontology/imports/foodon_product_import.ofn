AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "Japan Earth"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "Uncaria gambir"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "gambier extract"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "gambir extract"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "pale catechu"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002913 "white catechu"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002913 "gambier powder"@en)
