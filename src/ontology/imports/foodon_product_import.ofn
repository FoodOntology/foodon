# Class: obo:FOODON_00001151 (citrus fruit food product)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001151 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001151 "A citrus fruit is botanically classified as a type of berry called a hesperidium that has a thick, leathery rind, with numerous oil glands, and a large flesh portion composed of several wedge-shaped sections. Unlike pome fruit, such as the apple, the citrus fruit is derived from a superior ovary, an ovary completely separate from the calyx."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001151 "https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/hesperidium"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001151 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_00001151 "citrus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001151 "citrus fruit food product"@en)
EquivalentClasses(obo:FOODON_00001151 ObjectIntersectionOf(obo:FOODON_00001057 ObjectSomeValuesFrom(obo:RO_0001000 ObjectIntersectionOf(obo:PO_0030109 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_03411139)))))
