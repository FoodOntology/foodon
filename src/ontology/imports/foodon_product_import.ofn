# Class: obo:FOODON_03307110 (rolled oats)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03307110 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03307110 "A type of lightly processed whole-grain food. Traditionally, they are made from oat groats (hulled grains) that have been dehusked and steamed, before being rolled into flat flakes under heavy rollers and then (optionally) stabilized by being lightly toasted."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03307110 wikipedia:Rolled_oats)
AnnotationAssertion(Annotation(dcterms:license "Public domain"@en) Annotation(dcterms:rightsHolder "Hankwang") schema:image obo:FOODON_03307110 <https://upload.wikimedia.org/wikipedia/commons/9/97/Rolled_oats.jpg>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03307110 siren:F7110)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307110 "old fashioned oats"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03307110 "whole oats"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03307110 "SIREN DB annotation:
* whole, shape achieved by forming, thickness <0.3 cm. FOODON:03430153
* partially heat-treated FOODON:03440018
* seed, skin removed, germ removed (endosperm) FOODON:03420208
* water removal process FOODON:03460138
* food rolling process FOODON:03460239
* preservation by dehydration or drying FOODON:03470116"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03307110 "rolled oats"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03307110 <https://wholegrainscouncil.org/whole-grains-101/easy-ways-enjoy-whole-grains/grain-month-calendar/oats-%E2%80%93-january-grain-month/types>)
