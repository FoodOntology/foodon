# Class: obo:FOODON_00001564 (blood meal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001564 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001564 "Blood meal is a dry, inert powder made from blood used as a high-nitrogen organic fertilizer and a high protein animal feed."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001564 "https://en.wikipedia.org/wiki/Blood_meal"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001564 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_00001564 siren:F10831)
AnnotationAssertion(rdfs:comment obo:FOODON_00001564 "It is one of the highest non-synthetic sources of nitrogen. It usually comes from cattle or hogs as a slaughterhouse by-product. N = 13.25%, P = 1.0%, K = 0.6%.

SIREN DB annotation:
* medium ground FOODON:03430117
* blood UBERON:0000178
* water removal process FOODON:03460138
* preservation by dehydration or drying FOODON:03470116
* animal as consumer FOODON:03510021"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001564 "blood meal"@en)
EquivalentClasses(obo:FOODON_00001564 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000086 obo:FOODON_03430106) ObjectSomeValuesFrom(obo:RO_0002353 ObjectIntersectionOf(obo:FOODON_03470116 ObjectSomeValuesFrom(obo:RO_0002233 ObjectIntersectionOf(obo:UBERON_0000178 ObjectSomeValuesFrom(obo:RO_0003001 ObjectUnionOf(obo:FOODON_03411136 obo:NCBITaxon_9913))))))))
SubClassOf(obo:FOODON_00001564 obo:FOODON_00001594)
SubClassOf(obo:FOODON_00001564 obo:FOODON_03302001)

# Class: obo:FOODON_00001565 (pre-evisceration carcass)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001565 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001565 "A pre-evisceration carcass is the carcass of a dead animal immediately following hide removal, before any antimicrobial applications and any part of the evisceration process has been performed. This is a material entity state within a butchery process."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001565 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001565 "pre-evisceration carcass"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00001565 "https://www.ars.usda.gov/ARSUserFiles/30400510/protocols/USMARC%20Carcass%20Sampling%20Protocol.pdf"^^xsd:anyURI)
SubClassOf(obo:FOODON_00001565 obo:FOODON_02020895)
SubClassOf(obo:FOODON_00001565 ObjectSomeValuesFrom(obo:RO_0001000 obo:UBERON_0008979))

# Class: obo:FOODON_00001566 (post-evisceration carcass)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001566 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001566 "A post-intervention carcass is a carcass that has had all antimicrobial intervention applied, been split in half along the backbone, and placed in a cooler, often referred to as the \"hot box\" cooler."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001566 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001566 "post-evisceration carcass"@en)
SubClassOf(obo:FOODON_00001566 obo:FOODON_02020895)
SubClassOf(obo:FOODON_00001566 ObjectSomeValuesFrom(obo:RO_0001000 obo:UBERON_0008979))

# Class: obo:FOODON_00001568 (food trimming)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001568 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001568 "Food trimmings are the parts removed from the culinary trimming of unwanted or inedible parts (i.e. sinews, skin, fat etc.) from meat, fish poultry or vegetables. Trimmings are used for making stocks, soups and sauces."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001568 "http://en.foodlexicon.org/p0000380.php"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001568 "Gregory Harhay"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_00001568 "trim"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_00001568 "trimmings"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001568 "food trimming"@en)
SubClassOf(obo:FOODON_00001568 obo:FOODON_00001714)

# Class: obo:FOODON_00001569 (high moisture corn (animal feed))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001569 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001569 "High-moisture corn refers to corn harvested at 24 percent or greater moisture, stored and allowed to ferment in a silo or other storage structure, and used as feed for livestock."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001569 "http://corn.agronomy.wisc.edu/Management/L062.aspx"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001569 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001569 "high moisture corn (animal feed)"@en)
SubClassOf(obo:FOODON_00001569 obo:FOODON_03301750)

# Class: obo:FOODON_00001570 (rolled grain)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001570 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001570 "Rolled grain is grain has been mechanicallly crushed to separate the hull from the endosperm."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001570 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001570 "rolled grain"@en)
SubClassOf(obo:FOODON_00001570 obo:FOODON_00001173)

# Class: obo:FOODON_00001571 (corn stover)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001571 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001571 "Corn stover consists of the leaves and stalks of maize (corn) (Zea mays ssp. mays L.) plants left in a field after harvest and consists of the residue: stalk; the leaf, husk, and cob remaining in the field following the harvest of cereal grain."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001571 "https://en.wikipedia.org/wiki/Corn_stover"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001571 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00001571 "Such stover makes up about half of the yield of a corn crop and is similar to straw from other cereal grasses; in Britain it is sometimes called corn straw."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001571 "corn stover"@en)
SubClassOf(obo:FOODON_00001571 obo:FOODON_00002127)

# Class: obo:FOODON_00001572 (corn stubble)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001572 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001572 "Corn stubble are the stems of corn plants remaining in the ground after harvest."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001572 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001572 "corn stubble"@en)
SubClassOf(obo:FOODON_00001572 obo:FOODON_00002127)

# Class: obo:FOODON_00001573 (cottonseed hull)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00001573 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001573 "The outer coverings of the cottonseed, known as cottonseed hulls, are removed from the cotton kernels before the oil is extracted."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001573 "https://en.wikipedia.org/wiki/Cottonseed"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00001573 "Gregory Harhay"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00001573 "Cottonseed hulls serve as an excellent source of feed for the livestock as they contain about 8% of cotton linters which have nearly 100% cellulose in them."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001573 "cottonseed hull"@en)
SubClassOf(obo:FOODON_00001573 obo:FOODON_00002127)

# Class: obo:FOODON_00001574 (soybean stubble)

