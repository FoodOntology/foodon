# Class: obo:FOODON_00003147 (nutritional drink)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003147 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003147 "Nutrition drinks are beverages that promise a healthy balance of protein, carbohydrate, and fat."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003147 <https://www.health.harvard.edu/staying-healthy/supplemental-nutrition-drinks-help-or-hype>)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00003147 "There are hundreds of varieties of nutritional drinks that fall into two general categories, shakes and formulas.  Shakes are intended for oral consumption and may be designed to be compatible with health conditions such as diabetes (Glucerna). Nutrition shakes are usually fortified with vitamins and blended with sugar to improve taste.  Formulas are designed for more specific disease states such as cancer, chronic obstructive pulmonary disease, and later-stage kidney disease."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00003147 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(dcterms:date obo:FOODON_00003147 "2019-08-26T06:16:43Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00003147 "nutritional drink"@en)
SubClassOf(obo:FOODON_00003147 obo:FOODON_03317089)

# Class: obo:FOODON_00003149 (Canadian bacon)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003149 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003149 "The American name for a form of back bacon that is cured, smoked and fully cooked, trimmed into cylindrical medallions, and thickly sliced. \"Canadian\" bacon is made only from the lean eye of the loin and is ready to eat. Its flavor is described as more ham-like than other types because of its lean cut."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003149 wikipedia:Back_bacon)
AnnotationAssertion(dcterms:contributor obo:FOODON_00003149 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(dcterms:date obo:FOODON_00003149 "2019-08-26T13:39:17Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(dcterms:license <https://creativecommons.org/licenses/by-sa/4.0>) Annotation(dcterms:rightsHolder "Beyond My Ken") schema:image obo:FOODON_00003149 <https://upload.wikimedia.org/wikipedia/commons/thumb/9/9f/American_Canadian_bacon.jpg/603px-American_Canadian_bacon.jpg>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00003149 "Canadian-style bacon"@en-us)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00003149 "back bacon"@en-ca)
AnnotationAssertion(rdfs:label obo:FOODON_00003149 "Canadian bacon"@en)
SubClassOf(obo:FOODON_00003149 obo:FOODON_00001061)

# Class: obo:FOODON_00003150 (back bacon)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003150 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003150 "Back bacon is a cut of bacon that includes the pork loin from the back of the pig. It may also include a portion of the pork belly in the same cut. It is much leaner than side bacon made only from the pork belly."@en-ca)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003150 wikipedia:Back_bacon)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00003150 "Back bacon is derived from the same cut used for pork chops.  It is the most common cut of bacon used in British and Irish cuisine, where both smoked and unsmoked varieties are found.[Wikipedia:Back_bacon]"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00003150 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(dcterms:date obo:FOODON_00003150 "2019-08-26T13:42:46Z"^^xsd:dateTime)
AnnotationAssertion(schema:image obo:FOODON_00003150 <https://upload.wikimedia.org/wikipedia/commons/thumb/9/92/Bacon.JPG/640px-Bacon.JPG>)
AnnotationAssertion(rdfs:label obo:FOODON_00003150 "back bacon"@en)
SubClassOf(obo:FOODON_00003150 obo:FOODON_00001061)

