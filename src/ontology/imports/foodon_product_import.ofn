# Class: obo:FOODON_03315658 (head cheese)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03315658 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03315658 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03315658 "Head cheese is a cold cut that originated in Europe. Head cheese is not a dairy cheese, but a terrine or meat jelly made with flesh from the head of a calf or pig, or less commonly a sheep or cow, and often set in aspic. A version pickled with vinegar is known as souse."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03315658 "https://en.wikipedia.org/wiki/Head_cheese"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03315658 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03315658 siren:F15658)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03315658 "brawn"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03315658 "souse"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03315658 "SIREN DB annotation:
* whole, shape achieved by forming FOODON:03430147
* fully heat-treated FOODON:03440014
* jowl, trimmed FOODON:03530040
* skeletal meat part, without bone, without skin FOODON:03420268
* curing or aging process FOODON:03460253
* ingredient: flavoring, spice or herb added FOODON:03460227"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03315658 "head cheese"@en)
SubClassOf(obo:FOODON_03315658 obo:FOODON_00001010)

