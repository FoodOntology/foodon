# Class: obo:FOODON_03301293 (fodder (animal feed))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03301293 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03301293 "Fodder, a type of animal feed, is any agricultural foodstuff used specifically to feed domesticated livestock, such as cattle, rabbits, sheep, horses, chickens and pigs. \"Fodder\" refers particularly to food given to the animals (including plants cut and carried to them), rather than that which they forage for themselves (called forage)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03301293 "https://en.wikipedia.org/wiki/Fodder"^^xsd:anyURI)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03301293 siren:F1293)
AnnotationAssertion(rdfs:comment obo:FOODON_03301293 "SIREN DB annotation:
* whole, natural shape FOODON:03430150
* not heat-treated FOODON:03440003
* whole plant or most parts used FOODON:03420150
* water removal process FOODON:03460138
* preservation by dehydration or drying FOODON:03470116
* food animal as consumer FOODON:03510015"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03301293 "fodder (animal feed)"@en)
EquivalentClasses(obo:FOODON_03301293 ObjectIntersectionOf(obo:FOODON_00001261 obo:FOODON_00004172 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_03413358)))
SubClassOf(obo:FOODON_03301293 obo:FOODON_00001261)

