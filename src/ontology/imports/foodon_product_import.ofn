AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002686 "langustas"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002686 "rock lobster"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002686 "spiny lobster"@en)
