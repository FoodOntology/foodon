# Class: obo:FOODON_00002466 (biscuit (hard) food product)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002466 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002466 "In Commonwealth nations and Ireland, a biscuit is a small baked product that would be called either a \"cookie\" or a \"cracker\" in the United States and most of English-speaking Canada. Biscuits in the United Kingdom, the Isle of Man and Ireland are hard and may be savoury or sweet, such as chocolate biscuits, digestives, hobnobs, ginger nuts, rich tea, bourbons, and custard creams"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002466 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002466 "biscuit"@en-gb)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002466 "cookie"@en-us)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002466 "cracker"@en-us)
AnnotationAssertion(rdfs:label obo:FOODON_00002466 "biscuit (hard) food product"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00002466 obo:FOODON_03301884)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00002466 "https://www.collinsdictionary.com/word-lists/biscuit-biscuits"^^xsd:anyURI)
SubClassOf(obo:FOODON_00002466 obo:FOODON_00001626)

