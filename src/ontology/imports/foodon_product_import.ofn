# Class: obo:FOODON_00002686 (spiny lobster)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002686 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002686 "Spiny lobsters, also known as langustas, langouste, or rock lobsters, are a family (Palinuridae) of about 60 species of achelate crustaceans, in the Decapoda Reptantia. Spiny lobsters are also, especially in Australia, New Zealand, Ireland, South Africa, and the Bahamas, called crayfish, sea crayfish, or crawfish (\"kreef\" in South Africa), terms which elsewhere are reserved for freshwater crayfish."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002686 "Damion Dooley")
AnnotationAssertion(dcterms:date obo:FOODON_00002686 "2019-06-27T08:31:13Z"^^xsd:dateTime)
