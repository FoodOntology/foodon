AnnotationAssertion(schema:image obo:FOODON_03460755 "https://upload.wikimedia.org/wikipedia/commons/thumb/9/98/Gr%C3%BCnmalz.jpg/640px-Gr%C3%BCnmalz.jpg"^^xsd:anyURI)
