# Class: obo:FOODON_03301881 (chopped liver (dish))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03301881 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03301881 "Chopped liver is a liver pâté popular in Ashkenazi Jewish cuisine. It is a common menu item in kosher delicatessens in Britain, Canada, South Africa, and the U.S.  The dish is often made by sautéing or broiling liver and onions, adding hard-boiled eggs, salt and pepper, and grinding that mixture. The liver used is generally calf, beef, or chicken."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03301881 wikipedia:Chopped_liver)
AnnotationAssertion(dcterms:contributor obo:FOODON_03301881 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03301881 siren:F1881)
AnnotationAssertion(rdfs:label obo:FOODON_03301881 "chopped liver (dish)"@en)
SubClassOf(obo:FOODON_03301881 obo:FOODON_00003288)
SubClassOf(obo:FOODON_03301881 ObjectSomeValuesFrom(obo:FOODON_00001563 obo:FOODON_03309772))

