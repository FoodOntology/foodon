# Class: obo:FOODON_00002935 (venison)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002935 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002935 "Venison originally meant the meat of a game animal, and now especially means a deer or antelope (in South Africa). Venison can be used to refer to any part of the animal, so long as it can be consumed, including the internal organs. Venison, much like beef or pork, is categorized into specific cuts, including roast, sirloin, and ribs."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002935 "https://en.wikipedia.org/wiki/Venison"@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002935 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002935 "Emma Griffiths"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00002935 "2019-08-09T23:49:47Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002935 "venison"@en)
