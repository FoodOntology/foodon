# Class: obo:FOODON_00002500 (spice rub)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002500 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002500 "Spice rub is any mixture of ground spices that is made for the purpose of being rubbed on raw food before the food is cooked. The spice rub forms a coating on the food. The food can be marinated in the spice rub for some time for the flavors to incorporate into the food or it can be cooked immediately after it is coated in the rub. The spice rub can be left on or partially removed before cooking."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002500 "https://en.wikipedia.org/wiki/Spice_rub"^^xsd:anyURI)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002500 "Damion Dooley")
AnnotationAssertion(dcterms:date obo:FOODON_00002500 "2019-01-23T22:18:16Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002500 "spice rub"@en)
SubClassOf(obo:FOODON_00002500 obo:FOODON_03303380)

# Class: obo:FOODON_00002501 (multi-component food)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002501 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002501 "A food product consisting of food material derived from ingredients sourced from multiple organisms."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002501 "Damion Dooley")
AnnotationAssertion(dcterms:date obo:FOODON_00002501 "2019-01-23T22:40:32Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_00002501 "multi-ingredient"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00002501 "The definition of this is being discussed in issue: https://github.com/FoodOntology/foodon/issues/57

Namely, how to characterize the threshold of ingredients that make for multi-component classification? Salt, pepper, spices wouldn't normally make a food multi-component?"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002501 "multi-component food"@en)
SubClassOf(obo:FOODON_00002501 obo:FOODON_00001002)
SubClassOf(obo:FOODON_00002501 ObjectSomeValuesFrom(obo:RO_0002350 obo:FOODON_03400139))

