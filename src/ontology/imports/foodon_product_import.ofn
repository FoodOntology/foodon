AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00000073 obo:IAO_0000122)
AnnotationAssertion(Annotation(obo:IAO_0000119 "https://en.wikipedia.org/wiki/Cereal_food_fines"^^xsd:anyURI) obo:IAO_0000115 obo:FOODON_00000073 "Cereal Food Fines are a byproduct or left-over of breakfast cereal food processing. Usually the source is unknown and sometimes this product is used in low quality dog food."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00000073 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00000073 "fines"@en)
