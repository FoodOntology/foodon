AnnotationAssertion(obo:IAO_0000412 obo:BFO_0000141 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000141 "immaterial entity"@en)

# Class: obo:CHEBI_33252 (atomic nucleus)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_33252 "A nucleus is the positively charged central portion of an atom, excluding the orbital electrons.")
AnnotationAssertion(obo:IAO_0000412 obo:CHEBI_33252 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:CHEBI_33252 "atomic nucleus")
SubClassOf(obo:CHEBI_33252 obo:CHEBI_36342)

# Class: obo:CHEBI_36342 (subatomic particle)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_36342 "A particle smaller than an atom.")
AnnotationAssertion(obo:IAO_0000412 obo:CHEBI_36342 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:CHEBI_36342 "subatomic particle")
SubClassOf(obo:CHEBI_36342 obo:BFO_0000040)

# Class: obo:CL_0000000 (cell)

AnnotationAssertion(obo:IAO_0000115 obo:CL_0000000 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.")
AnnotationAssertion(obo:IAO_0000412 obo:CL_0000000 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:CL_0000000 "cell")
SubClassOf(obo:CL_0000000 obo:UBERON_0000465)

# Class: obo:COB_0000011 (atom)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000011 "A material entity consisting of exactly one atomic nucleus and the electron(s) orbiting it."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000011 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000011 "atom"@en)
SubClassOf(obo:COB_0000011 obo:BFO_0000040)

# Class: obo:COB_0000013 (molecule)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000013 "A material entity that consists of two or more atoms that are all connected via covalent bonds such that any atom can be transitively connected with any other atom."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000013 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000013 "molecule"@en)
SubClassOf(obo:COB_0000013 obo:BFO_0000040)

# Class: obo:COB_0000021 (gross anatomical part)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000021 "A part of a multicellular organism that is a collection of cell components that are not all contained in one cell."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000021 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000021 "gross anatomical part"@en)
SubClassOf(obo:COB_0000021 obo:UBERON_0000465)

# Class: obo:COB_0000022 (organism)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000022 "A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome"@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000022 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000022 "organism"@en)
SubClassOf(obo:COB_0000022 obo:UBERON_0000465)

# Class: obo:COB_0000026 (processed material entity)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000026 "A material entity processed by human activity with an intent to produce it."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000026 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000026 "processed material entity"@en)
SubClassOf(obo:COB_0000026 obo:BFO_0000040)

# Class: obo:COB_0000035 (completely executed planned process)

AnnotationAssertion(obo:IAO_0000412 obo:COB_0000035 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000035 "completely executed planned process"@en)
SubClassOf(obo:COB_0000035 obo:COB_0000082)

# Class: obo:COB_0000049 (nucleic acid chain)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000049 "A molecule that consists of nucleotides (unmodified nucleotide residues and/or modified nucleotide residues) linked by phosphodiester bonds or derivatives of such bonds."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000049 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000049 "nucleic acid chain"@en)
SubClassOf(obo:COB_0000049 obo:COB_0000013)

# Class: obo:COB_0000077 (obsolete action specification)

AnnotationAssertion(obo:IAO_0000412 obo:COB_0000077 obo:cob.owl)
AnnotationAssertion(obo:IAO_0100001 obo:COB_0000077 obo:IAO_0000007)
AnnotationAssertion(rdfs:label obo:COB_0000077 "obsolete action specification")
AnnotationAssertion(owl:deprecated obo:COB_0000077 "true"^^xsd:boolean)

# Class: obo:COB_0000080 (complex of molecules)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000080 "A complex of two or more molecules that are not covalently bound."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000080 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000080 "complex of molecules"@en)
SubClassOf(obo:COB_0000080 obo:BFO_0000040)

# Class: obo:COB_0000082 (planned process)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000082 "A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000082 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000082 "planned process"@en)
SubClassOf(obo:COB_0000082 obo:BFO_0000015)

# Class: obo:COB_0000083 (failed planned process)

AnnotationAssertion(obo:IAO_0000412 obo:COB_0000083 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000083 "failed planned process"@en)
SubClassOf(obo:COB_0000083 obo:COB_0000082)

# Class: obo:COB_0000110 (material processing)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000110 "A completely executed planned process that intends to output material entities from input material entities"@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0000110 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000110 "material processing"@en)
SubClassOf(obo:COB_0000110 obo:COB_0000035)

# Class: obo:COB_0000502 (characteristic)

AnnotationAssertion(obo:IAO_0000412 obo:COB_0000502 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0000502 "characteristic"@en)

# Class: obo:COB_0001300 (device)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0001300 "A processed material entity which is designed to be capable of a process."@en)
AnnotationAssertion(obo:IAO_0000412 obo:COB_0001300 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:COB_0001300 "device"@en)
SubClassOf(obo:COB_0001300 obo:COB_0000026)

# Class: obo:ENVO_01000813 (geophysical entity)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000813 "A material part of an astronomical body.")
AnnotationAssertion(obo:IAO_0000412 obo:ENVO_01000813 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:ENVO_01000813 "geophysical entity"@en)
SubClassOf(obo:ENVO_01000813 obo:BFO_0000040)

# Class: obo:GO_0005575 (cellular_component)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0005575 "A location, relative to cellular compartments and structures, occupied by a macromolecular machine. There are three types of cellular components described in the gene ontology: (1) the cellular anatomical entity where a gene product carries out a molecular function (e.g., plasma membrane, cytoskeleton) or membrane-enclosed compartments (e.g., mitochondrion); (2) virion components, where viral proteins act, and (3) the stable macromolecular complexes of which gene product are parts (e.g., the clathrin complex).")
AnnotationAssertion(obo:IAO_0000412 obo:GO_0005575 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:GO_0005575 "cellular_component")
SubClassOf(obo:GO_0005575 obo:BFO_0000040)

# Class: obo:GO_0032991 (protein-containing complex)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0032991 "A stable assembly of two or more macromolecules, i.e. proteins, nucleic acids, carbohydrates or lipids, in which at least one component is a protein and the constituent parts function together.")
AnnotationAssertion(obo:IAO_0000412 obo:GO_0032991 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:GO_0032991 "protein-containing complex")
SubClassOf(obo:GO_0032991 obo:COB_0000080)
SubClassOf(obo:GO_0032991 obo:GO_0005575)

# Class: obo:GO_0110165 (cellular anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0110165 "A part of a cellular organism that is either an immaterial entity or a material entity with granularity above the level of a protein complex but below that of an anatomical system. Or, a substance produced by a cellular organism with granularity above the level of a protein complex.")
AnnotationAssertion(obo:IAO_0000412 obo:GO_0110165 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:GO_0110165 "cellular anatomical entity")
SubClassOf(obo:GO_0110165 obo:GO_0005575)
SubClassOf(obo:GO_0110165 obo:UBERON_0000465)

# Class: obo:IAO_0000005 (objective specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000005 "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000005 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000005 "objective specification"@en)
SubClassOf(obo:IAO_0000005 obo:IAO_0000033)

# Class: obo:IAO_0000007 (action specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000007 "A directive information entity that describes an action the bearer will take."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000007 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000007 "action specification"@en)
SubClassOf(obo:IAO_0000007 obo:IAO_0000033)

# Class: obo:IAO_0000027 (data item)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000027 "An information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000027 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000027 "data item"@en)
SubClassOf(obo:IAO_0000027 obo:IAO_0000030)

# Class: obo:IAO_0000030 (information content entity)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000030 "A generically dependent continuant that is about some thing."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000030 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000030 "information content entity"@en)

# Class: obo:IAO_0000033 (directive information entity)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000033 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000033 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000033 "directive information entity"@en)
SubClassOf(obo:IAO_0000033 obo:IAO_0000030)

# Class: obo:IAO_0000104 (plan specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000104 "A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000104 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000104 "plan specification"@en)
SubClassOf(obo:IAO_0000104 obo:IAO_0000033)

# Class: obo:IAO_0000109 (measurement datum)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000109 "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device."@en)
AnnotationAssertion(obo:IAO_0000412 obo:IAO_0000109 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:IAO_0000109 "measurement datum"@en)
SubClassOf(obo:IAO_0000109 obo:IAO_0000027)

# Class: obo:NCBITaxon_131567 (cellular organism)

AnnotationAssertion(obo:IAO_0000412 obo:NCBITaxon_131567 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:NCBITaxon_131567 "cellular organism")
SubClassOf(obo:NCBITaxon_131567 obo:COB_0000022)

# Class: obo:OBI_0000066 (investigation)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000066 "a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s)."@en)
AnnotationAssertion(obo:IAO_0000412 obo:OBI_0000066 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:OBI_0000066 "investigation"@en)
SubClassOf(obo:OBI_0000066 obo:COB_0000035)

# Class: obo:OBI_0000070 (assay)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000070 "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it."@en)
AnnotationAssertion(obo:IAO_0000412 obo:OBI_0000070 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:OBI_0000070 "assay"@en)

# Class: obo:OBI_0200000 (data transformation)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0200000 "A completely executed planned process that produces output data from input data."@en)
AnnotationAssertion(obo:IAO_0000412 obo:OBI_0200000 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:OBI_0200000 "data transformation"@en)

# Class: obo:PATO_0000125 (mass)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000125 "A physical quality that inheres in a bearer by virtue of the proportion of the bearer's amount of matter.")
AnnotationAssertion(obo:IAO_0000412 obo:PATO_0000125 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:PATO_0000125 "mass")
SubClassOf(obo:PATO_0000125 obo:COB_0000502)

# Class: obo:PCO_0000000 (collection of organisms)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000000 "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(obo:IAO_0000412 obo:PCO_0000000 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:PCO_0000000 "collection of organisms"@en)
SubClassOf(obo:PCO_0000000 obo:BFO_0000040)

# Class: obo:PR_000000001 (protein)

AnnotationAssertion(obo:IAO_0000115 obo:PR_000000001 "An amino acid chain that is produced de novo by ribosome-mediated translation of a genetically-encoded mRNA, and any derivatives thereof.")
AnnotationAssertion(obo:IAO_0000412 obo:PR_000000001 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:PR_000000001 "protein")
SubClassOf(obo:PR_000000001 obo:PR_000018263)

# Class: obo:PR_000018263 (amino acid chain)

AnnotationAssertion(obo:IAO_0000115 obo:PR_000018263 "An organic amino compound that consists of amino acid residues (unmodified amino-acid residues and/or modified amino-acid residues) linked by peptide bonds or derivatives of such bonds.")
AnnotationAssertion(obo:IAO_0000412 obo:PR_000018263 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:PR_000018263 "amino acid chain")
SubClassOf(obo:PR_000018263 obo:COB_0000013)

# Class: obo:UBERON_0000465 (material anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0000465 "Anatomical entity that has mass.")
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0000465 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:UBERON_0000465 "material anatomical entity")
SubClassOf(obo:UBERON_0000465 obo:BFO_0000040)
SubClassOf(obo:UBERON_0000465 obo:UBERON_0001062)

# Class: obo:UBERON_0000466 (immaterial anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0000466 "Anatomical entity that has no mass.")
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0000466 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:UBERON_0000466 "immaterial anatomical entity")
SubClassOf(obo:UBERON_0000466 obo:BFO_0000141)
SubClassOf(obo:UBERON_0000466 obo:UBERON_0001062)

# Class: obo:UBERON_0001062 (anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0001062 "Biological entity that is either an individual member of a biological species or constitutes the structural organization of an individual member of a biological species.")
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0001062 obo:cob.owl)
AnnotationAssertion(rdfs:label obo:UBERON_0001062 "anatomical entity")


