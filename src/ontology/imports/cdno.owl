        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000115>A pentacyclic triterpenoid that is oleanane containing a double bond between positions 12 and 13 and substituted by hydroxy groups at the 3beta, 22beta and 24-positions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>soyasapogenol B</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_9210 -->

