        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">isopeonidin 3-rutinoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_143237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_143237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>An acetophenone substituted by a sulfooxy group at position 2 and by a hydroxy group at position 4.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>2-O-sulfate-4-hydroxyacetophenone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">2-O-sulfate-4-hydroxyacetophenone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_145012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_145012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>A rebaudioside that is rubusoside in which the hydroxy groups at positions 3 and 4 of the beta-D-glucopyranosyloxy group at the 13alpha position have both been converted to the corresponding beta-D-glucopyranoside.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>rebaudioside A</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">rebaudioside A</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_145013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_145013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
