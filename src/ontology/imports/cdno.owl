    <!-- http://purl.obolibrary.org/obo/CHEBI_190519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_190519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000115>A globular protein that is present in the milk of many mammalian species including ruminants, such as cows and sheep, and some non-ruminants, such as pigs and horses</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>beta-lactoglobulin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">beta-lactoglobulin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_190521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_190521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000009"/>
        <obo:IAO_0000115>A group of small molecular weight albumins (15-17 kDa) that are one of the two major kinds of storage proteins synthesized in the seeds of mustard and rapeseed during its maturation. Its heterodimer structure is composed of two polypeptide chains that are held together by disulfide bonds. The proteins are soluble in a wide pH range and show high heat stability.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>napin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">napin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_190522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_190522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000115>A prolamin present in wheat and several other cereals within the grass genus Triticum. It is made up of single-chain polypeptides with an average molecular weight of 25-100 kDa linked by intramolecular disulfide bonds and classified based on its primary amino acid sequence into the alpha/beta-, gamma- and omega-type.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>gliadin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">gliadin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_192499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_192499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>are a type of flavonoid pigments in plants. Anthoxanthins are water-soluble pigments which range in color from white or colorless to a creamy to yellow, often on petals of flowers.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>anthoxanthin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">anthoxanthin </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_192500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_192500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38672"/>
        <obo:IAO_0000115>a class of flavonoids that use the 3-hydroxy-2,3-dihydro-2-phenylchromen-4-one (IUPAC name) backbone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>flavanonol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">flavanonol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_192501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_192501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23909"/>
        <obo:IAO_0000115>Dimer of casuarictin linked by a bond between the gallic acid residue and one of the hexahydroxydiphenic acid units. It has sanguisorbic acid ester groups as linking units between glucopyranose moieties.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sanguiin H6</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sanguiin H6 </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_192502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_192502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23909"/>
        <obo:IAO_0000115>Is trimer of casuarictin linked by sanguisorbic acid ester groups between glucopyranose moieties. It contributes to the antioxidant capacity of raspberries.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lambertianin C</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lambertianin C </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_192503 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_192503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>a class of condensed tannins in the sub-class procyanidins contained in the seeds of Areca catechu also called betel nut. The arecatannin-type natural products from Ceylonese cassia bark and Areca seed are examples polyphenols by both current definitions, and fit the distinct definition of a polymeric phenol as well.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>arecatannin a2</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">arecatannin a2 </rdfs:label>
    </owl:Class>
    


