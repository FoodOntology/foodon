        <obo:IAO_0000115>An optically active form of lactic acid having (S)-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(S)-lactic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(S)-lactic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28197"/>
        <obo:IAO_0000115>A glycosyloxyisoflavone that is  daidzein attached to a beta-D-glucopyranosyl residue at position 7 via a glycosidic linkage. It is used in the treatment of alcohol dependency (antidipsotropic).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>daidzein 7-O-beta-D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22580"/>
        <obo:IAO_0000115>A trihydroxyanthraquinone that is 9,10-anthraquinone which is substituted by hydroxy groups at positions 1, 3, and 8 and by a methyl group at position 6. It is present in the roots and barks of numerous plants (particularly rhubarb and buckthorn), moulds, and lichens. It is an active ingredient of various Chinese herbs.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>emodin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">emodin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000115>A flavan-3,3&apos;,4&apos;,5,5&apos;,7-hexol having (2R,3R)-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-epigallocatechin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(-)-epigallocatechin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A member of the class of phenols that is guaiacol in which the hydrogen para- to the hydroxy group is replaced by a vinyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>2-methoxy-4-vinylphenol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">2-methoxy-4-vinylphenol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24043"/>
        <obo:IAO_0000115>The simplest member of the class of flavones that consists of 4H-chromen-4-one bearing a phenyl substituent at position 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>flavone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">flavone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26607"/>
        <obo:IAO_0000115>A straight-chain saturated fatty acid containing fifteen-carbon atoms.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pentadecanoic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pentadecanoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A 7-hydroxyflavonol with additional hydroxy groups at positions 3, 3&apos; and 4&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>fisetin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_42680 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_42680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(2-cis,6-cis)-farnesol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Dalbergin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_44247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_44247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25413"/>
        <obo:IAO_0000115>A tetracosenoic acid having a cis-double bond at position 15.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(15Z)-tetracosenoic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(15Z)-tetracosenoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_45487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_45487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15035"/>
        <obo:IAO_0000115>A retinal in which the double bond alpha- to the aldehyde group has cis configuration, whilst the remaining acyclic double bonds have trans configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>13-cis-retinal</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">13-cis-retinal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4629 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000115>A  sapogenin that is spirostan which is substituted by a hydroxy group at the 3beta position, contains a double bond at the 5-6 position, and has R- configuration at position 25. A natural product found in Dioscorea (wild yam) species, it is used as the starting point for the commercial synthesis of a number of steroids, including cortisone, pregnenolone and progesterone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>diosgenin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">diosgenin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A monomethoxyflavone that is the 4&apos;-methyl ether derivative of luteolin. It is a natural product isolated from citrus fruits which exhibits a range of pharmacological activities.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>diosmetin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">diosmetin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_4630"/>
        <obo:IAO_0000115>A disaccharide derivative that consists of  diosmetin substituted by a 6-O-(alpha-L-rhamnopyranosyl)-beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>diosmin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">diosmin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_46905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_46905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176840"/>
        <obo:IAO_0000115>A pantothenic acid having R-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(R)-pantothenic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(R)-pantothenic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>A  carotenone that is beta-carotene in which the 4 position has undergone formal oxidation to afford the corresponding ketone. Isolated as orange-red crystals, it is widely distributed in marine invertebrates.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>echinenone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Elastin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Elastin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_47771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_47771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27013"/>
        <obo:IAO_0000115>A tocopherol in which the chroman-6-ol core is substituted by methyl groups at positions 5 and 8. While it is found in low concentrations in many vegetable oils, only cottonseed oil contains significant amounts.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>beta-tocopherol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_47772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_47772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27013"/>
        <obo:IAO_0000115>A tocopherol in which the chroman-6-ol core is substituted by a methyl group at position 8. It is found particularly in maize (corn) oil and soya bean (soybean) oils.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>delta-tocopherol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_47916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_47916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72544"/>
        <obo:IAO_0000115>Any member of the &apos;superclass&apos; flavonoids whose skeleton is based on 1-benzopyran with an aryl substituent at position 2. The term was originally restricted to natural products, but is now also used to describe semi-synthetic and fully synthetic compounds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>flavonoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">flavonoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_47925 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_47925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23401"/>
        <obo:IAO_0000115>A monohydroxycinnamic acid in which the hydroxy substituent is located at C-3 of the phenyl ring.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3-coumaric acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">3-coumaric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_47964 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_47964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>A simplest memebr of the class of aurones that is 1-benzofuran-3(2H)-one in which both hydrogens at position 2 are substituted by a benzylidene group (the Z-isomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>aurone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">aurone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_48039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_48039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>Any hydroxyflavanone in which a hydroxy group is present at position 3 of the heterocyclic ring.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>dihydroflavonols</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dihydroflavonols</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4806 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51149"/>
        <obo:IAO_0000115>A gallate ester obtained by the formal condensation of gallic acid with the (3R)-hydroxy group of (-)-epigallocatechin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-epigallocatechin 3-gallate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4853 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>A hydroxycoumarin that is the 6-O-beta-D-glucoside of esculetin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>esculin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_48607 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_48607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36093"/>
        <obo:IAO_0000115>A metal chloride salt with a Li(+) counterion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lithium chloride</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lithium chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_48775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_48775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000012"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cadmium(2+)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cadmium(2+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_48828 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_48828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000012"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cobalt(2+)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cobalt(2+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26948"/>
        <obo:IAO_0000115>A hydrochloride obtained by combining thiamine chloride with one molar equivalent of hydrochloric acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>thiamine hydrochloride</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">thiamine hydrochloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A phenylpropanoid formally derived from guaiacol with an allyl chain substituted para to the hydroxy group. It is a major component of clove essential oil, and exhibits antibacterial, analgesic and antioxidant properties. It has been widely used in dentistry to treat toothache and pulpitis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>eugenol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">eugenol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_4932 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_4932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A trimethoxyflavone that is flavone substituted by hydroxy groups at C-5 and C-7 and methoxy groups at C-6, C-3&apos; and C-4&apos; respectively. Isolated from Citrus reticulata and Salvia tomentosa, it exhibits anti-inflammatory, anti-ulcer and antineoplastic activities.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>eupatilin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000028"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>molybdenum(4+)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">molybdenum(4+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000028"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>molybdenum(6+)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">molybdenum(6+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000012"/>
        <obo:IAO_0000115>An aluminium cation that has a charge of +3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>aluminium(3+)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">aluminium(3+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000012"/>
