    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_7044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>myoglobin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">myoglobin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_70824 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_70824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>An N-acylglycine that is hippuric acid (N-benzoylglycine) substituted at position 3 on the phenyl ring by a hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>m-hydroxyhippuric acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">m-hydroxyhippuric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>A beta-diketone that is methane in which two of the hydrogens are substituted by 4-hydroxycinnamoyl groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>bisdemethoxycurcumin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">bisdemethoxycurcumin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>An aryl sulfate that is quinol (hydroquinone) with one of the two hydroxy groups substituted by a sulfo group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quinol sulfate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">quinol sulfate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26848"/>
        <obo:IAO_0000115>A type of tannin usually found in brown algae such as kelps and rockweeds. Unlike the hydrolysable or condensed tannins, these compounds are oligomers of phloroglucinol.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phlorotannin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phlorotannin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000115>A a gallocatechin that has (2S,3R)-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-gallocatechin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(-)-gallocatechin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>Any ketone that is 1,3-diphenylpropanone and its derivatives obtained by substitution.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>dihydrochalcones</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dihydrochalcones</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50753"/>
        <obo:IAO_0000115>Members of the class of tetrahydrochromenochromene that consists of a cis-fused tetrahydrochromeno[3,4-b]chromene skeleton and its substituted derivatives. The term was originally restricted to natural products, but is now also used to describe semi-synthetic and fully synthetic compounds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>rotenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">rotenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72544"/>
        <obo:IAO_0000115>Any 1-benzopyran with an aryl substituent at position 4. The term was originally restricted to natural products, but is now also used to describe semi-synthetic and fully synthetic compounds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>neoflavonoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">neoflavonoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38691"/>
        <obo:IAO_0000115>A member of the class of flavans in which one or more ring hydrogens are replaced by hydroxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>hydroxyflavan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">hydroxyflavan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000013"/>
        <obo:IAO_0000115>Any organic molecular entity whose stucture is based on derivatives of a phenyl-substituted 1-phenylpropane possessing a C15 or C16 skeleton, or such a structure which is condensed with a C6-C3 lignan precursors. The term is a &apos;superclass&apos; comprising all members of the classes of flavonoid, isoflavonoid, neoflavonoid, chalcones, dihydrochalcones, aurones, pterocarpan, coumestans, rotenoid, flavonolignan, homoflavonoid and flavonoid oligomers. Originally restricted to natural products, the term is also applied to synthetic compounds related to them.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>flavonoids</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">flavonoids</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50753"/>
        <obo:IAO_0000115>Any isoflavonoid with a 3,4-dihydro-3-aryl-2H-1-benzopyran skeleton and its substituted derivatives.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>isoflavans</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">isoflavans</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50753"/>
        <obo:IAO_0000115>Members of the class of benzofurochromene with a 6H-[1]benzofuro[3,2-c]chromene skeleton and its substituted derivatives. They are the 3,4-didehydroderivatives of pterocarpans.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>coumestans</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">coumestans</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72577"/>
        <obo:IAO_0000115>A member of the class of coumestans that is 6H-[1]benzofuro[3,2-c]chromene substituted by an oxo group at position 6.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>coumestan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">coumestan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72785 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25681"/>
        <obo:IAO_0000115>An HETE having a 9-hydroxy group and (5E)-, (7Z)-, (11Z)- and (14Z)-double bonds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>9-hydroxy-5E,7Z,11Z,14Z-eicosatetraenoic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">9-hydroxy-5E,7Z,11Z,14Z-eicosatetraenoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36009"/>
        <obo:IAO_0000115>A 20-carbon, polyunsaturated fatty acid having two double bonds at unspecified positions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>icosadienoic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">icosadienoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26377"/>
        <obo:IAO_0000115>The simplest member of the class of pterocarpans that is 6a,11a-dihydro-6H-[1]benzofuro[3,2-c]chromene.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pterocarpan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pterocarpan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52221"/>
        <obo:IAO_0000115>An isothiocyanate with the formula CH2=CHCH2N=C=S. A colorless oil with boiling point 152degreeC, it is responsible for the pungent taste of mustard, horseradish, and wasabi.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>allyl isothiocyanate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">allyl isothiocyanate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27300"/>
        <obo:IAO_0000115>A vitamin D that is calciol or its hydroxylated metabolites calcidiol and calcitriol. Calciol (also known as vitamin D3) acts as a hormone precursor, being hydroxylated in the liver to calcidiol (25-hydroxyvitamin D3), which is then further hydroxylated in the kidney to give calcitriol (1,25-dihydroxyvitamin D3), the active hormone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>D3 vitamins</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">D3 vitamins</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28088"/>
        <obo:IAO_0000115>An organic anion that is the conjugate base of genistein, obtained by selective deprotonation of the 7-hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>genistein(1-)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38757"/>
        <obo:IAO_0000115>A member of the class of isoflavones having one or more glycosyl residues attached at unspecified positions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>glycosyloxyisoflavone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">glycosyloxyisoflavone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74793 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_4308"/>
        <obo:IAO_0000115>An anthocyanin cation that is the 3-O-beta-D-glucoside of peonidin (methylcyanidin).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>peonidin 3-O-beta-D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74811 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38695"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38697"/>
        <obo:IAO_0000115>An anthocyanidin 3-O-beta-D-sambubioside having cyanidin as the anthocyanidin component.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cyanidin 3-O-beta-D-sambubioside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74957 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">4&apos;,6,7-trihydroxyisoflavone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74960 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A trihydroxyflavanone that consists of 3&apos;-methoxyflavanone in which the three hydroxy substituents are located at positions 4&apos;, 5, and 7.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>homoeriodictyol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">homoeriodictyol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50699"/>
        <obo:IAO_0000115>Any oligosaccharide that has a biosynthetic pathway in common with that of raffinose.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>raffinose family oligosaccharide</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">raffinose family oligosaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_7502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28412"/>
        <obo:IAO_0000115>A flavanone glycoside that is  eriodictyol substituted by a 2-O-(6-deoxy-alpha-L-mannopyranosyl)-beta-D-glucopyranosyl residue at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>neoeriocitrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">neoeriocitrin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38695"/>
        <obo:IAO_0000115>An anthocyanidin chloride that has peonidin as the cationic component.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>peonidin chloride</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">peonidin chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A dihydroxyflavone in which the two hydroxy groups are located at positions 5 and 7.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>chrysin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">chrysin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36009"/>
        <obo:IAO_0000115>Any polyunsaturated fatty acid containing 22 carbons and 2 double bonds</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>docosadienoic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">docosadienoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38702"/>
        <obo:IAO_0000115>An inorganic sodium salt having bromate as the counterion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sodium bromate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sodium bromate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An anthocyanidin cation that is flavylium bearing four hydroxy substituents at positions 3, 4&apos;, 5 and 7 as well as a methoxy substituent at position 3&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>peonidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35218"/>
        <obo:IAO_0000115>An anthocyanidin cation that is flavylium bearing five hydroxy substituents at positions 3, 3&apos;, 4&apos;, 5 and 7 as well as a methoxy substituent at position 5&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>petunidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26191"/>
        <obo:IAO_0000115>A glycosyl alditol consisting of beta-D-galactopyranose and D-glucitol joined by a 1-&gt;4 glycosidic bond. It is used as a laxative, as an excipient, and as replacement bulk sweetener in some low-calorie foods.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lactitol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lactitol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75619 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of two molecules of (+)-catechin joined by a bond between positions 4 and 6&apos; in alpha-configuration. Procyanidin B6 is isolated from leaves and fruit of cowberry Vaccinium vitis-idaea and other plants. It can also be found in grape seeds and in beer.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B6</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B6</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75621 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin  consisting of two molecules of (-)-epicatechin joined by a bond between positions 4 and 6&apos; in beta-configuration. It can be found in grape seeds, in Hibiscus cannabinus (kenaf) root and bark, in apple and in cacao.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B5</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B5</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of two molecules of (+)-catechin joined by a bond between positions 4 and 8&apos; in alpha-configuration. It can be found in red wine, in barley, in beer, in peach or in Jatropha macrantha, the Huanarpo Macho.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B3</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B3</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of two molecules of (-)-epicatechin joined by a bond between positions 4 and 8&apos; in a beta-configuration. Procyanidin B2 can be found in Cinchona pubescens (Chinchona, in the rind, bark and cortex), in Cinnamomum verum (Ceylon cinnamon, in the rind, bark and cortex), in Crataegus monogyna (Common hawthorn, in the flower and blossom), in Uncaria guianensis (Cat&apos;s claw, in the root), in Vitis vinifera (Common grape vine, in the leaf), in Litchi chinensis (litchi, in the pericarp), in the apple, in Ecdysanthera utilis and in red wine.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B2</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B2</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of (-)-epicatechin and (+)-catechin units joined by a bond between positions 4 and 8&apos; respectively  in a beta-configuration.. Procyanidin B1 can be found in Cinnamomum verum (Ceylon cinnamon, in the rind, bark or cortex), in Uncaria guianensis (cat&apos;s claw, in the root), and in Vitis vinifera (common grape vine, in the leaf) or in peach.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B1</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75643 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of three (-)-epicatechin units joined by two successive (4beta-&gt;8)-linkages.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin C1</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin C1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75644 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin consisting of three (+)-catechin trimer joined by two successive (4alpha-&gt;8)-linkages.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin C2</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin C2</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A kaempferol O-glucuronide that is kaempferol with a beta-D-glucosiduronic acid residue attached at the 3-position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>kaempferol 3-O-glucuronide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000014"/>
        <obo:IAO_0000115>Any member of the group of eight water-soluble vitamins originally thought to be a single compound (vitamin B) that play important roles in cell metabolism. The group comprises of vitamin B1, B2, B3, B5, B6, B7, B9, and B12 (Around 20 other compounds were once thought to be B vitamins but are no longer classified as such).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>B vitamin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">B vitamin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_190420"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24840"/>
        <obo:IAO_0000115>A compound of iron and sulfate in which the ratio of iron(2+) to sulfate ions is 1:1. Various hydrates occur naturally - most commonly the heptahydrate, which loses water to form the tetrahydrate at 57degreeC and the monohydrate at 65degreeC.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>iron(2+) sulfate (anhydrous)</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">iron(2+) sulfate (anhydrous)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A quercetin O-glucoside that is quercetin with a beta-D-glucosyl residue attached at position 4&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quercetin 4&apos;-O-beta-D-glucopyranoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75902 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A monomethoxyflavone that is scutellarein methylated at position 6.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>hispidulin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">hispidulin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_7602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A methoxyflavone that is flavone substituted by methoxy groups at positions 5, 6, 7, 8, 3&apos; and 4&apos; respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>nobiletin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">nobiletin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_7603 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26658"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Nobilin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Nobilin </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_7609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>nomilin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000115>A catechin that is flavan carrying five hydroxy substituents at positions 3, 3&apos;, 4&apos;, 5 and 7 (the 2S,3S-stereoisomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(+)-epicatechin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(+)-epicatechin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000115>A gallate ester obtained by formal condensation of the carboxy group of gallic acid with the (3S)-hydroxy group of (+)-catechin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(+)-catechin-3-O-gallate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(+)-catechin-3-O-gallate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000115>A benzofuran-derived stilbenoid that is a homotrimer obtained by cyclotrimerisation of resveratrol.</obo:IAO_0000115>
