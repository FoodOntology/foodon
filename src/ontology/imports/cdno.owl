    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_133348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_34778"/>
        <obo:IAO_0000115>A glycosyloxyisoflavone that is glycitin carrying an acetyl substituent at position 6 on the glucose moiety.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>glycitein 7-(6-O-acetyl-beta-D-glucoside)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_133365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_133365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>An anthocyanidin glycoside that is pelargonidin in which the two phenolic hydrogens at positions 3 and 5 have been replaced by beta-D-glucosyl residues.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pelargonin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pelargonin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_134345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_134345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A 2-acyl-4,6-diprenylphloroglucinol in which the acyl group is specified as 3-methylbutanoyl.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>deoxyhumulone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">deoxyhumulone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_136609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_136609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26267"/>
        <obo:IAO_0000115>A biflavonoid that is 3,4,5-trihydroxybenzocyclohepten-6-one which is substituted at positions 1 and 8 by (2R,3R)-3,5,7-trihydroxy-3,4-dihydro-2H-chromen-2-yl groups. It is the main red pigment in black tea.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>theaflavin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">theaflavin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_136666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_136666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A trimethoxyflavone that is 6-hydroxyluteolin in which the phenolic hydogens at positions 4&apos;, 6 and 7 have been replaced by methyl groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>eupatorin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">eupatorin</rdfs:label>
    </owl:Class>
    


