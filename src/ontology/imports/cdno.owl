    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_145829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An aryl beta-D-glucoside that is phloretin attached to a beta-D-glucopyranosyl residue at position 4&apos; via a glycosidic linkage. It is isolated from the leaves of the Chinese sweet tea Lithocarpus polystachyus and exhibits significant anti-hyperglycemic, anti-oxidative and anti-inflammatory properties.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>trilobatin</rdfs:label>
    </owl:Class>
    


