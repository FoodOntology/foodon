    <!-- http://purl.obolibrary.org/obo/CHEBI_5623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_5623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
        <obo:IAO_0000115>An indole alkaloid fundamental parent with a structure of 9H-beta-carboline carrying a methyl substituent at C-1. It has been isolated from the bark of Sickingia rubra, Symplocus racemosa, Passiflora incarnata, Peganum harmala, Banisteriopsis caapi and Tribulus terrestris, as well as from tobacco smoke. It is a specific, reversible inhibitor of monoamine oxidase A.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>harman</rdfs:label>
    </owl:Class>
    


