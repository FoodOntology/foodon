    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37684"/>
        <obo:IAO_0000115>A mannose with D-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>D-mannose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">D-mannose</rdfs:label>
    </owl:Class>
    


