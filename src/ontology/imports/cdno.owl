        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33235"/>
        <obo:IAO_0000115>A tocotrienol that is chroman-6-ol substituted by methyl groups at positions 2 and 8 and a farnesyl chain at position 2.</obo:IAO_0000115>
