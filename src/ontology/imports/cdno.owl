    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18388"/>
        <obo:IAO_0000115>An apigenin flavone glycoside, which is found in the passion flower, bamboo leaves and pearl millet</obo:IAO_0000115>
