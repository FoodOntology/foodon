        <obo:IAO_0000115>A short-chain saturated fatty acid comprising ethane attached to the carbon of a carboxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>propionic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">propionic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_30769 -->

