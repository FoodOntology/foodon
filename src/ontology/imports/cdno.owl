    <!-- http://purl.obolibrary.org/obo/CDNO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115 xml:lang="en">A complex carbohydrate with various rheological properties that result in viscoelastic behavior</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">gum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Fractions of dietary fibre calculated as the sum of water insoluble dietary fibre (IDF)(e.g. cellulose) and soluble dietary fibre that precipitates in the presence of 78% aqueous ethanol (SDFP).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">high molecular weight dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre of degree of polymerization (DP) &gt; 2 resistant to digestion and absorption in the human small intestine but that is partially or completely fermented by the large bowel microbiota.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">fermentable dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre that resists degradation by the bacteria in the colon, resulting in limited action by the large bowel microbiota.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">non-fermentable dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">Soluble dietary fibre that dissolves in water to form semifluid solutions or a gel-like matrix, and exhibits high shear strength in aqueous solutions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">viscous dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre which has been isolated or synthesized and is added to the diet of humans or other monogastric species that has beneficial physiological effects.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">added dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre that is selectively utilized by host microorganisms conferring a health benefit.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">prebiotic dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">Water soluble dietary fibre which precipitates in 78% aqueous ethanol.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">soluble dietary fibre precipitate (SDFP)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">Water soluble dietary fibre which remains soluble in 78% aqueous ethanol.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">soluble dietary fibre soluble (SDFS)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre oligomers of degree of polymerization (DP) &gt; 2 which remain soluble in 78% aqueous ethanol and are not digested by enzymes of the human digestive tract.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">low molecular weight dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115 xml:lang="en">A polysaccharide fraction of dietary fibre that excludes lignin and all starch.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">non-starch polysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000008"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000032"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000041"/>
        <obo:IAO_0000115 xml:lang="en">A non-starch polysaccharide composed of cellulose or its derivatives.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cellulosic polysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000041"/>
        <obo:IAO_0000115 xml:lang="en">A non-starch polysaccharide, other than cellulose, composed of chains of various types of monosaccharide units, that may be substituted with side chains and by various functional groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">non-starch non-cellulosic polysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000043"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37163"/>
        <obo:IAO_0000115 xml:lang="en">A linear α-glucan composed of repeating α-1,4-linked maltotriose or maltotetraose subunits, connected by α-1,6-glycosidic bonds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pullulan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000042"/>
        <obo:IAO_0000115 xml:lang="en">A cellulosic polysaccharide to which substituent groups have been added.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">modified cellulose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000043"/>
        <obo:IAO_0000115 xml:lang="en">A non-starch polysaccharide composed of chitin (β-1,4-poly-N-acetyl-D-glucosamine) and β-1,3-D-glucan, obtained from Aspergillus niger mycelial cell walls.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">chitin-glucan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50699"/>
        <obo:IAO_0000115 xml:lang="en">A dietary fiber consisting of 3-9 monomeric units not digested by enzymes of the human digestive tract and soluble in water.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">nondigestible oligosaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000033"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000043"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28796"/>
        <obo:IAO_0000115 xml:lang="en">A fructan consisting primarily of β-(2,6)-linked fructose residues with β-(1,2)-branches</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">graminan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000033"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000035"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000043"/>
        <obo:IAO_0000115 xml:lang="en">A polysaccharide primarily composed of a backbone containing α−1,4-D-galacturonic acid residues</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pectic polysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000032"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000033"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000035"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000038"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000041"/>
        <obo:IAO_0000115 xml:lang="en">A highly water-soluble or water-dispersible polysaccharide that readily dissolves or disperses to form highly hydrated entities of colloidal (nanoscale) dimensions</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">polysaccharide-based hydrocolloid</rdfs:label>
    </owl:Class>
    


