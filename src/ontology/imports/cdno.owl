        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_192499"/>
        <obo:IAO_0000115>A member of the class of flavonoid with a 2-aryl-1-benzopyran-4-one (2-arylchromen-4-one) skeleton and its substituted derivatives.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>flavones</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">flavones</rdfs:label>
    </owl:Class>
    


