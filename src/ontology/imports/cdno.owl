    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>A proline derivative that is proline substituted by at least one hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>hydroxyproline</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">hydroxyproline</rdfs:label>
