    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23849"/>
        <obo:IAO_0000115>A diterpene glycoside that is rubusoside in which the hydroxy group at position 2 of the allylic beta-D-glucoside has been converted to the corresponding beta-D-glucoside. It is a natural herbal sweetener that is 250-300 times sweeter than sucrose (though with a bitter aftertaste), extracted from the Stevia rebaudiana plant native to South America.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>stevioside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_9349 -->

