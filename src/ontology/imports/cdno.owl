        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>salicylic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">salicylic acid</rdfs:label>
