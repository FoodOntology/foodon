        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27013"/>
        <obo:IAO_0000115>A tocopherol that is chroman-6-ol substituted by methyl groups at positions 2, 5, 7 and 8 and a 4,8,12-trimethyltridecyl group at position 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>alpha-tocopherol</rdfs:label>
    </owl:Class>
    


