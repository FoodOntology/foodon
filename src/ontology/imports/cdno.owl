        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26658"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Lactupicrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Lactupicrin </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24676"/>
        <obo:IAO_0000115>A methoxybenzoic acid that is 4-methoxybenzoic acid bearing a hydroxy substituent at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3-hydroxy-4-methoxybenzoic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16247"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_190516"/>
        <obo:IAO_0000115>A glycerophosphocholine that is glycero-3-phosphocholine bearing two acyl substituents at positions 1 and 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phosphatidylcholine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phosphatidylcholine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>A polyphenylpropanoid derived from three monolignol monomers: trans-p-coumaryl alcohol, coniferol and trans-sinapyl alcohol. There is extensive cross-linking and no defined primary structure.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lignin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lignin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64709 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000001"/>
        <obo:IAO_0000115>Any organic molecular entity that is acidic and contains carbon in covalent linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>organic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">organic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64962 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24279"/>
        <obo:IAO_0000115>An indolylmethylglucosinolate that is the conjugate base of glucobrassicin, obtained by deprotonation of the sulfo group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>glucobrassicin(1-)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>An enantiomer of secoisolariciresinol having (-)-(2R,3R)-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-secoisolariciresinol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(-)-secoisolariciresinol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38702"/>
        <obo:IAO_0000115>An inorganic sodium salt that has chlorate as the counter-ion. An oxidising agent, it is used for bleaching paper and as a herbicide. It is also used in the manufacture of dyes, explosives and matches.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sodium chlorate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sodium chlorate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>A carotenol, the structure of which is (6&apos;R)-beta,epsilon-carotene hydroxy-substituted at C-3 with R-stereochemistry.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>zeinoxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18222"/>
        <obo:IAO_0000115>Any xylose with D-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>D-xylose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">D-xylose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A C-glycosyl compound that is luteolin substituted by beta-D-glucopyranosyl moieties at positions 6 and 8 respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lucenin-2</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65585 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23849"/>
        <obo:IAO_0000115>An abietane diterpenoid that is abieta-8,11,13-triene substituted by hydroxy groups at positions 11 and 12 and a carboxy group at position 20. It is isolated from rosemary (Rosmarinus officinalis) and common sage (Salvia officinalis) and exhibits anti-angiogenic, antineoplastic, antioxidant and anti-HIV activity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>carnosic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">carnosic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15889"/>
        <obo:IAO_0000115>A pentacyclic triterpenoid that is lupane in which the hydrogen at the 3beta position is substituted by a hydroxy group. It occurs in the skin of lupin seeds, as well as in the latex of fig trees and of rubber plants. It is also found in many edible fruits and vegetables.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lupeol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lupeol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>A beta-diketone that is curcumin in which one of the methoxy groups is replaced by hydrogen. It is found in Curcuma zedoaria and Etlingera elatior.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>demethoxycurcumin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">demethoxycurcumin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A glycosyloxyflavone that is luteolin substituted by a 6-O-malonyl-beta-D-glucopyranosyl moiety at position 7 via glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>luteolin 7-O-(6-O-malonyl-beta-D-glucoside)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>A carotenol that is  carotenol psi,psi-carotene substituted by a hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lycoxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_66046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_2197"/>
        <obo:IAO_0000115>A glycosyloxyflavone that is 6-hydroxyluteolin attached to a beta-D-glucopyranosyl-(1-&gt;3)-beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage. Isolated from Globularia cordifolia and Globularia alypum, it exhibits antioxidant activity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>6-hydroxyluteolin 7-O-laminaribioside</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">6-hydroxyluteolin 7-O-laminaribioside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_66103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_42491"/>
        <obo:IAO_0000115>A trihydroxyflavone that is flavone with hydroxy groups at positions 5, 7 and 4&apos; and methoxy groups at positions 3&apos; and 6. Isolated from Salvia tomentosa and Artemisia asiatica, it exhibits anti-allergic, anti-inflammatory and apoptosis inducing activties.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>jaceosidin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">jaceosidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_66331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23086"/>
        <obo:IAO_0000115>A member of the class of chalcones that is trans-chalcone substituted by hydroxy groups at positions 4, 2&apos; and 4&apos;, a methoxy group at position 6&apos; and a prenyl group at position 3&apos;. Isolated from Humulus lupulus, it induces apoptosis in human malignant glioblastoma cells.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>xanthohumol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">xanthohumol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_190297"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36093"/>
        <obo:IAO_0000115>A magnesium salt comprising of two chlorine atoms bound to a magnesium atom.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>magnesium dichloride</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">magnesium dichloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_66395 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A quercetin O-glycoside that consists of quercetin attached to a beta-D-glucuronopyranosyl moiety at position 3 via a glycosidic linkage. Isolated from Salvia and Phaseolus vulgaris, it exhibits antioxidant and antidepressant activities.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>miquelianin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6650 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64709"/>
        <obo:IAO_0000115>A 2-hydroxydicarboxylic acid that is succinic acid in which one of the hydrogens attached to a carbon is replaced by a hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>malic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">malic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6674 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An anthocyanidin cation that is delphinidin carrying methyl substituents at positions 3&apos; and 5&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>malvidin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">malvidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_66773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_66773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27552"/>
        <obo:IAO_0000115>A  flavanone glycoside that is  4&apos;-methoxy-5,7-dihydroxyflavanone attached to a neohesperidose (alpha-L-rhamnopyranosyl-(1-&gt;2)-beta-D-glucopyranose) residue via a glycosidic linkage. It has been isolated from the fruits of Poncirus trifoliata and exhibits inhibitory activity against liopolysaccharide (LPS)-induced prostaglandin E2 and interleukin-6 (IL-6) production.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(2S)-poncirin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(2S)-poncirin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6698 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>A lignan that is gamma-butyrolactone in which the 3 and 4 positions are substituted by 4-hydroxy-3-methoxybenzyl groups (the 3R,4R-diastereomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-matairesinol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(-)-matairesinol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_6699 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26658"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Matricin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Matricin </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176842"/>
        <obo:IAO_0000115>A folate obtained by deprotonation of any tetrahydrofolic acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tetrahydrofolate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tetrahydrofolate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17579"/>
        <obo:IAO_0000115>A carotenoid having the structure of beta-carotene but with a cis double bond at the 9,10-position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>9-cis-beta-carotene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A lignan that is tetrahydrofuran substituted at positions 2, 3 and 4 by 4-hydroxy-3-methoxyphenyl, hydroxymethyl and 4-hydroxy-3-methoxybenzyl groups respectively (the 2R,3S,4S-diastereomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-lariciresinol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A lignan that is tetrahydrofuran substituted at positions 2, 3 and 4 by 4-hydroxy-3-methoxyphenyl, hydroxymethyl and 4-hydroxy-3-methoxybenzyl groups respectively (the 2S,3R,4R-diastereomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(+)-lariciresinol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(+)-lariciresinol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26377"/>
        <obo:IAO_0000115>A member of the class of pterocarpans that is the 3-O-methyl ether of (+)-6a-hydroxymaackiain (the 6aR,12aR stereoisomer). A phytoalexin found in pods of garden peas (Pisum sativum) and other plants of the pea family, including Tephrosia candida.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(+)-pisatin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(+)-pisatin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A quercetin O-glycoside that is quercetin with a beta-D-galactosyl residue attached at position 3. Isolated from Artemisia capillaris, it exhibits hepatoprotective activity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quercetin 3-O-beta-D-galactopyranoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67939 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000115>A pentacyclic triterpenoid that is beta-amyrin in which one of the hydrogens of the methyl group at position 28 has been replaced by a hydroxy group. It is a plant metabolite found in olive oil as well as in Rhododendron ferrugineum and other Rhododendron species.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>erythrodiol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67991 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36615"/>
        <obo:IAO_0000115>A ginsenoside found in Panax ginseng and Panax japonicus var. major that is dammarane which is substituted by hydroxy groups at the 3beta, 12beta and 20 pro-S positions, in which the hydroxy group at position 3 has been converted to the corresponding beta-D-glucopyranosyl-beta-D-glucopyranoside, and in which a double bond has been introduced at the 24-25 position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(20S)-ginsenoside Rg3</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(20S)-ginsenoside Rg3</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_68329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_68329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24676"/>
        <obo:IAO_0000115>A dimethoxybenzene that is 3,5-dimethyl ether derivative of gallic acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>syringic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">syringic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_68352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_68352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A quercetin O-glucoside that is quercetin with a beta-D-glucosyl residue attached at position 3. Isolated from Lepisorus contortus, it exhibits antineoplastic activityand has been found to decrease the rate of polymerization and sickling of red blood cells</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quercetin 3-O-beta-D-glucopyranoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_68428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_68428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26191"/>
        <obo:IAO_0000115>An alpha-D-glucoside consisting of D-glucitol having an alpha-D-glucosyl residue attached at the 4-position. Used as a sugar substitute.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>maltitol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">maltitol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_68465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_68465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24676"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_69304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_69304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A  proanthocyanidin found in Cinnamomum cassia and Cinnamomum zeylanicum.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cinnamtannin B-1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_69437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_69437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000115>A member of the class of  7-hydroxyisoflavones which consists of isoflavone substituted by hydroxy groups at positions 5, 7, 3&apos; and 4&apos;. It has been isolated from the mycelia of Cordyceps sinensis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>orobol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_69581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_69581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>Paeonol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Paeonol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_70082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_70082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18152"/>
        <obo:IAO_0000115>A glycosyloxyflavone that consists of myricetin attached to a alpha-L-rhamnopyranosyl residue at position 3 via a glycosidic linkage. Isolated from Myrica cerifera, it exhibits anti-allergic activity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>myricitrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">myricitrin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_70253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_70253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>4&apos;-O-methylepigallocatechin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">4&apos;-O-methylepigallocatechin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_70254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_70254">
