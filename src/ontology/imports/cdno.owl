        <obo:IAO_0000115>A class of glycerophospholipids in which a phosphatidyl group is esterified to the hydroxy group of ethanolamine.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phosphatidylethanolamine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phosphatidylethanolamine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
