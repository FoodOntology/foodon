        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cholesterol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cholesterol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_16119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64709"/>
        <obo:IAO_0000115>A cyclohexenecarboxylic acid that is cyclohex-1-ene-1-carboxylic acid substituted by hydroxy groups at positions 3, 4 and 5 (the 3R,4S,5R stereoisomer). It is an intermediate metabolite in plants and microorganisms.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>shikimic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">shikimic acid</rdfs:label>
    </owl:Class>
    


