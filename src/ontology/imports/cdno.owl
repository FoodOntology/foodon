        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>ketose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">ketose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>A branched-chain amino acid that consists of glycine in which one of the hydrogens attached to the alpha-carbon is substituted by an isobutyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>leucine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">leucine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>Any phenylpropanoid  derived from phenylalanine via dimerization of substituted cinnamic alcohols, known as monolignols, to a dibenzylbutane skeleton. Note that while individual members of the class have names ending ...lignane, ...lignene, ...lignadiene, etc., the class names lignan, neolignan, etc., do not end with an &quot;e&quot;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lignan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lignan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25681"/>
        <obo:IAO_0000115>A two-membered subclass of octadecatrienoic acid comprising the (9Z,12Z,15Z)- and (6Z,9Z,12Z)-isomers. Linolenic acids are nutrients essential to the formation of prostaglandins and are also used in making paints and synthetic resins.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>linolenic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">linolenic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>A diamino acid that is caproic (hexanoic) acid bearing two amino substituents at positions 2 and 6.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lysine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lysine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23652"/>
        <obo:IAO_0000115>A dextrin in which the D-glucose units are linked by alpha-(1-&gt;4) glycosidic bonds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>maltodextrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">maltodextrin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000012"/>
        <obo:IAO_0000115>An  alkylmercury compound in which the  alkyl group specified is methyl.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>methylmercury compound</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">methylmercury compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>Any terpenoid derived from a monoterpene. The term includes compounds in which the C10 skeleton of the parent monoterpene has been rearranged or modified by the removal of one or more skeletal atoms (generally methyl groups).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>monoterpenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">monoterpenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
        <obo:IAO_0000115>Any fatty acid with one double or triple bond in the fatty acid chain and singly bonded carbon atoms in the rest of the chain. MUFAs have positive effects on the cardiovascular system, and in diabetes treatment.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>monounsaturated fatty acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">monounsaturated fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>A monoterpenoid that is 6,6-dimethylbicyclo[3.1.1]hept-2-ene substituted by a carboxy group at position 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>myrtenic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72544"/>
        <obo:IAO_0000115>A polycyclic aromatic ketone metabolite of naphthalene.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>naphthoquinone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">naphthoquinone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>A phenylpropanoid that includes plant products formed primarily from oxidative coupling of two para-propylphenol moities. Unlike lignan, the units are coupled at  positions other than their beta-carbon atoms.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>neolignan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">neolignan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>An epoxycarotenoid that is 6,7-didehydro-5,5&apos;,6,6&apos;-tetrahydro-5&apos;,6&apos;-epoxy-beta,beta-carotene which is substituted by hydroxy groups at the 3, 3&apos;, and 5 positions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>neoxanthin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">neoxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000011"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>nitrogen atom</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">nitrogen atom</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25681 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26208"/>
        <obo:IAO_0000115>A family of polyunsaturated fatty acids that have in common a final carbon-carbon double bond in the omega-3 position, i.e., the third bond from the methyl end of the fatty acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>omega-3 fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25704 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000021"/>
        <obo:IAO_0000115>Compounds of the general formula SO3HOR where R is an organyl group</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>organic sulfate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">organic sulfate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_25863 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An anthocyanidin cation that is flavylium substituted by a hydroxy groups at positions 3, 5, 7 and 4&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pelargonidin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pelargonidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26848"/>
        <obo:IAO_0000115>Any organic aromatic compound with a structure based on a phenylpropane skeleton. The class includes naturally occurring phenylpropanoid esters, flavonoids, anthocyanins, coumarins and many small phenolic molecules as well as their semi-synthetic and synthetic analogues. Phenylpropanoids are also precursors of lignin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phenylpropanoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phenylpropanoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000018"/>
        <obo:IAO_0000115>A phosphorus oxoacid that consists of one oxo and three hydroxy groups joined covalently to a central phosphorus atom.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phosphoric acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phosphoric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23042"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phytoene</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phytoene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15889"/>
        <obo:IAO_0000115>Sterols similar to cholesterol which occur in plants and vary only in carbon side chains and/or presence or absence of a double bond.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phytosterols</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phytosterols</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000013"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <obo:IAO_0000115>A compound that contains two or more hydroxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>polyol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">polyol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>Members of the class of phenols that contain 2 or more benzene rings each of which is substituted by at least one hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>polyphenol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">polyphenol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
        <obo:IAO_0000115>Any fatty acid containing more than one double bond. Acids in this group are reported to have cardioprotective effects; and levels are lowered in chronic fatigue syndrome.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>polyunsaturated fatty acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">polyunsaturated fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78689"/>
        <obo:IAO_0000115>A flavonoid oligomer obtained by the the condensation of two or more units of hydroxyflavans.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>proanthocyanidin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">proanthocyanidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An alpha-amino acid that is pyrrolidine bearing a carboxy substituent at position 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>proline</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">proline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50753"/>
        <obo:IAO_0000115>Members of the class of benzofurochromene with a 6a,11a-dihydro-6H-[1]benzofuro[3,2-c]chromene skeleton and its substituted derivatives. They generally bear structural resemblance to isoflavanoids that possess antibiotic activity and are produced by plant tissues in response to infection. They are the 3,4-dihydroderivatives of coumestans.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pterocarpans</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pterocarpans</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64709"/>
        <obo:IAO_0000115>A cyclitol carboxylic acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quinic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">quinic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24174"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>rhamnogalacturonan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">rhamnogalacturonan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35381"/>
        <obo:IAO_0000115>A deoxymannose sugar that is the 6-deoxy derivative of hexose.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>rhamnose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">rhamnose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26607 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
        <obo:IAO_0000115>Any fatty acid containing no carbon to carbon multiple bonds. Known to produce adverse biological effects when ingested to excess.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>saturated fatty acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">saturated fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26658 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>Any terpenoid derived from a sesquiterpene. The term includes compounds in which the C15 skeleton of the parent sesquiterpene has been rearranged or modified by the removal of one or more skeletal atoms (generally methyl groups).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sesquiterpenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sesquiterpenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>Any terpenoid derived from a sesterterpene. The term includes compounds in which the C25 skeleton of the parent sesterterpene has been rearranged or modified by the removal of one or more skeletal atoms (generally methyl groups). Sometimes sesterterpenoids are erroneously referred to as sesterpenoids.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sesterterpenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26667 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <obo:IAO_0000115>Any of the N-acylneuraminic acids and their esters and other derivatives of the alcoholic hydroxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sialic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sialic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26709 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_32149"/>
        <obo:IAO_0000115>An inorganic sodium salt having hydrogensulfite as the counterion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sodium hydrogensulfite</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sodium hydrogensulfite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24866"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36093"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38702"/>
        <obo:IAO_0000115>An inorganic chloride salt having sodium(1+) as the counterion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sodium chloride</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sodium chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000013"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>stilbene</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">stilbene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26776 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26775"/>
        <obo:IAO_0000115>Any olefinic compound characterised by a 1,2-diphenylethylene backbone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>stilbenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">stilbenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
        <obo:IAO_0000115>Any of a group of astringent polyphenolic vegetable principles or compounds, chiefly complex glucosides of catechol and pyrogallol.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tannin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tannin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26849 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64709"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tartaric acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tartaric acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24913"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72544"/>
        <obo:IAO_0000115>Any isoprenoid that is a natural product or related compound formally derived from isoprene units. Terpenoids may contain oxygen in various functional groups. This class is subdivided according to the number of carbon atoms in the parent terpene. The skeleton of terpenoids may differ from strict additivity of isoprene units by the loss or shift of a fragment, generally a methyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>terpenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">terpenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>Any terpenoid derived from a tetraterpene. The term includes compounds in which the C40 skeleton of the parent tetraterpene has been rearranged or modified by the removal of one or more skeletal atoms (generally methyl groups).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tetraterpenoid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tetraterpenoid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75769"/>
        <obo:IAO_0000115>Any member of the group of 1,3-thiazolium cations that exhibit biological activity against vitamin B1 deficiency in animals. Symptoms of vitamin B1 deficiency include constipation, loss of apetite, fatigue, nausea, delirium, blurry vision and muscle weakness. Severe vitamin B1 deficiency can also lead to a disease known as beriberi. Vitamin B1 consists of the vitamer thiamin and its acid, aldehyde and phosphorylated derivatives (and their corresponding ionized, salt and hydrate forms).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>vitamin B1</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">vitamin B1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_26986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An alpha-amino acid in which one of the hydrogens attached to the alpha-carbon of glycine is substituted by a 1-hydroxyethyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>threonine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">threonine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33234"/>
        <obo:IAO_0000115>A collective name for a group of closely related lipids that contain a chroman-6-ol nucleus substituted at position 2 by a methyl group and by a saturated hydrocarbon chain consisting of three isoprenoid units. They are designated as alpha-, beta-, gamma-, and delta-tocopherol depending on the number and position of additional methyl substituents on the aromatic ring. Tocopherols occur in vegetable oils and vegetable oil products, almost exclusively with R,R,R configuration. Tocotrienols differ from tocopherols only in having three double bonds in the hydrocarbon chain.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tocopherol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tocopherol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36233"/>
        <obo:IAO_0000115>A disaccharide formed by a (1&lt;-&gt;1)-glycosidic bond between two units of D-glucose.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>trehalose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">trehalose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>A branched-chain amino acid that consists of glycine in which one of the hydrogens attached to the alpha-carbon is substituted by an isopropyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>valine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">valine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>An epoxycarotenol that is 5,5&apos;,6,6&apos;-tetrahydro-5,6:5&apos;,6&apos;-diepoxy-beta,beta-carotene substituted by hydroxy groups at positions 3 and 3&apos;. It is the naturally occurring xanthophyll pigment found in a variety of plants.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>violaxanthin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">violaxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000014"/>
        <obo:IAO_0000115>Any member of a group of fat-soluble hydroxy seco-steroids that exhibit biological activity against vitamin D deficiency. Vitamin D  can be obtained from sun exposure, food and supplements and is biologically inactive and converted into the biologically active calcitriol via double hydroxylation in the body.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>vitamin D</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">vitamin D</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75769"/>
        <obo:IAO_0000115>Any member of the group of pyridines that exhibit biological activity against vitamin B6 deficiency. Vitamin B6 deficiency is associated with microcytic anemia, electroencephalographic abnormalities, dermatitis with cheilosis (scaling on the lips and cracks at the corners of the mouth) and glossitis (swollen tongue), depression and confusion, and weakened immune function. Vitamin B6 consists of the vitamers pyridoxine, pyridoxal, and pyridoxamine and their respective 5&apos;-phosphate esters (and includes their corresponding ionized and salt forms).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>vitamin B6</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">vitamin B6</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23044"/>
        <obo:IAO_0000115>A subclass of carotenoids consisting of the oxygenated carotenes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>xanthophyll</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">xanthophyll</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>avenacin A-1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25681"/>
        <obo:IAO_0000115>A linolenic acid with cis-double bonds at positions 9, 12 and 15. Shown to have an antithrombotic effect.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>alpha-linolenic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lutein 5,6-epoxide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176842"/>
        <obo:IAO_0000115>An N-acyl-amino acid that is a form of the water-soluble vitamin B9. Its biologically active forms (tetrahydrofolate and others) are essential for nucleotide biosynthesis and homocysteine remethylation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>folic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">folic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38695"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38697"/>
        <obo:IAO_0000115>An anthocyanin cation that is cyanidin(1+) carrying a single beta-D-galactosyl substituent at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cyanidin 3-O-beta-D-galactoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000115>A hydroxyisoflavone that is daidzein bearing an additional hydroxy substituent at position 2&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>2&apos;-hydroxydaidzein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>A hydroxycoumarin that is coumarin substituted by a hydroxy group ay position 7.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>umbelliferone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28088"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>genistein 7-O-beta-D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>zeaxanthin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">zeaxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A dihydroxyflavanone that is flavanone substituted by hydroxy groups at positions 5 and 7 and a methoxy group at position 4&apos; (the 2S stereoisomer).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>4&apos;-methoxy-5,7-dihydroxyflavanone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">4&apos;-methoxy-5,7-dihydroxyflavanone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27566 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A trihydroxyflavanone having a structure of naringenin prenylated at C-6.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>6-prenylnaringenin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">6-prenylnaringenin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An alpha-amino acid that is propanoic acid bearing an amino substituent at position 2 and a 1H-imidazol-4-yl group at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>histidine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">histidine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27587 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24697"/>
        <obo:IAO_0000115>A member of the class of dihydroflavonols that is (2S)-flavanone substituted by hydroxy groups at positions 3, 7 and 4&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>garbanzol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27589 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166895"/>
        <obo:IAO_0000115>A proanthocyanidin obtained by the condensation of (-)-epicatechin and (+)-catechin units.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>procyanidin B4</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">procyanidin B4</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51867"/>
        <obo:IAO_0000115>A methyl ketone that is acetone in which one of the methyl groups has been replaced by a phenyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>acetophenone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">acetophenone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>An extended flavonoid that is 6,7-methylenedioxyflavanone substituted by methoxy groups at positions 5 and 2&apos; respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>betagarin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27680 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115>A heteroglycan consisting of a mannan backbone with galactose side groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>galactomannan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">galactomannan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27693 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26125"/>
        <obo:IAO_0000115>A member of the class of phytosterols that is stigmast-5-ene substituted by a beta-hydroxy group at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>sitosterol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">sitosterol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
        <obo:IAO_0000115>A trimethylxanthine in which the three methyl groups are located at positions 1, 3, and 7. A purine alkaloid that occurs naturally in tea and coffee.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>caffeine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">caffeine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>A vetispirane sesquiterpenoid that consists of (2R,5S,6S,8S,10R)-8-hydroxy-10-methyl-2-(prop-1-en-2-yl)spiro[4.5]decane bearing a formyl substituent at position 6.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lubimin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27781 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25413"/>
        <obo:IAO_0000115>A tetradecenoic acid in which the double bond is at the 9-10 position and has Z configuration. Myristoleic acid has been isolated from Serenoa repens and has cytotoxic and apoptosis-inducing effects.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>myristoleic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">myristoleic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27810 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33570"/>
        <obo:IAO_0000115>A  benzenediol that is benzene dihydroxylated at positions 1 and 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>resorcinol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">resorcinol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An anthocyanidin cation that is flavylium substituted at positions 3, 3&apos;, 4&apos;, 5 and 7 by hydroxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cyanidin cation</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cyanidin cation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27867 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27325"/>
        <obo:IAO_0000115>An  epoxycarotenol that is beta-carotene-3,3&apos;-diol in which one of the one of the endocyclic double bonds has been oxidised to the corresponding epoxide. It is a neutral yellow plant pigment found in Euglenophyta.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>antheraxanthin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26776"/>
        <obo:IAO_0000115>A stilbenol that is stilbene in which the phenyl groups are substituted at positions 3, 5, and 4&apos; by hydroxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>resveratrol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An alpha-amino acid that is alanine bearing an indol-3-yl substituent at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tryptophan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tryptophan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72572"/>
        <obo:IAO_0000115>Isoflavone in which the double bond between positions 2 and 3 has been reduced to a single bond.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>isoflavanone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">isoflavanone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A member of the class of cinnamaldehydes that is cinnamaldehyde substituted by a hydroxy group at position 4 and methoxy groups at positions 3 and 5.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(E)-sinapaldehyde</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(E)-sinapaldehyde</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27956 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22652"/>
        <obo:IAO_0000115>Dehydroascorbic acid having the L-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>L-dehydroascorbic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">L-dehydroascorbic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A glycosyloxyflavone that is luteolin substituted by a beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>luteolin 7-O-beta-D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25413"/>
        <obo:IAO_0000115>A 9-octadecenoic acid and the trans-isomer of oleic acid.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>elaidic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">elaidic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115>The most important reserve polysaccharide found in plants. It is a glucan consisting of amylose and amylopectin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>starch</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">starch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An aromatic amino acid that is alanine in which one of the methyl hydrogens is substituted by a phenyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>phenylalanine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">phenylalanine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115>A polydisperse highly branched polysaccharide derivative composed of chains of D-glucopyranose residues in alpha(1-&gt;4) glycosidic linkage. The chains are joined together by alpha(1-&gt;6) glycosidic linkages. A small number of alpha(1-&gt;3) glycosidic linkages and some 6-phosphate ester groups also may occur. The branches in amylopectin typically contain 24 to 30 glucose residues.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>amylopectin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">amylopectin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38697"/>
        <obo:IAO_0000115>A rutinoside consisting of cyanidin having the rutinosyl group at the 3-position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>cyanidin 3-O-rutinoside</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">cyanidin 3-O-rutinoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000115>A 7-hydroxyisoflavone with additional hydroxy groups at positions 5 and 4&apos;. It is a phytoestrogenic isoflavone with antioxidant properties.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>genistein</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">genistein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <obo:IAO_0000115>A bornane monoterpenoid that is 1,7,7-trimethylbicyclo[2.2.1]heptane substituted by a hydroxy group at position 2.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>borneol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
        <obo:IAO_0000115>A glucan composed of unbranched chains of D-glucopyranose residues in alpha(1-&gt;4) glycosidic linkage. The number of repeated glucose subunits (n) is usually in the range of 300 to 3000, but can be many thousands. One of the two components of starch (the other, 70-80%, being amylopectin). Cf. linear maltodextrin, in which the chain length is typically between 3 and 17 glucose units.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>amylose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">amylose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A dihydroxyflavanone in which the two hydroxy groups are located at positions 5 and 7. A natural product found in Piper sarmentosum and Cryptocarya chartacea.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pinocembrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">pinocembrin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
        <obo:IAO_0000115>A dimethylxanthine having the two methyl groups located at positions 1 and 3. It is structurally similar to caffeine and is found in green and black tea.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>theophylline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26004"/>
        <obo:IAO_0000115>A member of the class of coumarins that is umbelliferone in which the hydroxy group at position 7 is replaced by an ethoxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>7-ethoxycoumarin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000115>A member of the class of 7-hydroxyisoflavones that is 7-hydroxyisoflavone substituted by an additional hydroxy group at position 4&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>daidzein</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">daidzein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A trihydroxyflavanone having the three hydroxy gropus located at the 3&apos;-, 5- and 7-positions and an additional methoxy substituent at the 4&apos;-position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>hesperetin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">hesperetin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35381"/>
        <obo:IAO_0000115>An aldohexose that is the C-4 epimer of glucose.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>galactose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">galactose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33261"/>
        <obo:IAO_0000115>A 2-carbon sulfoxide in which the sulfur atom has two methyl substituents.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>dimethyl sulfoxide</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dimethyl sulfoxide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26658"/>
        <obo:IAO_0000115>An eremophilane sesquiterpenoid that is (+)-5-epi-aristolochene bearing additional 1beta- and 3alpha-hydroxy substituents. It is a phytoalexin produced in Nicotiana and Capsicum plant species in response to pathogen attack.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>capsidiol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">capsidiol </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A quercetin O-glucoside in which a glucofuranosyl residue is attached at position 3 of quercetin via a beta-glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quercetin 3-O-beta-D-glucofuranoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>An alpha-amino acid that consists of butyric acid bearing an amino substituent at position 2 and a carbamoyl substituent at position 4.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>glutamine</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">glutamine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A flavanone 7-O-beta-D-glucoside that is (S)-naringenin substituted by a beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>naringenin 7-O-beta-D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
        <obo:IAO_0000115>A phenethylamine alkaloid that is phenethylamine substituted at positions 3, 4 and 5 by methoxy groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>mescaline</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">mescaline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000014"/>
        <obo:IAO_0000115>Any member of a group of fat-soluble 2-methyl-1,4-napthoquinones that exhibit biological activity against vitamin K deficiency. Vitamin K is required for the synthesis of prothrombin and certain other blood coagulation factors.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>vitamin K</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">vitamin K</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A tetrahydroxyflavanone that is flavanone substituted by hydroxy groups at positions 5, 7, 3&apos; and 4&apos; respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>eriodictyol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">eriodictyol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23042"/>
        <obo:IAO_0000115>A cyclic carotene with a beta- and an epsilon-ring at opposite ends respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>alpha-carotene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_61266"/>
        <obo:IAO_0000115>A member of the class of arabinoxylans that consists of a polymer chain of beta-(1-&gt;4)-linked D-xylopyranose units, many of which are 2- or 3-substituted, or 2,3-disubstituted by alpha-L-arabinofuranosyl residues.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>arabinoxylan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">arabinoxylan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47916"/>
        <obo:IAO_0000115>An anthocyanidin cation consisting of benzopyrylium with hydroxy substituents at the 3-, 5- and 7-positions and a 3,4,5-trihydroxyphenyl group at the 2-position. It is a plant pigment responsible for the colours of the plants of the genera Viola and Delphinium.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>delphinidin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">delphinidin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28478 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A hydroxy monocarboxylic acid that is acetic acid in which one of the methyl hydrogens is substituted by a 2-hydroxyphenyl group. It is a metabolite of phenylalanine and is excreted in the urine of patients suffering from diseases like phenylketonuria.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(2-hydroxyphenyl)acetic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(2-hydroxyphenyl)acetic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28802"/>
        <obo:IAO_0000115>A tetrahydroxyflavone in which the four hydroxy groups are located at positions 3, 5, 7 and 4&apos;. Acting as an antioxidant by reducing oxidative stress, it is currently under consideration as a possible cancer treatment.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>kaempferol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">kaempferol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38695"/>
        <obo:IAO_0000115>An anthocyanidin chloride that has pelargonidin as the cationic counterpart.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>pelargonidin chloride</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24698"/>
        <obo:IAO_0000115>A rutinoside that is quercetin with the hydroxy group at position C-3 substituted with glucose and rhamnose sugar groups.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>rutin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000047"/>
        <obo:IAO_0000115>A hexasaccharide that is verbascose which has an additional unit of alpha-D-galactopyranose attached by a 1-&gt;6 glycosidic linkage to the terminal galactosyl residue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>ajugose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">ajugose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_74961"/>
        <obo:IAO_0000115>A pentasaccharide that is stachiose which has an additional unit of alpha-D-galactopyranose attached by a 1-&gt;6 glycosidic linkage to the terminal galactosyl residue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>verbascose</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">verbascose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A  monomethoxybenzene that consists of phenol with a methoxy substituent at the ortho position.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>guaiacol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">guaiacol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26658"/>
        <obo:IAO_0000115>A farnesane sesquiterpenoid that is dodeca-2,6,10-triene substituted by methyl groups at positions 3, 7 and 11 and a hydroxy group at position 1.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>farnesol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">farnesol </rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166888"/>
        <obo:IAO_0000115>A 3beta-sterol consisting of stigmastan-3beta-ol with double bonds at positions 5 and 24(28). The double bond at postion 24(28) adopts a Z-configuration.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>isofucosterol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">isofucosterol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38755"/>
        <obo:IAO_0000115>A member of the class of 7-hydroxyisoflavones that is 7-hydroxyisoflavone substituted by additional hydroxy groups at positions 5, 2&apos; and 4&apos; and a prenyl group at position 3&apos;.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>licoisoflavone A</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26125"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>campesterol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">campesterol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18135"/>
        <obo:IAO_0000115>A monocarboxylic acid that is propionic acid substituted at position 3 by a phenyl group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3-phenylpropionic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28647 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18135"/>
        <obo:IAO_0000115>A member of the class of benzoic acids that is gallic acid in which the phenolic hydroxy group at position 3 is converted into the corresponding methyl ether.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3-O-methylgallic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28661 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36009"/>
        <obo:IAO_0000115>A C18, omega-6 acid fatty acid comprising a linolenic acid having cis- double bonds at positions 6, 9 and 12.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>gamma-linolenic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5070"/>
        <obo:IAO_0000115>A disaccharide derivative that is (S)-naringenin substituted by a 6-O-(6-deoxy-alpha-L-mannopyranosyl)-beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>narirutin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">narirutin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28709 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28412"/>
        <obo:IAO_0000115>A disaccharide derivative that consists of eriodictyol substituted by a 6-O-(alpha-L-rhamnopyranosyl)-beta-D-glucopyranosyl moiety at position 7 via a glycosidic linkage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>eriocitrin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">eriocitrin</rdfs:label>
    </owl:Class>
    


