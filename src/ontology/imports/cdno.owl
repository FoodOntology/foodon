        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26125"/>
        <obo:IAO_0000115>A phytosterol consisting of ergostane having double bonds at the 5,6-, 7,8- and 22,23-positions as well as a 3beta-hydroxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>ergosterol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">ergosterol</rdfs:label>
    </owl:Class>
    


