    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000033"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37163"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">resistant glucan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000033"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000037"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000039"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000047"/>
        <obo:IAO_0000115 xml:lang="en">A nondigestible oligosaccharide composed of a backbone of β-(1→4)-linked d-xylopyranosyl residues partially substituted with arabinofuranosyl side chains.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">arabinoxylan-oligosaccharide</rdfs:label>
    </owl:Class>
    


