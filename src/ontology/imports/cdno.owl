        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18135"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_140677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_140677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17579"/>
        <obo:IAO_0000115>A beta-carotene carrying one additional hydroxy substituent at position 4.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>4-hydroxy-all-trans-beta-carotene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_141540 -->

