        <obo:IAO_0000115>A sulfur-containing amino acid that is propanoic acid with an amino group at position 2 and a sulfanyl group at position 3.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
