        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>4&apos;-O-methylepigallocatechin-3-O-gallate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">4&apos;-O-methylepigallocatechin-3-O-gallate</rdfs:label>
    </owl:Class>
    


