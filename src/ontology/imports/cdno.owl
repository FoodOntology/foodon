        <obo:IAO_0000115>A gallate ester resulting from the formal condensation of gallic acid with the (5R)-hydroxy group of (-)-quinic acid (i.e. the hydroxy group on the same side of the cyclohexane ring as the carboxy group).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>theogallin</rdfs:label>
    </owl:Class>
    


