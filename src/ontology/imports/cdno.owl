        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3&apos;-O-methylepicatechin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">3&apos;-O-methylepicatechin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_70255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_70255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23053"/>
        <obo:IAO_0000115>A gallate ester obtained by formal condensation of the carboxy group of gallic acid with the (3R)-hydroxy group of epicatechin. A natural product found in Parapiptadenia rigida.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>(-)-epicatechin-3-O-gallate</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">(-)-epicatechin-3-O-gallate</rdfs:label>
    </owl:Class>
    


