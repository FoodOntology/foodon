    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176839"/>
        <obo:IAO_0000115>A pyridinemonocarboxylic acid that is pyridine in which the hydrogen at position 3 is replaced by a carboxy group.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>nicotinic acid</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">nicotinic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_15948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23042"/>
        <obo:IAO_0000115>An acyclic carotene commonly obtained from tomatoes and other red fruits.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>lycopene</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">lycopene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_15956 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176841"/>
        <obo:IAO_0000115>An organic heterobicyclic compound that consists of 2-oxohexahydro-1H-thieno[3,4-d]imidazole having a valeric acid substituent attached to the tetrahydrothiophene ring. The parent of the class of biotins.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>biotin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">biotin</rdfs:label>
    </owl:Class>
    


