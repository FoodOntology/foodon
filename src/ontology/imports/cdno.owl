        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33235"/>
        <obo:IAO_0000115>A tocotrienol that is chroman-6-ol substituted by methyl groups at positions 2, 5 and 8 and a farnesyl chain at position 2. It has been isolated from various cultivars of wheat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>beta-tocotrienol</rdfs:label>
