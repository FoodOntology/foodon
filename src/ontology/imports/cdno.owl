        <rdfs:label>Myricanone</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">Myricanone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_142263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_142263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38697"/>
