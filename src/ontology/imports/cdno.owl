        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28802"/>
        <obo:IAO_0000115>A pentahydroxyflavone having the five hydroxy groups placed at the 3-, 3&apos;-, 4&apos;-, 5- and 7-positions. It is one of the most abundant flavonoids in edible vegetables, fruit and wine.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>quercetin</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">quercetin</rdfs:label>
    </owl:Class>
    


