        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_61266"/>
        <obo:IAO_0000115>A heteroglycan consisting of beta-(1-&gt;4)-linked D-glucose (G) and D-mannose (M) in a proportion of 5:8. The basic polymeric repeating unit has the pattern: GGMMGMMMMMGGM, with branching through beta-(1-&gt;3)- and beta-(1-&gt;6)-glucosyl linkages. Acetate groups are present on C-6 every 9-19 units of the main chain.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>glucomannan</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">glucomannan</rdfs:label>
    </owl:Class>
    


