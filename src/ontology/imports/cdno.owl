        <obo:IAO_0000115>A glycosylfructose that is D-fructofuranose attached to a alpha-D-glucopyranosyl unit at position 6 via a glycosidic linkage. It is found in honey and sugarcane.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>6-O-alpha-D-glucopyranosyl-D-fructofuranose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_18404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_18404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18135"/>
        <obo:IAO_0000115>A methylcatechol carrying a methyl substituent at position 3. It is a xenobiotic metabolite produced by some bacteria capable of degrading nitroaromatic compounds present in pesticide-contaminated soil samples.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>3-methylcatechol</rdfs:label>
    </owl:Class>
    


