        <obo:IAO_0000115>A member of the class of coumarins that is umbelliferone sulfate which carries a methyl group at position 4. It is a metabolite of 4-methylumbelliferone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
