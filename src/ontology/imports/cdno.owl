    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33234"/>
        <obo:IAO_0000115>A tocol in which the hydrocarbon chain at position 2 contains three double bonds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label>tocotrienol</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">tocotrienol</rdfs:label>
    </owl:Class>
    


