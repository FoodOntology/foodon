    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <obo:IAO_0000115 xml:lang="en">A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <obo:IAO_0000115 xml:lang="en">An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label xml:lang="en">material entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that is ingested and contributes to survival, growth and development</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dietary chemical component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Material which remains after the removal of water from plant matter.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dry plant matter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <obo:IAO_0000115 xml:lang="en">Carbohydrates that are absorbed in the small intestine and provide carbohydrate for metabolism in monogastric animals.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">available carbohydrate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">Available carbohydrate in monosaccharide and disaccharide form</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">free sugar</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A carbohydrate or associated lignin that resists hydrolytic digestion in the small intestine of humans and other monogastric species, with fermentative digestion in the large intestine</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre which dissolves in water and is partially or completely fermented in the colon of monogastric animals by gut bacteria.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">soluble dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">A portion of starch that cannot be digested by amylases in the small intestine</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">resistant starch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Dietary fibre which does not dissolve in water and is inert to digestive enzymes in the upper gastrointestinal tract of monogastric animals, with variable fermentability in the large bowel.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">insoluble dietary fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000115 xml:lang="en">A protein that accumulates in developing seeds or grains.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">seed storage protein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_167164"/>
        <obo:IAO_0000115 xml:lang="en">A mineral nutrient that represents a major proportion of the minerals required in the diet</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">macro element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_167164"/>
        <obo:IAO_0000115 xml:lang="en">Mineral nutrient that is present in a very low concentration within the diet</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">trace element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A plant metabolite that is not essential for growth or division of plant cells.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">plant secondary metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDNO_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDNO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDNO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">An organic molecule that has a vitamin(role)</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cdno.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/XML/1998/namespacestring">vitamin (molecular entity)</rdfs:label>
