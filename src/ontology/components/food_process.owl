AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03311126 "Food material which is raw."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03311126 "food (raw)"@en)
SubClassOf(obo:FOODON_03311126 obo:FOODON_00002454)

