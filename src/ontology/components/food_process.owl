AnnotationAssertion(rdfs:comment obo:FOODON_03311631 "How to distinguish from food (baked)?"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03311631 "baked good"@en)
SubClassOf(obo:FOODON_03311631 obo:FOODON_00001626)

# Class: obo:FOODON_03316043 (food (heat-treated))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03316043 "Food material which has undergone heating."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03316043 "food (heat-treated)"@en)
SubClassOf(obo:FOODON_03316043 obo:FOODON_00002454)

# Class: obo:FOODON_03430102 (liquid, higher viscosity)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430102 "A liquid that flows slowly at room temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430102 "Destined for PATO"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430102 "liquid, higher viscosity"@en)
SubClassOf(obo:FOODON_03430102 obo:ENVO_01001690)

# Class: obo:FOODON_03430109 (liquid, lower viscosity)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430109 "A liquid that flows very easily at room temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430109 "Destined for PATO"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430109 "liquid, lower viscosity"@en)
SubClassOf(obo:FOODON_03430109 obo:ENVO_01001690)

# Class: obo:FOODON_03430130 (food (liquid))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430130 "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430130 "food (liquid)"@en)
SubClassOf(obo:FOODON_03430130 obo:ENVO_01001690)
SubClassOf(obo:FOODON_03430130 obo:FOODON_00002454)

# Class: obo:FOODON_03430137 (sliced)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430137 "A characteristic of food material which has been cut to an even thickness (height) which is smaller than its width and length."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430137 "sliced"@en)
SubClassOf(obo:FOODON_03430137 obo:FOODON_00002470)

# Class: obo:FOODON_03440014 (fully heat-treated)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03440014 "A characteristic of food material which indicates that it has been heat-treated throughout, leaving no part raw."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440014 "fully heat-treated"@en)
SubClassOf(obo:FOODON_03440014 obo:FOODON_03440022)

# Class: obo:FOODON_03440018 (partially heat-treated)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03440018 "A characteristic of food material which indicates that part of its material has undergone heating."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440018 "partially heat-treated"@en)
SubClassOf(obo:FOODON_03440018 obo:FOODON_03440022)

# Class: obo:FOODON_03440022 (heat-treated)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03440022 "A characteristic of food material which indicates that it has undergone a heating cycle at least once."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03440022 "syn. heated"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440022 "heat-treated"@en)
SubClassOf(obo:FOODON_03440022 obo:PATO_0001241)

# Class: obo:FOODON_03450002 (food cooking by heating)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450002 "A food cooking process in which food material undergoes heating."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450002 "food cooking by heating"@en)
SubClassOf(obo:FOODON_03450002 obo:FOODON_00005709)
SubClassOf(obo:FOODON_03450002 obo:FOODON_03000548)

# Class: obo:FOODON_03450004 (cooking by dry heat)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450004 "Cooked at moderate to high levels of heat in which no liquid is added and only small amounts of fat may be added to prevent sticking."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450004 "cooking by dry heat"@en)
SubClassOf(obo:FOODON_03450004 obo:FOODON_03450002)

# Class: obo:FOODON_03450005 (food baking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450005 "Cooked without moisture, covered or uncovered, in an oven."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03450005 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_03450005 "food baking"@en)
SubClassOf(obo:FOODON_03450005 obo:FOODON_03450004)

# Class: obo:FOODON_03450006 (broiling or grilling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450006 "Cooked without moisture under or over intense direct heat."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450006 "broiling or grilling"@en)
SubClassOf(obo:FOODON_03450006 obo:FOODON_03450004)

# Class: obo:FOODON_03450007 (charcoal broiling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450007 "Cooked without moisture over direct heat from a charcoal fire."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450007 "charcoal broiling"@en)
SubClassOf(obo:FOODON_03450007 obo:FOODON_03450006)

# Class: obo:FOODON_03450008 (griddle cooking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450008 "Cooking on a flat surface at medium heat with only a sufficient amount of fat used to prevent sticking."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450008 "griddle cooking"@en)
SubClassOf(obo:FOODON_03450008 obo:FOODON_03450004)

# Class: obo:FOODON_03450009 (cooked by popping)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450009 "Cooking by agitating the food over a dry, high heat source, resulting in exploding."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450009 "cooked by popping"@en)
SubClassOf(obo:FOODON_03450009 obo:FOODON_03450004)

# Class: obo:FOODON_03450010 (food toasting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450010 "Cooking with direct heat until the surface of the food is browned, usually associated with bread or sandwiches."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450010 "food toasting"@en)
SubClassOf(obo:FOODON_03450010 obo:FOODON_03450004)

# Class: obo:FOODON_03450011 (cooking by microwave)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450011 "Cooking in a microwave oven."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450011 "cooking by microwave"@en)
SubClassOf(obo:FOODON_03450011 obo:FOODON_03450002)

# Class: obo:FOODON_03450012 (cooking by moist heat)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450012 "Cooking in varying amounts of water, water-based liquid or steam."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450012 "LanguaL curation note: If the food absorbs a significant amount of water, also used *REHYDRATED* or *WATER ADDED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450012 "cooking by moist heat"@en)
SubClassOf(obo:FOODON_03450012 obo:FOODON_03450002)

# Class: obo:FOODON_03450013 (cooking in water or water-based liquid)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450013 "A process of cooking by moist heat which is effected by hot water or water-based liquid in a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450013 "cooking in water or water-based liquid"@en)
SubClassOf(obo:FOODON_03450013 obo:FOODON_03450012)

# Class: obo:FOODON_03450014 (boiling in container)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450014 "A cooking in water or water-based liquid process in which the liquid is boiling."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450014 "Water at standard atmospheric pressure (in other words, at sea level) will boil at a temperature of 100 degrees C (212 degrees F)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450014 "boiling in container"@en)
SubClassOf(obo:FOODON_03450014 obo:FOODON_03450013)

# Class: obo:FOODON_03450015 (boiling and then draining)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450015 "A boiling in container process which concludes with draining liquid as a separate output."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450015 "boiling and then draining"@en)
SubClassOf(obo:FOODON_03450015 obo:FOODON_03450014)

# Class: obo:FOODON_03450016 (boiling in large amount of liquid)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450016 "A boiling in container process involving a liquid to solid ratio greater than 2:1."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450016 "boiling in large amount of liquid"@en)
SubClassOf(obo:FOODON_03450016 obo:FOODON_03450014)

# Class: obo:FOODON_03450017 (boiling in small amount of liquid)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450017 "A boiling in container process involving a liquid to solid ratio less than or equal to 2:1."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450017 "boiling in small amount of liquid"@en)
SubClassOf(obo:FOODON_03450017 obo:FOODON_03450014)

# Class: obo:FOODON_03450018 (boiling without draining)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450018 "A boiling in container process which concludes with the liquid partly or fully incorporated into the food material being cooked."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450018 "boiling without draining"@en)
SubClassOf(obo:FOODON_03450018 obo:FOODON_03450014)

# Class: obo:FOODON_03450019 (braising)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450019 "Browned initially in fat or oil and then tightly covered and cooked over low heat in a small amount of water."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450019 "braising"@en)
SubClassOf(obo:FOODON_03450019 obo:FOODON_03450013)

# Class: obo:FOODON_03450020 (simmering)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450020 "Cooking in a moderate amount of liquid at just below the liquid's boiling point."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450020 "simmering"@en)
SubClassOf(obo:FOODON_03450020 obo:FOODON_03450013)

# Class: obo:FOODON_03450021 (cooking in steam)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450021 "Cooked in a container containing steam."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450021 "cooking in steam"@en)
SubClassOf(obo:FOODON_03450021 obo:FOODON_03450012)

# Class: obo:FOODON_03450022 (steaming with pressure)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450022 "Cooked in a pressure cooker."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450022 "steaming with pressure"@en)
SubClassOf(obo:FOODON_03450022 obo:FOODON_03450021)

# Class: obo:FOODON_03450023 (steaming without pressure)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450023 "Cooked suspended above boiling water."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450023 "steaming without pressure"@en)
SubClassOf(obo:FOODON_03450023 obo:FOODON_03450021)

# Class: obo:FOODON_03450024 (cooking with fat or oil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450024 "A food cooking method that subjects the food to full or partial immersion in hot oil as the medium for heat transfer."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450024 "cooking with fat or oil"@en)
SubClassOf(obo:FOODON_03450024 obo:FOODON_03000548)

# Class: obo:FOODON_03450025 (cooking with added fat or oil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450025 "Cooked by adding fat or oil to those foods that do not contain fat or oil that would render during the cooking process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450025 "cooking with added fat or oil"@en)
SubClassOf(obo:FOODON_03450025 obo:FOODON_03450024)

# Class: obo:FOODON_03450026 (cooking in small amount of fat or oil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450026 "Cooked with sufficient fat or oil to coat and moisten the food being prepared, but not cooked in enough fat or oil to immerse the food."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03450026 <http://purl.obolibrary.org/obo/FOODON:03450008>)
AnnotationAssertion(rdfs:comment obo:FOODON_03450026 "Use *griddle cooking* when only enough fat or oil is used to prevent sticking."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450026 "cooking in small amount of fat or oil"@en)
SubClassOf(obo:FOODON_03450026 obo:FOODON_03450025)

# Class: obo:FOODON_03450027 (sautéing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450027 "Cooking in a very small amount of very hot fat, turning and browning the food on all sides."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450027 "Not committing to water or oil/fat.  Modern def!  Get sources... https://www.lecreuset.ca/en_CA/glossary/Saut%C3%A9ing.html"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450027 "sautéing"@en)
SubClassOf(obo:FOODON_03450027 obo:FOODON_03450026)
SubClassOf(obo:FOODON_03450027 ObjectSomeValuesFrom(obo:OBI_0000299 obo:FOODON_03000594))

# Class: obo:FOODON_03450028 (stir-frying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450028 "Cooked by frying foods quickly over high heat, stirring constantly. Only enough cooking oil is used to coat the bottom of the pan."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450028 "stir-frying"@en)
SubClassOf(obo:FOODON_03450028 obo:FOODON_03450026)

# Class: obo:FOODON_03450029 (deep-frying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450029 "Cooked in hot fat or oil deep enough to immerse the food entirely."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450029 "deep-frying"@en)
SubClassOf(obo:FOODON_03450029 obo:FOODON_03450025)
SubClassOf(obo:FOODON_03450029 ObjectSomeValuesFrom(obo:OBI_0000299 obo:FOODON_03307052))

# Class: obo:FOODON_03450030 (cooking with inherent fat or oil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450030 "Cooked in fat or oil rendered from the food being prepared."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450030 "cooking with inherent fat or oil"@en)
SubClassOf(obo:FOODON_03450030 obo:FOODON_03450024)

# Class: obo:FOODON_03450031 (heating of container by immersion in water or steam)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450031 "A heating of container where the container is closed, such as a pouch, and is immersed in hot water or steam."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450031 "heating of container by immersion in water or steam"@en)
SubClassOf(obo:FOODON_03450031 obo:FOODON_03450032)

# Class: obo:FOODON_03450032 (heating of container)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450032 "A food cooking method in which heat is transferred to the outside of a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450032 "heating of container"@en)
SubClassOf(obo:FOODON_03450032 obo:FOODON_03000548)

# Class: obo:FOODON_03450033 (heating of container in double boiler)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450033 "Heating a container that is placed in another container filled with boiling water."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450033 "heating of container in double boiler"@en)
SubClassOf(obo:FOODON_03450033 obo:FOODON_03450032)

# Class: obo:FOODON_03450034 (heating of container by water bath)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450034 "Heating a container that is placed in another container filled with water kept near the boiling point."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450034 "heating of container by water bath"@en)
SubClassOf(obo:FOODON_03450034 obo:FOODON_03450032)

# Class: obo:FOODON_03450035 (shallow frying (sensu chinese cooking))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450035 "A chinese cooking technique similar to sauteing in which thick slices or chunks of floured or battered ingredients are slow seared over moderate to low heat."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03450035 <https://openlibrary.org/books/OL4538013M/The_key_to_Chinese_cooking>)
AnnotationAssertion(rdfs:label obo:FOODON_03450035 "shallow frying (sensu chinese cooking)"@en)
SubClassOf(obo:FOODON_03450035 obo:FOODON_03450025)

# Class: obo:FOODON_03450036 (steeping)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450036 "Extracting flavor and other components from food sources by immersion in water, usually at near-boiling temperature."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450036 "steeping"@en)
SubClassOf(obo:FOODON_03450036 obo:FOODON_03450013)

# Class: obo:FOODON_03450037 (food reheating)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450037 "A process to bring an already fully cooked product to serving temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450037 "LanguaL curation note: Do not use for a process that completes the cooking of a partially cooked food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450037 "food reheating"@en)
SubClassOf(obo:FOODON_03450037 obo:FOODON_00005709)

# Class: obo:FOODON_03450038 (food reheating by microwave)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450038 "A food reheating process by application of microwaving"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450038 "food reheating by microwave"@en)
SubClassOf(obo:FOODON_03450038 obo:FOODON_03450037)

# Class: obo:FOODON_03450039 (food reheating by dry heat)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450039 "A food reheating process by application of dry heat"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450039 "food reheating by dry heat"@en)
SubClassOf(obo:FOODON_03450039 obo:FOODON_03450037)

# Class: obo:FOODON_03450040 (food reheating by boil-in-bag)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450040 "A food reheating process by application of boiling water."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450040 "food reheating by boil-in-bag"@en)
SubClassOf(obo:FOODON_03450040 obo:FOODON_03450037)

# Class: obo:FOODON_03450041 (food reheating in pan or cooking utensil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450041 "A food reheating process involving use of a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450041 "food reheating in pan or cooking utensil"@en)
SubClassOf(obo:FOODON_03450041 obo:FOODON_03450037)

# Class: obo:FOODON_03450043 (double steaming)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450043 "A Chinese cooking technique to prepare delicate food such as bird nests, shark fins, etc. The food is covered with water and put in a covered ceramic jar and the jar is then steamed for several hours."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03450043 wikipedia:Double_steaming)
AnnotationAssertion(rdfs:comment obo:FOODON_03450043 "This technique ensures there is no loss of liquid or moisture (its essences) from the food being cooked, hence it is often used with expensive ingredients like Chinese herbal medicines. [Wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450043 "double steaming"@en)
SubClassOf(obo:FOODON_03450043 obo:FOODON_03450014)

# Class: obo:FOODON_03450044 (rotisserie roasting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450044 "Rotisserie is a style of roasting where meat is skewered on a spit and revolves over a flame or other heat source."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03450044 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03450044 "The rotation cooks the meat evenly in its own juices and allows easy access for continuous basting if desired. [Wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450044 "rotisserie roasting"@en)
SubClassOf(obo:FOODON_03450044 obo:FOODON_03000566)

# Class: obo:FOODON_03450045 (searing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450045 "Searing is a technique used in grilling, roasting, braising, sautéing, etc. that cooks the surface of the food at high temperature so that a brownish crust forms by Maillard reaction and denaturation of proteins."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450045 "A similar technique, browning, is typically used to sear or brown all sides of a particular piece of meat, fish, poultry, etc. before finishing it in the oven. To obtain the desired brown crust, the meat surface must exceed 300 °F (150 °C), so searing requires the meat surface be free of water, which boils at around 212 °F (100 °C)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450045 "searing"@en)
SubClassOf(obo:FOODON_03450045 obo:FOODON_03450006)

# Class: obo:FOODON_03450046 (blind baking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450046 "A food baking process in which a pie crust or other pastry is baked without a filling."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03450046 wikipedia:Blind-baking)
AnnotationAssertion(rdfs:comment obo:FOODON_03450046 "LanguaL curation note: Use when a pie crust or other pastry is baked without the filling."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450046 "blind baking"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03450046 <https://www.seriouseats.com/how-to-blind-bake-a-pie-crust>)
SubClassOf(obo:FOODON_03450046 obo:FOODON_03450005)

# Class: obo:FOODON_03450047 (pressure frying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03450047 "A cooking process with added fat or oil in which food material is brought to high temperatures while pressure is held high enough that the water within a cooking container is prevented from boiling off."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03450047 "LanguaL curation note: Use when e.g. meat and cooking oil are brought to high temperatures while pressure is held high enough that the water within is prevented from boiling off."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03450047 "pressure frying"@en)
SubClassOf(obo:FOODON_03450047 obo:FOODON_03450025)

# Class: obo:FOODON_03460101 (lactic acid fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460101 "A food fermentation process in which lactic acid bacteria (LAB) convert carbohydrates into energy and lactic acid."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460101 "lactic acid fermentation"@en)
SubClassOf(obo:FOODON_03460101 obo:FOODON_03460256)

# Class: obo:FOODON_03460102 (proteolytic fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460102 "A food fermentation process in which proteolytic bacteria participate in fermentation by generating protease enzymes which break down protiens in food material."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460102 "proteolytic fermentation"@en)
SubClassOf(obo:FOODON_03460102 obo:FOODON_00001304)

# Class: obo:FOODON_03460103 (component substitution)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460103 "A material processing in which a component of a material is removed and replaced by another material."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460103 "LanguaL curation note: Use the appropriate narrower term for a food product that was prepared from a natural food product by removing an endogeneous component and adding a component of the same class. Index the specific component added under *INGREDIENT ADDED*, regardless of its level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460103 "component substitution"@en)
SubClassOf(obo:FOODON_03460103 obo:COB_0000110)

# Class: obo:FOODON_03460106 (food noncertified color addition)

AnnotationAssertion(rdfs:comment obo:FOODON_03460106 "LanguaL curation note: Used when a color is added that is exempt from certification and considered safe for use."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460106 "food noncertified color addition"@en)
SubClassOf(obo:FOODON_03460106 obo:FOODON_03460150)

# Class: obo:FOODON_03460107 (lactic acid-other agent fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460107 "A food fermentation process in which carbohydrates are converted into energy and lactic acid by microbials other than lactic acid bacteria."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460107 "lactic acid-other agent fermentation"@en)
SubClassOf(obo:FOODON_03460107 obo:FOODON_00001304)

# Class: obo:FOODON_03460109 (artificial carbonation)

AnnotationAssertion(rdfs:comment obo:FOODON_03460109 "LanguaL curation note: Used when carbon dioxide has been added to a food product at any level. https://orcid.org/0000-0002-8844-9165's note: converted to a process"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460109 "artificial carbonation"@en)
SubClassOf(obo:FOODON_03460109 obo:FOODON_03460175)

# Class: obo:FOODON_03460111 (food treatment)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460111 "Used to specifically characterize a food product based on the treatment or processes applied to the product or any indexed ingredient. The processes include adding, substituting or removing components or modifying the food or component, e.g., through fermentation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460111 "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460111 "food treatment"@en)
SubClassOf(obo:FOODON_03460111 obo:FOODON_00002451)

# Class: obo:FOODON_03460112 (water removal to reconstitution ratio 3 plus 1 or higher)

AnnotationAssertion(rdfs:label obo:FOODON_03460112 "water removal to reconstitution ratio 3 plus 1 or higher"@en)
SubClassOf(obo:FOODON_03460112 obo:FOODON_03460138)

# Class: obo:FOODON_03460113 (water removal to reconstitution ratio 2 plus 1)

AnnotationAssertion(rdfs:label obo:FOODON_03460113 "water removal to reconstitution ratio 2 plus 1"@en)
SubClassOf(obo:FOODON_03460113 obo:FOODON_03460138)

# Class: obo:FOODON_03460114 (water removal to reconstitution ratio 1 plus 1)

AnnotationAssertion(rdfs:label obo:FOODON_03460114 "water removal to reconstitution ratio 1 plus 1"@en)
SubClassOf(obo:FOODON_03460114 obo:FOODON_03460138)

# Class: obo:FOODON_03460119 (microbial/enzymatic modification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460119 "A food modification by microbial or enzymatic action which results in molecular changes in any food component."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460119 "LanguaL curation note: If salt, sugar or other food additive is used to aid in the modification, index it by the appropriate term under *INGREDIENT ADDED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460119 "microbial/enzymatic modification"@en)
SubClassOf(obo:FOODON_03460119 obo:FOODON_03460141)

# Class: obo:FOODON_03460121 (food irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460121 "A physical/chemical modification in which a food product or component is irradiated for any purpose."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460121 "There are three kinds of irradiation that can be applied to food: gamma, electron-beam, and X-ray"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460121 "food irradiation"@en)
SubClassOf(obo:FOODON_03460121 obo:FOODON_03460130)

# Class: obo:FOODON_03460123 (alcohol-acetic acid fermentation)

AnnotationAssertion(rdfs:label obo:FOODON_03460123 "alcohol-acetic acid fermentation"@en)
SubClassOf(obo:FOODON_03460123 obo:FOODON_03460256)

# Class: obo:FOODON_03460127 (lipolytic fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460127 "A food fermentation process in which microorganisms secrete lipases to break down lipids into glycerol and free fatty acids."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460127 "lipolytic fermentation"@en)
SubClassOf(obo:FOODON_03460127 obo:FOODON_00001304)

# Class: obo:FOODON_03460128 (multi-component food fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460128 "A food fermentation process in which significant amounts of two or more components (i.e. carbohydrate and protein, carbohydrate and fat, protein and fat, or all three) are modified through microbial processes."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460128 "Enzymatic or other biological processes may also be involved."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460128 "multi-component food fermentation"@en)
SubClassOf(obo:FOODON_03460128 obo:FOODON_00001304)

# Class: obo:FOODON_03460130 (physical/chemical modification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460130 "A food modification where physical or chemical changes are effected in any food ingredient through a physical or non-enzymatic chemical process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460130 "physical/chemical modification"@en)
SubClassOf(obo:FOODON_03460130 obo:FOODON_03460141)

# Class: obo:FOODON_03460133 (food certified color addition)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460133 "A food color addition in which color that must be certified by batch as safe to use is added at any level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460133 "food certified color addition"@en)
SubClassOf(obo:FOODON_03460133 obo:FOODON_03460150)

# Class: obo:FOODON_03460134 (protein removal)

AnnotationAssertion(rdfs:label obo:FOODON_03460134 "protein removal"@en)
SubClassOf(obo:FOODON_03460134 obo:FOODON_03000665)

# Class: obo:FOODON_03460135 (alkaloid or purine removal)

AnnotationAssertion(rdfs:label obo:FOODON_03460135 "alkaloid or purine removal"@en)
SubClassOf(obo:FOODON_03460135 obo:FOODON_03000665)

# Class: obo:FOODON_03460137 (demineralizing)

AnnotationAssertion(rdfs:comment obo:FOODON_03460137 "LanguaL curation note: Used when one or more naturally present minerals have been fully or partially removed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460137 "demineralizing"@en)
SubClassOf(obo:FOODON_03460137 obo:FOODON_03000665)

# Class: obo:FOODON_03460138 (water removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460138 "LanguaL curation note: Used for a liquid or solid product from which a significant amount of water (25% or more of the original weight of the water) has been removed. If dehydration is the primary preservation method, also index *DEHYDRATED OR DRIED*. For soups that require the addition of water, use the appropriate narrower term regardless of whether water was removed or not. Do not use for products that have been rehydrated."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460138 "water removal"@en)
SubClassOf(obo:FOODON_03460138 obo:FOODON_03000665)

# Class: obo:FOODON_03460140 (decaffeination)

AnnotationAssertion(rdfs:label obo:FOODON_03460140 "decaffeination"@en)
SubClassOf(obo:FOODON_03460140 obo:FOODON_03000665)
SubClassOf(obo:FOODON_03460140 obo:FOODON_03460135)

# Class: obo:FOODON_03460141 (food modification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460141 "A food treatment process in which a food material's composition is changed in some mechanical or chemical way."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460141 "LanguaL curation note: Used when the food product underwent mechanical, chemical or enzymatic modification that has affected the texture, flavor or other characteristic of the product."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460141 "food modification"@en)
SubClassOf(obo:FOODON_03460141 obo:FOODON_03460111)

# Class: obo:FOODON_03460148 (water addition)

AnnotationAssertion(rdfs:comment obo:FOODON_03460148 "LanguaL curation note: Used for a liquid or solid product to which water was added beyond its natural water level. If a single-strength standard for the product exists, use the appropriate narrower term under *WATER ADDED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460148 "water addition"@en)
SubClassOf(obo:FOODON_03460148 obo:FOODON_03460225)
SubClassOf(obo:FOODON_03460148 obo:FOODON_03460254)

# Class: obo:FOODON_03460150 (food color addition)

AnnotationAssertion(rdfs:comment obo:FOODON_03460150 "LanguaL curation note: Used when a color substance is added to a food at any level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460150 "food color addition"@en)
SubClassOf(obo:FOODON_03460150 obo:FOODON_03460225)

# Class: obo:FOODON_03460160 (alcoholization)

AnnotationAssertion(rdfs:comment obo:FOODON_03460160 "LanguaL curation note: Used when alcohol is added for flavor or taste, for example, brandied peaches or cold-pack cheese food with port wine."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460160 "alcoholization"@en)
SubClassOf(obo:FOODON_03460160 obo:FOODON_03460225)

# Class: obo:FOODON_03460161 (fat removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460161 "LanguaL curation note: Used for products that contain less than 60% of the fat naturally present in the food source (more precisely, the part of the food source.) more specific fat levels, which vary from one product type to another, are specified in the extended scope notes for *FAT PARTIALLY REMOVED* and *FAT FULLY REMOVED* in the manual."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460161 "fat removal"@en)
SubClassOf(obo:FOODON_03460161 obo:FOODON_03000665)

# Class: obo:FOODON_03460169 (food instantizing)

AnnotationAssertion(rdfs:comment obo:FOODON_03460169 "LanguaL curation note: Used for food products modified to reduce cooking time or to enhance dispersion characteristics of powdered or granulated products."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460169 "food instantizing"@en)
SubClassOf(obo:FOODON_03460169 obo:FOODON_03460141)

# Class: obo:FOODON_03460174 (food hydrogenation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460174 "The saturating or hardening of a vegetable oil to which hydrogen has been chemically added to convert it to a fat."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460174 "food hydrogenation"@en)
SubClassOf(obo:FOODON_03460174 obo:FOODON_03460130)

# Class: obo:FOODON_03460175 (carbonation)

AnnotationAssertion(rdfs:comment obo:FOODON_03460175 "LanguaL curation note: Used when carbon dioxide is added or introduced by processing. Excludes naturally carbonated water, which is indexed under food source *MINERAL WATER*.  https://orcid.org/0000-0002-8844-9165's note: converted to a process"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460175 "carbonation"@en)
SubClassOf(obo:FOODON_03460175 obo:FOODON_03460225)

# Class: obo:FOODON_03460178 (food aeration)

AnnotationAssertion(rdfs:comment obo:FOODON_03460178 "LanguaL curation note: Used for products with which a substantial amount of air has been mixed through mechanical action. Do not use when air was introduced primarily through chemical action or through fermentation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460178 "food aeration"@en)
SubClassOf(obo:FOODON_03460178 obo:FOODON_03460130)

# Class: obo:FOODON_03460179 (food ionizing irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460179 "A food irradiation process in which ionizing irradiation is applied."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460179 "food ionizing irradiation"@en)
SubClassOf(obo:FOODON_03460179 obo:FOODON_03460121)

# Class: obo:FOODON_03460182 (candying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460182 "A chemical modification involving osmosis in which water within fruit or vegetable material immersed in sugar syrop is replaced by sugar molecules."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460182 "LanguaL curation note: Used for whole fruit or pieces of fruit are permeated by sugar to result in a product with sugar solids over 70% (e.g., candied citrus peel or candied cherry). Not used for sugar-coated products or for such products as candied sweet potatoes or glazed carrots, which are merely sweetened by cooking in syrup."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460182 "candying"@en)
SubClassOf(obo:FOODON_03460182 obo:FOODON_03460130)

# Class: obo:FOODON_03460190 (pickling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460190 "A process of preserving or extending the shelf life of food by either anaerobic fermentation in brine or immersion in vinegar."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03460190 wikipedia:Pickling)
AnnotationAssertion(rdfs:comment obo:FOODON_03460190 "LanguaL curation note: Also index by other applicable terms from *MICROBIALLY/ ENZYMATICALLY MODIFIED*.  LanguaL definition: \"Treated with acid that may be produced by fermentation or added and/or with salt brine, often in the presence of spices or herbs, producing changes in flavor and texture."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460190 "pickling"@en)
SubClassOf(obo:FOODON_03460190 obo:FOODON_03460119)

# Class: obo:FOODON_03460192 (food texturing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460192 "Modified through physical and/or chemical treatment to promote or affect the tactile quality and appearance of a food product."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460192 "food texturing"@en)
SubClassOf(obo:FOODON_03460192 obo:FOODON_03460130)

# Class: obo:FOODON_03460194 (nutrient or dietary substance addition)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460194 "A food is 'enriched' when nutrients are added to it to replace those that are lost in processing; a food is 'fortified' when nutrients that were never present are added to it."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460194 "LanguaL curation note: Used when a chemical constituent is added for nutrient supplementation. Not used when the constituent is added to improve the functional properties of the food product. If the purpose of the constituent is not known, use the appropriate index term."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460194 "nutrient or dietary substance addition"@en)
SubClassOf(obo:FOODON_03460194 obo:FOODON_03460225)

# Class: obo:FOODON_03460197 (food bleaching)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460197 "Treated with chemicals to reduce color, primarily to whiten, e.g., bleached flour."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460197 "food bleaching"@en)
SubClassOf(obo:FOODON_03460197 obo:FOODON_03460130)

# Class: obo:FOODON_03460198 (debittering)

AnnotationAssertion(rdfs:label obo:FOODON_03460198 "debittering"@en)
SubClassOf(obo:FOODON_03460198 obo:FOODON_03460238)

# Class: obo:FOODON_03460200 (food acidification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460200 "A food material combination process where acid is added to"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460200 "LanguaL curation note: Used  when acid is added to a food product at any level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460200 "food acidification"@en)
SubClassOf(obo:FOODON_03460200 obo:FOODON_03460225)

# Class: obo:FOODON_03460203 (lactose conversion)

AnnotationAssertion(rdfs:comment obo:FOODON_03460203 "LanguaL curation note: Used when all or part of the lactose in milk is converted to glucose and galactose through enzymatic action."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460203 "lactose conversion"@en)
SubClassOf(obo:FOODON_03460203 obo:FOODON_03460252)

# Class: obo:FOODON_03460206 (food alkalization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460206 "Treated with a solution of alkali (primarily potassium or sodium carbonate). In cacao, alkalization neutralizes acids and leads to changes in flavor and color. In fats and oils, treatment with alkali leads to saponification of free fatty acids; soap and alkali are then removed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460206 "food alkalization"@en)
SubClassOf(obo:FOODON_03460206 obo:FOODON_03460130)

# Class: obo:FOODON_03460207 (food filling process)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460207 "A food material combination in which food material is added by a filling process."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460207 "LanguaL curation note: Applies to all filled or stuffed products, including pies and sandwiches."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460207 "food filling process"@en)
SubClassOf(obo:FOODON_03460207 obo:FOODON_03460225)
SubClassOf(obo:FOODON_03460207 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00001868))

# Class: obo:FOODON_03460208 (fat substitution)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460208 "A component substition process in which endogenous fat is removed and fat from a different source is added."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460208 "fat substitution"@en)
SubClassOf(obo:FOODON_03460208 obo:FOODON_03000665)
SubClassOf(obo:FOODON_03460208 obo:FOODON_03460103)

# Class: obo:FOODON_03460220 (grain parboiling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460220 "Treated with moist heat to soften the grain and to transfer nutrients from the bran to the endosperm."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460220 "grain parboiling"@en)
SubClassOf(obo:FOODON_03460220 obo:FOODON_03450012)
SubClassOf(obo:FOODON_03460220 obo:FOODON_03460130)

# Class: obo:FOODON_03460225 (food material combination)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460225 "A material combination process involving two or more food materials."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03460225 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03460225 "LanguaL curation note: A food product is characterized by its main ingredient (food source and part); the addition of secondary ingredients is considered a treatment applied to the product. Secondary ingredients are indexed according to rules that are based on the order of predominance by weight (not counting water) as seen from the label statement, formulation or recipe and/or from the amount of the ingredient as percentage of total product weight. The general rule is:  an ingredient is always indexed if it is the second ingredient in order of predominance, if it is used as a filling, or if it is part of the product name(e.g., raisin bread). Specific rules are given in the scope note for the individual ingredient added; these rules specify more exhaustive indexing. For example, *MUSHROOM ADDED* is indexed regardless of ingredient position. another specific rule is given in the scope note for *SALTED*:  Use if the level of salt is more than 4%. Such a rule is used only when the percentage level can be inferred from the list of ingredients."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460225 "food material combination"@en)
SubClassOf(obo:FOODON_03460225 obo:FOODON_03460111)
SubClassOf(obo:FOODON_03460225 obo:OBI_0000652)

# Class: obo:FOODON_03460230 (single component food fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460230 "A food fermentation process in which significant amounts of one category of component - either carbohydrates, proteins or fats - is modified through microbial processes."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460230 "LanguaL curation note: Used for products in which either carbohydrates, proteins or fats were modified through microbial processes. Enzymatic or other biological processes may also be involved. If two or more of these components are modified in significant amounts, index under *FERMENTED/MODIFIED, MULTIPLE COMPONENT*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460230 "single component food fermentation"@en)
SubClassOf(obo:FOODON_03460230 obo:FOODON_00001304)

# Class: obo:FOODON_03460232 (alcohol fermentation)

AnnotationAssertion(rdfs:label obo:FOODON_03460232 "alcohol fermentation"@en)
SubClassOf(obo:FOODON_03460232 obo:FOODON_03460256)

# Class: obo:FOODON_03460234 (dilution process to 15-49% of single strength)

AnnotationAssertion(rdfs:label obo:FOODON_03460234 "dilution process to 15-49% of single strength"@en)
SubClassOf(obo:FOODON_03460234 obo:FOODON_03460148)

# Class: obo:FOODON_03460236 (sodium removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460236 "LanguaL curation note: Used when naturally present sodium has been fully or partially removed. Index also by the appropriate term under *SALT OR SODIUM SPECIAL CLAIM OR USE*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460236 "sodium removal"@en)
SubClassOf(obo:FOODON_03460236 obo:FOODON_03460137)

# Class: obo:FOODON_03460237 (dilution process to 50-99% of single strength)

AnnotationAssertion(rdfs:label obo:FOODON_03460237 "dilution process to 50-99% of single strength"@en)
SubClassOf(obo:FOODON_03460237 obo:FOODON_03460148)

# Class: obo:FOODON_03460238 (food component separation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460238 "A material component separation process involving food material."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03460238 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03460238 "LanguaL curation note: Use the appropriate term under *COMPONENT REMOVED* to indicate the permanent full or partial removal of a nutritional/chemical component naturally present in the part of plant or animal used."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460238 "food component separation"@en)
SubClassOf(obo:FOODON_03460238 obo:OBI_0600014)

# Class: obo:FOODON_03460239 (grain rolling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460239 "A physical forming process in which grain kernels are physically compressed between heated rollers."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460239 "LanguaL curation note: Used for a grain in which the kernels have been physically compressed between heated rollers."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460239 "grain rolling"@en)
SubClassOf(obo:FOODON_03460239 obo:FOODON_00002409)

# Class: obo:FOODON_03460241 (thawing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460241 "A heating material to a threshold from a frozen state to a temperature above 0 degrees Celsius."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460241 "LanguaL curation note: Used when the product or any indexed ingredient was frozen and then thawed. Excludes freeze-dried products and freeze-flo products."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460241 "thawing"@en)
SubClassOf(obo:FOODON_03460241 obo:FOODON_03000547)

# Class: obo:FOODON_03460246 (carbonation by fermentation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460246 "A food fermentation process involving production of carbon dioxide which remains noticeable in the food material."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460246 "carbonation by fermentation"@en)
SubClassOf(obo:FOODON_03460246 obo:FOODON_00001304)
SubClassOf(obo:FOODON_03460246 obo:FOODON_03460175)

# Class: obo:FOODON_03460247 (partial fat removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460247 "LanguaL curation note: Used for products that contain between 10-20% and 60% of the fat naturally present in the food source. Examples are breakfast cocoa, low fat milk and low-fat cottage cheese."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460247 "partial fat removal"@en)
SubClassOf(obo:FOODON_03460247 obo:FOODON_03460161)

# Class: obo:FOODON_03460248 (full fat removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460248 "LanguaL curation note: Used for products that contain less than 10-20% of the fat naturally present in the food source. Examples are skim milk, low-fat cocoa and dry-curd cottage cheese."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460248 "full fat removal"@en)
SubClassOf(obo:FOODON_03460248 obo:FOODON_03460161)

# Class: obo:FOODON_03460250 (protein substitution)

AnnotationAssertion(rdfs:label obo:FOODON_03460250 "protein substitution"@en)
SubClassOf(obo:FOODON_03460250 obo:FOODON_03460103)

# Class: obo:FOODON_03460252 (enzymatic modification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460252 "A food ageing process involving the addition of enzymes or the activation of endogenous enzymes."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460252 "LanguaL curation note: Used for products in which one or more components were converted through the addition of enzymes or through activation of endogenous enzymes."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460252 "enzymatic modification"@en)
SubClassOf(obo:FOODON_03460252 obo:FOODON_03000632)
SubClassOf(obo:FOODON_03460252 obo:FOODON_03460119)

# Class: obo:FOODON_03460253 (curing of food)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460253 "A food ageing process involving the addition of salt or sugar, with an objective of reducing water content in the material by osmosis."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03460253 <https://en.wikipedia.org/wiki/Curing_(food_preservation)>)
AnnotationAssertion(rdfs:comment obo:FOODON_03460253 "LanguaL note: Such changes may be induced by the introduction of certain chemicals, such as sodium sulfite, salt, sugar, or other substances, such as phenolics, in dry or liquid form and often aided by smoke. Cheese should always be indexed by the appropriate narrower term under *LACTIC ACID-OTHER AGENT FERMENTED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460253 "curing of food"@en)
SubClassOf(obo:FOODON_03460253 obo:FOODON_03000632)

# Class: obo:FOODON_03460254 (water addition or removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460254 "LanguaL curation note: Used when water is added or removed in order to change the total solids-to-liquids ratio of a food product."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460254 "water addition or removal"@en)
EquivalentClasses(obo:FOODON_03460254 ObjectUnionOf(obo:FOODON_03460138 obo:FOODON_03460148))
SubClassOf(obo:FOODON_03460254 obo:FOODON_03460111)

# Class: obo:FOODON_03460256 (carbohydrate fermentation)

AnnotationAssertion(rdfs:label obo:FOODON_03460256 "carbohydrate fermentation"@en)
SubClassOf(obo:FOODON_03460256 obo:FOODON_03460230)

# Class: obo:FOODON_03460259 (rehydration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460259 "The addition of liquid to a material to restore a palatable concentration of liquid inside the material."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460259 "LanguaL curation note: Used for a product that is prepared by adding water or a water-based liquid (milk, juice, broth) to a dehydrated or concentrated product or to a product that contains an indexed dehydrated ingredient plus water to rehydrate that ingredient. Examples:  juice or juice drink from concentrate; milk reconstituted from dry or concentrated milk; soaked dried beans or stewed fruit; biscuit dough (prepared by rehydrating flour); soup made from dehydrated ingredients; cooked noodles or boiled rice. If the resulting product contains water beyond its natural water level, also index *WATER ADDED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460259 "rehydration"@en)
SubClassOf(obo:FOODON_03460259 obo:FOODON_03460148)

# Class: obo:FOODON_03460261 (food ultraviolet irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460261 "A food irradiation process which utilizes ultraviolet radiation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460261 "food ultraviolet irradiation"@en)
SubClassOf(obo:FOODON_03460261 obo:FOODON_03460121)

