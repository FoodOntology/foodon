# Class: obo:FOODON_00004722 (fresh)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004722 "A characteristic of raw organism material which has not undergone significant deterioration or spoilage, and which has not been subjected to drying or freezing."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004722 "fresh"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004722 <https://inspection.canada.ca/en/food-labels/labelling/industry/composition-and-quality#s10c3>)
SubClassOf(obo:FOODON_00004722 obo:FOODON_00004348)

# Class: obo:FOODON_00004723 (dried)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004723 "A physical object quality of material that has undergone a drying process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004723 "dried"@en)
SubClassOf(obo:FOODON_00004723 obo:PATO_0001241)

# Class: obo:FOODON_00004724 (dried raw)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004724 "A dried characteristic of organism material which was raw when subjected to a drying process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004724 "dried raw"@en)
SubClassOf(obo:FOODON_00004724 obo:FOODON_00004723)

# Class: obo:FOODON_00004725 (chilled)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004725 "A chilling temperature characteristic of material indicating that it bears this temperature by having undergone a cooling material to a threshold process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004725 "chilled"@en)
SubClassOf(obo:FOODON_00004725 obo:PATO_0001241)

# Class: obo:FOODON_00004726 (chilled fresh)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004726 "A chilled temperature of material which also holds a fresh characteristic."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00004726 "This doesn't necessarily imply that a food product is foodsafe chilled."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004726 "chilled fresh"@en)
EquivalentClasses(obo:FOODON_00004726 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 obo:FOODON_00004722) ObjectSomeValuesFrom(obo:RO_0000053 obo:FOODON_00004725)))
SubClassOf(obo:FOODON_00004726 obo:FOODON_00004725)

# Class: obo:FOODON_00004727 (thawed)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004727 "A physical object quality indicating that its bearer is above a frozen temperature and that it was previously frozen."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00004727 "This term doesn’t commit to exactly how cool or warm a material might be."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004727 "thawed"@en)
SubClassOf(obo:FOODON_00004727 obo:PATO_0001241)

# Class: obo:FOODON_00004728 (flash frozen)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004728 "A frozen characteristic which indicates the bearer is an output of a flash freezing process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004728 "flash frozen"@en)
SubClassOf(obo:FOODON_00004728 obo:PATO_0001985)

# Class: obo:FOODON_00004729 (ambient temperature)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00004729 "https://www.gmp-compliance.org/gmp-news/ambient-room-temperature-cold-what-is-what|http://purl.obolibrary.org/obo/XCO_0000058")
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004729 "A temperature which refers to the average kinetic energy of molecules in the air surrounding an object or within a particular area."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004729 wikipedia:Room_temperature)
AnnotationAssertion(rdfs:label obo:FOODON_00004729 "ambient temperature"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004729 obo:XCO_0000058)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004729 <https://www.gmp-compliance.org/gmp-news/ambient-room-temperature-cold-what-is-what>)
SubClassOf(obo:FOODON_00004729 obo:PATO_0000146)

# Class: obo:FOODON_00004730 (foodsafe chilled)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004730 "A characteristic of chilled food material that has a temperature which meets safe food storage standards."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004730 "foodsafe chilled"@en)
SubClassOf(obo:FOODON_00004730 obo:FOODON_00004725)

# Class: obo:FOODON_00004731 (food (fresh frozen))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004731 "Food which has a fresh frozen characteristic."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004731 "food (fresh frozen)"@en)
SubClassOf(obo:FOODON_00004731 obo:FOODON_03302148)

# Class: obo:FOODON_00005139 (food (dried raw))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00005139 "Dried food which was dried when in a raw state."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00005139 "food (dried raw)"@en)
SubClassOf(obo:FOODON_00005139 obo:FOODON_03307539)

# Class: obo:FOODON_00005179 (thawed (from frozen raw))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00005179 "A thawed characteristic of organism material indicating that it was raw just before being frozen and then thawed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00005179 "thawed (from frozen raw)"@en)
SubClassOf(obo:FOODON_00005179 obo:FOODON_00004727)

# Class: obo:FOODON_00005451 (room temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00005451 "A temperature which encompasses the range of air temperatures most people find comfortable indoors while dressed in typical clothing."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00005451 wikipedia:Room_temperature)
AnnotationAssertion(rdfs:label obo:FOODON_00005451 "room temperature"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00005451 <https://www.gmp-compliance.org/gmp-news/ambient-room-temperature-cold-what-is-what>)
SubClassOf(obo:FOODON_00005451 obo:PATO_0000146)

# Class: obo:FOODON_00005709 (food heating)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00005709 "A food treatment in which thermal energy (heat) is applied to a food material until an objective range of temperature or process time is achieved."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00005709 "food heating"@en)
SubClassOf(obo:FOODON_00005709 obo:FOODON_03000547)

# Class: obo:FOODON_03000001 (food peeling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000001 "peeling\" is the process of removing the outer covering, layer or skin from a fruit, vegetable, or plant or animal (such as a shrimp)."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03000001 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_03000001 "food peeling"@en)
SubClassOf(obo:FOODON_03000001 obo:FOODON_03460238)
SubClassOf(obo:FOODON_03000001 ObjectSomeValuesFrom(obo:OBI_0000299 obo:FOODON_00002655))

# Class: obo:FOODON_03000493 (raw (not intact))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000493 "A characteristic of organism material which has undergone comminution or meat tenderizing, but which is otherwise unprocessed."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000493 <https://www.fsis.usda.gov/sites/default/files/import/Product-Categorization.pdf>)
AnnotationAssertion(rdfs:comment obo:FOODON_03000493 "This is a peer of \"raw\", intended to catch the case where a material maintains nutritional characteristics despite certain kinds of processing which may affect other characteristics related to food safety, taste, etc."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000493 "raw (not intact)"@en)
SubClassOf(obo:FOODON_03000493 obo:PATO_0001995)

# Class: obo:FOODON_03000494 (sterilization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000494 "A microorganism killing process in which all microorganisms are destroyed in an input material."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000494 "If food material is involved, we could infer instances of this is a subclass of food preservation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000494 "sterilization"@en)
SubClassOf(obo:FOODON_03000494 obo:FOODON_03000714)

# Class: obo:FOODON_03000495 (food (sterile))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000495 "Food material which is sterile."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000495 "food (sterile)"@en)
SubClassOf(obo:FOODON_03000495 obo:FOODON_00002454)

# Class: obo:FOODON_03000496 (microorganism removal)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000496 "A food microorganism control process in which food microorganisms are removed from food material."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000496 "microorganism removal"@en)
SubClassOf(obo:FOODON_03000496 obo:FOODON_03000711)
SubClassOf(obo:FOODON_03000496 obo:FOODON_03470107)

# Class: obo:FOODON_03000497 (food (perishable))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000497 "Food which has a perishable characteristic."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000497 "food (perishable)"@en)
SubClassOf(obo:FOODON_03000497 obo:FOODON_00002454)

# Class: obo:FOODON_03000498 (perishable)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000498 "A characteristic of food material which indicates that over time it will more likely decompose, or spoil or cause illness due to foodborne microorganisms, unless subjected to a food preservation process."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000498 <https://en.wiktionary.org/wiki/perishable>)
AnnotationAssertion(rdfs:comment obo:FOODON_03000498 "Perishability is often linked to the water activity (or concentration) in food materials."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000498 "perishable"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03000498 <https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/inspection-technical-guides/water-activity-aw-foods>)
SubClassOf(obo:FOODON_03000498 obo:FOODON_00002470)

# Class: obo:FOODON_03000499 (shelf stable)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000499 "A characteristic food material which indicates that from a food safety perspective it can be safely stored at room temperature."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000499 <https://www.fsis.usda.gov/food-safety/safe-food-handling-and-preparation/food-safety-basics/shelf-stable-food>)
AnnotationAssertion(rdfs:comment obo:FOODON_03000499 "Some food materials such as milk need sterilization to be shelf stable; others are shelf stable due to their dehydrated state, such as dates or dried peas."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000499 "shelf stable"@en)
SubClassOf(obo:FOODON_03000499 obo:FOODON_00002470)

# Class: obo:FOODON_03000500 (durable shelf life)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000500 "A characteristic of shelf stable food material which indicates that in addition to being safely storable, it maintains its quality and desired palatability, and fulfills any nutritional declarations it has, up to some date of minimum durability."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000500 <https://inspection.canada.ca/en/preventive-controls/shelf-life-studies>)
AnnotationAssertion(rdfs:comment obo:FOODON_03000500 "The general discriptive dimension here is \"durability\".  Some food materials such as bread need packaging and/or additives in addition to preservatives to extend their durable life. Ambient temperature or humidity may ultimately affect extend durable life performance."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000500 "durable shelf life"@en)
SubClassOf(obo:FOODON_03000500 obo:FOODON_03000499)

# Class: obo:FOODON_03000501 (ultraviolet light exposed (sensu food))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000501 "A characteristic of irradiated food material which indicates that it has been exposed to ultraviolet light."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000501 "ultraviolet light exposed (sensu food)"@en)
SubClassOf(obo:FOODON_03000501 obo:FOODON_03000503)

# Class: obo:FOODON_03000503 (irradiated (sensu food))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000503 "A characteristic of food material which indicates that it has undergone food irradiation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000503 "Irradiation changes the biochemical constitution of some/many foods, so this kind of raw food is not necessarily a child of “raw”: “Some foods, such as dairy foods and eggs, cannot be irradiated because it causes changes in flavour or texture.” [https://www.betterhealth.vic.gov.au/health/healthyliving/food-irradiation]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000503 "irradiated (sensu food)"@en)
SubClassOf(obo:FOODON_03000503 obo:FOODON_00002470)

# Class: obo:FOODON_03000504 (pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000504 "A microorganism killing process which has the objective of reducing potential pathogenic microbes by an amount equivalent to Pasteur's process."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000504 wikipedia:Pasteurization)
AnnotationAssertion(rdfs:label obo:FOODON_03000504 "pasteurization"@en)
SubClassOf(obo:FOODON_03000504 obo:FOODON_03000714)

# Class: obo:FOODON_03000505 (pasteurized)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000505 "A characteristic of food material which indicates that it has been pasteurized."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000505 "pasteurized"@en)
SubClassOf(obo:FOODON_03000505 obo:FOODON_00002470)

# Class: obo:FOODON_03000506 (fermented)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000506 "A characteristic of food material which indicates that it has undergone fermentation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000506 "fermented"@en)
SubClassOf(obo:FOODON_03000506 obo:FOODON_00002470)

# Class: obo:FOODON_03000507 (material energy modulation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000507 "Material processing which involves a change in energy applied to or inherent in a material."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000507 wikipedia:Energy)
AnnotationAssertion(rdfs:label obo:FOODON_03000507 "material energy modulation"@en)
SubClassOf(obo:FOODON_03000507 obo:FOODON_03000684)

# Class: obo:FOODON_03000508 (thermal energy modulation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000508 "An energy modulation in which thermal energy (heat) is added to or removed from a material or its environment."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000508 "thermal energy modulation"@en)
SubClassOf(obo:FOODON_03000508 obo:FOODON_03000507)

# Class: obo:FOODON_03000509 (material (thermally processed))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000509 "A material which has been subject to thermal energy modulation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000509 "material (thermally processed)"@en)
SubClassOf(obo:FOODON_03000509 obo:BFO_0000040)

# Class: obo:FOODON_03000510 (thermally treated)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000510 "A characteristic of a material that has undergone a thermal energy modulation process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000510 "thermally treated"@en)
SubClassOf(obo:FOODON_03000510 obo:PATO_0001241)

# Class: obo:FOODON_03000511 (temperature control)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000511 "A thermal energy modulation in which a material or environment is artificially controlled to ensure its temperature falls within a specified range."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000511 wikipedia:Temperature_control)
AnnotationAssertion(rdfs:comment obo:FOODON_03000511 "syn temperature regulation"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000511 "temperature control"@en)
SubClassOf(obo:FOODON_03000511 obo:FOODON_03000508)

# Class: obo:FOODON_03000512 (uncontrolled environment)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000512 "An environment which is not temperature or humidity controlled."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000512 "uncontrolled environment"@en)
SubClassOf(obo:FOODON_03000512 obo:BFO_0000040)

# Class: obo:FOODON_03000513 (uncontrolled temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000513 "A temperature characteristic of a material which is not subjected to a temperature control process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000513 "uncontrolled temperature"@en)
SubClassOf(obo:FOODON_03000513 obo:PATO_0000146)

# Class: obo:FOODON_03000514 (controlled environment)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000514 "An environment which is temperature and humidity controlled."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000514 "Using the word \"controlled\" here rather than \"regulated\" since regulated may imply not just mechanical but regulatory control."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000514 "controlled environment"@en)
SubClassOf(obo:FOODON_03000514 obo:BFO_0000040)

# Class: obo:FOODON_03000515 (controlled temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000515 "A temperature characteristic of a bearer which is the output of a temperature regulation process."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000515 "syn. controlled temperature"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000515 "controlled temperature"@en)
SubClassOf(obo:FOODON_03000515 obo:PATO_0000146)

# Class: obo:FOODON_03000516 (foodsafe freezing temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000516 "A freezing temperature (of a bearer) which meets safe food storage standards."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000516 "foodsafe freezing temperature"@en)
SubClassOf(obo:FOODON_03000516 obo:PATO_0000146)

# Class: obo:FOODON_03000517 (water freezing temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000517 "A temperature which is of water when it transitions from liquid to solid phase at 1 atm of pressure."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000517 "The measurement context of 1 atmosphere of pressure roughly equates to pressure on Earth at sea-level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000517 "water freezing temperature"@en)
SubClassOf(obo:FOODON_03000517 obo:PATO_0000146)

# Class: obo:FOODON_03000518 (chilling temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000518 "A temperature which indicates that the bearer is below a cool temperature but above a freezing temperature"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000518 "chilling temperature"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03000518 <https://www.gmp-compliance.org/gmp-news/ambient-room-temperature-cold-what-is-what>)
SubClassOf(obo:FOODON_03000518 obo:PATO_0000146)

# Class: obo:FOODON_03000519 (foodsafe chilling temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000519 "A chilling temperature (of a bearer) which meets safe food storage standards."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000519 "The bearer can be a food item or a refrigerator / cooler."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000519 "foodsafe chilling temperature"@en)
SubClassOf(obo:FOODON_03000519 obo:FOODON_03000518)

# Class: obo:FOODON_03000520 (cold temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000520 "A temperature which indicates that the bearer is below a cool temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000520 "This covers common language use of \"cold\" which includes sub-zero temperature."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000520 "cold temperature"@en)
SubClassOf(obo:FOODON_03000520 obo:PATO_0000146)

# Class: obo:FOODON_03000521 (cool temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000521 "A temperature which indicates that the bearer is below room temperature but above a cold temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000521 "The range of \"cool\" vs. \"cold\" temperatures is fuzzy."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000521 "cool temperature"@en)
SubClassOf(obo:FOODON_03000521 obo:PATO_0000146)

# Class: obo:FOODON_03000522 (ISO 1 standard temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000522 "A reference temperature of 20 Degrees celcius which enables standardized comparison of material characteristics."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000522 wikipedia:ISO_1)
AnnotationAssertion(rdfs:label obo:FOODON_03000522 "ISO 1 standard temperature"@en)
SubClassOf(obo:FOODON_03000522 obo:FOODON_00005451)

# Class: obo:FOODON_03000523 (neutral temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000523 "A temperature relative to a material entity at which it maintains its physical or chemical constitution over time, all other things considered."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000523 "Fresh food material doesn't really have a neutral temperature since the conditions for being \"fresh\" are also the conditions for eventual decay.  A frozen material may have a neutral temperature range within which it won't change its composition appreciably."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000523 "neutral temperature"@en)
SubClassOf(obo:FOODON_03000523 obo:PATO_0000146)

# Class: obo:FOODON_03000524 (warm temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000524 "A temperature (of a bearer) which is greater than room temperature and less than a hot temperature."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000524 "warm temperature"@en)
SubClassOf(obo:FOODON_03000524 obo:PATO_0000146)

# Class: obo:FOODON_03000525 (hot temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000525 "A temperature (of a bearer) which is greater than warm temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000525 "This may be subjectively relative to a material - hot oil vs hot water"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000525 "hot temperature"@en)
SubClassOf(obo:FOODON_03000525 obo:PATO_0000146)

# Class: obo:FOODON_03000526 (skin burning temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000526 "A temperature of a bearer which is capable of inflicting pain or injury to epithelial tissue due to thermal exposure by conduction or infrared radiation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000526 "This pertains to cooking implements that may pose a burn risk."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000526 "skin burning temperature"@en)
SubClassOf(obo:FOODON_03000526 obo:PATO_0000146)

# Class: obo:FOODON_03000527 (scalding temperature)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000527 "A skin burning temperature of a bearer which indicates the bearer is a liquid."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000527 "scalding temperature"@en)
SubClassOf(obo:FOODON_03000527 obo:FOODON_03000526)

# Class: obo:FOODON_03000528 (boiling point)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000528 "A temperature characteristic of a liquid at which the vapour pressure of the liquid equals the pressure surrounding the liquid and the liquid changes into a vapour."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000528 wikipedia:Boiling_point)
AnnotationAssertion(rdfs:comment obo:FOODON_03000528 "The boiling point of a liquid varies depending upon the surrounding environmental pressure.\"[https://en.wikipedia.org/wiki/Boiling_point]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000528 "boiling point"@en)
SubClassOf(obo:FOODON_03000528 obo:PATO_0000146)

# Class: obo:FOODON_03000529 (water boiling point)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000529 "A boiling point characteristic of water"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000529 "water boiling point"@en)
SubClassOf(obo:FOODON_03000529 obo:FOODON_03000528)

# Class: obo:FOODON_03000530 (material cooling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000530 "A thermal energy modulation in which heat is removed from a material or (indirectly) its environment."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000530 "material cooling"@en)
SubClassOf(obo:FOODON_03000530 obo:FOODON_03000508)

# Class: obo:FOODON_03000531 (cooling material to a threshold)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000531 "A material cooling process which commenses when a material is placed into an environment which has a cooler temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000531 "This definition is engineered to fit both refrigeration and \"icewater soaking\" or other food preparation processes."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000531 "cooling material to a threshold"@en)
SubClassOf(obo:FOODON_03000531 obo:FOODON_03000530)

# Class: obo:FOODON_03000532 (food (foodsafe chilled))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000532 "Chilled food which is within a recommended foodsafe chilling temperature."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000532 "food (foodsafe chilled)"@en)
SubClassOf(obo:FOODON_03000532 obo:FOODON_00002642)

# Class: obo:FOODON_03000533 (food (refrigerated))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000533 "Food material which has undergone refrigeration."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000533 "This class doesn't commit to whether or not refrigerated food has been kept at a food safe temperature standard. Also, this term covers both cooked, reheated and uncooked (possibly fresh) food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000533 "food (refrigerated)"@en)
SubClassOf(obo:FOODON_03000533 obo:FOODON_00002645)

# Class: obo:FOODON_03000534 (refrigerated)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000534 "A characteristic of food material which has undergone refrigeration and/or is within a refrigerator."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000534 "One can say that food material is refrigerated, but this does not commit to the degree to which such material has become chilled or frozen."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000534 "refrigerated"@en)
SubClassOf(obo:FOODON_03000534 obo:FOODON_00002470)

# Class: obo:FOODON_03000535 (frozen after cooking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000535 "A characteristic of food material which was cooked and then frozen."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000535 "frozen after cooking"@en)
SubClassOf(obo:FOODON_03000535 obo:PATO_0001985)

# Class: obo:FOODON_03000536 (food natural freezing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000536 "A material freezing process in which ambient natural environment sub-zero temperatures are used to freeze food material."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000536 wikipedia:Frozen_food)
AnnotationAssertion(rdfs:label obo:FOODON_03000536 "food natural freezing"@en)
SubClassOf(obo:FOODON_03000536 obo:FOODON_03470136)

# Class: obo:FOODON_03000537 (quiescent freezing)

