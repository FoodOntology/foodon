AnnotationAssertion(rdfs:comment obo:FOODON_00004469 "syn “frozen fresh.”"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004469 "fresh frozen"@en)
SubClassOf(obo:FOODON_00004469 obo:PATO_0001985)

