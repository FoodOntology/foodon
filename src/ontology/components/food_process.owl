# Class: obo:FOODON_03460285 (alcohol removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460285 "LanguaL curation note: Used for products from which alcohol has been removed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460285 "alcohol removal"@en)
