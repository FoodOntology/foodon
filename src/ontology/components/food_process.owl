AnnotationAssertion(rdfs:label obo:FOODON_03460300 "acetic acid fermentation"@en)
SubClassOf(obo:FOODON_03460300 obo:FOODON_03460256)

# Class: obo:FOODON_03460306 (emulsification)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460306 "The mixing of two liquid or solid-liquid components [by a process of severe mixing, stirring and beating] with the objective of creating an emulsion."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03460306 <https://ebooks.inflibnet.ac.in/ftp02/chapter/size-reduction-2-emulsification-and-homogenization/>)
AnnotationAssertion(rdfs:comment obo:FOODON_03460306 "LanguaL curation note: \"Used for products in which two or more phases are mixed very finely but not at the molecular level. A very fine dispersion of a solid in a liquid is called a suspension. A very fine dispersion of one liquid in another immiscible liquid is called an emulsion.\" Renamed from \"food homogenization or emulsification process\" in order to move homogenization into a subclass."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460306 "emulsification"@en)
SubClassOf(obo:FOODON_03460306 obo:FOODON_03000690)

# Class: obo:FOODON_03460324 (partial fat removal, 50% or more remaining)

AnnotationAssertion(rdfs:comment obo:FOODON_03460324 "LanguaL curation note: Used for food products that have had fat partially removed to leave more than 50% fat from a full fat product. An example would 2% milk where full fat milk is 4%."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460324 "partial fat removal, 50% or more remaining"@en)
SubClassOf(obo:FOODON_03460324 obo:FOODON_03460247)

# Class: obo:FOODON_03460325 (partial fat removal, less than 50% remaining)

AnnotationAssertion(rdfs:comment obo:FOODON_03460325 "LanguaL curation note: Used for food products that have had fat removed to leave less than 50% fat from a full fat product. Examples would be 1% milk or 1/2% milk, where full fat milk is 4%."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460325 "partial fat removal, less than 50% remaining"@en)
SubClassOf(obo:FOODON_03460325 obo:FOODON_03460247)

