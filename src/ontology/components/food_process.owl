AnnotationAssertion(rdfs:label obo:FOODON_03460266 "carbohydrate removal"@en)
SubClassOf(obo:FOODON_03460266 obo:FOODON_03000665)

# Class: obo:FOODON_03460268 (food puffing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460268 "A physical/chemical modification in which moisture inside a starchy food material is instantaneously (flash) evaporated under high heat or pressure, causing a porous, crispy structure to form."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460268 "food puffing"@en)
SubClassOf(obo:FOODON_03460268 obo:FOODON_03460130)

