SubClassOf(obo:FOODON_03460354 obo:FOODON_03460353)

# Class: obo:FOODON_03460355 (chocolate coating or covering process)

AnnotationAssertion(rdfs:comment obo:FOODON_03460355 "LanguaL curation note: Includes chocolate coatings for such products as candy and ice cream products as well as icings and frostings for such products as cakes and doughnuts."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460355 "chocolate coating or covering process"@en)
SubClassOf(obo:FOODON_03460355 obo:FOODON_03460353)

# Class: obo:FOODON_03460357 (carob coating or covering process)

AnnotationAssertion(rdfs:comment obo:FOODON_03460357 "LanguaL curation note: Used for foods that have a coating or icing made from carob."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460357 "carob coating or covering process"@en)
SubClassOf(obo:FOODON_03460357 obo:FOODON_03460353)

# Class: obo:FOODON_03460358 (food aeration by whipping)

AnnotationAssertion(rdfs:comment obo:FOODON_03460358 "LanguaL curation note: Used when foods or liquids (or a combination) are aerated by vigorously mixing them using a whip, whisk, spoon, spatula, rotary beater or electric mixer."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460358 "food aeration by whipping"@en)
SubClassOf(obo:FOODON_03460358 obo:FOODON_03460178)

# Class: obo:FOODON_03460359 (food aeration by creaming)

AnnotationAssertion(rdfs:comment obo:FOODON_03460359 "LanguaL curation note: Used when a solid fat (butter, margarine, shortening) is aerated to a creamy appearance, often with the addition of sugar."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460359 "food aeration by creaming"@en)
SubClassOf(obo:FOODON_03460359 obo:FOODON_03460178)

# Class: obo:FOODON_03460366 (flattening)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460366 "A physical forming process in which semi-solid material is flattened between two surfaces."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460366 "LanguaL curation note: Used for any process such as rolling or pounding that is applied to dough, paste or meat (veal, chicken breast) in order to flatten the appearance."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460366 "flattening"@en)
SubClassOf(obo:FOODON_03460366 obo:FOODON_00002409)

# Class: obo:FOODON_03460391 (seed roasting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460391 "A roasting process involving seeds."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460391 "LanguaL curation note: Used primarily for processing of seeds, such as coffee, spices, nuts, and cacao beans."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460391 "seed roasting"@en)
SubClassOf(obo:FOODON_03460391 obo:FOODON_03450005)

# Class: obo:FOODON_03460393 (acid reduction)

AnnotationAssertion(rdfs:comment obo:FOODON_03460393 "LanguaL curation note: Used when a juice, typically orange, has undergone a process specified in 21 CFR 146.148 to reduce the adicity of the food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460393 "acid reduction"@en)
SubClassOf(obo:FOODON_03460393 obo:FOODON_03000665)

# Class: obo:FOODON_03460396 (marination with acidifier)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460396 "A marination process with an acidifier as a defining ingredient."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460396 "LanguaL curation note: Used when a food such as meat, fish or vegetables are soaked in a seasoned liquid in order to absorb flavor and, in some instances, to be tenderized. Most marinades contain an acid (lemon juice, vinegar, wine) and herbs or spices; the acid ingredient serves as the tenderizer."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460396 "marination with acidifier"@en)
SubClassOf(obo:FOODON_03460396 obo:FOODON_03460123)
SubClassOf(obo:FOODON_03460396 obo:FOODON_03460200)

# Class: obo:FOODON_03460398 (rind removal)

AnnotationAssertion(rdfs:comment obo:FOODON_03460398 "LanguaL curation note: Used for food products (typically fruit, cheese or meat) that have had the rind removed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460398 "rind removal"@en)
SubClassOf(obo:FOODON_03460398 obo:FOODON_03460238)

# Class: obo:FOODON_03460750 (gluten removal)

AnnotationAssertion(rdfs:label obo:FOODON_03460750 "gluten removal"@en)
SubClassOf(obo:FOODON_03460750 obo:FOODON_03460134)

# Class: obo:FOODON_03460751 (leavening agent addition)

AnnotationAssertion(rdfs:label obo:FOODON_03460751 "leavening agent addition"@en)
SubClassOf(obo:FOODON_03460751 obo:FOODON_03460225)

# Class: obo:FOODON_03460752 (sourdough addition)

AnnotationAssertion(rdfs:comment obo:FOODON_03460752 "LanguaL curation note: If wheat sourdough was added use also *WHEAT ADDED [H0319]*. If rye sourdough was added use also *RYE ADDED [H0337]*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460752 "sourdough addition"@en)
SubClassOf(obo:FOODON_03460752 obo:FOODON_03460751)

# Class: obo:FOODON_03460753 (yeast addition)

AnnotationAssertion(rdfs:label obo:FOODON_03460753 "yeast addition"@en)
SubClassOf(obo:FOODON_03460753 obo:FOODON_03460751)

# Class: obo:FOODON_03460760 (animal rendering)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460760 "Rendering is a process that converts waste animal tissue into stable, value-added materials. Rendering can refer to any processing of animal byproducts into more useful materials, or more narrowly to the rendering of whole animal fatty tissue into purified fats like lard or tallow. Rendering can be carried out on an industrial, farm, or kitchen scale."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460760 "animal rendering"@en)
SubClassOf(obo:FOODON_03460760 obo:FOODON_03460238)

# Class: obo:FOODON_03460781 (food micro-encapsulation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460781 "Micro-encapsulation is a process in which tiny particles or droplets are surrounded by a coating to give small capsules many useful properties. In a relatively simplistic form, a microcapsule is a small sphere with a uniform wall around it."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460781 "The material inside the microcapsule is referred to as the core, internal phase, or fill, whereas the wall is sometimes called a shell, coating, or membrane. Most microcapsules have diameters between a few micrometers and a few millimeters. The definition has been expanded, and includes most foods. Every class of food ingredient has been encapsulated; flavors are the most common. The technique of microencapsulation depends on the physical and chemical properties of the material to be encapsulated.[http://en.wikipedia.org/wiki/Micro-encapsulation]  LanguaL curation note: Used for the coating of microscopic particles with another material."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460781 "food micro-encapsulation"@en)
SubClassOf(obo:FOODON_03460781 obo:FOODON_03460130)

# Class: obo:FOODON_03470100 (preservation by adding chemical preservative)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470100 "Preservation by adding chemical preservatives (e.g., sorbic acid, sodium benzoate, BHT, calcium proprionate) to suppress or inhibit undesirable microorganisms or enzyme activity."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470100 "preservation by adding chemical preservative"@en)
SubClassOf(obo:FOODON_03470100 obo:FOODON_03470109)

# Class: obo:FOODON_03470102 (food sterilization before filling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470102 "LanguaL curation note: Used when a food product is sterilized by holding at a high temperature before filling; the container may be sterilized before or after filling."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470102 "LanguaL curation note: Used when a food product is sterilized by holding at a high temperature before filling; the container may be sterilized before or after filling."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470102 "food sterilization before filling"@en)
SubClassOf(obo:FOODON_03470102 obo:FOODON_03470123)

# Class: obo:FOODON_03470103 (food salting)

AnnotationAssertion(rdfs:comment obo:FOODON_03470103 "LanguaL curation note: Used when salting is used for preservation. The salt content of the food is generally 8% or higher (e.g. salted fish, etc.)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470103 "food salting"@en)
SubClassOf(obo:FOODON_03470103 obo:FOODON_03460225)
SubClassOf(obo:FOODON_03470103 obo:FOODON_03470145)
SubClassOf(obo:FOODON_03470103 obo:FOODON_03470154)

# Class: obo:FOODON_03470106 (food smoking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470106 "Smoking is the process of flavoring, browning, cooking, or preserving food by exposing it to smoke from burning or smoldering material, most often wood."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03470106 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03470106 "In the past, smoking was a useful preservation tool, in combination with other techniques, most commonly salt-curing or drying. For some long-smoked foods, the smoking time also served to dry the food. Drying, curing, or other techniques can render the interior of foods inhospitable to bacterial life, while the smoking gives the vulnerable exterior surfaces an extra layer of protection. [Wikipedia]|LanguaL curation note: Used when smoking is used for preservation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470106 "food smoking"@en)
SubClassOf(obo:FOODON_03470106 obo:FOODON_03460141)
SubClassOf(obo:FOODON_03470106 obo:FOODON_03470145)

# Class: obo:FOODON_03470107 (food preservation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470107 "A food treatment which contributes to the prevention or retardation of microbial, enzymatic or oxidative spoilage and thus to the durability of food material."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470107 "LanguaL curation notes: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term. Index all methods for which information is available, even if a corresponding descriptor has already been used in *H. TREATMENT APPLIED*. Preservation descriptors refer to the finished food as a whole with these exceptions: (1) if the components of a multi-component food, such as cream pie, are preservation by different methods, index all methods; (2)  if chemical preservatives are declared on the label, always index them even if it is known that the preservative was introduced through or is only present in a component or ingredient of the food; and (3) if the preservation method for an ingredient is declared on the label (such as brie cheese made from pasteurized milk) index it. Also use *INGREDIENT preservation by THERMAL PROCESSING* or *INGREDIENT preservation by IRRADIATION* when ingredients have been pasteurized, ultrapasteurized, sterilized or irradiated."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470107 "food preservation"@en)
SubClassOf(obo:FOODON_03470107 obo:FOODON_03460111)

# Class: obo:FOODON_03470108 (preservation by treatment with chemicals)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470108 "Preservation by immersing in or spraying with liquids (e.g., sulfite solutions) or surrounding with gases (e.g., ethylene oxide, propylene oxide or sulfur dioxide) to destroy undesirable microorganisms or inactivate enzymes. Diffusion and chemical reaction may create a residue in the food product that contributes to continuing preservation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470108 "preservation by treatment with chemicals"@en)
SubClassOf(obo:FOODON_03470108 obo:FOODON_03470109)

# Class: obo:FOODON_03470109 (chemical food preservation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470109 "Preservation by use of chemical to destroy, suppress or inhibit undesirable microorganisms or enzyme activity."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470109 "chemical food preservation"@en)
SubClassOf(obo:FOODON_03470109 obo:FOODON_03470107)

# Class: obo:FOODON_03470110 (food sterilization after filling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470110 "LanguaL curation note: Used when a food product was sterilized by holding at a high temperature after filling."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470110 "LanguaL curation note: Used when a food product was sterilized by holding at a high temperature after filling."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470110 "food sterilization after filling"@en)
SubClassOf(obo:FOODON_03470110 obo:FOODON_03470123)

# Class: obo:FOODON_03470111 (preservation by storage in modified atmosphere)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470111 "Preservation by storage in an atmosphere in which the concentrations of oxygen and carbon dioxide are different from those in air. This reduces microbial and enzymatic activity; often used commercially in conjunction with refrigeration (e.g., refrigerated rail cars) for fresh meat and produce."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470111 "preservation by storage in modified atmosphere"@en)
SubClassOf(obo:FOODON_03470111 obo:FOODON_03470176)

# Class: obo:FOODON_03470112 (drying under reduced pressure)

AnnotationAssertion(rdfs:comment obo:FOODON_03470112 "LanguaL curation note: Used when the pressure is reduced to increase the efficiency of water removal."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470112 "drying under reduced pressure"@en)
SubClassOf(obo:FOODON_03470112 obo:FOODON_03470144)

# Class: obo:FOODON_03470113 (food sterilization by irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470113 "A preservation by irradiation process in which microorganisms are reduced or eliminated on or in food material by exposure to ultraviolet irradiation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470113 "LanguaL curation note: Used for a food product that has been packed in a hermetically sealed container and rendered commercially sterile by ionizing radiation (e.g. 24-28 kGy)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470113 "food sterilization by irradiation"@en)
SubClassOf(obo:FOODON_03470113 obo:FOODON_03460179)
SubClassOf(obo:FOODON_03470113 obo:FOODON_03470122)

# Class: obo:FOODON_03470114 (food sterilization by hot filling and cooling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470114 "LanguaL curation note: Used when a sterile product is filled into a container at approximately 212 degrees F and cooled promptly after sealing."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470114 "LanguaL curation note: Used when a sterile product is filled into a container at approximately 212 degrees F and cooled promptly after sealing."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470114 "food sterilization by hot filling and cooling"@en)
SubClassOf(obo:FOODON_03470114 obo:FOODON_03470102)

# Class: obo:FOODON_03470115 (surface pasteurization or disinfection by ultraviolet irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470115 "A preservation by irradiation process in which microorganisms are reduced or eliminated on or in material by exposure to ultraviolet irradiation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470115 "LanguaL curation note: Used when sufficient ultraviolet radiation is applied to destroy most pathogenic and spoilage organisms present on the surface or to inhibit sprouting of stored agricultural produce and destroy storage pests. When followed by refrigeration, also index *preservation by CHILLING*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470115 "surface pasteurization or disinfection by ultraviolet irradiation"@en)
SubClassOf(obo:FOODON_03470115 obo:FOODON_03470138)

# Class: obo:FOODON_03470116 (drying (water reduction))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470116 "A drying process in which water is removed from a material."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470116 wikipedia:Drying)
AnnotationAssertion(dcterms:contributor obo:FOODON_03470116 <https://orcid.org/0000-0002-9578-0788>)
AnnotationAssertion(rdfs:comment obo:FOODON_03470116 "LanguaL curation note: Used when the water activity has been lowered enough to achieve preservation. Also index *WATER REMOVED* in *H. TREATMENT APPLIED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470116 "drying (water reduction)"@en)
SubClassOf(obo:FOODON_03470116 obo:FOODON_03000614)

# Class: obo:FOODON_03470117 (heat drying process)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470117 "Drying of material by application of thermal energy."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470117 "heat drying process"@en)
SubClassOf(obo:FOODON_03470117 obo:FOODON_03000614)

# Class: obo:FOODON_03470119 (pasteurization by irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470119 "A pasteurization process which employs ionizing radiation."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470119 "LanguaL curation note: Used when sufficient radiation (e.g. 10 kGy) is applied to destroy most patho-genic and food spoilage organisms. Also index *preservation by CHILLING*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470119 "pasteurization by irradiation"@en)
SubClassOf(obo:FOODON_03470119 obo:FOODON_03000504)
SubClassOf(obo:FOODON_03470119 obo:FOODON_03470122)

# Class: obo:FOODON_03470120 (heat treatment food preservation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470120 "Preservation by the use of high temperature for a time sufficient to reduce or destroy undesirable microorganisms and enzyme activity. [FDA CFSAN 1995]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470120 "heat treatment food preservation"@en)
SubClassOf(obo:FOODON_03470120 obo:FOODON_03470107)

# Class: obo:FOODON_03470121 (microorganism filtration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470121 "A filtration process which removes microorganisms from an input material."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470121 "microorganism filtration"@en)
SubClassOf(obo:FOODON_03470121 obo:FOODON_03000496)
SubClassOf(obo:FOODON_03470121 obo:OBI_0302885)

# Class: obo:FOODON_03470122 (preservation by ionizing radiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470122 "The application of ionizing radiation to food with the objective of food preservation by irradiation, primarily by high energy electromagnetic waves or particles."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470122 "preservation by ionizing radiation"@en)
SubClassOf(obo:FOODON_03470122 obo:FOODON_03470138)

# Class: obo:FOODON_03470123 (food sterilization by heating)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470123 "LanguaL curation note: Used when the product is rendered commercially sterile by holding at high temperature before or after it is packed in a hermetically sealed container."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470123 "LanguaL curation note: Used when the product is rendered commercially sterile by holding at high temperature before or after it is packed in a hermetically sealed container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470123 "food sterilization by heating"@en)
SubClassOf(obo:FOODON_03470123 obo:FOODON_03470120)

# Class: obo:FOODON_03470124 (osmotic dehydration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470124 "A dehydration process involving osmosis."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470124 "osmotic dehydration"@en)
SubClassOf(obo:FOODON_03470124 obo:FOODON_03000617)

# Class: obo:FOODON_03470126 (aseptic filling and sealing of food)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470126 "LanguaL curation note: Used when a sterile product is filled in a sterile atmosphere into a sterile container. For further detail see 21 CFR 113.3(a)."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470126 "LanguaL curation note: Used when a sterile product is filled in a sterile atmosphere into a sterile container. For further detail see 21 CFR 113.3(a)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470126 "aseptic filling and sealing of food"@en)
SubClassOf(obo:FOODON_03470126 obo:FOODON_03470102)

# Class: obo:FOODON_03470128 (slow freezing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470128 "A freezing process which involves a controlled ambient air temperature of around -18 degrees Celcius."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470128 "A recommendation for conventional freezing is to set a food freezer at -18 Celsius in order to pull heat out of added materials in a timely fashion."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470128 "slow freezing"@en)
SubClassOf(obo:FOODON_03470128 obo:FOODON_03470136)

# Class: obo:FOODON_03470129 (food sterilization by hot filling, held hot and cooling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470129 "LanguaL curation note: Used when a sterile product is filled into a container at approximately 212 degrees F., sealed, and held hot temporarily to complete processing before cooling."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470129 "LanguaL curation note: Used when a sterile product is filled into a container at approximately 212 degrees F., sealed, and held hot temporarily to complete processing before cooling."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470129 "food sterilization by hot filling, held hot and cooling"@en)
SubClassOf(obo:FOODON_03470129 obo:FOODON_03470102)

# Class: obo:FOODON_03470130 (freeze-drying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470130 "Dehydration of food material by freezing it within a vacuum to remove moisture via sublimation, which turns ice directly into vapor."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470130 wikipedia:Freeze_drying)
AnnotationAssertion(rdfs:comment obo:FOODON_03470130 "LanguaL note: \"Usually the product is not stored frozen."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470130 "freeze-drying"@en)
SubClassOf(obo:FOODON_03470130 obo:FOODON_03000617)

# Class: obo:FOODON_03470131 (material chilling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470131 "A cooling material to a threshold process which is at or above the freezing point of water, and less than a cool (~7°C) temperature."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470131 "The temperature range for cooling varies between 30°F and 45°F (-1°C and 7°C), depending on jurisdiction."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470131 "material chilling"@en)
SubClassOf(obo:FOODON_03470131 obo:FOODON_03000531)

# Class: obo:FOODON_03470132 (quick freezing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470132 "A freezing process which happens much more quickly than slow (conventional) freezing,"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470132 wikipedia:Frozen_food)
AnnotationAssertion(rdfs:comment obo:FOODON_03470132 "syn \"fast freezing"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470132 "quick freezing"@en)
SubClassOf(obo:FOODON_03470132 obo:FOODON_03470136)

# Class: obo:FOODON_03470133 (spray-drying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470133 "An artificial heat drying process which outputs a dry powder from an input liquid or slurry by rapidly drying with a hot gas."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470133 wikipedia:Spray_drying)
AnnotationAssertion(rdfs:comment obo:FOODON_03470133 "LanguaL curation note: Used when liquids and low-viscosity pastes or purees are dried by atomisation. Example: milk."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470133 "spray-drying"@en)
SubClassOf(obo:FOODON_03470133 obo:FOODON_03470144)

# Class: obo:FOODON_03470134 (shelf-drying under normal pressure)

AnnotationAssertion(rdfs:comment obo:FOODON_03470134 "LanguaL curation note: Used when water is removed from products placed in trays on shelves under atmospheric pressure. Example: vegetables, fruits."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470134 "shelf-drying under normal pressure"@en)
SubClassOf(obo:FOODON_03470134 obo:FOODON_03470143)

# Class: obo:FOODON_03470135 (pasteurization by heating)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470135 "LanguaL curation note: Used when the product is held at a temperature of 60-150 °C (140-300 °F) for a time sufficient to destroy most pathogenic and food spoilage organisms. When followed by refrigeration, also index *preservation by CHILLING*."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470135 "LanguaL curation note: Used when the product is held at a temperature of 60-150 °C (140-300 °F) for a time sufficient to destroy most pathogenic and food spoilage organisms. When followed by refrigeration, also index *preservation by CHILLING*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470135 "pasteurization by heating"@en)
SubClassOf(obo:FOODON_03470135 obo:FOODON_03000504)
SubClassOf(obo:FOODON_03470135 obo:FOODON_03470120)

# Class: obo:FOODON_03470136 (material freezing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470136 "A cooling material to a threshold which transition its phase from a liquid or gas into a solid."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470136 "We commonly associate water with freezing, but dry ice is an example of gaseous carbon dioxide cooling under pressure and turning directly into solid carbon dioxide blocks. [https://en.wikipedia.org/wiki/Dry_ice]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470136 "material freezing"@en)
SubClassOf(obo:FOODON_03470136 obo:FOODON_03000531)
SubClassOf(obo:FOODON_03470136 obo:FOODON_03470107)

# Class: obo:FOODON_03470137 (brining)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470137 "A food salting process in which food material is Immersed in a salt brine strong enough to suppress enzyme activity and growth of undesirable organisms."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470137 wikipedia:Brining)
AnnotationAssertion(rdfs:label obo:FOODON_03470137 "brining"@en)
SubClassOf(obo:FOODON_03470137 obo:FOODON_03470103)

# Class: obo:FOODON_03470138 (preservation by irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470138 "Preservation by the use of radiation to destroy or suppress undesirable microorganisms or enzyme activity."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470138 "preservation by irradiation"@en)
SubClassOf(obo:FOODON_03470138 obo:COB_0000035)

# Class: obo:FOODON_03470139 (food dry salting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470139 "A food salting process in which food material is packed in dry salt in sufficient quantity to suppress enzyme activity or growth of undesirable organisms."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470139 "food dry salting"@en)
SubClassOf(obo:FOODON_03470139 obo:FOODON_03470103)

# Class: obo:FOODON_03470140 (drum-drying)

AnnotationAssertion(rdfs:label obo:FOODON_03470140 "drum-drying"@en)
SubClassOf(obo:FOODON_03470140 obo:FOODON_03470143)

# Class: obo:FOODON_03470141 (natural heat drying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470141 "Drying by exposure to the sun and/or ambient air."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470141 "LanguaL note: \"Includes field-dried products such as grains and dry beans. These products are included also if they have been artificially dried to return them to normal dry state, e.g. grain that has been artificially dried after harvest."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470141 "natural heat drying"@en)
SubClassOf(obo:FOODON_03470141 obo:FOODON_03470117)

# Class: obo:FOODON_03470142 (refrigeration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470142 "A cooling material to a threshold process which is carried out during short or long-term food storage."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470142 "refrigeration"@en)
EquivalentClasses(obo:FOODON_03470142 ObjectUnionOf(obo:FOODON_03470131 obo:FOODON_03470136))
SubClassOf(obo:FOODON_03470142 obo:FOODON_03000531)
SubClassOf(obo:FOODON_03470142 obo:FOODON_03470107)

# Class: obo:FOODON_03470143 (artificial drying under normal pressure)

AnnotationAssertion(rdfs:label obo:FOODON_03470143 "artificial drying under normal pressure"@en)
SubClassOf(obo:FOODON_03470143 obo:FOODON_03470144)

# Class: obo:FOODON_03470144 (artificial heat drying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470144 "Drying by the application of artificial heat."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470144 "artificial heat drying"@en)
SubClassOf(obo:FOODON_03470144 obo:FOODON_03470117)

# Class: obo:FOODON_03470145 (preservation by reducing water activity)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470145 "A food preservation process which lowers the water activity (relative humidity) of a food product by drying (water reduction) or by adding salt, sugar or other agents to the food."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470145 <https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/inspection-technical-guides/water-activity-aw-foods>)
AnnotationAssertion(rdfs:label obo:FOODON_03470145 "preservation by reducing water activity"@en)
SubClassOf(obo:FOODON_03470145 obo:FOODON_03470107)

# Class: obo:FOODON_03470146 (preservation by adding sugar)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470146 "Preservation by adding sugar, sugar syrup or by partial inversion of disaccharides until the sugar concentration is high enough to prevent growth of microorganisms."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470146 "preservation by adding sugar"@en)
SubClassOf(obo:FOODON_03470146 obo:FOODON_03470145)

# Class: obo:FOODON_03470147 (food sterilization at ultra high temperature (UHT))

AnnotationAssertion(rdfs:label obo:FOODON_03470147 "food sterilization at ultra high temperature (UHT)"@en)
SubClassOf(obo:FOODON_03470147 obo:FOODON_03470126)

# Class: obo:FOODON_03470148 (ultra pasteurization (UP) by heat)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470148 "When used to describe a dairy product, means that such product shall have been thermally processed at or above 138° C (280° C) for at least 2 seconds, either before or after packaging so as to produce a product that has extended shelf life under refrigerated conditions (21 CFR 131.3 (c)). Used to describe liquid egg products that also have been thermally processed, but at a different temperature than for milk products.  The egg product will have an extended shelf life under refrigerated conditions."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470148 "ultra pasteurization (UP) by heat"@en)
SubClassOf(obo:FOODON_03470148 obo:FOODON_03470135)

# Class: obo:FOODON_03470149 (preservation by adding acid)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470149 "Preservation by adding acids or salts to suppress or inhibit undesirable micro-organisms or enzyme activity."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470149 "preservation by adding acid"@en)
SubClassOf(obo:FOODON_03470149 obo:FOODON_03470100)

# Class: obo:FOODON_03470150 (sous vide cooking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470150 "A food cooking method that is intended to maintain the integrity of food material by heating it for an extended period of time in an immersed vacuum sealed plastic pouch at relatively low temperature."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470150 <http://en.wikipedia.org/wiki/Sous-vide>)
AnnotationAssertion(rdfs:label obo:FOODON_03470150 "sous vide cooking"@en)
SubClassOf(obo:FOODON_03470150 obo:FOODON_03450013)

# Class: obo:FOODON_03470151 (preservation of food component by heat treatment)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470151 "LanguaL curation note: Used when an ingredient or a component of a food has undergone preservation by pasteurization, ultrapasteurization or sterilization."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470151 "LanguaL curation note: Used when an ingredient or a component of a food has undergone preservation by pasteurization, ultrapasteurization or sterilization."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470151 "preservation of food component by heat treatment"@en)
SubClassOf(obo:FOODON_03470151 obo:FOODON_03470120)

# Class: obo:FOODON_03470152 (food material preservation by irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470152 "A preservation by irradiation process applied to food material."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470152 wikipedia:Ionizing_radiation)
AnnotationAssertion(rdfs:comment obo:FOODON_03470152 "LanguaL curation note: Used when an ingredient or a component of a food has been preservation by irradiation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470152 "food material preservation by irradiation"@en)
SubClassOf(obo:FOODON_03470152 obo:FOODON_03470138)

# Class: obo:FOODON_03470153 (preservation by adding spices or extracts)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470153 "Preservation by adding spices or extracts (e.g. garlic, onion, horseradish, paprika) to suppress or inhibit undesirable micro-organisms, enzyme activity, or oxidative changes."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470153 "preservation by adding spices or extracts"@en)
SubClassOf(obo:FOODON_03470153 obo:FOODON_03470107)

# Class: obo:FOODON_03470154 (preservation by adding inorganic acids or salts)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470154 "Preservation by adding inorganic acids or salts (e.g. SO2, H2SO4, KNO4, NaNO3)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470154 "preservation by adding inorganic acids or salts"@en)
SubClassOf(obo:FOODON_03470154 obo:FOODON_03470149)

# Class: obo:FOODON_03470155 (preservation by adding organic acids or salts)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470155 "Preservation by adding organic acids or salts (e.g. lactic acid, acetic acid, salicylic acid)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470155 "preservation by adding organic acids or salts"@en)
SubClassOf(obo:FOODON_03470155 obo:FOODON_03470149)

# Class: obo:FOODON_03470156 (preservation by adding antibiotics)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470156 "Preservation by adding antibiotics (e.g. nisin, tylosine, subtlin, bacitracin, chlorotetracyclin, oxytetracyclin) to kill micro organisms or stop their growth."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470156 "preservation by adding antibiotics"@en)
SubClassOf(obo:FOODON_03470156 obo:FOODON_03470100)

# Class: obo:FOODON_03470157 (microorganism ultra-filtration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470157 "A microorganism filtration process that consists of separating particles from a fluid using a semipermeable membrane with pores of 1-100 nanometers."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470157 "Some dairy product are ultrafiltrated in order to obtain a higher protein concentration and hereby, a thicker consistency or textture. LanguaL curation note: Used when a product is preservation by the use of ultra-filtration to remove undesirable micro organisms and molecules. Example: beer."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470157 "microorganism ultra-filtration"@en)
SubClassOf(obo:FOODON_03470157 obo:FOODON_03470121)

# Class: obo:FOODON_03470158 (pasteurization by heat after filling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470158 "Pasteurization by heat after food material has been sealed in a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470158 "pasteurization by heat after filling"@en)
SubClassOf(obo:FOODON_03470158 obo:FOODON_03470181)

# Class: obo:FOODON_03470159 (pasteurization by heat before filling)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470159 "Pasteurization by heat before food material has been sealed in a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470159 "pasteurization by heat before filling"@en)
SubClassOf(obo:FOODON_03470159 obo:FOODON_03470181)

# Class: obo:FOODON_03470160 (ultra high pressure sterilization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470160 "The process of holding food at a high pressure, normally greater than 1000 bar, which leads to sterilization. Example: Fruit juice, jam."@en)
AnnotationAssertion(dcterms:date obo:FOODON_03470160 "https://orcid.org/0000-0002-8844-9165"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_03470160 "ultra high pressure sterilization"@en)
SubClassOf(obo:FOODON_03470160 obo:FOODON_03000494)
SubClassOf(obo:FOODON_03470160 obo:FOODON_03470107)

# Class: obo:FOODON_03470161 (preservation by electron accelerator radiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470161 "Treated by electron accelerator radiation, for example to kill insects in cereals."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470161 "preservation by electron accelerator radiation"@en)
SubClassOf(obo:FOODON_03470161 obo:FOODON_03470138)

# Class: obo:FOODON_03470162 (disinfection by irradiation)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470162 "LanguaL curation note: Used when sufficient radiation (e.g. 1-5 k gy) is applied to destroy pathogenic and food spoilage organisms. Example: spices. Radurised food should be stored in a cool and dry place."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470162 "LanguaL curation note: Used when sufficient radiation (e.g. 1-5 k gy) is applied to destroy pathogenic and food spoilage organisms. Example: spices. Radurised food should be stored in a cool and dry place."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470162 "disinfection by irradiation"@en)
SubClassOf(obo:FOODON_03470162 obo:FOODON_03470122)

# Class: obo:FOODON_03470163 (drying by radiation)

AnnotationAssertion(rdfs:comment obo:FOODON_03470163 "LanguaL curation note: Used when the water activity is lowered enough by high frequency heating in order to achieve preservation."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470163 "drying by radiation"@en)
SubClassOf(obo:FOODON_03470163 obo:FOODON_03000614)

# Class: obo:FOODON_03470165 (drying by microwave radiation)

AnnotationAssertion(rdfs:comment obo:FOODON_03470165 "LanguaL curation note: Used when the water activity is lowered enough by microwave radiation in order to achieve preservation. Also index *WATER REMOVED* in facet H - Treatment applied. Example: tea."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470165 "drying by microwave radiation"@en)
SubClassOf(obo:FOODON_03470165 obo:FOODON_03470163)

# Class: obo:FOODON_03470166 (drying by infrared heat radiation)

AnnotationAssertion(rdfs:comment obo:FOODON_03470166 "LanguaL curation note: Used when susceptible materials are dried by electromagnetic radiation with wave-lengths between 0.76um and 1 mm."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470166 "drying by infrared heat radiation"@en)
SubClassOf(obo:FOODON_03470166 obo:FOODON_03470143)

# Class: obo:FOODON_03470168 (artificial drying under increased pressure)

AnnotationAssertion(rdfs:comment obo:FOODON_03470168 "LanguaL curation note: Used when a product is dehydrated under pressure. Example: vegetable or fruit juices, milk."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470168 "artificial drying under increased pressure"@en)
SubClassOf(obo:FOODON_03470168 obo:FOODON_03470144)

# Class: obo:FOODON_03470169 (concentration by reverse osmosis)

AnnotationAssertion(rdfs:comment obo:FOODON_03470169 "LanguaL curation note: Used when the water content of a product is reduced by reverse osmosis. Typically used for concentrating fluids, e.g. milk, fruit juices."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470169 "concentration by reverse osmosis"@en)
SubClassOf(obo:FOODON_03470169 obo:FOODON_03470112)

# Class: obo:FOODON_03470170 (sun drying)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470170 "Drying by exposure to the sun."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470170 "This implies that material is also subjected to ambient air during the drying process."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470170 "sun drying"@en)
SubClassOf(obo:FOODON_03470170 obo:FOODON_03470141)

# Class: obo:FOODON_03470171 (cryogenic freezing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470171 "Frozen very rapidly by means of refrigerating agents such as liquid nitrogen or carbon dioxide."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470171 wikipedia:Flash_freezing)
AnnotationAssertion(rdfs:comment obo:FOODON_03470171 "This process involves being frozen by a refrigerating agent."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470171 "cryogenic freezing"@en)
SubClassOf(obo:FOODON_03470171 obo:FOODON_03470132)

# Class: obo:FOODON_03470172 (refrigeration with a refrigerating agent)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470172 "A process of refrigeration involving a refrigerating agent."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_03470172 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03470172 "Refrigeration can be as complex as with compressors and gas, or as simple as with ice in a container."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470172 "refrigeration with a refrigerating agent"@en)
SubClassOf(obo:FOODON_03470172 obo:FOODON_03470142)

# Class: obo:FOODON_03470173 (inert atmosphere storage)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470173 "Preservation by storage in inert gases (e.g. nitrogen) to suppress or inhibit undesirable micro-organism growth, oxidation activity, etc."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470173 "inert atmosphere storage"@en)
SubClassOf(obo:FOODON_03470173 obo:FOODON_03470176)

# Class: obo:FOODON_03470174 (vaccum storage)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470174 "Storing under reduced pressure (e.g. 1.3-2 kPa) in order to suppress or inhibit undesirable micro organism growth, oxidation activity, etc."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470174 "vaccum storage"@en)
SubClassOf(obo:FOODON_03470174 obo:FOODON_03470176)

# Class: obo:FOODON_03470175 (food blanching)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470175 "Blanching is a cooking process wherein a food, usually a vegetable or fruit, is scalded in boiling water, removed after a brief, timed interval, and finally plunged into iced water or placed under cold running water to halt the cooking process."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03470175 <https://en.wikipedia.org/wiki/Blanching_(cooking)>)
AnnotationAssertion(dcterms:contributor obo:FOODON_03470175 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_03470175 "LanguaL definition: \"Short time scalding; this can be used to stop emzymatic activity for vegetables being prepared for freezing."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470175 "food blanching"@en)
SubClassOf(obo:FOODON_03470175 obo:FOODON_03000548)
SubClassOf(obo:FOODON_03470175 obo:FOODON_03460130)
SubClassOf(obo:FOODON_03470175 obo:FOODON_03470120)

# Class: obo:FOODON_03470176 (controlled atmosphere storage)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470176 "Storage of fruits and vegetables in an atmosphere in which the concentrations of oxygen, carbon dioxide (and often nitrogen) are different from those in air and at a low temperature. All three (four) factors are controlled at the desired levels in order to suppress the fruits' and vegetables' natural respiration."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470176 "controlled atmosphere storage"@en)
SubClassOf(obo:FOODON_03470176 obo:FOODON_03470107)

# Class: obo:FOODON_03470177 (microorganism micro-filtration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470177 "A microorganism filtration process that consists of separating components by using semipermeable membranes with pore sizes between 0.1 and 10 micrometers to remove suspended particles or microorganisms from a fluid."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470177 "microorganism micro-filtration"@en)
SubClassOf(obo:FOODON_03470177 obo:FOODON_03470121)

# Class: obo:FOODON_03470178 (high temperature short time (HTST) pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470178 "High Temperature Short Time (HTST) pasteurization is one of the most common methods of pasteurization , which uses metal plates and hot water to raise milk temperatures to at least 72° C (161° F) for not less than 15 seconds, followed by rapid cooling."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470178 "high temperature short time (HTST) pasteurization"@en)
SubClassOf(obo:FOODON_03470178 obo:FOODON_03470135)

# Class: obo:FOODON_03470179 (higher heat shorter time (HHST) pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470179 "Higher Heat Shorter Time (HHST) is a process similar to HTST pasteurization, but it uses slightly different equipment and higher temperatures (83 - 127° C) for a shorter time."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470179 "higher heat shorter time (HHST) pasteurization"@en)
SubClassOf(obo:FOODON_03470179 obo:FOODON_03470135)

# Class: obo:FOODON_03470180 (ultra high temperature (UHT) pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470180 "Typically involves heating milk or cream to 135° to 150° C (275° to 302° F) for 1 or 2 seconds. The milk is then packaged in sterile, hermetically-sealed (airtight) containers (aspetic filling) and can be stored without refrigeration for up to 90 days. After opening, spoilage times for UHT products are similar to those of conventionally pasteurized products."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470180 "ultra high temperature (UHT) pasteurization"@en)
SubClassOf(obo:FOODON_03470180 obo:FOODON_03470135)

# Class: obo:FOODON_03470181 (filling conditions for pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470181 "A pasteurization by heating process in which containers are pasteurized in preparation for a filling process."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470181 "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470181 "filling conditions for pasteurization"@en)
SubClassOf(obo:FOODON_03470181 obo:FOODON_03470135)

# Class: obo:FOODON_03470182 (low-temperature-long-time (LTLT) pasteurization)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03470182 "A pasteurization by heating process which uses low heat for a longer time to kill pathogenic bacteria."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03470182 "An example of LTLT is when milk is pasteurized at 63° C (145° F) for 30 minutes."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03470182 "low-temperature-long-time (LTLT) pasteurization"@en)
SubClassOf(obo:FOODON_03470182 obo:FOODON_03470135)

# Class: obo:FOODON_03530050 (fruit or vegetable ripeness)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530050 "A food plant physical characteristic about the ripening stage of development of a fruit (or vegetable)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530050 "fruit or vegetable ripeness"@en)
SubClassOf(obo:FOODON_03530050 obo:FOODON_03530268)

# Class: obo:FOODON_03530051 (unripe)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530051 "A fruit (or vegetable) ripeness characteristic in which a fruit has not achieved full maturity and is not slightly ripe."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03530051 "broad syn. unripe; immature"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530051 "unripe"@en)
SubClassOf(obo:FOODON_03530051 obo:FOODON_03530050)

# Class: obo:FOODON_03530052 (ripe)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530052 "A fruit (or vegetable) ripeness characteristic in which a fruit has achieved full maturity and is ready for utilization."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530052 "ripe"@en)
SubClassOf(obo:FOODON_03530052 obo:FOODON_03530050)

# Class: obo:GO_0009835 (fruit ripening)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0009835 "An developmental maturation process that has as participant a fruit. Ripening causes changes in one or more characteristics of a fruit (color, aroma, flavor, texture, hardness, cell wall structure) and may make it more attractive to animals and aid in seed dispersal."@en)
AnnotationAssertion(obo:IAO_0000119 obo:GO_0009835 wikipedia:Ripening)
AnnotationAssertion(rdfs:label obo:GO_0009835 "fruit ripening"@en)
SubClassOf(obo:GO_0009835 obo:FOODON_03000630)
SubClassOf(obo:GO_0009835 obo:FOODON_03460252)

# Class: obo:OBI_0302885 (filtration)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0302885 "filtration is a process which separates components suspended in a fluid based on granularity properties relying on a filter device."@en)
AnnotationAssertion(rdfs:label obo:OBI_0302885 "filtration"@en)
SubClassOf(obo:OBI_0302885 obo:OBI_0600014)

# Class: obo:OBI_0400109 (homogenizer)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0400109 "A device which performs a homogenization process."@en)
AnnotationAssertion(rdfs:label obo:OBI_0400109 "homogenizer"@en)
SubClassOf(obo:OBI_0400109 obo:COB_0001300)

# Class: obo:OBI_0600014 (material component separation)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0600014 "A material processing in which components of an input material become segregated in space"@en)
AnnotationAssertion(rdfs:comment obo:OBI_0600014 "Note this allows for centrifugation, where an output material may have adjacent but distinct components."@en)
AnnotationAssertion(rdfs:label obo:OBI_0600014 "material component separation"@en)
SubClassOf(obo:OBI_0600014 obo:COB_0000110)

# Class: obo:PATO_0000033 (concentration of)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000033 "A quality inhering in a substance by virtue of the amount of the bearer's there is mixed with another substance."@en)
AnnotationAssertion(rdfs:comment obo:PATO_0000033 "Problematic definition where both substances are “part of” bearer."@en)
AnnotationAssertion(rdfs:label obo:PATO_0000033 "concentration of"@en)

# Class: obo:PATO_0000146 (temperature)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000146 "A physical quality of the thermal energy of a system."@en)
AnnotationAssertion(rdfs:label obo:PATO_0000146 "temperature"@en)
SubClassOf(obo:PATO_0000146 obo:PATO_0001241)

# Class: obo:PATO_0000998 (viscous)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000998 "A viscosity quality inhering in a bearer by virtue of the bearer's having viscosity."@en)
AnnotationAssertion(rdfs:label obo:PATO_0000998 "viscous"@en)
SubClassOf(obo:PATO_0000998 obo:PATO_0000992)

# Class: obo:PATO_0001432 (decayed)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001432 "A quality inhering in a bearer by virtue of the bearer's decomposition into component parts."@en)
AnnotationAssertion(rdfs:comment obo:PATO_0001432 "This also allows for chemical synthesis resulting from decomposition products."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001432 "decayed"@en)
SubClassOf(obo:PATO_0001432 obo:PATO_0000169)

# Class: obo:PATO_0001546 (quality of a solid)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001546 "A physical quality inhering in a bearer by virtue of the bearer's exhibiting the physical characteristics of an entity characterized by particles arranged such that their shape and volume are relatively stable."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001546 "quality of a solid"@en)
SubClassOf(obo:PATO_0001546 obo:PATO_0002198)

# Class: obo:PATO_0001548 (quality of a liquid)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001548 "A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001548 "quality of a liquid"@en)
SubClassOf(obo:PATO_0001548 obo:PATO_0002198)

# Class: obo:PATO_0001822 (wet)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001822 "A quality inhering in a bearer by virtue of whether the bearer's being covered by a liquid."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001822 "wet"@en)

# Class: obo:PATO_0001824 (dry)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001824 "A wetness quality inhering in a bearer by virtue of the bearer's not being covered by a liquid."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001824 "dry"@en)

# Class: obo:PATO_0001842 (acidity)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001842 "A concentration quality inhering in a bearer by virtue of the bearer's containing acid (hydrogen ions)."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001842 "acidity"@en)

# Class: obo:PATO_0001985 (frozen)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0001985 "A quality inhering in a bearer by virtue of the bearer's being kept below its freezing point."@en)
AnnotationAssertion(rdfs:label obo:PATO_0001985 "frozen"@en)
SubClassOf(obo:PATO_0001985 obo:PATO_0000146)


