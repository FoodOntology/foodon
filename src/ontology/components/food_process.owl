# Class: obo:FOODON_00004041 (destemmed grape pressing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004041 "A grape pressing process in which whole grapes or destemmed grape must is input directly into a grape press."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004041 <https://en.wikipedia.org/wiki/Pressing_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004041 "destemmed grape pressing"@en)
SubClassOf(obo:FOODON_00004041 obo:FOODON_00004040)
SubClassOf(obo:FOODON_00004041 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00003417))

# Class: obo:FOODON_00004042 (whole-cluster grape pressing)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004042 "A grape pressing process in which whole grapes and grape clusters are input directly into a grape press."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004042 <https://en.wikipedia.org/wiki/Pressing_(wine)>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004042 "By avoiding a maceration process, this technique limits the extraction of phenolics into white wines."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004042 "whole-cluster grape pressing"@en)
SubClassOf(obo:FOODON_00004042 obo:FOODON_00004040)
SubClassOf(obo:FOODON_00004042 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00003638))

# Class: obo:FOODON_00004043 (grape crushing and destemming)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004043 "A food component separation that accomplishes grape crushing and destemming with one device."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00004043 "This process may be carried out by a \"stemmer-crusher\" aka \"destemmer-crusher\"."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004043 "grape crushing and destemming"@en)
SubClassOf(obo:FOODON_00004043 obo:FOODON_03460238)
SubClassOf(obo:FOODON_00004043 ObjectSomeValuesFrom(obo:OBI_0000293 ObjectUnionOf(obo:FOODON_00003417 obo:FOODON_00003638)))
SubClassOf(obo:FOODON_00004043 ObjectSomeValuesFrom(obo:OBI_0000299 obo:FOODON_00004039))

# Class: obo:FOODON_00004068 (winemaking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004068 "A food material processing which is the production of wine, starting with the selection of the fruit, its fermentation into alcohol, and the bottling or packaging of the finished liquid."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004068 wikipedia:Winemaking)
AnnotationAssertion(rdfs:label obo:FOODON_00004068 "winemaking"@en)
SubClassOf(obo:FOODON_00004068 obo:FOODON_00002451)

# Class: obo:FOODON_00004069 (wine maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004069 "A food modification which is a step in winemaking where the phenolic materials of the grape - tannins, coloring agents (anthocyanins) and flavor compounds - are leached from the grape skins, seeds and stems into the must."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004069 <https://en.wikipedia.org/wiki/Maceration_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004069 "wine maceration"@en)
SubClassOf(obo:FOODON_00004069 obo:FOODON_03460141)

# Class: obo:FOODON_00004070 (conventional maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004070 "A wine maceration process which occurs in a room temperature environment without other atmospheric controls.????"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004070 "conventional maceration"@en)
SubClassOf(obo:FOODON_00004070 obo:FOODON_00004069)

# Class: obo:FOODON_00004071 (hot maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004071 "A method of maceration involving high-temperature treatment of grape must before fermentation."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004071 <https://www.bio-conferences.org/articles/bioconf/full_html/2017/02/bioconf-oiv2017_02032>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004071 "Various techniques of thermo-maceration were developed on the basis of evolution of the industrial technologies. The extraction principle consists in heating the whole grapes or the crushed and destemmed grapes to high temperatures (65–80◦C), promoting the diffusion of phenolics from the skins, especially anthocyanins.\"[https://www.bio-conferences.org/articles/bioconf/full_html/2017/02/bioconf-oiv2017_02032]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004071 "hot maceration"@en)
SubClassOf(obo:FOODON_00004071 obo:FOODON_00004069)

# Class: obo:FOODON_00004072 (limited maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004072 "A maceration process where seeds and skins of grapes are left in contact with juice or wine for a shorter period of time."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004072 "limited maceration"@en)
SubClassOf(obo:FOODON_00004072 obo:FOODON_00004069)

# Class: obo:FOODON_00004073 (extended maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004073 "A maceration process where seeds and skins of grapes are left in contact with juice or wine for a longer period of time."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004073 "extended maceration"@en)
SubClassOf(obo:FOODON_00004073 obo:FOODON_00004069)

# Class: obo:FOODON_00004074 (cold maceration)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00004074 "https://www.sciencedirect.com/science/article/abs/pii/S0023643818304122")
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004074 "A wine maceration process in which  temperatures of the fermenting must are kept low to encourage extraction by water and added sulfur dioxide rather than relying principally on heat and alcohol to act as a solvent."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004074 <https://en.wikipedia.org/wiki/Maceration_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004074 "cold maceration"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004074 wikipedia:Sulfur_dioxide)
SubClassOf(obo:FOODON_00004074 obo:FOODON_00004069)

# Class: obo:FOODON_00004075 (carbonic maceration)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004075 "A maceration process in which whole grapes are fermented in a carbon dioxide rich environment before crushing.  Fermentation occurs within grape tissue, rather than from the skin surface."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004075 wikipedia:Carbonic_maceration)
AnnotationAssertion(rdfs:comment obo:FOODON_00004075 "This method involves filling a sealed vessel with carbon dioxide and then adding whole grapes or grape clusters. ... Carbonic maceration ferments most of the juice while it is still inside the grape, although grapes at the bottom of the vessel are crushed by gravity and undergo conventional fermentation.\"[https://en.wikipedia.org/wiki/Carbonic_maceration]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004075 "carbonic maceration"@en)
SubClassOf(obo:FOODON_00004075 obo:FOODON_00004069)
SubClassOf(obo:FOODON_00004075 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00003417))

