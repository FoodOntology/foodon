AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000665 "A food processing method which reduces the relative proportion of one component of a food. ISSUE : Is this always a subcomponent of \"material separation\"?"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03000665 "This is not necessarily a child of food component separation, in the case where new components are made out of the constituents of old components."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03000665 "component reduction"@en)
SubClassOf(obo:FOODON_03000665 obo:OBI_0600014)

# Class: obo:FOODON_03000666 (comminution)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03000666 "A physical forming process involving the reduction of solid materials from one average particle size to a smaller average particle size, by crushing, grinding, cutting, vibrating, or other processes."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03000666 wikipedia:Comminution)
AnnotationAssertion(rdfs:label obo:FOODON_03000666 "comminution"@en)
SubClassOf(obo:FOODON_03000666 obo:OBI_0600014)

