AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460298 "LanguaL curation note: Used when a clotting enzyme is added to a food product at any level."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460298 "LanguaL curation note: Used when a clotting enzyme is added to a food product at any level."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460298 "clotting enzyme addition"@en)
