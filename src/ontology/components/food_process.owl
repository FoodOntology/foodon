AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002755 "Food material which has undergone rehydration."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002755 "food (rehydrated)"@en)
SubClassOf(obo:FOODON_00002755 obo:FOODON_00002454)

# Class: obo:FOODON_00002814 (ikajime)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002814 "An animal harvesting process in which a fish is slaughtered by insertion of a spike quickly and directly into the hindbrain, usually located slightly behind and above the eye, thereby causing immediate brain death, which enables the quality of the fishes' meat to be maintained."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002814 wikipedia:Ikejime)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002814 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:comment obo:FOODON_00002814 "The technique originated in Japan, but is now in widespread use. [...] When spiked correctly, the fish fins flare and the fish relaxes, immediately ceasing all motion. Destroying the brain and the spinal cord of the fish will prevent reflex action from happening; such muscle movements would otherwise consume adenosine triphosphate (ATP) in the muscle, and as a result produce lactic acid and ammonia, making the fish sour, soggy and less tasteful. Furthermore, the blood contained in the fish flesh retracts to the gut cavity, which produces a better coloured and flavoured fillet, and prolongs shelf life.\" [Wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002814 "ikajime"@en)
SubClassOf(obo:FOODON_00002814 obo:FOODON_00005719)
SubClassOf(obo:FOODON_00002814 obo:FOODON_03460111)

# Class: obo:FOODON_00002971 (food (precooked))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002971 "Food material which has been prepared and cooked in advance so that it only needs to be heated quickly (if at all) before consumption."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002971 "food (precooked)"@en)
SubClassOf(obo:FOODON_00002971 obo:FOODON_00002454)

# Class: obo:FOODON_00002976 (food (powdered))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002976 "Ground food material which has a powdered characteristic."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002976 "food (powdered)"@en)
SubClassOf(obo:FOODON_00002976 obo:FOODON_00002713)
SubClassOf(obo:FOODON_00002976 obo:FOODON_03000717)

# Class: obo:FOODON_00003203 (harvesting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003203 "A process which takes in some food material from an individual or community of plant or animal organisms in a given context and time, and outputs a precursor or consumable food product. This may include a part of an organism or the whole, and may involve killing the organism."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00003203 "This includes harvesting from plants, hunting a deer, or milking process of a cow.  The food is derived from part or whole of a single organism species (with perhaps a few exceptions, such as lichen)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003203 "harvesting"@en)
SubClassOf(obo:FOODON_00003203 obo:FOODON_03460238)
SubClassOf(obo:FOODON_00003203 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00003402))
SubClassOf(obo:FOODON_00003203 ObjectSomeValuesFrom(obo:OBI_0000299 obo:FOODON_00003374))

# Class: obo:FOODON_00003215 (winterization of oil)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003215 "Winterization of oil is a process that uses a solvent and cold temperatures to separate lipids and other desired oil compounds from waxes. Winterization is a type of fractionation, the general process of separating the triglycerides found in fats and oils, using the difference in their melting points, solubility, and volatility."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003215 "winterization of oil"@en)
SubClassOf(obo:FOODON_00003215 obo:FOODON_03000660)

# Class: obo:FOODON_00003307 (shell removal)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003307 "A process which separates a culinary nut's shell from its meat, leaving the meat part more or less intact."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003307 "shell removal"@en)
SubClassOf(obo:FOODON_00003307 obo:FOODON_03460238)

# Class: obo:FOODON_00003346 (overripe)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003346 "A fruit (or vegetable) ripeness characteristic in which a fruit has surpassed ripeness and is undergoing decomposition."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003346 "overripe"@en)
SubClassOf(obo:FOODON_00003346 obo:FOODON_03530050)

# Class: obo:FOODON_00003347 (slightly ripe)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003347 "A fruit (or vegetable)  ripeness characteristic in which a fruit has some ripe part or is about to achieve full maturity."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_00003347 "broad syn. slightly ripe"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003347 "slightly ripe"@en)
SubClassOf(obo:FOODON_00003347 obo:FOODON_03530050)

