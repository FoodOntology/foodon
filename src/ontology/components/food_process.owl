# Class: obo:ENVO_00010506 (emulsion)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_00010506 "A mixture of two immiscible (unblendable) substances. One substance (the dispersed phase) is dispersed in the other (the continuous phase)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:ENVO_00010506 <https://ebooks.inflibnet.ac.in/ftp02/chapter/size-reduction-2-emulsification-and-homogenization/>)
AnnotationAssertion(rdfs:label obo:ENVO_00010506 "emulsion"@en)
SubClassOf(obo:ENVO_00010506 obo:BFO_0000040)

# Class: obo:ENVO_01001687 (mass of solid material)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001687 "An mass of environmental material which is composed primarily of a solid environmental material"@en)
AnnotationAssertion(rdfs:label obo:ENVO_01001687 "mass of solid material"@en)
SubClassOf(obo:ENVO_01001687 obo:ENVO_01001686)

# Class: obo:ENVO_01001690 (mass of liquid)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001690 "An object which is composed primarily of a liquid."@en)
AnnotationAssertion(rdfs:label obo:ENVO_01001690 "mass of liquid"@en)
SubClassOf(obo:ENVO_01001690 obo:ENVO_01001688)

# Class: obo:FOODON_00000071 (cutting)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00000071 "A process of cutting material into smaller pieces, chunks or slices."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00000071 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00000071 "cutting"@en)
SubClassOf(obo:FOODON_00000071 obo:FOODON_03000666)

# Class: obo:FOODON_00001079 (food (pickled))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001079 "Food material which is subjected to fermentation or acidification."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00001079 wikipedia:Pickling)
AnnotationAssertion(rdfs:comment obo:FOODON_00001079 "Pickled food is often preserved by soaking and storing it in vinegar or brine."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00001079 "food (pickled)"@en)
SubClassOf(obo:FOODON_00001079 obo:FOODON_00002158)

# Class: obo:FOODON_00001181 (food (cooked))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00001181 "A food material which has undergone a cooking process."@en)
