SubClassOf(obo:FOODON_03460270 obo:FOODON_03460130)

# Class: obo:FOODON_03460274 (food flaking)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460274 "A physical forming process in which cooked particles of grain or tiny pellets of dough are forced between very heavy rollers that convert each piece into a single flake."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03460274 "LanguaL curation note: Used only for breakfast cereals made by forcing cooked particles of grain or tiny pellets of dough between very heavy rollers that convert each piece into a single flake."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460274 "food flaking"@en)
