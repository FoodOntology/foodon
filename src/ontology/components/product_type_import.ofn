# Class: obo:FOODON_03540169 (01690 - pretzels (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540169 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540169 "The group includes any type of soft Pretzels. This group includes only the \"bread-like\" pretzel made from wheat flour, water and yeast, usually sprinkled with coarse salt and baked in form of knot. The hard salted snacks in form of small pretzel are not included in this term and should be coded as A00FG 'Sticks, salty'. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Pretzels] and [https://www.google.co.uk/search?tbm=isch&q=Pretzels soft]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540169 langual:A005V)
AnnotationAssertion(rdfs:label obo:FOODON_03540169 "01690 - pretzels (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540169 obo:FOODON_03540165)

