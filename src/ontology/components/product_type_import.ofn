AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543701 "The group includes any type of Coffee beverages, most often made with ground coffee beans and hot water (and possibly other ingredients). The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks] and [https://www.google.co.uk/search?tbm=isch&q=Coffee beverages]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543701 langual:A03KA)
AnnotationAssertion(rdfs:label obo:FOODON_03543701 "37010 - coffee beverages (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543701 obo:FOODON_03543700)
SubClassOf(obo:FOODON_03543701 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002351 obo:FOODON_00001139) ObjectAllValuesFrom(obo:RO_0002351 obo:FOODON_00001139)))

# Class: obo:FOODON_03543702 (37020 - coffee espresso (beverage) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543702 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543702 "The group includes any type of Coffee espresso beverage. This is normally produced with 7 grams of ground coffee with 30 (in some cases up to 50) ml of water. This corresponds to using approximately 200 grams of coffee per liter. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks] and [https://www.google.co.uk/search?tbm=isch&q=Coffee espresso]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543702 langual:A03KB)
AnnotationAssertion(rdfs:label obo:FOODON_03543702 "37020 - coffee espresso (beverage) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543702 obo:FOODON_03543701)

# Class: obo:FOODON_03543703 (37030 - coffee (strong) beverage (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543703 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543703 "The group includes any type of Coffee (strong) beverage. It corresponds to more than 55-60 grams of coffee per liter. This is for example produced by brewing 7 grams of coffee in 120 ml or less of water. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543703 langual:A167A)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543703 "norvegian coffee"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543703 "37030 - coffee (strong) beverage (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543703 obo:FOODON_03543701)

# Class: obo:FOODON_03543704 (37040 - coffee (average strength) beverage (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543704 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543704 "The group includes any type of Coffee (average strenght) beverage. It corresponds to 40-60 (ideally 45-55) grams of coffee per liter. This is for example produced by dripping 7 grams of coffee in roughly 125-150 ml of water. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543704 langual:A03KC)
AnnotationAssertion(rdfs:label obo:FOODON_03543704 "37040 - coffee (average strength) beverage (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543704 obo:FOODON_03543701)

# Class: obo:FOODON_03543705 (37050 - coffee (weak strength) beverage (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543705 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543705 "The group includes any type of Coffee (weak strenght) beverage. This corresponds to less than 45 grams of coffee per liter. This is for example produced by extracting (e.g. french press) 7 grams of coffee in 200 ml of water (35 grams per liter). The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543705 langual:A03KD)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543705 "americano coffee"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543705 "37050 - coffee (weak strength) beverage (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543705 obo:FOODON_03543701)

# Class: obo:FOODON_03543706 (37060 - instant coffee (beverage) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543706 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543706 "The group includes any type of Instant coffee beverage (except coffee decaffeinated). This is for example produced by diluting 3.4 grams of soluble coffee in roughly 150 ml of water. This corresponds to a dilution factor of approximately 0.02. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543706 langual:A03KE)
AnnotationAssertion(rdfs:label obo:FOODON_03543706 "37060 - instant coffee (beverage) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543706 obo:FOODON_03543701)

# Class: obo:FOODON_03543707 (37070 - coffee beverage decaffeinated (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543707 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543707 "The group includes any type of Coffee beverage decaffeinated (caffeine-free). When relevant, information on whether the coffee beverage decaffeinated was made by e.g. soluble decaffeinated coffee or coffee ground decaffeinated has to be reported with additional facet descriptors. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543707 langual:A03KF)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543707 "coffee beverage caffeine-free"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543707 "37070 - coffee beverage decaffeinated (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543707 obo:FOODON_03543701)

# Class: obo:FOODON_03543708 (37080 - coffee with milk or cream (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543708 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543708 "The group includes any type of Coffee with milk or dairy-cream. This term should not be used in case of coffee with milk/cream imitates and substitutes (non-dairy); in these latter cases use a proper coffee beverage as base term and add the dairy imitate ingredient as facet descriptor. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/List_of_coffee_drinks] and [https://www.google.co.uk/search?tbm=isch&q=Coffee with milk or cream]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543708 langual:A03KG)
AnnotationAssertion(rdfs:label obo:FOODON_03543708 "37080 - coffee with milk or cream (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543708 obo:FOODON_03543701)

# Class: obo:FOODON_03543709 (37090 - coffee drink, cappuccino (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543709 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543709 "The group includes any type of coffee drink called cappuccino, i.e. a coffee beverage usually prepared with double espresso, hot milk, and steamed milk foam. This term should not be used in case of cappuccino made with milk imitates and substitutes (non-dairy); in these latter cases use a proper coffee beverage as base term and add the dairy imitate ingredient as facet descriptor. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/Cappuccino] and [https://www.google.co.uk/search?tbm=isch&q=Coffee drink, cappuccino]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543709 langual:A03KH)
AnnotationAssertion(rdfs:label obo:FOODON_03543709 "37090 - coffee drink, cappuccino (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543709 obo:FOODON_03543708)

# Class: obo:FOODON_03543710 (37100 - coffee drink, café macchiato (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543710 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543710 "The group includes any type of Coffee drink called café macchiato, i.e. a coffee beverage usually prepared with an espresso and a small amount of milk. This term should not be used in case of café macchiato made with milk imitates and substitutes (non-dairy); in these latter cases use a proper coffee beverage as base term and add the dairy imitate ingredient as facet descriptor. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/Caffè_macchiato]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543710 langual:A03KJ)
AnnotationAssertion(rdfs:label obo:FOODON_03543710 "37100 - coffee drink, café macchiato (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543710 obo:FOODON_03543708)

