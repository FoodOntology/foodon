# Class: obo:FOODON_03541909 (19090 - mammals and birds meat (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03541909 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03541909 "The group includes any type of Meat (flesh) from mammals or birds. Meat refers here to substantially lean meat or including some, but not predominant, amount of fat. In some cases the meat is marketed together with bones (not eaten as such). The part consumed/analysed is by default a portion proportionally representing all heterogeneity observed in this food item/group. When relevant, information on the part consumed/analysed has to be reported with additional facet descriptors.[https://en.wikipedia.org/wiki/meat] and [https://www.google.co.uk/search?tbm=isch&q=meat]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03541909 langual:A0EYH)
AnnotationAssertion(rdfs:label obo:FOODON_03541909 "19090 - mammals and birds meat (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03541909 obo:FOODON_03541876)

# Class: obo:FOODON_03541910 (19100 - mammals meat (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03541910 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03541910 "The group includes any type of meat (with eventually minor amounts of fat) from all mammals, including wild or game individual.[https://en.wikipedia.org/wiki/Meat]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03541910 langual:A0EYF)
AnnotationAssertion(rdfs:label obo:FOODON_03541910 "19100 - mammals meat (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03541910 obo:FOODON_03541909)

