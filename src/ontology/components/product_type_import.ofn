AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400210 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400210 "Sweetened bakery product that is leavened and baked."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400210 langual:A0210)
AnnotationAssertion(rdfs:label obo:FOODON_03400210 "cake (us cfr)"@en)
SubClassOf(obo:FOODON_03400210 obo:FOODON_03400135)

