AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400799 "Dishes whose predominant ingredient is seen to be meat; e.g. stew, meat burger, meat balls, meat pie or pasty"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400799 langual:A0799)
AnnotationAssertion(rdfs:label obo:FOODON_03400799 "meat dish (eurofir)"@en)
