AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400165 "custard, frozen"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400165 "french custard ice cream"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400165 "french ice cream"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400165 "ice cream, french"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400165 "frozen custard (us cfr)"@en)
SubClassOf(obo:FOODON_03400165 obo:FOODON_03400137)

