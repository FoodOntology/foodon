# Class: obo:FOODON_03400779 (milk (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400779 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400779 "Milk in all forms, milk-based beverage, cultured milk product, or milk."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400779 langual:A0779)
AnnotationAssertion(rdfs:comment obo:FOODON_03400779 "LanguaL curation note: Index also * MILK OR MILK COMPONENT* or underlying term in facet C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400779 "milk (eurofir)"@en)
SubClassOf(obo:FOODON_03400779 obo:FOODON_03400778)

# Class: obo:FOODON_03400780 (liquid milk (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400780 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400780 "Liquid milks are the secretion of the mammary gland of animals such as cow, sheep, goat, buffalo and camel, and include Human milk. The category includes milks that have only been processed for reasons of food safety (e.g. pasteurisation), preservation (e.g. UHT) or skimming to reduce fat content."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400780 langual:A0780)
AnnotationAssertion(rdfs:comment obo:FOODON_03400780 "LanguaL curation note: Index also *MILK* in facet C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400780 "liquid milk (eurofir)"@en)
SubClassOf(obo:FOODON_03400780 obo:FOODON_03400779)

# Class: obo:FOODON_03400781 (processed milk (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400781 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400781 "Processed milks are milks that have been subject to processing that modifies their consistency (e.g. evaporated milk) and/or composition other than fat content (e.g. whey). The group also includes milk-based drinks like milkshakes."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400781 langual:A0781)
AnnotationAssertion(rdfs:comment obo:FOODON_03400781 "LanguaL curation note: Index also *MILK OR MILK COMPONENT* or underlying term in facet C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400781 "processed milk (eurofir)"@en)
SubClassOf(obo:FOODON_03400781 obo:FOODON_03400779)

# Class: obo:FOODON_03400782 (cream (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400782 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400782 "Includes fresh cream, crème fraîche and sour cream."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400782 langual:A0782)
AnnotationAssertion(rdfs:comment obo:FOODON_03400782 "LanguaL curation note: Index also *CREAM* or underlying terms in facet C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400782 "cream (eurofir)"@en)
SubClassOf(obo:FOODON_03400782 obo:FOODON_03400779)

# Class: obo:FOODON_03400783 (fermented milk product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400783 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400783 "Fermented milk is a milk product obtained by fermentation of milk, which milk may have been manufactured from products obtained from milk with or without compositional modification as limited by the provision in Section 3.3, by the action of suitable microorganisms and resulting in reduction of pH with or without coagulation (CODEX STAN 243-2003).  Fermented milk products include a range of foods commonly referred to as yogurt (or yoghurt), plus sour milk drinks produced by fermentation. A few of these are alcoholic as they are made with combined lactic and yeast ferments (e.g. kefir, koumiss); others are lactic fermented milk products (e.g. cieddu, kaeder milk, skyr, taette). In some traditional fermented milk products, such as Stragisto (strained yoghurt), Labneh, Ymer and Ylette, Milk the protein has been increased to minimum 5.6%.  ."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400783 langual:A0783)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400783 "cultured milk product"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400783 "fermented milk product (eurofir)"@en)
SubClassOf(obo:FOODON_03400783 obo:FOODON_03400778)

# Class: obo:FOODON_03400784 (cheese (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400784 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400784 "Cheese is the ripened or unripened soft or semi-hard, hard and extra hard product, which may be coated, and in which the whey protein/casein ratio does not exceed that of milk, obtained by : coagulating wholly or partly  through the action of rennet or other suitable coagulating agents, and by partially draining the whey resulting from such coagulation; and/or processing techniques involving coagulation of the protein of milk and/or products obtained from milk which give an end-product with similar physical, chemical and organoleptic characteristics (CODEX STAN A-6-1978, Rev.1-1999, Amended 2003). The group includes goat and sheep cheeses, and cheeses made from sour milk, whey or buttermilk."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400784 langual:A0784)
AnnotationAssertion(rdfs:comment obo:FOODON_03400784 "LanguaL curation note: Index also * MILK OR MILK COMPONENT* or underlying term in facet C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400784 "cheese (eurofir)"@en)
SubClassOf(obo:FOODON_03400784 obo:FOODON_03400778)

# Class: obo:FOODON_03400785 (cured cheese (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400785 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400785 "Ripened cheese is cheese which is not ready for consumption shortly after manufacture but which must be held for such time, at such temperature, and under such other conditions as will result in the necessary biochemical and physical changes characterizing the cheese in question. (CODEX STAN A-6-1978, Rev.1-1999, Amended 2003). The group includes cheeses that are normally consumed cured but may be sold in an uncured or very lightly cured stage."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400785 langual:A0785)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400785 "ripened cheese"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400785 "LanguaL curation note: Cheeses are classified here according to their consistency (Codex Alimentarius Standard). Cheeses can be further distinguished according to fat content and rind type in facet Z."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400785 "cured cheese (eurofir)"@en)
SubClassOf(obo:FOODON_03400785 obo:FOODON_03400784)

# Class: obo:FOODON_03400786 (uncured cheese (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400786 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400786 "Unripened cheese including fresh cheese is cheese which is ready for consumption shortly after manufacture (CODEX STAN A-6-1978, Rev.1-1999, Amended 2003). It is consumed fresh and has a mild acid flavour, moisture max. 80%. Includes such products as cream cheese and mozzarella cheese."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400786 langual:A0786)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400786 "unripened cheese"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400786 "uncured cheese (eurofir)"@en)
SubClassOf(obo:FOODON_03400786 obo:FOODON_03400784)

# Class: obo:FOODON_03400787 (processed cheese (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400787 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400787 "Process(ed) cheese and spreadable process(ed) cheese are made by grinding, mixing, melting and emulsifying with the aid of heat and emulsifying agents one or more varieties of cheese, with or without the addition of milk components and/or other foodstuffs (CODEX STAN A-8(b)-1978). The result is a homogeneous plastic mass, except for grated cheese product, which is powdered or granular."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400787 langual:A0787)
AnnotationAssertion(rdfs:label obo:FOODON_03400787 "processed cheese (eurofir)"@en)
SubClassOf(obo:FOODON_03400787 obo:FOODON_03400784)

# Class: obo:FOODON_03400788 (imitation milk products (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400788 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400788 "The group includes soya milk, soya cheese, non-dairy coffee creamer."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400788 langual:A0788)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400788 "milk product analog"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400788 "imitation milk products (eurofir)"@en)
SubClassOf(obo:FOODON_03400788 obo:FOODON_03400778)

# Class: obo:FOODON_03400789 (frozen dairy dessert (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400789 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400789 "A frozen dessert prepared from one or more dairy ingredients plus other ingredients."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400789 langual:A0789)
AnnotationAssertion(rdfs:comment obo:FOODON_03400789 "LanguaL curation note: Includes frozen dairy items offered in a cone, a sandwich or as a cake or pie, such as frozen yogurt in a cone or an ice cream sandwich; these are also indexed under *GRAIN ADDED*. Non-dairy ices (e.g. Water ices, granitas, sorbets) are classified under *DESSERT*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400789 "frozen dairy dessert (eurofir)"@en)
SubClassOf(obo:FOODON_03400789 obo:FOODON_03400778)

# Class: obo:FOODON_03400790 (egg or egg product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400790 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400790 "The group includes bird eggs, food product whose predominant constituent is eggs, recipe dishes whose main ingredient is considered to be eggs. It does not include fish roe (under Fish)."@en)
