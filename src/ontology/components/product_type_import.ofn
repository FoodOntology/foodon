AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400176 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400176 "An elastic substance flavored and used for chewing; it may be sweetened with a nutritive or nonnutritive sweetener. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400176 langual:A0176)
AnnotationAssertion(rdfs:label obo:FOODON_03400176 "chewing gum (us cfr)"@en)
SubClassOf(obo:FOODON_03400176 obo:FOODON_03401270)

