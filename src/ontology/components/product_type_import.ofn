AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400225 "Mixture of fruits, vegetables, or other ingredients, such as spices and sweeteners, used to enhance the flavor of other food products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400225 langual:A0225)
AnnotationAssertion(rdfs:label obo:FOODON_03400225 "relish (us cfr)"@en)
SubClassOf(obo:FOODON_03400225 obo:FOODON_03400179)

