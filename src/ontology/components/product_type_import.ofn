# Class: obo:FOODON_03400181 (food additive (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400181 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400181 "Substance that is added to food or that is used to treat food and that becomes a component of the food or otherwise affects the functional or nutritional characteristics of the food; for purposes of this vocabulary it excludes products that fall under other categories, such as flavors and sweeteners."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03400181 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03400181 "FDA CFSAN 1995")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400181 langual:A0181)
AnnotationAssertion(rdfs:label obo:FOODON_03400181 "food additive (us cfr)"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03400181 <https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfcfr/CFRSearch.cfm?CFRPart=170&showFR=1>)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03400181 <https://www.fda.gov/food/food-ingredients-packaging/overview-food-ingredients-additives-colors#foodadd>)
