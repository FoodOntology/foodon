AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400226 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400226 "Flat hard candy to which is added nuts, usually peanuts."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400226 langual:A0226)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400226 "candy, brittle"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400226 "brittle (us cfr)"@en)
SubClassOf(obo:FOODON_03400226 obo:FOODON_03400216)

