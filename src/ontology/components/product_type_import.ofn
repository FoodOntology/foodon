AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400188 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400188 "Candy or other food product made with sweeteners and frequently containing nuts, fruits, starches, flavorings and other foods (21 CFR 170.3(n)(9). [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400188 langual:A0188)
AnnotationAssertion(rdfs:label obo:FOODON_03400188 "confectionery (us cfr)"@en)
SubClassOf(obo:FOODON_03400188 obo:FOODON_03401270)

# Class: obo:FOODON_03400191 (bakery product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400191 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400191 "Prepared grain product made by baking or frying. Includes doughs, batters and mixes."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400191 langual:A0191)
AnnotationAssertion(rdfs:label obo:FOODON_03400191 "bakery product (us cfr)"@en)
SubClassOf(obo:FOODON_03400191 obo:FOODON_03400106)

