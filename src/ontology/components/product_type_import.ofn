AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400194 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400194 "A thin, sweetened bakery product griddled or cooked in a heated mold."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400194 langual:A0194)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400194 "waffle or pancake"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400194 "pancake or waffle (us cfr)"@en)
SubClassOf(obo:FOODON_03400194 obo:FOODON_03400135)

# Class: obo:FOODON_03400195 (malt beverage (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400195 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400195 "Alcoholic beverage prepared from water, malted grain and hops (humulus) by brewing. Examples are beer, ale and malt liquor (27 CFR 7.10)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400195 langual:A0195)
AnnotationAssertion(rdfs:label obo:FOODON_03400195 "malt beverage (us cfr)"@en)
SubClassOf(obo:FOODON_03400195 obo:FOODON_03400278)

# Class: obo:FOODON_03400196 (fruit nectar (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400196 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400196 "Pulpy, liquid food prepared from fruit puree, pulp, juice or concentrates thereof, water, and optional ingredients. It contains finely divided insoluble fruit solids but not seeds, pits, or other coarse or hard substances. The proportion of fruit ingredient used on an equivalent single strength basis is not less than 40% by weight of the finished food. It may be sweetened (21 CFR 146.113)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400196 langual:A0196)
AnnotationAssertion(rdfs:label obo:FOODON_03400196 "fruit nectar (us cfr)"@en)
SubClassOf(obo:FOODON_03400196 obo:FOODON_03400104)

# Class: obo:FOODON_03400197 (fruit spread or sauce (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400197 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400197 "Nonstandardized fruit product prepared from a mixture of one or more fruit ingredients and optional ingredients including nutritive carbohydrate sweetener, spice or flavor; includes applesauce and cranberry sauce."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400197 langual:A0197)
AnnotationAssertion(rdfs:label obo:FOODON_03400197 "fruit spread or sauce (us cfr)"@en)
SubClassOf(obo:FOODON_03400197 obo:FOODON_03400155)

# Class: obo:FOODON_03400198 (soup (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400198 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400198 "A liquid food made by simmering meat, poultry, seafood or vegetables, being clear or thickened to the consistency of a thin puree or having milk or cream added, and often containing pieces of solid food such as meat, shellfish, pasta or vegetables. Soup takes precedence over other food products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400198 langual:A0198)
AnnotationAssertion(rdfs:label obo:FOODON_03400198 "soup (us cfr)"@en)
SubClassOf(obo:FOODON_03400198 obo:FOODON_03400172)

# Class: obo:FOODON_03400200 (distinctive distilled spirits (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400200 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400200 "Distilled spirits produced at less than 190 proof and having a distinctive flavor and aroma derived from the source (or from flavoring ingredients added) through a manufacturing process characteristic of the type. Includes whiskey, brandy, rum and similar products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400200 langual:A0200)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400200 "distilled spirits, distinctive"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400200 "spirits, distinctive distilled"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400200 "distinctive distilled spirits (us cfr)"@en)
SubClassOf(obo:FOODON_03400200 obo:FOODON_03400277)

# Class: obo:FOODON_03400202 (pastry, sweetened (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400202 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400202 "Sweetened bakery product consisting of a sweetened or unsweetened pastry shell or enclosure containing a sweetened filling, usually fruit, cheese or custard. Examples would be apple strudel, danish pastry or cream puff."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400202 langual:A0202)
AnnotationAssertion(rdfs:label obo:FOODON_03400202 "pastry, sweetened (us cfr)"@en)
SubClassOf(obo:FOODON_03400202 obo:FOODON_03400135)

# Class: obo:FOODON_03400203 (cookie (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400203 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400203 "Sweetened bakery product baked in individual portions that are usually small and flat."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400203 langual:A0203)
AnnotationAssertion(rdfs:label obo:FOODON_03400203 "cookie (us cfr)"@en)
SubClassOf(obo:FOODON_03400203 obo:FOODON_03400135)

# Class: obo:FOODON_03400204 (candy (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400204 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400204 "Food product prepared by heating a mixture of sweeteners and other optional ingredients according to the specific formula for each subgroup."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400204 langual:A0204)
AnnotationAssertion(rdfs:label obo:FOODON_03400204 "candy (us cfr)"@en)
SubClassOf(obo:FOODON_03400204 obo:FOODON_03400188)

# Class: obo:FOODON_03400205 (wine, 7-24% alcohol (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400205 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400205 "Alcoholic beverage produced by the normal fermentation of the juice of grapes or other fruits or of the fermentable parts of plants or plant-related products; may contain certain optional ingredients. Contains between 7-24% alcohol by volume (27 CFR 4.10)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400205 langual:A0205)
AnnotationAssertion(rdfs:label obo:FOODON_03400205 "wine, 7-24% alcohol (us cfr)"@en)
SubClassOf(obo:FOODON_03400205 obo:FOODON_03400297)

