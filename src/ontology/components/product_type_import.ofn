# Class: obo:FOODON_03400230 (water ice (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400230 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400230 "Frozen non-dairy dessert prepared by freezing, while stirring, a mixture of water, nutritive sweeteners and flavorings; the mix may or may not be pasteurized. Must not contain milk or milk-derived ingredients, egg yolk or food fats. The optional flavor ingredients are specified in 21 CFR 135.140(d) and (e)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400230 langual:A0230)
AnnotationAssertion(rdfs:label obo:FOODON_03400230 "water ice (us cfr)"@en)
SubClassOf(obo:FOODON_03400230 obo:FOODON_03400206)

# Class: obo:FOODON_03400231 (margarine (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400231 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400231 "Food product having functional characteristics similar to those of butter; it is in plastic form or liquid emulsion and contains not less than 80% fat whose origin is vegetable or rendered animal carcass fats or a mixture of these as well as other optional ingredients specified by 21 CFR 166.110."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400231 langual:A0231)
AnnotationAssertion(rdfs:label obo:FOODON_03400231 "margarine (us cfr)"@en)
SubClassOf(obo:FOODON_03400231 obo:FOODON_03400294)

# Class: obo:FOODON_03400232 (mellorine (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400232 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400232 "Frozen dairy dessert produced by freezing while stirring a pasteurized mix of ingredients including, but not limited to, milk derived nonfat solids, animal or vegetable fat or both, only part of which may be milkfat, and nutritive carbohydrate sweeteners."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400232 langual:A0232)
AnnotationAssertion(rdfs:label obo:FOODON_03400232 "mellorine (us cfr)"@en)
SubClassOf(obo:FOODON_03400232 obo:FOODON_03400159)

# Class: obo:FOODON_03400233 (ice milk (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400233 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400233 "Frozen dairy dessert similar to ice cream; it has between 2% and 7% milkfat and at least 11% total milk solids."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400233 langual:A0233)
AnnotationAssertion(rdfs:label obo:FOODON_03400233 "ice milk (us cfr)"@en)
SubClassOf(obo:FOODON_03400233 obo:FOODON_03400114)

# Class: obo:FOODON_03400237 (sweetener (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400237 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400237 "A product added to a food item to achieve some degree of sweet taste; it may be nutritive or nonnutritive."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400237 langual:A0237)
AnnotationAssertion(rdfs:label obo:FOODON_03400237 "sweetener (us cfr)"@en)
SubClassOf(obo:FOODON_03400237 obo:FOODON_03400133)

# Class: obo:FOODON_03400240 (liqueur (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400240 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400240 "Alcoholic beverage produced by combining a spirit (frequently brandy) with flavoring and sugar. May be grouped into five categories: fruits, seeds, herbs, peels and cremes. Examples of each include cherry heering, anisette, chartreuse, curacao and creme de menthe (27 CFR 5.22(h))."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400240 langual:A0240)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400240 "cordial"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400240 "liqueur (us cfr)"@en)
SubClassOf(obo:FOODON_03400240 obo:FOODON_03400200)

# Class: obo:FOODON_03400241 (soft drink (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400241 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400241 "Nonalcoholic beverage made from potable water by adding one or more of the following: carbon dioxide, flavoring ingredients or sweeteners. Naturally or artificially carbonated mineral waters are also considered soft drinks. Excludes products containing 15% or more fruit juice, which are indexed by the appropriate narrower term under *FRUIT JUICE OR RELATED PRODUCT*. Includes beverage bases to make soft drinks. Carbonated fruit juices are indexed by *FRUIT JUICE* or *FRUIT JUICE, DILUTED* and *CARBONATED* or the appropriate narrower term."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400241 langual:A0241)
AnnotationAssertion(rdfs:label obo:FOODON_03400241 "soft drink (us cfr)"@en)
SubClassOf(obo:FOODON_03400241 obo:FOODON_03400112)
SubClassOf(obo:FOODON_03400241 ObjectAllValuesFrom(obo:RO_0002351 obo:FOODON_03316090))

