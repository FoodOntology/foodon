SubClassOf(obo:FOODON_03400211 obo:FOODON_03400114)

# Class: obo:FOODON_03400212 (stew or hash (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400212 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400212 "Prepared dish consisting of a mixture of meat, poultry or seafood with one or more vegetables and possibly other ingredients. In contrast to soups, which are liquid or semiliquid, stews are thickened or have a larger proportion of solid ingredients."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400212 langual:A0212)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400212 "hash or stew"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400212 "stew or hash (us cfr)"@en)
SubClassOf(obo:FOODON_03400212 obo:FOODON_03400172)

# Class: obo:FOODON_03400213 (fudge (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400213 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400213 "Soft candy prepared by boiling milk, sugar, salt and optional ingredients to the soft-ball stage (238 degrees F.)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400213 langual:A0213)
AnnotationAssertion(rdfs:label obo:FOODON_03400213 "fudge (us cfr)"@en)
SubClassOf(obo:FOODON_03400213 obo:FOODON_03400293)

# Class: obo:FOODON_03400214 (glaze (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400214 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400214 "An edible coating used to enhance appearance and palatibility and to protect the food product. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400214 langual:A0214)
AnnotationAssertion(rdfs:label obo:FOODON_03400214 "glaze (us cfr)"@en)
