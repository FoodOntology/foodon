AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400803 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400803 "Includes fish offal; a food product whose predominant constituent is fish (e.g. dried and salted fish, smoked fish, canned fish, pickled fish, restructured fish and fish analogues, surimi; fish paste, pâté)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400803 langual:A0803)
AnnotationAssertion(rdfs:label obo:FOODON_03400803 "seafood product (eurofir)"@en)
SubClassOf(obo:FOODON_03400803 obo:FOODON_03400801)

