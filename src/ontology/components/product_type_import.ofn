AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400192 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400192 "Cooked or uncooked mixture prepared with starch (tapioca starch, cornstarch, etc.) and other optional ingredients including sweeteners, eggs and flavorings."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400192 langual:A0192)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400192 "starch pudding"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400192 "pudding, starch (us cfr)"@en)
SubClassOf(obo:FOODON_03400192 obo:FOODON_03400285)

