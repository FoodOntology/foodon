# Class: obo:FOODON_03540268 (02680 - rotation cooked layered cakes (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540268 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540268 "The group includes any type of traditional bakery wares normally produced on a spit-like device that cooks the dough and rotates. As soon as one layer is cooked, a following layer of dough/thick batter is painted on the surface. With this process, the cake assumes the same layered appearance as the rings of wood. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Spit_cake] and [https://www.google.co.uk/search?tbm=isch&q=Rotation+cooked+layered+cakes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540268 langual:A0C6L)
AnnotationAssertion(rdfs:label obo:FOODON_03540268 "02680 - rotation cooked layered cakes (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540268 obo:FOODON_03540255)

# Class: obo:FOODON_03540269 (02690 - pyramid cake (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540269 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540269 "The group includes any type of Pyramid cake, i.e. a typical Polish-Lithuanian cake in form of pine or pyramid, obtained by rotational painting-cooking of a dough, such as Sakotis and Sekacz. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/%C5%A0akotis] and [https://www.google.co.uk/search?tbm=isch&q=Sakotis and Sekacz]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540269 langual:A00BE)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540269 "sakotis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540269 "sekacz"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540269 "02690 - pyramid cake (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540269 obo:FOODON_03540268)

