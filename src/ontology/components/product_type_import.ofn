# Class: obo:FOODON_03542938 (29380 - custard (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03542938 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03542938 "The group includes any type of Custard, such as Creme anglais and Pastry cream. A custard is a liquid thickened or set by the coagulation of egg protein. Since the group includes also desserts based on dairy imitates, information on the characterising ingredients has to be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Custard] and [https://www.google.co.uk/search?tbm=isch&q=Custard]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03542938 langual:A02PX)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542938 "creme anglais"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542938 "pastry cream"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03542938 "29380 - custard (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03542938 obo:FOODON_03542937)

# Class: obo:FOODON_03542939 (29390 - starchy pudding (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03542939 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03542939 "The group includes any type of Starchy pudding. A starch pudding usually consists of milk (or similar), sugar (or similar) and other ingredients, and is thickened with starch or other thickening agent. For example Cornstarch pudding or blanc mange are included in this group. Since the group includes also desserts based on dairy imitates, information on the characterising ingredients has to be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Blancmange] and [https://www.google.co.uk/search?tbm=isch&q=Starchy pudding Blancmange]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03542939 langual:A02PY)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542939 "blanc mange"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542939 "cornstarch pudding"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03542939 "29390 - starchy pudding (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03542939 obo:FOODON_03542937)

