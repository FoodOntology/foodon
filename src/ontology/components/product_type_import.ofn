# Class: obo:FOODON_03540245 (02450 - sponge biscuits (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540245 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540245 "The group includes any type of Sponge biscuits, i.e. low density, dry, egg-based and sweet biscuits such as Savoiardi, Ladyfingers and Sponge fingers. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Ladyfinger_(biscuit)] and [https://www.google.co.uk/search?tbm=isch&q=Sponge+biscuits]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540245 langual:A16FJ)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540245 "ladyfingers"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540245 "savoiardi"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540245 "sponge fingers"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540245 "02450 - sponge biscuits (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540245 obo:FOODON_03540238)

# Class: obo:FOODON_03540246 (02460 - biscuit with inclusions, filling or coating (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540246 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540246 "The group includes any type of filled biscuit, i.e. biscuits with inclusions, filling or coating such as American cookies. Taking into account the broad variability of ingredient combination, this group is not further detailed and all the characterising ingredients should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Biscuits] and [https://www.google.co.uk/search?tbm=isch&q=Biscuit filled or coated or with fruit]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540246 langual:A00AE)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540246 "american cookies"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540246 "02460 - biscuit with inclusions, filling or coating (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540246 obo:FOODON_03540237)

# Class: obo:FOODON_03540247 (02470 - wafers (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540247 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540247 "The group includes any type of plain wafers (i.e. without inclusions, fillings or coatings) and wafer-based biscuits. For example wafer and cream sandwich cookies (e.g. Neapolitan wafers), ice-cream cones made of wafer and Raffaello-type sweets are included in this group. Taking into account the broad variability of ingredient combination, this group is not further detailed and all the characterising ingredients should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Wafers] and [https://www.google.co.uk/search?tbm=isch&q=Wafers]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540247 langual:A0BYR)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540247 "cookies"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540247 "raffaello"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540247 "02470 - wafers (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540247 obo:FOODON_03540246)

# Class: obo:FOODON_03540248 (02480 - choux pastry (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540248 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540248 "The group includes any type of choux pastry, i.e. all pastries based on baked choux dough, like beignet and similar. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Choux_pastry] and [https://www.google.co.uk/search?tbm=isch&q=Choux+pastry]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540248 langual:A00AG)
AnnotationAssertion(rdfs:label obo:FOODON_03540248 "02480 - choux pastry (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540248 obo:FOODON_03540236)

# Class: obo:FOODON_03540249 (02490 - éclair (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540249 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540249 "The group includes any type of Éclair, i.e. long choux pastry filled with cream and topped with icing. Relevant information on fillings should be reported with additional facets descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Éclair] and [https://www.google.co.uk/search?tbm=isch&q=éclair pastry]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540249 langual:A00AH)
AnnotationAssertion(rdfs:label obo:FOODON_03540249 "02490 - éclair (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540249 obo:FOODON_03540248)

# Class: obo:FOODON_03540250 (02500 - beignets (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540250 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540250 "The group includes any type of Beignets, i.e. possibly filled and/or topped choux pastry. They are in most countries deep fried and simply served with powdered sugar. In some cases they are oven baked and filled or topped as eclairs. When relevant, information on toppings/fillings should be reported with additional facets descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Beignets] and [https://www.google.co.uk/search?tbm=isch&q=Beignets choux pastry]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540250 langual:A00AJ)
AnnotationAssertion(rdfs:label obo:FOODON_03540250 "02500 - beignets (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540250 obo:FOODON_03540248)

# Class: obo:FOODON_03540251 (02510 - profiterole (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540251 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540251 "The group includes any type of Profiterole, i.e. assembled combination of baked choux pastry 'balls' with white filling and rich chocolate cream topping. When relevant, information on toppings/fillings should be reported with additional facets descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Profiterole] and [https://www.google.co.uk/search?tbm=isch&q=Profiterole]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540251 langual:A00AK)
AnnotationAssertion(rdfs:label obo:FOODON_03540251 "02510 - profiterole (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540251 obo:FOODON_03540248)

# Class: obo:FOODON_03540252 (02520 - croquembouche (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540252 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540252 "The group includes any type of Croquembouche which is, to some extent, similar to profiteroles but with caramel topping providing a more rigid structure, allowing forming high cone-like structures. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Croquembouche] and [https://www.google.co.uk/search?tbm=isch&q=Croquembouche]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540252 langual:A00AL)
AnnotationAssertion(rdfs:label obo:FOODON_03540252 "02520 - croquembouche (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540252 obo:FOODON_03540248)

# Class: obo:FOODON_03540253 (02530 - gougere (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540253 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540253 "The group includes any type of Gougere, i.e. baked choux pastry 'balls' in the savoury variant, alone or assembled in compositions, such as cheese choux. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Gougere] and [https://www.google.co.uk/search?tbm=isch&q=Gougere]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540253 langual:A00AM)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540253 "cheese choux"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540253 "02530 - gougere (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540253 obo:FOODON_03540248)

# Class: obo:FOODON_03540254 (02540 - cakes (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540254 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540254 "The group includes any type of cake, i.e. sweets generally constituted by baked sweet dough/batter and possibly containing creams or fillings of different nature, regardless the size. Individual sized cakes, such as cupcakes are also included in this group. Often a final glazing or icing is also present. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Cakes] and [https://www.google.co.uk/search?tbm=isch&q=Cakes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540254 langual:A00AN)
AnnotationAssertion(rdfs:label obo:FOODON_03540254 "02540 - cakes (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540254 obo:FOODON_03540236)

# Class: obo:FOODON_03540255 (02550 - plain cakes (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540255 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540255 "The group includes any type of plain cakes, i.e. cakes mainly constituted of a baked sweet dough. Small cakes such as cupcakes mainly constituted of a baked sweet dough are also included in this group. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Cakes] and [https://www.google.co.uk/search?tbm=isch&q=Plain+cakes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540255 langual:A00AP)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540255 "cake-based cupcake"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540255 "02550 - plain cakes (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540255 obo:FOODON_03540254)

# Class: obo:FOODON_03540256 (02560 - sponge cake (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540256 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540256 "The group includes any type of Sponge cake, i.e. a cake based on a particularly aerated and flexible baked product, rich in eggs. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Sponge_cake] and [https://www.google.co.uk/search?tbm=isch&q=Sponge+cake]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540256 langual:A00AQ)
AnnotationAssertion(rdfs:label obo:FOODON_03540256 "02560 - sponge cake (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540256 obo:FOODON_03540255)

# Class: obo:FOODON_03540257 (02570 - sponge cake roll (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540257 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540257 "The group includes any type of Sponge cake roll, i.e. a sponge cake in form of roll. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Sponge_cake] and [https://www.google.co.uk/search?tbm=isch&q=Sponge+cake+roll]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540257 langual:A00BB)
AnnotationAssertion(rdfs:label obo:FOODON_03540257 "02570 - sponge cake roll (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540257 obo:FOODON_03540256)

# Class: obo:FOODON_03540258 (02580 - cream cake (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540258 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540258 "The group includes any type of Cream cake, i.e. a cake containing a considerable proportion of a cream. Cakes containing a cheese-based cream are not included in this term and are listed under A00AR 'Cheese cake'. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Cream_cake] and [https://www.google.co.uk/search?tbm=isch&q=Cream+cake]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540258 langual:A00AV)
AnnotationAssertion(rdfs:label obo:FOODON_03540258 "02580 - cream cake (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540258 obo:FOODON_03540255)

# Class: obo:FOODON_03540259 (02590 - cream custard cake (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540259 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540259 "The group includes any type of Cream custard cake, i.e. a cake containing a considerable proportion of custard, regardless of the bakery part. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Cakes] and [https://www.google.co.uk/search?tbm=isch&q=Cream+custard+cake]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540259 langual:A00AX)
AnnotationAssertion(rdfs:label obo:FOODON_03540259 "02590 - cream custard cake (efsa foodex2)"@en)
