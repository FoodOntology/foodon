AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400180 "A soup in which the liquid phase has high viscosity."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400180 langual:A0180)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400180 "bisque"@en)
