AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400242 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400242 "Unsweetened bakery product baked in individual portions that are usually thin and crisp and may or may not be fat coated."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400242 langual:A0242)
AnnotationAssertion(rdfs:label obo:FOODON_03400242 "cracker (us cfr)"@en)
SubClassOf(obo:FOODON_03400242 obo:FOODON_03400107)

