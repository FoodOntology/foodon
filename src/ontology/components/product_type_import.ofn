AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400178 "Unsweetened bakery product that may be unleavened or yeast-leavened and may be baked in various forms. Excludes pie crust."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400178 langual:A0178)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400178 "bun, roll, or bread"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400178 "roll, bun, or bread"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400178 "bread (us cfr)"@en)
