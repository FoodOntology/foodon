# Class: obo:FOODON_03400251 (fruit preserve or jam (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400251 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400251 "Viscous or semisolid fruit product made from whole fruits or pieces of fruit of one or more varieties and optional ingredients.  Includes fruit preserve or jam (21 CFR 150.160) and artificially sweetened fruit preserve or jam (21 CFR 150.161).  The specifications of starting mixture and finished soluble solids are the same as for fruit jelly."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400251 langual:A0251)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400251 "jam or fruit preserve"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400251 "marmalade"@en)
