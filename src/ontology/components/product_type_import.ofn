# Class: obo:FOODON_03543327 (33270 - drink mixes (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543327 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543327 "The group includes any type of Drink mixes, i.e. liquid concentrates or powdered drink bases, usually intended to be diluted with water to produce a beverage. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://www.google.co.uk/search?tbm=isch&q=Drink mixes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543327 langual:A03GD)
AnnotationAssertion(rdfs:label obo:FOODON_03543327 "33270 - drink mixes (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543327 obo:FOODON_03543326)

# Class: obo:FOODON_03543328 (33280 - liquid drink bases (including concentrates and home-made preparations) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543328 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543328 "The group includes any type of Liquid drink bases (including concentrates and home-made preparations) usually intended to be diluted with water to produce a beverage. For example Cordial liquid concentrate, Squash, Fruit cordial and Fruit syrup are included in this group. However liquid concentrates used to prepare hot drinks (e.g. tea and herbal liquid extracts, liquid coffee concentrate) are excluded from this group and should be coded with their proper FoodEx2 code. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://www.google.co.uk/search?tbm=isch&q=Liquid drink bases (including concentrates)]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543328 langual:A03GE)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543328 "fruit cordial"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543328 "fruit syrup"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543328 "squash"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543328 "33280 - liquid drink bases (including concentrates and home-made preparations) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543328 obo:FOODON_03543327)

# Class: obo:FOODON_03543329 (33290 - powdered drink bases (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543329 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543329 "The group includes any type of Powdered drink base, usually intended to be diluted with water to produce a beverage. However fruit/vegetable juice powder and powdered ingredients used to prepare hot drinks (e.g. tea and herbal powder, instant coffee powder, coffee- and cocoa-beverage-preparation powder) are excluded from this group and should be coded with their proper FoodEx2 code. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/Drink_mix] and [https://www.google.co.uk/search?tbm=isch&q=Powdered drink bases]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543329 langual:A03GF)
AnnotationAssertion(rdfs:label obo:FOODON_03543329 "33290 - powdered drink bases (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543329 obo:FOODON_03543327)

# Class: obo:FOODON_03543330 (33300 - alcoholic beverages (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543330 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543330 "The category covers all beverages containing alcohol. For traditional products, like wine and beer, also the versions with removed alcohol are included.[https://en.wikipedia.org/wiki/Alcoholic_beverages] and [https://www.google.co.uk/search?tbm=isch&q=Alcoholic beverages]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543330 langual:A03LZ)
AnnotationAssertion(rdfs:label obo:FOODON_03543330 "33300 - alcoholic beverages (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543330 obo:FOODON_03401895)
SubClassOf(obo:FOODON_03543330 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002351 obo:FOODON_00001579) ObjectAllValuesFrom(obo:RO_0002351 obo:FOODON_00001579)))

# Class: obo:FOODON_03543331 (33310 - beer and beer-like beverage (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543331 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543331 "The category covers any type of Beer and beer-like beverage. Beer is an alcoholic beverage produced by the saccharification of starch and fermentation of the resulting sugar. The starch and saccharification enzymes are often derived from malted cereal grains, most commonly malted barley and malted wheat. Most beer is also flavoured with hops, which add bitterness and act as a natural preservative, though other flavourings such as herbs or fruit may occasionally be included. The preparation of beer is called brewing. Alcohol-free beers and beverages similar to beer are also included in this group. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/Beer] and [https://www.google.co.uk/search?tbm=isch&q=Beer and beer-like beverage]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543331 langual:A03MA)
AnnotationAssertion(rdfs:label obo:FOODON_03543331 "33310 - beer and beer-like beverage (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543331 obo:FOODON_03543330)

