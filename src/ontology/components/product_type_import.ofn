AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "cayenne pepper"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "guinea spice"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "hot pepper"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "paprika"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "red pepper"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03541405 "tabasco pepper"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03541405 "14050 - peppers, dried (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03541405 obo:FOODON_03541404)

