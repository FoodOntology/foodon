AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400243 "bouillon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400243 "consomme"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400243 "soup, thin (us cfr)"@en)
SubClassOf(obo:FOODON_03400243 obo:FOODON_03400198)

# Class: obo:FOODON_03400244 (fondant (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400244 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400244 "Candy prepared by cooking together sugar, water and ingredients to control crystal growth to a temperature of 238-246 degrees F. The product is then cooled approximately 100 degrees and agitated to promote a smooth, creamy texture."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400244 langual:A0244)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400244 "candy, fondant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400244 "fondant (us cfr)"@en)
SubClassOf(obo:FOODON_03400244 obo:FOODON_03400293)

# Class: obo:FOODON_03400245 (sherbet (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400245 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400245 "Frozen dairy dessert prepared by freezing, while stirring, a pasteurized mixture of one or more optional dairy ingredients, caseinates and other non-dairy ingredients, excluding other food fats; the milkfat content is not less than 1% nor more than 2%."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400245 langual:A0245)
AnnotationAssertion(rdfs:label obo:FOODON_03400245 "sherbet (us cfr)"@en)
SubClassOf(obo:FOODON_03400245 obo:FOODON_03400114)

# Class: obo:FOODON_03400246 (decoration (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400246 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400246 "Candy-like product shaped and/or colored to serve as a decoration."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400246 langual:A0246)
AnnotationAssertion(rdfs:label obo:FOODON_03400246 "decoration (us cfr)"@en)
SubClassOf(obo:FOODON_03400246 obo:FOODON_03400188)

# Class: obo:FOODON_03400248 (doughnut (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400248 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400248 "Deep-fat fried sweetened bakery product that may be leavened with yeast or baking powder."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400248 langual:A0248)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400248 "cruller"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400248 "doughnut (us cfr)"@en)
