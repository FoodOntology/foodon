AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400804 "A recipe dish whose main ingredient is considered to be fish"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400804 langual:A0804)
AnnotationAssertion(rdfs:label obo:FOODON_03400804 "seafood dish (eurofir)"@en)
SubClassOf(obo:FOODON_03400804 obo:FOODON_03400803)
