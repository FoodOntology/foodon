# Class: obo:FOODON_03400814 (rice or other grain (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400814 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400814 "Examples are whole grain wheat, brown rice, bulgur, parboiled rice, rolled oats, wild rice, pearl barley, millet, rolled oats, corn grits and similar products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400814 langual:A0814)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400814 "cereal grains"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400814 "rice or other grain (eurofir)"@en)
SubClassOf(obo:FOODON_03400814 obo:FOODON_03400812)

# Class: obo:FOODON_03400815 (pasta and similar products (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400815 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400815 "Eurocode-2 group 06.30. Pasta can be either dried or fresh, and as main-dish (pasta asciutta) or miniature pasta (e.g. to add to soups). Although pasta is usually made from durum wheat flour, it can also be made from wholemeal flour or buckwheat flour. Noodles contain egg unless specifically referred to as plain noodles. Asian transparent noodles can made from a wide range of flours, many of them non-cereal."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400815 langual:A0815)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400815 "pasta"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400815 "LanguaL curation note: Renamed from *PASTA (EUROFIR)* (LanguaL 2010)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400815 "pasta and similar products (eurofir)"@en)
SubClassOf(obo:FOODON_03400815 obo:FOODON_03400812)

# Class: obo:FOODON_03400816 (breakfast cereal (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400816 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400816 "Prepared grain product ready or nearly ready for consumption and marketed primarily for breakfast use. Includes formulated breakfast cereals such as 'corn flakes' or \"muesli\" and simple breakfast cereals such as instant oatmeal."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400816 langual:A0816)
AnnotationAssertion(rdfs:comment obo:FOODON_03400816 "LanguaL curation note: Excludes rolled oats, corn grits and similar products, which are indexed under *RICE OR OTHER GRAIN *."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400816 "breakfast cereal (eurofir)"@en)
SubClassOf(obo:FOODON_03400816 obo:FOODON_03400812)

# Class: obo:FOODON_03400817 (bread and similar products (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400817 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400817 "Products in the Bread categories normally have contents of sugars and fat neither exceeding 5% on a dry weight basis."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400817 langual:A0817)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400817 "bread"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400817 "LanguaL curation note: Renamed from *BREAD (EUROFIR)* (LanguaL 2010)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400817 "bread and similar products (eurofir)"@en)
SubClassOf(obo:FOODON_03400817 obo:FOODON_03400812)

# Class: obo:FOODON_03400818 (leavened bread (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400818 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400818 "Includes wholemeal wheat bread, soda bread, rye bread"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400818 langual:A0818)
AnnotationAssertion(rdfs:label obo:FOODON_03400818 "leavened bread (eurofir)"@en)
SubClassOf(obo:FOODON_03400818 obo:FOODON_03400817)

# Class: obo:FOODON_03400819 (unleavened bread, crisp bread and rusk (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400819 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400819 "A flatbread, or unleavened bread, is a simple bread made with flour, water, and salt and then thoroughly rolled into flattened dough. Many flatbreads are unleavened-made without yeast or sourdough culture-although some flatbread is made with yeast, such as pita bread. There are many other optional ingredients that flatbreads may contain, such as curry powder, diced jalapeños, chili powder, or black pepper. Olive oil or sesame oil may be added as well. Flatbreads can range from one millimeter to a few centimeters thick. [Wikipedia].
Includes pitta bread, matzo, tortilla."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400819 langual:A0819)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400819 "crisp bread"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400819 "flatbread"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400819 "unleavened bread"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400819 "LanguaL curation note: Renamed from *FLATBREAD (EUROFIR)* (LanguaL 2010)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400819 "unleavened bread, crisp bread and rusk (eurofir)"@en)
SubClassOf(obo:FOODON_03400819 obo:FOODON_03400817)

# Class: obo:FOODON_03400820 (bread product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400820 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400820 "Includes breadcrumbs, bread stuffing"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400820 langual:A0820)
AnnotationAssertion(rdfs:label obo:FOODON_03400820 "bread product (eurofir)"@en)
SubClassOf(obo:FOODON_03400820 obo:FOODON_03400817)

# Class: obo:FOODON_03400821 (fine bakery ware (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400821 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400821 "Products in the *BREAD* category normally have contents of sugars and fat neither exceeding 5% on a dry weight basis. Bakery products exceeding either of these limits are termed \"Fine bakery ware\". Savoury fine bakery wares will tend to be higher in fat and sweet products in sugars. However, some products, for example scones, may be considered savoury or sweet. Therefore, all of these products are categorised as \"Fine bakery wares\", rather than using separate categories for savoury and sweet products. Some examples are: biscuits, cookies, dry pastry (e.g. savoury biscuits, sweet biscuits and cookies); sweet breads (e.g. croissants, currant bun, dough cakes like muffins or brioche, scone, doughnut); pastry (e.g. danish pastry, baclava); tart, pie (e.g. custard tart, mince pie); cakes (e.g. fruit cake, cream cake, sponge cake."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400821 langual:A0821)
AnnotationAssertion(rdfs:label obo:FOODON_03400821 "fine bakery ware (eurofir)"@en)
SubClassOf(obo:FOODON_03400821 obo:FOODON_03400812)

# Class: obo:FOODON_03400822 (savoury cereal dish (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400822 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400822 "Includes dumpling, risotto, savoury pancake, pizza, couscous, savoury pie, sandwich."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400822 langual:A0822)
AnnotationAssertion(rdfs:label obo:FOODON_03400822 "savoury cereal dish (eurofir)"@en)
SubClassOf(obo:FOODON_03400822 obo:FOODON_03400812)
SubClassOf(obo:FOODON_03400822 obo:FOODON_03400861)

# Class: obo:FOODON_03400823 (nut, seed or kernel (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400823 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400823 "Nuts, seeds and kernels in all forms, including pastes. Examples: walnut, hazelnut, sweet chestnut, sunflower seed, olive seed, pine nut, apricot kernel, peanuts."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400823 langual:A0823)
AnnotationAssertion(rdfs:label obo:FOODON_03400823 "nut, seed or kernel (eurofir)"@en)
SubClassOf(obo:FOODON_03400823 obo:FOODON_03400777)
SubClassOf(obo:FOODON_03400823 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002351 ObjectUnionOf(obo:FOODON_00001172 obo:FOODON_03304497)) ObjectAllValuesFrom(obo:RO_0002351 ObjectUnionOf(obo:FOODON_00001172 obo:FOODON_03304497))))

# Class: obo:FOODON_03400824 (nut or seed product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400824 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400824 "Includes coconut milk, chestnut purée, tahini paste, peanut butter."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400824 langual:A0824)
AnnotationAssertion(rdfs:label obo:FOODON_03400824 "nut or seed product (eurofir)"@en)
SubClassOf(obo:FOODON_03400824 obo:FOODON_03400823)

# Class: obo:FOODON_03400825 (vegetable or vegetable product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400825 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400825 "Includes: plants and parts of plants eaten as vegetables (i.e. normally consumed as a savoury and usually with other foods as sources of protein and/or grain starch), including immature pulses; edible fungi and seaweed; a food product whose predominant constituent is vegetables; a recipe dish whose main ingredient is considered to be vegetables. The group excludes: fruiting body of a plant when this is consumed as a dessert fruit (under *FRUIT*); seeds, kernels and nuts (under *NUT, SEED OR KERNEL PRODUCT*); oils produced from vegetable plants (under *FAT OR OIL*); herbs, spices, chutney and pickles produced from vegetables (under *SPICE, CONDIMENT OR OTHER INGREDIENT*); food products produced wholly or partially from vegetables but used as a substitute for a food assigned to another main group (for example, potato flour is a substitute flour under *FLOUR OR STARCH*)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400825 langual:A0825)
AnnotationAssertion(rdfs:label obo:FOODON_03400825 "vegetable or vegetable product (eurofir)"@en)
SubClassOf(obo:FOODON_03400825 obo:FOODON_03400777)

# Class: obo:FOODON_03400826 (vegetable (excluding potato) (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400826 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400826 "In EFG, Potatoes were excluded distinguished from other vegetables because of their high starch content. Herbs have been included where these may be consumed in significant amounts as vegetables, either raw or cooked (e.g. parsley, chives). A vegetable fruit is usually consumed as a vegetable when the starch content is high (e.g. avocado, olive). Some examples of foods classified here would be lettuce, cabbage, rhubarb, asparagus, onion, carrot."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400826 langual:A0826)
AnnotationAssertion(rdfs:label obo:FOODON_03400826 "vegetable (excluding potato) (eurofir)"@en)
SubClassOf(obo:FOODON_03400826 obo:FOODON_03400825)

# Class: obo:FOODON_03400827 (vegetable product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400827 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400827 "For example, tomato purée, sun-dried tomatoes, pickled red cabbage, sauerkraut."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400827 langual:A0827)
AnnotationAssertion(rdfs:label obo:FOODON_03400827 "vegetable product (eurofir)"@en)
SubClassOf(obo:FOODON_03400827 obo:FOODON_03400826)

# Class: obo:FOODON_03400828 (vegetable dish (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400828 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400828 "A recipe dish whose main ingredient is considered to be vegetables."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400828 langual:A0828)
AnnotationAssertion(rdfs:label obo:FOODON_03400828 "vegetable dish (eurofir)"@en)
SubClassOf(obo:FOODON_03400828 obo:FOODON_03400827)
SubClassOf(obo:FOODON_03400828 obo:FOODON_03400861)

# Class: obo:FOODON_03400829 (starchy root or potato (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400829 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400829 "In EFG, Potatoes were excluded distinguished from other vegetables because of their high starch content. Some examples of foods classified here would be new potato, main-crop potato, jerusalem artichoke, sweet potato, yam"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400829 langual:A0829)
AnnotationAssertion(rdfs:label obo:FOODON_03400829 "starchy root or potato (eurofir)"@en)
