# Class: obo:FOODON_03543364 (33640 - noble rot wine (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543364 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543364 "The group includes any type of Noble rot wine (such as Tokaji), i.e. sweet wines made from botrytis infected grapes grown in dry conditions. The grapes used for this type of wines are infected by Botrytis cinerea when they are ripe, and then, thanks to drier conditions, they become partially raisined, giving concentrated sweet wines. The part consumed/analysed is by default the whole marketed unit or a homogeneous representative portion.[https://en.wikipedia.org/wiki/Late_harvest_wine] and [https://www.google.co.uk/search?tbm=isch&q=Noble rot wine]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543364 langual:A03NR)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543364 "botrytized wines"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543364 "tokaji"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543364 "33640 - noble rot wine (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543364 obo:FOODON_03543361)

