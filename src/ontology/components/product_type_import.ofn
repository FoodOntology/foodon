AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540284 "karelian pasty"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540284 "02840 - flat bread-based pastry (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540284 obo:FOODON_03540275)

