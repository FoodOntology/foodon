# Class: obo:FOODON_03543150 (31500 - traditional margarine (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543150 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543150 "The group includes fat-based emulsion resembling in the aspect butter but normally not including significant amounts dairy fat. The fat sources are usually vegetable fats, though historically animal fats including dairy fats have been used. The basic process is emulsifying a blend of vegetable oils and fats, which can be modified using fractionation, interesterification, and/or hydrogenation. The term traditional margarine refers here to the types more solid, most often used for cooking, baking or frying.[https://en.wikipedia.org/wiki/Margarin] and [https://www.google.co.uk/search?tbm=isch&q=Traditional margarine]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543150 langual:A039D)
AnnotationAssertion(rdfs:label obo:FOODON_03543150 "31500 - traditional margarine (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543150 obo:FOODON_03543149)

# Class: obo:FOODON_03543151 (31510 - blended margarine (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543151 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543151 "The group includes margarines blended with vegetable oils, in many cases leading to spreadable products, used for consumption as such, on bread or similar.[https://en.wikipedia.org/wiki/Margarin] and [https://www.google.co.uk/search?tbm=isch&q=Blended margarine]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543151 langual:A039E)
AnnotationAssertion(rdfs:label obo:FOODON_03543151 "31510 - blended margarine (efsa foodex2)"@en)
