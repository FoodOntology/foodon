SubClassOf(obo:FOODON_03544503 obo:FOODON_03544502)

# Class: obo:FOODON_03544504 (45040 - omega-6 fatty acids (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544504 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544504 "The group includes Omega-6 fatty acids used as fortifying agents. Omega-6 fatty acids (also referred to as n-6 fatty acids) are a family of polyunsaturated fatty acids that have in common a final carbon-carbon double bond in the n-6 position, that is, the sixth bond, counting from the methyl end. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity. ] and [https://en.wikipedia.org/wiki/Omega-6_fatty_acid]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544504 langual:A0EVT)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03544504 "n-6 fatty acids"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03544504 "45040 - omega-6 fatty acids (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544504 obo:FOODON_03544502)

