# Class: obo:FOODON_03400813 (cereal or cereal-like milling products and derivatives (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400813 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400813 "Examples: wheat flour, wholemeal, substitute flours and starches, wheat flour, patent, soya flour, rye flour, whole, potato flour, cornflour, carob flour, rice flour, arrowroot, buckwheat flour, tapioca"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400813 langual:A0813)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400813 "flour or starch"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400813 "milled grain or starch product"@en)
