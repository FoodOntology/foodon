AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543034 "The group includes any type of chocolate, i.e. solid product obtained by refining, conching and tempering mixtures of cocoa mass, cocoa butter and eventually other ingredients. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Chocolate and similar]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543034 langual:A0EQD)
AnnotationAssertion(rdfs:label obo:FOODON_03543034 "30340 - chocolate and similar (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543034 obo:FOODON_03543033)

# Class: obo:FOODON_03543035 (30350 - bitter chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543035 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543035 "The group includes any type of Bitter chocolate, such as Dark chocolate and Plain chocolate, usually containing at least 35 % total dry cocoa solids, with no milk or much less than milk chocolate and with no sugar or small amount of sugar. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Dark_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Bitter chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543035 langual:A034G)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543035 "black chocolate"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543035 "dark chocolate"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543035 "plain chocolate"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543035 "30350 - bitter chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543035 obo:FOODON_03543034)

# Class: obo:FOODON_03543036 (30360 - bitter-sweet chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543036 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543036 "The group includes any type of Bitter-sweet chocolate, a bitter chocolate with small amount of sugar added. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Bittersweet_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Bittersweet chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543036 langual:A034H)
AnnotationAssertion(rdfs:label obo:FOODON_03543036 "30360 - bitter-sweet chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543036 obo:FOODON_03543035)

# Class: obo:FOODON_03543037 (30370 - milk chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543037 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543037 "The group includes any type of Milk chocolate, i.e. a sweet chocolate obtained from cocoa products, sugars and milk or milk products. According to EU legislation (Directive 2000/36/EC) milk chocolate has to contain not less than 14 % dry milk solids and not less than 3.5 % milk fat. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Milk_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Milk chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543037 langual:A034J)
AnnotationAssertion(rdfs:label obo:FOODON_03543037 "30370 - milk chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543037 obo:FOODON_03543034)

# Class: obo:FOODON_03543038 (30380 - family chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543038 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543038 "The group includes any type of Family milk chocolate, i.e. a sweet chocolate obtained from cocoa products, sugars and milk or milk products. According to EU legislation (Directive 2000/36/EC) family milk chocolate contains higher dry milk solid ingredients (not less than 20 %) and milk fat (not less than 5 %) than the standard milk chocolate. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Types_of_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Family milk chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543038 langual:A034K)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543038 "family milk chocolate"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543038 "30380 - family chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543038 obo:FOODON_03543037)

# Class: obo:FOODON_03543039 (30390 - cream chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543039 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543039 "The group includes any type of Cream Chocolate. According to EU legislation (Directive 2000/36/EC) Cream chocolate has a higher milk fat content (minimum milk fat content of 5.5 %) than the standard milk chocolate. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Types_of_chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543039 langual:A034L)
AnnotationAssertion(rdfs:label obo:FOODON_03543039 "30390 - cream chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543039 obo:FOODON_03543037)

# Class: obo:FOODON_03543040 (30400 - couverture chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543040 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543040 "The group includes any type of Couverture chocolate. In EU the products sold as Couverture chocolate have the characteristics defined by EU legislation Directive 2000/36/EC. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Couverture_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=Couverture chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543040 langual:A034M)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543040 "cooking chocolate"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543040 "30400 - couverture chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543040 obo:FOODON_03543034)

# Class: obo:FOODON_03543041 (30410 - white chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543041 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543041 "The group includes any type of White chocolate, i.e. product obtained from cocoa butter, milk or milk products and sugars which, According to EU legislation (Directive 2000/36/EC), contains not less than 20 % cocoa butter and not less than 14 % dry milk solids. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/White_chocolate] and [https://www.google.co.uk/search?tbm=isch&q=White chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543041 langual:A034P)
AnnotationAssertion(rdfs:label obo:FOODON_03543041 "30410 - white chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543041 obo:FOODON_03543034)

# Class: obo:FOODON_03543042 (30420 - gianduja chocolate (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543042 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543042 "The group includes any type of Gianduja chocolate, i.e. a special type of sweet chocolate containing about 30-50% hazelnut (and in some later variants eventually almond) paste, invented in Turin (Piedmont). The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Gianduja_(chocolate)] and [https://www.google.co.uk/search?tbm=isch&q=Gianduja chocolate]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543042 langual:A034N)
AnnotationAssertion(rdfs:label obo:FOODON_03543042 "30420 - gianduja chocolate (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543042 obo:FOODON_03543034)

