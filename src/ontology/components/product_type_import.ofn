AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400830 langual:A0830)
AnnotationAssertion(rdfs:label obo:FOODON_03400830 "potato dish (eurofir)"@en)
SubClassOf(obo:FOODON_03400830 obo:FOODON_03400829)
SubClassOf(obo:FOODON_03400830 obo:FOODON_03400861)

# Class: obo:FOODON_03400831 (pulse or pulse product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400831 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400831 "EFG group 14. Eurocode-2 group 7.10-20"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400831 langual:A0831)
AnnotationAssertion(rdfs:comment obo:FOODON_03400831 "LanguaL curation note: Use for crops harvested as dry seed. Index green beans and green peas as vegetables."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400831 "pulse or pulse product (eurofir)"@en)
SubClassOf(obo:FOODON_03400831 obo:FOODON_03400825)

# Class: obo:FOODON_03400832 (pulse dish (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400832 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400832 langual:A0832)
AnnotationAssertion(rdfs:label obo:FOODON_03400832 "pulse dish (eurofir)"@en)
SubClassOf(obo:FOODON_03400832 obo:FOODON_03400831)
SubClassOf(obo:FOODON_03400832 obo:FOODON_03400861)

# Class: obo:FOODON_03400833 (fruit or fruit product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400833 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400833 "The group includes: fruits when consumed as a dessert; food products whose predominant constituent is fruit; recipe dishes whose main ingredient is considered to be fruit. A fruit is usually consumed as a dessert when the starch content has been reduced by conversion during ripening to sugars. The group excludes: vegetable fruits (under Vegetable); nuts, seeds and kernels (under *NUT, SEED OR KERNEL PRODUCT*); oils produced from fruits (under *FAT OR OIL*); chutney and pickles (under Miscellaneous foods)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400833 langual:A0833)
AnnotationAssertion(rdfs:label obo:FOODON_03400833 "fruit or fruit product (eurofir)"@en)
SubClassOf(obo:FOODON_03400833 obo:FOODON_03400777)

# Class: obo:FOODON_03400834 (processed fruit product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400834 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400834 "Examples are dried fruits (e.g. dried mixed fruit), compotes, canned, stewed fruit (e.g. apple sauce, fruit cocktail)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400834 langual:A0834)
AnnotationAssertion(rdfs:label obo:FOODON_03400834 "processed fruit product (eurofir)"@en)
SubClassOf(obo:FOODON_03400834 obo:FOODON_03400833)

# Class: obo:FOODON_03400835 (sugar or sugar product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400835 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400835 "This group includes sucrose and other sugars, sugar substitutes, honey and syrups; fruit jams, marmalades and other spreads; dessert jellies and toppings; chocolate and non-chocolate confectionery; a food product whose predominant constituent is sugar or chocolate; a recipe dish whose main ingredient is considered to be sugar or chocolate."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400835 langual:A0835)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400835 "confectionery"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400835 "sugar or sugar product (eurofir)"@en)
SubClassOf(obo:FOODON_03400835 obo:FOODON_03400777)

# Class: obo:FOODON_03400836 (sugar, honey or syrup (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400836 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400836 "This group includes sugars (e.g. white sugar, brown sugar, fructose), sugar substitutes (non-nutritive sweeteners like aspartame & saccharine, nutritive sweeteners like sorbitol & mannitol), honey, syrups (e.g. molasses, maple syrup, corn syrup)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400836 langual:A0836)
AnnotationAssertion(rdfs:label obo:FOODON_03400836 "sugar, honey or syrup (eurofir)"@en)
SubClassOf(obo:FOODON_03400836 obo:FOODON_03400835)

# Class: obo:FOODON_03400837 (jam or marmalade (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400837 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400837 "Semisolid or jelled food prepared from fruit or fruit juice and other ingredients. The group includes fruit jam, fruit jelly preserve, marmalade."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400837 langual:A0837)
AnnotationAssertion(rdfs:label obo:FOODON_03400837 "jam or marmalade (eurofir)"@en)
SubClassOf(obo:FOODON_03400837 obo:FOODON_03400835)

# Class: obo:FOODON_03400838 (non-chocolate confectionery or other sugar product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400838 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400838 "Some examples are boiled sweet, gum sweet, nougat, turkish delight, chewing gum, marzipan, candied fruit."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400838 langual:A0838)
AnnotationAssertion(rdfs:label obo:FOODON_03400838 "non-chocolate confectionery or other sugar product (eurofir)"@en)
SubClassOf(obo:FOODON_03400838 obo:FOODON_03400835)

# Class: obo:FOODON_03400839 (chocolate or chocolate product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400839 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400839 "Some examples are chocolate slab or bar (e.g. milk chocolate bar, white chocolate bar), filled chocolate candy, chocolate-coated confectionery bars."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400839 langual:A0839)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400839 "chocolate confectionery"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400839 "chocolate or chocolate product (eurofir)"@en)
SubClassOf(obo:FOODON_03400839 obo:FOODON_03400835)

# Class: obo:FOODON_03400840 (beverage (non-milk) (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400840 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400840 "Alcoholic or non-alcoholic beverage; excludes milk and milk-based beverages."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400840 langual:A0840)
AnnotationAssertion(rdfs:label obo:FOODON_03400840 "beverage (non-milk) (eurofir)"@en)
SubClassOf(obo:FOODON_03400840 obo:FOODON_03400777)

# Class: obo:FOODON_03400841 (juice or nectar (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400841 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400841 "The members of the work group in Action COST 99/Eurofoods considered it important to be able to separate fruit juices from both *NON-ALCOHOLIC BEVERAGE* and *FRUIT* in the EFG classification, in order to evaluate and compare consumption patterns across countries. Examples are orange juice, apple juice, tomato juice, fruit and vegetable nectars."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400841 langual:A0841)
AnnotationAssertion(rdfs:label obo:FOODON_03400841 "juice or nectar (eurofir)"@en)
SubClassOf(obo:FOODON_03400841 obo:FOODON_03400840)

# Class: obo:FOODON_03400842 (non alcoholic beverage (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400842 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400842 "Beverage containing no more than 0.5% alcohol; it may be flavoured, sweetened or carbonated; includes soft drinks and steeped beverages; excludes milk in all forms, fruit juices and vegetable juices."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400842 langual:A0842)
AnnotationAssertion(rdfs:label obo:FOODON_03400842 "non alcoholic beverage (eurofir)"@en)
SubClassOf(obo:FOODON_03400842 obo:FOODON_03400840)

# Class: obo:FOODON_03400843 (soft drink (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400843 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400843 "Includes carbonated soft drinks (e.g. soda water, carbonated lemonade, cola, tonic), non-dilution still drinks (e.g. still lemonade), dilution drinks (concentrates which are diluted with water prior to consumption , e.g. rosehip syrup, fruit squash, lime cordial)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400843 langual:A0843)
AnnotationAssertion(rdfs:label obo:FOODON_03400843 "soft drink (eurofir)"@en)
SubClassOf(obo:FOODON_03400843 obo:FOODON_03400842)

# Class: obo:FOODON_03400844 (water (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400844 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400844 "Includes tap water, carbonated mineral water, still mineral water."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400844 langual:A0844)
AnnotationAssertion(rdfs:label obo:FOODON_03400844 "water (eurofir)"@en)
SubClassOf(obo:FOODON_03400844 obo:FOODON_03400842)

# Class: obo:FOODON_03400845 (coffee, tea, cocoa or infusion (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400845 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400845 "Beverage prepared by extracting flavour and other components from food sources by percolation and/or immersion in water, usually at near-boiling temperature. The group includes coffee (e.g. instant coffee, coffee and chicory essence), tea, herbal tea (e.g. green tea, black tea, tisane), cocoa beverage and beverage powder."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400845 langual:A0845)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400845 "infusion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400845 "steeped beverage"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400845 "LanguaL curation note: Renamed from *COFFEE, TEA, COCOA (EUROFIR)* (LanguaL 2010)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400845 "coffee, tea, cocoa or infusion (eurofir)"@en)
SubClassOf(obo:FOODON_03400845 obo:FOODON_03400842)

# Class: obo:FOODON_03400846 (alcoholic beverage (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400846 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400846 "Beverage containing more than 0.5% alcohol; includes distilled spirits, malt beverage, and wine. Alcohol-free varieties are included in the appropriate categories together with their alcohol-containing forms and distinguished in facets H and P."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400846 langual:A0846)
AnnotationAssertion(rdfs:comment obo:FOODON_03400846 "LanguaL curation note: Alcoholic content can be indexed in facet Z."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400846 "alcoholic beverage (eurofir)"@en)
SubClassOf(obo:FOODON_03400846 obo:FOODON_03400840)

# Class: obo:FOODON_03400847 (beer or beer-like beverage (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400847 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400847 "Includes beer, barley beer."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400847 langual:A0847)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400847 "beer or other malt beverage"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400847 "LanguaL curation note: Renamed from *BEER OR OTHER MALT BEVERAGE (EUROFIR)* (LanguaL 2010)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400847 "beer or beer-like beverage (eurofir)"@en)
SubClassOf(obo:FOODON_03400847 obo:FOODON_03400846)

# Class: obo:FOODON_03400848 (cider, perry or similar drink (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400848 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400848 "Includes apple cider, perry (made by fermenting pear juice)"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400848 langual:A0848)
AnnotationAssertion(rdfs:label obo:FOODON_03400848 "cider, perry or similar drink (eurofir)"@en)
SubClassOf(obo:FOODON_03400848 obo:FOODON_03400846)

# Class: obo:FOODON_03400849 (wine, fortified wine or wine-like beverage (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400849 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400849 "Alcoholic beverage produced by the normal fermentation of the juice of grapes or other fruits or of the fermentable parts of plants or plant-related products. The group includes table wine, dessert wine, elderberry wine, fortified and liqueur wines (e.g. port, sherry, vermouth)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400849 langual:A0849)
AnnotationAssertion(rdfs:label obo:FOODON_03400849 "wine, fortified wine or wine-like beverage (eurofir)"@en)
SubClassOf(obo:FOODON_03400849 obo:FOODON_03400846)

# Class: obo:FOODON_03400850 (liqueur or spirits (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400850 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400850 "Alcoholic beverage prepared by fermentation of grain or plant-related products and subsequent distillation. Includes liqueurs (e.g. calvados, kahlua, advocaat) and spirits (e.g. brandy, whisk(e)y, rum)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400850 langual:A0850)
AnnotationAssertion(rdfs:label obo:FOODON_03400850 "liqueur or spirits (eurofir)"@en)
SubClassOf(obo:FOODON_03400850 obo:FOODON_03400846)

# Class: obo:FOODON_03400851 (alcoholic mixed drink (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400851 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400851 "Includes cocktails, punch, shandy."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400851 langual:A0851)
AnnotationAssertion(rdfs:label obo:FOODON_03400851 "alcoholic mixed drink (eurofir)"@en)
SubClassOf(obo:FOODON_03400851 obo:FOODON_03400846)

# Class: obo:FOODON_03400852 (miscellaneous food product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400852 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400852 "EFG group 32, Eurocode-2 group 12."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400852 langual:A0852)
AnnotationAssertion(rdfs:comment obo:FOODON_03400852 "LanguaL curation note: Use for foods and ingredients that could not fit into any of the above classes."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400852 "miscellaneous food product (eurofir)"@en)
SubClassOf(obo:FOODON_03400852 obo:FOODON_03400777)

# Class: obo:FOODON_03400853 (spice, condiment or other ingredient (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400853 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400853 "This subgroup includes baking goods and other ingredients such as flavourings, essences, seasonings and extracts which are difficult to assign to other main groups; herbs and spices; dressings, condiments and mixed accompaniments such as chutneys and pickles. The group does not include starches (under *GRAIN OR GRAIN PRODUCT*); plant products that may be used in significant amounts as vegetables as well as herbs, like chives and parsley (under *VEGETABLE*)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400853 langual:A0853)
AnnotationAssertion(rdfs:label obo:FOODON_03400853 "spice, condiment or other ingredient (eurofir)"@en)
SubClassOf(obo:FOODON_03400853 obo:FOODON_03400852)

# Class: obo:FOODON_03400854 (baking ingredient (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400854 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400854 "Includes yeast, baking powder, pectin, additives."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400854 langual:A0854)
AnnotationAssertion(rdfs:label obo:FOODON_03400854 "baking ingredient (eurofir)"@en)
SubClassOf(obo:FOODON_03400854 obo:FOODON_03400853)

# Class: obo:FOODON_03400855 (flavouring or essence (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400855 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400855 "Includes almond essence, vanilla essence."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400855 langual:A0855)
AnnotationAssertion(rdfs:label obo:FOODON_03400855 "flavouring or essence (eurofir)"@en)
SubClassOf(obo:FOODON_03400855 obo:FOODON_03400853)

# Class: obo:FOODON_03400856 (seasoning or extract (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400856 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400856 "Includes salt, stock cubes, gravy thickener, beef extract, marmite, vinegar."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400856 langual:A0856)
AnnotationAssertion(rdfs:label obo:FOODON_03400856 "seasoning or extract (eurofir)"@en)
SubClassOf(obo:FOODON_03400856 obo:FOODON_03400853)

# Class: obo:FOODON_03400857 (herb or spice (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400857 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400857 "Aromatic or pungent plant product used whole or ground as a seasoning in food products, e.g. basil, oregano, thyme, allspice, clove, paprika, curry powder. Herbs may be considered to be plants whose non-woody parts are consumed in small amounts for their flavouring properties rather than in amounts significant to the intake of major nutrients. Spices are usually a dried part, or parts, of aromatic plants used either whole or ground to add flavour and for preservative properties. Some such as coriander and fenugreek are the ground seeds of plants whose leaves are used as herbs or vegetables. Others are dried fruits or berries."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400857 langual:A0857)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400857 "spice or herb"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400857 "herb or spice (eurofir)"@en)
SubClassOf(obo:FOODON_03400857 obo:FOODON_03400853)

# Class: obo:FOODON_03400858 (condiment (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400858 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400858 "Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavours of other foods; includes ketchup, tabasco sauce, barbeque sauce, vinegar, soy sauce, prepared mustard, prepared horseradish, mint sauce and tartar sauce."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400858 langual:A0858)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400858 "condiment sauce"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400858 "condiment (eurofir)"@en)
SubClassOf(obo:FOODON_03400858 obo:FOODON_03400853)

# Class: obo:FOODON_03400859 (dressing, mayonnaise (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400859 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400859 "Mixture of edible fats or oils, acidifying agents and optional ingredients such as sweeteners (nutritive or non-nutritive), starch, egg and seasonings. Used in limited amounts to accompany salads and other foods. Includes salad dressings & other vinegar and oil based cold sauces, mayonnaise & other egg and oil based cold sauces."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400859 langual:A0859)
AnnotationAssertion(rdfs:label obo:FOODON_03400859 "dressing, mayonnaise (eurofir)"@en)
SubClassOf(obo:FOODON_03400859 obo:FOODON_03400853)

# Class: obo:FOODON_03400860 (chutney or pickle (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400860 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400860 "Product prepared by immersing fruits, vegetables, or other ingredients, such as spices and sweeteners, in a brine or an acid solution. Used to enhance the flavour of other food products. Examples are mango chutney, dill pickle, mixed pickle, relish."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400860 langual:A0860)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400860 "pickle; relish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400860 "chutney or pickle (eurofir)"@en)
SubClassOf(obo:FOODON_03400860 obo:FOODON_03400827)
SubClassOf(obo:FOODON_03400860 obo:FOODON_03400858)

# Class: obo:FOODON_03400861 (prepared food product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400861 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400861 "This subgroup includes multicomponent meals, sauces, retail salads, desserts, soups, snacks and other foods where similarity of the product type is more significant than the source of the principal ingredient(s)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400861 langual:A0861)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400861 "soup, sauce or miscellaneous food product"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400861 "prepared food product (eurofir)"@en)
SubClassOf(obo:FOODON_03400861 obo:FOODON_03400852)

# Class: obo:FOODON_03400862 (savoury sauce (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400862 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400862 "Nonstandardized food product used as a meal accompaniment and consisting of a mixture of fats or oils, starch, liquid and other optional ingredients specified by the recipe; excludes condiments. Includes. bolognese sauce , white sauce, brown sauce, butter sauce, tomato sauce."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400862 langual:A0862)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400862 "gravy or sauce"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400862 "LanguaL curation note: Sauce is a very general term for a liquid or semiliquid seasoning or other accompaniment for food. When sauces are cooked as part of, or adjuncts to, dishes (including starters, main courses and desserts), they have been assigned to the *SAVOURY SAUCE* or"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400862 "savoury sauce (eurofir)"@en)
SubClassOf(obo:FOODON_03400862 obo:FOODON_03400861)

# Class: obo:FOODON_03400863 (dessert sauce (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400863 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400863 "Sweetened and flavored product that is used as an accompaniment to desserts, e.g. fruit sauce, fudge sauce, brandy sauce."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400863 langual:A0863)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400863 "sweet sauce"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400863 "LanguaL curation note: Sauce is a very general term for a liquid or semiliquid seasoning or other accompaniment for food. When sauces are cooked as part of, or adjuncts to, dishes (including starters, main courses and desserts), they have been assigned to the *SAVOURY SAUCE* or"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400863 "dessert sauce (eurofir)"@en)
SubClassOf(obo:FOODON_03400863 obo:FOODON_03400861)

# Class: obo:FOODON_03400864 (dessert (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400864 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400864 "Sweetened prepared product usually consumed after the main course in a meal. Excludes fruit or fruit products, bakery products and confectionery. Includes sweet puddings (custards, starch puddings), non-dairy ices (e.g. water ices, granitas, sorbets) and gelatine desserts."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400864 langual:A0864)
AnnotationAssertion(rdfs:label obo:FOODON_03400864 "dessert (eurofir)"@en)
SubClassOf(obo:FOODON_03400864 obo:FOODON_03400861)

# Class: obo:FOODON_03400865 (soup (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400865 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400865 "A liquid food made by simmering meat, poultry, seafood or vegetables, being clear or thickened to the consistency of a thin puree or having milk or cream added, and often containing pieces of solid food such as meat, shellfish, pasta or vegetables. Soup takes precedence over other food products. Examples are egg and lemon soup, oxtail soup, fish soup, rice soup, lentil soup, minestrone, cherry soup."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400865 langual:A0865)
AnnotationAssertion(rdfs:label obo:FOODON_03400865 "soup (eurofir)"@en)
SubClassOf(obo:FOODON_03400865 obo:FOODON_03400861)

# Class: obo:FOODON_03400866 (prepared salad (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400866 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400866 "A combination of one or more vegetable, fruit, herb, meat, poultry, seafood, egg, cereal or pasta, usually served with some kind of moist dressing; may be moulded with a jellying agent. Salad takes precedence over other product types. Examples are egg salad, tuna salad, mixed vegetable salad, jelled fruit salad, macaroni salad, potato salad, rice salad, mayonnaise salad."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400866 langual:A0866)
AnnotationAssertion(rdfs:label obo:FOODON_03400866 "prepared salad (eurofir)"@en)
SubClassOf(obo:FOODON_03400866 obo:FOODON_03400861)

# Class: obo:FOODON_03400867 (sandwich filling (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400867 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400867 "Includes cheese-based sandwich filling, fish-based sandwich filling."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400867 langual:A0867)
AnnotationAssertion(rdfs:label obo:FOODON_03400867 "sandwich filling (eurofir)"@en)
SubClassOf(obo:FOODON_03400867 obo:FOODON_03400861)

# Class: obo:FOODON_03400868 (savoury snack (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400868 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400868 "Unsweetened food product marketed for consumption between meals; excludes nuts, edible seeds, and sweetened products such as cakes, puddings and candies. Examples are potato crisps, maize-based snacks, pretzels, popcorn."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400868 langual:A0868)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400868 "snack food"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400868 "savoury snack (eurofir)"@en)
SubClassOf(obo:FOODON_03400868 obo:FOODON_03400861)

# Class: obo:FOODON_03400869 (product for special nutritional use or dietary supplement (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400869 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400869 "This group includes products for dietetic use that are not typically regarded as food. It excludes normal foods that are prepared or processed in a special way to suit dietetic purposes; these are indexed as the normal food with the addition of appropriate terms available from the thesaurus (facet P)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400869 langual:A0869)
AnnotationAssertion(rdfs:label obo:FOODON_03400869 "product for special nutritional use or dietary supplement (eurofir)"@en)
SubClassOf(obo:FOODON_03400869 obo:FOODON_03400777)

# Class: obo:FOODON_03400870 (dietary supplement (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400870 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400870 "Includes vitamin/mineral products, tonics, supplements. Vitamin and mineral food supplements are sources in concentrated forms of those nutrients alone or in combinations, marketed in forms such as capsules, tablets, powders, solutions etc., that are designed to be taken in measured small-unit quantities but are not in a conventional food form and whose purpose is to supplement the intake of vitamins and/or minerals from the normal diet (Codex CAC/GL 55 - 2005)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400870 langual:A0870)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400870 "vitamin and mineral food supplements"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400870 "dietary supplement (eurofir)"@en)
SubClassOf(obo:FOODON_03400870 obo:FOODON_03400869)

# Class: obo:FOODON_03400871 (food for special nutritional use (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400871 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400871 "Foods for Special Dietary Uses are those foods that are specially processed or formulated to satisfy particular dietary requirements that exist because of a particular physical or physiological condition and/or specific diseases and disorders and that are presented as such. The composition of these foodstuffs must differ significantly from the composition of ordinary foods of comparable nature, if such ordinary foods exist (CODEX STAN 146-1985).  The product may be used as the sole or major source of nourishment. It is frequently offered in a form convenient to use. The group includes infant formula, products designed for weight loss, instant breakfast, energy food stick, interal and parenteral complete nutrition solutions, etc."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400871 langual:A0871)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400871 "food for special dietary use"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400871 "meal replacement"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400871 "food for special nutritional use (eurofir)"@en)
SubClassOf(obo:FOODON_03400871 obo:FOODON_03400869)

# Class: obo:FOODON_03400872 (medical food (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400872 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400872 "Foods for special medical purposes are a category of foods for special dietary uses that are specially processed or formulated and presented for the dietary management of patients and may be used only under medical supervision. They are intended for the exclusive or partial feeding of patients with limited or impaired capacity to take, digest, absorb or metabolize ordinary foodstuffs or certain nutrients contained therein, or who have other special medically-determined nutrient requirements, whose dietary management cannot be achieved only by modification of the normal diet, by other foods for special dietary uses, or by a combination of the two (CODEX STAN 180-1991)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400872 langual:A0872)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400872 "dietary foods for special medical purposes"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400872 "food for special medical purposes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400872 "medical food (eurofir)"@en)
SubClassOf(obo:FOODON_03400872 obo:FOODON_03400871)

# Class: obo:FOODON_03400873 (food for infants (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400873 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400873 "Eurocode-2 group 13.60."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400873 langual:A0873)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400873 "infant formula"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400873 "LanguaL curation note: Use for Infant formulae and follow-on formulae. Index Processed cereal-based foods and baby foods for infants and young children as the corresponding normal food (e.g. soup, fruit product). For both infant and baby foods, also index *INFANT OR TODDLER FOOD* in facet P."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400873 "food for infants (eurofir)"@en)
SubClassOf(obo:FOODON_03400873 obo:FOODON_03400871)

# Class: obo:FOODON_03400874 (GS1 Global Product Classification (GPC))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400874 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400874 "The Global System 1 (GS1) Global Product Classification (GPC) is a system that gives buyers and sellers a common language for grouping products in the same way, everywhere in the world.$br/$
The GS1 GPC classification in facet A is currently updated based on June 2017 release of GS1 GPC Standard for Food/Beverage/Tobacco, except for codes pertaining to tobacco. See the GS1 site for details [https://www.gs1.org/standards/gpc]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400874 langual:A0874)
AnnotationAssertion(rdfs:label obo:FOODON_03400874 "GS1 Global Product Classification (GPC)"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03400874 <https://www.gs1.org/docs/gdsn/support/it/GDSN_Mandatory_Attributes_Simplified_TK.ppt>)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03400874 <https://www.gs1.org/docs/gdsn/tiig/3_1/GDSN_Trade_Item_Implementation_Guide.pdf>)
SubClassOf(obo:FOODON_03400874 obo:FOODON_03400352)

