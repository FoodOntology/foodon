# Class: obo:FOODON_03400812 (grain or grain product (eurofir))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400812 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400812 "This group includes: grains and their milled products obtained from members of the grass family; dough products obtained from grain, such as pasta and breads; breakfast cereals; savoury and sweet products and dishes in which grain products are considered the predominant constituent; substitute flours and other starch products obtained from non-cereal sources. It excludes sweet corn when eaten as a vegetable."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400812 langual:A0812)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400812 "cereal product"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400812 "grain or grain product (eurofir)"@en)
