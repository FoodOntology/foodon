AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400224 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400224 "Wine containing 14-24% alcohol."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400224 langual:A0224)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400224 "aperitif wine (u.s.)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400224 "dessert wine (u.s.)"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400224 "heavy wine, 14-24% alcohol (us cfr)"@en)
