AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400215 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400215 "Natural or synthetic product, dissolved in a suitable solvent or carried on an appropriate dry base and added to a food product to enhance or impart taste and aroma."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400215 langual:A0215)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400215 "aroma"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400215 "flavoring (us cfr)"@en)
SubClassOf(obo:FOODON_03400215 obo:FOODON_03400300)

# Class: obo:FOODON_03400216 (hard candy (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400216 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400216 "Candy prepared by boiling a mixture of water, sugars, butter or margarine and optional ingredients to the hard-crack stage (300 degrees F.)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400216 langual:A0216)
AnnotationAssertion(rdfs:label obo:FOODON_03400216 "hard candy (us cfr)"@en)
SubClassOf(obo:FOODON_03400216 obo:FOODON_03400204)

# Class: obo:FOODON_03400217 (meat, poultry, seafood or related product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400217 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400217 "Products of the flesh of animals. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400217 langual:A0217)
AnnotationAssertion(rdfs:label obo:FOODON_03400217 "meat, poultry, seafood or related product (us cfr)"@en)
SubClassOf(obo:FOODON_03400217 obo:FOODON_03401270)

# Class: obo:FOODON_03400218 (sandwich (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400218 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400218 langual:A0218)
AnnotationAssertion(rdfs:comment obo:FOODON_03400218 "LanguaL curation note: Sandwich takes precedent over other product types. Examples: peanut butter and jelly sandwich, tuna sandwich, egg salad sandwich or hamburger on roll. The filling of a sandwich is always indexed as the food source, even if the bread is the same weight or outweighs the filling ingredient(s). The bread would be indexed by *GRAIN ADDED* or the appropriate narrower term."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400218 "sandwich (us cfr)"@en)
SubClassOf(obo:FOODON_03400218 obo:FOODON_03400102)

# Class: obo:FOODON_03400219 (custard, cooked (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400219 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400219 "Cooked or baked mixture of milk, eggs and optional ingredients including nutritive and non-nutritive sweeteners."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400219 langual:A0219)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400219 "cooked custard"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400219 "custard, cooked (us cfr)"@en)
SubClassOf(obo:FOODON_03400219 obo:FOODON_03400285)

# Class: obo:FOODON_03400220 (pasta dish (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400220 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400220 "Prepared food product in which pasta in its cooked form is the first or second ingredient. Examples are spaghetti with meat balls, macaroni and cheese, beef stroganoff with noodles, etc. Excludes *SOUP* and *SALAD*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400220 langual:A0220)
AnnotationAssertion(rdfs:label obo:FOODON_03400220 "pasta dish (us cfr)"@en)
SubClassOf(obo:FOODON_03400220 obo:FOODON_03400172)

# Class: obo:FOODON_03400221 (sausage or luncheon meat (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400221 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400221 "This category includes a wide variety of products made from comminuted or chopped meat (skeletal and/or organ meat) that is usually salted and/or seasoned and often stuffed in an edible or inedible casing. Includes products such as pork sausage, pickle or pimiento loaf, meat spread and pate, and products made by binding meat chunks with gelatin or other binders, such as sectioned and formed ham, beef rolls, and headcheese. Excludes plain ground meat, meat loaf and products made by slicing intact muscle or other tissue, even if packaged and marketed like luncheon meat. Index all processes applied to the product at hand; examples: *FULLY HEAT TREATED*, *CURED FOR 2 MONTHS*, *SMOKED*, *FERMENTED*, *EMULSIFIED OR HOMOGENIZED*. Also consider *PARTICLE SIZE IN SOLID FORMED PRODUCTS* and *TYPEOF SAUSAGE CASING* in *Z. ADJUNCT CHARACTERISTICS OF FOOD*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400221 langual:A0221)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400221 "luncheon meat"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400221 "sausage or luncheon meat (us cfr)"@en)
SubClassOf(obo:FOODON_03400221 obo:FOODON_03400150)

# Class: obo:FOODON_03400222 (dessert (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400222 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400222 "Sweetened prepared product usually consumed after the main course in a meal. Excludes fruit or fruit products, bakery products and confectionery."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400222 langual:A0222)
AnnotationAssertion(rdfs:label obo:FOODON_03400222 "dessert (us cfr)"@en)
SubClassOf(obo:FOODON_03400222 obo:FOODON_03400172)

