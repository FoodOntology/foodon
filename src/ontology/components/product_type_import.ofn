AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400802 "Flesh from marine or freshwater fish, molluscs, crustaceans, and other fauna such as reptiles, insects or frogs not in the Meats group.."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400802 langual:A0802)
AnnotationAssertion(rdfs:label obo:FOODON_03400802 "fish or related organism (eurofir)"@en)
