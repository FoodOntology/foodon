AnnotationAssertion(rdfs:label obo:FOODON_03544522 "45220 - other edible ingredients from animal and plant commodities (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544522 obo:FOODON_03544461)

# Class: obo:FOODON_03544523 (45230 - bird nest (edible part) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544523 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544523 "The group includes edible bird's nests harvested for human consumption. In the Asian cuisine bird nests are used as ingredient in soups and drinks (e.g. minuman sarang burung). The part consumed/analysed is not specified. When relevant, information on the part consumed/analysed has to be reported with additional facet descriptors.[https://en.wikipedia.org/wiki/Edible_bird%27s_nest] and [] and [https://www.google.co.uk/search?tbm=isch&q=Edible+bird%27s+nest]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544523 langual:A16PQ)
AnnotationAssertion(rdfs:label obo:FOODON_03544523 "45230 - bird nest (edible part) (efsa foodex2)"@en)
