AnnotationAssertion(rdfs:label obo:FOODON_03400103 "pastry, unsweetened, filled (us cfr)"@en)
SubClassOf(obo:FOODON_03400103 obo:FOODON_03400102)

# Class: obo:FOODON_03400104 (fruit juice or related product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400104 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400104 "Liquid food prepared from fruit (21 CFR 146). Products prepared from fruit juice by thickening with pectin are indexed under *FRUIT JELLY*; those thickened with gelatin are under *FRUIT BUTTER, JELLY, PRESERVE OR RELATED PRODUCT*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400104 langual:A0104)
AnnotationAssertion(rdfs:label obo:FOODON_03400104 "fruit juice or related product (us cfr)"@en)
SubClassOf(obo:FOODON_03400104 obo:FOODON_03400143)

# Class: obo:FOODON_03400105 (dressing, condiment, gravy or sauce (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400105 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400105 "Seasoned product that contains multiple ingredients and that is used in limited amounts to accompany other foods; excludes flavors, spices and herbs."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400105 langual:A0105)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400105 "condiment, dressing, gravy or sauce"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400105 "gravy, condiment, dressing or sauce"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400105 "sauce, condiment, dressing or gravy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400105 "dressing, condiment, gravy or sauce (us cfr)"@en)
SubClassOf(obo:FOODON_03400105 obo:FOODON_03401270)

# Class: obo:FOODON_03400106 (prepared grain or starch product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400106 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400106 "Food product prepared by drying and/or cooking a mixture of milled grain or non-grain starch with a liquid and usually other ingredients such as sweeteners or fats. Includes sweetened and unsweetened bakery products, macaroni or noodle products and breakfast cereals. Excludes *PUDDING, STARCH*, which is under *CUSTARD OR PUDDING*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400106 langual:A0106)
AnnotationAssertion(rdfs:label obo:FOODON_03400106 "prepared grain or starch product (us cfr)"@en)
SubClassOf(obo:FOODON_03400106 obo:FOODON_03400125)

# Class: obo:FOODON_03400107 (bakery product, unsweetened (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400107 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400107 "Includes breads, crackers, pie or pizza crusts and pretzels. Excludes glazed, filled or frosted bakery products, which fall under *BAKERY PRODUCT, SWEETENED* and unsweetened filled products that fall under *PREPARED FOOD PRODUCT WITH BAKERY BASE OR ENCLOSURE, UNSWEETENED* or the appropriate narrower term.  See 21 CFR for description of some subgroups."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400107 langual:A0107)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400107 "crepe, unfilled"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400107 "unfilled crepe"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400107 "unsweetened bakery product"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400107 "bakery product, unsweetened (us cfr)"@en)
SubClassOf(obo:FOODON_03400107 obo:FOODON_03400191)

# Class: obo:FOODON_03400108 (pastry shell, unsweetened (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400108 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400108 langual:A0108)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400108 "puff pastry"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400108 "pastry shell, unsweetened (us cfr)"@en)
SubClassOf(obo:FOODON_03400108 obo:FOODON_03400107)

# Class: obo:FOODON_03400109 (pasteurized process cheese spread (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400109 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400109 "Pasteurized cheese product made with mandatory emulsifier and optional dairy ingredients. Milkfat minimum 20% of total; moisture minimum 44%, maximum 60% (21 CFR 133.179, 133.180)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400109 langual:A0109)
AnnotationAssertion(rdfs:label obo:FOODON_03400109 "pasteurized process cheese spread (us cfr)"@en)
SubClassOf(obo:FOODON_03400109 obo:FOODON_03400117)

# Class: obo:FOODON_03400110 (pasteurized process cheese (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400110 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400110 "Pasteurized cheese product made with mandatory emulsifier and optional milkfat or cream. Milkfat minimum 47% of solids (43% for swiss, 45% for gruyere); moisture maximum 51% (21 CFR 133.169, 133.170, 133.171)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400110 langual:A0110)
AnnotationAssertion(rdfs:label obo:FOODON_03400110 "pasteurized process cheese (us cfr)"@en)
SubClassOf(obo:FOODON_03400110 obo:FOODON_03400117)

# Class: obo:FOODON_03400111 (pasteurized process cheese food (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400111 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400111 "Pasteurized cheese product made with optional emulsifier and optional dairy ingredients. Milkfat minimum 23% of total; moisture maximum 44%."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400111 langual:A0111)
AnnotationAssertion(rdfs:label obo:FOODON_03400111 "pasteurized process cheese food (us cfr)"@en)
SubClassOf(obo:FOODON_03400111 obo:FOODON_03400117)

# Class: obo:FOODON_03400112 (nonalcoholic beverage (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400112 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400112 "Beverage containing no more than 0.5% alcohol; it may be flavored, sweetened or carbonated; includes soft drinks and steeped beverages; excludes milk in all forms, fruit juices, diluted fruit juices and vegetable juices."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400112 langual:A0112)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400112 "malt beverage, nonalcoholic"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400112 "nonalcoholic beverage (us cfr)"@en)
SubClassOf(obo:FOODON_03400112 obo:FOODON_03400229)
SubClassOf(obo:FOODON_03400112 ObjectAllValuesFrom(obo:RO_0002351 obo:FOODON_00002057))

# Class: obo:FOODON_03400113 (spice or herb (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400113 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400113 "Aromatic or pungent plant product used whole or ground as a seasoning in food products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400113 langual:A0113)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400113 "herb or spice"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400113 "spice or herb (us cfr)"@en)
SubClassOf(obo:FOODON_03400113 obo:FOODON_03400133)

# Class: obo:FOODON_03400114 (frozen dairy dessert (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400114 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400114 "A frozen dessert prepared from one or more dairy ingredients or their analogs, plus other ingredients. Includes frozen dairy items offered in a cone, a sandwich or as a cake or pie, such as frozen yogurt in a cone or an ice cream sandwich; these are also indexed under *GRAIN ADDED*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400114 langual:A0114)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400114 "dairy dessert, frozen"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400114 "dessert, frozen dairy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400114 "frozen dairy dessert (us cfr)"@en)
SubClassOf(obo:FOODON_03400114 obo:FOODON_03400164)

# Class: obo:FOODON_03400115 (cheese or cheese product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400115 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400115 "Natural cheese, cured or uncured, cheese product (which is further processed), or cheese product analog."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400115 langual:A0115)
AnnotationAssertion(rdfs:label obo:FOODON_03400115 "cheese or cheese product (us cfr)"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03400115 <https://www.ecfr.gov/cgi-bin/text-idx?node=pt21.2.133>)
SubClassOf(obo:FOODON_03400115 obo:FOODON_03400164)

# Class: obo:FOODON_03400116 (cold-pack cheese product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400116 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400116 "Cheese product made without the aid of heat. See 21 CFR 133.123-125 for lists of cheeses that cannot be used."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400116 langual:A0116)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400116 "cheese product, cold-pack"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400116 "cold-pack cheese product (us cfr)"@en)
SubClassOf(obo:FOODON_03400116 obo:FOODON_03400282)

# Class: obo:FOODON_03400117 (pasteurized cheese product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400117 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400117 "Food prepared by comminuting and mixing, with the aid of heat, one or more natural cheeses, with or without additional ingredients, into a homogeneous plastic mass; the product is packed while hot. See 21 CFR 133.167-180 for lists of cheeses that cannot be used."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400117 langual:A0117)
AnnotationAssertion(rdfs:label obo:FOODON_03400117 "pasteurized cheese product (us cfr)"@en)
SubClassOf(obo:FOODON_03400117 obo:FOODON_03400282)

# Class: obo:FOODON_03400118 (nutritive sweetener (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400118 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400118 "A substance having greater than 2% of the caloric value of sucrose per equivalent unit of sweetening capacity. For example, the amount of such subtance having the sweetening capacity of 1 teaspoon of sucrose would have more than 0.4 calories (21 CFR 170.3(o)(21))."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400118 langual:A0118)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400118 "nutritive carbohydrate sweetener"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400118 "sweetener, nutritive"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400118 "nutritive sweetener (us cfr)"@en)
SubClassOf(obo:FOODON_03400118 obo:FOODON_03400237)

# Class: obo:FOODON_03400120 (neutral distilled spirits (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400120 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400120 "Distilled spirits produced at or above 190 proof and, if bottled, bottled at not less than 80 proof (27 CFR 5.22(a))."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400120 langual:A0120)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400120 "alcohol or neutral spirits"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400120 "neutral spirits or alcohol"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400120 "neutral distilled spirits (us cfr)"@en)
SubClassOf(obo:FOODON_03400120 obo:FOODON_03400277)

# Class: obo:FOODON_03400123 (cream product analog (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400123 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400123 "Food product having functional characteristics similar to a cream product; it may be nutritionally equivalent or inferior to the product it purports to resemble. Includes nondairy coffee whitener and nondairy topping."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400123 langual:A0123)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400123 "cream substitute"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400123 "cream, imitation"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400123 "imitation cream"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400123 "whipped topping"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400123 "cream product analog (us cfr)"@en)
SubClassOf(obo:FOODON_03400123 obo:FOODON_03400147)

# Class: obo:FOODON_03400125 (grain or starch product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400125 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400125 "Any form of whole or milled grain, prepared grain product or starch containing product derived from non-grain sources. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400125 langual:A0125)
AnnotationAssertion(rdfs:label obo:FOODON_03400125 "grain or starch product (us cfr)"@en)
SubClassOf(obo:FOODON_03400125 obo:FOODON_03401270)

# Class: obo:FOODON_03400126 (cold-pack cheese food (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400126 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400126 "Cold-pack cheese product made with other dairy ingredients and without emulsifier. Milkfat minimum 23% of total; moisture maximum 44% (21 CFR 133.124, 133.125)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400126 langual:A0126)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400126 "cheese food, cold-pack"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400126 "cold cheese food"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400126 "cold-pack cheese food (us cfr)"@en)
SubClassOf(obo:FOODON_03400126 obo:FOODON_03400116)

# Class: obo:FOODON_03400127 (fruit juice (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400127 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400127 "The liquid extracted or expressed from mature fruit with or without the application of heat. Includes concentrated juice and single-strength juice. If the single-strength juice is prepared from concentrate, then *WATER ADDED* should be used. Carbonated fruit juices are indexed by *FRUIT JUICE* or *FRUIT JUICE, DILUTED* and *CARBONATED* or the appropriate narrower term."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400127 langual:A0127)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400127 "juice, fruit"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400127 "fruit juice (us cfr)"@en)
SubClassOf(obo:FOODON_03400127 obo:FOODON_03400104)

# Class: obo:FOODON_03400128 (cheese product analog (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400128 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400128 "Food product having functional characteristics similar to those of cheese or cheese product; it may be nutritionally equivalent or inferior to the product it purports to resemble. The ingredients may or may not be milk-based. An example is a cheese-like product made from skim milk and vegetable oil."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400128 langual:A0128)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400128 "cheese substitute"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400128 "cheese, imitation"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400128 "imitation cheese"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400128 "cheese product analog (us cfr)"@en)
SubClassOf(obo:FOODON_03400128 obo:FOODON_03400115)

# Class: obo:FOODON_03400129 (refined or partially-refined food product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400129 obo:IAO_0000428)
