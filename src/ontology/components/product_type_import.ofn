AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400179 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400179 "Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavors of other foods; includes catsup, relish, prepared mustard, prepared horseradish, and condiment sauces."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400179 langual:A0179)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400179 "relish or condiment"@en)
