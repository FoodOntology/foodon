AnnotationAssertion(rdfs:comment obo:FOODON_03400880 "LanguaL curation note: If low alcohol claim, index in facet P. Index in facet B the type of product on which the cordial/syrup is based (i.e. fruit, dairy)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400880 "10000589 - alcoholic cordials/syrups (gs1 gpc)"@en)
SubClassOf(obo:FOODON_03400880 obo:FOODON_03400876)

