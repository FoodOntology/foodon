# Class: obo:FOODON_03544474 (44740 - vitamin a     (retinol, carotenoids) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544474 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544474 "The group includes Vitamin A used for fortification or enrichment of foods. Vitamin A is a group of unsaturated nutritional organic compounds, that includes retinol, retinal, retinoic acid, and several provitamin A carotenoids, among which beta-carotene is the most important] and [https://en.wikipedia.org/wiki/Vitamin_A]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544474 langual:A0EXZ)
AnnotationAssertion(rdfs:label obo:FOODON_03544474 "44740 - vitamin a     (retinol, carotenoids) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544474 obo:FOODON_03544473)

# Class: obo:FOODON_03544475 (44750 - vitamin b1   (thiamine) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544475 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544475 "The group includes Vitamin B1 used for fortification or enrichment of foods. Thiamine or thiamin or vitamin B1, named as the \"thio-vitamine\" (\"sulfur-containing vitamin\") is a water-soluble vitamin of the B complex.[https://en.wikipedia.org/wiki/Vitamin_B1_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544475 langual:A0EXY)
AnnotationAssertion(rdfs:label obo:FOODON_03544475 "44750 - vitamin b1   (thiamine) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544475 obo:FOODON_03544473)

# Class: obo:FOODON_03544476 (44760 - vitamin b2   (riboflavin) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544476 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544476 "The group includes Vitamin B2 used for fortification or enrichment of foods. Riboflavin, also known as vitamin B2, is the vitamin formerly known as G. It is an easily absorbed colored micronutrient with a key role in maintaining health in humans and other animals. Riboflavin is the central component of the cofactors FAD and FMN, and is therefore required by all flavoproteins] and [https://en.wikipedia.org/wiki/Vitamin_B2_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544476 langual:A0EXX)
AnnotationAssertion(rdfs:label obo:FOODON_03544476 "44760 - vitamin b2   (riboflavin) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544476 obo:FOODON_03544473)

# Class: obo:FOODON_03544477 (44770 - vitamin b3   (niacin, niacinamide) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544477 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544477 "The group includes Vitamin B3 used for fortification or enrichment of foods. Niacin (also known as vitamin B3 and nicotinic acid) is an organic compound with the formula C6H5NO2 and is one of the essential human nutrients] and [https://en.wikipedia.org/wiki/Vitamin_B3_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544477 langual:A0EXV)
AnnotationAssertion(rdfs:label obo:FOODON_03544477 "44770 - vitamin b3   (niacin, niacinamide) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544477 obo:FOODON_03544473)

# Class: obo:FOODON_03544478 (44780 - vitamin b5   (pantothenic acid) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544478 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544478 "The group includes Vitamin B5 used for fortification or enrichment of foods. Pantothenic acid, also called pantothenate or vitamin B5 (a B vitamin), is a water-soluble vitamin. For many animals, pantothenic acid is an essential nutrient] and [https://en.wikipedia.org/wiki/Vitamin_B5_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544478 langual:A0EXT)
AnnotationAssertion(rdfs:label obo:FOODON_03544478 "44780 - vitamin b5   (pantothenic acid) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544478 obo:FOODON_03544473)

# Class: obo:FOODON_03544479 (44790 - vitamin b6   (pyridoxine, pyridoxamine, pyridoxal) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544479 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544479 "The group includes Vitamin B6 used for fortification or enrichment of foods. Vitamin B6 is a water-soluble vitamin and is part of the vitamin B complex group. Several forms of the vitamin are known, but pyridoxal phosphate (PLP) is the active form and is a cofactor in many reactions of amino acid metabolism, including transamination, deamination, and decarboxylation. PLP also is necessary for the enzymatic reaction governing the release of glucose from glycogen] and [https://en.wikipedia.org/wiki/Vitamin_B6_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544479 langual:A0EXS)
AnnotationAssertion(rdfs:label obo:FOODON_03544479 "44790 - vitamin b6   (pyridoxine, pyridoxamine, pyridoxal) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544479 obo:FOODON_03544473)

# Class: obo:FOODON_03544480 (44800 - vitamin b7   (biotin) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544480 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544480 "The group includes Vitamin B7 used for fortification or enrichment of foods. Biotin, also known as vitamin H or coenzyme R, is a water-soluble B-vitamin (vitamin B7)] and [https://en.wikipedia.org/wiki/Vitamin_B7_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544480 langual:A0EXR)
AnnotationAssertion(rdfs:label obo:FOODON_03544480 "44800 - vitamin b7   (biotin) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544480 obo:FOODON_03544473)

# Class: obo:FOODON_03544481 (44810 - vitamin b9   (folic acid, folinic acid) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544481 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544481 "The group includes Vitamin B9 used for fortification or enrichment of foods. Folic acid (also known as vitamin M, vitamin B9, vitamin Bc or folacin, pteroyl-L-glutamic acid, and pteroyl-L-glutamate) is a form of the water-soluble vitamin B9. Folate is a naturally occurring form of the vitamin, found in food, while folic acid is synthetically produced, and used in fortified foods and supplements] and [https://en.wikipedia.org/wiki/Vitamin_B9_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544481 langual:A0EXQ)
AnnotationAssertion(rdfs:label obo:FOODON_03544481 "44810 - vitamin b9   (folic acid, folinic acid) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544481 obo:FOODON_03544473)

# Class: obo:FOODON_03544482 (44820 - vitamin b12 (cyanocobalamin, hydroxocobalamin, methylcobalamin) (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544482 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544482 "The group includes Vitamin B12 used for fortification or enrichment of foods. Vitamin B-12, also called cobalamin (cyanocobalamin, hydroxocobalamin, methylcobalamin), is a water-soluble vitamin with a key role in the normal functioning of the brain and nervous system, and for the formation of blood] and [https://en.wikipedia.org/wiki/Vitamin_B12_]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544482 langual:A0EXP)
AnnotationAssertion(rdfs:label obo:FOODON_03544482 "44820 - vitamin b12 (cyanocobalamin, hydroxocobalamin, methylcobalamin) (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544482 obo:FOODON_03544473)

