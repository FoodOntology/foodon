# Class: obo:FOODON_03544518 (45180 - co-factors to metabolism (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544518 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544518 "The group includes ingredients, used in fortified foods and dietary supplements, which influence the metabolism as co-factors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544518 langual:A0F4M)
AnnotationAssertion(rdfs:label obo:FOODON_03544518 "45180 - co-factors to metabolism (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544518 obo:FOODON_03544461)

# Class: obo:FOODON_03544519 (45190 - carnitine (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544519 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544519 "The group includes Carnitine used in fortified foods and dietary supplements. Carnitine is a quaternary ammonium compound biosynthesized from the amino acids lysine and methionine. It is required for the transport of fatty acids from the intermembraneous space in the mitochondria, into the mitochondrial matrix during the breakdown of lipids (fats) for the generation of metabolic energy. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity. ] and [https://en.wikipedia.org/wiki/Carnitine]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544519 langual:A0F4N)
AnnotationAssertion(rdfs:label obo:FOODON_03544519 "45190 - carnitine (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544519 obo:FOODON_03544518)

# Class: obo:FOODON_03544520 (45200 - enzymes for fortification (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544520 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544520 "The group includes Enzymes with biological roles, used in fortified foods and dietary supplements. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544520 langual:A0EVJ)
AnnotationAssertion(rdfs:label obo:FOODON_03544520 "45200 - enzymes for fortification (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544520 obo:FOODON_03544518)

# Class: obo:FOODON_03544521 (45210 - creatine-creatinine (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544521 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544521 "The group includes Creatine-creatinine used in fortified foods and dietary supplements. Creatine is a nitrogenous organic acid that occurs naturally in vertebrates and helps to supply energy to all cells in the body, primarily muscle. This is achieved by increasing the formation of adenosine triphosphate (ATP). The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity. ] and [https://en.wikipedia.org/wiki/Creatinine]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03544521 langual:A0F4P)
AnnotationAssertion(rdfs:label obo:FOODON_03544521 "45210 - creatine-creatinine (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03544521 obo:FOODON_03544518)

# Class: obo:FOODON_03544522 (45220 - other edible ingredients from animal and plant commodities (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03544522 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03544522 "The category covers edible ingredient from animal and plant commodities not mentioned elsewhere."@en)
