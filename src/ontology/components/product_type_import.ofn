AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03401299 "mineral supplement"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03401299 "dietary supplement, mineral"@en)
SubClassOf(obo:FOODON_03401299 obo:FOODON_03401298)

