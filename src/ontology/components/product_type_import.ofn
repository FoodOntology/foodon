AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400206 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400206 "Frozen dessert prepared from nondairy ingredients."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400206 langual:A0206)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400206 "dessert, frozen nondairy"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400206 "nondairy dessert, frozen"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400206 "frozen nondairy dessert (us cfr)"@en)
SubClassOf(obo:FOODON_03400206 obo:FOODON_03400222)

# Class: obo:FOODON_03400208 (salad (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400208 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400208 "A combination of one or more vegetable, fruit, herb, meat, poultry, seafood, egg, cereal or pasta, usually served with some kind of moist dressing; may be molded with a jelling agent. Salad takes precedence over other product types. Examples are egg salad, tuna salad, mixed vegetable salad, jelled fruit salad and macaroni salad."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400208 langual:A0208)
AnnotationAssertion(rdfs:label obo:FOODON_03400208 "salad (us cfr)"@en)
SubClassOf(obo:FOODON_03400208 obo:FOODON_03400172)

# Class: obo:FOODON_03400209 (fruit jelly (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400209 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400209 "Jelled product made from one or more fruit juices and optional ingredients. Includes both fruit jelly, which may be sweetened with nutritive carbohydrate sweeteners, (21 CFR 150.140), and artificially sweetened fruit jelly (21 CFR 150.141). The finished fruit jelly must have a soluble solid content of no less than 65% and the ratio by weight of the fruit ingredient to sweetener in the starting mixture must be no less than 45:55. Artificially sweetened fruit jelly must contain no less than 55% fruit ingredient by weight."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400209 langual:A0209)
AnnotationAssertion(rdfs:label obo:FOODON_03400209 "fruit jelly (us cfr)"@en)
SubClassOf(obo:FOODON_03400209 obo:FOODON_03400155)

