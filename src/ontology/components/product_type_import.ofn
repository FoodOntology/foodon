AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400229 "Alcoholic or nonalcoholic beverage; excludes milk and milk-based beverages, fruit juices and fruit juice drinks, and vegetable juices. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400229 langual:A0229)
AnnotationAssertion(rdfs:label obo:FOODON_03400229 "beverage (us cfr)"@en)
SubClassOf(obo:FOODON_03400229 obo:FOODON_03401270)
