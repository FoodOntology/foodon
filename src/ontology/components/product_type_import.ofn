AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542561 "loligo vulgaris"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542561 "ommastrephes sagittatus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542561 "todarodes pacificus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03542561 "todarodes sagittatus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03542561 "25610 - squids (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03542561 obo:FOODON_03542553)

