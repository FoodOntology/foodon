AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03401306 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03401306 "Yeast, algae, or fungus based dietary supplement."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03401306 langual:A1306)
AnnotationAssertion(rdfs:comment obo:FOODON_03401306 "LanguaL curation note: Use for supplements based on plants, yeast, algae, and fungi (index in facet B).
If the supplement also contains vitamins or minerals use the appropriate descriptor under * DIETARY SUPPLEMENT, COMBINATION*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03401306 "dietary supplement, botanical"@en)
SubClassOf(obo:FOODON_03401306 obo:FOODON_03401298)

# Class: obo:FOODON_03401307 (yeast supplement)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03401307 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03401307 "Nutritional yeast is a source of protein and vitamins, especially the B-complex vitamins and is a complete protein. [http://en.wikipedia.org/wiki/Nutritional_yeast]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03401307 "WIKIPEDIA:Nutritional_yeast")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03401307 langual:A1307)
AnnotationAssertion(rdfs:comment obo:FOODON_03401307 "LanguaL curation note: Currently not used in US classification of dietary supplements."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03401307 "yeast supplement"@en)
SubClassOf(obo:FOODON_03401307 obo:FOODON_03401306)

# Class: obo:FOODON_03401308 (probiotic or bacteria supplement)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03401308 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03401308 "Probiotics are live microorganisms thought to be healthy for the host organism. According to the currently adopted definition by FAO/WHO, probiotics are selected \"live microorganisms which when administered in adequate amounts confer a health benefit on the host\".[FAO/WHO (2001) Health and Nutritional Properties of Probiotics in Food including Powder Milk with Live Lactic Acid Bacteria. Report of a Joint FAO/WHO Expert Consultation on Evaluation of Health and Nutritional Properties of Probiotics in Food Including Powder Milk with Live Lactic Acid Bacteria]  
Lactic acid bacteria (LAB) and bifidobacteria are the most common types of microbes used as probiotics; but also certain yeasts and bacilli are available. [http://en.wikipedia.org/wiki/Probiotics]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03401308 "WIKIPEDIA:Probiotics")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03401308 langual:A1308)
AnnotationAssertion(rdfs:comment obo:FOODON_03401308 "LanguaL curation note: Currently not used in US classification of dietary supplements."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03401308 "probiotic or bacteria supplement"@en)
SubClassOf(obo:FOODON_03401308 obo:FOODON_03401306)
SubClassOf(obo:FOODON_03401308 obo:FOODON_03401309)

# Class: obo:FOODON_03401309 (dietary supplement, metabolite or precursor)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03401309 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03401309 "Includes hormone precursors; steroid precursors; 7-dehydrocholesterol, lutein, omega-3's, CoQ10"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03401309 langual:A1309)
AnnotationAssertion(rdfs:label obo:FOODON_03401309 "dietary supplement, metabolite or precursor"@en)
SubClassOf(obo:FOODON_03401309 obo:FOODON_03401298)

