# Class: obo:FOODON_03400168 (cured cheese (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400168 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400168 "Natural cheese that is cured; includes cheeses that are normally consumed cured but may be sold in an uncured or very lightly cured stage. The classification of cured cheeses is based on the method of curing, the moisture content, and the milk fat content measured as the proportion of solids. Scope notes given for the general classes give moisture and milkfat proportions that cover the entire range specified in the CFR for the individual cheeses included in a class; the class definition given in the CFR section cited may be more restrictive."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400168 langual:A0168)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400168 "cheese, cured"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400168 "cured cheese (us cfr)"@en)
SubClassOf(obo:FOODON_03400168 obo:FOODON_03400187)

# Class: obo:FOODON_03400169 (gelatin dessert (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400169 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400169 "Sweetened product containing gelatin, flavoring and coloring."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400169 langual:A0169)
AnnotationAssertion(rdfs:label obo:FOODON_03400169 "gelatin dessert (us cfr)"@en)
SubClassOf(obo:FOODON_03400169 obo:FOODON_03400222)

# Class: obo:FOODON_03400172 (prepared food product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400172 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400172 "Food product that is 1) ready or nearly ready for consumption; 2) usually a composite of several foods or ingredients that often belong to distinct product types; 3) usually formulated, mixed and partially or fully cooked. Prepared foods often undergo several of the processes listed in *F. EXTENT OF HEAT TREATMENT* and *H. TREATMENT APPLIED*; these factors should be carefully considered in indexing. The classification of prepared food products emphasizes consumption characteristics. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400172 langual:A0172)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400172 "prepared dish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400172 "prepared food product (us cfr)"@en)
SubClassOf(obo:FOODON_03400172 obo:FOODON_03401270)

# Class: obo:FOODON_03400173 (caramel candy (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400173 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400173 "Candy prepared by heating together sugar, corn syrup, fat and cream or milk to 240-250 degrees F."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400173 langual:A0173)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400173 "candy, caramel"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400173 "caramel candy (us cfr)"@en)
SubClassOf(obo:FOODON_03400173 obo:FOODON_03400293)

