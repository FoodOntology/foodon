AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400102 langual:A0102)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400102 "crepe, dinner"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400102 "taco, prepared"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400102 "prepared food product with bakery base or enclosure, unsweetened (us cfr)"@en)
SubClassOf(obo:FOODON_03400102 obo:FOODON_03400172)

