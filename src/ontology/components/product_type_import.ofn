# Class: obo:FOODON_03400100 (pie, unsweetened, or pizza (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400100 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400100 langual:A0100)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400100 "pizza pie"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03400100 "LanguaL curation note: Used only for unsweetened products; sweetened pies are indexed under *PIE, SWEETENED*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400100 "pie, unsweetened, or pizza (us cfr)"@en)
SubClassOf(obo:FOODON_03400100 obo:FOODON_03400102)

# Class: obo:FOODON_03400101 (cultured milk product (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400101 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400101 "Milk modified by adding acid-producing and/or flavor-producing bacteria under controlled conditions."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400101 langual:A0101)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400101 "milk product, cultured"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400101 "cultured milk product (us cfr)"@en)
SubClassOf(obo:FOODON_03400101 obo:FOODON_03400148)

