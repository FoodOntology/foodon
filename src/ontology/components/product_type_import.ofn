# Class: obo:FOODON_03542213 (22130 - freshwater fish (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03542213 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03542213 "The group includes any type of Freshwater fish (ISSCAAP division 1), i.e. fish that generally remains life long, including the spawning period, in fresh water (lakes, ponds, rivers and brooks). Several species of freshwater fish are domesticated and bred in fish farms.[https://en.wikipedia.org/wiki/Freshwater_fish] and [https://www.google.co.uk/search?tbm=isch&q=Freshwater fish]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03542213 langual:A026X)
AnnotationAssertion(rdfs:label obo:FOODON_03542213 "22130 - freshwater fish (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03542213 obo:FOODON_03542212)

