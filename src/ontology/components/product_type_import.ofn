AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400227 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400227 "Ice cream, in comparison with frozen custard, contains less than 1.4% egg yolk solids by weight of the finished product (21 CFR 135.110(a))."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400227 langual:A0227)
AnnotationAssertion(rdfs:label obo:FOODON_03400227 "ice cream (us cfr)"@en)
SubClassOf(obo:FOODON_03400227 obo:FOODON_03400137)

# Class: obo:FOODON_03400228 (snack food (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400228 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400228 "Unsweetened food product marketed for consumption between meals; excludes nuts, edible seeds, and sweetened products such as cakes, puddings and candies. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400228 langual:A0228)
AnnotationAssertion(rdfs:label obo:FOODON_03400228 "snack food (us cfr)"@en)
SubClassOf(obo:FOODON_03400228 obo:FOODON_03401270)

