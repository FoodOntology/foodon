# Class: obo:FOODON_03543066 (30660 - loukoumi (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543066 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543066 "The group includes any type of Loukoumi, also known as Lokum or Turkish deligh, i.e. confections with a jelly texture made mainly from starch or gelatine, sugar and other ingredients such as chopped dates, pistachios and other nuts. They are often packaged and eaten in small cubes dusted with icing sugar or other edible powders and with different flavourings. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Loukoumi] and [https://www.google.co.uk/search?tbm=isch&q=Loukoumi]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543066 langual:A0FDG)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543066 "lokum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543066 "turkish delight"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543066 "30660 - loukoumi (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543066 obo:FOODON_03543058)

# Class: obo:FOODON_03543067 (30670 - quince cheese (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03543067 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03543067 "The group includes any type of Quince cheese, also known as Cotognata, Birsalmasajt or Dulce de membrillo, i.e. a confection made by slowly cooking quince fruits with sugar and water until dense and grainy texture. It is sold in squares or wedges and it can be cut into slices and spread over bread, eaten plain or with cheese. It is also used to stuff pastries.[https://en.wikipedia.org/wiki/Quince_cheese] and [https://www.google.co.uk/search?tbm=isch&q=Quince cheese]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03543067 langual:A0FDH)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543067 "birsalmasajt"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543067 "cotognata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03543067 "dulce de membrillo"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03543067 "30670 - quince cheese (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03543067 obo:FOODON_03543058)

