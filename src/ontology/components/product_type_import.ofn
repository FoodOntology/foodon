AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400182 "imitation milk"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400182 "milk analog (us cfr)"@en)
SubClassOf(obo:FOODON_03400182 obo:FOODON_03400147)

# Class: obo:FOODON_03400183 (quick bread, sweetened (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400183 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400183 "Chemically leavened sweetened bakery product that may contain other ingredients such as fruits, nuts or that may be filled."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400183 langual:A0183)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400183 "fruit bread"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400183 "nut bread"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400183 "quick bread, sweetened (us cfr)"@en)
SubClassOf(obo:FOODON_03400183 obo:FOODON_03400135)

# Class: obo:FOODON_03400184 (fruit butter (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400184 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400184 "Smooth semisolid fruit product prepared from a mixture of one or more fruit ingredients and specified optional ingredients. Skins, seeds, pits, and cores are screened out. Nutritive carbohydrate sweetener may be used, but the starting mixture of optional ingredients must contain at least five parts by weight of the fruit ingredient to each two parts by weight of the nutritive carbohydrate sweetener.  The soluble content of the finished fruit butter is not less than 43% solids (21 CFR 150.110)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400184 langual:A0184)
AnnotationAssertion(rdfs:label obo:FOODON_03400184 "fruit butter (us cfr)"@en)
SubClassOf(obo:FOODON_03400184 obo:FOODON_03400155)

# Class: obo:FOODON_03400185 (uncured cheese (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400185 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400185 "Natural cheese that is not cured or is cured for less than 7 days. It may undergo some further processing, such as creaming. It is consumed fresh and has a mild acid flavor. Moisture max. 80%. Includes such products as cottage cheese, cream cheese and mozzarella cheese."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400185 langual:A0185)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03400185 "soft cheese"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400185 "uncured cheese (us cfr)"@en)
SubClassOf(obo:FOODON_03400185 obo:FOODON_03400187)

# Class: obo:FOODON_03400186 (hard cheese (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400186 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400186 "Cured cheese ripened by bacteria."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400186 langual:A0186)
AnnotationAssertion(rdfs:comment obo:FOODON_03400186 "LanguaL curation note: Used for cheeses, which contain not more than 39 percent of moisture, and their solids contain not less than 50 percent of milkfat [21 CFR Ch. I (4-1-99 Edition)]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03400186 "hard cheese (us cfr)"@en)
SubClassOf(obo:FOODON_03400186 obo:FOODON_03400316)

# Class: obo:FOODON_03400187 (natural cheese (us cfr))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03400187 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03400187 "Cheese made from milk or milk components, such as cream, by the following process: (1) produce curd through coagulation of milk by bacterial action and/or enzymes and/or acidification and draining of whey. (2) For cured cheese only: cure the curd. Excludes products made through further processing, such as comminuting (see *CHEESE PRODUCT*)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03400187 langual:A0187)
AnnotationAssertion(rdfs:label obo:FOODON_03400187 "natural cheese (us cfr)"@en)
SubClassOf(obo:FOODON_03400187 obo:FOODON_03400115)

