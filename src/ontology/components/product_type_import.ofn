SubClassOf(obo:FOODON_03540174 obo:FOODON_03540001)

# Class: obo:FOODON_03540175 (01750 - pasta and similar products (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540175 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540175 "The category includes any type of pasta and similar products, otherwise known in some regions under the name of noodles. By default it is not defined if the food items belonging to this group are cooked or not; therefore in case of cooked products (e.g. boiled pasta), the cooking method should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Pasta] and [https://www.google.co.uk/search?tbm=isch&q=Pasta raw]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540175 langual:A007D)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03540175 "noodles"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03540175 "01750 - pasta and similar products (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540175 obo:FOODON_03540174)

# Class: obo:FOODON_03540176 (01760 - pasta, plain (not stuffed), uncooked (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540176 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540176 "The group includes any type of plain pasta (i.e. not stuffed). By default it is not defined if the food items belonging to this group are cooked or not; therefore in case of cooked products (e.g. boiled pasta), the cooking method should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Pasta] and [https://www.google.co.uk/search?tbm=isch&q=Pasta wholemeal uncooked]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540176 langual:A007E)
AnnotationAssertion(rdfs:label obo:FOODON_03540176 "01760 - pasta, plain (not stuffed), uncooked (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540176 obo:FOODON_03540175)

# Class: obo:FOODON_03540177 (01770 - pasta wholemeal (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540177 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540177 "The group includes any type of wholemeal pasta; however, in case it is known if the wholemeal pasta is fresh or dried and with or without eggs the other more specific terms available in FoodEx2 should be used and 'wholemeal' should be added as facet descriptor. By default it is not defined if the food items belonging to this group are cooked or not; therefore in case of cooked products (e.g. boiled pasta), the cooking method should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Pasta] and [https://www.google.co.uk/search?tbm=isch&q=Pasta+wholemeal]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03540177 langual:A04LC)
AnnotationAssertion(rdfs:label obo:FOODON_03540177 "01770 - pasta wholemeal (efsa foodex2)"@en)
SubClassOf(obo:FOODON_03540177 obo:FOODON_03540176)

# Class: obo:FOODON_03540178 (01780 - fresh pasta (efsa foodex2))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03540178 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03540178 "The group includes any type of Fresh pasta (i.e. not dried, normally needing refrigeration). By default it is not defined if the food items belonging to this group are cooked or not; therefore in case of cooked products (e.g. boiled pasta), the cooking method should be reported with additional facet descriptors. The part consumed/analysed is by default the whole or a portion of it representing the observed heterogeneity.[https://en.wikipedia.org/wiki/Pasta] and [https://www.google.co.uk/search?tbm=isch&q=Fresh+pasta]"@en)
