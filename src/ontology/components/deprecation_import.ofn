AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414465 langual:B4465)
AnnotationAssertion(rdfs:label obo:FOODON_03414465 "obsolete: chordate"@en)
AnnotationAssertion(owl:deprecated obo:FOODON_03414465 "true"^^xsd:boolean)

