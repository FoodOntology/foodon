AnnotationAssertion(rdfs:label obo:FOODON_00002591 "Merlot grape cultivar"@en)
SubClassOf(obo:FOODON_00002591 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002592 (Pinot blanc wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002592 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002592 "A pinot blanc wine is any wine produced using only Pinco blanc grapes."@en)
