AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002577 "A grape wine distinguished by the region its grapes were grown in."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002577 "wine by region"@en)
SubClassOf(obo:FOODON_00002577 obo:FOODON_03301014)

# Class: obo:FOODON_00002583 (Chardonnay grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002583 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002583 "The Chardonnay grape cultivar is the result of a cross between the Pinot noir and Gouais blanc (Heunisch) grape varieties. It produces a green-skinned grape variety used in the production of white wine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002583 wikipedia:Chardonnay)
AnnotationAssertion(rdfs:label obo:FOODON_00002583 "Chardonnay grape cultivar"@en)
SubClassOf(obo:FOODON_00002583 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002584 (Chardonnay wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002584 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002584 "Chardonnay wine is wine produced using only Chardonnay grapes."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002584 wikipedia:Chardonnay)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002584 <https://orcid.org/0000-0002-1107-9135>)
AnnotationAssertion(rdfs:label obo:FOODON_00002584 "Chardonnay wine"@en)
SubClassOf(obo:FOODON_00002584 obo:FOODON_03310273)
SubClassOf(obo:FOODON_00002584 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002583))

# Class: obo:FOODON_00002585 (Cabernet Sauvignon wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002585 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002585 "A Cabernet Sauvignon wine is any wine produced using only Cabernet Sauvignon grapes. It often appears with Merlot and Cabernet Franc in blended Bordeaux wines."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002585 wikipedia:Cabernet_Sauvignon)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002585 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002585 "Cabernet Sauvignon wine"@en)
SubClassOf(obo:FOODON_00002585 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002585 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002640))

# Class: obo:FOODON_00002586 (Chenin blanc wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002586 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002586 "A Chenin blanc wine is any wine produced using only Chenin blanc grapes."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002586 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(rdfs:label obo:FOODON_00002586 "Chenin blanc wine"@en)
