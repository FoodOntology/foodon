# Class: obo:FOODON_00002593 (Pinot blanc grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002593 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002593 "Pinot blanc is a white wine grape. It is a point genetic mutation of Pinot noir."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002593 wikipedia:Pinot_blanc)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002593 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(schema:image obo:FOODON_00002593 <https://upload.wikimedia.org/wikipedia/commons/thumb/b/b3/Pinot-blanc.jpg/440px-Pinot-blanc.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002593 "Pinot blanc grape cultivar"@en)
SubClassOf(obo:FOODON_00002593 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002594 (Pinot gris wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002594 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002594 "Pinot gris is a white wine varietal produced only from Pinot gris grapes.  The Italian synonym, Pinot Grigio, has become strongly associated with lighter wines produced in great quantities, particularly in northern Italy."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002594 <https://www.wine-searcher.com/grape-381-pinot-grigio>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002594 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002594 <https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Alto_adige_Pinot_grigio.jpg/179px-Alto_adige_Pinot_grigio.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002594 "Pinot gris wine"@en)
SubClassOf(obo:FOODON_00002594 obo:FOODON_03310273)
SubClassOf(obo:FOODON_00002594 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002595))

# Class: obo:FOODON_00002595 (Pinot gris grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002595 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002595 "Pinot gris is a white wine grape variety (mutation) of the Pinot family which shares its genetic fingerprint with Pinot Noir, Pinot Blanc et al. . Pinot gris is grown around the globe with the \"spicy\" full-bodied Alsatian and lighter-bodied, more acidic Italian styles being most widely recognized."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002595 wikipedia:Pinot_gris)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002595 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002595 <https://commons.wikimedia.org/wiki/File:Pinot_Gris_close.JPG>)
AnnotationAssertion(rdfs:label obo:FOODON_00002595 "Pinot gris grape cultivar"@en)
SubClassOf(obo:FOODON_00002595 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002596 (Pinot noir wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002596 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002596 "Pinot noir wine is a red wine varietal made only from Pinot noir grapes.  The thin skins and low levels of phenolic compounds lends pinot to producing mostly lightly colored, medium-bodied and low-tannin wines that can often go through phases of uneven and unpredictable aging."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002596 wikipedia:Pinot_noir)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002596 <https://orcid.org/0009-0006-7774-1546l>)
AnnotationAssertion(rdfs:label obo:FOODON_00002596 "Pinot noir wine"@en)
SubClassOf(obo:FOODON_00002596 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002596 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002597))

# Class: obo:FOODON_00002597 (Pinot noir grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002597 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002597 "Pinot noir grape is a red wine grape variety. The name is derived from the French words for pine and black. The word pine alludes to the grape variety having tightly clustered, pine cone-shaped bunches of fruit. Pinot noir grapes are grown around the world, mostly in the cooler climates, and the grape is chiefly associated with the Burgundy region of France."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002597 wikipedia:Pinot_noir)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002597 <https://orcid.org/0009-0006-7774-1546l>)
AnnotationAssertion(schema:image obo:FOODON_00002597 <https://en.wikipedia.org/wiki/Pinot_noir#/media/File:Grape_near_Sancerre.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002597 "Pinot noir grape cultivar"@en)
SubClassOf(obo:FOODON_00002597 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002598 (Pinotage wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002598 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002598 "Pinotage wine is a red wine varietal produced only from Pinotage grapes. This type of wine can range from a fairly cheap, light-bodied red wine with some funky aromas (including extremes such as acetone, paint, rubber, and at times banana) all the way to full-bodied red wines with balance, elegance, fully developed black fruit flavors, and an enduring, sweet, smokey finish."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002598 <https://www.thespruceeats.com/what-is-pinotage-wine-3511226>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002598 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002598 <https://upload.wikimedia.org/wikipedia/commons/thumb/e/e4/Stellenbosch_Pinotage.jpg/179px-Stellenbosch_Pinotage.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002598 "Pinotage wine"@en)
SubClassOf(obo:FOODON_00002598 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002598 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002599))

# Class: obo:FOODON_00002599 (Pinotage grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002599 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002599 "Pinotage is a red wine grape that is South Africa's signature variety. It was bred there in 1925 as a crossbetween Pinot noir and Cinsaut. The grape is a viticultural intraspecific cross of two varieties of Vitis vinifera, not an interspecific hybrid."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002599 wikipedia:Pinotage)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002599 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002599 <https://i2.wp.com/www.winetwofive.com/wp-content/uploads/2018/06/CEP-TIBOUREN.jpg?resize=128%2C128>)
AnnotationAssertion(rdfs:label obo:FOODON_00002599 "Pinotage grape cultivar"@en)
SubClassOf(obo:FOODON_00002599 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002600 (Reserve wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002600 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002600 "Reserve wine is wine of a higher quality than usual, or a wine that has been aged before being sold, or both. Traditionally, winemakers would reserve some of their best wine rather than sell it immediately, coining the term."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002600 wikipedia:Reserve_wine)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002600 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002600 "Reserve wine"@en)
SubClassOf(obo:FOODON_00002600 obo:FOODON_03301014)

# Class: obo:FOODON_00002601 (Riesling wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002601 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002601 "Riesling wine is a white wine varietal produced only from Riesling grapes, and offered as dry, semi-sweet, sweet, and sparkling white wines. Riesling wines are usually varietally pure and are seldom oaked."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002601 wikipedia:Riesling)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002601 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002601 <https://upload.wikimedia.org/wikipedia/commons/thumb/9/96/Alsatian_Riesling_.jpg/179px-Alsatian_Riesling_.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002601 "Riesling wine"@en)
SubClassOf(obo:FOODON_00002601 obo:FOODON_03310273)
SubClassOf(obo:FOODON_00002601 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002602))

# Class: obo:FOODON_00002602 (Riesling grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002602 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002602 "Riesling grape is an aromatic white grape variety displaying flowery, almost perfumed, aromas as well as high acidity."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002602 wikipedia:Riesling)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002602 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002602 <https://upload.wikimedia.org/wikipedia/commons/thumb/7/76/Riesling_grapes_leaves.jpg/320px-Riesling_grapes_leaves.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002602 "Riesling grape cultivar"@en)
SubClassOf(obo:FOODON_00002602 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002603 (Sangiovese wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002603 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002603 "Sangiovese wine is a red wine varietal produced only from Sangiovese grapes. It is prized for its high acid, firm tannins and balanced nature. Savory flavors of dark cherries and black stonefruit are characteristic, and may be backed by secondary notes of tomato leaf and dried herbs."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002603 <https://www.wine-searcher.com/grape-432-sangiovese>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002603 <https://orcid.org/0000-0002-5439-3570>)
