AnnotationAssertion(dcterms:contributor obo:FOODON_03310272 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:comment obo:FOODON_03310272 "The actual color of the wine can range from intense violet, typical of young wines, through to brick red for mature wines and brown for older red wines.\"[https://en.wikipedia.org/wiki/Red_wine]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03310272 "red wine"@en)
SubClassOf(obo:FOODON_03310272 obo:FOODON_03301014)
SubClassOf(obo:FOODON_03310272 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00003778))

# Class: obo:FOODON_03310273 (white wine)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03310273 "A wine that is fermented with little or no grape skin contact."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03310273 wikipedia:White_wine)
AnnotationAssertion(dcterms:contributor obo:FOODON_03310273 <https://orcid.org/0000-0002-1816-4260>)
AnnotationAssertion(dcterms:contributor obo:FOODON_03310273 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:comment obo:FOODON_03310273 "A wine whose color can be straw-yellow, yellow-green, or yellow-gold. It is produced by the alcoholic fermentation of the non-coloured pulp of grapes, which may have a skin of any colour."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03310273 "white wine"@en)
SubClassOf(obo:FOODON_03310273 obo:FOODON_03301014)
SubClassOf(obo:FOODON_03310273 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00003777))

# Class: obo:FOODON_03310734 (rosé wine)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03310734 "A type of grape wine that incorporates some of the color from the grape skins, but not enough to qualify it as a red wine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03310734 <https://en.wikipedia.org/wiki/Ros%C3%A9>)
AnnotationAssertion(rdfs:label obo:FOODON_03310734 "rosé wine"@en)
SubClassOf(obo:FOODON_03310734 obo:FOODON_03301014)

