SubClassOf(obo:FOODON_00002586 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002587))

# Class: obo:FOODON_00002587 (Chenin blanc grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002587 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002587 "Chenin blanc grapes are a White wine grape variety from the Loire Valley of France. Its high acidity means it can be used to make everything from sparkling wines to well-balanced dessert wines, although it can produce very bland, neutral wines if the vine's natural vigor is not controlled."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002587 wikipedia:Chenin_blanc)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002587 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(rdfs:label obo:FOODON_00002587 "Chenin blanc grape cultivar"@en)
SubClassOf(obo:FOODON_00002587 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002588 (Malbec wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002588 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002588 "A Malbec wine is any wine produced using only Malbec grapes."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002588 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(rdfs:label obo:FOODON_00002588 "Malbec wine"@en)
SubClassOf(obo:FOODON_00002588 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002588 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002589))

# Class: obo:FOODON_00002589 (Malbec grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002589 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002589 "Malbec grapes are a purple grape variety used in making red wine. The grapes tend to have an inky dark color and robust tannins, and are known as one of the six grapes allowed in the blend of red Bordeaux wine. The French plantations of Malbec are now found primarily in Cahors in South West France. It is increasingly celebrated as an Argentine varietal wine and is being grown around the world."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002589 wikipedia:Malbec)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002589 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(rdfs:label obo:FOODON_00002589 "Malbec grape cultivar"@en)
SubClassOf(obo:FOODON_00002589 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002590 (Merlot wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002590 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002590 "A Merlot wine is any wine produced using only Merlot grapes."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002590 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(rdfs:label obo:FOODON_00002590 "Merlot wine"@en)
SubClassOf(obo:FOODON_00002590 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002590 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002591))

# Class: obo:FOODON_00002591 (Merlot grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002591 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002591 "Merlot is a dark blue-colored wine grape variety, that is used as both a blending grape and for varietal wines."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002591 wikipedia:Merlot)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002591 <https://orcid.org/0000-0001-7751-1042>)
