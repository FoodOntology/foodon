# Class: obo:FOODON_03311270 (Beaujolais wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03311270 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03311270 "A French Appellation d'Origine Contrôlée (AOC) wine generally made of the Gamay grape which has a thin skin and is low in tannins."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03311270 wikipedia:Beaujolais)
AnnotationAssertion(dcterms:contributor obo:FOODON_03311270 <https://orcid.org/0000-0002-8844-9165>)
