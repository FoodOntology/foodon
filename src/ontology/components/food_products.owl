# Class: obo:FOODON_00002631 (tagliatelle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002631 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002631 "Tagliatelle is a traditional type of egg pasta from the Emilia-Romagna and Marche regions of Italy. Individual pieces of tagliatelle are long, flat ribbons that are similar in shape to fettuccine and are typically about 6.5 to 10 mm (0.26 to 0.39 in) wide."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002631 wikipedia:Tagliatelle)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002631 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002631 <https://upload.wikimedia.org/wikipedia/commons/thumb/0/02/Tagliatelles2.jpg/312px-Tagliatelles2.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002631 "tagliatelle"@en)
SubClassOf(obo:FOODON_00002631 obo:FOODON_00001211)

# Class: obo:FOODON_00002632 (tortellini)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002632 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002632 "Tortellini are ring-shaped pasta, sometimes also described as \"navel shaped\", hence their alternative name of \"belly button\" (ombelico). They are typically stuffed with a mix of meat (pork loin, raw prosciutto, Mortadella), and Parmigiano Reggiano cheese."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002632 wikipedia:Tortellini)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002632 <https://orcid.org/0000-0002-5439-3570>)
AnnotationAssertion(schema:image obo:FOODON_00002632 <https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/Tortellini_Bolognesi.jpg/320px-Tortellini_Bolognesi.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002632 "tortellini"@en)
SubClassOf(obo:FOODON_00002632 obo:FOODON_00001211)

# Class: obo:FOODON_00002633 (tortelloni)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002633 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002633 "Tortelloni are stuffed pasta, the same shape as tortellini, but larger. They are usually stuffed with ricotta cheese and leaf vegetables, such as spinach."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002633 wikipedia:Tortelloni)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002633 <https://orcid.org/0009-0006-7774-1546>)
AnnotationAssertion(schema:image obo:FOODON_00002633 <https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Tortelloni_tomato_sauce1.JPG/275px-Tortelloni_tomato_sauce1.JPG>)
AnnotationAssertion(rdfs:label obo:FOODON_00002633 "tortelloni"@en)
SubClassOf(obo:FOODON_00002633 obo:FOODON_00001211)

# Class: obo:FOODON_00002634 (tortiglioni)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002634 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002634 "Tortiglioni are a type of pasta, similar to rigatoni but larger and with deeper grooves which spiral around the pasta."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002634 wikipedia:Tortiglioni)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002634 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(schema:image obo:FOODON_00002634 <https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/Tortiglioni_closeup.png/320px-Tortiglioni_closeup.png>)
AnnotationAssertion(rdfs:label obo:FOODON_00002634 "tortiglioni"@en)
SubClassOf(obo:FOODON_00002634 obo:FOODON_00001211)

# Class: obo:FOODON_00002635 (fusilli)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002635 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002635 "Fusilli are a variety of pasta that are formed into corkscrew or helical shapes. The word fusilli presumably comes from fuso (\"spindle\"), as traditionally it is \"spun\" by pressing and rolling a small rod over the thin strips of pasta to wind them around it in a corkscrew shape."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002635 wikipedia:Fusilli)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002635 <https://orcid.org/0009-0006-7774-1546>)
AnnotationAssertion(schema:image obo:FOODON_00002635 <https://en.wikipedia.org/wiki/Fusilli#/media/File:Fusilli.png>)
AnnotationAssertion(rdfs:label obo:FOODON_00002635 "fusilli"@en)
SubClassOf(obo:FOODON_00002635 obo:FOODON_00001211)

# Class: obo:FOODON_00002636 (conchiglie)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002636 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002636 "Conchiglie, commonly known as \"shells\" or \"seashells\" is a type of pasta. It is usually sold in the plain durum wheat variety. The shell shape of the pasta allows the sauce to adhere to it."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002636 wikipedia:Conchiglie)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002636 <https://orcid.org/0000-0002-1107-9135>)
AnnotationAssertion(schema:image obo:FOODON_00002636 <https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Conchiglie_rigate.png/320px-Conchiglie_rigate.png>)
AnnotationAssertion(rdfs:label obo:FOODON_00002636 "conchiglie"@en)
SubClassOf(obo:FOODON_00002636 obo:FOODON_00001211)

# Class: obo:FOODON_00002637 (linguine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002637 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002637 "Linguine is a type of pasta similar to fettuccine and trenette but elliptical in section rather than flat. It is about 4 millimetres in width, which is wider than spaghetti but not as wide as fettuccine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002637 wikipedia:Linguine)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002637 <https://orcid.org/0000-0001-7751-1042>)
AnnotationAssertion(schema:image obo:FOODON_00002637 <https://en.wikipedia.org/wiki/Linguine#/media/File:Linguine.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002637 "linguine"@en)
SubClassOf(obo:FOODON_00002637 obo:FOODON_00001211)

# Class: obo:FOODON_00002638 (penne)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002638 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002638 "Penne is an extruded type of pasta with cylinder-shaped pieces, their ends cut at a bias. It is lexically related to Latin penna (meaning \"feather\" or \"quill\"), and was originally intended to imitate the then-ubiquitous fountain pen's steel nibs."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002638 wikipedia:Penne)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002638 <https://orcid.org/0000-0002-1107-9135>)
AnnotationAssertion(schema:image obo:FOODON_00002638 <https://en.wikipedia.org/wiki/Penne#/media/File:Pennelisce_closeup.png>)
AnnotationAssertion(rdfs:label obo:FOODON_00002638 "penne"@en)
SubClassOf(obo:FOODON_00002638 obo:FOODON_00001211)

# Class: obo:FOODON_00002639 (Zakynthos wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002639 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002639 "Zakynthos Wine is wine produced on the Greek island of Zakynthos (Zante) in the Ionian Sea. A wide array of native Ionian grape varieties have been planted on the island for centuries, and are most famously used to make the intensely flavored, highly acidic Verdea wine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002639 <https://www.wine-searcher.com/regions-zakynthos>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002639 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002639 "Zakynthos wine"@en)
SubClassOf(obo:FOODON_00002639 obo:FOODON_00002577)

# Class: obo:FOODON_00002640 (Cabernet Sauvignon grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002640 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002640 "The Cabernet Sauvignon grape cultivar originates from a cross between Cabernet Franc and Sauvignon blanc varieties. It produces Cabernet Sauvignon grapes, a red wine grape variety."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002640 wikipedia:Cabernet_Sauvignon)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002640 <https://orcid.org/0000-0002-1107-9135>)
AnnotationAssertion(rdfs:label obo:FOODON_00002640 "Cabernet Sauvignon grape cultivar"@en)
SubClassOf(obo:FOODON_00002640 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002641 (Bordeaux wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002641 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002641 "Any wine produced in the Bordeaux region of southwest France."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002641 wikipedia:Bordeaux_wine)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002641 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002641 "Bordeaux wine"@en)
SubClassOf(obo:FOODON_00002641 obo:FOODON_00002577)

# Class: obo:FOODON_00002831 (cannelloni)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002831 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002831 "Cannelloni are a cylindrical type of lasagna generally served baked with a filling and covered by a sauce in Italian cuisine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002831 wikipedia:Cannelloni)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002831 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(schema:image obo:FOODON_00002831 <https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Cannelloni2.png/320px-Cannelloni2.png>)
AnnotationAssertion(rdfs:label obo:FOODON_00002831 "cannelloni"@en)
SubClassOf(obo:FOODON_00002831 obo:FOODON_00001211)

# Class: obo:FOODON_00002863 (Blaufränkisch grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002863 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002863 "Blaufränkisch (German for blue Frankish) is a dark-skinned variety of grape used for red wine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002863 <https://en.wikipedia.org/wiki/Blaufr%C3%A4nkisch>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002863 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002863 "Blaufränkisch grape cultivar"@en)
SubClassOf(obo:FOODON_00002863 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002864 (Blaufränkisch wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002864 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002864 "A red wine varietal produced entirely from Blaufränkisch grapes."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002864 <https://en.wikipedia.org/wiki/Blaufr%C3%A4nkisch>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002864 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002864 "Blaufränkisch wine"@en)
SubClassOf(obo:FOODON_00002864 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002864 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002863))

# Class: obo:FOODON_00002868 (Mourvèdre grape cultivar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002868 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002868 "A red wine grape cultivar variety that is grown in many regions around the world including the Rhône and Provence regions of France, the Valencia and Jumilla denominaciones de origen of Spain, as well as the Balearic Islands, California and Washington and the Australian regions of South Australia and New South Wales, as well as South Africa."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002868 <https://en.wikipedia.org/wiki/Mourv%C3%A8dre>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002868 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(schema:image obo:FOODON_00002868 <https://upload.wikimedia.org/wikipedia/commons/thumb/c/c6/Balzac_noir-mourvedre.jpg/451px-Balzac_noir-mourvedre.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00002868 "Mourvèdre grape cultivar"@en)
SubClassOf(obo:FOODON_00002868 obo:NCBITaxon_29760)

# Class: obo:FOODON_00002869 (Mourvèdre wine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002869 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002869 <https://en.wikipedia.org/wiki/Mourv%C3%A8dre>)
AnnotationAssertion(dcterms:contributor obo:FOODON_00002869 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(rdfs:label obo:FOODON_00002869 "Mourvèdre wine"@en)
SubClassOf(obo:FOODON_00002869 obo:FOODON_03310272)
SubClassOf(obo:FOODON_00002869 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_00002868))

# Class: obo:FOODON_00004039 (destemmed grape must)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004039 "A grape berry food product which results from crushing whole (destemmed) grapes and which contains grape juice and components of grape pomace."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004039 "destemmed grape must"@en)
SubClassOf(obo:FOODON_00004039 obo:FOODON_00001071)

# Class: obo:FOODON_00004044 (free-run grape juice)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004044 "Grape juice which has been extracted through the process of crushing, the natural break down of the grape cell walls during maceration or fermentation, and/or by the weight of grapes within a tall container."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004044 <https://en.wikipedia.org/wiki/Pressing_(wine)#Free-run_versus_pressed_juice>)
AnnotationAssertion(rdfs:label obo:FOODON_00004044 "free-run grape juice"@en)
SubClassOf(obo:FOODON_00004044 obo:FOODON_00001162)

# Class: obo:FOODON_00004045 (pressed grape juice)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004045 "Grape juice which is extracted from grapes using a grape pressing process."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004045 <https://en.wikipedia.org/wiki/Pressing_(wine)#Free-run_versus_pressed_juice>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004045 "Pressed juice often has lower acidity levels, higher potassium and pH level, more phenolic compounds such as tannins and more suspended solids such as natural gum and proteins. [wikipedia:Pressing_(wine)#Free-run_versus_pressed_juice]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004045 "pressed grape juice"@en)
SubClassOf(obo:FOODON_00004045 obo:FOODON_00001162)

# Class: obo:FOODON_00004046 (grape pomace)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004046 "The solid remains of grapes after crushing or pressing, typically containing pulp, skins, stems, and seeds."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004046 wikipedia:Pomace)
AnnotationAssertion(rdfs:comment obo:FOODON_00004046 "Grape pomace contains the skins, pulp, seeds, and stems of the fruit, and has traditionally been used to produce pomace brandy.\"     [https://en.wikipedia.org/wiki/Pomace]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004046 "grape pomace"@en)
SubClassOf(obo:FOODON_00004046 obo:FOODON_00001162)

# Class: obo:FOODON_00004048 (table wine (US))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004048 "A grape wine which is neither fortified, nor sparkling, nor expensive."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004048 wikipedia:Table_wine)
AnnotationAssertion(rdfs:label obo:FOODON_00004048 "table wine (US)"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004048 <https://www.ecfr.gov/current/title-27/part-4#p-4.21(a)(5)>)
SubClassOf(obo:FOODON_00004048 obo:FOODON_03301014)

# Class: obo:FOODON_00004049 (Quality Wines Produced in Specified Regions)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004049 "A Protected Geographical Status appellation which identifies a wine with either Protected Geographical Indication or a Protected Designation of Origin."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004049 wikipedia:Quality_Wines_Produced_in_Specified_Regions)
AnnotationAssertion(rdfs:comment obo:FOODON_00004049 "The European Union regulates and defines the status of \"quality wines\" according to production method, management and geographical location. Its original, fundamental role is in differentiating quality wines from table wines.\"[https://en.wikipedia.org/wiki/Quality_Wines_Produced_in_Specified_Regions]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004049 "Quality Wines Produced in Specified Regions"@en)
SubClassOf(obo:FOODON_00004049 obo:FOODON_03530254)

# Class: obo:FOODON_00004050 (rosé wine must)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004050 "A grape must made from red wine grapes which are partially macerated."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004050 <https://en.wikipedia.org/wiki/Maceration_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004050 "rosé wine must"@en)
SubClassOf(obo:FOODON_00004050 obo:FOODON_00001071)
SubClassOf(obo:FOODON_00004050 ObjectSomeValuesFrom(obo:OBI_0000312 ObjectIntersectionOf(obo:FOODON_00004072 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00004067))))

# Class: obo:FOODON_00004051 (red wine must)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004051 "A grape must made from red wine grapes which are substantially macerated."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004051 <https://en.wikipedia.org/wiki/Maceration_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004051 "red wine must"@en)
SubClassOf(obo:FOODON_00004051 obo:FOODON_00001071)
SubClassOf(obo:FOODON_00004051 ObjectSomeValuesFrom(obo:OBI_0000312 ObjectIntersectionOf(obo:FOODON_00004073 ObjectSomeValuesFrom(obo:OBI_0000293 obo:FOODON_00004067))))

# Class: obo:FOODON_00004052 (white wine must)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004052 "A grape must made from red or white wine grapes and which has insignificant masceration."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004052 <https://en.wikipedia.org/wiki/Maceration_(wine)>)
AnnotationAssertion(rdfs:label obo:FOODON_00004052 "white wine must"@en)
SubClassOf(obo:FOODON_00004052 obo:FOODON_00001071)

# Class: obo:FOODON_00004053 (Vintners Quality Alliance)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004053 "A regulatory and appellation system which guarantees the high quality and authenticity of origin for Canadian wines made under that system in British Columbia and Ontario."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004053 wikipedia:Vintners_Quality_Alliance)
AnnotationAssertion(rdfs:label obo:FOODON_00004053 "Vintners Quality Alliance"@en)
SubClassOf(obo:FOODON_00004053 obo:FOODON_03530087)

# Class: obo:FOODON_00004054 (American Viticultural Area)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004054 "A designated wine grape-growing region in the United States, providing an official appellation for the mutual benefit of wineries and consumers."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004054 wikipedia:American_Viticultural_Area)
AnnotationAssertion(rdfs:label obo:FOODON_00004054 "American Viticultural Area"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00004054 <https://www.ecfr.gov/current/title-27/part-4>)
SubClassOf(obo:FOODON_00004054 obo:FOODON_03530087)

# Class: obo:FOODON_00004055 (Denominación de origen)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004055 "A food product appellation framework which is a regulatory geographical indication system used primarily for foodstuffs such as cheeses, condiments, honey, and meats, among others."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004055 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004055 "In wines, it parallels the hierarchical systems of France (1935) and Italy (1963), although Rioja (1925) and Jerez (1933) preceded the full system.[https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004055 "Denominación de origen"@en)
SubClassOf(obo:FOODON_00004055 obo:FOODON_03530087)

# Class: obo:FOODON_00004056 (Spanish wine production framework)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004056 "A food product appellaction framework pertaining to Spanish wine."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004056 wikipedia:Spanish_wine_regions)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004056 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:label obo:FOODON_00004056 "Spanish wine production framework"@en)
SubClassOf(obo:FOODON_00004056 obo:FOODON_03530087)

# Class: obo:FOODON_00004057 (Denominación de Origen Protegida)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004057 "The mainstay of Spain's wine quality control system. Each region is governed by a consejo regulador, which decides on the boundaries of the region, permitted varietals, maximum yields, limits of alcoholic strength and other quality standards or production limitations pertaining to the zone."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004057 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004057 "As of 2019 there are 96 DOPs that are subdivided into DOCa, DO, VP, and VC. The sub-categories can be called DOP, or they can use the traditional terms of DOCa, DO, VP, and VC.  In 2016, the use of the term Denominación de Origen (DO) was updated to Denominación de Origen Protegida (DOP).\"[wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004057 "Denominación de Origen Protegida"@en)
SubClassOf(obo:FOODON_00004057 obo:FOODON_00004049)
SubClassOf(obo:FOODON_00004057 obo:FOODON_00004056)

# Class: obo:FOODON_00004058 (Denominación de Origen Calificada)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004058 "The highest category in Spanish wine regulations, reserved for regions with above-average grape prices and particularly stringent quality controls."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004058 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004058 "Rioja was the first Spanish region to be awarded DOCa status in 1991, followed by Priorat in 2003. Priorat uses the Catalan language DOQ, for denominació d'origen qualificada. These are the only two regions considered \"above\" DO status.\"[wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004058 "Denominación de Origen Calificada"@en)
SubClassOf(obo:FOODON_00004058 obo:FOODON_00004057)

# Class: obo:FOODON_00004059 (Vino de Pago)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004059 "A special term for high-quality, single-estate Spanish wines which in some cases also have DOP or VC or IGP appellations."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004059 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004059 "Pago is a Spanish term for a vineyard estate ...This category was formed in 2003.\"[wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004059 "Vino de Pago"@en)
SubClassOf(obo:FOODON_00004059 obo:FOODON_00004057)

# Class: obo:FOODON_00004060 (Vino de Calidad con indicación geográfica)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004060 "A category of spanish wine that does not fully meet the stringent standards of the DOP category, but are above the standards of the IGP category."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004060 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:label obo:FOODON_00004060 "Vino de Calidad con indicación geográfica"@en)
SubClassOf(obo:FOODON_00004060 obo:FOODON_00004057)

# Class: obo:FOODON_00004061 (Indicación geográfica protegida)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004061 "An EU Protected Geographical Indication which includes Spanish wines below the DOP level, and is wine originating from a specific place, a region or a country, which has a certain quality, reputation or other characteristic - including production phases - that can be essentially attributed to its geographical origin, at least one of which takes place in the defined geographical area."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004061 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004061 "These can use the traditional term Vino de la Tierra (VT).\"[wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004061 "Indicación geográfica protegida"@en)
SubClassOf(obo:FOODON_00004061 obo:FOODON_00004056)
SubClassOf(obo:FOODON_00004061 obo:FOODON_03530256)

# Class: obo:FOODON_00004062 (Vino de Mesa)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004062 "Any wine from unclassified Spanish vineyards, and wine that has been declassified by blending."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004062 <https://en.wikipedia.org/wiki/Denominaci%C3%B3n_de_origen#Wine>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004062 "This includes both inexpensive jug wines and some expensive wines that are not yet classified due to innovation outside traditional lines.\"[wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004062 "Vino de Mesa"@en)
SubClassOf(obo:FOODON_00004062 obo:FOODON_00004056)

# Class: obo:FOODON_00004065 (Table Wine (deprecated EU standard))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004065 "A European Union wine category replaced by the Protected Geographical Indication in 2011."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004065 wikipedia:Table_wine)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00004065 <https://www.wine-searcher.com/wine-label-eu>)
AnnotationAssertion(rdfs:comment obo:FOODON_00004065 "The lower of two overall quality categories, the higher of which is Quality Wines Produced in Specified Regions (QWPSR). All levels of national wine classification systems within the EU correspond to either TW or the QWPSR, although the terms that actually appear on wine labels are defined by national wine laws with the EU regulations as a framework.\"[https://en.wikipedia.org/wiki/Table_wine]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004065 "Table Wine (deprecated EU standard)"@en)
SubClassOf(obo:FOODON_00004065 obo:FOODON_03530256)

