AnnotationAssertion(rdfs:label obo:FOODON_03311270 "Beaujolais wine"@en)
SubClassOf(obo:FOODON_03311270 obo:FOODON_00002577)

# Class: obo:FOODON_03317393 (still wine)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03317393 "Wine produced by a method of vinification that leaves it free from carbon dioxide and therefore not sparkling or effervescent."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03317393 <https://en.wiktionary.org/wiki/still_wine>)
AnnotationAssertion(rdfs:label obo:FOODON_03317393 "still wine"@en)
SubClassOf(obo:FOODON_03317393 obo:FOODON_03301014)

# Class: obo:FOODON_03530086 (Appellation d'origine contrôlée)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530086 "A food product appellation framework authorized for certain French geographical indications for wines, cheeses, butters, and other agricultural products, all under the auspices of the government bureau Institut National des Appellations d'Origine (INAO). [Wikipedia]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530086 "Appellation d'origine contrôlée"@en)
SubClassOf(obo:FOODON_03530086 obo:FOODON_03530087)

# Class: obo:FOODON_03530254 (Protected Geographical Status)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530254 "A food product appellation framework defined in European Union law to protect the names of regional foods."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03530254 "Protected Designation of Origin (PDO), Protected Geographical Indication (PGI) and Traditional Speciality Guaranteed (TSG) are geographical indications, or more precisely regimes, within the framework. The law (enforced within the EU and being gradually expanded internationally via bilateral agreements of the EU with non-EU countries) ensures that only products genuinely originating in that region are allowed in commerce as such. The legislation came into force in 1992. The purpose of the law is to protect the reputation of the regional foods and eliminate the unfair competition and misleading of consumers by non-genuine products, which may be of inferior quality or of different flavour. [https://en.wikipedia.org/wiki/Geographical_indications_and_traditional_specialities_in_the_European_Union#Protected_geographical_indication_(PGI)]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530254 "Protected Geographical Status"@en)
SubClassOf(obo:FOODON_03530254 obo:FOODON_03530087)

# Class: obo:FOODON_03530255 (Protected Designation of Origin)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530255 "A Protected Geographical Status which covers agricultural products and foodstuffs which are produced, processed and prepared in a given geographical area using recognised know-how."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530255 "Protected Designation of Origin"@en)
SubClassOf(obo:FOODON_03530255 obo:FOODON_03530254)

# Class: obo:FOODON_03530256 (Protected Geographical Indication)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530256 "A Protected Geographical Status covering agricultural products and foodstuffs closely linked to the geographical area."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530256 "Protected Geographical Indication"@en)
SubClassOf(obo:FOODON_03530256 obo:FOODON_03530254)

# Class: obo:FOODON_03530257 (Traditional Speciality Guaranteed)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530257 "A Protected Geographical Status which highlights traditional character, either in the composition or means of production."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530257 "Traditional Speciality Guaranteed"@en)
SubClassOf(obo:FOODON_03530257 obo:FOODON_03530254)

# Class: obo:FOODON_03530258 (Denominazione di origine controllata)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530258 "An Italian wine quality assurance label for food products and especially wines (an appellation), and for various formaggi."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03530258 wikipedia:Denominazione_di_origine_controllata)
AnnotationAssertion(rdfs:comment obo:FOODON_03530258 "It is modelled after the French AOC. It was instituted in 1963 and overhauled in 1992 for compliance with the equivalent EU law on Protected Designation of Origin, which came into effect that year .\"[https://en.wikipedia.org/wiki/Denominazione_di_origine_controllata]."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530258 "Denominazione di origine controllata"@en)
SubClassOf(obo:FOODON_03530258 obo:FOODON_03530087)

