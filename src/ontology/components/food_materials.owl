# Class: obo:FOODON_02000320 (pork spareribs)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_02000320 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_02000320 "Ribs derived from the pork belly.  Spareribs are the longer rib bones and intercostal meat located below the back ribs. They begin with the second rib and extend downward to the sternum and costal cartilage, spanning the length of the Rib cage."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_02000320 <https://orcid.org/0000-0001-5275-8866>)
AnnotationAssertion(dcterms:date obo:FOODON_02000320 "2023-08-01T21:30:23Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment obo:FOODON_02000320 "The name originates from the German “Ribbersper” or “Spear” Ribs in reference to how they were cooked, thus the name “Spareribs.”"@en)
AnnotationAssertion(rdfs:label obo:FOODON_02000320 "pork spareribs"@en)
EquivalentClasses(obo:FOODON_02000320 ObjectIntersectionOf(obo:FOODON_03530046 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_02000281)))
