# Class: obo:FOODON_02000455 (bison shoulder clod)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_02000455 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_02000455 "A bison sub-primal cut which is  large muscle system which lies dorsal and posterior to the elbow joint, ventral and posterior to the ridge of the scapula (blade bone) and is anterior to the 6th rib."@en)
AnnotationAssertion(dcterms:contributor obo:FOODON_02000455 <https://orcid.org/0000-0001-5275-8866>)
AnnotationAssertion(dcterms:date obo:FOODON_02000455 "2023-10-10T15:20:43Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment obo:FOODON_02000455 "Centred around the scapula or blade bone in the Chuck. Scapula is removed to make this a boneless subprimal."@en)
AnnotationAssertion(rdfs:label obo:FOODON_02000455 "bison shoulder clod"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_02000455 <https://www.ams.usda.gov/sites/default/files/media/IMPS100SeriesDraft2020.pdf>)
SubClassOf(obo:FOODON_02000455 obo:FOODON_00004540)
SubClassOf(obo:FOODON_02000455 ObjectSomeValuesFrom(obo:RO_0001000 obo:FOODON_02000453))

