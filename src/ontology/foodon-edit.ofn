############################
#   Annotation Properties
############################

# Annotation Property: <http://purl.obolibrary.org/obo/IAO_0000600> (elucidation)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/IAO_0000600> "elucidation"@en)

# Annotation Property: <http://schema.org/image> (schema:image)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://schema.org/image> "An image of the item. In Protege, this can be a URL."@en)
AnnotationAssertion(rdfs:label <http://schema.org/image> "schema:image"@en)

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#hasSynonym> (has synonym)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#hasSynonym> "has synonym"@en)


############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/FOODON_00001301> (has food substance analog)

SymmetricObjectProperty(<http://purl.obolibrary.org/obo/FOODON_00001301>)

# Object Property: <http://purl.obolibrary.org/obo/FOODON_00001563> (has defining ingredient)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00001563> "A defining ingredient defines what a food is principally categorized as, rather than an ingredient listed by percentage of weight or volume. A food may have more than one defining ingredient."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00001563> "Damion Dooley"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_00001563> "FoodOn"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_00001563> "For example, 'bean soup' has a defining ingredient of some 'bean'.  Similarly, spicy chicken wings require a defining ingredient of (usually minute) amounts of chilli. 

A soup may 'has ingredient' some bean, but that doesn't make it a 'bean soup', i.e. there should be no inference to that category. However, some classes may have that simple ingredient \"necessary and sufficient\" equivalency."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00001563> "has defining ingredient"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/FOODON_00001563> <http://purl.obolibrary.org/obo/FOODON_00002420>)

# Object Property: <http://purl.obolibrary.org/obo/FOODON_00002420> (has ingredient)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002420> "A relation attaching between a food material and another food material that has been added to it at some point in its history."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00002420> "Damion Dooley"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_00002420> "FoodOn"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002420> "has ingredient"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_00002420> <https://www.fda.gov/food/food-ingredients-packaging/overview-food-ingredients-additives-colors>)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/FOODON_00002420> <http://purl.obolibrary.org/obo/RO_0009001>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/FOODON_00002420> <http://purl.obolibrary.org/obo/FOODON_00002403>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/FOODON_00002420> <http://purl.obolibrary.org/obo/FOODON_00001002>)

# Object Property: <http://purl.obolibrary.org/obo/HANCESTRO_0308> (hasCountryOfOrigin)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/HANCESTRO_0308> "has country of origin"@en)

# Object Property: <http://purl.obolibrary.org/obo/RO_0000086> (has quality)

SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/RO_0000053>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0000087> (has role)

SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/RO_0000053>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0009001> (has substance added)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/RO_0009001> "Damion Dooley")


############################
#   Data Properties
############################

# Data Property: <https://www.w3.org/TR/owl-time/#time:hasXSDDuration> (hasXSDDuration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://www.w3.org/TR/owl-time/#time:hasXSDDuration> "Extent of a temporal entity, expressed using xsd:duration"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://www.w3.org/TR/owl-time/#time:hasXSDDuration> <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <https://www.w3.org/TR/owl-time/#time:hasXSDDuration> "2023-05-13T18:37:00Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <https://www.w3.org/TR/owl-time/#time:hasXSDDuration> "hasXSDDuration"@en)
DataPropertyDomain(<https://www.w3.org/TR/owl-time/#time:hasXSDDuration> <https://www.w3.org/TR/owl-time/#time:TemporalEntity>)

# Data Property: <https://www.w3.org/TR/owl-time/#time:numericDuration> (numericDuration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://www.w3.org/TR/owl-time/#time:numericDuration> "Value of a temporal extent expressed as a number scaled by a temporal unit"@en)
AnnotationAssertion(rdfs:label <https://www.w3.org/TR/owl-time/#time:numericDuration> "numericDuration"@en)
DataPropertyDomain(<https://www.w3.org/TR/owl-time/#time:numericDuration> <https://www.w3.org/TR/owl-time/#time:Duration>)
DataPropertyRange(<https://www.w3.org/TR/owl-time/#time:numericDuration> xsd:decimal)



