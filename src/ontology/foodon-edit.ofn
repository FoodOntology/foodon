# Class: obo:NCBITaxon_320146 (Chaenomeles japonica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_320146 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_320146 "*Chaenomeles japonica*, known as Maule's quince, is a species of flowering quince. The fruit is edible, but hard and astringent-tasting, unless bletted. The fruit is occasionally used in jam, jelly and pie making as a substitute for its cousin, the true quince, Cydonia oblonga. [https://en.wikipedia.org/wiki/Chaenomeles_japonica]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_320146 "japanese quince plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_320146 <http://eol.org/pages/230570>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_320146 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10007>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_320146 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=508021>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_320146 langual:B5049)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_320146 "PLANTS:CHJA2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_320146 "Chaenomeles japonica (Thunb.) Lindl. ex Spach")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_320146 "chaenomeles japonica"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_320146 "flowering-quince"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_320146 "maule's quince"@en)
SubClassOf(obo:NCBITaxon_320146 obo:FOODON_03411298)

