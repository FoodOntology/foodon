# Class: obo:FOODON_03415086 (witch-hazel plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415086 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415086 "Witch-hazels (*Hamamelis*) are a genus of flowering plants in the family *Hamamelidaceae*, with four species in North America (*H. mexicana, H. ovalis, H. virginiana, H. vernalis*), and one each in Japan (*H. japonica*) and China (*H. mollis*). The leaves and bark of the North American witch-hazel, *Hamamelis virginiana*, may be used to produce an astringent decoction as a cooling agent for various uses in traditional medicine, herbalism, and skincare products. [https://en.wikipedia.org/wiki/Witch-hazel]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415086 <http://eol.org/pages/4293>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415086 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?315758>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415086 langual:B5086)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415086 "PLANTS:HAMAM")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415086 "hamamelis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415086 "witch-hazel plant"@en)
SubClassOf(obo:FOODON_03415086 obo:FOODON_03413359)

# Class: obo:FOODON_03415087 (honeybush plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415087 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415087 "Cyclopia, better known by the common name Honeybush, or Heuningbos in Afrikaans, is a genus of some 20 species of flowering plants in the legume family, *Fabaceae*, of the subfamily *Faboideae*. The leaves of honeybush are commonly used to make herbal teas. It grows only in small areas in the southwest and southeast of South Africa and has many similarities with rooibos. [https://en.wikipedia.org/wiki/Cyclopia_(plant)]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415087 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?3244>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415087 langual:B5087)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415087 "Cyclopia Vent.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415087 "cyclopia genistoides"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415087 "cyclopia intermedia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415087 "cyclopia sessiflora"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415087 "cyclopia subternata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415087 "honeybush plant"@en)
SubClassOf(obo:FOODON_03415087 obo:FOODON_03411179)

# Class: obo:FOODON_03415088 (chrysanthemum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415088 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415088 "Chrysanthemums, sometimes called mums or chrysanths, are flowering plants of the genus *Chrysanthemum* in the family *Asteraceae*. Yellow or white chrysanthemum flowers of the species *C. morifolium* are boiled to make a tea in some parts of Asia. Chrysanthemum leaves are steamed or boiled and used as greens, especially in Chinese cuisine. The flowers may be added to dishes [https://en.wikipedia.org/wiki/Chrysanthemum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415088 <http://eol.org/pages/4206>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415088 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300128>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415088 langual:B5088)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415088 "PLANTS:CHRYS2")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415088 "daisy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415088 "chrysanthemum plant"@en)
SubClassOf(obo:FOODON_03415088 obo:FOODON_03411566)

# Class: obo:FOODON_03415089 (common daisy plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415089 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415089 "Bellis perennis is a common European species of daisy, of the *Asteraceae* family, often considered the archetypal species of that name. Many related plants also share the name \"daisy\", so to distinguish this species from other daisies it is sometimes qualified as common daisy, lawn daisy or English daisy. This daisy may be used as a potherb. Flower buds and petals can be eaten raw in sandwiches, soups and salads. It is also used as a tea and as a vitamin supplement. *Bellis perennis* has astringent properties and has been used in herbal medicine. 
[https://en.wikipedia.org/wiki/Bellis_perennis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415089 <http://eol.org/pages/467843>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415089 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6728>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415089 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=36826>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415089 langual:B5089)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415089 "PLANTS:BEPE2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415089 "English daisy")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415089 "bellis perennis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415089 "english daisy"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415089 "lawndaisy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415089 "common daisy plant"@en)
SubClassOf(obo:FOODON_03415089 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03415089 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_41492))

