# Class: obo:NCBITaxon_55670 (Stevia rebaudiana)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_55670 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_55670 "*Stevia* is a genus of about 240 species of herbs and shrubs in the sunflower family (Asteraceae), native to subtropical and tropical regions from western North America to South America. The species *Stevia rebaudiana*, commonly known as sweetleaf, sweet leaf, sugarleaf, or simply stevia, is widely grown for its sweet leaves. As a sweetener and sugar substitute, stevia's taste has a slower onset and longer duration than that of sugar, although some of its extracts may have a bitter or licorice-like aftertaste at high concentrations.
With its steviol glycoside extracts having up to 300 times the sweetness of sugar, stevia has garnered attention with the rise in demand for low-carbohydrate, low-sugar food alternatives."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_55670 "stevia plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_55670 "WIKIPEDIA:Stevia_rebaudiana")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55670 <http://eol.org/pages/483967>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55670 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?35581>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55670 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505914>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55670 langual:B4455)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55670 "PLANTS:STRE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_55670 "Stevia rebaudiana (Bertoni) Bertoni")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55670 "candyleaf"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55670 "stevia rebaudiana"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55670 "sugarleaf"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55670 "sweet leaf"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55670 "sweetleaf"@en)
SubClassOf(obo:NCBITaxon_55670 obo:FOODON_03411013)

