# Class: obo:FOODON_03430147 (fabricated whole form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430147 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430147 langual:E0147)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430147 "stick, formed"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430147 "LanguaL curation note: Used only for solid food products, i.e. hard or soft products capable of retaining a definite shape at room temperature (20 degrees C.). Examples of whole formed products are: whole cheese, apple pie, loaf of unsliced bread, noodle, yeast tablet and cornflake."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430147 "fabricated whole form (sensu food)"@en)
SubClassOf(obo:FOODON_03430147 obo:FOODON_03430131)

# Class: obo:FOODON_03430148 (divided into one or more quarters)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430148 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430148 langual:E0148)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430148 "quartered"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430148 "LanguaL curation note: Used for solid products that are divided into four identical pieces (e.g., quartered artichoke heart)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430148 "divided into one or more quarters"@en)
SubClassOf(obo:FOODON_03430148 obo:FOODON_03430133)

# Class: obo:FOODON_03430149 (food (liquid, low viscosity, with solid pieces))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430149 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430149 langual:E0149)
AnnotationAssertion(rdfs:label obo:FOODON_03430149 "food (liquid, low viscosity, with solid pieces)"@en)
SubClassOf(obo:FOODON_03430149 obo:FOODON_03430109)

# Class: obo:FOODON_03430150 (naturally shaped whole form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430150 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430150 "A whole form characteristic which is the shape of food material consisting of an organism or organism part."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430150 langual:E0150)
AnnotationAssertion(rdfs:comment obo:FOODON_03430150 "LanguaL curation note: Whole refers not only to a whole plant or animal but also to a whole part as indexed in C. PART OF PLANT OR ANIMAL; examples of whole natural products are: an apple, rice in grain form, an asparagus spear, a spinach leaf, a beef carcass, a dressed chicken, a chicken drumstick, a calf liver. Products may have been slightly modified during processing and preservation (e.g., raisins or a pear that has been peeled and cored)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430150 "naturally shaped whole form (sensu food)"@en)
SubClassOf(obo:FOODON_03430150 obo:FOODON_03430131)

# Class: obo:FOODON_03430151 (food (solid))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430151 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430151 "Food material which is a hard or soft material capable of retaining its own shape at room temperature."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430151 langual:E0151)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430151 "solid"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430151 "A soft product that is spreadable or formable is considered semisolid.  Room temperature is roughly 20 degrees C."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430151 "food (solid)"@en)
EquivalentClasses(obo:FOODON_03430151 ObjectIntersectionOf(obo:FOODON_00002454 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001546)))
SubClassOf(obo:FOODON_03430151 obo:FOODON_00002454)

# Class: obo:FOODON_03430152 (divided into pieces (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430152 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430152 "A characteristic of a collection of one or more pieces of a solid food material class, each of which have little or no relation to the shape of the whole."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430152 langual:E0152)
AnnotationAssertion(rdfs:comment obo:FOODON_03430152 "LanguaL note: \"If all dimensions are below 0.2 cm., use *DISINTEGRATED OR GROUND*. Examples are: bread slice, cubed beef, sliced carrot, cut green beans, apple ring, shredded cabbage or cheese.\""@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430152 "divided into pieces (sensu food)"@en)
SubClassOf(obo:FOODON_03430152 obo:FOODON_00005712)

# Class: obo:FOODON_03430153 (whole form, shape achieved by forming, thickness <0.3 cm.)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430153 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430153 langual:E0153)
AnnotationAssertion(rdfs:label obo:FOODON_03430153 "whole form, shape achieved by forming, thickness <0.3 cm."@en)
EquivalentClasses(obo:FOODON_03430153 ObjectIntersectionOf(obo:FOODON_03430147 ObjectSomeValuesFrom(obo:RO_0000086 obo:FOODON_00002406)))
SubClassOf(obo:FOODON_03430153 obo:FOODON_03430147)

# Class: obo:FOODON_03430154 (food supplement form)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430154 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430154 "Food supplements are generally marketed in dose form designed to be taken in measured small unit quantities, such as pill, capsule, tablet, powder or liquid."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430154 langual:E0154)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430154 "galenic formulation"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430154 "food supplement form"@en)
SubClassOf(obo:FOODON_03430154 obo:FOODON_00002454)

# Class: obo:FOODON_03430155 (edible tablet)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430155 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430155 "A tablet is a mixture of active substances and excipients, usually in powder form, pressed or compacted into a solid. Tablets can be made in virtually any shape, although requirements of patients and tableting machines mean that most are round, oval or capsule shaped. Medicinal tablets and capsules are often called \"pills\". This is technically incorrect, since tablets are made by compression, whereas pills are ancient solid dose forms prepared by rolling a soft mass into a round shape. A caplet is a smooth, coated, oval shaped medicinal tablet in the shape of a capsule. [Wikipedia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430155 langual:E0155)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430155 "caplet"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430155 "pill"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430155 "edible tablet"@en)
SubClassOf(obo:FOODON_03430155 obo:FOODON_03430154)

# Class: obo:FOODON_03430156 (chewable tablet)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430156 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430156 "Chewable tablets are the tablets which are required to be broken and chewed in between the teeth before ingestion. These tablets are given to the children who have difficulty in swallowing and to the adults who dislike swallowing. A number of antacid tablets and multivitamin tablets are prepared as chewable tablets. [http://www.pharmpedia.com/Chewable_tablets]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430156 langual:E0156)
AnnotationAssertion(rdfs:label obo:FOODON_03430156 "chewable tablet"@en)
SubClassOf(obo:FOODON_03430156 obo:FOODON_03430155)

# Class: obo:FOODON_03430157 (non-chewable tablet)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430157 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430157 langual:E0157)
AnnotationAssertion(rdfs:label obo:FOODON_03430157 "non-chewable tablet"@en)
SubClassOf(obo:FOODON_03430157 obo:FOODON_03430155)

# Class: obo:FOODON_03430158 (effervescent tablet)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430158 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430158 "Effervescent tablets are uncoated tablets that generally contain acid substances and carbonates or bicarbonates and which react rapidly in the presence of water by releasing carbon dioxide. They are intended to be dissolved or dispersed in water before use. [http://www.pharmpedia.com/Effervescent_tablet]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430158 "LANGUAL:E0158"^^rdfs:Literal)
AnnotationAssertion(rdfs:label obo:FOODON_03430158 "effervescent tablet"@en)
SubClassOf(obo:FOODON_03430158 obo:FOODON_03430157)

# Class: obo:FOODON_03430159 (edible capsule)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430159 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430159 "The two main types of capsules are hard-shelled capsules, which are normally used for dry, powdered ingredients, and soft-shelled capsules, primarily used for oils and for active ingredients that are dissolved or suspended in oil. Both of these classes of capsule are made both from gelatin and from plant-based gelling substances like carrageenans and modified forms of starch and cellulose. [http://en.wikipedia.org/wiki/Capsule_(pharmacy)]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03430159 "WIKIPEDIA:Capsule_(pharmacy)")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430159 langual:E0159)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430159 "encapsulated"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430159 "edible capsule"@en)
SubClassOf(obo:FOODON_03430159 obo:FOODON_03430154)

# Class: obo:FOODON_03430160 (hard gelatin capsule)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430160 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430160 "Traditionally hard gelatin capsules have been used for enclosure of powders or other solid substances like granules and pellets. Recently pastes and oils have also been filled in hard gelatin capsules. [http://www.pharmpedia.com/Hard_Gelatin_Capsules]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430160 langual:E0160)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430160 "gel cap"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430160 "LanguaL curation note: If appropriate, gelatin-free hard-shelled capsules can also be indexed with VEGAN/VEGETARIAN OR SUITABILITY FOR VEGAN/VEGETARIAN CLAIM OR USE [P0199] and/or KOSHER CLAIM OR USE [P0127]."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430160 "hard gelatin capsule"@en)
SubClassOf(obo:FOODON_03430160 obo:FOODON_03430159)

# Class: obo:FOODON_03430161 (soft gelatin capsule)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430161 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430161 "Soft-shelled capsules are primarily used for oils and for active ingredients that are dissolved or suspended in oil. [Wikipedia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430161 langual:E0161)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430161 "softgel capsule"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430161 "soft gelatin capsule"@en)
SubClassOf(obo:FOODON_03430161 obo:FOODON_03430159)

# Class: obo:FOODON_03430162 (food supplement powder)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430162 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430162 "Powder for oral solution."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430162 langual:E0162)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430162 "sachet"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430162 "food supplement powder"@en)
SubClassOf(obo:FOODON_03430162 obo:FOODON_03430154)

