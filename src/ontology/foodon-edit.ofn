# Class: obo:NCBITaxon_108881 (Theobroma grandiflorum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_108881 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_108881 "Cupuaçu (*Theobroma grandiflorum*), also spelled cupuassu, cupuazú, and copoasu, is a tropical rainforest tree related to cacao. Common throughout the Amazon basin, it is widely cultivated in the jungles of Colombia, Bolivia and Peru and in the north of Brazil, with the largest production in Pará, followed by Amazonas, Rondônia and Acre."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_108881 "cupuaçu plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_108881 "WIKIPEDIA:Cupuacu")
AnnotationAssertion(obo:IAO_0000600 obo:NCBITaxon_108881 "The white pulp of the cupuaçu is uniquely fragrant (described as a mix of chocolate and pineapple), and it contains theacrine (1,3,7,9-tetramethyluric acid) instead of the xanthines (caffeine, theobromine, and theophylline) found in cacao.[1] It is frequently used in desserts, juices and sweets. The juice tastes primarily like a pear, with a hint of banana."@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_108881 <http://eol.org/pages/482162>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_108881 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101891>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_108881 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506108>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_108881 langual:B4457)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_108881 "PLANTS:THGR7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_108881 "Theobroma grandiflorum (Willd. ex Spreng.) K. Schum.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_108881 "Theobroma grandiflorum (Willd. ex Spreng.) Schum.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_108881 "Theobroma grandiflorum (Willd. ex Sprengel) Schumann")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_108881 "theobroma grandiflorum"@en)
SubClassOf(obo:NCBITaxon_108881 obo:FOODON_03411024)
SubClassOf(obo:NCBITaxon_108881 obo:FOODON_03411179)

# Class: obo:NCBITaxon_109096 (Chaerophyllum bulbosum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_109096 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_109096 "*Chaerophyllum bulbosum* is a species of flowering plant from the carrot family and known by several common names, including turnip-rooted chervil, tuberous-rooted chervil, bulbous chervil, and parsnip chervil. It is native to Europe and Western Asia. It was a popular vegetable in the 19th century. [https://en.wikipedia.org/wiki/Chaerophyllum_bulbosum]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_109096 "bulbous chervil plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 <http://eol.org/pages/581716>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10020>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=29615>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 langual:B3440)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 "CCPR:")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109096 "PLANTS:CHBU5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_109096 "Chaerophyllum bulbosum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_109096 "chaerophyllum bulbosum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_109096 "turnip-rooted chervil"@en)
SubClassOf(obo:NCBITaxon_109096 obo:FOODON_03411018)

# Class: obo:NCBITaxon_109171 (Pachyrhizus erosus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_109171 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_109171 "*Pachyrhizus erosus*, commonly known as Jícama, Yam, and Mexican Turnip, is the name of a native Mexican vine, although the name most commonly refers to the plant's edible tuberous root. Jícama is one species in the genus Pachyrhizus. Plants in this genus are commonly referred to as yam bean, although the term \"yam bean\" can be another name for jícama. The other major species of yam beans are also indigenous within the Americas."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_109171 "jicama plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_109171 "WIKIPEDIA:Jicama")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109171 <http://eol.org/pages/4277>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109171 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?26286>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109171 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=26824>)
