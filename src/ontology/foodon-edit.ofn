# Class: obo:FOODON_03414370 (mulard duck)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414370 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414370 "The Mulard (or Moulard) is a hybrid variety of domestic duck produced by crossing a female Pekin with a male Muscovy Duck. Since the domestic Pekin is descended from the Mallard Duck (*Anas platyrhynchos*) and the Muscovy (*Cairina moschata*) is a separate species, all Mulards are sterile F1 hybrids. Most are bred through artificial insemination, and are sometimes also called \"mule ducks\"."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414370 "WIKIPEDIA:Mulard_duck")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414370 langual:B4370)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414370 "mule duck"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414370 "mulard duck"@en)
SubClassOf(obo:FOODON_03414370 obo:FOODON_03411316)

# Class: obo:FOODON_03414371 (red deer)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414371 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414371 "The red deer (*Cervus elaphus*) is one of the largest deer species. The red deer inhabits most of Europe, the Caucasus Mountains region, Asia Minor, parts of western Asia, and central Asia. It also inhabits the Atlas Mountains region between Morocco and Tunisia in northwestern Africa."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414371 <http://eol.org/pages/328649>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414371 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180695>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414371 langual:B4371)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414371 "MSW3:14200352")
AnnotationAssertion(rdfs:label obo:FOODON_03414371 "red deer"@en)
SubClassOf(obo:FOODON_03414371 obo:FOODON_03411583)
SubClassOf(obo:FOODON_03414371 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9860))

# Class: obo:FOODON_03414372 (japanese horse-chestnut tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414372 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414372 "Aesculus turbinata, common name \"Japanese horse-chestnut\" is native to Japan but cultivated elsewhere. It is a tree up to 30 m tall. Flowers are white to pale yellowish with red spots. Capsules are dark brown, obovoid to pyriform. The seeds were traditionally eaten, after leaching, by the Jomon people of Japan over about four millennia, until 300 AD."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414372 <http://eol.org/pages/483851>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414372 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?1637>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414372 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506070>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414372 langual:B4372)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414372 "PLANTS:AETU")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414372 "Japanese horse-chestnut")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414372 "aesculus turbinata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414372 "japanese horse chestnut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414372 "japanese horse-chestnut tree"@en)
SubClassOf(obo:FOODON_03414372 obo:FOODON_03411544)
SubClassOf(obo:FOODON_03414372 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_83375))

# Class: obo:FOODON_03414373 (common vetch plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414373 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414373 "Vicia sativa, known as the Common Vetch, Tare or simply \"the vetch\", is a nitrogen fixing leguminous plant. Although considered a weed when found growing in a cultivated grainfield, this hardy plant is often grown as green manure or livestock fodder."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414373 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414373 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300667>)
