SubClassOf(obo:NCBITaxon_170989 obo:FOODON_03411179)

# Class: obo:NCBITaxon_171249 (Citrus limonia)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_171249 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_171249 "Rangpur, Citrus × limonia, also known as lemandarin, is a hybrid between the mandarin orange and the lemon. It is a citrus fruit with a very acidic taste and an orange peel and flesh."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_171249 "mandarin lime plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_171249 "WIKIPEDIA:Mandarin_Lime")
