AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_102211> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505894>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_102211> <http://www.langual.org/langual_thesaurus.asp?termid=B2518>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_102211> "PLANTS:BEHI3")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_102211> "Benincasa hispida (Thunb.) Cogn.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_102211> "benincasa hispida var."@en)
