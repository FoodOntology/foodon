# Class: obo:NCBITaxon_115466 (Euterpe oleracea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_115466 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_115466 "The açaí palm (*Euterpe oleracea*) is a species of palm tree in the genus *Euterpe* cultivated for its fruit and hearts of palm. Global demand for the fruit has expanded rapidly in recent years, and açaí is now cultivated for that purpose primarily. *Euterpe edulis* (juçara) is a closely related species which is now the primary source of hearts of palm.[https://en.wikipedia.org/wiki/A%C3%A7a%C3%AD_palm]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_115466 "assai palm plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115466 <http://eol.org/pages/1100375>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115466 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?16475>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115466 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506722>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115466 langual:B4592)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115466 "PLANTS:EUOL2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_115466 "Euterpe oleracea Mart.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115466 "açaí palm"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115466 "euterpe oleracea"@en)
SubClassOf(obo:NCBITaxon_115466 obo:FOODON_03411231)
SubClassOf(obo:NCBITaxon_115466 obo:FOODON_03411286)
SubClassOf(obo:NCBITaxon_115466 obo:FOODON_03413387)

