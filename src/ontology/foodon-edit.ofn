AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414844 langual:B4844)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414844 "×Citrofortunella floridana J. W. Ingram & H. E. Moore")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414844 "×Citrofortunella swinglei J. W. Ingram & H. E. Moore")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414844 "×citrofortunella floridana"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414844 "×citrofortunella swinglei"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414844 "limequat"@en)
SubClassOf(obo:FOODON_03414844 obo:FOODON_03414845)

# Class: obo:FOODON_03414845 (citrofortunella hybrids plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414845 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414845 "Citrofortunella according to the Swingle system, is a hybrid genus, containing intergeneric hybrids between members of the genus Citrus and the closely related Fortunella. It is named after its two parent genera. Such hybrids often combine the cold hardiness of the Fortunella, such as the Kumquat, with some edibility properties of the citrus species. Citrofortunellas, which are all hybrids, are marked with the multiplication sign before the word \"Citrofortunella\", for example × *Citrofortunella microcarpa* or × *Citrofortunella mitis which refer to the same plant.[https://en.wikipedia.org/wiki/Citrus_taxonomy]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414845 langual:B4845)
AnnotationAssertion(rdfs:label obo:FOODON_03414845 "citrofortunella hybrids plant"@en)
SubClassOf(obo:FOODON_03414845 obo:FOODON_03411139)

# Class: obo:FOODON_03414846 (kiwiberry)

