# Class: obo:NCBITaxon_38860 (Mentha suaveolens)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_38860 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_38860 "*Mentha suaveolens*, the apple mint, pineapple mint, woolly mint or round-leafed mint (synonyms *M. rotundifolia, Mentha macrostachya, Mentha insularis*), is a member of the mint family *Lamiaceae*. It is native to southern and western Europe including the Mediterranean region. It is a herbaceous, upright perennial plant that is most commonly grown as a culinary herb or for ground cover. [https://en.wikipedia.org/wiki/Mentha_suaveolens]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_38860 "apple mint plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38860 <http://eol.org/pages/486806>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38860 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?313976>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38860 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503753>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38860 langual:B5005)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38860 "PLANTS:MESU5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_38860 "Mentha suaveolens Ehrh.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38860 "mentha suaveolens"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38860 "pineapple mint"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38860 "round-leaf mint"@en)
SubClassOf(obo:NCBITaxon_38860 obo:FOODON_03411267)

# Class: obo:NCBITaxon_38868 (Salvia officinalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_38868 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_38868 "*Salvia officinalis* (sage, also called garden sage, common sage, or culinary sage) is a perennial, evergreen subshrub, with woody stems, grayish leaves, and blue to purplish flowers. It is a member of the mint family *Lamiaceae* and native to the Mediterranean region, though it has naturalized in many places throughout the world. It has a long history of medicinal and culinary use, and in modern times as an ornamental garden plant. The common name \"sage\" is also used for a number of related and unrelated species. [https://en.wikipedia.org/wiki/Salvia_officinalis]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_38868 "kitchen sage plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38868 <http://eol.org/pages/578478>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38868 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32950>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38868 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32729>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38868 langual:B4992)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38868 "PLANTS:SAOF2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_38868 "Salvia officinalis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38868 "common sage"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38868 "salvia officinalis"@en)
SubClassOf(obo:NCBITaxon_38868 obo:FOODON_03411303)

# Class: obo:NCBITaxon_38869 (Salvia sclarea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_38869 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_38869 "*Salvia sclarea*, the clary or clary sage, is a biennial or short-lived herbaceous perennial in the genus *Salvia*. The plant has a lengthy history as a medicinal herb, and is currently grown for its essential oil - used widely in perfumes and as a muscatel flavoring for vermouths, wines, and liqueurs. [https://en.wikipedia.org/wiki/Salvia_sclarea]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_38869 "clary sage plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38869 <http://eol.org/pages/579411>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38869 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32964>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38869 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32741>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38869 langual:B5124)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38869 "PLANTS:SASC2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_38869 "Salvia sclarea L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38869 "salvia sclarea"@en)
SubClassOf(obo:NCBITaxon_38869 obo:FOODON_03413359)

# Class: obo:NCBITaxon_38874 (Fraxinus ornus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_38874 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_38874 "*Fraxinus ornus*, the manna ash or South European flowering ash, is a species of Fraxinus native to southern Europe and southwestern Asia. A sugary extract from the sap is extracted by making a cut in the bark; this was compared in late medieval times with the biblical manna. [https://en.wikipedia.org/wiki/Fraxinus_ornus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_38874 "manna ash plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38874 <http://eol.org/pages/483953>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38874 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?302>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38874 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505982>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38874 langual:B5019)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38874 "PLANTS:FROR2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_38874 "Fraxinus ornus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38874 "flowering ash"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38874 "fraxinus ornus"@en)
SubClassOf(obo:NCBITaxon_38874 obo:FOODON_03411012)

# Class: obo:NCBITaxon_3888 (Pisum sativum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3888 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3888 "The pea is most commonly the small spherical seed or the seed-pod of the pod fruit *Pisum sativum*."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3888 "garden pea plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3888 "WIKIPEDIA:Pisum_sativum")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3888 <http://eol.org/pages/703192>)
