# Class: obo:FOODON_03413711 (hartwort plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413711 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413711 "Tordylium apulum, commonly known as the Mediterranean Hartwort, is an annual forb or herb. It is classified within the family *Apiaceae*, the carrot family. It is located in a range from Europe to west Asia, but was introduced to the United States. It is now found only in Arizona. The hartwort does have edible leaves. In Italy it is used as a condiment."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413711 <http://eol.org/pages/485022>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413711 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36756>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413711 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505532>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413711 langual:B3711)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413711 "tordylium apulum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413711 "tordylium maximum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413711 "hartwort plant"@en)
SubClassOf(obo:FOODON_03413711 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03413711 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_489417))

# Class: obo:FOODON_03413712 (plantain plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413712 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413712 "Plantago is a genus of about 200 species of small, inconspicuous plants commonly called plantains. *Plantago* species have been used since prehistoric times as herbal remedies. The herb is astringent, anti-toxic, antimicrobial, anti-inflammatory, anti-histamine, as well as demulcent, expectorant, styptic and diuretic. Externally, a poultice of the leaves is useful for insect bites, poison-ivy rashes, minor sores, and boils. In folklore it is even claimed to be able to cure snakebite. Internally, it is used for coughs and bronchitis, as a tea, tincture, or syrup. The broad-leaved varieties are sometimes used as a leaf vegetable for salads, green sauce, et cetera. Plantain seed husks expand and become mucilaginous when wet, especially those of *Plantago psyllium*, which is used in common over-the-counter bulk laxative and fiber supplement products. []"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413712 <http://eol.org/pages/4354>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413712 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317089>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413712 langual:B3712)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413712 "PLANTS:PLANT")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413712 "Plantago")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413712 "Plantago L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413712 "Plantago sp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413712 "indianwheat"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413712 "plantago spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413712 "plantain plant"@en)
SubClassOf(obo:FOODON_03413712 obo:FOODON_03411566)

