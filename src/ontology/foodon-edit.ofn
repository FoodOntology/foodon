AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414483 langual:B4483)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414483 "PLANTS:HEAL")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414483 "alpine sweetvetch"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414483 "hedysarum alpinum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414483 "alpine sweetvetch plant"@en)
SubClassOf(obo:FOODON_03414483 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03414483 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_57576))

# Class: obo:FOODON_03414484 (giant pacific octopus)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414484 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414484 "Enteroctopus dofleini, also known as the giant Pacific octopus or North Pacific giant octopus, is a large cephalopod belonging to the genus *Enteroctopus*."@en)
