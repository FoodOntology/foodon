# Class: obo:FOODON_03414837 (lillipilly plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414837 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414837 "Syzygium smithii (formerly *Acmena smithii*) is a summer-flowering, winter-fruiting evergreen tree, belonging to the myrtle family *Myrtaceae*. It shares the common name \"lilly pilly\" with several other plants, however in New Zealand, it is commonly known as 'monkey apple'. It is planted as shrubs or hedgerows, and features: rough, woody bark; cream and green smooth, waxy leaves; flushes of pink new growth; and white to maroon edible berries. []"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414837 <http://eol.org/pages/8095>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414837 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36135>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414837 langual:B4837)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414837 "APNI:73568")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414837 "Acmena smithii (Poir.) Merr. & L.M.Perry")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414837 "Syzygium smithii (Poir.) Nied.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414837 "acmena smithii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414837 "monkey apple"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414837 "syzygium smithii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414837 "lillipilly plant"@en)
SubClassOf(obo:FOODON_03414837 obo:FOODON_03414835)

