AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415136 "PLANTS:VITR")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415136 "heart's ease"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415136 "viola tricolor"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415136 "johnny-jump-up plant"@en)
