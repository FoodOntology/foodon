# Class: obo:FOODON_03413448 (anadromous fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413448 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413448 "Anadromous fish live in the sea mostly, breed in fresh water; the best-known are salmon, which hatch in small freshwater streams, go down to the sea and live there for several years, then return to the same streams where they were hatched, spawn, and die shortly thereafter."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413448 langual:B3448)
AnnotationAssertion(rdfs:label obo:FOODON_03413448 "anadromous fish"@en)
SubClassOf(obo:FOODON_03413448 obo:FOODON_03413360)

# Class: obo:FOODON_03413449 (catadromous fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413449 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413449 "Catadromous fish live in fresh water, breed in the sea; the most remarkable are freshwater eels of genus Anguilla, whose larvae drift on the open ocean, sometimes for months or years, before travelling thousands of kilometres back to their original streams."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413449 langual:B3449)
AnnotationAssertion(rdfs:label obo:FOODON_03413449 "catadromous fish"@en)
SubClassOf(obo:FOODON_03413449 obo:FOODON_03413360)

# Class: obo:FOODON_03413450 (amphidromous fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413450 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413450 "Amphidromous fish move between fresh and salt water during some part of life cycle, but not for breeding."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413450 langual:B3450)
AnnotationAssertion(rdfs:label obo:FOODON_03413450 "amphidromous fish"@en)
SubClassOf(obo:FOODON_03413450 obo:FOODON_03413360)

