AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411572 "MANSFELD:15074")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411572 "PLANTS:CIAR8")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411572 "chinese cinnamon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411572 "cassia, chinese"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411572 "cinnamomum aromaticum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411572 "cinnamomum cassia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411572 "chinese cinnamon plant"@en)
SubClassOf(obo:FOODON_03411572 obo:FOODON_03411472)
SubClassOf(obo:FOODON_03411572 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_119260))

# Class: obo:FOODON_03411573 (atheriniform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411573 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411573 "The Atheriniformes, also known as the silversides, are an order of ray-finned fishes that includes the Old World silversides and several less-familiar families, including the unusual *Phallostethidae*. The order includes at least 354 species. They are found worldwide in tropical and temperate marine and freshwater environments. [https://en.wikipedia.org/wiki/Atheriniformes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411573 <http://eol.org/pages/8268>)
