AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411535 "Agave is a genus of monocots native to the hot and arid regions of Mexico and the Southwestern United States. Some agave species are also native to tropical areas of South America. Some species are known by the name \"century plant\". Agave tequilana, agave azul or blue agave, is used in the production of tequila. Agave nectar, also called agave syrup, a sweetener derived from Agave sap, is used as an alternative to sugar in cooking, and can be added to breakfast cereals as a binding agent."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411535 langual:B1535)
AnnotationAssertion(rdfs:label obo:FOODON_03411535 "agave plant"@en)
SubClassOf(obo:FOODON_03411535 obo:FOODON_03411048)

# Class: obo:FOODON_03411536 (coconut palm plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411536 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411536 "The coconut palm, *Cocos nucifera*, is a member of the family *Arecaceae* (palm family). It is the only accepted species in the genus *Cocos*. The term coconut can refer to the entire coconut palm, the seed, or the fruit, which is not a botanical nut, but a drupe. The spelling cocoanut is an old-fashioned form of the word."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 <http://eol.org/pages/1091712>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11043>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42451>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 langual:B1536)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 "MANSFELD:10983")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411536 "PLANTS:CONU")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411536 "coconut palm")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411536 "coconut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411536 "cocos nucifera"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411536 "coconut palm plant"@en)
SubClassOf(obo:FOODON_03411536 obo:FOODON_03411022)
SubClassOf(obo:FOODON_03411536 obo:FOODON_03411286)
