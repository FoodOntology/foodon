# Class: <http://purl.obolibrary.org/obo/FOODON_03411002> (archaeogastropod)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411002> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411002> "Archaeogastropoda (also known as *Aspidobranchia*) was a taxonomic order of sea snails used in older classifications of gastropods, i.e. snails and slugs. *Archeogastropoda* are marine prosobranch gastropod mollusks, mainly mainly herbivores, typically having two gills and a double-chambered heart, with the eggs and sperm discharged directly into the water. They were traditionally regarded as a relatively primitive group. 
[https://en.wikipedia.org/wiki/Archaeogastropoda]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411002> <http://www.langual.org/langual_thesaurus.asp?termid=B1002>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411002> "aspidobranchia"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411002> "archaeogastropod"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411002> <http://purl.obolibrary.org/obo/FOODON_03412111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411005> (stem or spear vegetable plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/FOODON_03411005> "Examples of stem vegetables are kohlrabi, celery, fennel and rhubarb.  Examples of shoot vegetables are asparagus, hop, bamboo shoots and taugé."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411005> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411005> "A vegetable having shoot or stem which can be cooked and eaten."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_03411005> <https://orcid.org/0000-0001-5275-8866>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411005> <http://www.langual.org/langual_thesaurus.asp?termid=B1005>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411005> "shoot vegetable"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411005> "spear vegetable"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411005> "stem or spear vegetable plant"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_03411005> <http://foodcommodities.nl/commodities/vegetables.html>)
