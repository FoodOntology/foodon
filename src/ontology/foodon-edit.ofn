AnnotationAssertion(go:hasSynonym obo:FOODON_03414164 "cetacea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414164 "cetacean marine mammal"@en)
SubClassOf(obo:FOODON_03414164 obo:FOODON_03411122)

# Class: obo:FOODON_03414165 (pinniped group)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414165 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414165 "Pinnipeds (from Latin pinna, wing or fin, and ped-, foot) or fin-footed mammals are a widely distributed and diverse group of semiaquatic marine mammals comprising the families *Odobenidae* (the walrus), *Otariidae* (eared seals, including sea lions and fur seals), and *Phocidae* (earless seals)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414165 "WIKIPEDIA:Pinniped")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414165 langual:B4165)
AnnotationAssertion(rdfs:label obo:FOODON_03414165 "pinniped group"@en)
SubClassOf(obo:FOODON_03414165 obo:FOODON_03411122)

