# Class: obo:FOODON_03414476 (polyplacophoran)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414476 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414476 "Chitons are small to large marine molluscs in the class *Polyplacophora*, which formerly was known as *Amphineura*. There are approximately 940 extant and 430 fossil species recognized. These molluscs are also sometimes commonly known as sea cradles or \"coat-of-mail shells\". They are also sometimes referred to more formally as loricates, polyplacophorans, and rarely as polyplacophores. Chitons have a dorsal shell which is composed of eight separate shell plates or valves. These plates overlap somewhat at the front and back edges, and yet the plates articulate well with one another."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414476 "WIKIPEDIA:Polyplacophora")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414476 <http://eol.org/pages/2680>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414476 langual:B4476)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "amphineura"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "chiton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "chíton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "loricate"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "polplacophore"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414476 "polyplacophora"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414476 "polyplacophoran"@en)
SubClassOf(obo:FOODON_03414476 obo:FOODON_03412112)

# Class: obo:FOODON_03414477 (black katy chiton)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414477 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414477 "Katharina tunicata (Wood, 1815) is commonly known as the Black Katy chiton, Black Leather chiton, Black chiton, or Leather chiton. Capable of growing up to 12 cm, the animal is generally described as being football-shaped with a black leathery girdle in which are embedded eight protective plates. The parts of the plates that are visible are sometimes (but not always) diamond-shaped in outline. The underside of the animal is dull orange or yellow."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414477 <http://eol.org/pages/450283>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414477 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=78979>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414477 langual:B4477)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414477 "black chiton")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "black chiton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "black leather chiton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "gumboots"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "katharina tunicata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "leather chiton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414477 "leathery chiton"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414477 "black katy chiton"@en)
SubClassOf(obo:FOODON_03414477 obo:FOODON_03414476)
SubClassOf(obo:FOODON_03414477 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_34587))

