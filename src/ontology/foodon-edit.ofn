AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8795 "Pterocnemia pennata  (Orbigny, 1834)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8795 "darwin's rhea"@en)
