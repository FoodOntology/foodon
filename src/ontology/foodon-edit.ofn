AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411248 "brassica napus"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411248 "rape plant"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411248 "Brassica napus L. emend. Metzg. var. napus")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411248 "canola"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411248 "canola plant"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411248 "oilseed rape plant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411248 "rapeseed plant"@en)
SubClassOf(obo:FOODON_03411248 obo:FOODON_03411017)
SubClassOf(obo:FOODON_03411248 obo:FOODON_03413372)

