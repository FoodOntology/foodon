AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413454 "CEC1993:1264")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413454 "Astacus leptodactylus Eschscholtz, 1823")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413454 "Astacus leptodactylus Eschscholz, 1823")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413454 "astacus leptodactylus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413454 "galician crayfish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413454 "danube crayfish"@en)
SubClassOf(obo:FOODON_03413454 obo:FOODON_03414139)

