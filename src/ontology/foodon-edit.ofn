AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52471 "PLANTS:FEAS2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52471 "Ferula assa-foetida L.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52471 "Ferula foetida (Bunge) Regel")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52471 "asafoetida"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52471 "devil's dung"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52471 "ferula assa-foetida"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52471 "ferula foetida"@en)
SubClassOf(obo:NCBITaxon_52471 obo:FOODON_03411179)

# Class: obo:NCBITaxon_52570 (Trachyspermum ammi)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_52570 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_52570 "Ajwain, ajowan *Trachyspermum ammi*, also known as Ajowan caraway, Oomam in Tamil, bishop's weed or carom, is an annual herb in the family *Apiaceae*. It originated in India. Both the leaves and the fruit (often mistakenly called seeds) of the plant are consumed by humans. The plant is also called bishop's weed, but this is a common name it shares with some other different plants. The \"seed\" (i.e., the fruit) is often confused with lovage \"seed\".[https://en.wikipedia.org/wiki/Ajwain]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_52570 "ajowan plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52570 <http://eol.org/pages/477954>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52570 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36803>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52570 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=522739>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52570 langual:B2515)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52570 "PLANTS:TRAM13")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52570 "Apiaceae")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52570 "Trachyspermum ammi (L.) Sprague ex Turrill")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "aiwain"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "ajawain"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "ajowan caraway"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "ajwain"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "ajwan"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "bishop's weed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "carom"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "carum copticum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "ooman"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52570 "trachyspermum copticum"@en)
SubClassOf(obo:NCBITaxon_52570 obo:FOODON_03411179)

