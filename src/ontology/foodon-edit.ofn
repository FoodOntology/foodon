AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415165 "Krameria lappacea (Dombey) Burdet & B. B. Simpson")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415165 "krameria"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415165 "rhatany"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415165 "ratany plant"@en)
SubClassOf(obo:FOODON_03415165 obo:FOODON_03413359)

