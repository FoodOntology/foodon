# Class: obo:NCBITaxon_41492 (Bellis perennis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_41492 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_41492 "*Bellis perennis* is a common European species of daisy, of the *Asteraceae* family, often considered the archetypal species of that name. Many related plants also share the name \"daisy\", so to distinguish this species from other daisies it is sometimes qualified as common daisy, lawn daisy or English daisy. This daisy may be used as a potherb. Flower buds and petals can be eaten raw in sandwiches, soups and salads. It is also used as a tea and as a vitamin supplement. *Bellis perennis* has astringent properties and has been used in herbal medicine. 
[https://en.wikipedia.org/wiki/Bellis_perennis]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_41492 "common daisy plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41492 <http://eol.org/pages/467843>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41492 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6728>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41492 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=36826>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41492 langual:B5089)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41492 "PLANTS:BEPE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_41492 "Bellis perennis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41492 "bellis perennis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41492 "english daisy"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41492 "lawndaisy"@en)
SubClassOf(obo:NCBITaxon_41492 obo:FOODON_03411566)

# Class: obo:NCBITaxon_41496 (Calendula officinalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_41496 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_41496 "*Calendula officinalis*, the pot marigold, ruddles, common marigold or Scotch marigold, is a plant in the genus *Calendula* of the family *Asteraceae*. Pot marigold florets are edible. They are often used to add color to salads or added to dishes as a garnish and in lieu of saffron. The leaves are edible but are often not palatable. They have a history of use as a potherb and in salads."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_41496 "marigold plant (Calendula)"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_41496 "https://en.wikipedia.org/wiki/Calendula_officinalis"^^xsd:anyURI)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41496 <http://eol.org/pages/467729>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41496 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8457>)
