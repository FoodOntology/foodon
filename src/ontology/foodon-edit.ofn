AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49992 "PLANTS:THVU")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_49992 "common thyme"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_49992 "garden thyme"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_49992 "thymus vulgaris"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_49992 "Thymus vulgaris L.")
