AnnotationAssertion(go:hasSynonym obo:FOODON_03414739 "peppercress"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414739 "peppergrass"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414739 "pepperwort"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414739 "pepperweed plant"@en)
SubClassOf(obo:FOODON_03414739 obo:FOODON_03413372)

