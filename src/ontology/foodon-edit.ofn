AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_113544 "A species of arapaima native to the basin of the Amazon River. Once believed to be the sole species in the genus, it is among the largest freshwater fish. The species is an obligate air-breather and needs to come to the surface regularly to gulp air."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_113544 "arapaima"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_113544 wikipedia:Arapaima_gigas)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_113544 <http://eol.org/pages/204868>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_113544 langual:B4870)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_113544 asfis:arp)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_113544 "Arapaima gigas"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_113544 "pirarucu"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_113544 "Arapaima gigas")
SubClassOf(obo:NCBITaxon_113544 obo:FOODON_03414560)

# Class: obo:NCBITaxon_1137871 (Herniaria hirsuta)

