# Class: obo:FOODON_03411236 (turkey (bird))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411236 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411236 "The turkey is a large bird in the genus Meleagris, which is native to the Americas. Males of both turkey species have a distinctive fleshy wattle or protuberance that hangs from the top of the beak (called a snood). They are among the largest birds in their ranges. As in many galliformes, the male is larger and much more colorful than the female."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411236 <https://en.wikipedia.org/wiki/Turkey_(bird)>)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_03411236 "turkey"@en)
