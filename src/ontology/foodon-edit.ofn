# Class: obo:NCBITaxon_155124 (Aspalathus linearis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_155124 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_155124 "Rooibos, \"red bush\"; scientific name *Aspalathus linearis* is a broom-like member of the legume family of plants growing in South Africa's fynbos.
 
The generic name comes from the plant Calicotome villosa, aspalathos in Greek. This plant has very similar growth and flowers to the redbush. The specific name linearis comes from the plant's linear growing structure and needle-like leaves.

 The plant is used to make a herbal tea called rooibos tea, bush tea (esp. Southern Africa), redbush tea (esp. UK), South African red tea, or red tea. The product has been popular in Southern Africa for generations and is now consumed in many countries. It is sometimes spelled rooibosch in accordance with the old Dutch etymology."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_155124 "rooibos plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_155124 "WIKIPEDIA:Aspalathus_linearis")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_155124 <http://eol.org/pages/4277>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_155124 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?310979>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_155124 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506239>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_155124 langual:B2057)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_155124 "PLANTS:ASLI14")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_155124 "Aspalathus linearis (Burm. f.) R. Dahlgren")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_155124 "Aspalathus linearis (Burman f.) R. Dahlgren")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_155124 "aspalathus linearis"@en)
SubClassOf(obo:NCBITaxon_155124 obo:FOODON_03411179)

