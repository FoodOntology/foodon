AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414861 "Clarias"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414861 "Clarias Scopoli, 1777")
AnnotationAssertion(rdfs:label obo:FOODON_03414861 "clarias catfish"@en)
SubClassOf(obo:FOODON_03414861 obo:FOODON_03411901)

# Class: obo:FOODON_03414863 (amur catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414863 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414863 "A species of catfish (sheatfish), family Siluridae. It is a large freshwater fish found in continental East Asia and in Japan."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414863 wikipedia:Amur_catfish)
