SubClassOf(obo:FOODON_03411568 obo:NCBITaxon_4640)

# Class: obo:FOODON_03411573 (fish, atheriniform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411573 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411573 "The Atheriniformes, also known as the silversides, are an order of ray-finned fishes that includes the Old World silversides and several less-familiar families, including the unusual *Phallostethidae*. The order includes at least 354 species. They are found worldwide in tropical and temperate marine and freshwater environments. [https://en.wikipedia.org/wiki/Atheriniformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411573 <http://eol.org/pages/8268>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411573 langual:B1573)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411573 "atheriniformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411573 "fish, atheriniform"@en)
SubClassOf(obo:FOODON_03411573 obo:FOODON_03411365)

# Class: obo:FOODON_03411574 (fish, anguilliform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411574 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411574 "An eel is any fish belonging to the order Anguilliformes, which consists of four suborders, 20 families, 111 genera and about 800 species. Most eels are predators. The term \"eel\" (originally referring to the European eel) is also used for some other similarly shaped fish, such as electric eels and spiny eels, but these are not members of the Anguilliformes order. [https://en.wikipedia.org/wiki/Eel]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411574 <http://eol.org/pages/8280>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411574 langual:B1574)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411574 "anguilliformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411574 "fish, anguilliform"@en)
SubClassOf(obo:FOODON_03411574 obo:FOODON_03411365)

