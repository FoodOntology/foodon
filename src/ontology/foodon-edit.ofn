AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_43691 "WIKIPEDIA:Canarium_ovatum")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43691 <http://eol.org/pages/483518>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43691 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8819>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43691 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506413>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43691 langual:B1289)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43691 "PLANTS:CAOV7")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_43691 "canarium ovatum"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_43691 "pili nut tree"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_43691 "Canarium ovatum Engl.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_43691 "Canarium ovatum Engler")
AnnotationAssertion(rdfs:comment obo:NCBITaxon_43691 "LanguaL curation note: When indexing the pili fruit (drupe, seed) index both *PILI TREE [B1289]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
SubClassOf(obo:NCBITaxon_43691 obo:FOODON_03415026)

# Class: obo:NCBITaxon_43700 (Monopterus albus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_43700 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_43700 "A commercially important, air-breathing species of fish in the Synbranchidae family. Originating in the waters of East and Southeast Asia, it has been identified as an invasive species in the North American Everglades."@en)
