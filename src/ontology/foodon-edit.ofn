AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39304 "MSW3:14001032")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_39304 "Erignathus barbatus (Erxleben, 1777)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39304 "erignathus barbatus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39304 "oogruk"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39304 "square flipper seal"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39304 "squareflipper"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39304 "ugruk"@en)
