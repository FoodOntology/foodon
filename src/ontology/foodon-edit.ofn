# Class: <http://purl.obolibrary.org/obo/NCBITaxon_548163> (<http://purl.obolibrary.org/obo/NCBITaxon_548163>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_548163> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "The smooth leatherjacket or velvet leatherjacket, *Meuschenia scaber*, is a filefish of the family *Monacanthidae*, found off eastern Australia and all around New Zealand to depths of about 100 m, on rocky weedy reef areas. Its length is between 25 and 35 cm. In New Zealand it is simply known as leatherjacket as it is the only fish of this family commonly found there."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "velvet leatherjacket"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "WIKIPEDIA:Velvet_Leatherjacket")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_548163> <http://eol.org/pages/217899>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_548163> <http://www.langual.org/langual_thesaurus.asp?termid=B4290>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_548163> <https://www.fao.org/fishery/en/aqspecies/pkb>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_548163> <https://www.frdc.com.au/knowledge-hub/standards/37465005>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "Meuschenia scaber")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "Parika scaber (Forster, 1801)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_548163> "meuschenia scaber"@en)
