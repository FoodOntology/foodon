AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415016 "polypodium virginianum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415016 "polypodium vulgare"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415016 "common polypody plant"@en)
