AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414334 "Plantago major L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414334 "broadleaf plantain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414334 "common plantain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414334 "plantago major"@en)
