AnnotationAssertion(go:hasDbXref obo:NCBITaxon_151250 "PLANTS:SAKAP")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_151250 "Salsola kali L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_151250 "common saltwort"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_151250 "prickly russian thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_151250 "russian thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_151250 "tumbleweed"@en)
