# Class: obo:NCBITaxon_8182 (Pomoxis nigromaculatus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8182 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8182 "The black crappie, *Pomoxis nigromaculatus* (Lesueur, 1829), is very similar to *P. annularis* in size, shape, and habits, except that it is darker, with a pattern of black spots. The black crappie has 7-8 spines on its dorsal fin. The number of spines on the dorsal fin, is occasionally the only way to differeniate between a juvenile black crappie and a white crappie. The black crappie tends to prefer clearer water than the white crappie does. Its native range is uncertain, since it has been so widely transplanted, but it is presumed to be similar to the white crappie's. The black crappie is also known as the strawberry bass or Oswego bass. ("@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8182 "black crappie"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8182 "WIKIPEDIA:White_crappie)")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8182 <http://eol.org/pages/225242>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8182 langual:B1819)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8182 asfis:pxg)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8182 "CEC1993:597")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8182 "Pomoxis nigromaculatus")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8182 "crappie, black"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8182 "pomoxis nigromaculatus"@en)
SubClassOf(obo:NCBITaxon_8182 obo:FOODON_03411409)

# Class: obo:NCBITaxon_8187 (Lates calcarifer)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8187 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8187 "The barramundi or Asian sea bass, is a species of catadromous fish in the family Latidae of the order Perciformes. The species is widely distributed in the Indo-West Pacific region from South Asia to Papua New Guinea and Northern Australia. The fish is known as pla kapong in Thai and as bhetki in Bengali."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8187 "barramundi"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8187 "https://en.wikipedia.org/wiki/Barramundi"^^xsd:anyURI)
