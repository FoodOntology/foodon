# Class: obo:FOODON_03412368 (sandperch family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412368 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412368 "The sandperches are a family, *Pinguipedidae*, of fishes in the order Perciformes. Sandperches typically live on sand or rubble substrates in shallow seas. The anterior end of the fish is cylindrical and the posterior end partially flattened. The eyes are on the top of the head and the fish lie on the seabed, propped up by their widely separated pelvic fins. [https://en.wikipedia.org/wiki/Sandperch]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412368 <http://eol.org/pages/5265>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412368 langual:B2368)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412368 "pinguipedidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412368 "sandperch family"@en)
SubClassOf(obo:FOODON_03412368 obo:FOODON_03411581)

