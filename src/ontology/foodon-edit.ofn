AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414273 "potassium bitartrate"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414273 "potassium hydrogen tartrate"@en)
SubClassOf(obo:FOODON_03414273 obo:FOODON_03411041)

# Class: obo:FOODON_03414274 (whitespot giant arum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414274 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414274 "Amorphophallus paeoniifolius, the Elephant foot yam or Whitespot giant arum  or Stink lily, is a tropical tuber crop that offers excellent scope for adoption in the tropical countries as a cash crop due to its production potential and popularity as a vegetable in various delicious cuisines."@en)
