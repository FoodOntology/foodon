AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002903> "2019-08-09T15:34:19Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002903> "Cyclocheilichthys enoplos (Bleeker, 1849)"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002903> "Soldier river barb"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_00002903> <https://en.wikipedia.org/wiki/Cyclocheilichthys_enoplos>)
