AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414484 langual:B4484)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414484 "North Pacific giant octopus")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414484 "giant octopus")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414484 "enteroctopus dofleini"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414484 "north pacific giant octopus"@en)
