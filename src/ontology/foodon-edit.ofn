# Class: obo:FOODON_03411366 (carob bean plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411366 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411366 "Ceratonia siliqua, commonly known as the carob tree or carob bush, from Arabic خَرُّوبٌ (kharrūb) and Hebrew חרוב (haruv), St John's-bread, or locust bean (not to be confused with the African locust bean), or simply locust-tree, is a species of flowering evergreen shrub or tree in the pea family, Fabaceae"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411366 langual:B1366)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411366 "ceratonia siliqua"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411366 "locust bean"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411366 "carob bean plant"@en)
SubClassOf(obo:FOODON_03411366 obo:FOODON_03411014)
SubClassOf(obo:FOODON_03411366 obo:FOODON_03411179)

# Class: obo:FOODON_03411367 (broad bean plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411367 "Vicia faba, the Broad Bean, is a species of bean (*Fabaceae*) native to north Africa and southwest Asia, and extensively cultivated elsewhere. A variety is provisionally recognized: Vicia faba var. equina Pers. - Horse Bean.  Although usually classified in the same genus Vicia as the vetches, some botanists treat it in a separate monotypic genus *Faba*. The term fava bean (from the Italian fava, meaning \"broad bean\") is usually used in English speaking countries such as the US, however the term broad bean is the most common name in the UK."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411367 "WIKIPEDIA:Vicia_faba")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03411367 "vicia faba"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411367 <http://eol.org/pages/4277>)
