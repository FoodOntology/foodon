# Class: obo:FOODON_03412517 (oriental cashew plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412517 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412517 "Semecarpus anacardium is a native of India, found in the outer Himalayas to Coromandel Coast. It is closely related to the cashew.It is known as bhallatak in India and was called \"marking nut\" by Europeans, because it was used by washermen to mark cloth and clothing before washing, as it imparted a water insoluble mark to the cloth. It is also known as ker beeja in Kannada and bibba in Marathi."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412517 <http://eol.org/pages/483492>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412517 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33598>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412517 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506459>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412517 langual:B2517)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412517 "PLANTS:SEAN7")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412517 "markingnut tree"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412517 "semecarpus anacardium"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412517 "oriental cashew plant"@en)
SubClassOf(obo:FOODON_03412517 obo:FOODON_03411022)
SubClassOf(obo:FOODON_03412517 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_289767))

# Class: obo:FOODON_03412518 (fuzzy melon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412518 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412518 "The winter melon, also called ash gourd, white gourd, wax gourd, winter gourd, tallow gourd, ash pumpkin, and Chinese preserving melon is a vine grown for its very large fruit, eaten as a vegetable when mature. It is the only member of the genus *Benincasa*. The fruit is fuzzy when young. The immature melon has thick white flesh that is sweet when eaten. By maturity, the fruit loses its hairs and develops a waxy coating, giving rise to the name wax gourd, and providing a long shelf life.[https://en.wikipedia.org/wiki/Winter_melon]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412518 <http://eol.org/pages/484058>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412518 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6746>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412518 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505894>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412518 langual:B2518)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412518 "PLANTS:BEHI3")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412518 "ash gourd")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412518 "wax gourd")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412518 "winter melon")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "benincasa hispida var."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "chinese vegetable marrow"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "hairy melon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "mogwa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "tallow gourd"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "waxgourd"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412518 "winter melon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412518 "fuzzy melon plant"@en)
SubClassOf(obo:FOODON_03412518 obo:FOODON_03412091)
SubClassOf(obo:FOODON_03412518 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_102211))

# Class: obo:FOODON_03412519 (ground cherry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412519 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412519 "Physalis is a genus of flowering plants in the nightshade family (*Solanaceae*), which grow in warm temperate and subtropical regions of the world. Most of the species, of which there may be 75-90, are indigenous to the New World. Cultivated species and weedy annuals have been introduced worldwide. A notable feature is the formation of a large papery husk derived from the calyx, which partly or fully encloses the fruit. The fruit is small and orange, similar in size, shape and structure to a small tomato.[https://en.wikipedia.org/wiki/Physalis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412519 <http://eol.org/pages/4437>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412519 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300461>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412519 langual:B2519)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412519 "PLANTS:PHYSA")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412519 "Physalis L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412519 "Physalis spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412519 "groundcherry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412519 "husk tomato"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412519 "physalis spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412519 "ground cherry plant"@en)
SubClassOf(obo:FOODON_03412519 obo:FOODON_03411006)
SubClassOf(obo:FOODON_03412519 obo:FOODON_03414934)

# Class: obo:FOODON_03412520 (tayberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412520 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412520 "A cross between red raspberry and other bramble berry species [The Plant Book, Cambridge University Press 1990, page 571]. Tayberry (*Rubus idaeus x fruticosus*) is a cultivated shrub in the genus *Rubus* of the family *Rosaceae* patented in 1979 as a cross between a loganberry and the black raspberry ."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412520 "WIKIPEDIA:Tayberry")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412520 <http://eol.org/pages/8097>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412520 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?104968>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412520 langual:B2520)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412520 "Rubus loganobaccus L. H. Bailey")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412520 "rubus idaeus x fructicosus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412520 "tayberry plant"@en)
SubClassOf(obo:FOODON_03412520 obo:FOODON_03411121)

# Class: obo:FOODON_03412523 (red kuri squash plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412523 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412523 "Red kuri squash is thin skinned orange colored winter squash, that has the appearance of a small pumpkin without the ridges. It belongs to the Hubbard squash group. Inside the hard outer skin there is a firm flesh that provides a very delicate and mellow chestnut-like flavor.

Red kuri squash is commonly called \"Japanese squash\", \"orange Hokkaido squash\", \"baby red hubbard squash\", or \"Uchiki kuri squash\". In Japan, the word kuri may refer to either the squash discussed in this article or to Japanese chestnuts. In France, it is called potimarron, and in the United Kingdom, it is commonly called \"onion squash\".[https://en.wikipedia.org/wiki/Red_kuri_squash]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412523 <http://eol.org/pages/584406>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412523 obo:NCBITaxon_3661)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412523 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22369>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412523 langual:B2523)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412523 "Cucurbita maxima Duchesne")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412523 "Hokkaido squash"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412523 "red Hokkaido squash"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412523 "sweet meat squash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412523 "japanese pumpkin"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412523 "japanese squash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412523 "kabocha squash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412523 "kuri squash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412523 "nam gwa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412523 "red kuri squash plant"@en)
SubClassOf(obo:FOODON_03412523 obo:FOODON_03412511)

