# Class: obo:FOODON_00004311 (pangium edule plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00004311 "Pangium edule (Indonesian: keluak or keluwak;Malay: kepayang) is a tall tree native to the mangrove swamps of Southeast Asia (Indonesia, Malaysia and Papua New Guinea). It produces a large poisonous fruit (the \"football fruit\") which can be made edible by fermentation. In Singapore and Malaysia, the seeds are best known as an essential ingredient in ayam (chicken) or babi (pork) buah keluak, a mainstay of Peranakan cuisine. Alternatively, the kernels may be ground up to form a thick black gravy called rawan (or rawon in parts of Indonesia)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_00004311 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?26427>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_00004311 langual:B4496)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_00004311 "PLANTS:PAED4")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_00004311 "rowal"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00004311 "pangium edule plant"@en)
SubClassOf(obo:FOODON_00004311 obo:FOODON_03411174)
SubClassOf(obo:FOODON_00004311 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_112823))

