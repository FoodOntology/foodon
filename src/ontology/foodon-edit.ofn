# Class: obo:NCBITaxon_294739 (Mentha pulegium)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_294739 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_294739 "Pennyroyal refers to two plants in the mint family, *Lamiaceae*. The European pennyroyal, *Mentha pulegium*, (also called Squaw Mint, Mosquito Plant, and Pudding Grass), is a plant in the mint genus, within the family *Lamiaceae*. Crushed Pennyroyal leaves exhibit a very strong fragrance similar to spearmint. Pennyroyal is a traditional culinary herb, folk remedy, and abortifacient. The essential oil of pennyroyal is used in aromatherapy, and is also high in pulegone, a highly toxic volatile organic compound affecting liver and uterine function."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_294739 "european pennyroyal plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294739 <http://eol.org/pages/579696>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294739 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24079>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294739 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32270>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294739 langual:B4341)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294739 "PLANTS:MEPU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_294739 "Mentha pulegium L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_294739 "mentha pulegium"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_294739 "pennyroyal"@en)
SubClassOf(obo:NCBITaxon_294739 obo:FOODON_03411267)

# Class: obo:NCBITaxon_294740 (Mentha requienii)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_294740 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_294740 "*Mentha requienii*, or Corsican mint, is a herb and species of mint, native to Corsica, Sardinia, and mainland Italy, and naturalized in Portugal and in the British Isles. It is a very low-growing species with bright green leaves and a strong minty aroma. [https://en.wikipedia.org/wiki/Mentha_requienii]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_294740 "corsican mint plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294740 <http://eol.org/pages/483864>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294740 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?313206>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294740 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506031>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294740 langual:B5006)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_294740 "PLANTS:MERE7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_294740 "Mentha requienii Benth.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_294740 "mentha requienii"@en)
SubClassOf(obo:NCBITaxon_294740 obo:FOODON_03411267)

