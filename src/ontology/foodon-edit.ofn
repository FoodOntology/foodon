AnnotationAssertion(go:hasDbXref obo:FOODON_03411200 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=27018>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411200 langual:B1200)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411200 "MANSFELD:27303")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411200 "PLANTS:VIUN")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411200 "Vigna unguiculata (L.) Walp.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411200 "Vigna unguiculata (L.) Walp. ssp. unguiculata")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411200 "vigna sinensis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411200 "vigna unguiculata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411200 "cowpea plant"@en)
