AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03530253 "organic plant production"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03530253 "Foods produced in accordance with Council Regulation (EC) No 834/2007 of 28 June 2007 on organic production and labelling of organic products and repealing Regulation (EEC) No 2092/91."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530253 "organic plant cultivation"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03530253 <http://eur-lex.europa.eu/LexUriServ/LexUriServ.do?uri=OJ:L:2007:189:0001:0023:EN:PDF>)
