AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03415041> "curcuma xanthorrhiza"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03415041> "curcuma zanthorrhiza"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03415041> "temulawak plant"@en)
