# Class: obo:FOODON_03510020 (infant or toddler as food consumer)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510020 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510020 "Food produced and marketed to supply the particular dietary needs of normal infants (21 CFR 105.65) or normal toddlers (age 1 to 2 years). Junior foods are included with the strained foods for infants up to one year. Foods fall in this category only if the label bears a statement such as 'baby food', 'strained food', 'junior food' or 'toddler food'."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510020 langual:P0020)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03510020 "junior food"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03510020 "toddler food"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510020 "infant or toddler as food consumer"@en)
SubClassOf(obo:FOODON_03510020 obo:FOODON_03510256)

