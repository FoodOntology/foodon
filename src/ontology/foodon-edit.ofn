# Class: <http://purl.obolibrary.org/obo/FOODON_03510131> ("less" label claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510131> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510131> <http://www.langual.org/langual_thesaurus.asp?termid=P0131>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510131> "less, label claim"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510131> "LanguaL curation note: Used on label comparison statements to describe foods having 25% or greater reductions in a nutrient. (U.S. proposed)"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510131> "\"less\" label claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510131> <http://purl.obolibrary.org/obo/FOODON_03510059>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510132> ("light" label claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510132> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510132> "A claim stating that a product is \"light\" or \"lite\", and any claim likely to have the same meaning for the consumer, shall follow the same conditions as those set for the term \"reduced\", see *REDUCED {NAME OF NUTRIENT} NUTRITION CLAIM [P0132]*; the claim shall also be accompanied by an indication of the characteristic(s) which make(s) the food \"light\" or \"lite\" [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].

Used for foods that have 33.3% fewer calories than a comparable product and a minimum reduction of more than 40 calories per serving. Any other use of 'light' must specify whether it refers to the look, taste or smell; for example, 'light in color'. (U.S. FDA proposed)"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510132> <http://www.langual.org/langual_thesaurus.asp?termid=P0132>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510132> "light, label claim"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510132> "\"light\" label claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510132> <http://purl.obolibrary.org/obo/FOODON_03510059>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510133> ("more" label claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510133> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510133> <http://www.langual.org/langual_thesaurus.asp?termid=P0133>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510133> "more, label claim"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510133> "LanguaL curation note: Used in label comparison statement when a food contains at least 10% more of the daily nutritional value per amount customarily consumed."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510133> "\"more\" label claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510133> <http://purl.obolibrary.org/obo/FOODON_03510059>)

