# Class: obo:FOODON_03414226 (sugar melon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414226 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414226 "A sugar melon is a type of cantaloupe that is about five to six inches (12-15 cm) in diameter and weighing between two and a half to four pounds (1-2 kg). Nearly round in shape, it has thick, sweet, orange flesh and a ribbed exterior that is a silvery gray."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414226 "WIKIPEDIA:Sugar_melon")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414226 langual:B4226)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414226 "Cucumis melo L. var. saccharinus Naudin")
AnnotationAssertion(rdfs:label obo:FOODON_03414226 "sugar melon plant"@en)
SubClassOf(obo:FOODON_03414226 obo:FOODON_03411283)

# Class: obo:FOODON_03414227 (canary melon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414227 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414227 "The Canary melon (*C. melo* (Indorus group)) is a large, bright-yellow melon with a pale green to white inner flesh. This melon has a distinctively sweet flavor that is slightly tangier than a honeydew melon."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414227 "WIKIPEDIA:Canary_melon")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414227 langual:B4227)
AnnotationAssertion(rdfs:label obo:FOODON_03414227 "canary melon plant"@en)
SubClassOf(obo:FOODON_03414227 obo:NCBITaxon_357961)

# Class: obo:FOODON_03414228 (garden rhubarb plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414228 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414228 "Rhubarb (*Rheum rhabarbarum*) is a species of plant in the family *Polygonaceae*. In culinary use, fresh raw leaf stalks (petioles) are crisp (similar to celery, although they do not share the same family) with a strong, tart taste. Although rhubarb is not a true fruit, in the kitchen it is usually prepared as if it were. [https://en.wikipedia.org/wiki/Rhubarb]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414228 <http://eol.org/pages/485576>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414228 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?311395>)
