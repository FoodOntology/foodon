AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415181 "Arenga is a genus of palms, native to Southeast Asia, southern China, New Guinea, and northern Australia. [https://en.wikipedia.org/wiki/Arenga]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415181 <http://eol.org/pages/30205>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415181 langual:B5181)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415181 "arenga spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415181 "arenga palm plant"@en)
SubClassOf(obo:FOODON_03415181 obo:FOODON_03413391)

