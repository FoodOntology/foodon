AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3886 "butter bean plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3886 "multiflora bean plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3886 "phaseolus coccineus"@en)
