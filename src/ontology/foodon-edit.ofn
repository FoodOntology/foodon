AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414680 "Australian brush-cherry")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414680 "magenta cherry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414680 "magenta lilli-pilly"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414680 "syzygium paniculatum"@en)
