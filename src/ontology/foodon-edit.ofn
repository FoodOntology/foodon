AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72332 <http://eol.org/pages/469712>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72332 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?4274>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72332 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=35445>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72332 langual:B5065)
