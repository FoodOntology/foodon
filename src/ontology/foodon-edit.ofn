AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414849 "MSW3:14100003")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414849 "Equus Linnaeus, 1758")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414849 "equidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414849 "equus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414849 "equine animal"@en)
SubClassOf(obo:FOODON_03414849 obo:FOODON_03411134)

