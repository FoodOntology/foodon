# Class: obo:FOODON_03412616 (chinese walnut tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412616 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412616 "Juglans mandshurica, the Manchurian walnut, is a deciduous tree of the genus *Juglans* (section Cardiocaryon), native to the Eastern Asiatic Region (China, Russian Far East, North Korea and South Korea). It grows to about 25 m. The kernels of the nuts are edible, but small and difficult to extract."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412616 "WIKIPEDIA:Juglans_mandshurica")
AnnotationAssertion(go:hasDbXref obo:FOODON_03412616 <http://eol.org/pages/4299>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412616 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20758>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412616 langual:B2616)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412616 "PLANTS:JUMA8")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03412616 "Juglans mandshurica Maxim.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03412616 "chinese butternut"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412616 "juglans mandshurica"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412616 "manchurian walnut"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412616 "walnut, chinese"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03412616 "LanguaL curation note: When indexing the chinese walnut fruit (drupe, seed) index both *CHINESE WALNUT [B2616]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412616 "chinese walnut tree"@en)
SubClassOf(obo:FOODON_03412616 obo:NCBITaxon_16718)

# Class: obo:FOODON_03412617 (carp)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412617 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412617 "Carp are various species of oily freshwater fish from the family *Cyprinidae*, a very large group of fish native to Europe and Asia. In colloquial use, carp usually refers only to several larger cyprinid species such as *Cyprinus carpio* (common carp), *Carassius carassius* (Crucian carp), *Ctenopharyngodon idella* (grass carp), *Hypophthalmichthys molitrix* (silver carp), and *Hypophthalmichthys nobilis* (bighead carp). [https://en.wikipedia.org/wiki/Carp]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412617 <http://eol.org/pages/3198>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412617 langual:B2617)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412617 "cyprinidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412617 "carp"@en)
SubClassOf(obo:FOODON_03412617 obo:FOODON_03411921)

