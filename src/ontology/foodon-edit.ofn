AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72332 "PLANTS:ARAB3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_72332 "Artemisia absinthium L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_72332 "artemisia absinthium"@en)
