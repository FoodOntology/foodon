# Class: obo:NCBITaxon_105667 (Prunus tomentosa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_105667 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_105667 "The Nanking cherry (*Prunus tomentosa*) is a species of *Prunus* native to northern and western China. Other common names for *P. tomentosa* include Korean cherry, Manchu cherry, downy cherry, Shanghai cherry, Ando cherry, mountain cherry, Chinese bush cherry, Chinese dwarf cherry. The fruit is edible, being an ingredient of juice, jam, and wine, and in pickled vegetables and mushrooms. [https://en.wikipedia.org/wiki/Prunus_tomentosa]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_105667 "nanking cherry plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_105667 <http://eol.org/pages/632480>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_105667 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30138>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_105667 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=504627>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_105667 langual:B5051)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_105667 "PLANTS:PRTO80")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_105667 "Prunus tomentosa Thunb.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_105667 "korean cherry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_105667 "manchu cherry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_105667 "prunus tomentosa"@en)
