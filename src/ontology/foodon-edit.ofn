SubClassOf(obo:FOODON_03414479 obo:FOODON_03411316)

# Class: obo:FOODON_03414481 (mudminnow family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414481 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414481 "Umbridae (mudminnows) are a family of *Actinopterygii*, ray-finned fish that inhabit freshwater environments in temperate regions across the Northern Hemisphere. They are generally small fish, with the largest species reaching 33 centimetres (13 in) in length, and most less than half that."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414481 "WIKIPEDIA:Umbridae")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414481 <http://eol.org/pages/5508>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414481 langual:B4481)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414481 "umbridae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414481 "mudminnow family"@en)
SubClassOf(obo:FOODON_03414481 obo:FOODON_03413808)

