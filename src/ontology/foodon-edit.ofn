# Class: obo:NCBITaxon_39090 (Phoca largha)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_39090 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_39090 "The spotted seal (*Phoca largha*, *Phoca vitulina largha*), also known as the larga or largha seal, is a member of the family *Phocidae*, and is considered a \"true seal\". It inhabits ice floes and waters of the north Pacific Ocean and adjacent seas."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_39090 "spotted seal"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_39090 "WIKIPEDIA:Spotted_seal")
