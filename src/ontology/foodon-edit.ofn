AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430104 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430104 "A food material characteristic which indicates a collection of both wholely formed food items as well as severed pieces."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430104 langual:E0104)
AnnotationAssertion(rdfs:label obo:FOODON_03430104 "whole and pieces (sensu food)"@en)
