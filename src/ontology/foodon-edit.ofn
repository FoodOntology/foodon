# Class: obo:FOODON_03414051 (char)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414051 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414051 "A genus of salmonid fish often called char or charr; some species are called \"trout\". Salvelinus is a member of the subfamily Salmoninae within the family Salmonidae. The genus has a northern circumpolar distribution, and most of its members are typically cold-water fish that primarily inhabit fresh waters. Many species also migrate to the sea."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03414051 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414051 wikipedia:Salvelinus)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414051 <http://eol.org/pages/5158>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414051 langual:B4051)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414051 "charr"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414051 "salvelinus spp."@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414051 "Salvelinus Richardson, 1836")
AnnotationAssertion(rdfs:label obo:FOODON_03414051 "char"@en)
SubClassOf(obo:FOODON_03414051 obo:FOODON_03413807)

