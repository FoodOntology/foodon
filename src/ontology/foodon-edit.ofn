# Class: obo:FOODON_03414503 (hedge mustard plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414503 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414503 "Hedge mustard (*Sisymbrium officinale*) is a plant in the family *Brassicaceae*. It is found on roadsides and wasteland, and as a weed of arable land. A native of Europe and North Africa, it is now well-established throughout the world.

 It is distinct from the Mustard plants which belong to the genus Brassica."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414503 <http://eol.org/pages/583773>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414503 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?34458>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414503 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=23316>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414503 langual:B4503)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414503 "PLANTS:SIOF")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414503 "hedge mustard"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414503 "hedge-mustard"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414503 "sisymbrium officinale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414503 "hedge mustard plant"@en)
SubClassOf(obo:FOODON_03414503 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03414503 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_203582))

# Class: obo:FOODON_03414504 (tahitian spinach plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414504 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414504 "Xanthosoma brasiliense (Desf.) Engl. This particular taro was developed for its yield of edible leaves and stems rather than its roots. Food: the leaves and leaf stems are eaten as a cooked, green vegetable; the stems are widely used as a celery substitute in tropical areas. [http://greenharvest.com.au/Plants/Information/TahitianSpinach.html]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414504 <http://eol.org/pages/1127778>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414504 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?42083>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414504 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42583>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414504 langual:B4504)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414504 "PLANTS:XABR")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414504 "tahitian taro"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414504 "xanthosoma brasiliense"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414504 "tahitian spinach plant"@en)
SubClassOf(obo:FOODON_03414504 obo:FOODON_03411057)
SubClassOf(obo:FOODON_03414504 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_513163))

# Class: obo:FOODON_03414505 (scallop squash plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414505 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414505 "Pattypan squash, sunburst squash, cibleme in Cajun French, white squash, scallopini or yellow squash in Australian English, is a summer squash (species *Cucurbita pepo*) notable for its small size, round and shallow shape, and scalloped edges, somewhat resembling a small toy top, or flying saucer."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414505 "WIKIPEDIA:Pattypan_squash")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414505 langual:B4505)
