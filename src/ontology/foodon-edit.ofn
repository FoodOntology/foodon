AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13894 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42451>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13894 langual:B1536)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13894 "MANSFELD:10983")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13894 "PLANTS:CONU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_13894 "Cocos nucifera L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13894 "coconut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13894 "cocos nucifera"@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_13894 "LanguaL curation note: When indexing the coconut palm fruit (drupe, seed) index both *COCONUT PALM [B1130]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
SubClassOf(obo:NCBITaxon_13894 obo:FOODON_03411022)
SubClassOf(obo:NCBITaxon_13894 obo:FOODON_03411286)

