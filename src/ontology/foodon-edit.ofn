AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510062 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510062 "A claim that a food is low in sugars, and any claim likely to have the same meaning for the consumer, may only be made where the product contains no more than 5 g of sugars per 100 g for solids or 2,5 g of sugars per 100 ml for liquids [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].

Not defined in U.S. Federal Register; no basis for a recommended intake."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510062 langual:P0062)
AnnotationAssertion(rdfs:label obo:FOODON_03510062 "low sugars food"@en)
SubClassOf(obo:FOODON_03510062 obo:FOODON_03510090)

