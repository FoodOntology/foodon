# Class: obo:NCBITaxon_9718 (Pusa hispida)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9718 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9718 "The ringed seal (*Pusa hispida*), also known as the jar seal and as netsik or nattiq by the Inuit, is an earless seal (family: Phocidae) inhabiting the Arctic and sub-Arctic regions... Ringed seals occur throughout the Arctic Ocean. They can be found in the Baltic Sea, the Bering Sea and the Hudson Bay. They prefer to rest on ice floe and will move farther north for denser ice. One subspecies can be found in freshwater."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9718 "ringed seal"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9718 "WIKIPEDIA:Pusa_hispida")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9718 <http://eol.org/pages/1052724>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9718 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=622018>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9718 langual:B4498)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9718 "Pusa hispida (Schreber, 1775)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9718 "jar seal"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9718 "pusa hispida"@en)
SubClassOf(obo:NCBITaxon_9718 obo:FOODON_03411341)

# Class: obo:NCBITaxon_97441 (Viola odorata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_97441 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_97441 "*Viola odorata* is a species of the genus Viola, native to Europe and Asia, but has also been introduced to North America and Australia. It is commonly known as wood violet, sweet violet, English violet, common violet, florist's violet, or garden violet. [https://en.wikipedia.org/wiki/Viola_odorata]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_97441 "sweet violet plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_97441 <http://eol.org/pages/584573>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_97441 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?41733>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_97441 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22122>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_97441 langual:B5100)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_97441 "PLANTS:VIOD")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_97441 "Viola odorata L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_97441 "viola odorata"@en)
SubClassOf(obo:NCBITaxon_97441 obo:FOODON_03411179)

# Class: obo:NCBITaxon_9749 (Delphinapterus leucas)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9749 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9749 "The beluga or white whale, *Delphinapterus leucas*, is an Arctic and sub-Arctic cetacean. It is one of two members of the family *Monodontidae*, along with the narwhal, and the only member of the genus *Delphinapterus*. This marine mammal is commonly referred to simply as the beluga or sea canary due to its high-pitched twitter. Using the term \"white whale\" to refer to belugas is, in the strictest sense, erroneous, as the term \"whale\" is usually applied to the *Mysticeti* (baleen whales) and not to toothed cetaceans which belong to the suborder *Odontoceti*, which also includes dolphins and porpoises. ]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9749 "beluga whale"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9749 "WIKIPEDIA:Beluga_whale")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9749 <http://eol.org/pages/328541>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9749 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180483>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9749 langual:B4486)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9749 asfis:bel)
