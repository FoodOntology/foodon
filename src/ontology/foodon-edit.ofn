SubClassOf(obo:NCBITaxon_50193 obo:FOODON_03411566)

# Class: obo:NCBITaxon_50207 (Sonchus oleraceus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_50207 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_50207 "Sow thistles have been used as fodder, particularly for rabbits, hence the other common names of \"hare thistle\" or \"hare lettuce\". They are also edible to humans as a leaf vegetable; old leaves and stalks can be bitter but young leaves have a flavour similar to lettuce. Going by the name puha or rareke (raraki) it is frequently eaten in New Zealand as a vegetable, particularly by the native Maori. When cooked it tastes a little similar to chard. [Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_50207 "annual sowthistle plant"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_50207 "sowthistle plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50207 <http://eol.org/pages/492350>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50207 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?34939>)
