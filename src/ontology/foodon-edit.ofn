AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_36610 "The quince (*Cydonia oblonga *) is the sole member of the genus *Cydonia* in the family *Rosaceae *(which also contains apples and pears, among other fruits). It is a deciduous tree that bears a pome fruit, similar in appearance to a pear, and bright golden-yellow when mature.  [https://en.wikipedia.org/wiki/Quince]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_36610 "common quince plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 <http://eol.org/pages/245489>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12779>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25159>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 langual:B4219)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 "MANSFELD:8647")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_36610 "PLANTS:CYOB2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_36610 "Cydonia oblonga Mill.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_36610 "Cydonia oblonga P. Mill.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_36610 "cydonia oblonga"@en)
SubClassOf(obo:NCBITaxon_36610 obo:FOODON_03411298)

# Class: obo:NCBITaxon_3662 (Cucurbita moschata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3662 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3662 "A type of winter squash that grows on a vine. It has a sweet, nutty taste similar to that of a pumpkin. It has tan-yellow skin and orange fleshy pulp with a compartment of seeds in the bottom. When ripe, it turns increasingly deep orange, and becomes sweeter and richer."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3662 "butternut squash plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3662 wikipedia:Butternut_squash)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3662 <http://eol.org/pages/584408>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3662 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12601>)
