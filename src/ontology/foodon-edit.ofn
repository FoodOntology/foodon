AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002908> "yellowtail fish"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002908> <http://purl.obolibrary.org/obo/FOODON_03411365>)

