AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414962 "PLANTS:ROMA81")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414962 "cinnamon rose")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414962 "double cinnamon rose")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414962 "may rose"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414962 "rosa majalis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414962 "cinnamon rose plant"@en)
SubClassOf(obo:FOODON_03414962 obo:FOODON_03411225)
SubClassOf(obo:FOODON_03414962 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_57935))

# Class: obo:FOODON_03414963 (Myrica)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414963 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414963 "Myrica is a genus of about 35-50 species of small trees and shrubs in the family *Myricaceae*, order *Fagales*. The genus has a wide distribution, including Africa, Asia, Europe, North America and South America, and missing only from Australia. Common names include bayberry, bay-rum tree, candleberry, sweet gale, and wax-myrtle. The wax coating on the fruit of several species, known as bayberry wax, has been used traditionally to make candles. The fruit of *Myrica rubra* is an economically important crop in China, sold fresh, dried, canned, for juice, and for alcoholic beverages. *Myrica* is used to spice beer and snaps in Denmark. [https://en.wikipedia.org/wiki/Myrica]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414963 <http://eol.org/pages/4327>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414963 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402433>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414963 langual:B4963)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414963 "PLANTS:MOREL2")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414963 "Morella")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414963 "Morella Lour.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414963 "Morella rubra Lour.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414963 "morella"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414963 "Myrica"@en)
SubClassOf(obo:FOODON_03414963 obo:FOODON_03411231)

# Class: obo:FOODON_03414964 (buffaloberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414964 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414964 "Shepherdia, commonly called buffaloberry or bullberry, is a genus of small shrubs in the *Elaeagnaceae* family. The plants are native to northern and western North America. The berry is recognizable by being a dark shade of red, with little white dots on them. They are rough to the touch, and are found on both trees and shrubs. Buffaloberries are sour and can be made into jam, pie, jelly, syrup, soups, or prepared like cranberry sauce with sugar added. [https://en.wikipedia.org/wiki/Shepherdia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414964 <http://eol.org/pages/4380>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414964 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33863>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414964 langual:B4964)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414964 "PLANTS:SHEPH")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414964 "Shepherdia Nutt.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414964 "Shepherdia argentea (Pursh) Nutt.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414964 "shepherdia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414964 "buffaloberry plant"@en)
SubClassOf(obo:FOODON_03414964 obo:FOODON_03411231)

# Class: obo:FOODON_03414965 (plumcot plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414965 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414965 "Pluots, apriums, apriplums, or plumcots, are some of the hybrids between different *Prunus* species that are also called interspecific plums. Whereas plumcots and apriplums are first-generation hybrids between a plum parent (*P. salicina* or *P. cerasifera* or their hybrids), and an apricot (*P. armeniaca*), pluots and apriums are later-generations. Both names \"plumcot\" and \"apriplum\" have been used for trees derived from a plum seed parent, and are therefore equivalent. [https://en.wikipedia.org/wiki/Pluot]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414965 langual:B4965)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414965 "apriplum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414965 "aprium"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414965 "pluot"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414965 "prunus hybrid"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414965 "plumcot plant"@en)
SubClassOf(obo:FOODON_03414965 obo:FOODON_03411539)

# Class: obo:FOODON_03414966 (saskatoon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414966 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414966 "Amelanchier alnifolia, the saskatoon, Pacific serviceberry, western serviceberry, alder-leaf shadbush, dwarf shadbush, chuckley pear, or western juneberry, is a shrub with edible berry-like fruit, native to North America from Alaska across most of western Canada and in the western and north-central United States. Historically, it was also called pigeon berry."@en)
AnnotationAssertion(schema:image obo:FOODON_03414966 <https://upload.wikimedia.org/wikipedia/commons/thumb/e/ea/Amelanchier_alnifolia_6441.JPG/400px-Amelanchier_alnifolia_6441.JPG>)
