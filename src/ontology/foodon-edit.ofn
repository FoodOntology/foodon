AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411200 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=27018>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411200 langual:B1200)
