# Class: obo:FOODON_03411355 (vanilla plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411355 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411355 "Vanilla, the vanilla orchids, forms a flowering plant genus of about 110 species in the orchid family (*Orchidaceae*). The most widely known member is the flat-leaved vanilla (*V. planifolia*), native to Mexico, from which commercial vanilla flavoring is derived. 
 The fruit is termed \"vanilla bean\", though true beans are fabaceaen eudicots not at all closely related to orchids. Rather, the vanilla fruit is technically an elongate, fleshy and later dehiscent capsule 10-20 cm long. It ripens gradually for 8 to 9 months after flowering, eventually turning black in color and giving off a strong aroma. Each pod contains thousands of minute seeds, and both the pods and seeds within are used to create vanilla flavoring. Vanilla beans are harvested by hand from commercial orchards. [https://en.wikipedia.org/wiki/Vanilla_(genus)]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 <http://eol.org/pages/8156>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312480>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?41111>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 langual:B1355)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 "MANSFELD:11314")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411355 "PLANTS:VANIL")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411355 "Vanilla")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411355 "Vanilla Mill.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411355 "Vanilla planifolia Andr.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411355 "Vanilla spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411355 "french vanilla"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411355 "vanilla fragrans"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411355 "vanilla spp"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411355 "vanilla plant"@en)
SubClassOf(obo:FOODON_03411355 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03411355 ObjectSomeValuesFrom(obo:RO_0002162 ObjectUnionOf(obo:NCBITaxon_117957 obo:NCBITaxon_51239 obo:NCBITaxon_669897)))

