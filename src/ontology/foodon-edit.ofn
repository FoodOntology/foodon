AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414687 "Hicksbeachia pinnatifolia F. Muell.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "beef nut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "hicksbeachia pinnatifolia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "ivory silky oak"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "red bopple nut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "red nut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414687 "rose nut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414687 "monkeynut plant"@en)
SubClassOf(obo:FOODON_03414687 obo:FOODON_03411022)

