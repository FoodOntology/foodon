# Class: obo:FOODON_03411543 (beech tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411543 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411543 "Beech (*Fagus*) is a genus of ten species of deciduous trees in the family *Fagaceae*, native to temperate Europe, Asia and North America. The fruit of the beech tree is known as beechnuts or mast and is found in small burrs that drop from the tree in autumn. It is small, roughly triangular and edible, with a bitter, astringent taste."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411543 "WIKIPEDIA:Beech")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411543 <http://eol.org/pages/107351>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411543 langual:B1543)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411543 "beech nut tree"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411543 "fagus spp."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411543 "LanguaL curation note: When indexing beech nut index both *BEECH [B1543]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411543 "beech tree"@en)
SubClassOf(obo:FOODON_03411543 obo:FOODON_03411062)

