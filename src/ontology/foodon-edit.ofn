AnnotationAssertion(go:hasDbXref obo:FOODON_03411713 langual:B1713)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411713 "stewing chicken"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411713 "stewing hen"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411713 "chicken hen"@en)
