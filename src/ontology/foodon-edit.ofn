AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03413684> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03413684> "The shark catfishes form the family *Pangasiidae*. They are found in fresh and brackish waters across southern Asia, from Pakistan to Borneo. Among the 30-odd members of this family is the plant-eating, endangered Mekong giant catfish *Pangasianodon gigas*, one of the largest known freshwater fish. Several species are the basis of productive aquaculture industries in Vietnam's Mekong Delta. [https://en.wikipedia.org/wiki/Shark_catfish]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03413684> <http://eol.org/pages/5092>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03413684> <http://www.langual.org/langual_thesaurus.asp?termid=B3684>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413684> "pangasiidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03413684> "giant catfishes"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03413684> <http://purl.obolibrary.org/obo/FOODON_03411598>)

