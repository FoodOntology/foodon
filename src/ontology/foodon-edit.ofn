AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3915 "black lentil"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3915 "matpe bean"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3915 "minapa pappu"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3915 "mungo bean"@en)
