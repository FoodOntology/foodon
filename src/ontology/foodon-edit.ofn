AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411211 "citron")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411211 "etrog")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411211 "citrus medica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411211 "citron plant"@en)
SubClassOf(obo:FOODON_03411211 obo:FOODON_03411139)
SubClassOf(obo:FOODON_03411211 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_171251))

