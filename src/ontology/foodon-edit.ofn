AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430103 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430103 "Food material which is in semiliquid form (at room temperature)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430103 langual:E0103)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430103 "liquid, very thick"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430103 "LanguaL curation note: Used for liquid food products that are very thick but still pourable."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430103 "food (semiliquid)"@en)
SubClassOf(obo:FOODON_03430103 obo:FOODON_00002454)

