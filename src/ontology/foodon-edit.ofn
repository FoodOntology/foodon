# Class: obo:NCBITaxon_193516 (Hippophae rhamnoides)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_193516 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_193516 "*Hippophae rhamnoides*, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia. It is a spiny deciduous shrub. 
 *H. rhamnoides* is a very versatile plant and the fruits as well as the leaves can be used. The fruits are processed and then used in the food industry, in traditional medicine, as part of drugs or in the cosmetic industry. The leaves can be used as feed, particularly for ruminants. [https://en.wikipedia.org/wiki/Hippophae_rhamnoides]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_193516 "sea buckthorn plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_193516 <http://eol.org/pages/488204>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_193516 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?19177>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_193516 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503044>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_193516 langual:B2748)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_193516 "PLANTS:HIRH80")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_193516 "hippophae rhamnoides"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_193516 "Hippophae rhamnoides L.")
SubClassOf(obo:NCBITaxon_193516 obo:FOODON_03411539)

