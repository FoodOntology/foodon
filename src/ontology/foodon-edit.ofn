# Class: obo:FOODON_03411475 (pompano)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411475 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411475 "Pompanos are marine fishes in the genus Trachinotus in the family Carangidae (better known as \"jacks\"). Pompano may also refer to various other, similarly shaped members of the Carangidae, or the order Perciformes. Their appearance is deep-bodied and mackerel-like, typically silver and toothless, with a forked tail and narrow base. Of the 20 described species, most are valued as food."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411475 wikipedia:Pompano)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411475 <http://eol.org/pages/26259>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411475 langual:B1475)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411475 "trachinotus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411475 "pompano"@en)
SubClassOf(obo:FOODON_03411475 obo:FOODON_03411755)

