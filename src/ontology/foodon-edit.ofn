AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411731 "PLANTS:COOL")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411731 "Nalta jute")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411731 "jute"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411731 "corchorus olitorius"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411731 "jew's mallow"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411731 "jute mallow"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411731 "jute, nalta"@en)
