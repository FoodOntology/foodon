AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414861 "Clarias"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414861 "Clarias Scopoli, 1777")
AnnotationAssertion(rdfs:label obo:FOODON_03414861 "clarias catfish"@en)
SubClassOf(obo:FOODON_03414861 obo:FOODON_03411901)

# Class: obo:FOODON_03414862 (sharptooth catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414862 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414862 "A species of catfish of the family Clariidae, the airbreathing catfishes. The African sharptooth catfish was introduced all over the world in the early 1980s for aquaculture purposes, so is found in countries far outside its natural habitat, such as Brazil, Vietnam, Indonesia, and India."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414862 <http://eol.org/pages/205045>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414862 langual:B4862)
