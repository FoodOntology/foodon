# Class: obo:FOODON_00002983 (Ají dulce pepper plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002983 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002983 "Ají dulce is any of a variety of sweet perennial peppers found in Latin America and the Caribbean. It is most widely known in Puerto Rico and Venezuela, where it refers to a specific native variety of Capsicum chinense that is related to the habanero but with a much milder, smoky flavor. In the English-speaking Caribbean, it is known as seasoning pepper and is essential to a variety of traditional dishes."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002983 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002983 <https://en.wikipedia.org/wiki/Aj%C3%AD_dulce>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002983 "cachucha"@es)
AnnotationAssertion(dcterms:date obo:FOODON_00002983 "2019-08-12T23:19:40Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002983 "'ají gustoso"@es)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002983 "Ají dulce"@es)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002983 "ajicito"@es)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002983 "ají cachucha"@es)
AnnotationAssertion(rdfs:label obo:FOODON_00002983 "Ají dulce pepper plant"@en)
SubClassOf(obo:FOODON_00002983 obo:FOODON_03411643)

