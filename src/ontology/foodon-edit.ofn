# Class: obo:FOODON_03414309 (grunter family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414309 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414309 "Grunters or tigerperches are fishes in the family *Terapontidae* (also spelled *Teraponidae*, *Theraponidae* or *Therapontidae*). They are found in shallow coastal waters in the Indian Ocean and western Pacific, where they live in saltwater, brackish and freshwater habitats. They grow up to 80 cm in length and feed on fishes, insects and other invertebrates.
When caught, grunters make the characteristic grunting sounds that give them their name."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414309 "WIKIPEDIA:Terapontidae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414309 langual:B4309)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "grunters"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "teraponidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "terapontidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "theraponidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "therapontidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414309 "tigerperch"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414309 "grunter family"@en)
SubClassOf(obo:FOODON_03414309 obo:FOODON_03411581)

# Class: obo:FOODON_03414310 (silver perch)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414310 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414310 "Silver perch (*Bidyanus bidyanus*) is a medium sized freshwater fish endemic to the Murray-Darling river system in south-eastern Australia. The scientific name comes from an aboriginal name for the species recorded by Major Mitchell on his 1832 expedition. It is not a perch, being a grunter in the family *Terapontidae*. It is the largest of the Australian grunters, capable of growing to 40 cm and 8 kg, more usually around 30 cm and up to 1.5 kg."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414310 <http://eol.org/pages/205881>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414310 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=168040>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414310 langual:B4310)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414310 asfis:byb)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414310 <https://www.frdc.com.au/knowledge-hub/standards/37321008>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414310 "Bidyan perch")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414310 "bidyan perch"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414310 "bidyanus bidyanus"@en)
