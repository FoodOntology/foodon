# Class: obo:FOODON_03414362 (ratite)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414362 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414362 "A ratite is any of a diverse group of large, flightless birds of Gondwanan origin, most of them now extinct. There is still some controversy regarding the systematics involved. Some sources state that Ratites are synonymous with *Struthioiniformes*, while other sources state that Ratites are the same group, only that the order *Struthioniformes* contains only the Ostrich and possibly the Elephant Bird. Unlike other flightless birds, the ratites have no keel on their sternum - hence the name from the Latin ratis (for raft). Without this to anchor their wing muscles, they could not fly even if they were to develop suitable wings."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414362 "WIKIPEDIA:Ratite")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414362 <http://eol.org/pages/8662>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414362 langual:B4362)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414362 "struthioniformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414362 "ratite"@en)
SubClassOf(obo:FOODON_03414362 obo:FOODON_00002616)

# Class: obo:FOODON_03414363 (kiwi)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414363 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414363 "Kiwi are flightless birds endemic to New Zealand, in the genus *Apteryx* and family *Apterygidae*. At around the size of a domestic chicken, kiwi are by far the smallest living ratites and lay the largest egg in relation to their body size of any species of bird in the world."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414363 "WIKIPEDIA:Kiwi")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414363 <http://eol.org/pages/8663>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414363 langual:B4363)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414363 "Apteryx Shaw, 1813")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414363 "apteryx"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414363 "kiwi"@en)
SubClassOf(obo:FOODON_03414363 obo:FOODON_03414362)

# Class: obo:FOODON_03414364 (northern bobwhite)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414364 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414364 "The Northern Bobwhite, Virginia Quail or (in its home range) Bobwhite Quail (*Colinus virginianus*) is a ground-dwelling bird native to the United States, Mexico, and the Caribbean. It is a member of the group of species known as New World quails (*Odontophoridae*). They were initially placed with the Old World quails in the pheasant family (*Phasianidae*), but are not particularly closely related. The name \"bobwhite\" derives from its characteristic whistling call."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414364 <http://eol.org/pages/1049187>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414364 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175863>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414364 langual:B4364)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414364 "bobwhite quail")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414364 "common bobwhite")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414364 "bobwhite quail"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414364 "colinus virginianus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414364 "virginia quail"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414364 "northern bobwhite"@en)
SubClassOf(obo:FOODON_03414364 obo:FOODON_03411346)
SubClassOf(obo:FOODON_03414364 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9014))

# Class: obo:FOODON_03414365 (california quail)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414365 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414365 "The California Quail, *Callipepla californica*, also known as the California Valley Quail or Valley Quail, is a small ground-dwelling bird in the New World quail family. It is the state bird of California."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414365 <http://eol.org/pages/1049189>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414365 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175876>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414365 langual:B4365)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414365 "callipepla californica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414365 "california quail"@en)
SubClassOf(obo:FOODON_03414365 obo:FOODON_03411346)
SubClassOf(obo:FOODON_03414365 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_67771))

# Class: obo:FOODON_03414366 (common quail)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414366 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414366 "The Common Quail, *Coturnix coturnix*, is a small bird in the pheasant family *Phasianidae*. It is widespread and is found in parts of Europe, (should not be confused with the domesticated Japanese Quail, *Coturnix japonica*, original from Asia that although visually similar have very distinct calls)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414366 <http://eol.org/pages/914847>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414366 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=553871>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414366 langual:B4366)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414366 "coturnix coturnix"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414366 "common quail"@en)
SubClassOf(obo:FOODON_03414366 obo:FOODON_03411346)
SubClassOf(obo:FOODON_03414366 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9091))

# Class: obo:FOODON_03414367 (mallard)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414367 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414367 "The Mallard or Wild Duck (*Anas platyrhynchos*) is a dabbling duck which breeds throughout the temperate and subtropical Americas, Europe, Asia, and North Africa, and has been introduced to New Zealand and Australia. This duck belongs to the subfamily *Anatinae* of the waterfowl family *Anatidae*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414367 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175063>)
