AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414706 langual:B4706)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414706 "PLANTS:VIAD2")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414706 "phaseolus adenanthus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414706 "vigna adenantha"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414706 "wild pea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414706 "potato bean plant"@en)
