# Class: obo:NCBITaxon_568231 (Baillonella toxisperma)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_568231 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_568231 "*Baillonella toxisperma* (also called African pearwood, djave nut, or moabi) is a species of tree in the family *Sapotaceae*, and the only species in the genus *Baillonella*. It is found in Angola, Cameroon, the Republic of the Congo, the Democratic Republic of the Congo, Gabon and Nigeria. Its natural habitat is subtropical or tropical moist lowland forests. It is threatened by habitat loss. The moabi tree's nut oil is a key component of Baka and other indigenous people's subsistence.[https://en.wikipedia.org/wiki/Baillonella]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_568231 "african pearwood plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_568231 <http://eol.org/pages/1150112>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_568231 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6317>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_568231 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505954>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_568231 langual:B4842)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_568231 "PLANTS:BATO3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_568231 "Baillonella toxisperma Pierre")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_568231 "baillonella toxisperma"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_568231 "djave"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_568231 "djave nut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_568231 "moabi"@en)
SubClassOf(obo:NCBITaxon_568231 obo:FOODON_03411022)
SubClassOf(obo:NCBITaxon_568231 obo:FOODON_03411024)

# Class: obo:NCBITaxon_56866 (Luffa acutangula)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_56866 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_56866 "*Luffa acutangula* (Angled luffa, Ridged luffa, Vegetable Gourd, Silk squash, Sin qua) is a species of *Luffa*. It is commercially grown for its unripe fruits as a vegetable. Mature fruits are used to make cleaning sponges. Its fruit slightly resembles a cucumber with ridges. It ranges from central Asia and eastern Asia to southeastern Asia."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_56866 "angled loofah plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_56866 "WIKIPEDIA:Luffa_acutangula")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_56866 <http://eol.org/pages/487004>)
