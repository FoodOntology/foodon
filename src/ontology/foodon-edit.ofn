# Class: obo:NCBITaxon_48106 (Centella asiatica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_48106 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_48106 "Centella asiatica, commonly centella, is a small, herbaceous, annual plant of the family Mackinlayaceae or subfamily Mackinlayoideae of family Apiaceae, and is native to India, Sri Lanka, northern Australia, Indonesia, Iran, Malaysia, Melanesia, Papua New Guinea, and other parts of Asia.[1] It is used as a medicinal herb in Ayurvedic medicine, traditional African medicine, and traditional Chinese medicine. Botanical synonyms include *Hydrocotyle asiatica* L. and *Trisanthus cochinchinensis* (Lour.)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_48106 "asiatic pennywort plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_48106 "WIKIPEDIA:Centella_asiatica")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_48106 <http://eol.org/pages/581713>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_48106 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?9831>)
