# Class: obo:FOODON_03412789 (governor's plum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412789 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412789 "Flacourtia indica (syn. *Flacourtia ramontchi*), known commonly as ramontchi, governor's plum, batoko plum, Madagascar plum and Indian plum, is a species of flowering plant native to much of Africa and tropical and temperate parts of Asia. *F. indica* and *F. ramontchi* are sometimes treated as separate species. 
 The Ramontchi fruit itself is a pome about an inch thick and red ripening purple. It is very fleshy and has 6 to 10 seeds in layered carpels. The pulp is yellow or white and sweet with an acidic tang. It is eaten raw or made into jelly or jam. It can be fermented to make wine. [https://en.wikipedia.org/wiki/Flacourtia_indica]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412789 <http://eol.org/pages/487574>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412789 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?17118>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412789 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=502628>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412789 langual:B2789)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412789 "PLANTS:FLIN")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412789 "Madagascar plum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412789 "governor's plum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412789 "ramontchi")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "batoka plum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "flacourtia hirtiuscula"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "flacourtia indica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "flacourtia latifolia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "flacourtia ramontchi"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "flacourtia sepiaria"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "gmelina indica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "indian plum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412789 "madagascar plum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412789 "governor's plum plant"@en)
