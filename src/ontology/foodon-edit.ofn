AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411081 "EC:No 216/2009 DCP")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411081 "Dendrobranchiata Bate, 1888")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411081 "Natantia")
