AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4567 "PLANTS:TRDU3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4567 "Triticum durum Desf.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4567 "Triticum turgidum L. ssp. durum"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4567 "Triticum turgidum subsp. durum (Desf.) Husn.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4567 "macaroni wheat"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4567 "pasta wheat"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4567 "triticum durum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4567 "triticum ispahanicum ssp. durum"@en)
