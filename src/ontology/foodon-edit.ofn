# Class: obo:NCBITaxon_52152 (Elymus repens)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_52152 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_52152 "*Elymus repens*, commonly known as couch grass, is a very common perennial species of grass native to most of Europe, Asia, the Arctic biome, and northwest Africa. It has been brought into other mild northern climates for forage or erosion control, but is often considered a weed. Other names include common couch, twitch, quick grass, quitch grass (also just quitch), dog grass, quackgrass, scutch grass, and witchgrass. [https://en.wikipedia.org/wiki/Elymus_repens]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_52152 "couch grass plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52152 <http://eol.org/pages/1115777>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52152 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?102069>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52152 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=512839>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52152 langual:B5101)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52152 "PLANTS:ELRE4")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52152 "Elymus repens (L.) Gould")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52152 "Elytrigia repens (L.) Desv. ex Nevski")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52152 "elymus repens"@en)
SubClassOf(obo:NCBITaxon_52152 obo:FOODON_03413378)

