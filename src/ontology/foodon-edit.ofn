AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415005 "PLANTS:MESU5")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415005 "apple mint")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415005 "pineapple mint")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415005 "mentha suaveolens"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415005 "pineapple mint"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415005 "round-leaf mint"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415005 "apple mint plant"@en)
SubClassOf(obo:FOODON_03415005 obo:FOODON_03411267)
SubClassOf(obo:FOODON_03415005 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_38860))

# Class: obo:FOODON_03415006 (corsican mint plant)

