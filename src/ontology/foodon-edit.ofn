SubClassOf(obo:FOODON_03415077 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_145745))

# Class: obo:FOODON_03415078 (meadowsweet plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415078 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415078 "Filipendula ulmaria, commonly known as meadowsweet or mead wort, is a perennial herb in the family *Rosaceae* that grows in damp meadows. Meadowsweet has also been referred to as queen of the meadow, pride of the meadow, meadow-wort, meadow queen, lady of the meadow, dollof, meadsweet, and bridewort.
[https://en.wikipedia.org/wiki/Filipendula_ulmaria]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415078 <http://eol.org/pages/629935>)
