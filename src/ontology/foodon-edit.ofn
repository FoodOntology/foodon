# Class: <http://purl.obolibrary.org/obo/FOODON_00002483> (ricefield rat)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_00002483> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002483> "The ricefield rat (Rattus argentiventer) is a species of rat found throughout Southeast Asia. Although not a part of staple human diet in Cambodia, a growing market has developed there with most exports going to Vietnam"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00002483> "Damion Dooley"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002483> "rice-field rat"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002483> "ricefield rat"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002483> <http://purl.obolibrary.org/obo/FOODON_03414848>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002505> (dairy cattle)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_00002505> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002505> "Dairy cattle are a type of cattle bred for the ability to produce large quantities of milk, from which dairy products are made.  This class covers both male and female members of a dairy breed."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00002505> "Damion Dooley")
