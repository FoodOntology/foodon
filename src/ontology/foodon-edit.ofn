AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415036 "earthnut")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415036 "great pignut")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415036 "black caraway"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415036 "bunium bulbocastanum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415036 "bunium persicum"@en)
