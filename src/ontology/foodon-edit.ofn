# Class: obo:FOODON_03530291 (organic food production)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03530291 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530291 "An agricultural production process that aims to produce food using natural substances and processes that have a limited negative environmental and human health impact as they encourage the responsible use of energy and natural resources like water, the maintenance of biodiversity, the preservation of regional ecological balances, enhancement of soil fertility, and animal welfare."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03530291 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03530291 <https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/288329/11-546-future-of-food-and-farming-report.pdf%20(Box%204.1%20Food%20security%20and%20organic%20agriculture)>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03530291 langual:Z0291)
AnnotationAssertion(rdfs:comment obo:FOODON_03530291 "In Europe, \"organic production\" means the use of the production method compliant with the rules established in Council Regulation (EC) No 834/2007 of 28 June 2007 on organic production and labelling of organic products and repealing Regulation (EEC) No 2092/91, at all stages of production, preparation and distribution.[http://eur-lex.europa.eu/LexUriServ/LexUriServ.do?uri=OJ:L:2007:189:0001:0023:EN:PDF]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530291 "organic food production"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03530291 <http://www.fao.org/organicag/oa-faq/oa-faq6/en/>)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03530291 <https://ec.europa.eu/info/food-farming-fisheries/farming/organic-farming>)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03530291 <https://ec.europa.eu/info/food-farming-fisheries/farming/organic-farming/organics-glance_en>)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03530291 <https://www.ams.usda.gov/sites/default/files/media/OrganicProductionandHandlingStandards.pdf>)
SubClassOf(obo:FOODON_03530291 obo:FOODON_03530152)

# Class: obo:FOODON_03530292 (free-range food animal rearing)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03530292 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530292 "A method of farming husbandry where the animals, for at least part of the day, can roam freely outdoors, rather than being confined in an enclosure for 24 hours each day. This term can be applied to egg, dairy, poultry, and meat production."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03530292 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03530292 <http://www.ecolife.com/define/free-range.html>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03530292 wikipedia:Free_range)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_03530292 "grass fed"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03530292 langual:Z0292)
AnnotationAssertion(go:hasSynonym obo:FOODON_03530292 "free range"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03530292 "free-range food animal rearing"@en)
SubClassOf(obo:FOODON_03530292 obo:FOODON_00003388)

# Class: obo:FOODON_03530293 (shank (meat))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03530293 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03530293 "A meat shank or shin is the portion of meat around the tibia of the animal, the leg bone beneath the knee. [http://en.wikipedia.org/wiki/Shank_(meat)]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03530293 "WIKIPEDIA:Shank_(meat)")
AnnotationAssertion(go:hasDbXref obo:FOODON_03530293 langual:Z0293)
AnnotationAssertion(rdfs:label obo:FOODON_03530293 "shank (meat)"@en)
SubClassOf(obo:FOODON_03530293 obo:FOODON_03530008)

