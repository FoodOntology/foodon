AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414977 "Ceylon cinnamon")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414977 "ceylon cinnamon"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414977 "cinnamomum verum"@en)
