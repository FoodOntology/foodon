AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "Japanese Polled"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "Japanese Shorthorn"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "Kuroge Washu"@ja)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "Mukaku Washu"@ja)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "Nihon Tankaku Washu"@ja)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_00002555 "日本短角和種"@ja)
