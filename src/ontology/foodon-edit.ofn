AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411747 "Undaria pinnatifida (Harvey) Suringar 1873")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411747 "japanese kelp"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411747 "sea mustard"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411747 "undaria pinnatifida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411747 "wakame kelp"@en)
