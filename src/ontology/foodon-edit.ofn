AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414694 "Common name: Australian Nutmeg; Nutmeg; Native Nutmeg; Queensland Nutmeg. 
[http://keys.trin.org.au/key-server/data/0e0f0504-0103-430d-8004-060d07080d04/media/Html/taxon/Myristica_insipida.htm]"@en)
