AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414816> "bogong moth"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414816> <http://purl.obolibrary.org/obo/FOODON_03414644>)

