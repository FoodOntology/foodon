AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430110 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430110 langual:E0110)
AnnotationAssertion(rdfs:label obo:FOODON_03430110 "semiliquid with solid pieces"@en)
SubClassOf(obo:FOODON_03430110 obo:FOODON_03430103)

# Class: obo:FOODON_03430111 (cut into short pieces)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430111 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430111 langual:E0111)
AnnotationAssertion(rdfs:comment obo:FOODON_03430111 "LanguaL curation note: Used when the thickness of a piece size is between 0.3 and 1.5 cm. and the overall length is less than 5 cm., e.g., cut green beans."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430111 "cut into short pieces"@en)
SubClassOf(obo:FOODON_03430111 obo:FOODON_03430115)
SubClassOf(obo:FOODON_03430111 ObjectSomeValuesFrom(obo:RO_0002353 obo:FOODON_00000071))

# Class: obo:FOODON_03430113 (food physical quality)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430113 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430113 "The physical state of the food product (liquid, semiliquid, semisolid, or solid). Solid food products are further subdivided by shape or form. Terms are provided for products that have both liquid and solid components or that incorporate air or other gases. [FDA CFSAN 1995]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430113 langual:E0113)
AnnotationAssertion(rdfs:comment obo:FOODON_03430113 "Damion Dooley's note: these categories need to be mapped over to PATO phenotypic categories, with a suitable treatment of mixtures of solids that are divided into parts."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430113 "food physical quality"@en)
SubClassOf(obo:FOODON_03430113 obo:FOODON_00002470)

