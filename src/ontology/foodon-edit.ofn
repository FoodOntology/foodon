# Class: <http://purl.obolibrary.org/obo/FOODON_03411578> (santa claus melon plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411578> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411578> "The Santa Claus melon, sometimes known as Christmas melon or Piel de Sapo, is a variety of melon that grows to approximately 1 foot in length and is oblong in shape. It has a thick outer green-striped rind with a pale green inner pulp that provides a mild melon flavor, that can be as sweet as honeydew melons, if not more so."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411578> "WIKIPEDIA:Santa_claus_melon")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411578> <http://www.langual.org/langual_thesaurus.asp?termid=B1578>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411578> "melon, santa claus"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411578> "santa claus melon plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411578> <http://purl.obolibrary.org/obo/NCBITaxon_357961>)

