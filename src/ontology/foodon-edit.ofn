AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414992 "PLANTS:SAOF2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414992 "garden sage")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414992 "common sage"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414992 "salvia officinalis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414992 "kitchen sage plant"@en)
SubClassOf(obo:FOODON_03414992 obo:FOODON_03411303)
SubClassOf(obo:FOODON_03414992 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_38868))

