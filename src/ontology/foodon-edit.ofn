AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411724 "chinese long bean"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411724 "long-podded cowpea"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411724 "pea bean"@en)
