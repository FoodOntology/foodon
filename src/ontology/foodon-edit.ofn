AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "ascomycete"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "ascomycotina"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "ascos"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "dematiaceae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "plectascales"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "protascales"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_4890 "sac fungi"@en)
AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_51240 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_51240 "*Juglans regia*, the Persian walnut, English walnut, or especially in Great Britain, Common walnut, is an Old World walnut tree species native to the region stretching from the Balkans eastward to the Himalayas and southwest China. The whole fruit, including the husk, falls in autumn; the seed is large, with a relatively thin shell, and edible, with a rich flavor."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_51240 "english walnut tree"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_51240 "WIKIPEDIA:Juglans_regia")
