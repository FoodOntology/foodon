AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415051 "korean cherry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415051 "manchu cherry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415051 "prunus tomentosa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415051 "nanking cherry plant"@en)
