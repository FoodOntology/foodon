AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414722> "cycas spp."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414722> "cycas plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414722> <http://purl.obolibrary.org/obo/FOODON_03414719>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414723> (lepidozamia plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414723> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414723> "Lepidozamia is a genus of two species of cycad, both endemic to Australia. *Lepidozamia hopei* (W.Hill) Regel - northern Queensland; *Lepidozamia peroffskyana* Regel - southeastern Queensland, northeastern New South Wales [https://en.wikipedia.org/wiki/Lepidozamia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414723> <http://eol.org/pages/75720>)
