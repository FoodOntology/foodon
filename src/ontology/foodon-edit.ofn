AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53873 "PLANTS:DIOD2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_53873 "Dipteryx odorata (Aubl.) Willd.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_53873 "Dipteryx odorata (Aublet) Willd.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_53873 "cumaru"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_53873 "dipteryx odorata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_53873 "kumaru"@en)
