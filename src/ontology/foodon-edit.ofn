AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414862 "African sharptooth catfish"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414862 "Clarias gariepinus"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414862 "North African catfish")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414862 "https://en.wikipedia.org/wiki/Clarias_gariepinus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414862 "North African catfish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414862 "sharptooth catfish"@en)
