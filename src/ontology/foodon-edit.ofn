AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414350 langual:B4350)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414350 "PLANTS:PICU")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414350 "java pepper"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414350 "piper cubeba"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414350 "tailed pepper"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414350 "cubeb plant"@en)
SubClassOf(obo:FOODON_03414350 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03414350 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_405322))

# Class: obo:FOODON_03414351 (candlenut plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414351 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414351 "Aleurites moluccana, the Candlenut, is a flowering tree in the spurge family, *Euphorbiaceae*, also known as Candleberry, Indian walnut, Kemiri, Varnish tree, Nuez de la India, Buah keras or Kukui nut tree."@en)
