AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430123 langual:E0123)
AnnotationAssertion(rdfs:label obo:FOODON_03430123 "food (liquid, low viscosity, with no visible particles)"@en)
SubClassOf(obo:FOODON_03430123 obo:FOODON_03430109)

