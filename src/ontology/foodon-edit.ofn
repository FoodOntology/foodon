AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411300 "PLANTS:ALLIU")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411300 "Allium")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411300 "Allium L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411300 "Allium sp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411300 "allium spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411300 "bulb onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411300 "cebolla"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411300 "garden onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411300 "onion plant"@en)
SubClassOf(obo:FOODON_03411300 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03411300 obo:FOODON_03414302)
