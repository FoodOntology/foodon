# Class: obo:FOODON_03414466 (tunicate)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414466 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414466 "Tunicates, previously known as *Urochordata* or urochordates, are members of the *Tunicata*, a subphylum of the phylum *Chordata*. They are marine filter feeders with a saclike morphology. In their respiration and feeding they take in water through an incurrent (or inhalant) siphon and expel the filtered water through an excurrent (or exhalant) siphon. Most adult tunicates are sessile and attached to rocks or similarly suitable surfaces on the ocean floor; others such as salps, doliolids and pyrosomes swim in the pelagic zone as adults. Various species are commonly known as sea squirts or sea pork."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414466 "WIKIPEDIA:Tunicate")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414466 langual:B4466)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414466 "oopah"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414466 "sea squirt"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414466 "tunicata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414466 "tunicate"@en)
SubClassOf(obo:FOODON_03414466 obo:FOODON_00002581)

# Class: obo:FOODON_03414467 (ascidian)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414467 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414467 "Ascidiacea (commonly known as the ascidians or sea squirts) is a class in the Tunicata subphylum of sac-like marine invertebrate filter feeders. Ascidians are characterized by a tough outer \"tunic\" made of the polysaccharide tunicin, as compared to other tunicates which are less rigid."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414467 "WIKIPEDIA:Ascidiacea")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414467 <http://eol.org/pages/1486>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414467 langual:B4467)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414467 "ascidiacea"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414467 "sea squirts"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414467 "ascidian"@en)
SubClassOf(obo:FOODON_03414467 obo:FOODON_03414466)

# Class: obo:FOODON_03414470 (brown bear)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414470 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414470 "The brown bear (*Ursus arctos*) is a large bear distributed across much of northern Eurasia and North America. Adult bears generally weigh between 100 and 635 kg (220 and 1,400 lb) and its largest subspecies, the Kodiak bear, rivals the polar bear as the largest member of the bear family and as the largest land-based predator. There are several recognized subspecies within the brown bear species. In North America, two types are generally recognized, the coastal brown bear and the inland grizzly bear, and the two types could broadly define all brown bear subspecies."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414470 "WIKIPEDIA:Brown_bear")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414470 <http://eol.org/pages/328581>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414470 obo:NCBITaxon_9644)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414470 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180543>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414470 langual:B4470)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414470 "MSW3:14000970")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414470 "Ursus arctos Linnaeus, 1758")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414470 "ursus arctos"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414470 "brown bear"@en)
SubClassOf(obo:FOODON_03414470 obo:FOODON_03412406)
SubClassOf(obo:FOODON_03414470 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9644))

# Class: obo:FOODON_03414471 (kodiak bear)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414471 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414471 "The Kodiak bear (*Ursus arctos middendorffi*), also known as the Kodiak brown bear or the Alaskan grizzly bear or American brown bear, occupies the islands of the Kodiak Archipelago in South-Western Alaska. Its name in the Alutiiq language is Taquka-aq. It is the largest subspecies of brown bear."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414471 "WIKIPEDIA:Kodiak_Bear")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414471 <http://eol.org/pages/7664>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414471 langual:B4471)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414471 "MSW3:14000982")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414471 "Ursus arctos middendorffi Merriam, 1896")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414471 "taquka-aq"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414471 "ursus arctos middendorffi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414471 "kodiak bear"@en)
SubClassOf(obo:FOODON_03414471 obo:FOODON_03414470)

# Class: obo:FOODON_03414472 (grizzly bear)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414472 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414472 "The grizzly bear (*Ursus arctos horribilis*), also known as the silvertip bear, the grizzly, or the North American brown bear, is a subspecies of brown bear (Ursus arctos) that generally lives in the uplands of western North America. This subspecies is thought to descend from Ussuri brown bears which crossed to Alaska from eastern Russia 100,000 years ago, though they did not move south until 13,000 years ago."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414472 "WIKIPEDIA:Grizzly_bear")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414472 <http://eol.org/pages/7664>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414472 langual:B4472)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414472 "MSW3:14000979")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414472 "Ursus arctos horribilis Ord, 1815")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414472 "grizzly"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414472 "north american brown bear"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414472 "silvertip bear"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414472 "ursus arctos horribilis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414472 "grizzly bear"@en)
SubClassOf(obo:FOODON_03414472 obo:FOODON_03414470)

# Class: obo:FOODON_03414473 (california golden bear)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414473 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414473 "The California golden bear or California grizzly (*Ursus arctos californicus*) is an extinct subspecies of the brown bear. The California golden bear disappeared from the state of California in 1922, when the last one was shot in Tulare County. In 1866, a grizzly weighing 2,200 pounds was killed in Valley Center, California, the largest grizzly killed in California."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414473 "WIKIPEDIA:California_golden_bear")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414473 <http://eol.org/pages/7664>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414473 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=726987>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414473 langual:B4473)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414473 "MSW3:14000974")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414473 "Ursus arctos californicus Merriam, 1896")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414473 "ursus arctos californicus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414473 "california golden bear"@en)
SubClassOf(obo:FOODON_03414473 obo:FOODON_03412406)

# Class: obo:FOODON_03414474 (alaska blueberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414474 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414474 "Vaccinium ovalifolium (commonly known as Alaska blueberry, early blueberry, oval-leaf bilberry, oval-leaf blueberry, and oval-leaf huckleberry) is a plant in the heath family having three varieties, all of which grow in northerly regions, including the subarctic."@en)
