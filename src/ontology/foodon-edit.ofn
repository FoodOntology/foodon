# Class: obo:NCBITaxon_38851 (Gentiana lutea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_38851 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_38851 "*Gentiana lutea* (Great Yellow Gentian) is a species of gentian native to the mountains of central and southern Europe. Other names include 'Yellow Gentian', 'Bitter Root', 'Bitterwort', 'Centiyane', and 'Genciana'.
Gentian root has a long history of use as a herbal bitter in the treatment of digestive disorders and is an ingredient of many proprietary medicines."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_38851 "yellow gentian plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_38851 "WIKIPEDIA:Gentiana_lutea")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38851 <http://eol.org/pages/483956>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38851 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?17392>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38851 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505985>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38851 langual:B4335)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_38851 "PLANTS:GELU2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_38851 "Gentiana lutea L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38851 "gentian, yellow"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38851 "gentiana lutea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_38851 "great yellow gentian"@en)
SubClassOf(obo:NCBITaxon_38851 obo:FOODON_03414334)

# Class: obo:NCBITaxon_3886 (Phaseolus coccineus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3886 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3886 "*Phaseolus coccineus*, known as runner bean, scarlet runner bean, or multiflora bean, is a plant in the legume or *Fabaceae* family. Another common name is butter bean, which, however, can also refer to the lima bean, a different species."@en)
