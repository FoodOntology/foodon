AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414685 "athertonia diversifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414685 "atherton oak plant"@en)
SubClassOf(obo:FOODON_03414685 obo:FOODON_03411022)

# Class: obo:FOODON_03414686 (yellownut plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414686 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414686 "Beilschmiedia bancroftii is a tree species in the *Lauraceae* family. It is native to Queensland in Australia. Though the seeds are toxic when fresh, they were used by indigenous Australians following treatment. [https://en.wikipedia.org/wiki/Beilschmiedia_bancroftii]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414686 <http://eol.org/pages/4308>)
