AnnotationAssertion(go:hasSynonym obo:FOODON_03412017 "fiddlehead fern"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412017 "osmunda cinnamomea"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412017 "osmundastrum cinnamomea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412017 "cinnamon fern plant"@en)
