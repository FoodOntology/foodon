AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430121 langual:E0121)
AnnotationAssertion(rdfs:label obo:FOODON_03430121 "food (liquid, high viscosity, with small particles)"@en)
SubClassOf(obo:FOODON_03430121 obo:FOODON_03430102)

# Class: obo:FOODON_03430122 (divided or ground form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430122 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430122 "A solid form characteristic which covers both \"divided into piece(s)\" and \"ground form\" classes of food material."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430122 langual:E0122)
AnnotationAssertion(rdfs:comment obo:FOODON_03430122 "LanguaL curation note: The distinctions in this category are based on size characteristics, primarily thickness, which are important for heat transfer and for diffusion of chemicals in processing. *DIVIDED INTO HALVES, QUARTERS OR SEGMENTS* should be examined first and if one of the descriptors listed applies it should be used regardless of the size of the pieces. If none of these are applicable, other *DIVIDED OR DISINTEGRATED* descriptors should be examined. Do not use any of these descriptors if dividing or disintegrating results in a semiliquid or semisolid product."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430122 "divided or ground form (sensu food)"@en)
EquivalentClasses(obo:FOODON_03430122 ObjectUnionOf(obo:FOODON_03430136 obo:FOODON_03430152))
SubClassOf(obo:FOODON_03430122 obo:FOODON_00005712)

