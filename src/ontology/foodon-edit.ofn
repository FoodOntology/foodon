AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200963 <http://eol.org/pages/644031>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200963 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?40413>)
