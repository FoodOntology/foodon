AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414373 "PLANTS:VISA")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414373 "common vetch")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414373 "tare")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414373 "garden vetch"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414373 "narrowleaf vetch"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414373 "sweetpea (garden vetch)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414373 "vicia sativa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414373 "common vetch plant"@en)
