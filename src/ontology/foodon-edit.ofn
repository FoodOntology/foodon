# Class: obo:FOODON_03413409 (black nightshade plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413409 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413409 "Solanum nigrum (European Black Nightshade or locally just \"black nightshade\", Duscle, Garden Nightshade, Hound's Berry, Petty Morel, Wonder Berry, Small-fruited black nightshade or popolo) is a species in the *Solanum* genus, native to Eurasia and introduced in the Americas, Australasia and South Africa. Parts of this plant can be highly toxic to livestock and humans, and it's considered a weed. Nonetheless, ripe berries and cooked leaves of edible strains are used as food in some locales; and plant parts are used as a traditional medicine."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413409 <http://eol.org/pages/418543>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413409 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?310124>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413409 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=565525>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413409 langual:B3409)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413409 "PLANTS:SONI")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413409 "black nightshade")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413409 "solanum nigrum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413409 "black nightshade plant"@en)
SubClassOf(obo:FOODON_03413409 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03413409 obo:FOODON_03415104)
SubClassOf(obo:FOODON_03413409 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4112))

