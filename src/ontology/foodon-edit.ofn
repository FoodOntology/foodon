AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3673 "Momordica charantia L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "balsam pear"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "bitter cucumber"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "bitter gourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "fu gwa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "la-kwa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3673 "momordica charantia"@en)
