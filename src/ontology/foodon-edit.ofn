AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414937 "kaksa")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414937 "momordica dioica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414937 "spine gourd plant"@en)
SubClassOf(obo:FOODON_03414937 obo:FOODON_03411719)
SubClassOf(obo:FOODON_03414937 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_654836))

# Class: obo:FOODON_03414938 (sweet gourd plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414938 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414938 "Gac (*Momordica cochinchinensis*) is found throughout the Southeast Asian region from South China to Northeastern Australia. Gac is notable for its densely orange fruit containing rich contents of beta-carotene and lycopene. It is known as red melon, baby jackfruit, spiny bitter gourd, sweet gourd, or cochinchin gourd in English. [https://en.wikipedia.org/wiki/Gac]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414938 <http://eol.org/pages/483972>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414938 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24521>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414938 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505902>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414938 langual:B4938)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414938 "PLANTS:MOCO5")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414938 "spiny bitter cucumber")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414938 "gac"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414938 "momordica cochinchinensis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414938 "sweet gourd plant"@en)
SubClassOf(obo:FOODON_03414938 obo:FOODON_03411719)
SubClassOf(obo:FOODON_03414938 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3674))

# Class: obo:FOODON_03414939 (maca plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414939 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414939 "Lepidium meyenii (maca) is an herbaceous biennial plant of the crucifer family native to the high Andes of Peru. It is grown for its fleshy hypocotyl (a fused hypocotyl and taproot), which is used as a root vegetable and a medicinal herb. [https://en.wikipedia.org/wiki/Lepidium_meyenii]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414939 <http://eol.org/pages/483599>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414939 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21767>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414939 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506211>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414939 langual:B4939)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414939 "PLANTS:LEME19")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414939 "lepidium meyenii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414939 "maca plant"@en)
SubClassOf(obo:FOODON_03414939 obo:FOODON_03414739)
SubClassOf(obo:FOODON_03414939 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_153348))

# Class: obo:FOODON_03414940 (golden thistle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414940 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414940 "Scolymus hispanicus, the common golden thistle or Spanish oyster thistle, is a flowering plant in the genus *Scolymus* in the family *Asteraceae*, native to southern and western Europe, north to northwestern France. Although it has been cultivated at times, currently most of the plant which is consumed comes from harvesting of wild plant. Very popular in almost every province of Spain, where it's usually eaten in stews during Spring time. It's also used in salads, soups and with scrambled eggs in Andalusia, Spain, where it is called \"tagarnina\". [https://en.wikipedia.org/wiki/Scolymus_hispanicus]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414940 <http://eol.org/pages/485030>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414940 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33399>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414940 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505088>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414940 langual:B4940)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414940 "PLANTS:SCHI")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414940 "scolymus hispanicus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414940 "spanish oysterplant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414940 "golden thistle plant"@en)
SubClassOf(obo:FOODON_03414940 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03414940 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_114287))

# Class: obo:FOODON_03414941 (tuberous-root mustard plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414941 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414941 "This mustard relative develops a tuberous root, in appearance much like a globular turnip. Roots reach a diameter of 3 to 4 inches, and are similar to turnips in appearance, texture, flavor and culture. It is rarely grown in the U.S. The root, leaves and petioles are edible. [https://dev.hort.purdue.edu/newcrop/Crops/MustardTuberousRootedChine.html]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414941 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?461021>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414941 langual:B4941)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414941 "Brassica juncea subsp. napiformis (Pailleux & Bois) Gladis")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414941 "brassica juncea napiformis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414941 "turnip-root mustard"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414941 "tuberous-root mustard plant"@en)
SubClassOf(obo:FOODON_03414941 obo:FOODON_03411092)

# Class: obo:FOODON_03414945 (broccolini plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414945 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414945 "Broccolini is a green vegetable similar to broccoli but with smaller florets and longer, thin stalks. It is a natural hybrid of broccoli and gai lan, both cultivar groups of *Brassica oleracea*. [https://en.wikipedia.org/wiki/Broccolini]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414945 langual:B4945)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414945 "bimi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414945 "broccolini plant"@en)
SubClassOf(obo:FOODON_03414945 obo:FOODON_03411443)

# Class: obo:FOODON_03414946 (batavia lettuce plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414946 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414946 "A lettuce which is midway between the crisphead and leaf types. These lettuces tend to be larger, bolt-resistant and well-flavored."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414946 <https://en.wikipedia.org/wiki/Lettuce#Cultivars>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414946 langual:B4946)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414946 "French crisp"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414946 "summercrisp lettuce"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414946 "batavia lettuce plant"@en)
SubClassOf(obo:FOODON_03414946 obo:FOODON_03411390)

