AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3918 "Turkish gram"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3918 "dew bean"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3918 "mat bean"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3918 "matki"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3918 "moth bean"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3918 "Vigna aconitifolia (Jacq.) Marechal")
