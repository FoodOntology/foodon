# Class: obo:FOODON_03414381 (bovid)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414381 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414381 "A bovid (family *Bovidae*) is any of almost 140 species of cloven-hoofed, ruminant mammal which has males with characteristic unbranching horns covered in a permanent sheath of keratin.

The family is widespread, being native to Asia, Africa, Europe and North America, and diverse: members include bison, African buffalo, water buffalo, antelopes, gazelles, sheep, goats, muskoxen, and domestic cattle."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414381 "WIKIPEDIA:Bovidae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414381 <http://eol.org/pages/7687>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414381 langual:B4381)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414381 "bovidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414381 "bovid"@en)
SubClassOf(obo:FOODON_03414381 obo:FOODON_00005680)
SubClassOf(obo:FOODON_03414381 obo:FOODON_03411134)

# Class: obo:FOODON_03414382 (chinese mud carp)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414382 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414382 "Chinese mud carp (Cirrhinus chinensis) is a species of ray-finned fish in the genus Cirrhinus. Chinese mud carp is an important food fish in Guangdong Province. It is also cultured in this area and Taiwan.
 
Cantonese and Shunde cuisines often use this fish to make fish balls and dumplings."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414382 "WIKIPEDIA:Cirrhinus_chinensis")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414382 <http://eol.org/pages/3198>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414382 langual:B4382)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414382 "cirrhinus chinensis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414382 "chinese mud carp"@en)
SubClassOf(obo:FOODON_03414382 obo:FOODON_03412617)

# Class: obo:FOODON_03414383 (alaska plaice)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414383 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414383 "Alaska plaice (*Pleuronectes quadrituberculatus*) is a saltwater fish that live in the North Pacific Ocean. Like most flatfish, they live on the bottom of the continental shelf, up to 600 metres deep. Their geographic range is from the Gulf of Alaska in the east, to the Chukchi Sea in the north, to the Sea of Japan in the west."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414383 <http://eol.org/pages/221039>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414383 langual:B4383)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414383 "CEC1993:1132")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414383 "itis:172901")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414383 "pleuronectes quadrituberculatus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414383 "alaska plaice"@en)
SubClassOf(obo:FOODON_03414383 obo:FOODON_03412570)
SubClassOf(obo:FOODON_03414383 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_641111))

