# Class: obo:FOODON_03415071 (purple coneflower plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415071 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415071 "Echinacea is a genus, or group of herbaceous flowering plants in the daisy family. The *Echinacea* genus has nine species, which are commonly called coneflowers. [https://en.wikipedia.org/wiki/Echinacea]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415071 <http://eol.org/pages/4206>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415071 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?318214>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415071 langual:B5071)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415071 "PLANTS:ECHIN")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415071 "Echinacea")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415071 "Echinacea Moench")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415071 "Echinacea spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415071 "echinacea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415071 "purple coneflower plant"@en)
SubClassOf(obo:FOODON_03415071 obo:FOODON_03413359)

# Class: obo:FOODON_03415081 (sweet-tea plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415081 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415081 "Chinese sweet tea is a traditional Chinese herbal tea, made from the leaves of Chinese Blackberry (*Rubus suavissimus*). These leaves contain a natural sweetener, called rubusoside, which is 200 times as sweet as cane sugar. The tea has long been used to alleviate kidney symptoms, and a recent Japanese study also indicates that it has anti-inflammatory effects and helps against allergies. [https://en.wikipedia.org/wiki/Chinese_sweet_tea]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415081 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402703>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415081 langual:B5081)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415081 "Rubus suavissimus S. K. Lee")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415081 "chinese blackberry"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415081 "rubus suavissimus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415081 "sweet-tea plant"@en)
SubClassOf(obo:FOODON_03415081 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415081 obo:FOODON_03414206)

# Class: obo:FOODON_03415086 (witch-hazel plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415086 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415086 "Witch-hazels (*Hamamelis*) are a genus of flowering plants in the family *Hamamelidaceae*, with four species in North America (*H. mexicana, H. ovalis, H. virginiana, H. vernalis*), and one each in Japan (*H. japonica*) and China (*H. mollis*). The leaves and bark of the North American witch-hazel, *Hamamelis virginiana*, may be used to produce an astringent decoction as a cooling agent for various uses in traditional medicine, herbalism, and skincare products. [https://en.wikipedia.org/wiki/Witch-hazel]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415086 <http://eol.org/pages/4293>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415086 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?315758>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415086 langual:B5086)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415086 "PLANTS:HAMAM")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415086 "Hamamelis spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415086 "hamamelis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415086 "witch-hazel plant"@en)
SubClassOf(obo:FOODON_03415086 obo:FOODON_03413359)

# Class: obo:FOODON_03415087 (honeybush plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415087 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415087 "Cyclopia, better known by the common name Honeybush, or Heuningbos in Afrikaans, is a genus of some 20 species of flowering plants in the legume family, *Fabaceae*, of the subfamily *Faboideae*. The leaves of honeybush are commonly used to make herbal teas. It grows only in small areas in the southwest and southeast of South Africa and has many similarities with rooibos. [https://en.wikipedia.org/wiki/Cyclopia_(plant)]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415087 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?3244>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415087 langual:B5087)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415087 "Cyclopia Vent.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415087 "cyclopia genistoides"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415087 "cyclopia intermedia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415087 "cyclopia sessiflora"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415087 "cyclopia subternata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415087 "honeybush plant"@en)
SubClassOf(obo:FOODON_03415087 obo:FOODON_03411179)

# Class: obo:FOODON_03415088 (chrysanthemum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415088 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415088 "Chrysanthemums, sometimes called mums or chrysanths, are flowering plants of the genus *Chrysanthemum* in the family *Asteraceae*. Yellow or white chrysanthemum flowers of the species *C. morifolium* are boiled to make a tea in some parts of Asia. Chrysanthemum leaves are steamed or boiled and used as greens, especially in Chinese cuisine. The flowers may be added to dishes [https://en.wikipedia.org/wiki/Chrysanthemum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415088 <http://eol.org/pages/4206>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415088 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300128>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415088 langual:B5088)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415088 "PLANTS:CHRYS2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415088 "Chrysanthemum spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415088 "daisy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415088 "chrysanthemum plant"@en)
SubClassOf(obo:FOODON_03415088 obo:FOODON_03411566)

# Class: obo:FOODON_03415093 (jengkol plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415093 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415093 "Archidendron pauciflorum, commonly known as Djenkol, Jenkol or Jering is a species of flowering tree in the pea family, *Fabaceae*. It is native to Southeast Asia, where the seeds are a popular dish. The beans and leaves of the djenkol tree are traditionally used for medicinal purposes such as purifying the blood. [https://en.wikipedia.org/wiki/Archidendron_pauciflorum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415093 <http://eol.org/pages/4277>)
