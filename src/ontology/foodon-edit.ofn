AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413974 "EC:No 216/2009 RAX")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413974 "chub mackerel"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413974 "Rastrelliger Jordan and Starks in Jordan and Dickerson, 1908")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413974 "Rastrelliger spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413974 "indian mackerel"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413974 "rastrelliger spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413974 "chub mackerel (Rastrelliger genus)"@en)
