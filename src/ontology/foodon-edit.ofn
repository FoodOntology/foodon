# Class: obo:NCBITaxon_13402 (Carya)

AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_13402 "Trees in the genus *Carya* are commonly known as hickory, derived from the Powhatan language of Virginia.Hickory nuts (*Carya*) and walnuts (*Juglans*) in the *Juglandaceae* family grow within an outer husk; these fruits are technically drupes or drupaceous nuts, and thus not true botanical nuts. \"Tryma\" is a specialized term for such nut-like drupes."@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_13402 <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_13402 "WIKIPEDIA:Hickory")
AnnotationAssertion(dcterms:date obo:NCBITaxon_13402 "2023-06-18T16:25:33Z"^^xsd:dateTime)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13402 "carya spp."@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_13402 "LanguaL curation note: When indexing the hickory fruit (tryma/drupaceous nut) index both *HICKORY [B1553]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
SubClassOf(obo:NCBITaxon_13402 obo:FOODON_03411062)

# Class: obo:NCBITaxon_134033 (Castanea dentata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_134033 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_134033 "The American chestnut (*Castanea dentata*) is a large, monoecious deciduous tree of the beech family native to eastern North America. The nuts were once an important economic resource in North America, being sold on the streets of towns and cities, as they sometimes still are during the Christmas season [https://en.wikipedia.org/wiki/American_chestnut]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_134033 "american chestnut tree"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_134033 <http://eol.org/pages/1148514>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_134033 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=19454>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_134033 langual:B5021)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_134033 "PLANTS:CADE12")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_134033 "Castanea dentata (Marsh.) Borkh.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_134033 "castanea dentata"@en)
SubClassOf(obo:NCBITaxon_134033 obo:FOODON_03411544)

