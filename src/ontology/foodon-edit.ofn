# Class: obo:FOODON_03412346 (iceland moss)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412346 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412346 "Iceland moss (*Cetraria islandica*) is a lichen whose erect or ascending foliaceous habit gives it something of the appearance of a moss, whence probably the name. It is often of a pale chestnut color, but varies considerably, being sometimes almost entirely greyish white; and grows to a height of from 3 to 4 in., the branches being channelled or rolled into tubes, which terminate in flattened lobes with fringed edges."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412346 <http://eol.org/pages/2858645>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412346 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=382416>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412346 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=190618>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412346 langual:B2346)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412346 "PLANTS:CEIS60")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412346 "cetraria islandica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412346 "iceland lichen"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412346 "iceland moss"@en)
SubClassOf(obo:FOODON_03412346 obo:FOODON_03412345)
SubClassOf(obo:FOODON_03412346 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_78064))

