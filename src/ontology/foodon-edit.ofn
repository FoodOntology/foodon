SubClassOf(obo:NCBITaxon_115624 obo:FOODON_03413359)

# Class: obo:NCBITaxon_115666 (Solanum macrocarpon)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_115666 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_115666 "*Solanum macrocarpon* otherwise known as the African eggplant or gboma is a plant of the *Solanaceae* family.  *S. macrocarpon* is a tropical perennial plant that is closely related to the eggplant. The parts of the plant that is consumed are the fruits and its young leaves. While taste of both the leaves and the fruit are very bitter they have a high nutrient yield. [https://en.wikipedia.org/wiki/Solanum_macrocarpon]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_115666 "african eggplant plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115666 <http://eol.org/pages/484220>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115666 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?102157>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115666 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505838>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115666 langual:B4981)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115666 "PLANTS:SOMA7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_115666 "Solanum macrocarpon L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115666 "antroewa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115666 "gboma"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115666 "solanum macrocarpon"@en)
SubClassOf(obo:NCBITaxon_115666 obo:FOODON_03411458)

# Class: obo:NCBITaxon_115715 (Vigna subterranea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_115715 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_115715 "*Vigna subterranea* (also known by its common names: Bambara nut, Boro (Yoruba), Bambara groundnut, Bambara-bean, Congo goober, earth pea, ground-bean, or hog-peanut) is a member of the family *Fabaceae*. The plant originated in West Africa. Vigna subterranea ripens its pods underground, much like the peanut (also called a groundnut). They can be eaten fresh or boiled after drying.[]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_115715 "bambara groundnut plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_115715 <http://eol.org/pages/4277>)
