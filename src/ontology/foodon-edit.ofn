# Class: obo:FOODON_03414650 (cissus grape plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414650 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414650 "Cissus is a genus of approximately 350 species of lianas (woody vines) in the grape family (*Vitaceae)*. They have a cosmopolitan distribution, though the majority are to be found in the tropics. [https://en.wikipedia.org/wiki/Cissus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414650 <http://eol.org/pages/61156>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414650 langual:B4650)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414650 "cissus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414650 "cissus grape plant"@en)
SubClassOf(obo:FOODON_03414650 obo:FOODON_03411024)

# Class: obo:FOODON_03414651 (ampelocissus grape plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414651 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414651 "Ampelocissus is a genus of *Vitaceae* having 90 or more species found variously in tropical Africa, Asia, Central America, and Oceania. [https://en.wikipedia.org/wiki/Ampelocissus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414651 <http://eol.org/pages/4382>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414651 langual:B4651)
AnnotationAssertion(rdfs:label obo:FOODON_03414651 "ampelocissus grape plant"@en)
SubClassOf(obo:FOODON_03414651 obo:FOODON_03411024)

# Class: obo:FOODON_03414653 (custard finger plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414653 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414653 "Uvaria is a genus of flowering plants in the soursop family, *Annonaceae*. [https://en.wikipedia.org/wiki/Uvaria]"@en)
