# Class: obo:NCBITaxon_64478 (Actinidia arguta)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_64478 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_64478 "*Actinidia arguta* (hardy kiwi) is a perennial vine native to Japan, Korea, Northern China, and Russian Siberia. It produces a small fruit resembling the kiwifruit."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_64478 "kiwiberry"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_64478 <http://eol.org/pages/392750>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_64478 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?1389>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_64478 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506774>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_64478 langual:B4846)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_64478 "PLANTS:ACAR10")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_64478 "Actinidia arguta (Siebold & Zucc.) Planch. ex Miq.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "actinidia arguta"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "arctic kiwi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "baby kiwi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "cocktail kiwi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "grape kiwi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "hardy kiwi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_64478 "hardy kiwifruit"@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_64478 "The fruit are referred to as hardy kiwifruit, kiwi berry, arctic kiwi, baby kiwi, dessert kiwi, grape kiwi, northern kiwi, or cocktail kiwi, and are edible, berry- or grape-sized fruit similar to kiwifruit in taste and appearance, but are green, brownish, or purple with smooth skin, sometimes with a red blush. Often sweeter than the kiwifruit, hardy kiwifruit can be eaten whole and do not need to be peeled. Thin-walled, its exterior is smooth and leathery. - https://en.wikipedia.org/wiki/Actinidia_arguta"@en)
SubClassOf(obo:NCBITaxon_64478 obo:FOODON_03415177)

