# Class: obo:FOODON_03480047 (packed in vinegar with sugar and salt)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03480047 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03480047 "A mixture of vinegar, sugar, and salt which are used as a packing medium for food material."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03480047 langual:K0047)
AnnotationAssertion(rdfs:comment obo:FOODON_03480047 "In the U.S., grain strength is calculated as 10 times the acid content expressed as acetic acid.  For example, 40 grain vinegar = 4% acetic acid; 120 grain vinegar = 12% acetic acid. [Technically Speaking about Vinegar - A food technologist's guide to vinegar, The Vinegar Institute, 5775 Peachtree-Dunwoody Road, Atlanta, Georgia 30342, USA].
LanguaL curation note: Used for sweetened, salt, vinegar-water mixture with grain of at least 10 ( 1% expressed as acetic acid). For lower grain, use *PACKED IN SWEETENED LIQUID*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03480047 "packed in vinegar with sugar and salt"@en)
SubClassOf(obo:FOODON_03480047 obo:FOODON_03480029)

# Class: obo:FOODON_03490100 (food packaging)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03490100 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03490100 "A food contact material which encloses the food and can be in the type of a container, packaging or wrapping."@en)
AnnotationAssertion(obo:IAO_0000116 obo:FOODON_03490100 "Previous definition was a legacy definition, not ontological and has been moved to comments."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03490100 "http://orcid.org/0000-0001-8008-8249")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03490100 "https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/food-packaging")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03490100 "container"@en)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03490100 "packaging"@en)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03490100 "wrapping"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03490100 langual:M0100)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03490100 "food container"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03490100 "food wrap"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03490100 "food wrapping"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03490100 "Previous definition: Type of container or wrapping defined by the main container material, the container form and the material of the liner lids of ends. Also type of container or wrapping by form; prefer description by material first, then by form. [FDA CFSAN 1995]."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03490100 "food packaging"@en)
SubClassOf(obo:FOODON_03490100 obo:FOODON_00003368)

