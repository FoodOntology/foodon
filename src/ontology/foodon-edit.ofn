# Class: obo:FOODON_03413846 (round herring)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413846 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413846 "Etrumeus is a genus of round herrings in the family, *Dussumieriidae*. There are currently six recognized species in this genus: *Etrumeus golanii* DiBattista, J. E. Randall & Bowen, 2012; *Etrumeus makiawa* J. E. Randall & DiBattista, 2012; *Etrumeus micropus* (Temminck & Schlegel, 1846); *Etrumeus teres* (DeKay, 1842) (Red-eye round herring); *Etrumeus whiteheadi* Wongratana, 1983 (Whitehead's round herring); *Etrumeus wongratanai* DiBattista, J. E. Randall & Bowen, 2012. [https://en.wikipedia.org/wiki/Etrumeus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413846 <http://eol.org/pages/2776970>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413846 langual:B3846)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413846 "CEC1993:176")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413846 "Etrumeus Bleeker, 1853")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413846 "Etrumeus spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413846 "etrumeus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413846 "round herring"@en)
SubClassOf(obo:FOODON_03413846 obo:FOODON_03411124)

