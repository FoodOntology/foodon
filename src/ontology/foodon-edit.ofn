# Class: obo:FOODON_03411023 (fish, pleuronectiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411023 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411023 "A flatfish is a member of the order Pleuronectiformes of ray-finned demersal fishes, also called the Heterosomata, sometimes classified as a suborder of Perciformes. In many species, both eyes lie on one side of the head, one or the other migrating through or around the head during development. Some species face their left sides upward, some face their right sides upward, and others face either side upward. [https://en.wikipedia.org/wiki/Flatfish]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411023 <http://eol.org/pages/5168>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411023 langual:B1023)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "flat-fish"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "flat-fishes"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "flatfish"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "flatfish, flounder"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "flounders"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411023 "pleuronectiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411023 "fish, pleuronectiform"@en)
SubClassOf(obo:FOODON_03411023 obo:FOODON_03411365)

