# Class: obo:FOODON_03411708 (hawthorn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411708 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411708 "Crataegus, commonly called hawthorn or thornapple, is a large genus of shrubs and trees in the rose family, *Rosaceae*, native to temperate regions of the Northern Hemisphere in Europe, Asia and North America. The name hawthorn was originally applied to the species native to northern Europe, especially the Common Hawthorn, *C. monogyna*, and the unmodified name is often so used in Britain and Ireland. However the name is now also applied to the entire genus, and also to the related Asian genus *Rhaphiolepis*."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411708 "WIKIPEDIA:Crataegus")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411708 <http://eol.org/pages/8097>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411708 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300154>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411708 langual:B1708)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411708 "PLANTS:CRATA")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411708 "Crataegus")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411708 "Crataegus L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411708 "Crataegus sp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411708 "crataegus spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411708 "haw"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411708 "hawthorn plant"@en)
SubClassOf(obo:FOODON_03411708 obo:FOODON_03411599)

# Class: obo:FOODON_03411710 (roaster chicken)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411710 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411710 "A young chicken between eight and 12 weeks old, of either sex, with a ready-to-cook carcass weight of five pounds or more, that is tender-meated with soft, pliable, smooth-textured skin and breastbone cartilage that is somewhat less flexible than that of a broiler or fryer."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411710 "https://www.usda.gov/media/blog/2011/11/17/poultry-classifications-get-21st-century-upgrade"^^xsd:anyURI)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411710 langual:B1710)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411710 "roasting chicken"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411710 "In the past roaster chickens had been classified as three to five months old, but modern rearing practices have led to faster maturation.")
AnnotationAssertion(rdfs:label obo:FOODON_03411710 "roaster chicken"@en)
SubClassOf(obo:FOODON_03411710 obo:FOODON_03411457)

# Class: obo:FOODON_03411711 (capon)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411711 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411711 "https://www.usda.gov/media/blog/2011/11/17/poultry-classifications-get-21st-century-upgrade"^^xsd:anyURI)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_03411711 "A surgically neutered male chicken younger than four months old (previously younger than eight months) that is tender-meated with soft, pliable, smooth-textured skin."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411711 langual:B1711)
SubClassOf(obo:FOODON_03411711 obo:FOODON_03411457)

# Class: obo:FOODON_03411712 (stag chicken)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411712 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411712 "A male chicken (usually under 10 months of age) with coarse skin, somewhat toughened and darkened flesh, and considerable hardening of the breastbone cartilage. Their condition is intermediate between that of a roaster chicken and a rooster."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411712 langual:B1712)
AnnotationAssertion(rdfs:label obo:FOODON_03411712 "stag chicken"@en)
SubClassOf(obo:FOODON_03411712 obo:FOODON_03411457)

