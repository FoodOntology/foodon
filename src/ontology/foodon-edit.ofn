# Class: obo:FOODON_03414164 (cetacean marine mammal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414164 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414164 "The order *Cetacea* includes the marine mammals commonly known as whales, dolphins, and porpoises. Cetus is Latin and is used in biological names to mean \"whale\"; its original meaning, \"large sea animal\", was more general."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414164 "WIKIPEDIA:Cetacea")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414164 <http://eol.org/pages/7649>)
