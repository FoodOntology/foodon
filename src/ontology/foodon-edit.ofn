AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411267 langual:B1267)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411267 "PLANTS:MENTH")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411267 "Mentha")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411267 "Mentha L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411267 "Mentha spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411267 "mentha spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411267 "mint plant"@en)
SubClassOf(obo:FOODON_03411267 obo:FOODON_03411179)

