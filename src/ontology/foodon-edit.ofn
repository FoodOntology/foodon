AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3662 "butternut pumpkin"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3662 "cucurbita moschata"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3662 "cucurbita moschata var. butternut"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3662 "gramma"@en)
