AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414775 "Lysiphyllum carronii (F. Muell.) Pedley")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414775 "lysiphyllum carronii"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414775 "red bauhinia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414775 "northern beantree plant"@en)
SubClassOf(obo:FOODON_03414775 obo:FOODON_03413359)

