AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268906 langual:B4993)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268906 "PLANTS:SAFR10")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_268906 "Salvia fruticosa Mill.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268906 "greek-oregano"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268906 "salvia fruticosa"@en)
SubClassOf(obo:NCBITaxon_268906 obo:FOODON_03411303)

# Class: obo:NCBITaxon_270110 (Cochlearia officinalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_270110 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_270110 "Scurvy-grass (*Cochlearia* species; a.k.a. Scurvy grass, Scurvygrass, or Spoonwort) is a genus of about 30 species of annual and perennial herbs in the cabbage family *Brassicaceae*. They are widely distributed in temperate and arctic areas of the northern hemisphere, most commonly found in coastal regions, on cliff-tops and salt marshes where their high tolerance of salt enables them to avoid competition from larger, but less salt-tolerant plants; they also occur in alpine habitats in mountains and tundra.
 
Scurvy-grass was extensively eaten in the past by sailors suffering from scurvy after returning from long voyages, as the leaves are rich in vitamin C, which cures this deficiency disease resulting from a lack of fresh vegetables in the diet. The leaves, which have a strong peppery taste similar to the related horseradish and watercress, are also sometimes used in salads."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_270110 "scurvy-grass plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_270110 "WIKIPEDIA:Cochlearia")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 <http://eol.org/pages/584102>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11010>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22816>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 langual:B2945)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 "MANSFELD:23616")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_270110 "PLANTS:COOF4")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_270110 "Cochlearia officinalis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_270110 "cochlearia officinalis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_270110 "scurvygrass"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_270110 "spoonwort"@en)
SubClassOf(obo:NCBITaxon_270110 obo:FOODON_03411566)
SubClassOf(obo:NCBITaxon_270110 obo:FOODON_03413372)

