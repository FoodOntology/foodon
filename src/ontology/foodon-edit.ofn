# Class: <http://purl.obolibrary.org/obo/FOODON_03412505> (millet plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03412505> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412505> "The millets are a group of small-seeded species of cereal crops or grains, widely grown around the world for food and fodder. They do not form a taxonomic group, but rather a functional or agronomic one. Their essential similarities are that they are small-seeded grasses grown in difficult production environments such as those at risk of drought. They have been in cultivation in East Asia for the last 10,000 years."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03412505> "WIKIPEDIA:Millet")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412505> <http://eol.org/pages/8223>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412505> <http://www.langual.org/langual_thesaurus.asp?termid=B2505>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412505> "poaceae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412505> "millet plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412505> <http://purl.obolibrary.org/obo/FOODON_03411324>)

