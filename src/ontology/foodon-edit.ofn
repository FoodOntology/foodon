AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415084 langual:B5084)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415084 "PLANTS:ANSY2")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415084 "angelica sylvestris"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415084 "woodland angelica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415084 "wild angelica plant"@en)
