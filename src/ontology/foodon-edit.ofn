SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510196> <http://purl.obolibrary.org/obo/FOODON_03510017>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510197> (food quality claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510197> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510197> "Food Quality/Food Assurance Claim indicates, with reference to the product branding, labelling or packaging, whether the product is stamped with a quality mark, as approved by the governing authority, such as USDA for USA products [Source: GS1]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510197> <http://www.langual.org/langual_thesaurus.asp?termid=P0197>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510197> "food quality claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510197> <http://purl.obolibrary.org/obo/FOODON_03510159>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510198> (diabetic or suitable for diabetics claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510198> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510198> "It should be noted that such claims are illegal in some countries, e.g. Denmark, and that other countries, e.g. United Kingdom, are calling for an end to the use of terms such as 'diabetic' or 'suitable for diabetics' on food labels.
The European Commission is considering how foods intended specifically for people with diabetes can be controlled."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510198> <http://www.langual.org/langual_thesaurus.asp?termid=P0198>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510198> "diabetic or suitable for diabetics claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510198> <http://purl.obolibrary.org/obo/FOODON_03510124>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510199> (vegan/vegetarian or suitability for vegan/vegetarian claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510199> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510199> <http://www.langual.org/langual_thesaurus.asp?termid=P0199>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510199> "vegan/vegetarian or suitability for vegan/vegetarian claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510199> <http://purl.obolibrary.org/obo/FOODON_03510126>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510200> (no pork added claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510200> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510200> <http://www.langual.org/langual_thesaurus.asp?termid=P0200>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510200> "LanguaL curation note: Denotes a product that contains no pork meat."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510200> "no pork added claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510200> <http://purl.obolibrary.org/obo/FOODON_03510115>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510201> (no beef added claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510201> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510201> <http://www.langual.org/langual_thesaurus.asp?termid=P0201>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510201> "LanguaL curation note: Denotes a product that contains no beef or beef-products. Beef is considered to be a taboo foodproduct by some religions most notable Hinduism, Boedism and Jainism."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510201> "no beef added claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510201> <http://purl.obolibrary.org/obo/FOODON_03510115>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510202> (protein special claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510202> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510202> "Food that is promoted as being either high or low in protein."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510202> <http://www.langual.org/langual_thesaurus.asp?termid=P0202>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510202> "protein special claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510202> <http://purl.obolibrary.org/obo/FOODON_03510065>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510203> (high protein food)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510203> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510203> "A claim that a food is high in protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 20 % of the energy value of the food is provided by protein [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510203> <http://www.langual.org/langual_thesaurus.asp?termid=P0203>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510203> "high protein food"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510203> <http://purl.obolibrary.org/obo/FOODON_03510202>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510204> (natural source of vitamins and or minerals claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510204> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510204> <http://www.langual.org/langual_thesaurus.asp?termid=P0204>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510204> "LanguaL curation note: A claim that a food is a natural source of vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 15% of the recommended daily allowance specified in the Annex of Council Directive 90/496/EEC per 100 g or 100 ml."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510204> "natural source of vitamins and or minerals claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510204> <http://purl.obolibrary.org/obo/FOODON_03510210>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510205> (source of fibre)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510205> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510205> "A claim that a food is a source of fibre, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 3 g of fibre per 100 g or at least 1,5 g of fibre per 100 kcal [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510205> <http://www.langual.org/langual_thesaurus.asp?termid=P0205>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510205> "source of fibre"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510205> <http://purl.obolibrary.org/obo/FOODON_03510049>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510206> (source of protein)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510206> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510206> "A claim that a food is a source of protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 12 % of the energy value of the food is provided by protein. [REGULATION (EC) No 1924/2006 Corrigendum]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510206> <http://www.langual.org/langual_thesaurus.asp?termid=P0206>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510206> "source of protein"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510206> <http://purl.obolibrary.org/obo/FOODON_03510202>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510207> (contains {name of the nutrient or other substance} nutrition claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510207> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510207> "A claim that a food contains a nutrient or another substance, for which specific conditions are not laid down in this Regulation, or any claim likely to have the same meaning for the consumer, may only be made where the product complies with all the applicable provisions of this Regulation, and in particular Article 5. For vitamins and minerals the conditions of the claim \"source of\" shall apply. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510207> <http://www.langual.org/langual_thesaurus.asp?termid=P0207>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510207> "LanguaL curation note: Used for claims like \"contains [name of the nutrient or other substance]\"."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510207> "contains {name of the nutrient or other substance} nutrition claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510207> <http://purl.obolibrary.org/obo/FOODON_03510095>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510208> (increased {name of nutrient} nutrition claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510208> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510208> "A claim stating that the content in one or more nutrients, other than vitamins and minerals, has been increased, and any claim likely to have the same meaning for the consumer, may only be made where the product meets the conditions for the claim \"source of\" and the increase in content is at least 30 % compared to a similar product. [Forordning (EF) nr. 1924/2006 Berigtigelse 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510208> <http://www.langual.org/langual_thesaurus.asp?termid=P0208>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510208> "increased {name of nutrient} nutrition claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510208> <http://purl.obolibrary.org/obo/FOODON_03510095>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510209> ("naturally/natural" label claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510209> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510209> "Where a food naturally meets the condition(s) laid down in this Annex for the use of a nutritional claim, the term \"naturally/natural\" may be used as a prefix to the claim [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510209> <http://www.langual.org/langual_thesaurus.asp?termid=P0209>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510209> "\"naturally/natural\" label claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510209> <http://purl.obolibrary.org/obo/FOODON_03510059>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510210> (source of {name of vitamin/s}  and/or {name of mineral/s} nutrition claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510210> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510210> "A claim that a food is a source of vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least a significant amount as defined in the Annex to Directive 90/496/EEC or an amount provided for by derogations granted according to Article 6 of Regulation (EC) No 1925/2006 of the European Parliament and of the Council of 20 December 2006 on the addition of vitamins and minerals and of certain other substances to foods [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510210> <http://www.langual.org/langual_thesaurus.asp?termid=P0210>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510210> "source of {name of vitamin/s}  and/or {name of mineral/s} nutrition claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510210> <http://purl.obolibrary.org/obo/FOODON_03510095>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510211> (high {name of vitamin/s} and/or {name of mineral/s} nutrition claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510211> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510211> "A claim that a food is high in vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least twice the value of \"source of [NAME OF VITAMIN/S] and/or [NAME OF MINERAL/S]\" [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510211> <http://www.langual.org/langual_thesaurus.asp?termid=P0211>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510211> "high {name of vitamin/s} and/or {name of mineral/s} nutrition claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510211> <http://purl.obolibrary.org/obo/FOODON_03510095>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510212> (reduced {name of nutrient} nutrition claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510212> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510212> "A claim stating that the content in one or more nutrients has been reduced, and any claim likely to have the same meaning for the consumer, may only be made where the reduction in content is at least 30 % compared to a similar product, except for micronutrients, where a 10 % difference in the reference values as set in Directive 90/496/EEC shall be acceptable, and for sodium, or the equivalent value for salt, where a 25 % difference shall be acceptable. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510212> <http://www.langual.org/langual_thesaurus.asp?termid=P0212>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510212> "reduced {name of nutrient} nutrition claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510212> <http://purl.obolibrary.org/obo/FOODON_03510095>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510213> (food allergen labelling)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510213> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510213> <http://www.langual.org/langual_thesaurus.asp?termid=P0213>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510213> "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510213> "food allergen labelling"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510213> <http://purl.obolibrary.org/obo/FOODON_03602001>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510214> (food allergen labelling about cereals containing gluten and products thereof)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510214> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510214> <http://www.langual.org/langual_thesaurus.asp?termid=P0214>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510214> "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs.

LanguaL curation note: Used for cereals containing gluten ( i.e. wheat, rye, barley, oats, spelt, kamut or their hybridised strains) and products thereof"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510214> "food allergen labelling about cereals containing gluten and products thereof"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510214> <http://purl.obolibrary.org/obo/FOODON_03510213>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510215> (food allergen labelling about crustaceans and products thereof)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510215> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510215> <http://www.langual.org/langual_thesaurus.asp?termid=P0215>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510215> "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510215> "food allergen labelling about crustaceans and products thereof"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510215> <http://purl.obolibrary.org/obo/FOODON_03510213>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510216> (food allergen labelling about eggs and products thereof)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510216> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510216> <http://www.langual.org/langual_thesaurus.asp?termid=P0216>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510216> "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510216> "food allergen labelling about eggs and products thereof"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510216> <http://purl.obolibrary.org/obo/FOODON_03510213>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510217> (food allergen labelling about fish and products thereof)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03510217> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510217> <http://www.langual.org/langual_thesaurus.asp?termid=P0217>)
