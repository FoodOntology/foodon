AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_511543 "WIKIPEDIA:Piper_guineense")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_511543 <http://eol.org/pages/402261>)
