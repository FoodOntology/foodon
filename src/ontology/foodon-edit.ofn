# Class: obo:FOODON_03413974 (chub mackerel (Rastrelliger genus))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413974 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413974 "Rastrelliger is a mackerel genus in the family *Scombridae*. The three species of *Rastrelliger* together with the four species of *Scomber* comprise the tribe Scombrini, known as the \"true mackerels\": Short mackerel, *R. brachysoma* (Bleeker, 1851); Island mackerel, *R. faughni* Matsui, 1967.; Indian mackerel, *R. kanagurta* (Cuvier, 1816)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413974 wikipedia:Rastrelliger)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413974 <http://eol.org/pages/25976>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413974 langual:B3974)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413974 "CEC1993:966")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413974 "EC:No 216/2009 RAX")
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03413974 "chub mackerel"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413974 "Rastrelliger Jordan and Starks in Jordan and Dickerson, 1908")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413974 "Rastrelliger spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413974 "indian mackerel"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413974 "rastrelliger spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413974 "chub mackerel (Rastrelliger genus)"@en)
SubClassOf(obo:FOODON_03413974 obo:FOODON_03411426)

