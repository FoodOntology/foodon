AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00003137 "Vaccinium elliottii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003137 "elliott's blueberry"@en)
SubClassOf(obo:FOODON_00003137 obo:FOODON_03411491)

