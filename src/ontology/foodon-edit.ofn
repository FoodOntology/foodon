AnnotationAssertion(go:hasDbXref obo:NCBITaxon_159421 "PLANTS:PAFO2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_159421 "Passiflora foetida L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "bush passionfruit"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "maya-maya"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "passiflora foetida"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "stinking passionflower"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "wild maracuja"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_159421 "wild watermelon"@en)
