# Class: <http://purl.obolibrary.org/obo/FOODON_03480017> (packed in water)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03480017> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03480017> "Water which is used as a packing medium for food material."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03480017> <http://www.langual.org/langual_thesaurus.asp?termid=K0017>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03480017> "LanguaL curation note: Used for products that are packed in water or in water containing less than 4% salt, e.g., most canned vegetables. If a product normally packed in salted water is packed in salt free water, use *NO SALT ADDED CLAIM OR USE*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03480017> "packed in water"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03480017> <http://purl.obolibrary.org/obo/FOODON_03480011>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03480018> (packed in salt brine)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03480018> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03480018> "Salt brine which is used as a packing medium for food material."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03480018> <http://www.langual.org/langual_thesaurus.asp?termid=K0018>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03480018> "LanguaL curation note: Used only for food products that are packed in a salt water solution of 4% or more. For products packed in water with less than 4% salt, use 'packed in water'."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03480018> "packed in salt brine"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03480018> <http://purl.obolibrary.org/obo/FOODON_03480011>)

