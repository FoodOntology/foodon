AnnotationAssertion(rdfs:comment obo:FOODON_03414253 "A highly esteemed edible mushroom of the genus Cortinarius found in northern regions of Europe and North America."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414325 wikipedia:Beefsteak_tomato)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414325 langual:B4325)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414325 "MANSFELD:6054")
AnnotationAssertion(rdfs:comment obo:FOODON_03414325 "A beefsteak tomato (American English) or beef tomato (British English) is any of the largest varieties of cultivated tomatoes, some weighing 1 pound (450 g) or more."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414533 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414533 wikipedia:Hypsizygus_tessellatus)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414533 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=287202>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414533 langual:B4533)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414533 "Hypsizygus tessulatus"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414533 "Hypsizygus tessulatus (Bull.) Singer")
AnnotationAssertion(rdfs:comment obo:FOODON_03414533 "Bunapi-shimeji was selected from UV-irradiated buna-shimeji (brown beech mushroom) and the breed was registered as 'hokuto shiro #1' by Hokuto Corporation."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414534 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414534 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=317053>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414534 langual:B4534)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414534 "Lyophyllum shimeji (Kawam.) Hongo")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414534 "honshimeji"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414534 "lyophyllum shimeji"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414534 "A mycorrhizal fungus (Lyophyllum shimeji) which is difficult to cultivate."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414535 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414535 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=325880>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414535 langual:B4535)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414535 "Agaricus arvensis Schaeff., 1774")
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414536 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414536 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=292351>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414536 langual:B4536)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414536 "Sheep Polypore"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414536 "Albatrellus ovinus (Schaeff.) Kotl. & Pouzar 1957")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414536 "Albatrellus ovinus"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414536 "A terrestrial polypore fungus found in western North America, and Northern Europe. It is very closely related to the more common A. subrubescens, from which it may be distinguished microscopically by the amyloid spore wall."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414537 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414537 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=208468>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414537 langual:B4537)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414537 "Amanita caesarea (Scop.) Pers. 1801")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414537 "caesar's amanita"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414537 "A highly regarded edible mushroom in the genus Amanita, native to southern Europe and North Africa.

It has a distinctive orange cap, yellow gills and stipe. Similar orange-capped species occur in North America and India. It was known to and valued by the Ancient Romans, who called it Boletus, a name now applied to a very different type of fungus. First described by Giovanni Antonio Scopoli in 1772. [Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414538 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414538 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=309751>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414538 langual:B4538)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414538 "Boletus pinophilus Pilát & Dermek 1973")
AnnotationAssertion(rdfs:comment obo:FOODON_03414538 "A basidiomycete fungus of the genus Boletus found throughout Europe. The large, edible fruiting bodies known as mushrooms appear under pine trees, generally in summer and autumn.

It has a matte brown to maroon-coloured cap and its stem is often large and swollen, and the overall colour may have an orange-red tinge. As with other boletes, the size of the fruiting body is variable. Boletus pinophilus is edible, and may be preserved and cooked. [Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414539 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414539 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=200521>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414539 langual:B4539)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414539 "Boletus aestivalis"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414539 "Boletus reticulatus Schaeff. 1774")
AnnotationAssertion(rdfs:comment obo:FOODON_03414539 "A basidiomycete fungus of the genus Boletus, occuring in deciduous forests of Europe where it forms a symbiotic mycorrhizal relationship with species of oak (Quercus). The fungus produces fruiting bodies in the summer months which are edible and popularly collected."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414540 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414540 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=327488>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414540 langual:B4540)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414540 "Cantharellus pallens Pilát 1959")
AnnotationAssertion(rdfs:comment obo:FOODON_03414540 "A fungus often taken to be just a variety of Cantharellus cibarius var. pallens, but unlike \"true\" Cantharellus cibarius it yellows and then reddens when touched and has a weaker smell. Eyssartier and Roux classify it as a separate species but say that 90% of the chanterelles sold in French markets are this, not *Cantharellus cibarius*."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414541 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414541 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=153130>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414541 langual:B4541)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414541 "trombetta dei morti"@it)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414541 "trompette de la mort"@fr)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414541 "trumpet of the dead"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414541 "Craterellus cornucopioides (L.) Pers. 1825")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:FOODON_03414541 "Cantharellus cornucopioides"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414541 "An edible mushroom of genus Craterellus shaped like a horn."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414543 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414543 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=455453>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414543 langual:B4543)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414543 "yellowfoot chanterelle"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414543 "Craterellus tubaeformis (Fr.) Quél. 1888")
AnnotationAssertion(rdfs:comment obo:FOODON_03414543 "An edible fungus, smaller than the golden chanterelle (Cantharellus cibarius) and has a dark brown cap with paler gills and a hollow yellow stem.

\"It is mycorrhizal, forming symbiotic associations with plants, making it very challenging to cultivate. ... Craterellus tubaeformis tastes stronger but less fruity than the golden chanterelle. It has a very distinctive smokey, peppery taste when raw. \" - Wikipedia"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414547 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=356812>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414547 langual:B4174)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414547 langual:B4547)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414547 "bearded hedgehog mushroom"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414547 "monkey head mushroom"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414547 "satyr's beard"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414547 "Hericium erinaceus (Bull.) Pers. 1797")
AnnotationAssertion(rdfs:comment obo:FOODON_03414547 "An edible and medicinal mushroom belonging to the tooth fungus group. Native to North America, Europe and Asia it can be identified by its long spines (greater than 1 cm length), its appearance on hardwoods and its tendency to grow a single clump of dangling spines."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414548 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414548 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=225014>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414548 langual:B4548)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414548 "Hydnum repandum L. 1753")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414548 "pied de mouton"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414548 "sweet tooth"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414548 "A basidiomycete fungus of genus Hydnum. The fungus produces fruit bodies (mushrooms) that are characterized by their spore-bearing structures—in the form of spines rather than gills—which hang down from the underside of the cap."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414549 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414549 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=219829>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414549 langual:B4549)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414549 "Hydnum rufescens Pers. 1800")
AnnotationAssertion(rdfs:comment obo:FOODON_03414549 "An edible basidiomycete of the family Hydnaceae. It belongs to the small group of mushrooms often referred to as the tooth fungi, which produce fruit bodies whose cap undersurfaces are covered by hymenophores resembling spines or teeth, and not pores or gills."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414550 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414550 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=287857>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414550 langual:B4550)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414550 "Macrolepiota procera (Scop.) Singer 1948")
AnnotationAssertion(rdfs:comment obo:FOODON_03414550 "A basidiomycete fungus with a large, prominent fruiting body resembling a parasol. It is a fairly common species on well-drained soils. It is found solitary or in groups and fairy rings in pastures and occasionally in woodland. Globally, it is widespread in temperate regions."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414551 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414551 "A species of fungus in the *Morchellaceae* family of the *Ascomycota*. It is one of the most readily recognized of all the edible mushrooms and highly sought after."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414551 wikipedia:Morchella_esculenta)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414551 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=247978>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414551 langual:B4551)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414551 "Morchella esculenta (L.) Pers 1801")
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414552 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414552 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=303973>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414552 langual:B4552)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414552 "tamogitake"@jp)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414552 "Pleurotus citrinopileatus Singer 1942")
AnnotationAssertion(rdfs:comment obo:FOODON_03414552 "An edible gilled fungus native to eastern Russia, northern China, and Japan, the golden oyster mushroom is very closely related to *Pleurotus cornucopiae* of Europe, with some authors considering them to be at the rank of subspecies."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414553 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414553 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=355683>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414553 langual:B4553)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414553 "Pleurotus djamor (Rumph. ex Fr.) Boedijn 1959")
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414944 obo:IAO_0000122)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03414944 "fairy ring mushroom"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414944 langual:B4944)
AnnotationAssertion(rdfs:comment obo:FOODON_03414944 "a mushroom of genus Marasmius which is native to North America and Europe."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03420113 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03420113 "A broad term that includes milk and its components, cream, curd and whey; use the appropriate specific term when milk or a milk product is the principal ingredient. Use the appropriate term under *MEAT ANIMAL* to index the source of the milk (note: 21 CFR 131.110 defines milk as cow's milk)."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03420113 langual:C0113)
AnnotationAssertion(rdfs:comment obo:FOODON_03420113 "LanguaL curation note: For 'whole milk' combine *MILK OR MILK PRODUCT* (A. PRODUCT TYPE) with *MILK* (C. PART OF PLANT OR ANIMAL); for 'lowfat cottage cheese' combine *UNCURED CHEESE* (A. PRODUCT TYPE) with *CURD* (C. PART OF PLANT OR ANIMAL) and *FAT PARTIALLY REMOVED* (H. TREATMENT APPLIED)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03420113 "mammalian milk or milk component"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03420236 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03420236 "Extract, concentrate or isolate high in protein; may contain amino acids, polypeptides and enzymes."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03420236 langual:C0236)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03420236 langual:H0164)
AnnotationAssertion(rdfs:label obo:FOODON_03420236 "protein extract, concentrate or isolate"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03420244 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03420244 "The serum or watery part of milk that is separated from the thicker or more coagulable part or curd, espcially in the process of making cheese; it contains lactose, minerals and lactalbumin."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03420244 langual:C0244)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03420244 "whey"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03420244 "mammalian milk whey"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460748 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000118 obo:FOODON_03460748 "milk protein added"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460748 langual:H0748)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03460748 "milk protein"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460748 "mammalian milk protein"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510156 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510156 "Foods having 140 milligrams or less sodium per amount customarily consumed (and per 50 grams of food if the amount customarily consumed is small). Meals and main dishes have 140 milligrams sodium per 100 grams of food."@en)
