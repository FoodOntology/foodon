# Class: obo:NCBITaxon_145700 (Attalea speciosa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_145700 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_145700 "*Attalea speciosa* (babassu, babassu palm, babaçu, cusi) is a palm native to the Amazon Rainforest region in South America. This plant has commercial value because its seeds produce an edible oil called babassu oil, which is also used in cleaners and skin care products. The fruit is used to produce products such as medicines, beauty aids, and beverages. Traditional communities of the Maranhão region also produce a flour from the fruit and this is commercialized as a nutritional supplement. [https://en.wikipedia.org/wiki/Attalea_speciosa]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_145700 "babassu palm plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145700 <http://eol.org/pages/1131651>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145700 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6067>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145700 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=509373>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145700 langual:B1707)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145700 "PLANTS:ORBA5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_145700 "Attalea speciosa Mart.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_145700 "Orbignya barbosiana Burret")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_145700 "babacu"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_145700 "orbignya barbosiana"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_145700 "orbignya speciosa"@en)
SubClassOf(obo:NCBITaxon_145700 obo:FOODON_03411286)

# Class: obo:NCBITaxon_145711 (Salacca zalacca)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_145711 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_145711 "Salak (*Salacca zalacca*) is a species of palm tree (family *Arecaceae*) native to Java and Sumatra in Indonesia. The fruits grow in clusters at the base of the palm, and are also known as snake fruit due to the reddish-brown scaly skin. [https://en.wikipedia.org/wiki/Salak]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_145711 "salak palm plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145711 <http://eol.org/pages/1131455>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145711 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?401079>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145711 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=817227>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145711 langual:B4927)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_145711 "Salacca zalacca (Gaertn.) Voss")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_145711 "salacca zalacca"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_145711 "snakefruit"@en)
SubClassOf(obo:NCBITaxon_145711 obo:FOODON_03411286)
SubClassOf(obo:NCBITaxon_145711 obo:FOODON_03413391)

# Class: obo:NCBITaxon_145745 (Althaea officinalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_145745 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_145745 "*Althaea officinalis* (marsh-mallow, common marshmallow) is a perennial species indigenous to Europe, Western Asia, and North Africa, which is used as a medicinal plant and ornamental plant. A confection made from the root since ancient Egyptian time evolved into today's marshmallow treat. [https://en.wikipedia.org/wiki/Althaea_officinalis]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_145745 "common marshmallow plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145745 <http://eol.org/pages/584767>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145745 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?2721>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_145745 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21610>)
