AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430115 "cracked into medium size pieces"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430115 "divided into piece(s), thickness 0.3-1.5 cm."@en)
