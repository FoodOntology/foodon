# Class: obo:NCBITaxon_49212 (Salvia hispanica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_49212 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_49212 "*Salvia hispanica*, commonly known as chia, is a species of flowering plant in the mint family, *Lamiaceae*, native to central and southern Mexico and Guatemala. Chia is grown commercially for its seed, a food that is rich in omega-3 fatty acids. Chia seeds are typically small ovals with a diameter of about 1 mm (0.039 in). They are mottle-colored with brown, gray, black and white. The seeds are hydrophilic, absorbing up to 12 times their weight in liquid when soaked. While soaking, the seeds develop a mucilaginous gel-like coating that gives chia-based beverages a distinctive texture."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_49212 "chia plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_49212 "WIKIPEDIA:Salvia_hispanica")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49212 <http://eol.org/pages/578468>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49212 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32939>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49212 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32718>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49212 langual:B1723)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49212 "PLANTS:SAHI6")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_49212 "Salvia hispanica L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49212 "salvia chia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49212 "salvia columbariae"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49212 "salvia hispanica"@en)
SubClassOf(obo:NCBITaxon_49212 obo:FOODON_03411047)

# Class: obo:NCBITaxon_49225 (Triticum turgidum subsp. dicoccum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_49225 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_49225 "Emmer wheat (*Triticum dicoccum*), also known as farro especially in Italy, is a low yielding, awned wheat. It was one of the first crops domesticated in the Near East. It was widely cultivated in the ancient world, but is now a relict crop in mountainous regions of Europe and Asia."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_49225 "emmer plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_49225 "WIKIPEDIA:Emmer")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49225 <http://eol.org/pages/1114086>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49225 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506639>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49225 langual:B3505)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_49225 "Triticum dicoccon Schrank")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49225 "farro"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49225 "triticum dicoccum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49225 "ttiticum turgidum subsp. dicoccon"@en)
SubClassOf(obo:NCBITaxon_49225 obo:FOODON_03411312)

# Class: obo:NCBITaxon_49266 (Fucus vesiculosus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_49266 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_49266 "*Fucus vesiculosus*, known by the common name bladder wrack or bladderwrack, is a seaweed found on the coasts of the North Sea, the western Baltic Sea, and the Atlantic and Pacific Oceans, also known by the common names black tang, rockweed, bladder fucus, sea oak, black tany, cut weed, dyers fucus, red fucus, and rock wrack. It was the original source of iodine, discovered in 1811, and was used extensively to treat goitre, a swelling of the thyroid gland related to iodine deficiency.  [https://en.wikipedia.org/wiki/Fucus_vesiculosus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_49266 "bladder wrack"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49266 <http://eol.org/pages/893114>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49266 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11335>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49266 langual:B4605)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_49266 asfis:fuv)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_49266 "Fucus vesiculosus")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "black tang"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "black tany"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "bladder fucus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "bladderwrack"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "cut weed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "dyers fucus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "fucus vesiculosus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "red fucus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "rock weed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "rock wrack"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_49266 "sea oak"@en)
SubClassOf(obo:NCBITaxon_49266 obo:FOODON_03414604)

