# Class: obo:FOODON_03412418 (welsh onion plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412418 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412418 "Allium fistulosum, the Welsh onion, is a species of perennial plant very similar in taste and odor to the related common onion, *Allium cepa*, and hybrids between the two (tree onions) exist. A. fistulosum, however, does not develop bulbs, and possesses hollow leaves (fistulosum means \"hollow\") and scapes. Larger varieties of the *A. fistulosum* resemble the leek, such as the Japanese negi, whilst smaller varieties resemble chives. *A. fistulosum* can multiply by forming perennial evergreen clumps. [https://en.wikipedia.org/wiki/Allium_fistulosum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 <http://eol.org/pages/8187>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?2276>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=185463>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 langual:B2418)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 "MANSFELD:126")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412418 "PLANTS:ALFI4")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "Japanese bunching onion")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "Japanese bunching onion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "Welsh onion")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "allium fistulosum"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "bunching onion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "japanese bunching onion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "long green onion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "scallion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "spanish onion plant"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412418 "spring onion plant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412418 "welsh onion plant"@en)
