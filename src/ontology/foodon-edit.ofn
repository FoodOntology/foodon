AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413428 "common marigold")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413428 "pot marigold")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413428 "calendula"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413428 "calendula officinalis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413428 "ruddles"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413428 "scottish-marigold"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413428 "marigold plant (Calendula)"@en)
