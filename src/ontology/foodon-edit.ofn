# Class: obo:NCBITaxon_82423 (Tilia platyphyllos)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_82423 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_82423 "*Tilia platyphyllos* is a species of flowering plant in the family *Malvaceae (Tiliaceae)*. It is a deciduous tree, native to much of Europe, including locally in southwestern Great Britain, growing on lime-rich soils. The common names largeleaf linden and large-leaved linden are in standard use throughout the English-speaking world except in the British Isles, where it is widely, but not universally, known as large-leaved lime. [https://en.wikipedia.org/wiki/Tilia_platyphyllos]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_82423 "bigleaf linden plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 <http://eol.org/pages/584812>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36695>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21541>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 langual:B2967)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 "MANSFELD:4863")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82423 "PLANTS:TIPL")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_82423 "Tilia platyphyllos Scop.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_82423 "tilia platyphyllos"@en)
SubClassOf(obo:NCBITaxon_82423 obo:FOODON_03412051)

