# Class: <http://purl.obolibrary.org/obo/FOODON_03414165> (pinniped group)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414165> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414165> "Pinnipeds (from Latin pinna, wing or fin, and ped-, foot) or fin-footed mammals are a widely distributed and diverse group of semiaquatic marine mammals comprising the families *Odobenidae* (the walrus), *Otariidae* (eared seals, including sea lions and fur seals), and *Phocidae* (earless seals)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414165> "WIKIPEDIA:Pinniped")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414165> <http://www.langual.org/langual_thesaurus.asp?termid=B4165>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414165> "pinniped group"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414165> <http://purl.obolibrary.org/obo/FOODON_03411122>)

