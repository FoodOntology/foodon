# Class: <http://purl.obolibrary.org/obo/FOODON_03420101> (stem or stalk (without leaves))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03420101> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420101> "Flower stem or large, fleshy leafstalk (petiole), such as a rhubarb stalk without the leaf blade. For a large, fleshy leafstalk with the leaf blade use *PLANT ABOVE SURFACE*. Compare *LEAF*, *SPEAR, SHOOT* AND *SPROUT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420101> <http://www.langual.org/langual_thesaurus.asp?termid=C0101>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420101> "stalk (without leaves)"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420101> "stem or stalk (without leaves)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420101> <http://purl.obolibrary.org/obo/FOODON_03420144>)

