AnnotationAssertion(go:hasSynonym obo:FOODON_03414296 "calonectris"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414296 "puffinus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414296 "shearwater"@en)
SubClassOf(obo:FOODON_03414296 obo:FOODON_00002616)

# Class: obo:FOODON_03414302 (allium species)

