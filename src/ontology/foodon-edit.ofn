# Class: obo:FOODON_03413792 (white truffle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413792 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413792 "The \"white truffle\" or \"trifola d'Alba\" (*Tuber magnatum*) comes from the Langhe and Montferrat areas of the Piedmont region in northern Italy and, most famously, in the countryside around the cities of Alba and Asti; in Italy it can also be found in Molise, Abruzzo, and in the hills around San Miniato, in Tuscany. It is also found on the Istria peninsula, in Croatia in the Motovun forest along the Mirna river, and in Slovenia along the Dragonja and Rizana river, as well as in the Drome area in France."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413792 "WIKIPEDIA:Truffle#White_truffle")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413792 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=184470>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413792 langual:B3792)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413792 "Tuber magnatum Picco, 1788")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413792 "alba truffle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413792 "italian white truffle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413792 "tuber magnatum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413792 "white truffle"@en)
SubClassOf(obo:FOODON_03413792 obo:FOODON_03411387)

# Class: obo:FOODON_03413793 (black truffle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413793 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413793 "Tuber melanosporum, called the black truffle, Périgord truffle or French black truffle is a species of truffle native to Southern Europe. It is one of the most expensive edible mushrooms in the world."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413793 "WIKIPEDIA:Tuber_melanosporum")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413793 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=192144>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413793 langual:B3793)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413793 "Tuber melanosporum Vittad., 1831")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413793 "black périgord truffle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413793 "french black truffle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413793 "périgord truffle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413793 "tuber melanosporum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413793 "black truffle"@en)
SubClassOf(obo:FOODON_03413793 obo:FOODON_03411387)

