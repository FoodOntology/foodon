AnnotationAssertion(go:hasDbXref obo:FOODON_03412405 langual:B2405)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412405 "anglerfishes"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412405 "lophiidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412405 "lophius spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412405 "goosefish family"@en)
SubClassOf(obo:FOODON_03412405 obo:FOODON_03412404)

