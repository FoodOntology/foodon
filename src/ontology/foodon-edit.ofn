AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510153 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510153 "Food having 35 milligrams or less sodium per amount customarily consumed (and per 50 grams of food if the amount customarily consumed is small). Meals and main dishes contain 35 milligrams or less sodium per 100 grams food."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510153 langual:P0153)
AnnotationAssertion(rdfs:label obo:FOODON_03510153 "very low sodium claim"@en)
SubClassOf(obo:FOODON_03510153 obo:FOODON_03510036)

