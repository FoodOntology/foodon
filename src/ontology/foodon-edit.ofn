AnnotationAssertion(Annotation(dcterms:license <https://creativecommons.org/licenses/by-sa/3.0>) Annotation(dcterms:rightsHolder "Hennem08") <http://schema.org/image> obo:FOODON_00003276 <https://upload.wikimedia.org/wikipedia/commons/thumb/b/b2/Red_Velvet_Cake_Waldorf_Astoria.jpg/640px-Red_Velvet_Cake_Waldorf_Astoria.jpg>)
AnnotationAssertion(rdfs:label obo:FOODON_00003276 "red velvet cake"@en)
