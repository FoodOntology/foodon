AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414514 "Brassica rapa var. parachinensis (L. H. Bailey) Hanelt")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414514 "brassica rapa var. parachinensis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414514 "chinese flowering cabbage"@en)
