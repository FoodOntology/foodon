AnnotationAssertion(go:hasSynonym obo:FOODON_03414710 "saw-sedge"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414710 "sawsedge plant"@en)
SubClassOf(obo:FOODON_03414710 obo:FOODON_03414707)

# Class: obo:FOODON_03414711 (rocklily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414711 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414711 "Arthropodium is a genus of herbaceous perennial plants in the subfamily *Lomandroideae* of the family *Asparagaceae*. It is native to Australia, New Zealand, New Caledonia and Madagascar. The rhizomes of some species can be eaten as root vegetables, including *Arthropodium cirratum*, *Arthropodium milleflorum*, *Arthropodium minus*, and *Arthropodium strictum*. [https://en.wikipedia.org/wiki/Arthropodium]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414711 <http://eol.org/pages/80109>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414711 langual:B4711)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414711 "Asparagaceae")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414711 "arthropodium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414711 "rocklily plant"@en)
SubClassOf(obo:FOODON_03414711 obo:FOODON_03411018)

# Class: obo:FOODON_03414712 (bulbine-lily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414712 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414712 "Bulbine bulbosa, commonly known as bulbine lily, is a flowering plant in the genus *Bulbine*. It is endemic to Australia. The corms of mature plants are nutritious, containing calcium and iron, and were used as food by the Aborigines. [https://en.wikipedia.org/wiki/Bulbine_bulbosa]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414712 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8116>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414712 langual:B4712)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414712 "Bulbine bulbosa (R. Br.) Haw.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414712 "Xanthorrhoeaceae")
AnnotationAssertion(rdfs:label obo:FOODON_03414712 "bulbine-lily plant"@en)
SubClassOf(obo:FOODON_03414712 obo:FOODON_03411018)

# Class: obo:FOODON_03414714 (wombat berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414714 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414714 "Eustrephus is a monotypic genus in the family *Asparagaceae*, subfamily *Lomandroideae*. *Eustrephus latifolius*, commonly named wombat berry, is the sole species of evergreen vines which grow naturally in Malesia, the Pacific Islands and eastern Australia. The tubers are eaten baked, and have an earthy sweet flavour. [https://en.wikipedia.org/wiki/Eustrephus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414714 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?16466>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414714 langual:B4714)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414714 "Asparagaceae")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414714 "Eustrephus latifolius R. Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414714 "eustrephus latifolius"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414714 "orangevine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414714 "wombat berry plant"@en)
SubClassOf(obo:FOODON_03414714 obo:FOODON_03411018)

# Class: obo:FOODON_03414715 (wild parsnip plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414715 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414715 "Trachymene incisa, wild parsnip, is a perennial herb native to eastern Australia growing in sclerophyll forest and cleared areas, with a preference for sandy soils and rock crevices. The roots are a traditional Aboriginal bushfood, and are eaten after baking in campfire coals or in earth ovens. [https://en.wikipedia.org/wiki/Trachymene_incisa]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414715 langual:B4715)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414715 "Araliaceae")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414715 "trachymene incisa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414715 "wild parsnip plant"@en)
SubClassOf(obo:FOODON_03414715 obo:FOODON_03411018)

# Class: obo:FOODON_03414718 (long yam plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414718 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414718 "Dioscorea transversa, Pencil yam, is a vine of eastern and northern Australia. The tubers are a staple food of Australian Aboriginals and are eaten after cooking, usually in ground ovens. [https://en.wikipedia.org/wiki/Dioscorea_transversa]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414718 <http://eol.org/pages/8214>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414718 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?14262>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414718 langual:B4718)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414718 "Dioscorea transversa R. Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414718 "dioscorea transversa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414718 "pencil yam"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414718 "long yam plant"@en)
SubClassOf(obo:FOODON_03414718 obo:FOODON_03413396)

# Class: obo:FOODON_03414719 (cycad plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414719 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414719 "Cycads are widely distributed across the globe and have long been exploited by people as a source of food and medicine. They contain a large amount of starch in roots, stem, seeds as well as many bioactive compounds. [http://plantnet.rbgsyd.nsw.gov.au/PlantNet/cycad/ethn.html]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414719 <http://eol.org/pages/4236>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414719 langual:B4719)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414719 "cycadopsida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414719 "cycad plant"@en)
SubClassOf(obo:FOODON_03414719 obo:FOODON_03411058)

# Class: obo:FOODON_03414720 (bowenia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414720 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414720 "Bowenia, genus of two extant and two extinct species of palmlike cycads (family *Stangeriaceae*, not accepted, should be *Zamiaceae*). The genus is endemic to Australia, and both living species are found in Queensland. Both the Byfield fern (*Bowenia serrulata*) and *Bowenia spectabilis* are sometimes cultivated as ornamentals in greenhouses and outdoors in warmer climates.https://global.britannica.com/plant/Bowenia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414720 <http://eol.org/pages/75719>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414720 langual:B4720)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414720 "bovenia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414720 "bowenia plant"@en)
SubClassOf(obo:FOODON_03414720 obo:FOODON_03414719)

# Class: obo:FOODON_03414721 (burrawong plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414721 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414721 "Macrozamia is a genus of 38-40 species of cycads, in the family *Zamiaceae*, all endemic to Australia. The common name burrawang, originally referring to *Macrozamia communis* in the Daruk Australian Aboriginal language, is often used for all the species in the genus. [https://en.wikipedia.org/wiki/Macrozamia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414721 <http://eol.org/pages/30050>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414721 langual:B4721)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414721 "burrawang"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414721 "macrozamia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414721 "burrawong plant"@en)
SubClassOf(obo:FOODON_03414721 obo:FOODON_03414719)

# Class: obo:FOODON_03414722 (cycas plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414722 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414722 "Cycas is the type genus and the only genus recognised in the family *Cycadaceae*. About 113 species are accepted. [https://en.wikipedia.org/wiki/Cycas]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414722 <http://eol.org/pages/53639>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414722 langual:B4722)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414722 "cycas spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414722 "cycas plant"@en)
SubClassOf(obo:FOODON_03414722 obo:FOODON_03414719)

# Class: obo:FOODON_03414723 (lepidozamia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414723 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414723 "Lepidozamia is a genus of two species of cycad, both endemic to Australia. *Lepidozamia hopei* (W.Hill) Regel - northern Queensland; *Lepidozamia peroffskyana* Regel - southeastern Queensland, northeastern New South Wales [https://en.wikipedia.org/wiki/Lepidozamia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414723 <http://eol.org/pages/75720>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414723 langual:B4723)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414723 "lepidozamia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414723 "lepidozamia plant"@en)
SubClassOf(obo:FOODON_03414723 obo:FOODON_03414719)

# Class: obo:FOODON_03414724 (parakeelya plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414724 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414724 "Calandrinia balonensis, commonly known as Parakeelya, is succulent herb native to central Australia. Aborigines traditionally eat the leaves raw or steamed, and roots steamed. The seeds are also ground and eaten as a paste. [https://en.wikipedia.org/wiki/Calandrinia_balonensis]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414724 <http://eol.org/pages/6360216>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414724 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?417775>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414724 langual:B4724)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414724 "Parakeelya balonensis (Lindl.) Hershk.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414724 "calandrinia balonensis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414724 "parakeelya balonensis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414724 "parakeelya plant"@en)
SubClassOf(obo:FOODON_03414724 obo:FOODON_03411058)

# Class: obo:FOODON_03414725 (bush banana plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414725 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414725 "Marsdenia australis, commonly known as the bush banana, silky pear or green vine is an Australian native plant. It is found in Central Australia and throughout Western Australia. It is a bush tucker food used by Indigenous Australians. All parts of the bush banana plant are still eaten in the desert today. [https://en.wikipedia.org/wiki/Marsdenia_australis]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414725 <http://eol.org/pages/4280>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414725 langual:B4725)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414725 "leichhardtia australis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414725 "marsdenia australis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414725 "bush banana plant"@en)
SubClassOf(obo:FOODON_03414725 obo:FOODON_03411058)

# Class: obo:FOODON_03414726 (yam daisy plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414726 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414726 "Microseris scapigera is a yellow flowered daisy, perennial, herb, found in New Zealand. It's in a group of plant species, *Cichorieae* (tribe) having milky sap, which includes Chicory and Dandelion. [https://en.wikipedia.org/wiki/Microseris_scapigera]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414726 <http://eol.org/pages/4206>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414726 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24273>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414726 langual:B4726)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414726 "Microseris scapigera (Sol. ex A. Cunn.) Sch. Bip.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414726 "microseris scapigera"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414726 "yam daisy plant"@en)
SubClassOf(obo:FOODON_03414726 obo:FOODON_03411058)

# Class: obo:FOODON_03414727 (waterlily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414727 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414727 "Nymphaea is a genus of hardy and tender aquatic plants in the family *Nymphaeaceae*. Plants of the genus are known commonly as water lilies. Water lilies have several edible parts. The young leaves and unopened flower buds can be boiled and served as a vegetable. The seeds, high in starch, protein, and oil, may be popped, parched, or ground into flour. Potato-like tubers can be collected from the species Nymphaea tuberosa. [https://en.wikipedia.org/wiki/Nymphaea]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414727 <http://eol.org/pages/60384>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414727 langual:B4727)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414727 "nymphaea spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414727 "nymphaea tuberosa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414727 "water lily"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414727 "waterlily plant"@en)
SubClassOf(obo:FOODON_03414727 obo:FOODON_03411058)

# Class: obo:FOODON_03414728 (pandan plant)

