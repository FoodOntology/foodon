AnnotationAssertion(go:hasDbXref obo:NCBITaxon_74478 asfis:hlz)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_74478 "Himanthalia elongata")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_74478 "sea spaghetti"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_74478 "thong weed"@en)
SubClassOf(obo:NCBITaxon_74478 obo:FOODON_03414510)

