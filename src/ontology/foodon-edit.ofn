# Class: obo:NCBITaxon_76930 (Nemadactylus douglasii)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_76930 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_76930 "The porae or blue morwong, *Nemadactylus douglasii*, is a morwong of the genus *Nemadactylus*, found around south eastern Australia and the north eastern coast of the North Island of New Zealand at depths of about 10 to 100 metres, on sandy and rocky coasts. Its length is between 40 and 100 cm. Max weight is at least 12 kg."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_76930 "porae"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_76930 "WIKIPEDIA:Nemadactylus_douglasii")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_76930 <http://eol.org/pages/224006>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_76930 langual:B4287)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_76930 asfis:cdd)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_76930 <https://www.frdc.com.au/knowledge-hub/standards/37377002>)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_76930 "Nemadactylus douglasii")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_76930 "grey morwong"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_76930 "nemadactylus douglasii"@en)
SubClassOf(obo:NCBITaxon_76930 obo:FOODON_03412546)

