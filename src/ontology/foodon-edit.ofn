AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414326 "valerianella spp."@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414326 "Valerianella")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414326 "Valerianella Mill.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414326 "Valerianella P. Mill.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414326 "Valerianella sp.")
AnnotationAssertion(rdfs:label obo:FOODON_03414326 "cornsalad plant"@en)
SubClassOf(obo:FOODON_03414326 obo:FOODON_03411566)

