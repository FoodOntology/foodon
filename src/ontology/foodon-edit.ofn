AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13393 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=181839>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13393 langual:B5162)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13393 "PLANTS:CAOD")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_13393 "Cananga odorata (Lam.) Hook. f. & Thomson")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13393 "cananga odorata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13393 "cananga tree"@en)
SubClassOf(obo:NCBITaxon_13393 obo:FOODON_03413359)

