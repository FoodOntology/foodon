# Class: obo:FOODON_03412341 (job's tears plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412341 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412341 "Job's Tears, Coixseed, adlay, or adlai, is a tall grain-bearing tropical plant of the family *Poaceae* (grass family) native to East Asia and peninsular Malaysia but elsewhere cultivated in gardens as an annual. The variety *Coix lacryma-jobi* var. *ma-yuen* is harvested as a cereal crop and is used medicinally in parts of Asia. [https://en.wikipedia.org/wiki/Job%27s_tears]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 <http://eol.org/pages/1114853>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11129>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=41586>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 langual:B2341)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 "MANSFELD:36435")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412341 "PLANTS:COLA")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412341 "Job's tears")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412341 "coix lacryma-jobi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412341 "job's tears plant"@en)
SubClassOf(obo:FOODON_03412341 obo:FOODON_03411047)
SubClassOf(obo:FOODON_03412341 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4505))

