# Class: obo:FOODON_03413631 (pacific seabob)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413631 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413631 "Xiphopenaeus kroyeri was first described by Camill Heller in 1862, under the name *Penaeus kroyeri*. It was transferred to the genus *Xiphopenaeus* in 1869 by Sidney Irving Smith. *X. kroyeri* has been considered conspecific with the Pacific species *X. riveti*, but recent genetic analysis indicates that the two are separate species, and that *X. kroyeri* (sensu stricto) may even constitute two cryptic species."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413631 "WIKIPEDIA:Xiphopenaeus_kroyeri")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413631 <http://eol.org/pages/7184>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413631 langual:B3631)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413631 asfis:tit)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413631 "Xiphopenaeus riveti Bouvier 1907")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413631 "xiphopenaeus kroyeri"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413631 "xiphopenaeus riveti"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413631 "pacific seabob"@en)
SubClassOf(obo:FOODON_03413631 obo:FOODON_03411081)

