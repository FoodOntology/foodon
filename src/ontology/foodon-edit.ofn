AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510161> "LanguaL curation note: Use when the 'claim or use' index term is found in the name of the food appearing on the label (e.g., 'unbleached flour' indexed by *UNBLEACHED CLAIM OR USE*)."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510161> "label claim in food name"@en)
