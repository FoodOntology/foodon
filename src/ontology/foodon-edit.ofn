AnnotationAssertion(rdfs:label obo:FOODON_03415142 "jiaogulan plant"@en)
SubClassOf(obo:FOODON_03415142 obo:FOODON_03413359)

# Class: obo:FOODON_03415144 (lady's mantle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415144 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415144 "Alchemilla is a genus of herbaceous perennial plants in the family *Rosaceae*, with the common name \"lady's mantle\" applied generically as well as specifically to *Alchemilla mollis* when referred to as garden plant, the plant used as herbal tea or for medicinal usage such as gynaecological disorders is *Alchemilla xanthochlora* or in Middle Europe the so-called common lady's mantle *Alchemilla vulgaris*. [https://en.wikipedia.org/wiki/Alchemilla]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415144 <http://eol.org/pages/29928>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415144 langual:B5144)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415144 "alchemilla"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415144 "lady's mantle plant"@en)
SubClassOf(obo:FOODON_03415144 obo:FOODON_03413359)

# Class: obo:FOODON_03415147 (rockrose plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415147 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415147 "Cistus  is a genus of flowering plants in the rockrose family *Cistaceae*, containing about 20 species. In popular medicine, infusions of cistuses are used to treat diarrhea. *Cistus incanus* specifically is traditionally used for cold, flu, respiratory tract infections, etc. [https://en.wikipedia.org/wiki/Cistus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415147 <http://eol.org/pages/38069>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415147 langual:B5147)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415147 "cistus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415147 "rock rose"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415147 "rockrose plant"@en)
SubClassOf(obo:FOODON_03415147 obo:FOODON_03413359)

# Class: obo:FOODON_03415155 (beebalm plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415155 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415155 "Monarda is a genus of flowering plants in the mint family, *Lamiaceae*. Common names include bee balm, horsemint, oswego tea, and bergamot, the latter inspired by the fragrance of the leaves. Several species, including Monarda fistulosa and M. didyma, have a long history of use as medicinal plants by many Native Americans. [https://en.wikipedia.org/wiki/Monarda]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415155 <http://eol.org/pages/37998>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415155 langual:B5155)
