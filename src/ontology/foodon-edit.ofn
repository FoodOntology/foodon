# Class: obo:FOODON_03411555 (phaseolus vulgaris plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411555 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411555 "Phaseolus vulgaris, also known as the common bean among other names,[ is a herbaceous annual plant grown worldwide for its edible dry seeds or unripe fruit. The main categories of common beans, on the basis of use, are dry beans (seeds harvested at complete maturity), snap beans (tender pods with reduced fibre harvested before the seed development phase) and shell beans (seeds harvested at physiological maturity). Its leaf is also occasionally used as a vegetable and the straw as fodder. Its botanical classification, along with other *Phaseolus* species, is as a member of the legume family *Fabaceae*, most of whose members acquire the nitrogen they require through an association with rhizobia, a species of nitrogen-fixing bacteria.[https://en.wikipedia.org/wiki/Phaseolus_vulgaris]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 <http://eol.org/pages/645324>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 obo:NCBITaxon_3885)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?27632>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312013>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=26857>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 langual:B1555)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 "MANSFELD:27559")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411555 "PLANTS:PHVU")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris L. ssp. vulgaris")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris var. vulgaris")
AnnotationAssertion(rdfs:label obo:FOODON_03411555 "phaseolus vulgaris plant"@en)
SubClassOf(obo:FOODON_03411555 obo:FOODON_03411567)
SubClassOf(obo:FOODON_03411555 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3885))

# Class: obo:FOODON_03411556 (batavia cassia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411556 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411556 "Cinnamomum burmannii, also known as Indonesian cinnamon, Padang cassia, Batavia cassia, or korintje, is one of several plants in the genus *Cinnamomum* whose bark is sold as the spice cinnamon. The most common and cheapest type of cinnamon in the US is made from powdered *C. burmannii*. [https://en.wikipedia.org/wiki/Cinnamomum_burmannii]"@en)
