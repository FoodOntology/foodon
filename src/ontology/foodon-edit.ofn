AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_13894> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_13894> "The coconut palm, *Cocos nucifera*, is a member of the family *Arecaceae* (palm family). It is the only accepted species in the genus *Cocos*. The term coconut can refer to the entire coconut palm, the seed, or the fruit, which is not a botanical nut, but a drupe. The spelling cocoanut is an old-fashioned form of the word."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_13894> "coconut palm plant"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/NCBITaxon_13894> "WIKIPEDIA:Cocos_nucifera")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_13894> <http://eol.org/pages/1091712>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_13894> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11043>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_13894> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42451>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_13894> <http://www.langual.org/langual_thesaurus.asp?termid=B1536>)
