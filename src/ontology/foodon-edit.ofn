# Class: obo:NCBITaxon_34587 (Katharina tunicata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_34587 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_34587 "*Katharina tunicata* (Wood, 1815) is commonly known as the Black Katy chiton, Black Leather chiton, Black chiton, or Leather chiton. Capable of growing up to 12 cm, the animal is generally described as being football-shaped with a black leathery girdle in which are embedded eight protective plates. The parts of the plates that are visible are sometimes (but not always) diamond-shaped in outline. The underside of the animal is dull orange or yellow."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_34587 "black katy chiton"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_34587 "WIKIPEDIA:Katharina_tunicata")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_34587 <http://eol.org/pages/450283>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_34587 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=78979>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_34587 langual:B4477)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_34587 "Katharina tunicata (W. Wood, 1815)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "black chiton"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "black leather chiton"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "gumboots"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "katharina tunicata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "leather chiton"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_34587 "leathery chiton"@en)
SubClassOf(obo:NCBITaxon_34587 obo:FOODON_03414476)

