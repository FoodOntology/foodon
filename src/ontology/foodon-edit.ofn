# Class: obo:NCBITaxon_526618 (Pelotretis flavilatus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_526618 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_526618 "The southern lemon sole, *Pelotretis flavilatus*, is a righteye flounder, the only species in the genus *Pelotretis*, found around New Zealand in enclosed waters such as estuaries, harbours, mudflats, and sandflats, in waters less than 385 m in depth. Their length is from 25 to 50 cm."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_526618 "new zealand lemon sole"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_526618 "WIKIPEDIA:Pelotretis_flavilatus")
