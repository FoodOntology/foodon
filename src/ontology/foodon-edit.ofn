# Class: obo:NCBITaxon_400990 (Solanum centrale)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_400990 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_400990 "*Solanum centrale*, the kutjera, or Australian desert raisin, is a plant native to the more arid parts of Australia. Like other \"bush tomatoes\", it has been used as a food source by Central Australia and Aboriginal groups for millennia."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_400990 "bush raisin plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_400990 wikipedia:Solanum_centrale)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_400990 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=821426>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_400990 langual:B4703)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_400990 <https://eol.org/pages/52198634>)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_400990 "Solanum centrale J.M. Black")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_400990 "australian desert raisin"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_400990 "kutjera"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_400990 "solanum centrale"@en)
SubClassOf(obo:NCBITaxon_400990 obo:FOODON_03414702)

# Class: obo:NCBITaxon_400996 (Solanum ellipticum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_400996 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_400996 "*Solanum ellipticum* is known as potato bush and under the more ambiguous name of \"bush tomato\". Native to Australia, the potato bush is a small fruiting shrub in the *Solanaceae* family. [https://en.wikipedia.org/wiki/Solanum_ellipticum]"@en)
