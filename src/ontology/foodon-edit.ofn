AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03413396> "Dioscorea L.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413396> "dioscorea spp."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413396> "dioscoreaceae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03413396> "yam plant"@en)
