# Class: obo:NCBITaxon_174187 (Amorphophallus paeoniifolius)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_174187 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_174187 "*Amorphophallus paeoniifolius*, the Elephant foot yam or Whitespot giant arum  or Stink lily, is a tropical tuber crop that offers excellent scope for adoption in the tropical countries as a cash crop due to its production potential and popularity as a vegetable in various delicious cuisines."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_174187 "whitespot giant arum plant"@en)
