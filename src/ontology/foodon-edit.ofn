# Class: obo:NCBITaxon_183220 (Abelmoschus manihot)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_183220 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_183220 "The aibika (*Abelmoschus manihot*) is a flowering plant in the mallow family Malvaceae. It was formerly considered a species of *Hibiscus*, but is now classified in the genus *Abelmoschus*. The plant is also known as the sunset muskmallow, sunset hibiscus, or hibiscus manihot.
In Japanese, this plant is known as tororo aoi and is used to make neri, a starchy substance used in making washi. In Korean, this plant is known as hwang chok kyu and is used to make dak pul, which assists in making hanji."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_183220 "sunset muskmallow plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_183220 "WIKIPEDIA:Abelmoschus_manihot")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183220 <http://eol.org/pages/584457>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183220 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?621>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183220 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21771>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183220 langual:B4283)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183220 "PLANTS:ABMA9")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_183220 "Abelmoschus manihot (L.) Medik.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_183220 "abelmoschus manihot"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_183220 "aibika"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_183220 "hibiscus manihot"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_183220 "sunset hibiscus"@en)
SubClassOf(obo:NCBITaxon_183220 obo:FOODON_03411058)
SubClassOf(obo:NCBITaxon_183220 obo:FOODON_03414282)

# Class: obo:NCBITaxon_183260 (Hibiscus sabdariffa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_183260 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_183260 "Roselle (Hibiscus sabdariffa) is a species of Hibiscus probably native to West Africa, used for the production of bast fibre and as an infusion, in which it may be known as carcade."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_183260 "roselle plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_183260 <https://en.wikipedia.org/wiki/Roselle_(plant)>)
AnnotationAssertion(obo:IAO_0000600 obo:NCBITaxon_183260 "The roselle (*Hibiscus sabdariffa*) is a species of Hibiscus native to the Old World tropics, used for the production of bast fibre and as an infusion. It is an annual or perennial herb or woody-based subshrub, growing to 2-2.5 m (7-8 ft) tall. The leaves are deeply three- to five-lobed, 8-15 cm (3-6 in) long, arranged alternately on the stems.
 
The flowers are 8-10 cm (3-4 in) in diameter, white to pale yellow with a dark red spot at the base of each petal, and have a stout fleshy calyx at the base, 1-2 cm (0.39-0.79 in) wide, enlarging to 3-3.5 cm (1.2-1.4 in), fleshy and bright red as the fruit matures. It takes about six months to mature. [Wikipedia]"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 <http://eol.org/pages/487306>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?19078>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503001>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 langual:B1691)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 "MANSFELD:13432")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_183260 "PLANTS:HISA2")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_183260 "Sorrel of Guinea")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_183260 "guinea-wort")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_183260 "hibiscus sabdariffa"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_183260 "jamaica sorrel"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_183260 "red sorrel"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_183260 "Hibiscus sabdariffa L.")
SubClassOf(obo:NCBITaxon_183260 obo:FOODON_03412082)

