# Class: obo:FOODON_03414480 (velvet scoter)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414480 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414480 "The Velvet Scoter (*Melanitta fusca*), also called a Velvet Duck or whitewing (not to be confused with the white-winged scoter), is a large sea duck, which breeds over the far north of Europe and Asia west of the Yenisey basin. A small, isolated population nests in eastern Turkey. The East Siberian and North American White-winged Scoter is sometimes considered conspecific with the Velvet Scoter, and its two constituent subspecies are then known as *M. f. stejnegeri* and *M. f. deglandi*. Velvet and White-winged Scoter, along with the Surf Scoter, are placed in the subgenus *Melanitta*, distinct from the subgenus *Oidemia*, Black and Common Scoters."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414480 <http://eol.org/pages/1048996>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414480 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175163>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414480 langual:B4480)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414480 "Velvet duck"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414480 "white-winged scoter")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414480 "whitewing"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414480 "melanitta fusca"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414480 "velvet scoter"@en)
SubClassOf(obo:FOODON_03414480 obo:FOODON_03411316)
SubClassOf(obo:FOODON_03414480 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_371864))

# Class: obo:FOODON_03414481 (mudminnow family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414481 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414481 "Umbridae (mudminnows) are a family of *Actinopterygii*, ray-finned fish that inhabit freshwater environments in temperate regions across the Northern Hemisphere. They are generally small fish, with the largest species reaching 33 centimetres (13 in) in length, and most less than half that."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414481 "WIKIPEDIA:Umbridae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414481 <http://eol.org/pages/5508>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414481 langual:B4481)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414481 "umbridae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414481 "mudminnow family"@en)
SubClassOf(obo:FOODON_03414481 obo:FOODON_03413808)

# Class: obo:FOODON_03414482 (alaska blackfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414482 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414482 "Alaska blackfish are found in swamps, ponds, lakes, and streams with vegetation for cover, in tundra and forested locations not far inland. Their range includes Alaska and the Bering Sea islands. Alaska Natives once ate these fish and fed them to their dogs, catching them in the fall and freezing them for use over winter."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414482 <http://eol.org/pages/1012685>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414482 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=162159>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414482 langual:B4482)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414482 asfis:dap)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414482 "dallia pectoralis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414482 "alaska blackfish"@en)
SubClassOf(obo:FOODON_03414482 obo:FOODON_03414481)
SubClassOf(obo:FOODON_03414482 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_75939))

# Class: obo:FOODON_03414483 (alpine sweetvetch plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414483 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414483 "Hedysarum alpinum is a species of flowering plant in the legume family known by the common name alpine sweetvetch. It has a circumpolar distribution, occurring throughout the northern latitudes of the Northern Hemisphere. In North America it is widespread in Canada and the northernmost United States, including Alaska."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414483 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414483 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?18594>)
