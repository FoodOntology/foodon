# Class: obo:FOODON_03414457 (cupuaçu plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414457 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414457 "Cupuaçu (*Theobroma grandiflorum*), also spelled cupuassu, cupuazú, and copoasu, is a tropical rainforest tree related to cacao. Common throughout the Amazon basin, it is widely cultivated in the jungles of Colombia, Bolivia and Peru and in the north of Brazil, with the largest production in Pará, followed by Amazonas, Rondônia and Acre."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414457 <http://eol.org/pages/482162>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414457 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101891>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414457 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506108>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414457 langual:B4457)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414457 "PLANTS:THGR7")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414457 "theobroma grandiflorum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414457 "cupuaçu plant"@en)
SubClassOf(obo:FOODON_03414457 obo:FOODON_03411024)
SubClassOf(obo:FOODON_03414457 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03414457 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_108881))

# Class: obo:FOODON_03414458 (advantame)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414458 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414458 "Advantame is a new ultrahigh potency sweetener and flavor enhancer derived from aspartame and vanillin."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414458 <https://caloriecontrol.org/sugar-substitutes/>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414458 langual:B4458)
AnnotationAssertion(rdfs:comment obo:FOODON_03414458 "\"Advantame is approximately 20,000 times sweeter than sugar and 100 times sweeter than aspartame.\" [https://caloriecontrol.org/sugar-substitutes/]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414458 "advantame"@en)
SubClassOf(obo:FOODON_03414458 obo:FOODON_00001618)

# Class: obo:FOODON_03414459 (cucumis species)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414459 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414459 "Cucumis is a genus of twining, tendril-bearing plants in the *Cucurbitaceae* family which includes the cucumber (*Cucumis sativus*), muskmelons (*Cucumis melo*, including cantaloupe and honeydew), the horned melon (*Cucumis metuliferus*), and the West Indian gherkin (*Cucumis anguria*). [https://en.wikipedia.org/wiki/Cucumis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414459 langual:B4459)
AnnotationAssertion(rdfs:label obo:FOODON_03414459 "cucumis species"@en)
SubClassOf(obo:FOODON_03414459 obo:FOODON_03414460)

# Class: obo:FOODON_03414460 (gourd/squash family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414460 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414460 "The *Cucurbitaceae*, also called cucurbits and the gourd family, are a plant family consisting of about 965 species in around 95 genera, the most important of which are: 
  *Cucurbita* - squash, pumpkin, zucchini, some gourds; 
  *Lagenaria* - calabash, and others that are inedible; 
  *Citrullus* - watermelon (*C. lanatus, C. colocynthis*) and others; 
  *Cucumis* - cucumber (*C. sativus*), various melons; 
  *Luffa* - luffa, loofah"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414460 wikipedia:Cucurbitaceae)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414460 langual:B4460)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414460 "cucurbitaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414460 "gourd/squash family"@en)
SubClassOf(obo:FOODON_03414460 obo:FOODON_03413357)

# Class: obo:FOODON_03414461 (golden-spoon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414461 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414461 "Byrsonima crassifolia is a species of flowering plant in the acerola family, *Malpighiaceae*, that is native to tropical America. It is valued for its small, sweet, yellow fruit, which are strongly scented. Common names include nanche, nance, chacunga, changunga, craboo, kraabu, savanna serrette (or savanna serret) and golden spoon."@en)
