# Class: obo:FOODON_03414835 (acmena plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414835 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414835 "Acmena is a genus of shrubs and small trees in the myrtle family *Myrtaceae*. They are related to guavas. The name is derived from the Greek word for \"plentiful\". The species of this genus have sometimes been treated as part of the large Old World genus *Syzygium* (which in turn has sometimes been included in *Eugenia*, although many authors limit *Eugenia* mostly to New World species). Several 2006 papers include Acmena in *Syzygium*.[https://en.wikipedia.org/wiki/Acmena]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414835 <http://eol.org/pages/8095>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414835 langual:B4835)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414835 "APNI:73475")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414835 "Acmena DC.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414835 "acmena spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414835 "eugenia spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414835 "syzygium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414835 "acmena plant"@en)
SubClassOf(obo:FOODON_03414835 obo:FOODON_03414677)

