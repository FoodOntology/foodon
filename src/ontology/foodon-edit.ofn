AnnotationAssertion(go:hasDbXref obo:NCBITaxon_85293 "PLANTS:VIOP")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_85293 "Viburnum opulus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_85293 "crampbark"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_85293 "viburnum opulus"@en)
SubClassOf(obo:NCBITaxon_85293 obo:FOODON_03411231)

