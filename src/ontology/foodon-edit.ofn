AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413737 "lincoln's-weed"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413737 "sand mustard"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413737 "sand rocket"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413737 "wall rocket"@en)
