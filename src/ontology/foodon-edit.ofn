AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413741 "PLANTS:VAAN")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413741 "lowbush blueberry")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413741 "lowbush blueberry"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413741 "sugar berry"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413741 "sweet lowbush blueberry"@en)
