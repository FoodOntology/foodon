AnnotationAssertion(go:hasSynonym obo:FOODON_03414774 "hypoxis spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414774 "star lily"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414774 "star-grass"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414774 "stargrass"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414774 "stars"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414774 "star grass plant"@en)
SubClassOf(obo:FOODON_03414774 obo:FOODON_03413359)

# Class: obo:FOODON_03414775 (northern beantree plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414775 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414775 "Lysiphyllum is a genus of flowering plants in the legume family, *Fabaceae*. It belongs to the sub family *Cercidoideae*. It was formerly treated as part of the genus *Bauhinia*, but recent molecular phylogenetic analysis confirms that *Lysiphyllum* is a distinct genus from *Bauhinia*.[https://en.wikipedia.org/wiki/Lysiphyllum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414775 <http://eol.org/pages/4277>)
