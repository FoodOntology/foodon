# Class: obo:FOODON_03413712 (plantain plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413712 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413712 "Plantago is a genus of about 200 species of small, inconspicuous plants commonly called plantains. *Plantago* species have been used since prehistoric times as herbal remedies. The herb is astringent, anti-toxic, antimicrobial, anti-inflammatory, anti-histamine, as well as demulcent, expectorant, styptic and diuretic. Externally, a poultice of the leaves is useful for insect bites, poison-ivy rashes, minor sores, and boils. In folklore it is even claimed to be able to cure snakebite. Internally, it is used for coughs and bronchitis, as a tea, tincture, or syrup. The broad-leaved varieties are sometimes used as a leaf vegetable for salads, green sauce, et cetera. Plantain seed husks expand and become mucilaginous when wet, especially those of *Plantago psyllium*, which is used in common over-the-counter bulk laxative and fiber supplement products. []"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413712 <http://eol.org/pages/4354>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413712 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317089>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413712 langual:B3712)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413712 "PLANTS:PLANT")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413712 "Plantago")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413712 "Plantago L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413712 "Plantago sp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413712 "indianwheat"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413712 "plantago spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413712 "plantain plant"@en)
SubClassOf(obo:FOODON_03413712 obo:FOODON_03411566)

# Class: obo:FOODON_03413716 (broadleaf wild leek plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413716 "Allium ampeloprasum is a member of the onion genus Allium. The wild plant is commonly known as wild leek or broadleaf wild leek. Its native range is southern Europe to western Asia, but it is cultivated in many other places and has become naturalized in many countries."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413716 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=185436>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413716 langual:B3716)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03413716 "Allium ampeloprasum var. atroviolaceum"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03413716 "Allium ampeloprasum var. atroviolaceum (Boiss.) Regel"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03413716 "broadleaf wild leek"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413716 "broadleaf wild leek plant"@en)
SubClassOf(obo:FOODON_03413716 obo:NCBITaxon_4681)

