# Class: obo:FOODON_00002555 (wagyu cattle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002555 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002555 "Wagyu is any of the four Japanese breeds of beef cattle:  Japanese Black (Kuroge Washu), Japanese Polled (Mukaku Washu), Japanese Brown (Akage Washu or Akaushi) and Japanese Shorthorn (Nihon Tankaku Washu).  In several areas of Japan, wagyu beef is shipped carrying area names. Some examples are Matsusaka beef, Kobe beef, Yonezawa beef, Mishima beef, Ōmi beef, and Sanda beef."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002555 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002555 "https://en.wikipedia.org/wiki/Wagyu"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002555 "2019-03-20T08:06:23Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Akage Washu"@ja)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Akaushi"@jp)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Japanese Black"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Japanese Brown"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Japanese Polled"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Japanese Shorthorn"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Kuroge Washu"@ja)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Mukaku Washu"@ja)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "Nihon Tankaku Washu"@ja)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "日本短角和種"@ja)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_00002555 "無角和種"@ja)
