AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430114 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430114 langual:E0114)
AnnotationAssertion(rdfs:label obo:FOODON_03430114 "food (liquid, low viscosity, with small particles)"@en)
SubClassOf(obo:FOODON_03430114 obo:FOODON_03430109)

