AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_29159 "Crassostrea gigas")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "crassostrea angulata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "crassostrea gigas"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "magallana gigas"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "pacific cupped oyster"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "pacific oyster"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "portuguese cupped oyster"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29159 "portuguese oyster"@en)
