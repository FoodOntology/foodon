SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414951> <http://purl.obolibrary.org/obo/FOODON_03411231>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414953> (purple chokeberry plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414953> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414953> "Aronia prunifolia, called the purple chokeberry, is a North American species of shrubs in the rose family. Flowers are white or pink, producing purple fruits. Many people consider the fruits to be foul-tasting. [https://en.wikipedia.org/wiki/Aronia_prunifolia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414953> <http://eol.org/pages/8097>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414953> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?104451>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414953> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=836548>)
