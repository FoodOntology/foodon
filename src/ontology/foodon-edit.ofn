AnnotationAssertion(go:hasExactSynonym obo:FOODON_03430125 "chopped"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430125 "broken into large pieces"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430125 "cut into large pieces"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430125 "divided into pieces, thickness more than 1.5 cm."@en)
