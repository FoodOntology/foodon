# Class: obo:FOODON_03414282 (mallows plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414282 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414282 "Malvaceae, or the mallows, is a family of flowering plants estimated to contain 244 genera with 4225 known species. Well-known members of economic importance include okra, cotton, cacao and durian. There are also some genera containing familiar ornamentals, such as *Alcea* (hollyhock), *Malva* (mallow) and *Lavatera* (tree mallow). The largest genera in terms of number of species include *Hibiscus* (300 species), *Sterculia* (250 species), *Dombeya* (250 species), *Pavonia* (200 species) and *Sida* (200 species). [https://en.wikipedia.org/wiki/Malvaceae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414282 <http://eol.org/pages/4321>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414282 langual:B4282)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414282 "mallows"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414282 "malvaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414282 "mallows plant"@en)
SubClassOf(obo:FOODON_03414282 obo:FOODON_03413357)

# Class: obo:FOODON_03414283 (sunset muskmallow plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414283 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414283 "The aibika (*Abelmoschus manihot*) is a flowering plant in the mallow family Malvaceae. It was formerly considered a species of *Hibiscus*, but is now classified in the genus *Abelmoschus*. The plant is also known as the sunset muskmallow, sunset hibiscus, or hibiscus manihot.
In Japanese, this plant is known as tororo aoi and is used to make neri, a starchy substance used in making washi. In Korean, this plant is known as hwang chok kyu and is used to make dak pul, which assists in making hanji."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414283 <http://eol.org/pages/584457>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414283 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?621>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414283 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21771>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414283 langual:B4283)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414283 "PLANTS:ABMA9")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414283 "aibika")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414283 "bele")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414283 "sunset-hibiscus")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414283 "abelmoschus manihot"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414283 "aibika"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414283 "hibiscus manihot"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414283 "sunset hibiscus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414283 "sunset muskmallow plant"@en)
SubClassOf(obo:FOODON_03414283 obo:FOODON_03411058)
SubClassOf(obo:FOODON_03414283 obo:FOODON_03414282)
SubClassOf(obo:FOODON_03414283 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_183220))

# Class: obo:FOODON_03414284 (muskmallow plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414284 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414284 "Abelmoschus moschatus (Abelmosk, Ambrette seeds, Annual hibiscus, Bamia Moschata, Galu Gasturi, Muskdana, Musk mallow, Musk okra, Musk seeds, Ornamental okra, Rose mallow seeds, Tropical jewel hibiscus, Yorka okra; syn. *Hibiscus abelmoschus* L.) is an aromatic and medicinal plant in the *Malvaceae* family, which is native to India. [https://en.wikipedia.org/wiki/Abelmoschus_moschatus]"@en)
