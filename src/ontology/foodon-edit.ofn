AnnotationAssertion(oboInOwl:hasDbXref obo:NCBITaxon_55577 langual:B3398)
AnnotationAssertion(oboInOwl:hasDbXref obo:NCBITaxon_55577 "MANSFELD:18876")
AnnotationAssertion(oboInOwl:hasDbXref obo:NCBITaxon_55577 "PLANTS:DIRO")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:NCBITaxon_55577 "Dioscorea rotundata Poir.")
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_55577 "common yam"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_55577 "dioscorea cayennensis subsp. rotundata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_55577 "dioscorea rotundata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_55577 "eight-months yam"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:NCBITaxon_55577 "guinea yam"@en)
