AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413487 "Allium ×proliferum (Moench) Schrad. ex Willd.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413487 "beltsville bunching onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413487 "catawissa onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413487 "egyptian onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413487 "top onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413487 "wakegi onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413487 "tree onion plant"@en)
SubClassOf(obo:FOODON_03413487 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03413487 obo:FOODON_03414302)

# Class: obo:FOODON_03413488 (angled loofah plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413488 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413488 "Luffa acutangula (Angled luffa, Ridged luffa, Vegetable Gourd, Silk squash, Sin qua) is a species of *Luffa*. It is commercially grown for its unripe fruits as a vegetable. Mature fruits are used to make cleaning sponges. Its fruit slightly resembles a cucumber with ridges. It ranges from central Asia and eastern Asia to southeastern Asia."@en)
