# Class: obo:FOODON_03411202 (pawpaw plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411202 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411202 "Asimina triloba, the papaw, pawpaw, paw paw, paw-paw, or common pawpaw, is a small deciduous tree native to the eastern United States and Canada, producing a large, yellowish-green to brown fruit. It belongs to the genus *Asimina* in the same plant family (the *Annonaceae*) as the custard-apple, cherimoya, sweetsop, ylang-ylang and soursop. 
 Pawpaw fruits have a sweet, custardish flavor somewhat similar to banana, mango, and cantaloupe, and are commonly eaten raw, but are also used to make ice cream and baked desserts. 
 The fruit of the pawpaw is a large, yellowish-green to brown berry, 2-6 in (5-16 cm) long and 1-3 in (3-7 cm) broad, weighing from 0.7-18 oz (20-500 g), containing several brown/black seeds 1/2 to 1 in (15-25 mm) in diameter embedded in the soft, edible fruit pulp. [https://en.wikipedia.org/wiki/Asimina_triloba]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411202 <http://eol.org/pages/1054816>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411202 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?4485>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411202 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=18117>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411202 langual:B1202)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411202 "PLANTS:ASTR")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411202 "pawpaw")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411202 "asimina triloba"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411202 "dog banana"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411202 "indian banana"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411202 "pawpaw plant"@en)
SubClassOf(obo:FOODON_03411202 obo:FOODON_03411539)
SubClassOf(obo:FOODON_03411202 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_12953))

