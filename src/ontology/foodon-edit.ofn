# Class: obo:NCBITaxon_95602 (Eriocheir sinensis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_95602 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_95602 "A medium-sized burrowing crab that is named for its furry claws, which resemble mittens. It is native to rivers, estuaries and other coastal habitats of eastern Asia from Korea in the north to the Fujian province of China in the south. It has also been introduced to Europe and North America where it is considered an invasive species."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_95602 "chinese mitten crab"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_95602 wikipedia:Chinese_mitten_crab)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_95602 <http://eol.org/pages/1024100>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_95602 langual:B4890)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_95602 asfis:ers)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_95602 "Eriocheir sinensis"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_95602 "Shanghai hairy crab"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_95602 "Eriocheir sinensis H. Milne Edwards, 1853")
