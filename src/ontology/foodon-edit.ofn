AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411377 langual:B1377)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411377 "MANSFELD:1655")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411377 "PLANTS:ANGEL")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411377 "Angelica")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411377 "Angelica L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411377 "Angelica archangelica L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411377 "Angelica spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411377 "angelica archangelica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411377 "angelica spp"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411377 "angelica plant"@en)
