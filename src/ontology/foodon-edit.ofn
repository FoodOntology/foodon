AnnotationAssertion(go:hasDbXref obo:NCBITaxon_80379 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=30494>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_80379 langual:B2555)
