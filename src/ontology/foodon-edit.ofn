AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57935 langual:B4962)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57935 "PLANTS:ROMA81")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_57935 "Rosa majalis Herrm.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_57935 "Rosa majalis J. Herrm.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57935 "may rose"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57935 "rosa majalis"@en)
SubClassOf(obo:NCBITaxon_57935 obo:FOODON_03411225)

