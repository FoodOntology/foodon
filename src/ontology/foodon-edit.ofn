# Class: <http://purl.obolibrary.org/obo/FOODON_03530050> (fruit ripeness)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03530050> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03530050> "A food plant physical characteristic about the ripening stage of development of a fruit."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03530050> <http://www.langual.org/langual_thesaurus.asp?termid=Z0050>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03530050> "Ripeness entails safety, nutrient composition and consumption characteristics.

This term was revised (Aug 4, 2022) from LanguaL's original \"degree of plant maturity\" label and its \"plant or plant part\" scope, which leaned heavily toward a fruit-oriented sense.  (LanguaL curation note: Use the appropriate narrower term only if ripeness is stated in the food name or label.)  FoodOn now has a separate class for plant maturity."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03530050> "fruit ripeness"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03530050> <http://purl.obolibrary.org/obo/FOODON_03530268>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03530051> (unripe)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03530051> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03530051> "A fruit ripeness characteristic in which a fruit has not achieved full maturity and is not slightly ripe."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FOODON_03530051> "immature"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03530051> <http://www.langual.org/langual_thesaurus.asp?termid=Z0051>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03530051> "This condition does not necessarily preclude utilization, for example, green tomatoes are consumed despite their relative unripeness to red tomatoes."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03530051> "unripe"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03530051> <http://purl.obolibrary.org/obo/FOODON_03530050>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03530052> (ripe)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03530052> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03530052> "A fruit ripeness characteristic in which a fruit has achieved full maturity and is ready for utilization."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FOODON_03530052> "mature"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03530052> <http://www.langual.org/langual_thesaurus.asp?termid=Z0052>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03530052> "mature"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03530052> "LanguaL curation note: Use only if ripeness is stated in the food name or label."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03530052> "ripe"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_03530052> <https://en.wikipedia.org/wiki/Ripening>)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_03530052> <https://www.npr.org/sections/thesalt/2018/09/24/650585212/science-reveals-how-fruit-keeps-a-lid-on-ripening-until-the-time-is-right>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03530052> <http://purl.obolibrary.org/obo/FOODON_03530050>)

