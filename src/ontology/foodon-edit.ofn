AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412368> "The sandperches are a family, *Pinguipedidae*, of fishes in the order Perciformes. Sandperches typically live on sand or rubble substrates in shallow seas. The anterior end of the fish is cylindrical and the posterior end partially flattened. The eyes are on the top of the head and the fish lie on the seabed, propped up by their widely separated pelvic fins. [https://en.wikipedia.org/wiki/Sandperch]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412368> <http://eol.org/pages/5265>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412368> <http://www.langual.org/langual_thesaurus.asp?termid=B2368>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412368> "pinguipedidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412368> "sandperch family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412368> <http://purl.obolibrary.org/obo/FOODON_03411581>)

