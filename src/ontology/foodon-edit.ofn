AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_36622 "Chaenomeles sinensis (Thouin) Koehne")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_36622 "Pseudocydonia sinensis (Thouin) C. K. Schneid.")
