# Class: obo:FOODON_03411300 (onion plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411300 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411300 "The onion (*Allium cepa *L), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus *Allium*. Its close relatives include the garlic, shallot, leek, chive,[2] and Chinese onion. 
 This genus also contains several other species variously referred to as onions and cultivated for food, such as the Japanese bunching onion (*Allium fistulosum*), the tree onion (*A. ×proliferum*), and the Canada onion (*Allium canadense*). The name \"wild onion\" is applied to a number of *Allium* species, but *A. cepa* is exclusively known from cultivation. [https://en.wikipedia.org/wiki/Onion]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411300 <http://eol.org/pages/8187>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411300 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300022>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411300 langual:B1300)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411300 "PLANTS:ALLIU")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411300 "Allium")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411300 "Allium L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411300 "Allium sp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411300 "allium spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411300 "bulb onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411300 "cebolla"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411300 "garden onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411300 "onion plant"@en)
SubClassOf(obo:FOODON_03411300 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03411300 obo:FOODON_03414302)

