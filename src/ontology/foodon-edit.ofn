# Class: obo:NCBITaxon_75085 (Rubus phoenicolasius)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_75085 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_75085 "*Rubus phoenicolasius* (Japanese Wineberry, Wineberry, or Wine Raspberry) is a species of raspberry (*Rubus* subgenus *Idaeobatus*) native to northern China, Japan, and Korea.  The species was introduced to Europe and North America as an ornamental plant and for its potential in breeding hybrid raspberries. It has subsequently escaped from cultivation and become naturalised and sometimes invasive in parts of Europe and eastern North America."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_75085 "wineberry plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_75085 "WIKIPEDIA:Rubus_phoenicolasius")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75085 <http://eol.org/pages/632717>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75085 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32416>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75085 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25017>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75085 langual:B4261)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75085 "PLANTS:RUPH")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_75085 "Rubus phoenicolasius Maxim.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_75085 "japanese wineberry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_75085 "rubus phoenicolasius"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_75085 "wine raspberry"@en)
SubClassOf(obo:NCBITaxon_75085 obo:FOODON_03411494)

# Class: obo:NCBITaxon_75099 (Rubus ulmifolius)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_75099 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_75099 "*Rubus ulmifolius* is a species of wild blackberry known by the English common name elmleaf blackberry or thornless blackberry and the Spanish common name zarzamora. It is native to Europe and North Africa, and it is widely known elsewhere as an introduced species and sometimes a noxious weed. It is a brambly shrub with compound leaves and small, white or pink flowers. The fruit is a blackberry."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_75099 "elmleaf blackberry plant"@en)
