AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_72648 "Tacca leontopetaloides (L.) Kuntze")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_72648 "tacca leontopetaloides"@en)
SubClassOf(obo:NCBITaxon_72648 obo:FOODON_03411016)
SubClassOf(obo:NCBITaxon_72648 obo:FOODON_03413396)

# Class: obo:NCBITaxon_73102 (Gaultheria shallon)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_73102 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_73102 "*Gaultheria shallon* is a leathery-leaved shrub in the heather family (*Ericaceae*), native to western North America. In English, it is known as salal, shallon, or simply gaultheria in Britain. Its dark blue berries and young leaves are both edible and are efficient appetite suppressants, both with a unique flavor. [https://en.wikipedia.org/wiki/Gaultheria_shallon]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_73102 "salal plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_73102 <http://eol.org/pages/582116>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_73102 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?366>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_73102 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=23658>)
