# Class: obo:NCBITaxon_3501 (Urtica dioica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3501 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3501 "Stinging nettle or common nettle, *Urtica dioica*, is a herbaceous perennial flowering plant, native to Europe, Asia, northern Africa, and North America, and is the best-known member of the nettle genus *Urtica*. The plant has many hollow stinging hairs called trichomes on its leaves and stems, which act like hypodermic needles, injecting histamine and other chemicals that produce a stinging sensation when contacted by humans and other animals. The plant has a long history of use as a medicine and as a food source."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3501 "nettle plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3501 "WIKIPEDIA:Urtica_dioica")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 <http://eol.org/pages/595063>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?40944>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=19152>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 langual:B1674)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 "MANSFELD:7662")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3501 "PLANTS:URDI")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3501 "Urtica dioica L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3501 "stinging nettle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3501 "urtica spp."@en)
SubClassOf(obo:NCBITaxon_3501 obo:FOODON_03411566)

