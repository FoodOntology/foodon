AnnotationAssertion(go:hasDbXref obo:NCBITaxon_526618 <https://www.frdc.com.au/knowledge-hub/standards/37461796>)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_526618 "Pelotretis flavilatus")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_526618 "flounder"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_526618 "pelotretis flavilatus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_526618 "southern lemon sole"@en)
