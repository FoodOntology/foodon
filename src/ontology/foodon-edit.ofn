AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414662 "Davidsonia pruriens F. Muell.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414662 "davidson's plum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414662 "davidsonia pruriens"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414662 "davidsonia-plum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414662 "do-rog"@en)
