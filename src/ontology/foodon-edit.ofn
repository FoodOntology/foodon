AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/FOODON_00005451> "This should probably be a NTR for PATO."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_00005451> <https://en.wikipedia.org/wiki/Room_temperature>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_00005451> <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00005451> "2025-08-23T19:03:13Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00005451> "Comfortable room temperature varies between cultures and regions."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00005451> "room temperature"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00005451> <http://purl.obolibrary.org/obo/PATO_0000146>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00005452> (ISO 1 reference temperature)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00005452> "A reference temperature of 20.0 Celsius which is denoted by the ISO 1 standard."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/FOODON_00005452> "This should probably be a NTR for PATO."@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_00005452> <https://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00005452> "2025-08-23T19:19:36Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00005452> "This may be the measure of an object's temperature, or of an ambient temperature.  The ISO 1 standard does not indicate any methodology for measuring this temperature."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00005452> "ISO 1 reference temperature"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_00005452> <https://nvlpubs.nist.gov/nistpubs/jres/121/jres.121.026.pdf>)
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_00005452> <https://www.iso.org/standard/80702.html>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00005452> <http://purl.obolibrary.org/obo/PATO_0000146>)

