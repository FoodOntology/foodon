AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102329 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=568098>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102329 langual:B4634)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102329 asfis:pnm)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102329 <https://www.frdc.com.au/knowledge-hub/standards/37236002>)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_102329 "pinctada margaritifera"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_102329 "Pinctada margaritifera (Linnaeus, 1758)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102329 "black-lip oyster"@en)
SubClassOf(obo:NCBITaxon_102329 obo:FOODON_03411224)

