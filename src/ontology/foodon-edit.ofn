AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411248 "Brassica napus L. emend. Metzg. var. napus")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411248 "canola"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411248 "canola plant"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411248 "oilseed rape plant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411248 "rapeseed plant"@en)
SubClassOf(obo:FOODON_03411248 obo:FOODON_03411017)
