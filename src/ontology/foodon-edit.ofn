AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37334 langual:B2018)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37334 "MANSFELD:7643")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37334 "PLANTS:CIMA5")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_37334 "Citrus grandis"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_37334 "citrus decumana"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_37334 "Citrus maxima (Burm. f.) Merr.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_37334 "Citrus maxima (Burm.) Merr.")
AnnotationAssertion(rdfs:comment obo:NCBITaxon_37334 "\"Typically, the fruit is pale green to yellow when ripe, with sweet white (or, more rarely, pink or red) flesh, and a very thick albedo (rind pith). It is a large citrus fruit, 15-25 centimetres (5.9-9.8 in) in diameter,[7] usually weighing 1-2 kilograms (2.2-4.4 lb). The fruit tastes like a sweet, mild grapefruit.\" [https://en.wikipedia.org/wiki/Pomelo]"@en)
SubClassOf(obo:NCBITaxon_37334 obo:FOODON_03411139)

