AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414843> "The Nippon orangequat is a cross between a Satsuma mandarin and a Meiwa kumquat (*Fortunella crassifolia*), hybridized by Dr. Eugene May of the USDA and introduced in 1932, and is a member of the citrofortunella group. 'Nippon' is the only named cultivar in existence.[https://en.wikipedia.org/wiki/Orangequat]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414843> <http://eol.org/pages/4414>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414843> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314878>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414843> <http://www.langual.org/langual_thesaurus.asp?termid=B4843>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414843> "×Citrofortunella spp.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414843> "citrofortunella spp."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414843> "citrus sinensis x citrus japonica"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414843> "nippon orangequat"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414843> <http://purl.obolibrary.org/obo/FOODON_03414845>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414844> (limequat)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414844> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414844> "The limequat is a citrofortunella hybrid that is the result of a cross between the key lime (*Citrus aurantifolia*) and the kumquat (*Fortunella margarita*), hybridized by Walter Tennyson Swingle in 1909.[https://en.wikipedia.org/wiki/Limequat]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414844> <http://eol.org/pages/4414>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414844> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317809>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414844> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317810>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414844> <http://www.langual.org/langual_thesaurus.asp?termid=B4844>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414844> "×Citrofortunella floridana J. W. Ingram & H. E. Moore")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414844> "×Citrofortunella swinglei J. W. Ingram & H. E. Moore")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414844> "×citrofortunella floridana"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414844> "×citrofortunella swinglei"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414844> "limequat"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414844> <http://purl.obolibrary.org/obo/FOODON_03414845>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414845> (citrofortunella hybrids plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414845> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414845> "Citrofortunella according to the Swingle system, is a hybrid genus, containing intergeneric hybrids between members of the genus Citrus and the closely related Fortunella. It is named after its two parent genera. Such hybrids often combine the cold hardiness of the Fortunella, such as the Kumquat, with some edibility properties of the citrus species. Citrofortunellas, which are all hybrids, are marked with the multiplication sign before the word \"Citrofortunella\", for example × *Citrofortunella microcarpa* or × *Citrofortunella mitis which refer to the same plant.[https://en.wikipedia.org/wiki/Citrus_taxonomy]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414845> <http://www.langual.org/langual_thesaurus.asp?termid=B4845>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414845> "citrofortunella hybrids plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414845> <http://purl.obolibrary.org/obo/FOODON_03411139>)

