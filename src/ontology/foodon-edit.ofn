SubClassOf(obo:FOODON_03414772 obo:FOODON_03413359)

# Class: obo:FOODON_03414773 (horsfieldia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414773 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414773 "Horsfieldia is the name of a genus of evergreen trees. The genus consists of about 100 species and is distributed across South Asia, from India to the Philippines and Papua New Guinea. [https://en.wikipedia.org/wiki/Horsfieldia]"@en)
