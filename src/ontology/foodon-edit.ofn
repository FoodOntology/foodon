AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_200993 "*Fumaria officinalis* (common fumitory, drug fumitory or earth smoke) is a herbaceous annual flowering plant in the poppy family *Papaveraceae*. It is the most common species of the genus *Fumaria* in Western and Central Europe. [https://en.wikipedia.org/wiki/Fumaria_officinalis]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_200993 "common fumitory plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200993 <http://eol.org/pages/590512>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200993 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?70905>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200993 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=565200>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200993 langual:B5130)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_200993 "PLANTS:FUOF")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_200993 "Fumaria officinalis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_200993 "drug fumitory"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_200993 "fumaria officinalis"@en)
SubClassOf(obo:NCBITaxon_200993 obo:FOODON_03413359)

