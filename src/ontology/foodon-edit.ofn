# Class: obo:FOODON_03414334 (greater plantain plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414334 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414334 "Plantago major (\"broadleaf plantain\" or \"greater plantain\") is a species of *Plantago*, family *Plantaginaceae*. The plant is native to most of Europe and northern and central Asia, but has widely naturalised elsewhere in the world. 
 *Plantago major* is one of the most abundant and widely distributed medicinal crops in the world. A poultice of the leaves can be applied to wounds, stings, and sores in order to facilitate healing and prevent infection."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414334 "WIKIPEDIA:Plantago_major")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 <http://eol.org/pages/579221>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 obo:NCBITaxon_29818)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?28788>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32887>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 langual:B4334)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414334 "PLANTS:PLMA2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414334 "Plantago major L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414334 "broadleaf plantain"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414334 "common plantain"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414334 "plantago major"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414334 "greater plantain plant"@en)
SubClassOf(obo:FOODON_03414334 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03414334 obo:FOODON_03413712)
SubClassOf(obo:FOODON_03414334 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_29818))

# Class: obo:FOODON_03414336 (eucheuma)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414336 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414336 "Eucheuma is a general term used to describe a group of red seaweeds/seaplants representing the Tribe *Eucheumatoideae*, used in the production of Carrageenan, an important product used in cosmetics, food processing and industrial uses, as well as a food source for those living in Indonesia and the Philippines. Some of the most significant species include *Betaphycus gelatinae*, *Eucheuma denticulatum*, and several species of the genus *Kappaphycus* including *Kappaphycus alvarezii*. Since the mid-1970\"s *Kappaphycus* and *Eucheuma* have been the major source for the expansion of the carrageenan industry."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414336 "WIKIPEDIA:Eucheuma")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414336 langual:B4336)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414336 "betaphycus gelatinae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414336 "eucheuma denticulatum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414336 "kappaphycus alvarezii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414336 "eucheuma"@en)
SubClassOf(obo:FOODON_03414336 obo:FOODON_03411743)

# Class: obo:FOODON_03414338 (aniseed myrtle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414338 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414338 "Anetholea anisata (Vickery) Peter G.Wilson (formerly *Syzygium anisatum*, *Backhousia anisata*), ringwood or aniseed tree is a rare Australian rainforest tree with an aromatic leaf that has an essential oil profile comparable to true aniseed. The leaf from cultivated plantations is used as a bushfood spice and distilled for the essential oil, and is known in the trade as aniseed myrtle or anise myrtle."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414338 "WIKIPEDIA:Syzygium_anisatum")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414338 langual:B4338)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414338 "anetholea anisata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414338 "aniseed tree"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414338 "backhousia anisata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414338 "ringwood"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414338 "syzygium anisatum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414338 "aniseed myrtle plant"@en)
SubClassOf(obo:FOODON_03414338 obo:FOODON_03411179)

# Class: obo:FOODON_03414340 (lemon myrtle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414340 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414340 "Backhousia citriodora (common names lemon myrtle, lemon scented myrtle, lemon scented ironwood) is a flowering plant in the family *Myrtaceae*, genus *Backhousia*. It is endemic to subtropical rainforests of central and south-eastern Queensland, Australia, with a natural distribution from Mackay to Brisbane. Other common names are sweet verbena tree, sweet verbena myrtle, lemon scented verbena, and lemon scented backhousia."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414340 "WIKIPEDIA:Backhousia_citriodora")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414340 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6250>)
