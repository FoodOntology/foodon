AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411241 "PLANTS:ABES")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411241 "lady's fingers")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411241 "lady's-fingers")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411241 "okra")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411241 "quiabo")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411241 "abelmoschus esculentus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411241 "gombo"@en)
