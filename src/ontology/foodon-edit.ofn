AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414827 "APNI:114587")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414827 "Persoonia pinifolia R. Br.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414827 "Persoonia pinifolia R.Br.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414827 "persoonia pinifoli"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414827 "pine-leaved geebung plant"@en)
SubClassOf(obo:FOODON_03414827 obo:FOODON_03414671)

