AnnotationAssertion(go:hasDbXref obo:FOODON_03510220 langual:P0220)
AnnotationAssertion(rdfs:comment obo:FOODON_03510220 "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510220 "food allergen labelling about milk and products thereof, including lactose"@en)
SubClassOf(obo:FOODON_03510220 obo:FOODON_03510213)

# Class: obo:FOODON_03510221 (food allergen labelling about nuts and products thereof)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510221 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510221 langual:P0221)
AnnotationAssertion(rdfs:comment obo:FOODON_03510221 "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs.

LanguaL curation note: Used for nuts i. e. Almond (Amygdalus communis L.), Hazelnut (Corylus avellana), Walnut (Juglans regia), Cashew (Anacardium occidentale), Pecan nut (Carya illinoiesis (Wangenh.) K. Koch), Brazil nut (Bertholletia excelsa), Pistachio nut (Pistacia vera), Macadamia nut and Queensland nut (Macadamia ternifolia) and products thereof."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510221 "food allergen labelling about nuts and products thereof"@en)
SubClassOf(obo:FOODON_03510221 obo:FOODON_03510213)

