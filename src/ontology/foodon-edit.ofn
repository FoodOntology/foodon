AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510180 "Food containing at least 25% less saturated fat per amount customarily consumed than the saturated fat content of a comparable food product. The comparable food product may not be 'low saturated fat'."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510180 langual:P0180)
AnnotationAssertion(rdfs:label obo:FOODON_03510180 "reduced saturated fat food"@en)
SubClassOf(obo:FOODON_03510180 obo:FOODON_03510071)

