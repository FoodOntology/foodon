# Class: obo:FOODON_03414258 (azarole plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414258 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414258 "Crataegus azarolus is a species of hawthorn known by the common names azarole, mosphilla, and Mediterranean medlar. It is native to the Mediterranean Basin and it is grown there and elsewhere as an ornamental tree and for its fruit. It has been used historically for a number of medicinal purposes."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414258 "WIKIPEDIA:Crataegus_azarolus")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414258 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12083>)
