AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411898 "PLANTS:CIAUB")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411898 "Citrus aurantium ssp. bergamia (Risso & Poit.) Wight & Arn. ex Engler")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411898 "Citrus bergamia Risso & Poit.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411898 "Citrus ×aurantium L. ssp. bergamia (Risso & Poit.) Wight & Arn. ex Engl.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411898 "citrus aurantium bergamia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411898 "citrus bergamia"@en)
