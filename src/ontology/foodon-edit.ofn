AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "bekti"@bn)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "bhetki"@bn)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "cockup"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "giant perch"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "nairfish"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "palmer"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "pla kapong"@th)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8187 "silver barramundi"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8187 "Lates calcarifer")
