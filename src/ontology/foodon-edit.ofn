# Class: obo:NCBITaxon_210376 (Flacourtia indica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_210376 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_210376 "*Flacourtia indica* (syn. *Flacourtia ramontchi*), known commonly as ramontchi, governor's plum, batoko plum, Madagascar plum and Indian plum, is a species of flowering plant native to much of Africa and tropical and temperate parts of Asia. *F. indica* and *F. ramontchi* are sometimes treated as separate species. 
 The Ramontchi fruit itself is a pome about an inch thick and red ripening purple. It is very fleshy and has 6 to 10 seeds in layered carpels. The pulp is yellow or white and sweet with an acidic tang. It is eaten raw or made into jelly or jam. It can be fermented to make wine. [https://en.wikipedia.org/wiki/Flacourtia_indica]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_210376 "governor's plum plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_210376 <http://eol.org/pages/487574>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_210376 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?17118>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_210376 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=502628>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_210376 langual:B2789)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_210376 "PLANTS:FLIN")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_210376 "Flacourtia indica (Burm. f.) Merr.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_210376 "Flacourtia indica (Burm. fil.) Merr.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "batoka plum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "flacourtia hirtiuscula"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "flacourtia indica"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "flacourtia latifolia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "flacourtia ramontchi"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "flacourtia sepiaria"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "gmelina indica"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "indian plum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_210376 "madagascar plum"@en)
SubClassOf(obo:NCBITaxon_210376 obo:FOODON_03411206)

