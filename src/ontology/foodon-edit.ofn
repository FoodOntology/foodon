AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413463 "Pelophylax ridibundus (Pallas, 1771)")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413463 "Rana esculenta Linnaeus 1758")
