AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413418 "Bambara groundnut")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413418 "bambarra groundnut")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413418 "ground-bean")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413418 "hog-peanut")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413418 "bambara bean"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413418 "bambara nut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413418 "bambara-bean"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413418 "boro (yoruba)"@en)
