AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414340 "Backhousia citriodora F. Muell.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "australian lemon myrtle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "backhousia citriodora"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "lemon ironwood"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "lemon scented backhousia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "lemon scented ironwood"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "lemon scented myrtle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "lemon scented verbena"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "sweet verbena myrtle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414340 "sweet verbena tree"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414340 "lemon myrtle plant"@en)
SubClassOf(obo:FOODON_03414340 obo:FOODON_03411179)

# Class: obo:FOODON_03414341 (european pennyroyal plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414341 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414341 "Pennyroyal refers to two plants in the mint family, *Lamiaceae*. The European pennyroyal, *Mentha pulegium*, (also called Squaw Mint, Mosquito Plant, and Pudding Grass), is a plant in the mint genus, within the family *Lamiaceae*. Crushed Pennyroyal leaves exhibit a very strong fragrance similar to spearmint. Pennyroyal is a traditional culinary herb, folk remedy, and abortifacient. The essential oil of pennyroyal is used in aromatherapy, and is also high in pulegone, a highly toxic volatile organic compound affecting liver and uterine function."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414341 <http://eol.org/pages/579696>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414341 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24079>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414341 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32270>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414341 langual:B4341)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414341 "PLANTS:MEPU")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414341 "pennyroyoal")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414341 "mentha pulegium"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414341 "pennyroyal"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414341 "european pennyroyal plant"@en)
SubClassOf(obo:FOODON_03414341 obo:FOODON_03411267)
SubClassOf(obo:FOODON_03414341 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_294739))

# Class: obo:FOODON_03414342 (savory plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414342 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414342 "Satureja is a genus of aromatic plants of the family *Lamiaceae*, related to rosemary and thyme. There are about 30 species called savories, of which Summer savory and Winter savory are the most important in cultivation."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414342 "WIKIPEDIA:Satureja")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414342 <http://eol.org/pages/4302>)
