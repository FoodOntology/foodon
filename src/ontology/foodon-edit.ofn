AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412405> "lophiidae"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412405> "lophius spp."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412405> "goosefish family"@en)
