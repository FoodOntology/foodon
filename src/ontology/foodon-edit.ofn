AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "lemon ironwood"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "lemon scented backhousia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "lemon scented ironwood"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "lemon scented myrtle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "lemon scented verbena"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "sweet verbena myrtle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414340 "sweet verbena tree"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414340 "lemon myrtle plant"@en)
