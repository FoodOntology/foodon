AnnotationAssertion(go:hasBroadSynonym obo:FOODON_00002838 "chamburo"@en)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_00002838 "mountain papaya"@en)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_00002838 "mountain pawpaw"@en)
