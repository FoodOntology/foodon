# Class: obo:FOODON_03413856 (harengula)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413856 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413856 "Harengula is a genus of herrings that occur mostly in the western Atlantic, Gulf of Mexico and the Caribbean Sea, with one species in the eastern Pacific Ocean. There are currently four described species: *Harengula clupeola* (Cuvier, 1829) (False herring); *Harengula humeralis* (Cuvier, 1829) (Redear herring); *Harengula jaguana* Poey, 1865 (Scaled herring); *Harengula thrissina* (D. S. Jordan & C. H. Gilbert, 1882) (Pacific flatiron herring) [ https://en.wikipedia.org/wiki/Harengula]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413856 "WIKIPEDIA:Harengula")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413856 <http://eol.org/pages/6893>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413856 langual:B3856)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413856 "CEC1993:178")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413856 "EC:No 216/2009 SAS")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413856 "Harengula Valenciennes in Cuvier and Valenciennes, 1847")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413856 "Harengula spp.")
AnnotationAssertion(rdfs:label obo:FOODON_03413856 "harengula"@en)
SubClassOf(obo:FOODON_03413856 obo:FOODON_03411124)

