# Class: obo:NCBITaxon_443752 (Bidyanus bidyanus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_443752 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_443752 "Silver perch (*Bidyanus bidyanus*) is a medium sized freshwater fish endemic to the Murray-Darling river system in south-eastern Australia. The scientific name comes from an aboriginal name for the species recorded by Major Mitchell on his 1832 expedition. It is not a perch, being a grunter in the family *Terapontidae*. It is the largest of the Australian grunters, capable of growing to 40 cm and 8 kg, more usually around 30 cm and up to 1.5 kg."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_443752 "silver perch"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_443752 "WIKIPEDIA:Bidyanus_bidyanus")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_443752 <http://eol.org/pages/205881>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_443752 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=168040>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_443752 langual:B4310)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_443752 asfis:byb)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_443752 <https://www.frdc.com.au/knowledge-hub/standards/37321008>)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_443752 "Bidyanus bidyanus (Mitchell 1838)")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_443752 "Bidyanus bidyanus (Mitchell, 1838)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_443752 "bidyan perch"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_443752 "bidyanus bidyanus"@en)
SubClassOf(obo:NCBITaxon_443752 obo:FOODON_03414309)

# Class: obo:NCBITaxon_443792 (Lotella rhacina)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_443792 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_443792 "The rock cod (Lotella rhacina) is a temperate fish found off the coasts of southeastern Australia, Tasmania, the Great Australian Bight and northwards up the southwestern Australia coasts. They are also found around the coasts of New Zealand and California."@en)
