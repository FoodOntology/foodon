# Class: <http://purl.obolibrary.org/obo/FOODON_03414458> (advantame)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414458> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414458> "Advantame is a new ultrahigh potency sweetener and flavor enhancer derived from aspartame and vanillin."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414458> <https://caloriecontrol.org/sugar-substitutes/>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414458> <http://www.langual.org/langual_thesaurus.asp?termid=B4458>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03414458> "\"Advantame is approximately 20,000 times sweeter than sugar and 100 times sweeter than aspartame.\" [https://caloriecontrol.org/sugar-substitutes/]"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414458> "advantame"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414458> <http://purl.obolibrary.org/obo/FOODON_00001618>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414459> (cucumis species)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414459> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414459> "Cucumis is a genus of twining, tendril-bearing plants in the *Cucurbitaceae* family which includes the cucumber (*Cucumis sativus*), muskmelons (*Cucumis melo*, including cantaloupe and honeydew), the horned melon (*Cucumis metuliferus*), and the West Indian gherkin (*Cucumis anguria*). [https://en.wikipedia.org/wiki/Cucumis]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414459> <http://www.langual.org/langual_thesaurus.asp?termid=B4459>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414459> "cucumis species"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414459> <http://purl.obolibrary.org/obo/FOODON_03414460>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414460> (gourd/squash family)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414460> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414460> "The *Cucurbitaceae*, also called cucurbits and the gourd family, are a plant family consisting of about 965 species in around 95 genera, the most important of which are: 
  *Cucurbita* - squash, pumpkin, zucchini, some gourds; 
  *Lagenaria* - calabash, and others that are inedible; 
  *Citrullus* - watermelon (*C. lanatus, C. colocynthis*) and others; 
  *Cucumis* - cucumber (*C. sativus*), various melons; 
  *Luffa* - luffa, loofah"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414460> <https://en.wikipedia.org/wiki/Cucurbitaceae>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414460> <http://www.langual.org/langual_thesaurus.asp?termid=B4460>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414460> "cucurbitaceae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414460> "gourd/squash family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414460> <http://purl.obolibrary.org/obo/FOODON_03413357>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414466> (tunicate)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414466> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414466> "Tunicates, previously known as *Urochordata* or urochordates, are members of the *Tunicata*, a subphylum of the phylum *Chordata*. They are marine filter feeders with a saclike morphology. In their respiration and feeding they take in water through an incurrent (or inhalant) siphon and expel the filtered water through an excurrent (or exhalant) siphon. Most adult tunicates are sessile and attached to rocks or similarly suitable surfaces on the ocean floor; others such as salps, doliolids and pyrosomes swim in the pelagic zone as adults. Various species are commonly known as sea squirts or sea pork."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414466> "WIKIPEDIA:Tunicate")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414466> <http://www.langual.org/langual_thesaurus.asp?termid=B4466>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414466> "oopah"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414466> "sea squirt"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414466> "tunicata"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414466> "tunicate"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414466> <http://purl.obolibrary.org/obo/FOODON_00002581>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414467> (ascidian)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414467> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414467> "Ascidiacea (commonly known as the ascidians or sea squirts) is a class in the Tunicata subphylum of sac-like marine invertebrate filter feeders. Ascidians are characterized by a tough outer \"tunic\" made of the polysaccharide tunicin, as compared to other tunicates which are less rigid."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414467> "WIKIPEDIA:Ascidiacea")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414467> <http://eol.org/pages/1486>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414467> <http://www.langual.org/langual_thesaurus.asp?termid=B4467>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414467> "ascidiacea"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414467> "sea squirts"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414467> "ascidian"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414467> <http://purl.obolibrary.org/obo/FOODON_03414466>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414470> (brown bear)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414470> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414470> "The brown bear (*Ursus arctos*) is a large bear distributed across much of northern Eurasia and North America. Adult bears generally weigh between 100 and 635 kg (220 and 1,400 lb) and its largest subspecies, the Kodiak bear, rivals the polar bear as the largest member of the bear family and as the largest land-based predator. There are several recognized subspecies within the brown bear species. In North America, two types are generally recognized, the coastal brown bear and the inland grizzly bear, and the two types could broadly define all brown bear subspecies."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414470> "WIKIPEDIA:Brown_bear")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414470> <http://eol.org/pages/328581>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414470> <http://purl.obolibrary.org/obo/NCBITaxon_9644>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414470> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180543>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414470> <http://www.langual.org/langual_thesaurus.asp?termid=B4470>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414470> "MSW3:14000970")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414470> "Ursus arctos Linnaeus, 1758")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414470> "ursus arctos"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414470> "brown bear"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414470> <http://purl.obolibrary.org/obo/FOODON_03412406>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414470> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_9644>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03414471> (kodiak bear)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414471> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414471> "The Kodiak bear (*Ursus arctos middendorffi*), also known as the Kodiak brown bear or the Alaskan grizzly bear or American brown bear, occupies the islands of the Kodiak Archipelago in South-Western Alaska. Its name in the Alutiiq language is Taquka-aq. It is the largest subspecies of brown bear."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414471> "WIKIPEDIA:Kodiak_Bear")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414471> <http://eol.org/pages/7664>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414471> <http://www.langual.org/langual_thesaurus.asp?termid=B4471>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414471> "MSW3:14000982")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414471> "Ursus arctos middendorffi Merriam, 1896")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414471> "taquka-aq"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414471> "ursus arctos middendorffi"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414471> "kodiak bear"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414471> <http://purl.obolibrary.org/obo/FOODON_03414470>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414472> (grizzly bear)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414472> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414472> "The grizzly bear (*Ursus arctos horribilis*), also known as the silvertip bear, the grizzly, or the North American brown bear, is a subspecies of brown bear (Ursus arctos) that generally lives in the uplands of western North America. This subspecies is thought to descend from Ussuri brown bears which crossed to Alaska from eastern Russia 100,000 years ago, though they did not move south until 13,000 years ago."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414472> "WIKIPEDIA:Grizzly_bear")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414472> <http://eol.org/pages/7664>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414472> <http://www.langual.org/langual_thesaurus.asp?termid=B4472>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414472> "MSW3:14000979")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414472> "Ursus arctos horribilis Ord, 1815")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414472> "grizzly"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414472> "north american brown bear"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414472> "silvertip bear"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414472> "ursus arctos horribilis"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414472> "grizzly bear"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414472> <http://purl.obolibrary.org/obo/FOODON_03414470>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414473> (california golden bear)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414473> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414473> "The California golden bear or California grizzly (*Ursus arctos californicus*) is an extinct subspecies of the brown bear. The California golden bear disappeared from the state of California in 1922, when the last one was shot in Tulare County. In 1866, a grizzly weighing 2,200 pounds was killed in Valley Center, California, the largest grizzly killed in California."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414473> "WIKIPEDIA:California_golden_bear")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414473> <http://eol.org/pages/7664>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414473> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=726987>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414473> <http://www.langual.org/langual_thesaurus.asp?termid=B4473>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414473> "MSW3:14000974")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414473> "Ursus arctos californicus Merriam, 1896")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414473> "ursus arctos californicus"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414473> "california golden bear"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414473> <http://purl.obolibrary.org/obo/FOODON_03412406>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414476> (polyplacophoran)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414476> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414476> "Chitons are small to large marine molluscs in the class *Polyplacophora*, which formerly was known as *Amphineura*. There are approximately 940 extant and 430 fossil species recognized. These molluscs are also sometimes commonly known as sea cradles or \"coat-of-mail shells\". They are also sometimes referred to more formally as loricates, polyplacophorans, and rarely as polyplacophores. Chitons have a dorsal shell which is composed of eight separate shell plates or valves. These plates overlap somewhat at the front and back edges, and yet the plates articulate well with one another."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414476> "WIKIPEDIA:Polyplacophora")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414476> <http://eol.org/pages/2680>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414476> <http://www.langual.org/langual_thesaurus.asp?termid=B4476>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "amphineura"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "chiton"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "chíton"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "loricate"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "polplacophore"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414476> "polyplacophora"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414476> "polyplacophoran"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414476> <http://purl.obolibrary.org/obo/FOODON_03412112>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414479> (white-winged scoter)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414479> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414479> "The White-winged Scoter (*Melanitta deglandi* or *Melanitta fusca deglandi*) is a large sea duck."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414479> "WIKIPEDIA:White-winged_scoter")
