AnnotationAssertion(go:hasDbXref obo:FOODON_03411236 langual:B1236)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411236 "meleagris spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411236 "turkey (bird)"@en)
SubClassOf(obo:FOODON_03411236 obo:FOODON_00002616)
