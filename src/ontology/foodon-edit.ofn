# Class: obo:FOODON_03414841 (desert caper plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414841 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414841 "The wild orange is an Australian native plant throughout Australia. Its scientific name is *Capparis mitchellii*. It was named by botanist John Lindley. It is also known as the native orange. Its name in the Arrernte language of Central Australia is merne atwakeye. It is not related to oranges and neither to the Osage-orange which is known as \"wild orange\" in North America, but to capers.[https://en.wikipedia.org/wiki/Capparis_mitchellii]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414841 <http://eol.org/pages/4220>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414841 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?414316>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414841 langual:B4841)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414841 "Capparis mitchellii Lindl.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414841 "capparis mitchellii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414841 "merne atwakeye"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414841 "native orange"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414841 "wild orange"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414841 "desert caper plant"@en)
SubClassOf(obo:FOODON_03414841 obo:FOODON_03414695)

# Class: obo:FOODON_03414842 (african pearwood plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414842 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414842 "Baillonella toxisperma (also called African pearwood, djave nut, or moabi) is a species of tree in the family *Sapotaceae*, and the only species in the genus *Baillonella*. It is found in Angola, Cameroon, the Republic of the Congo, the Democratic Republic of the Congo, Gabon and Nigeria. Its natural habitat is subtropical or tropical moist lowland forests. It is threatened by habitat loss. The moabi tree's nut oil is a key component of Baka and other indigenous people's subsistence.[https://en.wikipedia.org/wiki/Baillonella]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414842 <http://eol.org/pages/1150112>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414842 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6317>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414842 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505954>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414842 langual:B4842)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414842 "PLANTS:BATO3")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414842 "baillonella toxisperma"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414842 "djave"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414842 "djave nut"@en)
