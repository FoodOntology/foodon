# Class: <http://purl.obolibrary.org/obo/FOODON_03411710> (roaster chicken)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411710> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411710> "A young chicken between eight and 12 weeks old, of either sex, with a ready-to-cook carcass weight of five pounds or more, that is tender-meated with soft, pliable, smooth-textured skin and breastbone cartilage that is somewhat less flexible than that of a broiler or fryer."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411710> "https://www.usda.gov/media/blog/2011/11/17/poultry-classifications-get-21st-century-upgrade"^^xsd:anyURI)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411710> <http://www.langual.org/langual_thesaurus.asp?termid=B1710>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411710> "roasting chicken"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03411710> "In the past roaster chickens had been classified as three to five months old, but modern rearing practices have led to faster maturation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411710> "roaster chicken"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411710> <http://purl.obolibrary.org/obo/FOODON_03411457>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411711> (capon)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411711> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411711> "https://www.usda.gov/media/blog/2011/11/17/poultry-classifications-get-21st-century-upgrade"^^xsd:anyURI)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_03411711> "A surgically neutered male chicken younger than four months old (previously younger than eight months) that is tender-meated with soft, pliable, smooth-textured skin."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411711> <http://www.langual.org/langual_thesaurus.asp?termid=B1711>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411711> <http://purl.obolibrary.org/obo/FOODON_03411457>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411712> (stag chicken)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411712> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411712> "A male chicken (usually under 10 months of age) with coarse skin, somewhat toughened and darkened flesh, and considerable hardening of the breastbone cartilage. Their condition is intermediate between that of a roaster chicken and a rooster."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411712> <http://www.langual.org/langual_thesaurus.asp?termid=B1712>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411712> "stag chicken"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411712> <http://purl.obolibrary.org/obo/FOODON_03411457>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411713> (chicken hen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411713> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411713> "A mature female chicken (usually more than 10 months of age) with meat less tender than that of a roaster, and with a nonflexible breastbone tip."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FOODON_03411713> "hen"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411713> <http://www.langual.org/langual_thesaurus.asp?termid=B1713>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411713> "stewing chicken"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411713> "stewing hen"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411713> "chicken hen"@en)
