# Class: obo:FOODON_03414335 (yellow gentian plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414335 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414335 "Gentiana lutea (Great Yellow Gentian) is a species of gentian native to the mountains of central and southern Europe. Other names include 'Yellow Gentian', 'Bitter Root', 'Bitterwort', 'Centiyane', and 'Genciana'.
Gentian root has a long history of use as a herbal bitter in the treatment of digestive disorders and is an ingredient of many proprietary medicines."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414335 <http://eol.org/pages/483956>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414335 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?17392>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414335 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505985>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414335 langual:B4335)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414335 "PLANTS:GELU2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414335 "yellow gentian")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414335 "gentian, yellow"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414335 "gentiana lutea"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414335 "great yellow gentian"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414335 "yellow gentian plant"@en)
SubClassOf(obo:FOODON_03414335 obo:FOODON_03414334)
SubClassOf(obo:FOODON_03414335 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_38851))

# Class: obo:FOODON_03414336 (eucheuma)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414336 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414336 "Eucheuma is a general term used to describe a group of red seaweeds/seaplants representing the Tribe *Eucheumatoideae*, used in the production of Carrageenan, an important product used in cosmetics, food processing and industrial uses, as well as a food source for those living in Indonesia and the Philippines. Some of the most significant species include *Betaphycus gelatinae*, *Eucheuma denticulatum*, and several species of the genus *Kappaphycus* including *Kappaphycus alvarezii*. Since the mid-1970\"s *Kappaphycus* and *Eucheuma* have been the major source for the expansion of the carrageenan industry."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414336 "WIKIPEDIA:Eucheuma")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414336 langual:B4336)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414336 "betaphycus gelatinae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414336 "eucheuma denticulatum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414336 "kappaphycus alvarezii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414336 "eucheuma"@en)
SubClassOf(obo:FOODON_03414336 obo:FOODON_03411743)

# Class: obo:FOODON_03414337 (sea thong)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414337 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414337 "Himanthalia elongata is a brown alga in the order *Fucales*, also known by the common names thongweed, sea thong and sea spaghetti. It is found in the north east Atlantic Ocean and the North Sea. 
According to the World Register of Marine Species, *Himanthalia elongata* is the only member of its genus, *Himanthalia* Lyngbye, 1819 [2] and the only member of its family, *Himanthaliaceae* (Kjellman) De Toni, 1891."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414337 <http://eol.org/pages/893096>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414337 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11361>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414337 langual:B4337)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414337 asfis:hlz)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414337 "sea spaghetti"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414337 "thong weed"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414337 "sea thong"@en)
SubClassOf(obo:FOODON_03414337 obo:FOODON_03414510)
SubClassOf(obo:FOODON_03414337 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_74478))

# Class: obo:FOODON_03414338 (aniseed myrtle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414338 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414338 "Anetholea anisata (Vickery) Peter G.Wilson (formerly *Syzygium anisatum*, *Backhousia anisata*), ringwood or aniseed tree is a rare Australian rainforest tree with an aromatic leaf that has an essential oil profile comparable to true aniseed. The leaf from cultivated plantations is used as a bushfood spice and distilled for the essential oil, and is known in the trade as aniseed myrtle or anise myrtle."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414338 "WIKIPEDIA:Syzygium_anisatum")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414338 langual:B4338)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414338 "anetholea anisata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414338 "aniseed tree"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414338 "backhousia anisata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414338 "ringwood"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414338 "syzygium anisatum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414338 "aniseed myrtle plant"@en)
SubClassOf(obo:FOODON_03414338 obo:FOODON_03411179)

# Class: obo:FOODON_03414339 (kaffir lime plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414339 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414339 "The kaffir lime (*Citrus × hystrix*, *Rutaceae*) is also known as combava, kieffer lime, limau purut, jeruk purut or makrut lime, Kabuyao (Cabuyao). It is a lime native to Indochinese and Malesian ecoregions in India, Laos, Indonesia, Malaysia and Thailand, and adjacent countries. It is used in Southeast Asian cuisine."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414339 <http://eol.org/pages/2906075>)
