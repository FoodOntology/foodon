# Class: obo:FOODON_00002457 (food (fresh))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002457 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002457 "Fresh food is food that has not been subjected to food preservation processes (including freezing) that alter its harvested state significantly."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002457 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002457 "https://en.wikipedia.org/wiki/Fresh_food"^^xsd:anyURI)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00002457 "Wikipedia defines fresh food as:\"food which has not been preserved and has not spoiled yet. For vegetables and fruits, this means that they have been recently harvested and treated properly postharvest; for meat, it has recently been slaughtered and butchered; for fish, it has been recently caught or harvested and kept cold.\""@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002457 "food (fresh)"@en)
SubClassOf(obo:FOODON_00002457 obo:FOODON_03311126)

# Class: obo:FOODON_00002463 (food (pan-fried))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002463 "Food material which has been pan-fried."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002463 "pan-fried"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002463 "food (pan-fried)"@en)
