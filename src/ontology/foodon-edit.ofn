# Class: obo:FOODON_03411751 (clementine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411751 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411751 "A clementine (*Citrus × clementina*) is a tangor, a hybrid between a willowleaf mandarin orange (*C. × deliciosa*) and a sweet orange (*C. × sinensis*), so named in 1902. The exterior is a deep orange colour with a smooth, glossy appearance. Clementines can be separated into 7 to 14 segments. Similar to tangerines, they tend to be easy to peel. They are typically juicy and sweet, with less acid than oranges. [https://en.wikipedia.org/wiki/Clementine]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411751 <http://eol.org/pages/4414>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411751 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314344>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411751 langual:B1751)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411751 "Citrus clementina hort. ex Tanaka")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411751 "citrus clementina"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411751 "citrus reticulata cv. clementine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411751 "clementine plant"@en)
SubClassOf(obo:FOODON_03411751 obo:FOODON_03411139)

