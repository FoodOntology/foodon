SubClassOf(obo:FOODON_03414516 obo:FOODON_03411189)

# Class: obo:FOODON_03414517 (common cattail plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414517 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414517 "Typha latifolia (bulrush, common bulrush, broadleaf cattail, common cattail, great reedmace, cooper's reed, cumbungi) is a perennial herbaceous plant in the genus *Typha*. It is found as a native plant species in North and South America, Europe, Eurasia, and Africa."@en)
