AnnotationAssertion(go:hasDbXref obo:FOODON_03411507 langual:B1507)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411507 "MANSFELD:7654")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411507 "PLANTS:CIPA3")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411507 "Citrus X paradisi Macfad. (pro sp.)")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411507 "Citrus paradisi Macfad.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411507 "Citrus x paradisi Macfad.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411507 "Citrus ×paradisi Macfad. (pro sp.)")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411507 "citrus paradisi"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411507 "citrus x paradisi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411507 "grapefruit plant"@en)
SubClassOf(obo:FOODON_03411507 obo:FOODON_03411139)
SubClassOf(obo:FOODON_03411507 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_37656))

