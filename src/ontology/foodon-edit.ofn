AnnotationAssertion(go:hasDbXref obo:FOODON_03414681 langual:B4681)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414681 "PLANTS:PADE18")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414681 "Panicum decompositum R. Br.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414681 "Whiteochloa cymbiformis (Hughes) B. K. Simon")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414681 "panicum australianse"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414681 "panicum cymbiforme"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414681 "panicum decompositum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414681 "whiteochloa cymbiformis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414681 "australian millet plant"@en)
SubClassOf(obo:FOODON_03414681 obo:FOODON_03412505)

# Class: obo:FOODON_03414682 (peanut tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414682 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414682 "Sterculia quadrifida, also known as the peanut tree, or red-fruited kurrajong is a small tree that grows in the rainforests, vine thickets and gallery forests of coastal Queensland, the Northern Territory and north-eastern New South Wales. Seed pods contain up to 8 black seeds that are edible and taste like raw peanuts. [https://en.wikipedia.org/wiki/Sterculia_quadrifida]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414682 <http://eol.org/pages/4321>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414682 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101919>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414682 langual:B4682)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414682 "Sterculia quadrifida R. Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414682 "red-fruit kurrajong"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414682 "sterculia quadrifida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414682 "peanut tree"@en)
SubClassOf(obo:FOODON_03414682 obo:FOODON_03411174)

# Class: obo:FOODON_03414683 (brown pine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414683 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414683 "Podocarpus is a genus of conifers, the most numerous and widely distributed of the podocarp family, *Podocarpaceae*. The genus occurs from southern Chile north to Mexico in the Americas and from New Zealand north to Japan in the Asia-Pacific region. [https://en.wikipedia.org/wiki/Podocarpus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414683 <http://eol.org/pages/13999>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414683 langual:B4683)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414683 "alpine pine"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414683 "podocarpus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414683 "brown pine plant"@en)
SubClassOf(obo:FOODON_03414683 obo:FOODON_03411174)

# Class: obo:FOODON_03414684 (araucaria tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414684 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414684 "Araucaria is a genus of evergreen coniferous trees in the family *Araucariaceae*. There are 19 extant species in New Caledonia (where 13 species are endemic), Norfolk Island, eastern Australia, New Guinea, Argentina, Chile, and southern Brazil. The edible large seeds of *Araucaria araucana*, *Araucaria angustifolia* and *Araucaria bidwillii* - also known as Araucaria nuts, and often called, although improperly, pine nuts - are eaten as food (particularly among the Mapuche people and Native Australians). In South America Araucaria nuts or seeds are called piñas [https://en.wikipedia.org/wiki/Araucaria]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414684 <http://eol.org/pages/4067>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414684 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?460224>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414684 langual:B4684)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414684 "PLANTS:ARAUC2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414684 "Araucaria")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414684 "Araucaria Juss.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414684 "Araucaria spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414684 "araucaria spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414684 "auracaria nut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414684 "araucaria tree"@en)
SubClassOf(obo:FOODON_03414684 obo:FOODON_03411062)

# Class: obo:FOODON_03414685 (atherton oak plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414685 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414685 "Athertonia diversifolia, commonly known as Atherton Oak, is a small to medium-sized rainforest tree of the family *Proteaceae* found in northern Queensland, Australia. A relative of the macadamia, it has potential as an ornamental tree and has an edible nut. 
[https://en.wikipedia.org/wiki/Athertonia_diversifolia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414685 <http://eol.org/pages/4370>)
