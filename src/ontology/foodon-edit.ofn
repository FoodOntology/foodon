AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413421 langual:B3421)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413421 "PLANTS:SANGU2")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413421 "Great burnet (Sanguisorba officinalis L.; Poterium officinala A. Gray) ; Salad burnet (Sanguisorba minor Scop.; syn: Poterium sanguisorba L.)")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413421 "sanguisorba"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413421 "burnet plant"@en)
SubClassOf(obo:FOODON_03413421 obo:FOODON_03411179)

