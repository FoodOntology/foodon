# Class: obo:FOODON_03412476 (sea lettuce)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412476 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412476 "The sea lettuces comprise the genus *Ulva*, a group of edible green algae that is widely distributed along the coasts of the world's oceans. The type species within the genus *Ulva* is *Ulva lactuca* Linnaeus, \"lactuca\" meaning lettuce. Additionally, some species in the algae genus *Monostroma* are known as slender sea lettuces.  *Ulva lactuca* [EU Regulation, see http://eunis.eea.europa.eu/species/65984]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412476 "WIKIPEDIA:Sea_lettuce")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412476 langual:B2476)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412476 "Ulva Linnaeus, 1753")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412476 "ulva spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412476 "sea lettuce"@en)
SubClassOf(obo:FOODON_03412476 obo:FOODON_03412502)

