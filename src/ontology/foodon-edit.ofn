AnnotationAssertion(go:hasSynonym obo:FOODON_03414778 "canary cheesewood"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414778 "cheesewood"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414778 "leichhardt-tree"@en)
