# Class: obo:NCBITaxon_290260 (Jubaea chilensis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_290260 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_290260 "*Jubaea* is a genus of palms (family *Arecaceae*) with one species, *Jubaea chilensis*, or *J. spectabilis*, the Chilean wine palm or Chile cocopalm. The common name refers to the past use of the sap from the trunk of this palm to produce a fermented beverage. The sap is also boiled down into a syrup and sold locally as miel de palma. The tree also produces small round fruits that are about 2-3 centimetres (0.79-1.18 in) in diameter. The fruit has a very hard outer shell and whitish meat on the inside, like a miniature coconut. [https://en.wikipedia.org/wiki/Jubaea]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_290260 "chile cocopalm plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_290260 <http://eol.org/pages/1142626>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_290260 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20718>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_290260 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506726>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_290260 langual:B5020)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_290260 "PLANTS:JUCH3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_290260 "Jubaea chilensis (Molina) Baill.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_290260 "chilean coco palm"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_290260 "chilean wine palm"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_290260 "jubaea chilensis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_290260 "jubaea spectabilis"@en)
SubClassOf(obo:NCBITaxon_290260 obo:FOODON_03411485)

