AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412455> <http://www.langual.org/langual_thesaurus.asp?termid=B2455>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03412455> "Acacia pennata (L.) Willd.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412455> "acacia pennata"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412455> "cha om"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412455> "climbing wattle plant"@en)
