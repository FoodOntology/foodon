AnnotationAssertion(go:hasDbXref obo:FOODON_03411999 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312013>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411999 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=26857>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411999 langual:B1999)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411999 "MANSFELD:27559")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411999 "PLANTS:PHVU")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411999 "Phaseolus vulgaris L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411999 "Phaseolus vulgaris var. vulgaris")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411999 "phaseolus vulgaris"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411999 "pink bean"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411999 "small white bean"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411999 "yellow bean"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411999 "common bean plant"@en)
SubClassOf(obo:FOODON_03411999 obo:FOODON_03411061)

