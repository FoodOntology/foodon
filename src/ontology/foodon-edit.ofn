AnnotationAssertion(go:hasSynonym obo:NCBITaxon_174549 "mountain flax"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_174549 "polygala senega"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_174549 "rattlesnake root"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_174549 "senega snakeroot"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_174549 "senegaroot"@en)
