AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510241 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510241 "COMMISSION REGULATION (EU) No 116/2010 of 9 February 2010 amending Regulation (EC) No 1924/2006 of the European Parliament and of the Council with regard to the list of nutrition claims."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510241 langual:P0241)
AnnotationAssertion(rdfs:label obo:FOODON_03510241 "monounsaturated fat claim"@en)
SubClassOf(obo:FOODON_03510241 obo:FOODON_03510247)

# Class: obo:FOODON_03510242 (polyunsaturated fat claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510242 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510242 "COMMISSION REGULATION (EU) No 116/2010 of 9 February 2010 amending Regulation (EC) No 1924/2006 of the European Parliament and of the Council with regard to the list of nutrition claims"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510242 langual:P0242)
AnnotationAssertion(rdfs:label obo:FOODON_03510242 "polyunsaturated fat claim"@en)
SubClassOf(obo:FOODON_03510242 obo:FOODON_03510247)

# Class: obo:FOODON_03510243 (high monounsaturated fat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510243 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510243 "A claim that a food is high in monounsaturated fat, and any claim likely to have the same meaning for the consumer, may only be made where at least 45 % of the fatty acids present in the product derive from monounsaturated fat under the condition that monounsaturated fat provides more than 20 % of energy of the product [COMMISSION REGULATION (EU) No 116/2010 of 9 February 2010 amending Regulation (EC) No 1924/2006 of the European Parliament and of the Council with regard to the list of nutrition claims]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510243 langual:P0243)
AnnotationAssertion(rdfs:label obo:FOODON_03510243 "high monounsaturated fat"@en)
SubClassOf(obo:FOODON_03510243 obo:FOODON_03510241)

# Class: obo:FOODON_03510244 (omega-3 fatty acids claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510244 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510244 langual:P0244)
AnnotationAssertion(rdfs:label obo:FOODON_03510244 "omega-3 fatty acids claim"@en)
SubClassOf(obo:FOODON_03510244 obo:FOODON_03510242)

# Class: obo:FOODON_03510245 (high omega-3 fatty acids)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510245 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510245 "A claim that a food is high in omega-3 fatty acids, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 0,6 g alpha-linolenic acid per 100 g and per 100 kcal, or at least 80 mg of the sum of eicosapentaenoic acid and docosahexaenoic acid per 100 g and per 100 kcal [COMMISSION REGULATION (EU) No 116/2010 of 9 February 2010 amending Regulation (EC) No 1924/2006 of the European Parliament and of the Council with regard to the list of nutrition claims]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510245 langual:P0245)
AnnotationAssertion(rdfs:label obo:FOODON_03510245 "high omega-3 fatty acids"@en)
SubClassOf(obo:FOODON_03510245 obo:FOODON_03510244)

# Class: obo:FOODON_03510246 (high polyunsaturated fat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510246 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510246 "A claim that a food is high in polyunsaturated fat, and any claim likely to have the same meaning for the consumer, may only be made where at least 45 % of the fatty acids present in the product derive from polyunsaturated fat under the condition that polyunsaturated fat provides more than 20 % of energy of the product [COMMISSION REGULATION (EU) No 116/2010 of 9 February 2010 amending Regulation (EC) No 1924/2006 of the European Parliament and of the Council with regard to the list of nutrition claims]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510246 langual:P0246)
AnnotationAssertion(rdfs:label obo:FOODON_03510246 "high polyunsaturated fat"@en)
SubClassOf(obo:FOODON_03510246 obo:FOODON_03510242)

