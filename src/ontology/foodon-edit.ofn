# Class: <http://purl.obolibrary.org/obo/FOODON_03414500> (ground squirrel)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414500> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414500> "Spermophilus is a genus of ground squirrels in the family *Sciuridae*. The majority of ground squirrel species, over 40 in total, are usually placed in this genus. However, *Spermophilus* in the broad sense has been found to be paraphyletic to the certainly distinct prairie dogs, marmots, and antelope squirrels, so it has been split into several genera by Kristofer Helgen and colleagues."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414500> "WIKIPEDIA:Spermophilus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414500> <http://eol.org/pages/15104>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414500> <http://www.langual.org/langual_thesaurus.asp?termid=B4500>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414500> "spermophilus"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414500> "ground squirrel"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414500> <http://purl.obolibrary.org/obo/FOODON_03411389>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414501> (arctic ground squirrel)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414501> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414501> "The Arctic ground squirrel (*Urocitellus parryii*) is a species of ground squirrel native to the Arctic. People in Alaska, particularly around the Aleutians, refer to them as \"Parka\" (pronounced \"par'kee\") squirrels. probably because their pelt is good for making the fur edging on the hoods of Parka style jackets."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414501> "WIKIPEDIA:Spermophilus_parryii")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414501> <http://eol.org/pages/8703>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414501> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180146>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414501> <http://www.langual.org/langual_thesaurus.asp?termid=B4501>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414501> "Spermophilus parryii (Richardson, 1825)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414501> "spermophilus parryii"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414501> "urocitellus parryii"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414501> "arctic ground squirrel"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414501> <http://purl.obolibrary.org/obo/FOODON_03414500>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414505> (scallop squash plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414505> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414505> "Pattypan squash, sunburst squash, cibleme in Cajun French, white squash, scallopini or yellow squash in Australian English, is a summer squash (species *Cucurbita pepo*) notable for its small size, round and shallow shape, and scalloped edges, somewhat resembling a small toy top, or flying saucer."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414505> "WIKIPEDIA:Pattypan_squash")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414505> <http://www.langual.org/langual_thesaurus.asp?termid=B4505>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414505> "pattypan squash plant"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414505> "scallop squash plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414505> <http://purl.obolibrary.org/obo/FOODON_03411190>)

