# Class: obo:FOODON_03411225 (rose plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411225 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411225 "A rose is a woody perennial flowering plant of the genus *Rosa*, in the family *Rosaceae*, or the flower it bears. There are over a hundred species and thousands of cultivars. Rose hips are occasionally made into jam, jelly, marmalade, and soup or are brewed for tea, primarily for their high vitamin C content. They are also pressed and filtered to make rose hip syrup. Rose hips are also used to produce rose hip seed oil, which is used in skin products and some makeup products. [https://en.wikipedia.org/wiki/Rose]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411225 <http://eol.org/pages/8097>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411225 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300516>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411225 langual:B1225)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411225 "PLANTS:ROSA5")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411225 "Rosa")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411225 "Rosa L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411225 "Rosa spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411225 "rosa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411225 "rosaceae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411225 "rosae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411225 "rose plant"@en)
SubClassOf(obo:FOODON_03411225 obo:FOODON_03411179)

