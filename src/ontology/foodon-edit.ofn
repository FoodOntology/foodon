# Class: <http://purl.obolibrary.org/obo/FOODON_03415023> (filbert plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03415023> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03415023> "Corylus maxima, the filbert, is a species of hazel native to southeastern Europe and southwestern Asia, from the Balkans to Ordu in Turkey. The filbert is similar to the related common hazel, *C. avellana*, differing in having the nut more fully enclosed by the tubular involucre. This feature is shared by the beaked hazel *C. cornuta* of North America, and the Asian beaked hazel *C. sieboldiana* of eastern Asia. [https://en.wikipedia.org/wiki/Corylus_maxima]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03415023> <http://eol.org/pages/5528>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03415023> <http://www.langual.org/langual_thesaurus.asp?termid=B5023>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03415023> "PLANTS:COMA18")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03415023> "corylus maxima"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03415023> "european filbert"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03415023> "giant filbert"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03415023> "Corylus maxima Mill.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03415023> "filbert plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03415023> <http://purl.obolibrary.org/obo/FOODON_03411533>)

