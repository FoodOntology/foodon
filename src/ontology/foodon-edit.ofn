AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_542674 "Phyla dulcis (Trevir.) Moldenke")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_542674 "honeyherb"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_542674 "lippia dulcis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_542674 "mexican lippia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_542674 "phyla dulcis"@en)
SubClassOf(obo:NCBITaxon_542674 obo:FOODON_03411179)

