AnnotationAssertion(rdfs:label obo:FOODON_00003229 "absinthe"@en)
SubClassOf(obo:FOODON_00003229 obo:FOODON_00001817)

# Class: obo:FOODON_00003251 (ox)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003251 "A castrated adult cattle male (occasionally a female or in some areas a bull) kept for draft or riding purposes."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003251 <http://orcid.org/0000-0002-8844-9165>)
