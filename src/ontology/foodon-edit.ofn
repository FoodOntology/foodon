AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414823 "Buchanania obovata Engl.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414823 "buchanania"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414823 "green-plum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414823 "wild mango"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414823 "green plum plant"@en)
SubClassOf(obo:FOODON_03414823 obo:FOODON_03414657)

