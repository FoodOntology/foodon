AnnotationAssertion(go:hasSynonym obo:FOODON_03414346 "astrocaryum vulgare"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414346 "awarra palm"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414346 "tucuma"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414346 "tucum plant"@en)
SubClassOf(obo:FOODON_03414346 obo:FOODON_03411017)

