AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4112 langual:B3409)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4112 "CCPR:")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4112 "PLANTS:SONI")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4112 "Solanum nigrum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4112 "solanum nigrum"@en)
SubClassOf(obo:NCBITaxon_4112 obo:FOODON_03411566)
SubClassOf(obo:NCBITaxon_4112 obo:FOODON_03415104)

