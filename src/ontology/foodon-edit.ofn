AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3645 "PLANTS:BEEX2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3645 "Bertholletia excelsa Bonpl.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3645 "Bertholletia excelsa Humb. & Bonpl.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3645 "bertholletia excelsa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3645 "brazilnut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3645 "cream nut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3645 "para nut"@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_3645 "LanguaL curation note: When indexing the fruit of the brazil nut (seed) index both *BRAZIL NUT [B1463]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
