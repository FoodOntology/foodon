AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411707 "PLANTS:ORBA5")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411707 "babassu")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411707 "babassu palm")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411707 "motacu")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411707 "motacuchi")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411707 "babacu"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411707 "orbignya barbosiana"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411707 "orbignya speciosa"@en)
