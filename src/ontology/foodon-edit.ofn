# Class: obo:FOODON_03414677 (syzygium plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414677 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414677 "Syzygium is a genus of flowering plants that belongs to the myrtle family, *Myrtaceae*. The genus comprises about 1200-1800 species, and has a native range that extends from Africa and Madagascar through southern Asia east through the Pacific. Several species of *Syzygium* bear fruit that are edible for humans, many of which are named \"roseapple\". Fifty-two species are found in Australia and are generally known as lillipillies, brush cherries or satinash. [https://en.wikipedia.org/wiki/Syzygium]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414677 <http://eol.org/pages/2508658>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414677 langual:B4677)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414677 "brush cherry"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414677 "lillipilli"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414677 "satinash"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414677 "syzygium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414677 "syzygium plant"@en)
SubClassOf(obo:FOODON_03414677 obo:FOODON_03413387)

# Class: obo:FOODON_03414678 (scrub cherry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414678 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414678 "Syzygium australe, with many common names that include brush cherry, scrub cherry, creek lilly-pilly, creek satinash, and watergum, is a rainforest tree native to eastern Australia. The pleasantly sour fruit are also eaten fresh or cooked. [https://en.wikipedia.org/wiki/Syzygium_australe]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414678 <http://eol.org/pages/8095>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414678 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402471>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414678 langual:B4678)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414678 "Syzygium australe (J. C. Wendl. ex Link) B. Hyland")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414678 "creek lilli-pilli"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414678 "creek satinash"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414678 "syzygium australe"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414678 "watergum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414678 "scrub cherry plant"@en)
SubClassOf(obo:FOODON_03414678 obo:FOODON_03414677)

# Class: obo:FOODON_03414681 (australian millet plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414681 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414681 "Panicum decompositum, known by the common names native millet, Australian millet, papa grass, and umbrella grass, is a species of grass native to the inland of Australia. Native millet is a staple food of outback Aborigines, who hand-harvest the seed to make damper, a traditional soda bread. Farmers also highly prize the grass as pasture for stock. [https://en.wikipedia.org/wiki/Panicum_decompositum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414681 <http://eol.org/pages/8223>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414681 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?26481>)
