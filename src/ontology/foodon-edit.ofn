AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510215 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510215 langual:P0215)
AnnotationAssertion(rdfs:comment obo:FOODON_03510215 "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510215 "food allergen labelling about crustaceans and products thereof"@en)
SubClassOf(obo:FOODON_03510215 obo:FOODON_03510213)

