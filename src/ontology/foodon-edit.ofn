AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3908 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300667>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3908 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=26355>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3908 langual:B4373)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3908 "PLANTS:VISA")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3908 "Vicia sativa L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3908 "garden vetch"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3908 "narrowleaf vetch"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3908 "sweetpea (garden vetch)"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3908 "vicia sativa"@en)
SubClassOf(obo:NCBITaxon_3908 obo:FOODON_03411156)
