# Class: obo:FOODON_03414971 (oroblanco plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414971 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414971 "An oroblanco, oro blanco (white gold) or sweetie (*Citrus grandis* Osbeck × *C. paradisi* Macf.) is a sweet seedless citrus hybrid fruit similar to grapefruit. It is often referred to as oroblanco grapefruit. [https://en.wikipedia.org/wiki/Oroblanco]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414971 langual:B4971)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414971 "sweetie"@en)
