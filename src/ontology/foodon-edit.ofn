AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414957 "wiry ground-berry"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414957 "native currant plant"@en)
SubClassOf(obo:FOODON_03414957 obo:FOODON_03411231)

# Class: obo:FOODON_03414958 (salal plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414958 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414958 "Gaultheria shallon is a leathery-leaved shrub in the heather family (*Ericaceae*), native to western North America. In English, it is known as salal, shallon, or simply gaultheria in Britain. Its dark blue berries and young leaves are both edible and are efficient appetite suppressants, both with a unique flavor. [https://en.wikipedia.org/wiki/Gaultheria_shallon]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414958 <http://eol.org/pages/582116>)
