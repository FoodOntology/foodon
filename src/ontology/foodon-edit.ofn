AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33114 langual:B2562)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33114 "PLANTS:CABA29")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_33114 "Capsicum baccatum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33114 "bishop's crown"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33114 "capsicum baccatum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33114 "pepper, rocotillo"@en)
SubClassOf(obo:NCBITaxon_33114 obo:FOODON_03411643)

