AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414682 "Sterculia quadrifida R. Br.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414682 "red-fruit kurrajong"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414682 "sterculia quadrifida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414682 "peanut tree"@en)
SubClassOf(obo:FOODON_03414682 obo:FOODON_03411174)
SubClassOf(obo:FOODON_03414682 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_225040))

# Class: obo:FOODON_03414683 (brown pine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414683 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414683 "Podocarpus is a genus of conifers, the most numerous and widely distributed of the podocarp family, *Podocarpaceae*. The genus occurs from southern Chile north to Mexico in the Americas and from New Zealand north to Japan in the Asia-Pacific region. [https://en.wikipedia.org/wiki/Podocarpus]"@en)
