# Class: obo:FOODON_03414691 (mistletoe plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414691 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414691 "Mistletoe is the most common name for most obligate hemiparasitic plants in the order *Santalales*. Mistletoes attach to and penetrate the branches of a tree or shrub by a structure called the haustorium, through which they absorb water and nutrients from the host plant.[https://en.wikipedia.org/wiki/Mistletoe]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414691 <http://eol.org/pages/4401>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414691 langual:B4691)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414691 "santalales"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414691 "mistletoe plant"@en)
SubClassOf(obo:FOODON_03414691 obo:FOODON_03411179)

# Class: obo:FOODON_03414692 (amyema plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414692 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414692 "Amyema is a genus of semi-parasitic shrubs (mistletoes) which occur in Malesia and Australia. [https://en.wikipedia.org/wiki/Amyema]"@en)
