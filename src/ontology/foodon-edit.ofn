AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414856 "Mylopharyngodon piceus"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414856 "black Chinese roach"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414856 "black carp"@en)
