# Class: obo:NCBITaxon_37052 (Ardenna grisea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_37052 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_37052 "The Sooty Shearwater (*Puffinus griseus*) is a medium-large shearwater in the seabird family *Procellariidae*. In New Zealand it is also known by its Maori name titi and as \"muttonbird\", like its relatives the Wedge-tailed Shearwater *(P. pacificus*) and the Australian Short-tailed Shearwater (*P. tenuirostris*)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_37052 "sooty shearwater"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_37052 "WIKIPEDIA:Sooty_Shearwater")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37052 <http://eol.org/pages/1047364>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37052 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=174553>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37052 langual:B4297)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37052 asfis:pfg)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_37052 "Puffinus griseus")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37052 "muttonbird"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37052 "puffinus griseus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37052 "titi"@en)
SubClassOf(obo:NCBITaxon_37052 obo:FOODON_03414296)

