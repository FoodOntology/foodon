AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411039 langual:B1039)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411039 "PLANTS:DIOD2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411039 "cumaru")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411039 "tonga-bean")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411039 "tonka bean")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411039 "cumaru"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411039 "dipteryx odorata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411039 "kumaru"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411039 "tonka bean plant"@en)
SubClassOf(obo:FOODON_03411039 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03411039 obo:FOODON_03413391)
