# Class: obo:NCBITaxon_3859 (Lathyrus odoratus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3859 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3859 "Sweet pea (*Lathyrus odoratus*) is a flowering plant in the genus *Lathyrus* in the family *Fabaceae* (legumes), native to the eastern Mediterranean. Unlike the edible pea, there is evidence that seeds of members of the genus *Lathyrus* are toxic if ingested in quantity. A related species, *Lathyrus sativus*, is grown for human consumption but when it forms a major part of the diet it causes symptoms of toxicity called lathyrism."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3859 "sweet pea plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3859 "WIKIPEDIA:Lathyrus_odoratus")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3859 <http://eol.org/pages/4277>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3859 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21596>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3859 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25864>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3859 langual:B1487)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3859 "PLANTS:LAOD")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3859 "Lathyrus odoratus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3859 "lathyrus odoratus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3859 "pea, sweet"@en)
SubClassOf(obo:NCBITaxon_3859 obo:FOODON_03413483)

# Class: obo:NCBITaxon_3860 (Lathyrus sativus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3860 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3860 "*Lathyrus sativus*, is a legume (family *Fabaceae*) commonly grown for human consumption and livestock feed in Asia and East Africa. It is a particularly important crop in areas that are prone to drought and famine, and is thought of as an 'insurance crop' as it produces reliable yields when all other crops fail. Like other grain legumes, *Lathyrus sativus* produces a high-protein seed. The seeds also contain variable amounts of a neurotoxic amino acid ß-N-Oxalyl-L-a,ß-diaminopropionic acid or ODAP or BOAA."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3860 "chickling vetch plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3860 "WIKIPEDIA:Lathyrus_sativus")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3860 <http://eol.org/pages/4277>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3860 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21613>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3860 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25877>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3860 langual:B3356)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3860 "PLANTS:LASA2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3860 "Lathyrus sativus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3860 "cicerchia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3860 "grass pea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3860 "white pea"@en)
SubClassOf(obo:NCBITaxon_3860 obo:FOODON_03411001)
SubClassOf(obo:NCBITaxon_3860 obo:FOODON_03413377)

