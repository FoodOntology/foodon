AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170989 "PLANTS:CIHY2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_170989 "Citrus hystrix DC.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_170989 "citrus hystrix"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_170989 "mauritius papeda"@en)
