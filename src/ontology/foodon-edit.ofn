# Class: obo:NCBITaxon_28503 (Sambucus ebulus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_28503 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_28503 "*Sambucus ebulus*, also known as danewort, dane weed, danesblood, dwarf elder or European dwarf elder, walewort, dwarf elderberry, elderwort and blood hilder is a herbaceous species of elder, native to southern and central Europe and southwest Asia. [https://en.wikipedia.org/wiki/Sambucus_ebulus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_28503 "dwarf elder plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28503 <http://eol.org/pages/488732>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28503 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32986>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28503 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=35321>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28503 langual:B4975)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28503 "PLANTS:SAEB")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_28503 "Sambucus ebulus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28503 "danewort"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28503 "dwarf elderberry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28503 "sambucus ebulus"@en)
SubClassOf(obo:NCBITaxon_28503 obo:FOODON_03414211)

# Class: obo:NCBITaxon_28509 (Glechoma hederacea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_28509 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_28509 "*Glechoma hederacea* (syn. *Nepeta glechoma* Benth., *Nepeta hederacea* (L.) Trevir.) is an aromatic, perennial, evergreen creeper of the mint family *Lamiaceae*. It is commonly known as ground-ivy, gill-over-the-ground, creeping charlie, alehoof, tunhoof, catsfoot, field balm, and run-away-robin. *Glechoma* has culinary and medicinal uses which were the cause of its being imported to America by early European settlers. [https://en.wikipedia.org/wiki/Glechoma_hederacea]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_28509 "ground ivy plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28509 <http://eol.org/pages/483313>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28509 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?316891>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28509 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=502801>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28509 langual:B5133)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28509 "PLANTS:GLHE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_28509 "Glechoma hederacea L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28509 "glechoma hederacea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28509 "groundivy"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28509 "nepeta glechoma"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28509 "nepeta hederacea"@en)
SubClassOf(obo:NCBITaxon_28509 obo:FOODON_03413359)

# Class: obo:NCBITaxon_28528 (Pinus mugo)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_28528 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_28528 "*Pinus mugo*, known as creeping pine, dwarf mountainpine, mugo pine, mountain pine, scrub mountain pine or Swiss mountain pine, is a species of conifer, native to high elevation habitats from southwestern to Central Europe. [https://en.wikipedia.org/wiki/Pinus_mugo]"@en)
