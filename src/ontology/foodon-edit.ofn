AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414544 langual:B4544)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414544 "Dipteryx alata Vogel")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "barujo"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "coco-feijão"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "cumaru"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "cumarurana"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "cumbaru"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "dipteryx alata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "emburena-brava"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "feijão-coco"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414544 "pau-cumaru"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414544 "baru plant"@en)
SubClassOf(obo:FOODON_03414544 obo:FOODON_03411024)

# Class: obo:FOODON_03414545 (pequi plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414545 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414545 "Caryocar brasiliense, known as Pequi or \"souari nut\", like its congeners, is an edible fruit popular in some areas of Brazil, especially in Brazil's center-west region."@en)
