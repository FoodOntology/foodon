AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03430100 "grated coarsely"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03430100 "minced"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03430100 "shredded"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430100 "divided into piece(s), thickness <0.3 cm."@en)
