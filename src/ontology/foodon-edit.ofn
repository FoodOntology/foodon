AnnotationAssertion(Annotation(<http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/2.0>) Annotation(<http://purl.org/dc/terms/rightsHolder> "Daniel Jolivet") <http://schema.org/image> <http://purl.obolibrary.org/obo/FOODON_00002997> <https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Saint-Aignan_%28Loir-et-Cher%29._Okapi.jpg/640px-Saint-Aignan_%28Loir-et-Cher%29._Okapi.jpg>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002997> "okapi"@en)
