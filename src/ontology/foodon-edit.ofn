AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "plastic (state)"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "pseudoplastic (state)"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "quasi-solid"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "semiplastic (state)"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "slush"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430144 "thixotropic (state)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430144 "LanguaL curation note: Used for soft food products that are formable or spreadable but not pourable. The product may be smooth or contain discrete particles."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430144 "food (semisolid)"@en)
SubClassOf(obo:FOODON_03430144 obo:FOODON_00002454)

