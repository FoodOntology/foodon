AnnotationAssertion(go:hasSynonym obo:NCBITaxon_70193 "little cuttle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_70193 "sepiola atlantica"@en)
SubClassOf(obo:NCBITaxon_70193 obo:FOODON_03414532)

