AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411894> "lepisosteiformes"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411894> "semionotiformes"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411894> "semionotiformes fish"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411894> <http://purl.obolibrary.org/obo/FOODON_03411365>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411895> (zeiform fish)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411895> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411895> "The Zeiformes are a small order of marine ray-finned fishes most notable for the dories, a group of common food fish. The order consists of about 33 species in seven families, mostly deep-sea types. [https://en.wikipedia.org/wiki/Zeiformes]"@en)
