# Class: obo:FOODON_03430130 (food (liquid))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430130 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430130 "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of the container."@en)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_03430130 "fluid"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430130 langual:E0130)
AnnotationAssertion(rdfs:comment obo:FOODON_03430130 "Liquids range from water to honey, corresponding to a range in viscosity (or apparent viscosity) from 1 to 500 centipoise (viscosity is a measure of a liquid's resistance to flow). Products that are pourable but have a higher viscosity are *SEMILIQUID*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430130 "food (liquid)"@en)
EquivalentClasses(obo:FOODON_03430130 ObjectIntersectionOf(obo:FOODON_00002454 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001548)))
SubClassOf(obo:FOODON_03430130 obo:FOODON_00002454)

# Class: obo:FOODON_03430131 (whole)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430131 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430131 "Refers to natural or formed shape as appropriate, regardless of size, which may vary from very large (e.g., beef carcass) to very small (e.g., poppy seed, yeast cell)."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430131 langual:E0131)
AnnotationAssertion(rdfs:label obo:FOODON_03430131 "whole"@en)
SubClassOf(obo:FOODON_03430131 obo:FOODON_03430113)

# Class: obo:FOODON_03430133 (divided into halves, quarters or segments)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430133 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430133 "Divided into pieces whose shape is defined in relation to the shape of the whole, i.e., halves, quarters, or segments. It is used regardless of the size of the whole."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430133 langual:E0133)
AnnotationAssertion(rdfs:label obo:FOODON_03430133 "divided into halves, quarters or segments"@en)
SubClassOf(obo:FOODON_03430133 obo:FOODON_03430122)

# Class: obo:FOODON_03430134 (semisolid with solid pieces)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430134 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430134 langual:E0134)
AnnotationAssertion(rdfs:comment obo:FOODON_03430134 "LanguaL curation note: Used for semisolid products that contain medium or small particles. The particles may be natural or formed whole shapes or may have been produced by dividing or disintegrating solids. Also included are products consisting of medium or small particles that are joined into a semisolid mass by naturally present or added oil, water, or other binding agents. The same particles without the binding agents would be indexed by the appropriate narrower term under *SOLID*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430134 "semisolid with solid pieces"@en)
SubClassOf(obo:FOODON_03430134 obo:FOODON_03430144)

