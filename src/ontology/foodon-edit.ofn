AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414368 "barbary duck"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414368 "cairina moschata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414368 "muscovy duck"@en)
SubClassOf(obo:FOODON_03414368 obo:FOODON_03411316)
SubClassOf(obo:FOODON_03414368 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_8855))

