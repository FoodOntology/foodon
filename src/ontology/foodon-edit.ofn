AnnotationAssertion(go:hasDbXref obo:NCBITaxon_219879 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402474>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_219879 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=835154>)
