AnnotationAssertion(dcterms:date obo:FOODON_00003251 "2019-11-04T18:48:09Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment obo:FOODON_00003251 "Ox as a prefix may also be used to refer to some carcass products from any adult cattle, such as ox-hide, ox-blood, oxtail, or ox-liver. [https://en.wikipedia.org/wiki/Cattle#Terminology]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003251 "ox"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00003251 <https://www.ruralheritage.com/ox_paddock/ox_whatis.htm>)
