# Class: obo:FOODON_03412093 (mule)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412093 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412093 "A mule is the offspring of a male donkey and a female horse. Horses and donkeys are different species, with different numbers of chromosomes. Of the two F1 hybrids between these two species, a mule is easier to obtain than a hinny (the offspring of a male horse and a female donkey). All male mules and most female mules are infertile."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412093 "WIKIPEDIA:Mule")
AnnotationAssertion(go:hasDbXref obo:FOODON_03412093 langual:B2093)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412093 "equus asinus x equus caballus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412093 "mule"@en)
SubClassOf(obo:FOODON_03412093 obo:FOODON_02021535)
SubClassOf(obo:FOODON_03412093 obo:FOODON_02021548)

# Class: obo:FOODON_03412103 (camel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412103 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412103 "Camelids are members of the biological family Camelidae, the only currently living family in the suborder Tylopoda. The extant members of this group are: dromedary camels, Bactrian camels, wild Bactrian camels, llamas, alpacas, vicuñas, and guanacos."@en)
