# Class: obo:NCBITaxon_8839 (Anas platyrhynchos)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8839 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8839 "The Mallard or Wild Duck (*Anas platyrhynchos*) is a dabbling duck which breeds throughout the temperate and subtropical Americas, Europe, Asia, and North Africa, and has been introduced to New Zealand and Australia. This duck belongs to the subfamily *Anatinae* of the waterfowl family *Anatidae*."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8839 "mallard"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8839 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175063>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8839 langual:B4367)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8839 "Anas platyrhynchos Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8839 "anas platyrhynchos"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8839 "duck, wild"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8839 "wild duck"@en)
SubClassOf(obo:NCBITaxon_8839 obo:FOODON_03411316)

# Class: obo:NCBITaxon_8843 (Anser anser)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8843 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8843 "A large bird in the waterfowl family Anatidae. It has mottled and barred grey and white plumage and an orange beak and legs. It measures between 74 and 91 centimetres (29 and 36 in) in length, with an average weight of 3.3 kilograms (7.3 lb)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8843 "greylag goose"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8843 wikipedia:Greylag_goose)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8843 <http://eol.org/pages/1047334>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8843 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175028>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8843 langual:B4594)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8843 asfis:ghd)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_8843 "anser anser"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8843 "Anser anser (Linnaeus, 1758)")

# Class: obo:NCBITaxon_8851 (Anseranas semipalmata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8851 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8851 "The magpie goose (*Anseranas semipalmata*) is the sole living representative waterbird species of the *Anseranatidae* family. It is a resident breeder in northern Australia and a vagrant to southern New Guinea. [https://en.wikipedia.org/wiki/Magpie_goose]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8851 "magpie goose"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8851 <http://eol.org/pages/1048549>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8851 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175198>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8851 langual:B4618)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8851 "Anseranas semipalmata (Latham, 1798)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8851 "anseranas semipalmata"@en)
SubClassOf(obo:NCBITaxon_8851 obo:FOODON_00002616)

# Class: obo:NCBITaxon_8855 (Cairina moschata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8855 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8855 "The Muscovy Duck (*Cairina moschata*) is a large duck native to Mexico, Central, and South America. Small wild and feral breeding populations have established themselves in the United States, particularly in the lower Rio Grande Valley of Texas, as well as in many other parts of North America, including southern Canada. Feral Muscovy Ducks have also been reported in parts of Europe."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8855 "muscovy duck"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8855 "WIKIPEDIA:Muscovy_Duck")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8855 <http://eol.org/pages/1048537>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8855 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175246>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8855 langual:B4368)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8855 "Cairina moschata (Linnaeus, 1758)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8855 "barbary duck"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8855 "cairina moschata"@en)
SubClassOf(obo:NCBITaxon_8855 obo:FOODON_03411316)

# Class: obo:NCBITaxon_88663 (Beryx splendens)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_88663 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_88663 "The splendid alfonsino, *Beryx splendens*, is an alfonsino of the genus *Beryx*, found around the world at depths of between 25 and 1,300 m. Their length is between 30 and 70 cm. It is known as kinmedai in sushi and Japanese cuisine."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_88663 "splendid alfonsino"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_88663 "WIKIPEDIA:Splendid_alfonsino")
