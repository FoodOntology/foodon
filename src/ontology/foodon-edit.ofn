AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414324 "allium canadense"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414324 "canada onion"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414324 "wild garlic"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414324 "wild onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414324 "canadian onion plant"@en)
SubClassOf(obo:FOODON_03414324 obo:FOODON_03411300)
SubClassOf(obo:FOODON_03414324 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_472403))

# Class: obo:FOODON_03414326 (cornsalad plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414326 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414326 "Corn salad is several species in the *Valeriana* genus (*Valerianella locusta* (Linnaeus), *Valerianella olitoria* (Moench), *Valeriana eriocarpa*, etc Desv. - the synonym Valeriana is obsolete but appears frequently in older texts). It is small dicot annual plants of the family *Valerianaceae*. It is also called Lewiston cornsalad, lamb's lettuce, fetticus, field salad, mâche, feldsalat, nut lettuce and rapunzel."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414326 "WIKIPEDIA:Cornsalad")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414326 <http://eol.org/pages/4260>)
