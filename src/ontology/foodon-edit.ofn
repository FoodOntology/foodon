# Class: obo:FOODON_03414156 (african buffalo)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414156 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414156 "The African buffalo, affalo, nyati, mbogo or Cape buffalo (*Syncerus caffer*), is a large African bovine. It is not closely related to the slightly larger wild Asian water buffalo, but its ancestry remains unclear. Owing to its unpredictable nature, which makes it highly dangerous to humans, it has not been domesticated unlike its Asian counterpart the domestic Asian water buffalo."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414156 <http://eol.org/pages/328707>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414156 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=183847>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414156 langual:B4156)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414156 "MSW3:14200707")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414156 "cape buffalo"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414156 "syncerus caffer"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414156 "african buffalo"@en)
SubClassOf(obo:FOODON_03414156 obo:FOODON_03414374)
