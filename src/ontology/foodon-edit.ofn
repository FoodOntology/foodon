# Class: obo:NCBITaxon_376798 (Phalaris canariensis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_376798 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_376798 "Canary grass is a plant, *Phalaris canariensis*, belonging to the family *Poaceae*. Originally a native of the Mediterranean region, it is now grown commercially in several parts of the world for birdseed. In the Canary Islands, Italy and North Africa, P. canariensis is used as food. [https://en.wikipedia.org/wiki/Canary_grass]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_376798 "canary grass plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_376798 <http://eol.org/pages/1114733>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_376798 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?27517>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_376798 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=41336>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_376798 langual:B4907)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_376798 "PLANTS:PHCA5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_376798 "Phalaris canariensis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_376798 "phalaris canariensis"@en)
SubClassOf(obo:NCBITaxon_376798 obo:FOODON_03412505)

# Class: obo:NCBITaxon_37690 (Citrus trifoliata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_37690 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_37690 "The trifoliate orange, *Citrus trifoliata* or *Poncirus trifoliata*, is a member of the family *Rutaceae* in the *Citrus* genus. It is native to northern China and Korea, and is also known as the Japanese bitter-orange, hardy orange or Chinese bitter orange. [https://en.wikipedia.org/wiki/Trifoliate_orange]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_37690 "trifoliate orange plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37690 <http://eol.org/pages/581896>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37690 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?29344>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37690 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=28989>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37690 langual:B5044)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_37690 "PLANTS:POTR4")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_37690 "Poncirus trifoliata (L.) Raf.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37690 "citrus trifoliate"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37690 "hardy orange"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_37690 "poncirus trifoliata"@en)
SubClassOf(obo:NCBITaxon_37690 obo:FOODON_03411193)

