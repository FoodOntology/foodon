AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414643 "weaver ant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414643 "green tree ant"@en)
SubClassOf(obo:FOODON_03414643 obo:FOODON_03412495)
SubClassOf(obo:FOODON_03414643 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_84561))

# Class: obo:FOODON_03414644 (moth)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414644 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414644 "Moths comprise a group of insects related to butterflies, belonging to the order *Lepidoptera*. Most lepidopterans are moths; and there are thought to be approximately 160,000 species of moth, many of which are yet to be described. Most species of moth are nocturnal, but there are also crepuscular and diurnal species. [https://en.wikipedia.org/wiki/Moth]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414644 <http://eol.org/pages/747>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414644 langual:B4644)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414644 "agrotis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414644 "butterfly"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414644 "cossidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414644 "moth"@en)
SubClassOf(obo:FOODON_03414644 obo:FOODON_03411220)

# Class: obo:FOODON_03414645 (beetle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414645 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414645 "Beetles are a group of insects that form the order *Coleoptera*, in the superorder *Endopterygota*. Their front pair of wings is hardened into wing-cases, elytra, distinguishing them from most other insects. The *Coleoptera*, with about 400,000 species, is the largest of all orders, constituting almost 40% of described insects and 25% of all known animal life-forms; new species are discovered frequently. [https://en.wikipedia.org/wiki/Beetle]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414645 <http://eol.org/pages/345>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414645 langual:B4645)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414645 "coleoptera"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414645 "passilidae spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414645 "beetle"@en)
SubClassOf(obo:FOODON_03414645 obo:FOODON_03411220)
SubClassOf(obo:FOODON_03414645 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7041))

# Class: obo:FOODON_03414646 (plant louse)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414646 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414646 "The *Hemiptera* or true bugs are an order of insects comprising some 50,000 to 80,000 species of groups such as the cicadas, aphids, planthoppers, leafhoppers, and shield bugs. They range in size from 1 mm (0.04 in) to around 15 cm (6 in), and share a common arrangement of sucking mouthparts. [https://en.wikipedia.org/wiki/Hemiptera]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414646 <http://eol.org/pages/539>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414646 langual:B4646)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414646 "hemiptera"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414646 "true bug"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414646 "plant louse"@en)
SubClassOf(obo:FOODON_03414646 obo:FOODON_03411220)

# Class: obo:FOODON_03414647 (bloodwood apple)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414647 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414647 "The Bush coconut, or bloodwood apple, is an Australian bush tucker food, often eaten by Aborigines of Central Australia. The bush coconut is, in fact, a combination of plant and animal: an adultpores female scale insect, *Cystococcus pomiformis*, lives in a gall induced on a bloodwood eucalypt (*Corymbia terminalis*). The gall looks like a small, knobbly woody fruit, ranging in size from a golf ball to a tennis ball, with a milky white flesh inside upon which the insect and its male offspring feed. [https://en.wikipedia.org/wiki/Bush_coconut]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414647 langual:B4647)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414647 "bush coconut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414647 "cystococcus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414647 "bloodwood apple"@en)
SubClassOf(obo:FOODON_03414647 obo:FOODON_03411220)

# Class: obo:FOODON_03414648 (puffball)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414648 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414648 "A puffball is a member of any of several groups of fungi in the division *Basidiomycota*. Puffballs encompass several genera, including *Calvatia*, *Calbovista* and *Lycoperdon*. True puffballs do not have a visible stalk (stem). [https://en.wikipedia.org/wiki/Puffball]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414648 langual:B4648)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414648 "calbovista"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414648 "calvatia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414648 "lycoperson"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414648 "puffball"@en)
SubClassOf(obo:FOODON_03414648 obo:FOODON_03411261)

