AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411747> "Undaria pinnatifida (Harvey) Suringar 1873")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411747> "japanese kelp"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411747> "sea mustard"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411747> "undaria pinnatifida"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411747> "wakame kelp"@en)
