AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411717 "pigweed"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411717 "amaranth plant"@en)
SubClassOf(obo:FOODON_03411717 obo:FOODON_03411324)
SubClassOf(obo:FOODON_03411717 obo:FOODON_03411566)

# Class: obo:FOODON_03411719 (gourd plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411719 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411719 "A gourd is a plant of the family *Cucurbitaceae*. Gourd is occasionally used to describe crops like cucumbers, squash, luffas, and melons. The term gourd, however, can more specifically refer to the plants of the two *Cucurbitaceae* genera *Lagenaria* and *Cucurbita*, or also to their hollow, dried-out shell.[A gourd is a plant of the family Cucurbitaceae. Gourd is occasionally used to describe crops like cucumbers, squash, luffas, and melons.[1] The term gourd, however, can more specifically refer to the plants of the two Cucurbitaceae genera Lagenaria and Cucurbita[citation needed], or also to their hollow, dried-out shell.[]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411719 <http://eol.org/pages/4458>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411719 langual:B1719)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411719 "cucurbitaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411719 "gourd plant"@en)
SubClassOf(obo:FOODON_03411719 obo:FOODON_03412091)

