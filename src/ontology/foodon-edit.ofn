AnnotationAssertion(go:hasDbXref obo:NCBITaxon_489417 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36756>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_489417 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505532>)
