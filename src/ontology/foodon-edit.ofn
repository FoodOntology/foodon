AnnotationAssertion(go:hasSynonym obo:FOODON_03415017 "peruvian ground apple"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415017 "smallanthus sonchifolius"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415017 "yacón"@en)
