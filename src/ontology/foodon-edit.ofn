AnnotationAssertion(go:hasDbXref obo:NCBITaxon_109171 "PLANTS:PAER3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_109171 "Pachyrhizus erosus (L.) Urb.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_109171 "Pachyrhizus erosus (L.) Urban")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_109171 "mexican yam bean"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_109171 "pachyrhizus erosus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_109171 "yam bean"@en)
