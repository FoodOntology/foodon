AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411530> "Fortunella Swingle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411530> "fortunella spp."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411530> "kumquat plant"@en)
