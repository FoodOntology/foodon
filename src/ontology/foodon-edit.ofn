# Class: <http://purl.obolibrary.org/obo/NCBITaxon_51089> (Myristica fragrans)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "The nutmeg tree is any of several species of trees in genus *Myristica*. The most important commercial species is *Myristica fragrans*, an evergreen tree indigenous to the Banda Islands in the Moluccas (or Spice Islands) of Indonesia. The nutmeg tree is important for two spices derived from the fruit: nutmeg and mace. Nutmeg is the actual seed of the tree, while mace is the dried \"lacy\" reddish covering or aril of the seed."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "nutmeg plant"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "WIKIPEDIA:Nutmeg")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://eol.org/pages/596922>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24855>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=18125>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://www.langual.org/langual_thesaurus.asp?termid=B1214>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "MANSFELD:12036")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "PLANTS:MYFR3")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "Myristica fragrans Houtt.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51089> "myristica fragrans"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/NCBITaxon_51089> "LanguaL curation note: When indexing the spice mace made from nutmeg, use *NUTMEG [B1214]* and *ARIL [C0287]*."@en)
SubClassOf(<http://purl.obolibrary.org/obo/NCBITaxon_51089> <http://purl.obolibrary.org/obo/FOODON_03411179>)

