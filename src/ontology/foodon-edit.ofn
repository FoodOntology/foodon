AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_133204 "Prunus virginiana L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_133204 "bitter-berry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_133204 "chokeberry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_133204 "prunus virginiana"@en)
