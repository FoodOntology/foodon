AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415045 "vanilla fragrans"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415045 "vanilla planifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415045 "bourbon vanilla plant"@en)
