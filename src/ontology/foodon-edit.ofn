# Class: obo:NCBITaxon_59496 (Rubus parviflorus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_59496 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_59496 "*Rubus parviflorus*, commonly called thimbleberry or salmonberry, is a species of *Rubus*, native to western and northern North America.  Thimbleberry fruits are larger, flatter, and softer than raspberries, and have many small seeds. Because the fruit is so soft, it does not pack or ship well, so thimbleberries are rarely cultivated commercially. However, wild thimbleberries make an excellent jam which is sold as a local delicacy. The fruits can be eaten raw or dried."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_59496 "thimbleberry plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_59496 "WIKIPEDIA:Rubus_parviflorus")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 <http://eol.org/pages/237187>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32408>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25007>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 langual:B4260)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 "PLANTS:RUPA")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 "PLANTS:RUPAP2")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59496 "PLANTS:RUPAV")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_59496 "Rubus parviflorus Nutt.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59496 "rubus parviflorus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59496 "salmonberry"@en)
SubClassOf(obo:NCBITaxon_59496 obo:FOODON_03411121)

# Class: obo:NCBITaxon_59499 (Rubus spectabilis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_59499 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_59499 "*Rubus spectabilis* (Salmonberry) is a species of *Rubus* native to the west coast of North America from west central Alaska to California. Salmonberries are edible and share the fruit structure of the raspberry, with the fruit pulling away from its receptacle. Books often call the fruit \"insipid\", but depending on ripeness and site, they are good eaten raw and when processed into jam, candy, jelly and wine. They were an important food for indigenous peoples. Traditionally, the berries were eaten with salmon or mixed with oolichan grease or salmon roe. They were not dried because of their high moisture content."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_59499 "salmonberry plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_59499 "WIKIPEDIA:Salmonberry")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59499 <http://eol.org/pages/244454>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59499 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32449>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59499 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25051>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59499 langual:B4259)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59499 "PLANTS:RUSP")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_59499 "Rubus spectabilis Pursh")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59499 "rubus spectabilis"@en)
SubClassOf(obo:NCBITaxon_59499 obo:FOODON_03411121)

