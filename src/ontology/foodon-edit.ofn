AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_489417 "Tordylium maximum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_489417 "tordylium apulum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_489417 "tordylium maximum"@en)
