# Class: obo:FOODON_03414771 (grevillea plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414771 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414771 "Grevillea is a diverse genus of about 360 species of evergreen flowering plants in the family *Proteaceae*, native to rainforest and more open habitats in Australia, New Guinea, New Caledonia, Sulawesi and other Indonesian islands east of the Wallace Line. Grevillea flowers were a traditional favourite among Aborigines for their sweet nectar. [https://en.wikipedia.org/wiki/Grevillea]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414771 <http://eol.org/pages/60829>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414771 langual:B4771)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414771 "grevillea spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414771 "grevillea plant"@en)
SubClassOf(obo:FOODON_03414771 obo:FOODON_03413359)

# Class: obo:FOODON_03414772 (heliotrope plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414772 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414772 "Heliotropium is a genus of flowering plants in the borage family, *Boraginaceae*. There are 250 to 300 species in this genus, which are commonly known as heliotropes. [https://en.wikipedia.org/wiki/Heliotropium]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414772 <http://eol.org/pages/38426>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414772 langual:B4772)
