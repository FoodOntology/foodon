# Class: obo:NCBITaxon_43311 (Fratercula cirrhata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_43311 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_43311 "The Tufted Puffin (*Fratercula cirrhata*) also known as Crested Puffin, is a relatively abundant medium-sized pelagic seabird in the auk (*Alcidae*) family found throughout the North Pacific Ocean. It is one of three species of puffin that make up the *Fratercula* genus and is easily recognizable by its thick red bill and yellow tufts."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_43311 "tufted puffin"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_43311 "WIKIPEDIA:Tufted_Puffin")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43311 <http://eol.org/pages/1049982>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43311 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=177032>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43311 langual:B4293)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_43311 "Fratercula cirrhata (Pallas, 1769)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43311 "crested puffin"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43311 "fratercula cirrhata"@en)
SubClassOf(obo:NCBITaxon_43311 obo:FOODON_03414292)

# Class: obo:NCBITaxon_43364 (Aesculus hippocastanum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_43364 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_43364 "*Aesculus hippocastanum* is a species of flowering plant in the soapberry and lychee family *Sapindaceae*. It is a large deciduous, synoecious (hermaphroditic-flowered) tree, commonly known as horse-chestnut or conker tree. [https://en.wikipedia.org/wiki/Aesculus_hippocastanum]"@en)
