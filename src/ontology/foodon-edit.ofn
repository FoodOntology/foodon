AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50207 "PLANTS:SOOL")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_50207 "Sonchus oleraceus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50207 "annual sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50207 "common sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50207 "common sowthistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50207 "hare's lettuce"@en)
