# Class: obo:FOODON_03414654 (small-leaved tamarind plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414654 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414654 "The Small-leaved Tamarind is a medium-sized, rainforest tree growing 18 to 30 m in height. The fruits are hairless, yellow-brown capsules, 3-5 cm in diameter, usually with two lobes. Each lobe contains a single, round seed surrounded by thick bright orange/red or yellow flesh. [http://www.environment.gov.au/cgi-bin/sprat/public/publicspecies.pl?taxon_id=21484]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414654 <http://eol.org/pages/4415>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414654 langual:B4654)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414654 "SPRAT:21484")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414654 "Diploglottis campbellii Cheel.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414654 "diploglottis campbellii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414654 "small-leaved tamarind plant"@en)
SubClassOf(obo:FOODON_03414654 obo:FOODON_03411024)

# Class: obo:FOODON_03414655 (midgen berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414655 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414655 "Midgen Berry, Midyim, or *Austromyrtus dulcis* is a spreading heathland shrub native to eastern Australia. The berries are a popular traditional bushfood, eaten by indigenous Australians and non-indigenous people. [https://en.wikipedia.org/wiki/Austromyrtus_dulcis]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414655 <http://eol.org/pages/8095>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414655 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312570>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414655 langual:B4655)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414655 "Austromyrtus dulcis (C. T. White) L. S. Sm.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414655 "austromyrtus dulcis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414655 "midgen-berry"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414655 "midyim"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414655 "midgen berry plant"@en)
SubClassOf(obo:FOODON_03414655 obo:FOODON_03411024)

# Class: obo:FOODON_03414656 (apple berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414656 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414656 "Billardiera scandens, commonly known as Apple Berry or Apple Dumpling, is a small shrub or twining plant of the *Pittosporaceae* family which occurs in forests in the coastal and tableland areas of all states and territories in Australia, apart from the Northern Territory and Western Australia. The fruits, which only ripen after dropping to the ground, are valued as an Australian bush food and are variously described as tasting like stewed apples or kiwifruit. [https://en.wikipedia.org/wiki/Billardiera_scandens]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414656 <http://eol.org/pages/4394>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414656 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7228>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414656 langual:B4656)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414656 "Billardiera scandens Sm.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414656 "apple dumpling"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414656 "apple-berry"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414656 "billardiera scandens"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414656 "apple berry plant"@en)
SubClassOf(obo:FOODON_03414656 obo:FOODON_03411024)

