AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412511 "Cucurbita maxima Duchesne")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412511 "Cucurbitaceae")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412511 "cucurbita maxima"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412511 "cucurbita maxima var. hubbard"@en)
