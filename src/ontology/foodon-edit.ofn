AnnotationAssertion(rdfs:label obo:FOODON_00002996 "mrigal carp"@en)
SubClassOf(obo:FOODON_00002996 obo:FOODON_03412617)

# Class: obo:FOODON_00002997 (okapi)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002997 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002997 "The okapi (Okapia johnstoni), also known as the forest giraffe, Congolese giraffe, or zebra giraffe, is an artiodactyl mammal native to the northeast of the Democratic Republic of the Congo in Central Africa. Although the okapi has striped markings reminiscent of zebras, it is most closely related to the giraffe."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002997 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002997 wikipedia:Okapi)
