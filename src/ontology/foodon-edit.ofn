# Class: obo:FOODON_03413505 (emmer plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413505 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413505 "Emmer wheat (*Triticum dicoccum*), also known as farro especially in Italy, is a low yielding, awned wheat. It was one of the first crops domesticated in the Near East. It was widely cultivated in the ancient world, but is now a relict crop in mountainous regions of Europe and Asia."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413505 <http://eol.org/pages/1114086>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413505 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506639>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413505 langual:B3505)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413505 "Triticum dicoccon")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413505 "Triticum dicoccon subsp. abyssinicum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413505 "Triticum dicoccon subsp. asiaticum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413505 "Triticum dicoccon subsp. dicoccon")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413505 "cultivated emmer wheat")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413505 "farro"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413505 "triticum dicoccum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413505 "ttiticum turgidum subsp. dicoccon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413505 "emmer plant"@en)
SubClassOf(obo:FOODON_03413505 obo:FOODON_03411312)
SubClassOf(obo:FOODON_03413505 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_49225))

# Class: obo:FOODON_03413506 (einkorn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413506 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413506 "Einkorn wheat (from German Einkorn, literally \"single grain\") can refer either to the wild species of wheat, *Triticum boeoticum* (the spelling baeoticum is also common), or to the domesticated form, *Triticum monococcum*. The wild and domesticated forms are either considered separate species, as here, or as subspecies of *T. monococcum*. Einkorn is a diploid species of hulled wheat, with tough glumes ('husks') that tightly enclose the grains. The cultivated form is similar to the wild, except that the ear stays intact when ripe and the seeds are larger."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413506 <http://eol.org/pages/1115242>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413506 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?410367>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413506 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42241>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413506 langual:B3506)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413506 "PLANTS:TRMO22")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413506 "einkorn wheat")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413506 "one-grained wheat")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413506 "small spelt")
AnnotationAssertion(rdfs:label obo:FOODON_03413506 "einkorn plant"@en)
SubClassOf(obo:FOODON_03413506 obo:FOODON_03411312)
SubClassOf(obo:FOODON_03413506 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4568))

