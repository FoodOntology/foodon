AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411463 "brazilnut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411463 "cream nut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411463 "para nut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411463 "brazil nut plant"@en)
