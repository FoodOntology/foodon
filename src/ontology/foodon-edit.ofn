AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_112863 "Lycium barbarum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_112863 "chinese boxthorn"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_112863 "common matrimonyvine"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_112863 "gojiberry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_112863 "lycium barbarum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_112863 "lycium halimifolium"@en)
SubClassOf(obo:NCBITaxon_112863 obo:FOODON_03411566)
SubClassOf(obo:NCBITaxon_112863 obo:FOODON_03414168)
SubClassOf(obo:NCBITaxon_112863 obo:FOODON_03415103)

