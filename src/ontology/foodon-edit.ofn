AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57919 "wood avens"@en)
SubClassOf(obo:NCBITaxon_57919 obo:FOODON_03413359)

# Class: obo:NCBITaxon_57926 (Argentina anserina)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_57926 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_57926 "*Argentina anserina* is a synonym of *Potentilla anserina* L., the accepted name of a perennial flowering plant in the rose family, *Rosaceae*. It is known by the common names \"silverweed\", common silverweed or silver cinquefoil. It was formerly believed to be useful for epilepsy, and that it could ward off witches and evil spirits. The plant has been cultivated as a food crop for its edible roots. [https://en.wikipedia.org/wiki/Argentina_anserina]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_57926 "silverweed plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57926 <http://eol.org/pages/301011>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57926 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?29465>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57926 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24687>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57926 langual:B5148)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57926 "PLANTS:ARAN7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_57926 "Argentina anserina (L.) Rydb.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_57926 "Potentilla anserina L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57926 "argentina anserine"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57926 "potentilla anserina"@en)
SubClassOf(obo:NCBITaxon_57926 obo:FOODON_03413359)

# Class: obo:NCBITaxon_57935 (Rosa majalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_57935 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_57935 "*Rosa majalis* (cinnamon rose, double cinnamon rose) is a species of deciduous shrubs in the genus *Rosa*, native to forests of Europe and Siberia. It grows to 2 m. and yields edible hip fruits rich in vitamin C, which are used in medicine and to produce rose hip syrup. [https://en.wikipedia.org/wiki/Rosa_majalis]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_57935 "cinnamon rose plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57935 <http://eol.org/pages/231454>)
