AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03414534> "A mycorrhizal fungus (Lyophyllum shimeji) which is difficult to cultivate."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414535> <http://purl.obolibrary.org/obo/IAO_0000122>)
