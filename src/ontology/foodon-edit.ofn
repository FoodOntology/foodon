AnnotationAssertion(go:hasSynonym obo:FOODON_03412091 "cucurbita spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412091 "pumpkin, squash or gourd"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412091 "squash, gourd or pumpkin plant"@en)
