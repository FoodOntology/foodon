AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415148 langual:B5148)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415148 "PLANTS:ARAN7")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415148 "silverweed cinquefoil")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415148 "argentina anserine"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415148 "potentilla anserina"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415148 "silverweed plant"@en)
SubClassOf(obo:FOODON_03415148 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415148 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_57926))

# Class: obo:FOODON_03415149 (tormentil plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415149 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415149 "Potentilla erecta (syn. *Tormentilla erecta*, *Potentilla laeta*, *Potentilla tormentilla*, known as the (common) tormentil, septfoil or erect cinquefoil) is a herbaceous perennial plant belonging to the rose family (*Rosaceae*). The plant is particularly used in herbal medicine as an astringent.[https://en.wikipedia.org/wiki/Potentilla_erecta]"@en)
