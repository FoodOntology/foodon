AnnotationAssertion(go:hasDbXref obo:NCBITaxon_32219 "PLANTS:AMAL2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_32219 "Amelanchier alnifolia (Nutt.) Nutt. ex M. Roem.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_32219 "amelanchier alnifolia"@en)
