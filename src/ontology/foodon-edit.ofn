AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415082 langual:B5082)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415082 "PLANTS:TRCA14")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415082 "sweet trefoil")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415082 "sweet trefoil"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415082 "trigonella caerulea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415082 "blue fenugreek plant"@en)
SubClassOf(obo:FOODON_03415082 obo:FOODON_03411696)
SubClassOf(obo:FOODON_03415082 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_200963))

# Class: obo:FOODON_03415083 (white deadnettle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415083 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415083 "Lamium album, commonly called white nettle or white dead-nettle, is a flowering plant in the family *Lamiaceae*. The young leaves are edible, and can be used in salads or cooked as a vegetable. Bees, especially bumble bees are attracted to the flowers which are a good source of early nectar and pollen, hence the plant is sometimes called the bee nettle. [https://en.wikipedia.org/wiki/Lamium_album]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415083 <http://eol.org/pages/579590>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415083 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314991>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415083 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32538>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415083 langual:B5083)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415083 "PLANTS:LAAL")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415083 "white dead-nettle")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415083 "lamium album"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415083 "white-nettle"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415083 "white deadnettle plant"@en)
SubClassOf(obo:FOODON_03415083 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03415083 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_53159))

# Class: obo:FOODON_03415084 (wild angelica plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415084 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415084 "Angelica sylvestris or wild angelica is a species of flowering plant, native to Europe and central Asia. It was used as a vegetable until the 20th century. *Angelica sylvestris* roots have been used in the traditional Austrian medicine internally as tea or tincture [https://en.wikipedia.org/wiki/Angelica_sylvestris]"@en)
