# Class: obo:FOODON_03411106 (sweet potato plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411106 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411106 "The sweet potato (*Ipomoea batatas*) is a dicotyledonous plant that belongs to the bindweed or morning glory family, *Convolvulaceae*. Its large, starchy, sweet-tasting, tuberous roots are a root vegetable. The young leaves and shoots are sometimes eaten as greens. The sweet potato is only distantly related to the potato (*Solanum tuberosum*) and does not belong to the nightshade family, *Solanaceae*, but both families belong to the same taxonomic order, the Solanales.[https://en.wikipedia.org/wiki/Sweet_potato]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 <http://eol.org/pages/580962>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20142>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=30764>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 langual:B1106)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 "MANSFELD:21565")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411106 "PLANTS:IPBA2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411106 "batate")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411106 "sweet potato")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411106 "ipomoea batatas"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411106 "sweet potato plant"@en)
SubClassOf(obo:FOODON_03411106 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03411106 obo:FOODON_03414741)
SubClassOf(obo:FOODON_03411106 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4120))

# Class: obo:FOODON_03411107 (pear tomato plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411107 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411107 "Pear tomato or teardrop tomato is the common name for any one in a group of indeterminate heirloom tomatoes. It originated in Europe in the 1700s. There are yellow, orange, and red varieties of this tomato; the yellow variety being most common. They are generally sweet, and are in the shape of a pear, but smaller.

Pear tomatoes are commonly eaten raw, but can also be used as a garnish, as an ingredient in many different dishes and sauces, or in drinks."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411107 "WIKIPEDIA:Pear_tomato")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411107 langual:B1107)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411107 "italian tomato"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411107 "lycopersicon lycopersicum var. pyriforme"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411107 "pear tomato plant"@en)
SubClassOf(obo:FOODON_03411107 obo:NCBITaxon_4081)

