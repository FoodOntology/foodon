AnnotationAssertion(go:hasSynonym obo:FOODON_03414687 "red nut"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414687 "rose nut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414687 "monkeynut plant"@en)
SubClassOf(obo:FOODON_03414687 obo:FOODON_03411022)

# Class: obo:FOODON_03414688 (johnstone river almond plant)

