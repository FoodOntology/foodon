AnnotationAssertion(go:hasDbXref obo:NCBITaxon_83375 "PLANTS:AETU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_83375 "Aesculus turbinata Blume")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_83375 "aesculus turbinata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_83375 "japanese horse chestnut"@en)
