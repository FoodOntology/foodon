# Class: obo:NCBITaxon_59011 (Typha angustifolia)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_59011 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_59011 "*Typha angustifolia* L., ( also Lesser Bulrush or Narrowleaf Cattail or Lesser Reedmace), is a perennial herbaceous plant of genus *Typha*. This cattail is an \"obligate wetland\" species that is commonly found in the northern hemisphere in brackish locations. Several parts of the plant are edible, including during various seasons the dormant sprouts on roots and bases of leaves, the inner core of the stalk, green bloom spikes, ripe pollen, and starchy roots. The edible stem is called bòn bòn in Vietnam."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_59011 "narrowleaf cattail plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_59011 "WIKIPEDIA:Typha_angustifolia")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59011 <http://eol.org/pages/526430>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59011 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?40799>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59011 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42325>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59011 langual:B4475)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_59011 "PLANTS:TYAN")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_59011 "Typha angustifolia L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59011 "lesser bulrush"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59011 "lesser reedmace"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59011 "narrow-leaf cat-tail"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59011 "narrowleaf cattail"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_59011 "typha angustifolia"@en)
SubClassOf(obo:NCBITaxon_59011 obo:FOODON_03411057)
SubClassOf(obo:NCBITaxon_59011 obo:FOODON_03414729)

