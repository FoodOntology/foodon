AnnotationAssertion(rdfs:label obo:FOODON_03415009 "lesser calamint plant"@en)
SubClassOf(obo:FOODON_03415009 obo:FOODON_03411179)

# Class: obo:FOODON_03415010 (chameleon-plant plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415010 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415010 "Houttuynia cordata, known as fish mint, fish leaf, lizard tail, chameleon plant, heartleaf, fishwort, and bishop's weed, is one of two species in the genus *Houttuynia* (the other being *H. emeiensis*), a flowering plant native to Japan, Korea, southern China, and Southeast Asia, where it grows in moist, shady places. [https://en.wikipedia.org/wiki/Houttuynia_cordata]"@en)
