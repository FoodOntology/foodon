SubClassOf(obo:FOODON_03415049 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_320146))

# Class: obo:FOODON_03415050 (japanese apricot plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415050 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415050 "Prunus mume is an Asian tree species classified in the *Armeniaca* section of the genus *Prunus* subgenus *Prunus*. Its common names include Chinese plum and Japanese apricot. Although generally referred to as a plum in English, it is more closely related to the apricot. In Chinese, Japanese and Korean cooking, the fruit of the tree is used in juices, as a flavouring for alcohol, as a pickle and in sauces. It is also used in traditional medicine. [https://en.wikipedia.org/wiki/Prunus_mume]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415050 <http://eol.org/pages/628584>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415050 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30048>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415050 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506231>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415050 langual:B5050)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415050 "PLANTS:PRMU5")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415050 "Japanese apricot")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415050 "ume")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415050 "chinese plum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415050 "prunus mume"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415050 "japanese apricot plant"@en)
SubClassOf(obo:FOODON_03415050 obo:FOODON_03411539)
SubClassOf(obo:FOODON_03415050 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_102107))

# Class: obo:FOODON_03415051 (nanking cherry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415051 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415051 "The Nanking cherry (*Prunus tomentosa*) is a species of *Prunus* native to northern and western China. Other common names for *P. tomentosa* include Korean cherry, Manchu cherry, downy cherry, Shanghai cherry, Ando cherry, mountain cherry, Chinese bush cherry, Chinese dwarf cherry. The fruit is edible, being an ingredient of juice, jam, and wine, and in pickled vegetables and mushrooms. [https://en.wikipedia.org/wiki/Prunus_tomentosa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415051 <http://eol.org/pages/632480>)
