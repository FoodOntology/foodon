# Class: obo:NCBITaxon_9970 (Syncerus caffer)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9970 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9970 "The African buffalo, affalo, nyati, mbogo or Cape buffalo (*Syncerus caffer*), is a large African bovine. It is not closely related to the slightly larger wild Asian water buffalo, but its ancestry remains unclear. Owing to its unpredictable nature, which makes it highly dangerous to humans, it has not been domesticated unlike its Asian counterpart the domestic Asian water buffalo."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9970 "african buffalo"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9970 "WIKIPEDIA:Syncerus_caffer")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9970 <http://eol.org/pages/328707>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9970 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=183847>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9970 langual:B4156)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9970 "MSW3:14200707")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9970 "Syncerus caffer (Sparrman, 1779)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9970 "cape buffalo"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9970 "syncerus caffer"@en)
SubClassOf(obo:NCBITaxon_9970 obo:FOODON_03414374)

