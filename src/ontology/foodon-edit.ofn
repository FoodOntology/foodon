AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414611 "itis:643890")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414611 "chelidonichthys lucerna"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414611 "chelidonichthys lucernus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414611 "smallscaled gurnard"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414611 "trigla corax"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414611 "trigla lucerna"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414611 "tub gurnard"@en)
SubClassOf(obo:FOODON_03414611 obo:FOODON_03412235)
SubClassOf(obo:FOODON_03414611 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_2576622))

# Class: obo:FOODON_03414612 (possum)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414612 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414612 "Phalangeriformes, or possums, any of a number of arboreal marsupial species native to Australia, New Guinea, and Sulawesi:
 
- Phalangeridae (possums and cuscuses), a family of mammals native to Australia and New Guinea containing most of the species referred to as \"possums\" in Australia

- Common brushtail possum (Trichosurus vulpecula), a common possum in Australian urban areas, invasive in New Zealand

- Common ringtail possum (Pseudocheirus peregrinus), also common in Australian urban areas, absent from New Zealand
 [https://en.wikipedia.org/wiki/Possum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414612 langual:B4612)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414612 "brushtail possum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414612 "phalangeridae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414612 "phalangeriformes"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414612 "pseudocheirus spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414612 "trichosurus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414612 "possum"@en)
SubClassOf(obo:FOODON_03414612 obo:FOODON_03411134)

# Class: obo:FOODON_03414613 (sea cow)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414613 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414613 "Sirenia, commonly referred to as sea cows, is an order of fully aquatic, herbivorous mammals that inhabit swamps, rivers, estuaries, marine wetlands, and coastal marine waters. *irenia* comprises the families *Dugongidae* (the dugong) and *Trichechidae* (manatees) with a total of four species. [https://en.wikipedia.org/wiki/Sirenia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414613 <http://eol.org/pages/8708>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414613 langual:B4613)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414613 "sirenia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414613 "sea cow"@en)
SubClassOf(obo:FOODON_03414613 obo:FOODON_03411122)

# Class: obo:FOODON_03414614 (manatee)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414614 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414614 "Manatees (family *Trichechidae*, genus *Trichechus*) are large, fully aquatic, mostly herbivorous marine mammals sometimes known as sea cows. There are three accepted living species of *Trichechidae*, representing three of the four living species in the order Sirenia: the Amazonian manatee (*Trichechus inunguis*), the West Indian manatee (*Trichechus manatus*), and the West African manatee (*Trichechus senegalensis*). [https://en.wikipedia.org/wiki/Manatee]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414614 <http://eol.org/pages/34723>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414614 langual:B4614)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414614 "trichechidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414614 "trichechus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414614 "manatee"@en)
SubClassOf(obo:FOODON_03414614 obo:FOODON_03414613)

# Class: obo:FOODON_03414615 (dugong)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414615 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414615 "The dugong (*Dugong dugon*) is a medium-sized marine mammal. It is one of four living species of the order *Sirenia*, which also includes three species of manatees. [https://en.wikipedia.org/wiki/Dugong]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414615 <http://eol.org/pages/328641>)
