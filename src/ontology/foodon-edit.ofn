AnnotationAssertion(go:hasSynonym obo:FOODON_03414623 "chelodina"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414623 "snake-necked turtle"@en)
SubClassOf(obo:FOODON_03414623 obo:FOODON_03411242)

