# Class: obo:FOODON_03411451 (macadamia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411451 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411451 "Macadamia is a genus of nine species of flowering plants in the family *Proteaceae*, with a disjunct distribution native to eastern Australia (seven species), New Caledonia (one species *M. neurophylla*) and Sulawesi in Indonesia (one species, *M. hildebrandii*). The fruit is a very hard woody globose follicle with a pointed apex, containing one or two seeds."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411451 "WIKIPEDIA:Macadamia")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411451 <http://eol.org/pages/61654>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411451 langual:B1451)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411451 "macadamia nut"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411451 "macadamia spp."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411451 "LanguaL curation note: When indexing the macadamia fruit (seed) index both *COCONUT PALM [B1130]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411451 "macadamia plant"@en)
SubClassOf(obo:FOODON_03411451 obo:FOODON_03411022)

