# Class: obo:NCBITaxon_3915 (Vigna mungo)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3915 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3915 "*Vigna mungo*, black gram, urad bean, minapa pappu, mungo bean or black matpe bean is a bean grown in the Indian subcontinent. At one time it was considered to belong to the same species as the mung bean. The product sold as *black lentil* is usually the whole urad bean, whereas the split bean (the interior being white) is called *white lentil*. It should not to be confused with the much smaller true black lentil (*Lens culinaris*)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3915 "black gram bean plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3915 "https://en.wikipedia.org/wiki/Vigna_mungo"^^xsd:anyURI)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3915 <http://eol.org/pages/654940>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3915 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?41621>)
