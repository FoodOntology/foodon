AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414704 "solanum ellipticum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414704 "velvet potato-bush"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414704 "potato bush"@en)
