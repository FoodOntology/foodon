SubClassOf(obo:FOODON_03414564 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_39089))

# Class: obo:FOODON_03414565 (fulmar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414565 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414565 "The fulmars are tubenosed seabirds of the family *Procellariidae*. The family consists of two extant species and two extinct fossils from the Miocene.</br>The northern fulmar (*Fulmarus glacialis*) or just fulmar lives in the North Atlantic and North Pacific, whereas the southern fulmar, (*Fulmarus glacialoides*) is, as its name implies, a bird of the Southern Ocean. Fulmars superficially resemble gulls, but are readily distinguished by their flight on stiff wings, and their tube noses. They breed on cliffs, laying a single egg on a ledge of bare rock. Outside the breeding season, they are pelagic, feeding on fish, squid and shrimp in the open ocean."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414565 "WIKIPEDIA:Fulmar")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414565 <http://eol.org/pages/19855>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414565 langual:B4565)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414565 "fulmarus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414565 "fulmar"@en)
SubClassOf(obo:FOODON_03414565 obo:FOODON_00002616)

# Class: obo:FOODON_03414566 (northern fulmar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414566 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414566 "The northern fulmar (*Fulmarus glacialis*), fulmar, or Arctic fulmar is a highly abundant sea bird found primarily in subarctic regions of the North Atlantic and North Pacific oceans. Fulmars come in one of two color morphs: a light one which is almost entirely white, and a dark one which is uniformly gray. Though similar in appearance to gulls, fulmars are in fact members of the *Procellariidae* family, which include petrels and shearwaters. It and the southern fulmar (*Fulmarus glacialodes*) together comprise the only extant species in the genus Fulmarus."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414566 <http://eol.org/pages/1047350>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414566 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=174536>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414566 langual:B4566)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414566 asfis:fno)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414566 "arctic fulmar"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414566 "fulmarus glacialis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414566 "northern fulmar"@en)
SubClassOf(obo:FOODON_03414566 obo:FOODON_03414565)
SubClassOf(obo:FOODON_03414566 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_30455))

# Class: obo:FOODON_03414567 (southern fulmar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414567 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414567 "The southern fulmar (*Fulmarus glacialoides*) is a seabird of the Southern Hemisphere. Along with the northern fulmar, *Fulmarus glacialis*, it belongs to the fulmar genus *Fulmarus* in the family *Procellariidae*, the true petrels. It is also known as the Antarctic fulmar or silver-grey fulmar."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414567 <http://eol.org/pages/1049463>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414567 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=174540>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414567 langual:B4567)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414567 asfis:fug)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414567 "antarctic fulmar"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414567 "fulmarus glacialoides"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414567 "silver-grey fulmar"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414567 "southern fulmar"@en)
SubClassOf(obo:FOODON_03414567 obo:FOODON_03414565)
SubClassOf(obo:FOODON_03414567 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_79629))

# Class: obo:FOODON_03414568 (black-headed gull)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414568 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414568 "The black-headed gull (*Chroicocephalus ridibundus*) is a small gull which breeds in much of Europe and Asia, and also in coastal eastern Canada."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414568 <http://eol.org/pages/1049595>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414568 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=824041>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414568 langual:B4568)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414568 "Lachmoewe")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414568 "chroicocephalus ridibundus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414568 "common black-headed gull"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414568 "black-headed gull"@en)
SubClassOf(obo:FOODON_03414568 obo:FOODON_03413503)
SubClassOf(obo:FOODON_03414568 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_1192867))

# Class: obo:FOODON_03414569 (lesser black-backed gull)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414569 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414569 "The lesser black-backed gull (*Larus fuscus*) is a large gull that breeds on the Atlantic coasts of Europe. It is migratory, wintering from the British Isles south to West Africa. It is a regular winter visitor to the east coast of North America, probably from the breeding population in Iceland."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414569 <http://eol.org/pages/1049580>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414569 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=176821>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414569 langual:B4569)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414569 asfis:low)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414569 "larus fuscus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414569 "lesser black-backed gull"@en)
SubClassOf(obo:FOODON_03414569 obo:FOODON_03413503)
SubClassOf(obo:FOODON_03414569 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_8915))

# Class: obo:FOODON_03414570 (great black-backed gull)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414570 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414570 "The great black-backed gull (*Larus marinus*), also known as the greater black-backed gull or, informally, as the black-back, is the largest member of the gull family. It breeds on the European and North American coasts and islands of the North Atlantic and is fairly sedentary, though some black-backs move farther south or inland to large lakes or reservoirs."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414570 <http://eol.org/pages/1049577>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414570 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=176815>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414570 langual:B4570)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414570 asfis:lvu)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414570 "greater black-backed gull"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414570 "larus marinus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414570 "great black-backed gull"@en)
SubClassOf(obo:FOODON_03414570 obo:FOODON_03413503)
SubClassOf(obo:FOODON_03414570 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_8912))

# Class: obo:FOODON_03414571 (minke whale)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414571 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414571 "Balaenoptera, from the Latin *balaena* (whale) and *pteron* (fin), is a genus of *Balaenopteridae*, the rorquals, and contains eight extant species. The species *Balaenoptera omurai* was published in 2003. *Balaenoptera* is the most diverse genus of its family, the only other member being the Humpback Whale, *Megaptera novaeangliae*."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414571 "WIKIPEDIA:Balaenoptera")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414571 <http://eol.org/pages/7660>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414571 langual:B4571)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414571 "balaenoptera spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414571 "baleen whale"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414571 "finback whale"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414571 "rorquals"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414571 "minke whale"@en)
SubClassOf(obo:FOODON_03414571 obo:FOODON_03411343)

# Class: obo:FOODON_03414572 (northern minke whale)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414572 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414572 "The common minke whale or northern minke whale (*Balaenoptera acutorostrata*) is a species of minke whale within the suborder of baleen whales. It is the smallest member of the rorquals and the second smallest species of baleen whale. Although first ignored by whalers due to its small size and low oil yield, it began to be exploited by various countries beginning in the early 20th century. As other species declined larger numbers of common minke whales were caught, largely for their meat. It is now one of the primary targets of the whaling industry. There is a dwarf form in the Southern Hemisphere."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 <http://eol.org/pages/328570>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180524>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 langual:B4572)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 asfis:miw)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 "CEC1993:1462")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414572 "MSW3:14300012")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414572 "lesser rorqual")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414572 "minke whale")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414572 "balaenoptera acutorostrata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414572 "common minke whale"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414572 "minke whale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414572 "northern minke whale"@en)
SubClassOf(obo:FOODON_03414572 obo:FOODON_03414571)
SubClassOf(obo:FOODON_03414572 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9767))

# Class: obo:FOODON_03414573 (antarctic minke whale)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414573 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414573 "The Antarctic minke whale or southern minke whale (*Balaenoptera bonaerensis*) is a species of minke whale within the suborder of baleen whales. It is the second smallest rorqual after the common minke whale and the third smallest baleen whale. Although first scientifically described in the mid-19th century, it wasn't recognized as a distinct species until the 1990s. Once ignored by whalers due to its small size and low oil yield, it is now one of the mainstays of the whaling industry alongside its cosmopolitan counterpart the common minke. It is the most abundant baleen whale in the world, numbering in the hundreds of thousands. It is primarily restricted to the Southern Hemisphere (although vagrants have been reported in the North Atlantic) and feeds mainly on euphausiids."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414573 <http://eol.org/pages/1053500>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414573 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=612592>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414573 langual:B4573)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414573 asfis:bfw)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414573 "MSW3:14300013")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414573 "balaenoptera bonaerensis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414573 "southern minke whale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414573 "antarctic minke whale"@en)
SubClassOf(obo:FOODON_03414573 obo:FOODON_03414571)
SubClassOf(obo:FOODON_03414573 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33556))

