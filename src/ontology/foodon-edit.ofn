AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_200963 "Trigonella caerulea (L.) Ser.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_200963 "sweet trefoil"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_200963 "trigonella caerulea"@en)
SubClassOf(obo:NCBITaxon_200963 obo:FOODON_03411696)

