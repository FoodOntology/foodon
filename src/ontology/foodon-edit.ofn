AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415132 "PLANTS:RHRO3")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415132 "rose-root")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "aaron's rod"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "arctic root"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "golden root"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "king's crown"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "lignum rhodium"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "orpin rhodium"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "rhodiola rosea"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "rose root"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415132 "roseroot"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415132 "roseroot stonecrop plant"@en)
SubClassOf(obo:FOODON_03415132 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415132 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_203015))

# Class: obo:FOODON_03415133 (ground ivy plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415133 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415133 "Glechoma hederacea (syn. *Nepeta glechoma* Benth., *Nepeta hederacea* (L.) Trevir.) is an aromatic, perennial, evergreen creeper of the mint family *Lamiaceae*. It is commonly known as ground-ivy, gill-over-the-ground, creeping charlie, alehoof, tunhoof, catsfoot, field balm, and run-away-robin. *Glechoma* has culinary and medicinal uses which were the cause of its being imported to America by early European settlers. [https://en.wikipedia.org/wiki/Glechoma_hederacea]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415133 <http://eol.org/pages/483313>)
