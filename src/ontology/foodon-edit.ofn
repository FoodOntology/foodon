# Class: obo:FOODON_03414841 (desert caper plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414841 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414841 "The wild orange is an Australian native plant throughout Australia. Its scientific name is *Capparis mitchellii*. It was named by botanist John Lindley. It is also known as the native orange. Its name in the Arrernte language of Central Australia is merne atwakeye. It is not related to oranges and neither to the Osage-orange which is known as \"wild orange\" in North America, but to capers.[https://en.wikipedia.org/wiki/Capparis_mitchellii]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414841 <http://eol.org/pages/4220>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414841 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?414316>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414841 langual:B4841)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414841 "Capparis mitchellii Lindl.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414841 "capparis mitchellii"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414841 "merne atwakeye"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414841 "native orange"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414841 "wild orange"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414841 "desert caper plant"@en)
SubClassOf(obo:FOODON_03414841 obo:FOODON_03414695)

# Class: obo:FOODON_03414843 (nippon orangequat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414843 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414843 "The Nippon orangequat is a cross between a Satsuma mandarin and a Meiwa kumquat (*Fortunella crassifolia*), hybridized by Dr. Eugene May of the USDA and introduced in 1932, and is a member of the citrofortunella group. 'Nippon' is the only named cultivar in existence.[https://en.wikipedia.org/wiki/Orangequat]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414843 <http://eol.org/pages/4414>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414843 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314878>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414843 langual:B4843)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414843 "×Citrofortunella spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414843 "citrofortunella spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414843 "citrus sinensis x citrus japonica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414843 "nippon orangequat"@en)
SubClassOf(obo:FOODON_03414843 obo:FOODON_03414845)

# Class: obo:FOODON_03414844 (limequat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414844 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414844 "The limequat is a citrofortunella hybrid that is the result of a cross between the key lime (*Citrus aurantifolia*) and the kumquat (*Fortunella margarita*), hybridized by Walter Tennyson Swingle in 1909.[https://en.wikipedia.org/wiki/Limequat]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414844 <http://eol.org/pages/4414>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414844 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317809>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414844 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?317810>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414844 langual:B4844)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414844 "×Citrofortunella floridana J. W. Ingram & H. E. Moore")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414844 "×Citrofortunella swinglei J. W. Ingram & H. E. Moore")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414844 "×citrofortunella floridana"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414844 "×citrofortunella swinglei"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414844 "limequat"@en)
SubClassOf(obo:FOODON_03414844 obo:FOODON_03414845)

# Class: obo:FOODON_03414845 (citrofortunella hybrids plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414845 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414845 "Citrofortunella according to the Swingle system, is a hybrid genus, containing intergeneric hybrids between members of the genus Citrus and the closely related Fortunella. It is named after its two parent genera. Such hybrids often combine the cold hardiness of the Fortunella, such as the Kumquat, with some edibility properties of the citrus species. Citrofortunellas, which are all hybrids, are marked with the multiplication sign before the word \"Citrofortunella\", for example × *Citrofortunella microcarpa* or × *Citrofortunella mitis which refer to the same plant.[https://en.wikipedia.org/wiki/Citrus_taxonomy]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414845 langual:B4845)
AnnotationAssertion(rdfs:label obo:FOODON_03414845 "citrofortunella hybrids plant"@en)
SubClassOf(obo:FOODON_03414845 obo:FOODON_03411139)

