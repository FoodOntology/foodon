AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440003> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440003> <http://www.langual.org/langual_thesaurus.asp?termid=F0003>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440003> "not cooked or raw"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440003> "raw or uncooked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440003> "uncooked or raw"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03440003> "LanguaL curation note: Used when no heat treatment was applied or, if the extent of heat applied did not result in significant changes in the food."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440003> "not heat-treated"@en)
