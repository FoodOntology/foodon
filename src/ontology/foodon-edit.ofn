# Class: <http://purl.obolibrary.org/obo/NCBITaxon_51239> (Vanilla planifolia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_51239> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "*Vanilla planifolia* is a species of vanilla orchid. It is native to Mexico and Central America, and is one of the primary sources for vanilla flavouring, due to its high vanillin content. Common names are flat-leaved vanilla, Tahitian vanilla, and West Indian vanilla (also used for the Pompona vanilla, *V. pompona*). Often, it is simply referred to as \"the vanilla\". [https://en.wikipedia.org/wiki/Vanilla_planifolia]"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "bourbon vanilla plant"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51239> <http://eol.org/pages/1127948>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51239> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?41111>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51239> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=43719>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51239> <http://www.langual.org/langual_thesaurus.asp?termid=B5045>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "PLANTS:VAPL2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "Vanilla planifolia Andrews")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "Vanilla planifolia Jacks.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "flat-leaved vanilla"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "vanilla"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "vanilla fragrans"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_51239> "vanilla planifolia"@en)
