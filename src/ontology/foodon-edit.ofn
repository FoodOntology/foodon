AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411303 "Salvia")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411303 "Salvia L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411303 "Salvia officinalis L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411303 "Salvia spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411303 "salvia"@en)
