AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415061 langual:B5061)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415061 "PLANTS:UGMO")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415061 "strawberry myrtle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415061 "ugni molinae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415061 "ugniberry"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415061 "chilean guava plant"@en)
SubClassOf(obo:FOODON_03415061 obo:FOODON_03411231)
SubClassOf(obo:FOODON_03415061 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_260145))

