# Class: obo:FOODON_03415025 (siberian kale plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415025 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415025 "Brassica napus (*Pabularia* Group) is commonly called Siberian kale. It is native to northern Asia and northern Europe. It primarily differs from a second type of kale known as *Brassica oleracea* (*Acephala* Group) by having (a) milder flavor, (b) more tenderness, (c) better resistance to the diseases/insects common to Brassicas and (d) better winter hardiness. Flat blue green leaves with white veins and ruffled edges. Plants typically mature to 12-18\" tall and to 24\" wide. *Brassica napus* (*Oleifera* Group) is grown primarily for vegetable oils including canola. *Brassica napus* (*Napobrassica* Group) includes rutabagas. [http://www.missouribotanicalgarden.org/PlantFinder/PlantFinderDetails.aspx?taxonid=275021]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415025 <http://eol.org/pages/4219>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415025 langual:B5025)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415025 "PLANTS:BRNAP")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415025 "Brassica napus L. var. pabularia (DC.) Rchb.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415025 "brassica napus pabularia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415025 "rape kale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415025 "siberian kale plant"@en)
SubClassOf(obo:FOODON_03415025 obo:FOODON_03411281)

# Class: obo:FOODON_03415026 (canarium plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415026 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415026 "Canarium is a genus of about 100 species of tropical and subtropical trees, in the family *Burseraceae*. The trees and their edible nuts have a large number of common names in their range. These include Pacific almond, canarium nut, pili nut, Java almond, Kenari nut, galip nut, nangai, and ngali. [https://en.wikipedia.org/wiki/Canarium]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415026 <http://eol.org/pages/4411>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415026 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312271>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415026 langual:B5026)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415026 "PLANTS:CANAR2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415026 "Canarium L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415026 "Canarium spp.")
AnnotationAssertion(rdfs:label obo:FOODON_03415026 "canarium plant"@en)
SubClassOf(obo:FOODON_03415026 obo:FOODON_03411022)

# Class: obo:FOODON_03415034 (honesty plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415034 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415034 "Lunaria (common name honesty) is a genus of flowering plants in the family *Brassicaceae*, native to central and southern Europe. It includes 4 species, the annual or biennial *L. annua* (syn. *L. biennis*), *Lunaria elongata*, the perennial *L. rediviva* and the rare Balkan species *Lunaria telekiana*. [https://en.wikipedia.org/wiki/Lunaria]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415034 <http://eol.org/pages/4219>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415034 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?459743>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415034 langual:B5034)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415034 "PLANTS:LUNAR")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415034 "Lunaria")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415034 "Lunaria L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415034 "Lunaria spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415034 "lunaria"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415034 "honesty plant"@en)
SubClassOf(obo:FOODON_03415034 obo:FOODON_03413372)

# Class: obo:FOODON_03415037 (randhuni plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415037 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415037 "Trachyspermum roxburghianum (also known as *Carum roxburghianum*) is a flowering plant in the family *Apiaceae*. It is grown extensively in the South Asia, Southeast Asia, and Indonesia. Its aromatic dried fruits, like its close relative ajwain, are often used in Bengali cuisine but are rarely used in the rest of India. The fresh leaves are used as an herb in Thailand and it is used medicinally in Myanmar. [https://en.wikipedia.org/wiki/Trachyspermum_roxburghianum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415037 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?406695>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415037 langual:B5037)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415037 "Trachyspermum roxburghianum (DC.) Craib")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415037 "carum roxburghianum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415037 "trachyspermum roxburghianum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415037 "randhuni plant"@en)
SubClassOf(obo:FOODON_03415037 obo:FOODON_03411179)

# Class: obo:FOODON_03415041 (temulawak plant)

