AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412450 "pteridium aquilinum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412450 "pteridium esculentum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412450 "pteris aquilina"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412450 "bracken fern plant"@en)
SubClassOf(obo:FOODON_03412450 obo:FOODON_03412453)

# Class: obo:FOODON_03412451 (lily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412451 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412451 "Lilium bulbs are starchy and edible as root vegetables, although bulbs of some species may be very bitter. The non-bitter bulbs of *L. lancifolium, L. pumilum*, and especially *L. brownii* are grown at large scale in China as a luxury or health food, most often sold in dry form. They are eaten especially in the summer, for their ability to reduce internal heat. They may be reconstituted and stir-fried, grated and used to thicken soup, or processed to extract starch. Their texture and taste draw comparison with the potato, although the individual bulb scales are much smaller (Source:"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412451 "WIKIPEDIA:Lily).")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412451 langual:B2451)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412451 "lilium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412451 "lily plant"@en)
SubClassOf(obo:FOODON_03412451 obo:FOODON_03411018)

# Class: obo:FOODON_03412452 (radicchio plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412452 "Radicchio is a cultivated form of leaf chicory (*Cichorium intybus, Asteraceae*), sometimes known as Italian chicory, and is a perennial. It is grown as a leaf vegetable which usually has white-veined red leaves. It has a bitter and spicy taste, which mellows when it is grilled or roasted."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412452 wikipedia:Radicchio)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412452 langual:B2452)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412452 "radicchio"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412452 "radicchio plant"@en)
SubClassOf(obo:FOODON_03412452 obo:NCBITaxon_13427)

# Class: obo:FOODON_03412453 (fern plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412453 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412453 "A fern is a member of a group of vascular plants that reproduce via spores and have neither seeds nor flowers. They differ from mosses by being vascular, i.e., having certain tissue that conducts water and nutrients, and having branched stems. Ferns are defined here in the broad sense, being all of the Polypodiopsida, comprising both the leptosporangiate (*Polypodiidae*) and eusporangiate ferns, the latter itself comprising \"ferns\" other than those denominated \"true ferns\": horsetails (including scouring rushes), whisk ferns, marattioid ferns, and ophioglossoid ferns.
Ferns are not as important economically as seed plants but have considerable importance in some societies. Some ferns are used for food, including the fiddleheads of *Pteridium aquilinum* (bracken), *Matteuccia struthiopteris* (ostrich fern), and *Osmundastrum cinnamomeum* (cinnamon fern). [https://en.wikipedia.org/wiki/Fern]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412453 langual:B2453)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412453 "fiddlehead"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412453 "pteridophyta"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412453 "fern plant"@en)
SubClassOf(obo:FOODON_03412453 obo:FOODON_03411057)

# Class: obo:FOODON_03412455 (climbing wattle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412455 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412455 "Acacia pennata (English: Climbing wattle, Thai: Cha-om, Burmese Su pout ywet) is a species of acacia which is native to South and Southeast Asia. In Burma, Laos and Thailand, the feathery shoots of Acacia pennata are used in soups, curries, omelettes and stir-fries. The edible shoots are picked up before they become tough and thorny.[http://en.wikipedia.org/wiki/Cha_om]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412455 "WIKIPEDIA:Cha_om")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412455 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412455 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?954>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412455 langual:B2455)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412455 "Acacia pennata (L.) Willd.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412455 "acacia pennata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412455 "cha om"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412455 "climbing wattle plant"@en)
SubClassOf(obo:FOODON_03412455 obo:FOODON_03411566)

