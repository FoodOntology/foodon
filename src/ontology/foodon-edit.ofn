AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea L. var. botrytis L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea L. var. italica Plenck")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea var. botrytis L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411443 "brassica oleracea l. convar. botrytis var. italica"@en)
