AnnotationAssertion(go:hasDbXref obo:FOODON_03510133 langual:P0133)
AnnotationAssertion(go:hasSynonym obo:FOODON_03510133 "more, label claim"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03510133 "LanguaL curation note: Used in label comparison statement when a food contains at least 10% more of the daily nutritional value per amount customarily consumed."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510133 "\"more\" label claim"@en)
SubClassOf(obo:FOODON_03510133 obo:FOODON_03510059)

