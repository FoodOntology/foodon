# Class: obo:NCBITaxon_13894 (Cocos nucifera)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_13894 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_13894 "The coconut palm, *Cocos nucifera*, is a member of the family *Arecaceae* (palm family). It is the only accepted species in the genus *Cocos*. The term coconut can refer to the entire coconut palm, the seed, or the fruit, which is not a botanical nut, but a drupe. The spelling cocoanut is an old-fashioned form of the word."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_13894 "coconut palm plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_13894 "WIKIPEDIA:Cocos_nucifera")
