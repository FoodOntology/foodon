AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411555 langual:B1555)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411555 "MANSFELD:27559")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411555 "PLANTS:PHVU")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris L. ssp. vulgaris")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411555 "Phaseolus vulgaris var. vulgaris")
AnnotationAssertion(rdfs:label obo:FOODON_03411555 "phaseolus vulgaris plant"@en)
