# Class: obo:NCBITaxon_3258 (Equisetum arvense)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3258 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3258 "*Equisetum arvense*, the field horsetail or common horsetail, is an herbaceous perennial horsetail native throughout the arctic and temperate regions of the northern hemisphere. *Equisetum arvense* has been used in traditional Austrian herbal medicine internally as tea, or externally as baths or compresses, for treatment of disorders of the skin, locomotor system, kidneys and urinary tract, rheumatism and gout. [https://en.wikipedia.org/wiki/Equisetum_arvense]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3258 "filed horsetail plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3258 <http://eol.org/pages/597765>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3258 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?400386>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3258 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=17152>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3258 langual:B5129)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3258 "PLANTS:EQAR")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3258 "Equisetum arvense L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3258 "common horsetail"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3258 "equisetum arvense"@en)
SubClassOf(obo:NCBITaxon_3258 obo:FOODON_03413359)

