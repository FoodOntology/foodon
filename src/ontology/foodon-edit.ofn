AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510061 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510061 "All narrower term definitions extracted from 58 Federal Register 2302, January 6, 1993, part 101.60(c)."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510061 langual:P0061)
AnnotationAssertion(rdfs:label obo:FOODON_03510061 "sugars special claim"@en)
SubClassOf(obo:FOODON_03510061 obo:FOODON_03510065)
