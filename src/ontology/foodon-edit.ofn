AnnotationAssertion(go:hasDbXref obo:FOODON_03415055 "PLANTS:SCHIS2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415055 "Schisandra Michx.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415055 "Schisandra spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415055 "five-flavor-fruit"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415055 "magnolia-vine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415055 "schisandra plant"@en)
SubClassOf(obo:FOODON_03415055 obo:FOODON_03411179)

# Class: obo:FOODON_03415057 (arctic bramble plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415057 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415057 "Rubus arcticus, the Arctic bramble or Arctic raspberry, is a species of slow-growing bramble belonging to the rose family, found in arctic and alpine regions in the Northern Hemisphere. Its dark red fruit is considered a delicacy. [https://en.wikipedia.org/wiki/Rubus_arcticus]"@en)
