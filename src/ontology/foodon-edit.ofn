# Class: obo:FOODON_03412132 (filefish family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412132 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412132 "Filefish (also known as foolfish, leatherjackets or shingles) are tropical to subtropical tetraodontiform marine fish of the diverse family *Monacanthidae*. Found in the Atlantic, Pacific and Indian Oceans, the filefish family contains approximately 107 species in 26 genera. Filefish are closely related to the triggerfish, pufferfish and trunkfish."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412132 "WIKIPEDIA:Monacanthidae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412132 <http://eol.org/pages/5058>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412132 langual:B2132)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412132 "monacanthidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412132 "filefish family"@en)
SubClassOf(obo:FOODON_03412132 obo:FOODON_03411977)

# Class: obo:FOODON_03412133 (moreton bay chestnut plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412133 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412133 "Castanospermum australe (Moreton Bay Chestnut or Blackbean), the only species in the genus *Castanospermum*, is a flowering plant in the family *Fabaceae*, native to the east coast of Australia in Queensland and New South Wales, and to the Pacific islands of Vanuatu, New Caledonia, and the island of New Britain (Papua New Guinea). Members of this genus accumulate iminosugars in their leaves.[https://en.wikipedia.org/wiki/Castanospermum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412133 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412133 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?9525>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412133 langual:B2133)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412133 "Castanospermum australe A. Cunn. & C. Fraser ex Hook.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412133 "Castanospermum australe A.Cunn. & C.Fraser ex Hook.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412133 "black turtle bean"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412133 "castanospermum australe"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412133 "moreton bay chestnut plant"@en)
SubClassOf(obo:FOODON_03412133 obo:FOODON_03411567)

