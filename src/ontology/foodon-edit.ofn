# Class: obo:NCBITaxon_329779 (Solanum incanum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_329779 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_329779 "*Solanum incanum* is a species of nightshade that is native to Sub-Saharan Africa and the Middle East, eastwards to India. Common names include thorn apple, bitter apple, bitterball and bitter tomato. In ancient India, *Solanum incanum* was domesticated into the eggplant, *Solanum melongena* [https://en.wikipedia.org/wiki/Solanum_incanum]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_329779 "thorn-apple plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_329779 <http://eol.org/pages/484223>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_329779 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101488>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_329779 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505835>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_329779 langual:B4984)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_329779 "PLANTS:SOIN5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_329779 "Solanum incanum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_329779 "bitter-apple"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_329779 "solanum incanum"@en)
SubClassOf(obo:NCBITaxon_329779 obo:FOODON_03411458)

