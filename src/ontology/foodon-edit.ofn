AnnotationAssertion(go:hasSynonym obo:FOODON_03414758 "spiral ginger"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414758 "costus plant"@en)
SubClassOf(obo:FOODON_03414758 obo:FOODON_03413359)

