# Class: obo:FOODON_03414216 (italian tangerine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414216 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414216 "Citrus × deliciosa (thorny (Australia) amarillo, beladi, Willowleaf Mandarin, Mediterranean Mandarin) is a citrus hybrid (mandarin × pumelo), though it was once thought to be a pure mandarin. It is related to the ponkan. 
 Its sweet fruit is eaten, its rind oil is used to flavour food and drinks, and petitgrain oil is extracted from the pruned leaves. [https://en.wikipedia.org/wiki/Citrus_×_deliciosa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414216 <http://eol.org/pages/4414>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414216 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314340>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414216 langual:B4216)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414216 "Citrus deliciosa Ten.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414216 "citrus deliciosa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414216 "mediterranean mandarin"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414216 "willow-leaf mandarin"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414216 "italian tangerine plant"@en)
SubClassOf(obo:FOODON_03414216 obo:FOODON_03411429)

