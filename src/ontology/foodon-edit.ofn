# Class: obo:FOODON_03414511 (north european kelp)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414511 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414511 "Laminaria hyperborea is a species of large brown alga, a kelp in the family *Laminariaceae*, also known by the common names of tangle and cuvie. It is found in the sublittoral zone of the northern Atlantic Ocean. A variety, *Laminaria hyperborea* f. *cucullata* (P.Svensden & J.M.Kain, 1971) is known from more wave sheltered areas in Scandinavia."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414511 <http://eol.org/pages/921870>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414511 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11230>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414511 langual:B4511)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414511 asfis:lah)
AnnotationAssertion(rdfs:label obo:FOODON_03414511 "north european kelp"@en)
SubClassOf(obo:FOODON_03414511 obo:FOODON_03411744)
SubClassOf(obo:FOODON_03414511 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_90893))

# Class: obo:FOODON_03414512 (new zealand lemon sole)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414512 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414512 "The southern lemon sole, *Pelotretis flavilatus*, is a righteye flounder, the only species in the genus *Pelotretis*, found around New Zealand in enclosed waters such as estuaries, harbours, mudflats, and sandflats, in waters less than 385 m in depth. Their length is from 25 to 50 cm."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414512 <http://eol.org/pages/214951>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414512 langual:B4512)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414512 asfis:eol)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414512 <https://www.frdc.com.au/knowledge-hub/standards/37461796>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414512 "itis:172951")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414512 "southern lemon sole")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414512 "flounder"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414512 "pelotretis flavilatus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414512 "southern lemon sole"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414512 "new zealand lemon sole"@en)
