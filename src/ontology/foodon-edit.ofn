AnnotationAssertion(go:hasDbXref obo:FOODON_03510218 langual:P0218)
AnnotationAssertion(rdfs:comment obo:FOODON_03510218 "Regulated by Directive 2003/89/EC of the European Parliament and of the Council of 10 November 2003 amending Directive 2000/13/EC as regards indication of the ingredients present in foodstuffs."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510218 "food allergen labelling about peanuts and products thereof"@en)
SubClassOf(obo:FOODON_03510218 obo:FOODON_03510213)

