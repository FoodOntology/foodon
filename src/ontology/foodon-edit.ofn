AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8915 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=176821>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8915 langual:B4569)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8915 asfis:low)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8915 "Larus fuscus Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8915 "larus fuscus"@en)
