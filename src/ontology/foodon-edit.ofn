AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430108 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430108 "Food material as a collection of several food material parts and/or phases - liquid, semiliquid, semisolid, or solid."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430108 langual:E0108)
AnnotationAssertion(rdfs:label obo:FOODON_03430108 "heterogeneous form (sensu food)"@en)
SubClassOf(obo:FOODON_03430108 obo:FOODON_03430113)

# Class: obo:FOODON_03430109 (food (liquid, low viscosity))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430109 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430109 "A liquid that flows very easily at room temperature."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430109 langual:E0109)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430109 "thin liquid"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430109 "Examples are: water, apple juice, sherry, acidophilus milk, whipping cream and some heavy liqueurs. The range of low viscosity liquid spans sucrose solutions between 0 and 45% solids (viscosity range from 1 to 10 centipoise). Prefer 'solid pieces' factor term to 'small particles' if both appear in the food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430109 "food (liquid, low viscosity)"@en)
EquivalentClasses(obo:FOODON_03430109 ObjectIntersectionOf(obo:FOODON_03430130 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001694)))
SubClassOf(obo:FOODON_03430109 obo:FOODON_03430130)

