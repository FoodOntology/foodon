# Class: obo:NCBITaxon_203582 (Sisymbrium officinale)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_203582 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_203582 "Hedge mustard (*Sisymbrium officinale*) is a plant in the family *Brassicaceae*. It is found on roadsides and wasteland, and as a weed of arable land. A native of Europe and North Africa, it is now well-established throughout the world.

 It is distinct from the Mustard plants which belong to the genus Brassica."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_203582 "hedge mustard plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_203582 "WIKIPEDIA:Hedge_mustard")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203582 <http://eol.org/pages/583773>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203582 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?34458>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203582 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=23316>)
