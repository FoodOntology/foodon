AnnotationAssertion(go:hasSynonym obo:NCBITaxon_400996 "velvet potato-bush"@en)
SubClassOf(obo:NCBITaxon_400996 obo:FOODON_03414702)

# Class: obo:NCBITaxon_40151 (Monodon monoceros)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_40151 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_40151 "The narwhal, or narwhale (*Monodon monoceros*), is a medium-sized toothed whale and possesses a large \"tusk\" from a protruding canine tooth. It lives year-round in the Arctic waters around Greenland, Canada, and Russia. It is one of two living species of whale in the *Monodontidae* family, along with the beluga whale. The narwhal males are distinguished by a long, straight, helical tusk, which is an elongated upper left canine."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_40151 "narwhal"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_40151 "WIKIPEDIA:Narwhal")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 <http://eol.org/pages/328542>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180485>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 langual:B4563)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 asfis:nar)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 "CEC1993:1461")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_40151 "MSW3:14300107")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_40151 "Monodon monoceros Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_40151 "monodon monoceros"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_40151 "narwhale"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_40151 "unicorn whale"@en)
SubClassOf(obo:NCBITaxon_40151 obo:FOODON_03411343)

