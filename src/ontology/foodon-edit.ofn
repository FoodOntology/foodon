# Class: obo:FOODON_03414252 (jasmine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414252 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414252 "Jasminum officinale, known as the common jasmine or simply jasmine, is a species of flowering plant in the olive family *Oleaceae*. It is also known as summer jasmine, poet's jasmine, white jasmine, true jasmine or jessamine, and is particularly valued by gardeners throughout the temperate world for the intense fragrance of its flowers in summer. It is also the National flower of Pakistan. 
 The essential oil of *Jasminum officinale* is used in aromatherapy. [https://en.wikipedia.org/wiki/Jasminum_officinale]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414252 <http://eol.org/pages/4426>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414252 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20668>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414252 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503238>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414252 langual:B4252)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414252 "PLANTS:JAOF")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414252 "Jasminum officinale L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414252 "common jasmine"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414252 "jasminum officinale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414252 "jasmine plant"@en)
SubClassOf(obo:FOODON_03414252 obo:FOODON_03411179)

# Class: obo:FOODON_03414254 (yam bean plant)

