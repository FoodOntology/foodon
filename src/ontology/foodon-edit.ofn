AnnotationAssertion(go:hasSynonym obo:FOODON_03411543 "beech nut tree"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411543 "fagus spp."@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411543 "LanguaL curation note: When indexing beech nut index both *BEECH [B1543]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411543 "beech tree"@en)
SubClassOf(obo:FOODON_03411543 obo:FOODON_03411062)

