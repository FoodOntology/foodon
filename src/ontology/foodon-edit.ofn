# Class: obo:FOODON_03412505 (millet plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412505 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412505 "The millets are a group of small-seeded species of cereal crops or grains, widely grown around the world for food and fodder. They do not form a taxonomic group, but rather a functional or agronomic one. Their essential similarities are that they are small-seeded grasses grown in difficult production environments such as those at risk of drought. They have been in cultivation in East Asia for the last 10,000 years."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412505 "WIKIPEDIA:Millet")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412505 <http://eol.org/pages/8223>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412505 langual:B2505)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412505 "poaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412505 "millet plant"@en)
SubClassOf(obo:FOODON_03412505 obo:FOODON_03411324)

