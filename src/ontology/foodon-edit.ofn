SubClassOf(obo:FOODON_03411366 obo:FOODON_03411179)

# Class: obo:FOODON_03411367 (broad bean plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411367 "Vicia faba, the Broad Bean, is a species of bean (*Fabaceae*) native to north Africa and southwest Asia, and extensively cultivated elsewhere. A variety is provisionally recognized: Vicia faba var. equina Pers. - Horse Bean.  Although usually classified in the same genus Vicia as the vetches, some botanists treat it in a separate monotypic genus *Faba*. The term fava bean (from the Italian fava, meaning \"broad bean\") is usually used in English speaking countries such as the US, however the term broad bean is the most common name in the UK."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411367 "WIKIPEDIA:Vicia_faba")
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_03411367 "vicia faba"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411367 <http://eol.org/pages/4277>)
