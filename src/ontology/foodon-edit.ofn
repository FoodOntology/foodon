# Class: <http://purl.obolibrary.org/obo/FOODON_03440011> (extent of food heat treatment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440011> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03440011> "Used to broadly characterize a food product based on the extent of heat applied. Heat treatment affects the flavor and textural characteristics of a food and thus consumer preparation time. Heat treatment causes chemical changes and/or reduction of enzyme and of microbial activity and thus affects food safety and shelflife. Specifics of preparation are covered by *G. COOKING METHOD* and *H. TREATMENT APPLIED*. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440011> <http://www.langual.org/langual_thesaurus.asp?termid=F0011>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440011> "extent of food heat treatment"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03440011> <http://purl.obolibrary.org/obo/FOODON_00002470>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03440014> (fully heat-treated)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440014> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440014> <http://www.langual.org/langual_thesaurus.asp?termid=F0014>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440014> "cooked, fully"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440014> "fully cooked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440014> "ready to eat (cooked)"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03440014> "LanguaL curation note: Used when heat was applied to a food product for a time sufficient to fully change its flavor and textural characteristics and to cause significant chemical changes and/or destruction of enzyme and microbial activity. The product can be consumed without further cooking."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440014> "fully heat-treated"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03440014> <http://purl.obolibrary.org/obo/FOODON_03440022>)
DisjointClasses(<http://purl.obolibrary.org/obo/FOODON_03440014> <http://purl.obolibrary.org/obo/FOODON_03440018>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03440018> (partially heat-treated)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440018> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440018> <http://www.langual.org/langual_thesaurus.asp?termid=F0018>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "brown and serve"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "cooked, partially"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "heat and serve"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "partially baked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "partially cooked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "prebaked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "precooked"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440018> "quick cooking"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03440018> "LanguaL curation note: Used when heat was applied to a food product for a time sufficient to partially change its flavor and textural characteristics and to cause some chemical changes and/or some reduction in enzyme and microbial activity. The product can be readied for consumption in a shortened cooking time. Products labeled 'quick cooking' are often partially heat treated. Some products are consumed partially heat-treated, e.g., pasteurized milk, blanched broccoli, or rare beef."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440018> "partially heat-treated"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03440018> <http://purl.obolibrary.org/obo/FOODON_03440022>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03440022> (heat-treated)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440022> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440022> <http://www.langual.org/langual_thesaurus.asp?termid=F0022>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440022> "heat-treated"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03440022> ObjectUnionOf(<http://purl.obolibrary.org/obo/FOODON_03440014> <http://purl.obolibrary.org/obo/FOODON_03440018>))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03440022> <http://purl.obolibrary.org/obo/FOODON_03440011>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03440023> (heat-treated, multiple components, different degrees of treatment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03440023> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03440023> <http://www.langual.org/langual_thesaurus.asp?termid=F0023>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03440023> "multiple heat treatments"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03440023> "LanguaL curation note: Used for foods containing several different components, each of which may have had a different *EXTENT OF HEAT TREATMENT*. An example would be a cheeseburger with a fully cooked bun and meat but a partially cooked slice of cheese and possibly raw tomato and lettuce."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03440023> "heat-treated, multiple components, different degrees of treatment"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03440023> <http://purl.obolibrary.org/obo/FOODON_03440011>)

