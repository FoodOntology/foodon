# Class: obo:FOODON_03411163 (palaemonid shrimp family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411163 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411163 "Palaemonidae is a family of shrimp in the order Decapoda. Two subfamilies are distinguished: *Palaemoninae* and *Pontoniinae*. *Palaemoninae* are mainly carnivores that eat small invertebrates and can be found in any aquatic habitat except the deep sea. The most significant genus is *Macrobrachium*, which contains commercially fished species. *Pontoniinae* inhabit coral reefs [https://en.wikipedia.org/wiki/Palaemonidae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411163 <http://eol.org/pages/7171>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411163 langual:B1163)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411163 "CEC1993:1236")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411163 "Palaemonidae")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411163 "freshwater prawns"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411163 "freshwater shrimps"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411163 "palaemonid shrimps"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411163 "palaemonidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411163 "palaemonid shrimp family"@en)
SubClassOf(obo:FOODON_03411163 obo:FOODON_03411237)

