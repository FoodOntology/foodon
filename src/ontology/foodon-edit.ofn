# Class: obo:FOODON_03411429 (mandarin orange tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411429 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411429 "The mandarin orange (*Citrus reticulata*), also known as the mandarin or mandarine, is a small citrus tree with fruit resembling other oranges, usually eaten plain or in fruit salads. Specifically reddish-orange mandarin cultivars can be marketed as tangerines, but this is not a botanical classification. 
 Mandarins are smaller and oblate, rather than spherical like the common oranges (which are a mandarin hybrid). The taste is considered less sour, as well as sweeter and stronger. A ripe mandarin is firm to slightly soft, heavy for its size, and pebbly-skinned. The peel is very thin, with very little bitter white mesocarp, so they are usually easier to peel and to split into segments. Hybrids generally have these traits to a lesser degree."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411429 wikipedia:Mandarin_orange)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 <http://eol.org/pages/582204>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 obo:NCBITaxon_85571)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10778>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=28888>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 langual:B1429)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 "MANSFELD:7687")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411429 "PLANTS:CIRE3")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411429 "Citrus reticulata Blanco")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "citrus deliciosa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "citrus nobilus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "citrus reticulata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "citrus unshia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "fremont"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "loose-skinned orange"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411429 "tangerine tree"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411429 "mandarin orange tree"@en)
SubClassOf(obo:FOODON_03411429 obo:FOODON_03411139)
