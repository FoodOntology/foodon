AnnotationAssertion(go:hasDbXref obo:FOODON_03411443 "PLANTS:BROLB")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea L. var. botrytis L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea L. var. italica Plenck")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411443 "Brassica oleracea var. botrytis L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411443 "brassica oleracea l. convar. botrytis var. italica"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411443 "brassica oleracea var. botrytis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411443 "brassica oleracea var. italica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411443 "broccoli plant"@en)
