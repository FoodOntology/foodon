AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3827 "PLANTS:CIAR5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3827 "Cicer arietinum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3827 "bengal gram bean"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3827 "chick bean"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3827 "chick pea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3827 "cicer arietinum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3827 "indian gram bean"@en)
SubClassOf(obo:NCBITaxon_3827 obo:FOODON_00002918)

