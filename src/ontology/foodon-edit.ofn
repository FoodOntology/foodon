AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430164 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430164 langual:E0164)
AnnotationAssertion(rdfs:label obo:FOODON_03430164 "edible bar"@en)
SubClassOf(obo:FOODON_03430164 obo:FOODON_03430154)

# Class: obo:FOODON_03430165 (liquid, supplement form)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430165 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430165 langual:E0165)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430165 "ampoule"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430165 "liquid, supplement form"@en)
SubClassOf(obo:FOODON_03430165 obo:FOODON_03430154)

# Class: obo:FOODON_03430166 (oral drops)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430166 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430166 "Oral drops are liquid preparations for oral use that are intended to be administered in small volumes with the aid of a suitable measuring device."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430166 langual:E0166)
AnnotationAssertion(rdfs:label obo:FOODON_03430166 "oral drops"@en)
SubClassOf(obo:FOODON_03430166 obo:FOODON_03430165)

# Class: obo:FOODON_03430167 (syrup food supplement)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430167 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430167 "Syrup or suspension/emulsion."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430167 langual:E0167)
AnnotationAssertion(rdfs:label obo:FOODON_03430167 "syrup food supplement"@en)
SubClassOf(obo:FOODON_03430167 obo:FOODON_03430165)

# Class: obo:FOODON_03430168 (spray supplement)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430168 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430168 langual:E0168)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430168 "oral spray"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430168 "squirt"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430168 "spray supplement"@en)
SubClassOf(obo:FOODON_03430168 obo:FOODON_03430165)

# Class: obo:FOODON_03430169 (parenteral preparation)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430169 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430169 "Parenteral preparations are not dietary supplements per se, but are included in this classification because of their importance in nutrient intake.
Parenteral preparations are sterile, pyrogen-free liquids (solutions, emulsions, or suspensions) or solid dosage forms containing one or more active ingredients, packaged in either single-dose or multidose containers. There are four main forms of parenteral preparations: injections, intravenous infusions (large volume parenterals), powders for injections, and implants. [http://apps.who.int/phint/en/p/docf/]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430169 langual:E0169)
AnnotationAssertion(rdfs:label obo:FOODON_03430169 "parenteral preparation"@en)
SubClassOf(obo:FOODON_03430169 obo:FOODON_03430165)

# Class: obo:FOODON_03430170 (solution for injection)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430170 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430170 "Medicinal use, e.g. B12 injections. Injection means the act of forcing a liquid into the body by means of a needle and syringe."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430170 langual:E0170)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430170 "injection"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430170 "shot"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430170 "solution for injection"@en)
SubClassOf(obo:FOODON_03430170 obo:FOODON_03430169)

# Class: obo:FOODON_03430171 (solution for infusion)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430171 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430171 "Infusion means the introduction of a substance, such as a fluid, electrolyte, nutrient, or drug, directly into a vein or interstitially by means of gravity flow."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430171 langual:E0171)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430171 "intravenous feeding"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430171 "intravenous infusion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430171 "solution for infusion"@en)
SubClassOf(obo:FOODON_03430171 obo:FOODON_03430169)

# Class: obo:FOODON_03430173 (edible wafer)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430173 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430173 langual:E0173)
AnnotationAssertion(rdfs:label obo:FOODON_03430173 "edible wafer"@en)
SubClassOf(obo:FOODON_03430173 obo:FOODON_03430154)

# Class: obo:FOODON_03430174 (lozenge)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430174 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430174 "A lozenge is designed to dissolve in the mouth. For example, to soothe the throat as a cough drop. [http://www.MedicineNet.com]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430174 langual:E0174)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430174 "troche"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430174 "LanguaL curation note: Includes strips."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430174 "lozenge"@en)
SubClassOf(obo:FOODON_03430174 obo:FOODON_03430154)

# Class: obo:FOODON_03430175 (edible gel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430175 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430175 langual:E0175)
AnnotationAssertion(rdfs:label obo:FOODON_03430175 "edible gel"@en)
SubClassOf(obo:FOODON_03430175 obo:FOODON_03430154)

