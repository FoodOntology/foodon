AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412743 "Chickasaw plum")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412743 "prunus angustifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412743 "chickasaw plum plant"@en)
SubClassOf(obo:FOODON_03412743 obo:FOODON_03411206)
SubClassOf(obo:FOODON_03412743 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_122119))

