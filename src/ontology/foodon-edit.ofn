# Class: obo:FOODON_03414960 (partridge berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414960 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414960 "Mitchella repens (partridge berry or squaw vine) is the best known plant in the genus *Mitchella*. It is a creeping prostrate herbaceous woody shrub occurring in North America belonging to the madder family (Rubiaceae). The scarlet berries are edible but rather tasteless, with a faint flavour of wintergreen, resembling cranberries (to which they are not closely related). They are often confused with the Newfoundland \"partridgeberry\" which is actually a relative of the lingonberry. [https://en.wikipedia.org/wiki/Mitchella_repens]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414960 <http://eol.org/pages/1107478>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414960 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402637>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414960 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=35063>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414960 langual:B4960)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414960 "PLANTS:MIRE")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414960 "partridgeberry")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414960 "mitchella repens"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414960 "squawvine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414960 "partridge berry plant"@en)
SubClassOf(obo:FOODON_03414960 obo:FOODON_03411231)
SubClassOf(obo:FOODON_03414960 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_45181))

# Class: obo:FOODON_03414961 (rugosa rose plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414961 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414961 "Rosa rugosa (rugosa rose, beach rose, Japanese rose, or Ramanas rose) is a species of rose native to eastern Asia, in northeastern China, Japan, Korea and southeastern Siberia, where it grows on the coast, often on sand dunes. [https://en.wikipedia.org/wiki/Rosa_rugosa]"@en)
