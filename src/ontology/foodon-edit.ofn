# Class: obo:FOODON_03420167 (fruit part)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03420167 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03420167 "The fleshy fruit of any plant. *FRUIT* includes vegetables berries and pods as well. The bulk of a fruit is its fleshy part, which is covered by a peel (skin) and which encloses a core, pit or seeds."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03420167 langual:C0167)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03420167 "berry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03420167 "berry or fruit (anatomical part)"@en)
