AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411172 "bengal gram bean"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411172 "chick bean"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411172 "chick pea"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411172 "cicer arietinum"@en)
