# Class: obo:FOODON_03414218 (myrtle-leaf orange plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414218 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414218 "Citrus myrtifolia, the myrtle-leaved orange tree, is a species of Citrus with foliage similar to that of the common myrtle. The fruit of the tree resemble small oranges. They are sour or bitter and are commonly called by their Italian name, *chinotto*. They are an essential flavoring agent of most Italian amari, of the popular Campari apéritif, and of several brands of carbonated soft drinks that are generically called \"chinotto\". [https://en.wikipedia.org/wiki/Citrus_myrtifolia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414218 <http://eol.org/pages/4414>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414218 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10756>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414218 langual:B4218)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414218 "Citrus myrtifolia Raf.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414218 "citrus myrtifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414218 "myrtle-leaf orange plant"@en)
SubClassOf(obo:FOODON_03414218 obo:FOODON_03411139)

# Class: obo:FOODON_03414219 (common quince plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414219 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414219 "The quince (*Cydonia oblonga *) is the sole member of the genus *Cydonia* in the family *Rosaceae *(which also contains apples and pears, among other fruits). It is a deciduous tree that bears a pome fruit, similar in appearance to a pear, and bright golden-yellow when mature.  [https://en.wikipedia.org/wiki/Quince]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 <http://eol.org/pages/245489>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12779>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25159>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 langual:B4219)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 "MANSFELD:8647")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414219 "PLANTS:CYOB2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414219 "quince")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414219 "wen po")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414219 "cydonia oblonga"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414219 "common quince plant"@en)
SubClassOf(obo:FOODON_03414219 obo:FOODON_03411298)
SubClassOf(obo:FOODON_03414219 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_36610))

# Class: obo:FOODON_03414220 (galia melon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414220 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414220 "The Galia is a type of hybrid melon originating from a cantaloupe-honeydew cross, larger than a cantaloupe, and with deep green flesh. The name Galia is the feminine form of the Israeli name Gal (meaning 'wave')."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414220 "WIKIPEDIA:Galia_(melon)")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414220 langual:B4220)
AnnotationAssertion(rdfs:label obo:FOODON_03414220 "galia melon plant"@en)
SubClassOf(obo:FOODON_03414220 obo:FOODON_03414221)

