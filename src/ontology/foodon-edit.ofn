AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411385 "Brassica oleracea L. var. viridis L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411385 "borekale"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411385 "brassica oleracea var. viridis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411385 "cow cabbage"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411385 "fodder kale"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411385 "portuguese kale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411385 "collard plant"@en)
SubClassOf(obo:FOODON_03411385 obo:FOODON_03411281)

