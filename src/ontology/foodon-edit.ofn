AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415049 "chaenomeles japonica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415049 "flowering-quince"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415049 "maule's quince"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415049 "japanese quince plant"@en)
