AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414522 "aerodramus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414522 "collocalia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414522 "swiftlet"@en)
SubClassOf(obo:FOODON_03414522 obo:FOODON_03414523)

