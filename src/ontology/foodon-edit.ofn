AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414562 "MSW3:14200813")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414562 "musk ox")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414562 "musk-ox")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414562 "musk ox"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414562 "musk-ox"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414562 "ovibos moschatus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414562 "muskox"@en)
SubClassOf(obo:FOODON_03414562 obo:FOODON_03414381)
SubClassOf(obo:FOODON_03414562 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_37176))

# Class: obo:FOODON_03414563 (narwhal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414563 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414563 "The narwhal, or narwhale (*Monodon monoceros*), is a medium-sized toothed whale and possesses a large \"tusk\" from a protruding canine tooth. It lives year-round in the Arctic waters around Greenland, Canada, and Russia. It is one of two living species of whale in the *Monodontidae* family, along with the beluga whale. The narwhal males are distinguished by a long, straight, helical tusk, which is an elongated upper left canine."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 <http://eol.org/pages/328542>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180485>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 langual:B4563)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 asfis:nar)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 "CEC1993:1461")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414563 "MSW3:14300107")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414563 "monodon monoceros"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414563 "narwhale"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414563 "unicorn whale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414563 "narwhal"@en)
SubClassOf(obo:FOODON_03414563 obo:FOODON_03411343)
SubClassOf(obo:FOODON_03414563 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_40151))

# Class: obo:FOODON_03414564 (harp seal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414564 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414564 "The harp seal or saddleback seal is a species of earless seal native to the northernmost Atlantic Ocean and parts of the Arctic Ocean."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414564 <http://eol.org/pages/1052720>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414564 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=622022>)
