# Class: <http://purl.obolibrary.org/obo/FOODON_03411129> (trout and salmon family)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411129> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411129> "Salmonidae is a family of ray-finned fish, the only living family currently placed in the order Salmoniformes. It includes salmon, trout, chars, freshwater whitefishes, and graylings, which collectively are known as the salmonids. The Atlantic salmon and trout of the genus *Salmo* give the family and order their names. [https://en.wikipedia.org/wiki/Salmonidae]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411129> <http://eol.org/pages/5158>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411129> <http://www.langual.org/langual_thesaurus.asp?termid=B1129>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411129> "salmonidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411129> "trout and salmon family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411129> <http://purl.obolibrary.org/obo/FOODON_03411592>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411133> (persian melon plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411133> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411133> "Persian melon, binomial name *Cucumis melo*, is a type of melon. It is orange in color and has a strongly netted, unridged rind. It is also known as the \"Patelquat\"."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411133> "WIKIPEDIA:Persian_melon")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411133> <http://www.langual.org/langual_thesaurus.asp?termid=B1133>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411133> "persian melon plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411133> <http://purl.obolibrary.org/obo/FOODON_03414221>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411134> (mammal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411134> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411134> "Mammals (from Latin mamma \"breast\") are vertebrate animals constituting the class Mammalia, and characterized by the presence of mammary glands which in females produce milk for feeding (nursing) their young, a neocortex (a region of the brain), fur or hair, and three middle ear bones."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_03411134> "Damion Dooley"@en)
