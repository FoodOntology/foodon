# Class: obo:NCBITaxon_57917 (Filipendula ulmaria)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_57917 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_57917 "*Filipendula ulmaria*, commonly known as meadowsweet or mead wort, is a perennial herb in the family *Rosaceae* that grows in damp meadows. Meadowsweet has also been referred to as queen of the meadow, pride of the meadow, meadow-wort, meadow queen, lady of the meadow, dollof, meadsweet, and bridewort.
[https://en.wikipedia.org/wiki/Filipendula_ulmaria]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_57917 "meadowsweet plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57917 <http://eol.org/pages/629935>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57917 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?17105>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57917 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25171>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57917 langual:B5078)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_57917 "PLANTS:FIUL")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_57917 "Filipendula ulmaria (L.) Maxim.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57917 "filipendula ulmaria"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_57917 "queen of the meadow"@en)
SubClassOf(obo:NCBITaxon_57917 obo:FOODON_03413359)

# Class: obo:NCBITaxon_57919 (Geum urbanum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_57919 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_57919 "*Geum urbanum*, also known as wood avens, herb Bennet, colewort and St. Benedict's herb (Latin herba benedicta), is a perennial plant in the rose family (*Rosaceae*), which grows in shady places. [https://en.wikipedia.org/wiki/Geum_urbanum]"@en)
