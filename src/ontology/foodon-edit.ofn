AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03413793 "Tuber melanosporum Vittad., 1831")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413793 "black périgord truffle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413793 "french black truffle"@en)
