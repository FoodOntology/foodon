AnnotationAssertion(go:hasDbXref obo:NCBITaxon_73102 "PLANTS:GASH")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_73102 "Gaultheria shallon Pursh")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_73102 "gaultheria shallon"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_73102 "shallon"@en)
SubClassOf(obo:NCBITaxon_73102 obo:FOODON_03411231)

