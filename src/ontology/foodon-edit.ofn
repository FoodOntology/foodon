AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_29719 "Mentha spicata L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29719 "mentha spicata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_29719 "mentha viridis"@en)
SubClassOf(obo:NCBITaxon_29719 obo:FOODON_03411267)

