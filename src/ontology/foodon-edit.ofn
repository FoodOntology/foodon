AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415128 langual:B5128)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415128 "euphrasia officinalis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415128 "euphrasia rostkoviana"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415128 "eyebright plant"@en)
SubClassOf(obo:FOODON_03415128 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415128 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_374709))

# Class: obo:FOODON_03415129 (filed horsetail plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415129 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415129 "Equisetum arvense, the field horsetail or common horsetail, is an herbaceous perennial horsetail native throughout the arctic and temperate regions of the northern hemisphere. *Equisetum arvense* has been used in traditional Austrian herbal medicine internally as tea, or externally as baths or compresses, for treatment of disorders of the skin, locomotor system, kidneys and urinary tract, rheumatism and gout. [https://en.wikipedia.org/wiki/Equisetum_arvense]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415129 <http://eol.org/pages/597765>)
