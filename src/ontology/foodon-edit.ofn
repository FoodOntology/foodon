AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415079 "narrow-leaved plantain")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415079 "ribgrass")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415079 "narrowleaf plantain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415079 "plantago lanceolata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415079 "ribwort plantain plant"@en)
