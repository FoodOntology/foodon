# Class: obo:NCBITaxon_13363 (Borago officinalis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_13363 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_13363 "Borage, (*Borago officinalis*), also known as a starflower, is an annual herb originating in Syria,[1] but naturalized throughout the Mediterranean region, as well as Asia Minor, Europe, North Africa, and South America. Traditionally borage was cultivated for culinary and medicinal uses, although today commercial cultivation is mainly as an oilseed. Borage is used as either a fresh vegetable or a dried herb."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_13363 "borage plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_13363 "WIKIPEDIA:Borago_officinalis")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13363 <http://eol.org/pages/580765>)
