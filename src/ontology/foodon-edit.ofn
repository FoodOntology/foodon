# Class: obo:NCBITaxon_458363 (Pediomelum esculentum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_458363 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_458363 "*Psoralea esculenta* (prairie turnip) is an herbaceous perennial plant native to prairies and dry woodlands of central North America, which bears a starchy tuberous root edible as a root vegetable. The plant is also known as *Pediomelum esculenta*. English names for the plant include tipsin, teepsenee, breadroot, breadroot scurf pea, and pomme blanche. The prairie turnip was a staple food of the Plains Indians."@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_458363 "Damion Dooley"@es)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_458363 "prairie turnip plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_458363 "WIKIPEDIA:Prairie_Turnip")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_458363 <http://eol.org/pages/4277>)
