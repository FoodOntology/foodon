SubClassOf(obo:NCBITaxon_43700 obo:FOODON_03414872)

# Class: obo:NCBITaxon_43725 (Quassia amara)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_43725 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_43725 "*Quassia amara* is a species in the genus *Quassia*, with some botanists treating it as the sole species in the genus. It is famous and used for the bitterwood or quassia, its heartwood, used as a febrifuge; this contains quassin, a bitter-tasting substance (it is, in fact, the bitterest substance found in nature). Extracts of *Q. amara* bark containing quassinoids are used as insecticides, being particularly useful against aphids on crop plants. It is also used to flavor aperitifs and bitters which are added to cocktails."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_43725 "bitterwood plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_43725 "WIKIPEDIA:Bitterwood")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43725 <http://eol.org/pages/582215>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43725 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30632>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43725 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=28841>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43725 langual:B2793)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43725 "PLANTS:QUAM")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_43725 "Quassia amara L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43725 "mafourere"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43725 "quassia amara"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43725 "quassia-wood"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43725 "surinam quassia"@en)
SubClassOf(obo:NCBITaxon_43725 obo:FOODON_03411024)

# Class: obo:NCBITaxon_438424 (Limnophila aromatica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_438424 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_438424 "*Limnophila aromatica* (synonym: *Limnophila chinensis* var. *aromatica*; also called rice paddy herb) is a tropical flowering plant in the plantain family, *Plantaginaceae*. [https://en.wikipedia.org/wiki/Limnophila_aromatica]"@en)
