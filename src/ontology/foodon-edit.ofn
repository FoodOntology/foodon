# Class: obo:NCBITaxon_23207 (Prunus serotina)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_23207 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_23207 "*Prunus serotina*, commonly called black cherry, wild black cherry, rum cherry, or mountain black cherry, is a deciduous woody plant species belonging to the genus Prunus. The species is widespread and common in North America and South America. Black cherry is closely related to the chokecherry (*Prunus virginiana*); chokecherry, however, is classified as a shrub or small tree and has smaller, less glossy leaves. [https://en.wikipedia.org/wiki/Prunus_serotina]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_23207 "black cherry plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_23207 <http://eol.org/pages/791911>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_23207 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30099>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_23207 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24764>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_23207 langual:B2479)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_23207 "PLANTS:PRSE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_23207 "Prunus serotina Ehrh.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_23207 "prunus serotina"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_23207 "wild black cherry"@en)
SubClassOf(obo:NCBITaxon_23207 obo:FOODON_03411306)

