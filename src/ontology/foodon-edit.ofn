AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414475 "narrow-leaf cattail")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414475 "lesser bulrush"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414475 "lesser reedmace"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414475 "narrow-leaf cat-tail"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414475 "narrowleaf cattail"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414475 "typha angustifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414475 "narrowleaf cattail plant"@en)
