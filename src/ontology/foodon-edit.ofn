AnnotationAssertion(go:hasDbXref obo:FOODON_03415047 langual:B5047)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415047 "PLANTS:CRME12")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415047 "Crataegus mexicana DC.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415047 "crataegus mexicana"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415047 "manzanita"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415047 "tejocote"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415047 "mexican hawthorn plant"@en)
SubClassOf(obo:FOODON_03415047 obo:FOODON_03411708)

