AnnotationAssertion(go:hasDbXref obo:NCBITaxon_27602 "MSW3:14300005")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_27602 "Balaena mysticetus Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_27602 "arctic right whale"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_27602 "balaena mysticetus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_27602 "black right whale"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_27602 "bowhead whale"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_27602 "great polar whale"@en)
