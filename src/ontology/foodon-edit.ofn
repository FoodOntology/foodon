# Class: obo:FOODON_03414164 (cetacean marine mammal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414164 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414164 "The order *Cetacea* includes the marine mammals commonly known as whales, dolphins, and porpoises. Cetus is Latin and is used in biological names to mean \"whale\"; its original meaning, \"large sea animal\", was more general."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414164 "WIKIPEDIA:Cetacea")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414164 <http://eol.org/pages/7649>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414164 langual:B4164)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414164 "cetacea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414164 "cetacean marine mammal"@en)
SubClassOf(obo:FOODON_03414164 obo:FOODON_03411122)

# Class: obo:FOODON_03414165 (pinniped group)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414165 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414165 "Pinnipeds (from Latin pinna, wing or fin, and ped-, foot) or fin-footed mammals are a widely distributed and diverse group of semiaquatic marine mammals comprising the families *Odobenidae* (the walrus), *Otariidae* (eared seals, including sea lions and fur seals), and *Phocidae* (earless seals)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414165 "WIKIPEDIA:Pinniped")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414165 langual:B4165)
AnnotationAssertion(rdfs:label obo:FOODON_03414165 "pinniped group"@en)
SubClassOf(obo:FOODON_03414165 obo:FOODON_03411122)

# Class: obo:FOODON_03414166 (domestic turkey)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414166 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414166 "A large fowl, one of the two species in the genus Meleagris and the same as the wild turkey. [...] all of the main domestic turkey varieties today descend from the turkey raised in central Mexico that was subsequently imported into Europe by the Spanish in the 16th century."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414166 wikipedia:Domestic_turkey)
AnnotationAssertion(Annotation(dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/deed.en>) Annotation(dcterms:rightsHolder wikipedia:User:Lupin) schema:image obo:FOODON_03414166 <https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Male_north_american_turkey_supersaturated.jpg/503px-Male_north_american_turkey_supersaturated.jpg>)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03414166 "turkey"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414166 <http://eol.org/pages/1049266>)
