AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412476> "The sea lettuces comprise the genus *Ulva*, a group of edible green algae that is widely distributed along the coasts of the world's oceans. The type species within the genus *Ulva* is *Ulva lactuca* Linnaeus, \"lactuca\" meaning lettuce. Additionally, some species in the algae genus *Monostroma* are known as slender sea lettuces.  *Ulva lactuca* [EU Regulation, see http://eunis.eea.europa.eu/species/65984]"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03412476> "WIKIPEDIA:Sea_lettuce")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412476> <http://www.langual.org/langual_thesaurus.asp?termid=B2476>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03412476> "Ulva Linnaeus, 1753")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412476> "ulva spp."@en)
