AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414331 "PLANTS:SAKAP")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414331 "common saltwort")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414331 "prickly saltwort")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414331 "common saltwort"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414331 "prickly russian thistle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414331 "russian thistle"@en)
