# Class: obo:FOODON_03414677 (syzygium plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414677 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414677 "Syzygium is a genus of flowering plants that belongs to the myrtle family, *Myrtaceae*. The genus comprises about 1200-1800 species, and has a native range that extends from Africa and Madagascar through southern Asia east through the Pacific. Several species of *Syzygium* bear fruit that are edible for humans, many of which are named \"roseapple\". Fifty-two species are found in Australia and are generally known as lillipillies, brush cherries or satinash. [https://en.wikipedia.org/wiki/Syzygium]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414677 <http://eol.org/pages/2508658>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414677 langual:B4677)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414677 "brush cherry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414677 "lillipilli"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414677 "satinash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414677 "syzygium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414677 "syzygium plant"@en)
SubClassOf(obo:FOODON_03414677 obo:FOODON_03413387)

# Class: obo:FOODON_03414678 (scrub cherry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414678 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414678 "Syzygium australe, with many common names that include brush cherry, scrub cherry, creek lilly-pilly, creek satinash, and watergum, is a rainforest tree native to eastern Australia. The pleasantly sour fruit are also eaten fresh or cooked. [https://en.wikipedia.org/wiki/Syzygium_australe]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414678 <http://eol.org/pages/8095>)
