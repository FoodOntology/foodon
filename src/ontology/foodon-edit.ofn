AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414261 "PLANTS:RUPH")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414261 "Japanese wineberry")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414261 "duo xian xuan gou zi")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414261 "wine raspberry")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414261 "wineberry")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414261 "japanese wineberry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414261 "rubus phoenicolasius"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414261 "wine raspberry"@en)
