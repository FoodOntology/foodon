# Class: obo:NCBITaxon_55513 (Pistacia vera)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_55513 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_55513 "The pistachio, *Pistacia vera* in the *Anacardiaceae* family, is a small tree originally from Persia (Iran), which now can also be found in to regions of Syria, Lebanon, Turkey, Greece, Kyrgyzstan, Turkmenistan, India, Pakistan, Egypt, Sicily and possibly Afghanistan (especially in the provinces of Samangan and Badghis). The fruit is a drupe, containing an elongated seed, which is the edible portion. The seed, commonly thought of as a nut, is a culinary nut, not a botanical nut."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_55513 "pistachio plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_55513 "WIKIPEDIA:Pistachio")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 <http://eol.org/pages/483483>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?28655>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506470>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 langual:B1416)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 "MANSFELD:28393")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_55513 "PLANTS:PIVE3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_55513 "Pistacia vera L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_55513 "pistacia vera"@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_55513 "LanguaL curation note: When indexing the pistachio fruit (drupe, seed) index both *PISTACHIO [B1416]* and *FRUIT [C0167]* (or its more precise narrower terms)."@en)
SubClassOf(obo:NCBITaxon_55513 obo:FOODON_03411022)

# Class: obo:NCBITaxon_55577 (Dioscorea cayenensis subsp. rotundata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_55577 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_55577 "*Dioscorea cayennensis* subsp. *rotundata*, the \"white yam\", sometimes sold as \"Guinea yam\" or \"white ñame\", is a subspecies of yam native to Africa. It is one of the most important cultivated yams.[https://en.wikipedia.org/wiki/Dioscorea_cayennensis_subsp._rotundata]"@en)
