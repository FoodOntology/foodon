AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3621 "PLANTS:RHRH2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3621 "Rheum rhabarbarum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3621 "rheum rhabarbarum"@en)
SubClassOf(obo:NCBITaxon_3621 obo:FOODON_03411364)

