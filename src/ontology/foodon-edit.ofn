# Class: obo:FOODON_03412411 (dulse)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412411 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412411 "Palmaria palmata (Linnaeus) Kuntze, also called dulse, dillisk, dilsk, red dulse, sea lettuce flakes or creathnach, is a red alga (*Rhodophyta*) previously referred to as *Rhodymenia palmata* (Linnaeus) Greville. It grows on the northern coasts of the Atlantic and Pacific oceans. It is a well-known snack food, and in Iceland, where it is known as söl, it has been an important source of fiber throughout the centuries."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412411 <http://eol.org/pages/968088>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412411 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=12842>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412411 langual:B2411)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412411 asfis:rhp)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412411 "rhodymenia palmata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412411 "dulse"@en)
SubClassOf(obo:FOODON_03412411 obo:FOODON_03413790)
SubClassOf(obo:FOODON_03412411 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_2822))

