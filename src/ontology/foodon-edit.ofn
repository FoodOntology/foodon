# Class: obo:NCBITaxon_2822 (Palmaria palmata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_2822 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_2822 "*Palmaria palmata* (Linnaeus) Kuntze, also called dulse, dillisk, dilsk, red dulse, sea lettuce flakes or creathnach, is a red alga (*Rhodophyta*) previously referred to as *Rhodymenia palmata* (Linnaeus) Greville. It grows on the northern coasts of the Atlantic and Pacific oceans. It is a well-known snack food, and in Iceland, where it is known as söl, it has been an important source of fiber throughout the centuries."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_2822 "dulse"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_2822 "WIKIPEDIA:Palmaria_palmata")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_2822 <http://eol.org/pages/968088>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_2822 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=12842>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_2822 langual:B2411)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_2822 asfis:rhp)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_2822 "Palmaria palmata")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_2822 "rhodymenia palmata"@en)
SubClassOf(obo:NCBITaxon_2822 obo:FOODON_03413790)

