AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03430107> "wedge-shaped"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430107> "LanguaL curation note: Used for solid products that are divided into more than four pieces each of which is the same shape (e.g., wedge of cheese)."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430107> "divided into segments or wedges"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430107> <http://purl.obolibrary.org/obo/FOODON_03430133>)

