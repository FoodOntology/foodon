AnnotationAssertion(go:hasDbXref obo:NCBITaxon_63459 "PLANTS:CHQU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_63459 "Chenopodium quinoa Willd.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_63459 "chenopodium quinoa"@en)
SubClassOf(obo:NCBITaxon_63459 obo:FOODON_03411324)
SubClassOf(obo:NCBITaxon_63459 obo:FOODON_03414745)

