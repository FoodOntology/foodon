# Class: obo:NCBITaxon_35874 (Dioscorea bulbifera)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_35874 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_35874 "*Dioscorea bulbifera*, the air potato, is a species of true yam in the yam family, *Dioscoreaceae*. It is native to Africa, southern Asia, India, Maldives, China, Japan, the Philippines, and Indonesia and northern Australia. The air potato is one of the most widely consumed yam species. [https://en.wikipedia.org/wiki/Dioscorea_bulbifera]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_35874 "air potato plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35874 <http://eol.org/pages/1121145>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35874 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?14186>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35874 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=43369>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35874 langual:B4717)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35874 "PLANTS:DIBU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_35874 "Dioscorea bulbifera L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_35874 "air yam"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_35874 "bitter yam"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_35874 "cheeky yam"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_35874 "dioscorea bulbifera"@en)
SubClassOf(obo:NCBITaxon_35874 obo:FOODON_03413396)

# Class: obo:NCBITaxon_35875 (Allium fistulosum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_35875 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_35875 "*Allium fistulosum*, the Welsh onion, is a species of perennial plant very similar in taste and odor to the related common onion, *Allium cepa*, and hybrids between the two (tree onions) exist. A. fistulosum, however, does not develop bulbs, and possesses hollow leaves (fistulosum means \"hollow\") and scapes. Larger varieties of the *A. fistulosum* resemble the leek, such as the Japanese negi, whilst smaller varieties resemble chives. *A. fistulosum* can multiply by forming perennial evergreen clumps. [https://en.wikipedia.org/wiki/Allium_fistulosum]"@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_35875 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_35875 "welsh onion plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 <http://eol.org/pages/8187>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?2276>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=185463>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 langual:B2418)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 "MANSFELD:126")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_35875 "PLANTS:ALFI4")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "Japanese bunching onion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "allium fistulosum"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "bunching onion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "japanese bunching onion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "long green onion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "scallion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "spanish onion plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_35875 "spring onion plant"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_35875 "Allium fistulosum L.")
