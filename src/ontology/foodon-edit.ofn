# Class: obo:FOODON_03411002 (archaeogastropod)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411002 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411002 "Archaeogastropoda (also known as *Aspidobranchia*) was a taxonomic order of sea snails used in older classifications of gastropods, i.e. snails and slugs. *Archeogastropoda* are marine prosobranch gastropod mollusks, mainly mainly herbivores, typically having two gills and a double-chambered heart, with the eggs and sperm discharged directly into the water. They were traditionally regarded as a relatively primitive group. 
[https://en.wikipedia.org/wiki/Archaeogastropoda]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411002 langual:B1002)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411002 "aspidobranchia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411002 "archaeogastropod"@en)
SubClassOf(obo:FOODON_03411002 obo:FOODON_03412111)

# Class: obo:FOODON_03411005 (stem or spear vegetable plant)

AnnotationAssertion(obo:IAO_0000112 obo:FOODON_03411005 "Examples of stem vegetables are kohlrabi, celery, fennel and rhubarb.  Examples of shoot vegetables are asparagus, hop, bamboo shoots and taugé."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411005 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411005 "A vegetable having shoot or stem which can be cooked and eaten."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03411005 <https://orcid.org/0000-0001-5275-8866>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411005 langual:B1005)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411005 "shoot vegetable"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411005 "spear vegetable"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411005 "stem or spear vegetable plant"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_03411005 <http://foodcommodities.nl/commodities/vegetables.html>)
SubClassOf(obo:FOODON_03411005 obo:FOODON_03411057)

