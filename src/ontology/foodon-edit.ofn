AnnotationAssertion(go:hasDbXref obo:NCBITaxon_79629 langual:B4567)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_79629 asfis:fug)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_79629 "Fulmarus glacialoides (A. Smith, 1840)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_79629 "antarctic fulmar"@en)
