AnnotationAssertion(rdfs:label obo:FOODON_03414698 "tree fern plant"@en)
SubClassOf(obo:FOODON_03414698 obo:FOODON_03412453)

# Class: obo:FOODON_03414700 (livistona plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414700 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414700 "Livistona is a genus of palms (family *Arecaceae*), native to southern and southeastern Asia, Australasia, and the Horn of Africa. [https://en.wikipedia.org/wiki/Livistona]"@en)
