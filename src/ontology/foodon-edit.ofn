SubClassOf(obo:FOODON_03411976 obo:FOODON_03411968)

# Class: obo:FOODON_03411977 (fish, tetraodontiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411977 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411977 "The Tetraodontiformes are an order of highly derived ray-finned fish, also called the Plectognathi. Sometimes these are classified as a suborder of the order Perciformes. The Tetraodontiformes are represented by 10 extant families and at least 349 species overall; most are marine and dwell in and around tropical coral reefs, but a few species are found in freshwater streams and estuaries. [https://en.wikipedia.org/wiki/Tetraodontiformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411977 <http://eol.org/pages/5052>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411977 langual:B1977)
AnnotationAssertion(rdfs:label obo:FOODON_03411977 "fish, tetraodontiform"@en)
SubClassOf(obo:FOODON_03411977 obo:FOODON_03411365)

# Class: obo:FOODON_03411983 (fish, beryciform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411983 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411983 "The Beryciformes are a poorly-understood order of carnivorous ray-finned fishes consisting of 7 families, 30 genera, and 161 species. Member genera include the alfonsinos, squirrelfishes, flashlight fishes, fangtooth fishes, spinyfins, pineconefishes, redfishes, roughies, and slimeheads. 
[https://en.wikipedia.org/wiki/Beryciformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411983 <http://eol.org/pages/8234>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411983 langual:B1983)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411983 "beryciformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411983 "fish, beryciform"@en)
SubClassOf(obo:FOODON_03411983 obo:FOODON_03411365)

