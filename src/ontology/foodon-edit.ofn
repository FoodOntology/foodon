# Class: obo:NCBITaxon_33125 (Lepidium sativum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_33125 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_33125 "Cress (*Lepidium sativum*), sometimes referred to as garden cress to distinguish it from similar plants also referred to as cress (from old Germanic cresso which means sharp, spicy), is a rather fast-growing, edible herb. Garden cress is genetically related to watercress and mustard, sharing their peppery, tangy flavor and aroma. In some regions, garden cress is known as mustard and cress, garden pepper cress, pepperwort, pepper grass, or poor man's pepper.[https://en.wikipedia.org/wiki/Garden_cress]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_33125 "garden cress plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 <http://eol.org/pages/585527>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21769>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22978>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 langual:B2270)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 "MANSFELD:23709")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33125 "PLANTS:LESA2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_33125 "Lepidium sativum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33125 "garden pepper cress"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33125 "lepidium sativum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33125 "peppergrass"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33125 "pepperwort"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33125 "poor man's pepper"@en)
SubClassOf(obo:NCBITaxon_33125 obo:FOODON_03411566)
SubClassOf(obo:NCBITaxon_33125 obo:FOODON_03414739)

# Class: obo:NCBITaxon_33128 (Papaver rhoeas)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_33128 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_33128 "*Papaver rhoeas* is a species of flowering plant in the family *Papaveraceae*. It has a variety of common names, including the Corn Poppy, Field Poppy, Flanders Poppy, or Red Poppy, one of the many species and genera named poppy. The four petals are vivid red, most commonly with a black spot at their base. Its seed is a moderately useful commodity, used in bread dough, for example, and to decorate bread. The red petals are used to make syrups and alcoholic/non-alcoholic drinks. Red poppy syrup is a traditional beverage of Mediterranean regions. [Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_33128 "corn poppy plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33128 <http://eol.org/pages/596241>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33128 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?26703>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33128 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=18893>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33128 langual:B3709)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33128 "PLANTS:PARH2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_33128 "Papaver rhoeas L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "common poppy"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "coquelicot"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "field poppy"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "flanders poppy"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "papaver rhoeas"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_33128 "shirley poppy"@en)
SubClassOf(obo:NCBITaxon_33128 obo:FOODON_03411515)

# Class: obo:NCBITaxon_33129 (Phaseolus acutifolius)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_33129 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_33129 "*Phaseolus acutifolius*, the Tepary bean, is native to the southwestern United States and Mexico and has been grown there by the native peoples since pre-Columbian times. It is more drought-resistant than the common bean (*Phaseolus vulgaris*) and is grown in desert and semi-desert conditions from Arizona through Mexico to Costa Rica.[https://en.wikipedia.org/wiki/Phaseolus_acutifolius]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_33129 "tepary plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_33129 <http://eol.org/pages/640456>)
