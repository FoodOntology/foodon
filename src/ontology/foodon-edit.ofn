AnnotationAssertion(go:hasSynonym obo:FOODON_03414187 "kishimejizoku"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414187 "An edible mushroom that grows mainly in fields, grass verges and roadsides."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414253 obo:IAO_0000122)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414253 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=201073>)
