# Class: obo:FOODON_03414981 (african eggplant plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414981 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414981 "Solanum macrocarpon otherwise known as the African eggplant or gboma is a plant of the *Solanaceae* family.  *S. macrocarpon* is a tropical perennial plant that is closely related to the eggplant. The parts of the plant that is consumed are the fruits and its young leaves. While taste of both the leaves and the fruit are very bitter they have a high nutrient yield. [https://en.wikipedia.org/wiki/Solanum_macrocarpon]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414981 <http://eol.org/pages/484220>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414981 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?102157>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414981 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505838>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414981 langual:B4981)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414981 "PLANTS:SOMA7")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414981 "African eggplant")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414981 "antroewa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414981 "gboma"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414981 "solanum macrocarpon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414981 "african eggplant plant"@en)
SubClassOf(obo:FOODON_03414981 obo:FOODON_03411458)
SubClassOf(obo:FOODON_03414981 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_115666))

# Class: obo:FOODON_03414982 (ethiopian eggplant plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414982 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414982 "Solanum aethiopicum, the bitter tomato, Ethiopian eggplant, or nakati, is a fruiting plant of the genus *Solanum* mainly found in Asia and Tropical Africa. It is also known as Ethiopian nightshade, garden eggs, and mock tomato. [https://en.wikipedia.org/wiki/Solanum_aethiopicum]"@en)
