# Class: obo:FOODON_03411067 (lime (citrus) plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411067 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411067 "A lime  is a hybrid citrus fruit, which is typically round, lime green, 3-6 centimetres (1.2-2.4 in) in diameter, and contains acidic juice vesicles. There are several species of citrus trees whose fruits are called limes, including the Key lime (*Citrus aurantifolia*), Persian lime, kaffir lime, and desert lime. Limes are a rich source of vitamin C, sour and are often used to accent the flavours of foods and beverages. They are grown year-round. Plants with fruit called \"limes\" have diverse genetic origins; limes do not form a monophyletic group. [https://en.wikipedia.org/wiki/Lime_(fruit)]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 <http://eol.org/pages/4414>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10683>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506403>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 langual:B1067)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 "MANSFELD:7576")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411067 "PLANTS:CIAU7")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411067 "Citrus aurantiifolia (Christm. & Panz.) Swingle")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411067 "Citrus aurantiifolia (Christm.) Swingle")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411067 "Citrus ×aurantiifolia (Christm.) Swingle (pro sp.)")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411067 "citrus aurantiifolia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411067 "citrus medica var. acida"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411067 "indian lime"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411067 "key lime"@en)
