AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510180 langual:P0180)
AnnotationAssertion(rdfs:label obo:FOODON_03510180 "reduced saturated fat food"@en)
SubClassOf(obo:FOODON_03510180 obo:FOODON_03510071)

