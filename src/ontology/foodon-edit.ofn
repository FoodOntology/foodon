AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510021 langual:P0021)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03510021 "animal food"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510021 "animal as food consumer"@en)
