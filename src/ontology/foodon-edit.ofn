AnnotationAssertion(go:hasDbXref obo:NCBITaxon_304153 langual:B4652)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_304153 "PLANTS:PHMI14")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_304153 "Physalis minima L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_304153 "physalis minima"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_304153 "wild cape gooseberry"@en)
SubClassOf(obo:NCBITaxon_304153 obo:FOODON_03412519)

# Class: obo:NCBITaxon_304449 (Parachanna obscura)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_304449 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_304449 "The obscure snakehead, *Parachanna obscura*, is a medium-sized carnivorous fish that has an elongated shape tapered on both ends and is covered in medium circular scales (cycloid). The head, resembling a snake, is long and depressed anteriorly and covered with cycloid scales slightly larger than those scales on the body. This species is found in central Africa along the western coastline from as far north as Senegal to as far south as Zaire and into central Africa into southwest Sudan. [https://en.wikipedia.org/wiki/Obscure_snakehead]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_304449 "snakehead"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_304449 <http://eol.org/pages/204348>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_304449 langual:B2308)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_304449 "Parachanna obscura")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_304449 "ophicephalus obscurus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_304449 "parachanna obscura"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_304449 "snake-head"@en)
SubClassOf(obo:NCBITaxon_304449 obo:FOODON_03412309)

# Class: obo:NCBITaxon_30455 (Fulmarus glacialis)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_30455 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_30455 "The northern fulmar (*Fulmarus glacialis*), fulmar, or Arctic fulmar is a highly abundant sea bird found primarily in subarctic regions of the North Atlantic and North Pacific oceans. Fulmars come in one of two color morphs: a light one which is almost entirely white, and a dark one which is uniformly gray. Though similar in appearance to gulls, fulmars are in fact members of the *Procellariidae* family, which include petrels and shearwaters. It and the southern fulmar (*Fulmarus glacialodes*) together comprise the only extant species in the genus Fulmarus."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_30455 "northern fulmar"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_30455 "WIKIPEDIA:Northern_fulmar")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_30455 <http://eol.org/pages/1047350>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_30455 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=174536>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_30455 langual:B4566)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_30455 asfis:fno)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_30455 "Fulmarus glacialis (Linnaeus, 1761)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_30455 "arctic fulmar"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_30455 "fulmarus glacialis"@en)
SubClassOf(obo:NCBITaxon_30455 obo:FOODON_03414565)

