AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414974 "crampbark"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414974 "viburnum opulus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414974 "guelder-rose plant"@en)
