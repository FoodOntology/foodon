# Class: obo:NCBITaxon_42526 (Colossoma macropomum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_42526 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_42526 "A large species of freshwater fish in the family Serrasalmidae. It is native to tropical South America, but kept in aquaculture and introduced elsewhere. It is also known by the names black pacu, black-finned pacu, giant pacu, cachama, gamitana, and sometimes as pacu (a name used for several other related species)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_42526 "cachama"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_42526 wikipedia:Tambaqui)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_42526 <http://eol.org/pages/215393>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_42526 langual:B4876)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_42526 asfis:csm)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_42526 "Colossoma macropomum"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_42526 "tambaqui"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_42526 "Colossoma macropomum (Cuvier, 1816)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_42526 "colossoma macropomum"@en)
SubClassOf(obo:NCBITaxon_42526 obo:FOODON_03414875)

