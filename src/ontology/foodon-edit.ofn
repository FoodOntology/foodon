AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414228 "Rheum x rhabarbarum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414228 "garden rhubarb")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414228 "rhubarb")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414228 "rheum rhabarbarum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414228 "garden rhubarb plant"@en)
SubClassOf(obo:FOODON_03414228 obo:FOODON_03411364)
SubClassOf(obo:FOODON_03414228 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3621))

