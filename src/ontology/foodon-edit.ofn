AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414277 "gem shellfish"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414277 "southern fan scallop"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414277 "Zygochlamys delicatula")
