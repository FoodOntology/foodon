# Class: <http://purl.obolibrary.org/obo/FOODON_03414381> (bovid)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414381> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414381> "A bovid (family *Bovidae*) is any of almost 140 species of cloven-hoofed, ruminant mammal which has males with characteristic unbranching horns covered in a permanent sheath of keratin.

The family is widespread, being native to Asia, Africa, Europe and North America, and diverse: members include bison, African buffalo, water buffalo, antelopes, gazelles, sheep, goats, muskoxen, and domestic cattle."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414381> "WIKIPEDIA:Bovidae")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414381> <http://eol.org/pages/7687>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414381> <http://www.langual.org/langual_thesaurus.asp?termid=B4381>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414381> "bovidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414381> "bovid"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414381> <http://purl.obolibrary.org/obo/FOODON_03411134>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414382> (chinese mud carp)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414382> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414382> "Chinese mud carp (Cirrhinus chinensis) is a species of ray-finned fish in the genus Cirrhinus. Chinese mud carp is an important food fish in Guangdong Province. It is also cultured in this area and Taiwan.
 
Cantonese and Shunde cuisines often use this fish to make fish balls and dumplings."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414382> "WIKIPEDIA:Cirrhinus_chinensis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414382> <http://eol.org/pages/3198>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414382> <http://www.langual.org/langual_thesaurus.asp?termid=B4382>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414382> "cirrhinus chinensis"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414382> "chinese mud carp"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414382> <http://purl.obolibrary.org/obo/FOODON_03412617>)

