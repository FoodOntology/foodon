AnnotationAssertion(go:hasDbXref obo:NCBITaxon_2576622 "CEC1993:1076")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_2576622 "Chelidonichthys lucernus (Linnaeus, 1758)")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_2576622 "Trigla lucerna Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_2576622 "chelidonichthys lucerna"@en)
