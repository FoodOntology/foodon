# Class: obo:NCBITaxon_377473 (Bunium bulbocastanum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_377473 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_377473 "*Bunium bulbocastanum* is a plant species in the family *Apiaceae*. It is related to cumin (*Cuminum cyminum*) and commonly called black cumin, blackseed, black caraway, or great pignut, and has a smoky, earthy taste. It is often confused with *Nigella sativa* (which is also called black cumin, blackseed, and black caraway). [https://en.wikipedia.org/wiki/Bunium_bulbocastanum]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_377473 "great pignut plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 <http://eol.org/pages/581707>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?316877>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?406659>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=29603>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 langual:B5036)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_377473 "PLANTS:BUBU4")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_377473 "Bunium bulbocastanum L.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_377473 "Bunium persicum (Boiss.) B. Fedtsch.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_377473 "black caraway"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_377473 "bunium bulbocastanum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_377473 "bunium persicum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_377473 "earthnut"@en)
SubClassOf(obo:NCBITaxon_377473 obo:FOODON_03411179)

# Class: obo:NCBITaxon_378008 (Curcuma australasica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_378008 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_378008 "*Curcuma australasica*, Native Turmeric, or Cape York Lily, is a rhizomatous herbaceous perennial plant of the *Zingiberaceae* or ginger family. It occurs on Cape York Peninsula, a few areas in the Northern Territory, Australia, and in Papua New Guinea. Aboriginal people in Cape York Peninsula used to roast and eat the roots of this plant. [https://en.wikipedia.org/wiki/Curcuma_australasica]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_378008 "native turmeric plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_378008 <http://eol.org/pages/1122341>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_378008 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=817991>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_378008 langual:B4713)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_378008 "PLANTS:CUAU2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_378008 "Curcuma australasica Hook. f.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_378008 "cape york lily"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_378008 "curcuma australasica"@en)
SubClassOf(obo:NCBITaxon_378008 obo:FOODON_03411018)

