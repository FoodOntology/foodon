AnnotationAssertion(go:hasSynonym obo:NCBITaxon_2576622 "smallscaled gurnard"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_2576622 "trigla corax"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_2576622 "trigla lucerna"@en)
