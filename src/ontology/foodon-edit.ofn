AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414904 <http://eol.org/pages/57691>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414904 langual:B4904)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414904 "typical snail"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414904 "helicidae"@en)
SubClassOf(obo:FOODON_03414904 obo:FOODON_03411455)

