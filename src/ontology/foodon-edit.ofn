AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510202 langual:P0202)
AnnotationAssertion(rdfs:label obo:FOODON_03510202 "protein special claim"@en)
SubClassOf(obo:FOODON_03510202 obo:FOODON_03510065)

# Class: obo:FOODON_03510203 (high protein food)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510203 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510203 "A claim that a food is high in protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 20 % of the energy value of the food is provided by protein [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510203 langual:P0203)
AnnotationAssertion(rdfs:label obo:FOODON_03510203 "high protein food"@en)
SubClassOf(obo:FOODON_03510203 obo:FOODON_03510202)

