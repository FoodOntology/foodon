AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430151> "A soft product that is spreadable or formable is considered semisolid.  Room temperature is roughly 20 degrees C."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430151> "food (solid)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430151> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_00002454> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001546>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430151> <http://purl.obolibrary.org/obo/FOODON_00002454>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430152> (divided into pieces)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430152> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430152> "Divided into pieces whose shape bears little or no relation to the shape of the whole. If all dimensions are below 0.2 cm., use *DISINTEGRATED OR GROUND*. Examples are: bread slice, cubed beef, sliced carrot, cut green beans, apple ring, shredded cabbage or cheese."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430152> <http://www.langual.org/langual_thesaurus.asp?termid=E0152>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430152> "divided into pieces"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430152> <http://purl.obolibrary.org/obo/FOODON_03430122>)

