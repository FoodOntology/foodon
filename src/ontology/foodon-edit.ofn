AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_32201 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_32201 "The pecan, *Carya illinoinensis*, is a species of hickory, native to south-central North America, in Mexico from Coahuila south to Jalisco and Veracruz, in the United States from southern Iowa, Illinois, Missouri, and Indiana east to western Kentucky, southwestern Ohio, North Carolina, South Carolina, and western Tennessee, south through Georgia, Alabama, Mississippi, Louisiana, Texas, Oklahoma, Arkansas, and Florida, and west into New Mexico."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_32201 "pecan tree"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_32201 "WIKIPEDIA:Pecan")
