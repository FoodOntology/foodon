# Class: obo:NCBITaxon_4567 (Triticum turgidum subsp. durum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_4567 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_4567 "Durum wheat, also called pasta wheat or macaroni wheat (Triticum durum or Triticum turgidum subsp. durum),[4] is a tetraploid species of wheat. It is the second most cultivated species of wheat after common wheat, although it represents only 5% to 8% of global wheat production."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_4567 "durum wheat plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4567 <http://eol.org/pages/8223>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4567 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?406896>)
