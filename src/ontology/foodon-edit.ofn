AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510200 langual:P0200)
AnnotationAssertion(rdfs:comment obo:FOODON_03510200 "LanguaL curation note: Denotes a product that contains no pork meat."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510200 "no pork added claim"@en)
SubClassOf(obo:FOODON_03510200 obo:FOODON_03510115)

# Class: obo:FOODON_03510201 (no beef added claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510201 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510201 langual:P0201)
AnnotationAssertion(rdfs:comment obo:FOODON_03510201 "LanguaL curation note: Denotes a product that contains no beef or beef-products. Beef is considered to be a taboo foodproduct by some religions most notable Hinduism, Boedism and Jainism."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510201 "no beef added claim"@en)
SubClassOf(obo:FOODON_03510201 obo:FOODON_03510115)

