# Class: obo:FOODON_03412543 (gonorynchiform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412543 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412543 "The Gonorynchiformes are an order of ray-finned fish that includes the important food source, the milkfish (*Chanos chanos*, family *Chanidae*), and a number of lesser-known types, both marine and freshwater.
The alternate spelling \"Gonorhynchiformes\", with an \"h\", is frequently seen but not official. [https://en.wikipedia.org/wiki/Gonorynchiformes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412543 <http://eol.org/pages/5483>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412543 langual:B2543)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412543 "gonorynchiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412543 "gonorynchiform fish"@en)
SubClassOf(obo:FOODON_03412543 obo:FOODON_03411365)

# Class: obo:FOODON_03412544 (albuliform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412544 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412544 "Albulidae is a family of fish, commonly known as the bonefishes, that are popular as game fish in Florida, select locations in the South Pacific and the Bahamas and elsewhere. The family is small, with 11 species in 3 genera. Presently, the bonefishes are in their own order: Albuliformes. [https://en.wikipedia.org/wiki/Bonefishes]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412544 "American Fisheries Society.
\\n\\n*Albulidae* is a family of fish, commonly known as the bonefishes, that are popular as game fish in Florida, select locations in the South Pacific and the Bahamas and elsewhere. The family is small, with 11 species in 3 genera. Presently, the bonefishes are in their own order: Albuliformes. [https://en.wikipedia.org/wiki/Bonefishes]")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412544 <http://eol.org/pages/8298>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412544 langual:B2544)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412544 "albuliformes"@en)
