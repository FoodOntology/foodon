SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430108> <http://purl.obolibrary.org/obo/FOODON_03430113>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430109> (food (liquid, low viscosity))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430109> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430109> "A liquid that flows very easily at room temperature."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430109> <http://www.langual.org/langual_thesaurus.asp?termid=E0109>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03430109> "thin liquid"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430109> "Examples are: water, apple juice, sherry, acidophilus milk, whipping cream and some heavy liqueurs. The range of low viscosity liquid spans sucrose solutions between 0 and 45% solids (viscosity range from 1 to 10 centipoise). Prefer 'solid pieces' factor term to 'small particles' if both appear in the food."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430109> "food (liquid, low viscosity)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430109> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001694>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430109> <http://purl.obolibrary.org/obo/FOODON_03430130>)

