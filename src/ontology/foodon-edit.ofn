AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412400 langual:B2400)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412400 "PLANTS:MAAR3")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412400 "maranta arundinacea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412400 "arrowroot plant"@en)
SubClassOf(obo:FOODON_03412400 obo:FOODON_03411016)
SubClassOf(obo:FOODON_03412400 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_210060))

