AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413436 "The *Lecythidaceae* comprise a family of about 20 genera and 250-300 species of woody plants native to tropical South America and Madagascar. The most important member of the family in world trade is the Brazil nut (*Bertholletia excelsa*), valued for its edible nuts; the Paradise nut (*Lecythis* species) is also eaten."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413436 "WIKIPEDIA:Lecythidaceae")
AnnotationAssertion(go:hasDbXref obo:FOODON_03413436 <http://eol.org/pages/34921>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413436 langual:B3436)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413436 "Lecythis zabucajo Aubl.; L. elliptica Kunth; L. ollaria L.; L. usitatis Miers")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413436 "lecythis spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413436 "paradise nut"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413436 "sapucaia-nut plant"@en)
