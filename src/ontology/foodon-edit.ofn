# Class: obo:NCBITaxon_455045 (Abelmoschus esculentus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_455045 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_455045 "Okra (*Abelmoschus esculentus* Moench, known in many English-speaking countries as lady's fingers or gumbo) is a flowering plant in the mallow family. It is valued for its edible green seed pods. The geographical origin of okra is disputed, with supporters of South Asian, Ethiopian and West African origins. The plant is cultivated in tropical, subtropical and warm temperate regions around the world."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_455045 "okra plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_455045 "WIKIPEDIA:Abelmoschus_esculentus")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_455045 <http://eol.org/pages/584458>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_455045 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?619>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_455045 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21770>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_455045 langual:B1241)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_455045 "PLANTS:ABES")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_455045 "Abelmoschus esculentus (L.) Moench")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_455045 "abelmoschus esculentus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_455045 "gombo"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_455045 "gumbo"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_455045 "hibiscus esculentus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_455045 "lady's finger"@en)
SubClassOf(obo:NCBITaxon_455045 obo:FOODON_03411006)
SubClassOf(obo:NCBITaxon_455045 obo:FOODON_03414282)

