AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03412016 "Solanum betaceum Cav.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03412016 "cyphomandra betacea"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412016 "solanum betaceum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412016 "tamarillo"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412016 "tree tomato plant"@en)
SubClassOf(obo:FOODON_03412016 obo:FOODON_03411006)

# Class: obo:FOODON_03412017 (cinnamon fern plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412017 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412017 "Osmundastrum is genus of leptosporangiate ferns in the family Osmundaceae with one accepted species, *Osmundastrum cinnamomeum*, the cinnamon fern. It is native to the Americas and eastern Asia, growing in swamps, bogs and moist woodlands. [https://en.wikipedia.org/wiki/Osmundastrum]"@en)
