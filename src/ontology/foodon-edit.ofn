AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414679 langual:B4679)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414679 "bush apple"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414679 "love apple"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414679 "syzygium eucalyptoides"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414679 "eucalypt eugenia plant"@en)
