# Class: obo:NCBITaxon_93759 (Corchorus olitorius)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_93759 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_93759 "Jute is a long, soft, shiny vegetable fibre that can be spun into coarse, strong threads. It is produced from plants in the genus *Corchorus*, which has been classified in the family *Tiliaceae*, or more recently in *Malvaceae*. However, it has been reclassified within the family *Sparrmanniaceae*.
 Jute is one of the most affordable natural fibres and is second only to cotton in amount produced and variety of uses of vegetable fibres."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_93759 "nalta jute plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_93759 "WIKIPEDIA:Corchorus_olitorius")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_93759 <http://eol.org/pages/584868>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_93759 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11458>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_93759 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=21516>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_93759 langual:B1731)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_93759 "PLANTS:COOL")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_93759 "jute"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_93759 "Corchorus olitorius L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "corchorus olitorius"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "jew's mallow"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "jute mallow"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "jute, nalta"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "molokhia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_93759 "tossa jute"@en)
