SubClassOf(obo:FOODON_03414342 obo:FOODON_03411179)

# Class: obo:FOODON_03414343 (vietnamese coriander plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414343 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414343 "Persicaria odorata, the Vietnamese coriander, is an herb whose leaves are used in Southeast Asian cooking. Other English names for the herb include Vietnamese mint, Vietnamese cilantro, Cambodian mint and hot mint."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414343 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?407755>)
