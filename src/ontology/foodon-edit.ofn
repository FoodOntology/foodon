# Class: obo:FOODON_03414167 (ocellated turkey)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414167 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414167 "The ocellated turkey (Meleagris ocellata) is a species of turkey residing primarily in the Yucatán Peninsula. A relative of the wild turkey (Meleagris gallopavo), it was sometimes previously treated in a genus of its own (Agriocharis), but the differences between the two turkeys are currently considered too small to justify generic segregation."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414167 <http://eol.org/pages/915307>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414167 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=553897>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414167 langual:B4167)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414167 "meleagris ocellata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414167 "ocellated turkey"@en)
SubClassOf(obo:FOODON_03414167 obo:FOODON_03411236)
SubClassOf(obo:FOODON_03414167 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9101))

