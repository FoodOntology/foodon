AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414873 asfis:flt)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414873 "Monopterus albus"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414873 "rice eel"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414873 "rice-field eel")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414873 "swamp eel")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414873 "white ricefield eel"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414873 "asian swamp eel"@en)
SubClassOf(obo:FOODON_03414873 obo:FOODON_03414872)
SubClassOf(obo:FOODON_03414873 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_43700))

# Class: obo:FOODON_03414874 (characiform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414874 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414874 "An order of ray-finned fish, comprising the characins and their allies. Grouped in 18 recognized families, there are more than two thousand different species, including the well-known piranha and tetras."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414874 wikipedia:Characiformes)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414874 <http://eol.org/pages/6896>)
