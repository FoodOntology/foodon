AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_264416 "Diplotaxis tenuifolia (L.) DC.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_264416 "diplotaxis tenuifolia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_264416 "lincoln's-weed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_264416 "sand mustard"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_264416 "sand rocket"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_264416 "wall rocket"@en)
