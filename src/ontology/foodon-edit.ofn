AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415117 langual:B5117)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415117 "American basil")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415117 "hoary basil")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415117 "lime basil")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415117 "american basil"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415117 "ocimum americanum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415117 "hoary basil plant"@en)
SubClassOf(obo:FOODON_03415117 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415117 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_204141))

