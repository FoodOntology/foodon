# Class: obo:FOODON_03414707 (sedge plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414707 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414707 "The *Cyperaceae* are a family of monocotyledonous graminoid flowering plants known as sedges, which superficially resemble grasses and rushes. The family is large, with some 5,500 known species described in about 90 genera, the largest being the Carex genus of \"true sedges\" with over 2,000 species. [https://en.wikipedia.org/wiki/Cyperaceae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414707 <http://eol.org/pages/8211>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414707 langual:B4707)
AnnotationAssertion(rdfs:label obo:FOODON_03414707 "sedge plant"@en)
SubClassOf(obo:FOODON_03414707 obo:FOODON_03411018)

# Class: obo:FOODON_03414708 (bush onion plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414708 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414708 "Cyperus bulbosus is a species of sedge found across Africa, the Middle East, Indian subcontinent, Southeast Asia, and Australia. In Australia, it is commonly called (Australian) bush onion or \"wild onion\", but is not related to the onion or other *Alliaceae*. It is a component of Australian bushfood, but is considered an agricultural weed in other areas.[https://en.wikipedia.org/wiki/Cyperus_bulbosus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414708 <http://eol.org/pages/29130>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414708 langual:B4708)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414708 "australian bush onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414708 "cyperus bulbosus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414708 "cyperus spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414708 "wild onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414708 "bush onion plant"@en)
SubClassOf(obo:FOODON_03414708 obo:FOODON_03414707)

# Class: obo:FOODON_03414709 (fimbry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414709 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414709 "Fimbristylis is a genus of sedges. A plant in this genus may be known commonly as a fimbry, fimbristyle, or fringe-rush. There are 200 to 300 species distributed worldwide. [https://en.wikipedia.org/wiki/Fimbristylis]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414709 <http://eol.org/pages/29247>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414709 langual:B4709)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414709 "fimbristyle"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414709 "fimbristylis spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414709 "fringe-rush"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414709 "fimbry plant"@en)
SubClassOf(obo:FOODON_03414709 obo:FOODON_03414707)

# Class: obo:FOODON_03414710 (sawsedge plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414710 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414710 "Gahnia (sawsedge, saw-sedge) is a genus of sedges native to China, Southeast Asia, New Guinea, Australia, New Zealand and a number of Pacific Islands. [https://en.wikipedia.org/wiki/Gahnia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414710 <http://eol.org/pages/30068>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414710 langual:B4710)
