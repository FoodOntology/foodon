# Class: <http://purl.obolibrary.org/obo/FOODON_03414695> (caperbush plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414695> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414695> "Capparis is a flowering plant genus in the family *Capparaceae* . These plants are shrubs or lianas and are collectively known as caper shrubs or caperbushes. *Capparis spinosa*, simply known as caper, yields fruit and more importantly flower buds, which are widely used pickled as a vegetable condiment. The fruit of other species, such as karir (*Capparis decidua*), are also used for cooking; *Capparis mitchellii* and the Wild passionfruit (the local subspecies of *Capparis spinosa*) are well-known bush tucker in Australia. Mabinlang seeds (*Capparis masaikai*) are eaten as sweets. [https://en.wikipedia.org/wiki/Capparis]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414695> <http://eol.org/pages/61430>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414695> <http://www.langual.org/langual_thesaurus.asp?termid=B4695>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414695> "capparis"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414695> "caperbush plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414695> <http://purl.obolibrary.org/obo/FOODON_03411179>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414696> (copper laurel plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414696> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414696> "Eupomatia laurina, commonly named Bolwarra or sometimes native guava or copper laurel is a species of shrubs to small trees, of the Australian continent ancient plant family *Eupomatiaceae*. The sweet, aromatic fruit is used as a spice-fruit in cooking, being included in beverages, jams and desserts. It is best used in combination with other ingredients that compliment its strong flavour, and hence should be considered one of the Australian spices. [https://en.wikipedia.org/wiki/Eupomatia_laurina]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414696> <http://eol.org/pages/2497096>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414696> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?415601>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414696> <http://www.langual.org/langual_thesaurus.asp?termid=B4696>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414696> "Eupomatia laurina R. Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414696> "bolwara"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414696> "copper-laurel"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414696> "eupomatia laurina"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414696> "native guava"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414696> "copper laurel plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414696> <http://purl.obolibrary.org/obo/FOODON_03411179>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414697> (scurvy weed plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414697> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414697> "Commelina cyanea, commonly known as scurvy weed, is a perennial prostrate herb of the family *Commelinaceae* native to moist forests and woodlands of eastern Australia, Lord Howe Island and Norfolk Island. The leaves are used as an edible vegetable. The leaves were used by early non-indigenous colonists to alleviate scurvy, and hence its common name. [https://en.wikipedia.org/wiki/Commelina_cyanea]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414697> <http://www.langual.org/langual_thesaurus.asp?termid=B4697>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414697> "Commelinaceae")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414697> "commelina"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414697> "commelina cyanea"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414697> "scurvy weed plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414697> <http://purl.obolibrary.org/obo/FOODON_03411057>)

