AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413434 "cucumis melo flexuosus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413434 "serpent gourd"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413434 "serpent melon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413434 "snake melon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413434 "trichosanthes cucumerina"@en)
