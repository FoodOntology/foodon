AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415076 langual:B5076)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415076 "PLANTS:MASY")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415076 "malva sylvestris"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415076 "common mallow plant"@en)
SubClassOf(obo:FOODON_03415076 obo:FOODON_03413413)
SubClassOf(obo:FOODON_03415076 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_145754))

# Class: obo:FOODON_03415077 (common marshmallow plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415077 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415077 "Althaea officinalis (marsh-mallow, common marshmallow) is a perennial species indigenous to Europe, Western Asia, and North Africa, which is used as a medicinal plant and ornamental plant. A confection made from the root since ancient Egyptian time evolved into today's marshmallow treat. [https://en.wikipedia.org/wiki/Althaea_officinalis]"@en)
