SubClassOf(obo:FOODON_03411155 obo:FOODON_03411598)

# Class: obo:FOODON_03411156 (pod or seed vegetable plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411156 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411156 "A legume  is a plant or its fruit or seed in the family *Fabaceae* (or *Leguminosae*). Legumes are grown agriculturally, primarily for their grain seed called pulse, for livestock forage and silage, and as soil-enhancing green manure. Well-known legumes include alfalfa, clover, peas, beans, chickpeas, lentils, lupin bean, mesquite, carob, soybeans, peanuts and tamarind. [https://en.wikipedia.org/wiki/Legume]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411156 <http://eol.org/pages/4277>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411156 langual:B1156)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411156 "fabaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411156 "pod or seed vegetable plant"@en)
SubClassOf(obo:FOODON_03411156 obo:FOODON_03411057)

# Class: obo:FOODON_03411157 (fish, gadiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411157 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411157 "Gadiformes are an order of ray-finned fish, also called the Anacanthini, that includes the cod and its allies. Many major food fish are in this order. They are found in marine waters throughout the world and the vast majority of the species are found in temperate or colder regions (tropical species are typically deep-water). A few species may enter estuaries but only one, the burbot (*Lota lota*), is a freshwater fish. [https://en.wikipedia.org/wiki/Gadiformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411157 <http://eol.org/pages/5496>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411157 langual:B1157)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411157 "gadiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411157 "fish, gadiform"@en)
SubClassOf(obo:FOODON_03411157 obo:FOODON_03411365)

# Class: obo:FOODON_03411159 (ribes berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411159 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411159 "Ribes is a genus of about 150 species of flowering plants native throughout the temperate regions of the Northern Hemisphere. It is usually treated as the only genus in the family *Grossulariaceae*. Seven subgenera are recognized."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411159 "WIKIPEDIA:Ribes")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411159 <http://eol.org/pages/38348>)
