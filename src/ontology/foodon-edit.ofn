AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414178 "Phallus duplicatus Bosc, 1811")
AnnotationAssertion(rdfs:comment obo:FOODON_03414178 "A species of fungus in the stinkhorn family. The bell-shaped to oval cap is green-brown, the cylindrical stalk is white.

When mature the cap becomes sticky with a slimy green coating that attracts flies that disperse its spores, and it has a distinct, \"netted\" universal veil. The fungus is edible when still in the \"egg\" stage, before the fruit body has expanded. It grows often in public lawns, and can also be found in meadows. [Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414179 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414179 wikipedia:Xerula_radicata)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414179 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=325611>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414179 langual:B4179)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414179 "Hymenopellis radicata"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414179 "Oudemansiella radicata"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414179 "Xerula radicata (Relhan) Dörfelt, 1975")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414179 "tsuetake"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414179 "xerula radicata"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414179 "A widespread Agaric mushroom readily identified by its deeply rooted stalk (stipe)."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414180 obo:IAO_0000122)
