# Class: obo:NCBITaxon_8790 (Dromaius novaehollandiae)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8790 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8790 "The Emu, *Dromaius novaehollandiae*, is the largest bird native to Australia and the only extant member of the genus *Dromaius*. It is the second-largest extant bird in the world by height, after its ratite relative, the ostrich. There are three subspecies of Emus in Australia. The Emu is common over most of mainland Australia, although it avoids heavily populated areas, dense forest, and arid areas."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8790 "emu"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8790 "WIKIPEDIA:Dromaius_novaehollandiae")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8790 <http://eol.org/pages/1178369>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8790 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=174385>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8790 langual:B2719)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8790 "Dromaius novaehollandiae (Latham, 1790)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8790 "dromaius novaehollandiae"@en)
SubClassOf(obo:NCBITaxon_8790 obo:FOODON_03414362)

# Class: obo:NCBITaxon_8795 (Rhea pennata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8795 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8795 "Darwin's rhea (*Rhea pennata*), also known as the lesser rhea, is a large flightless bird, but the smaller of the two extant species of rheas. It is found in the Altiplano and Patagonia in South America."@en)
