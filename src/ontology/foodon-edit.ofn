AnnotationAssertion(go:hasDbXref obo:FOODON_03411662 "MANSFELD:9338")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411662 "Prunus domestica subsp. insititia (L.) C. K. Schneid.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411662 "bullace"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411662 "prunus domestica insititia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411662 "prunus insititia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411662 "damson plum plant"@en)
SubClassOf(obo:FOODON_03411662 obo:FOODON_03411206)

