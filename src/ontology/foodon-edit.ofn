AnnotationAssertion(go:hasDbXref obo:NCBITaxon_88728 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=822554>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_88728 langual:B5031)
