# Class: obo:FOODON_03414864 (bagrid catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414864 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414864 "The *Bagridae* are a family of catfish that are native to Africa (*Bagrus*) and Asia (all other genera) from Japan to Borneo. It includes about 245 species. These fish are commonly known as naked catfishes or bagrid catfishes. Large bagrids are important as food fish. Some species are kept as aquarium fishes. [https://en.wikipedia.org/wiki/Bagridae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414864 <http://eol.org/pages/5110>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414864 langual:B4864)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414864 "bagridae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414864 "naked catfish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414864 "bagrid catfish"@en)
SubClassOf(obo:FOODON_03414864 obo:FOODON_03411598)

# Class: obo:FOODON_03414865 (longsnout catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414865 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414865 "A genus of bagrid catfishes found mostly in Southeast Asia with some species occurring in China. This genus has a confused taxonomy and there is uncertainty surrounding the number of valid species. The members of Leiocassis have an elongate narrow head and a prominently protruding snout."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414865 wikipedia:Leiocassis)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414865 <http://eol.org/pages/5110>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414865 langual:B4865)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414865 "Leiocassis"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414865 "Leiocassis Bleeker, 1857")
AnnotationAssertion(rdfs:label obo:FOODON_03414865 "longsnout catfish"@en)
SubClassOf(obo:FOODON_03414865 obo:FOODON_03414864)

# Class: obo:FOODON_03414867 (sorubim catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414867 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414867 "A genus of several South American catfish species of family Pimelodidae. The species are known by a number of different common names. They typically inhabit major rivers where they prefer the main channels and tend to stay at maximum depth, but some species can also be seen in lakes, flooded forests, and other freshwater habitats. They have robust bodies, and are important food fish."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414867 wikipedia:Pseudoplatystoma)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414867 <http://eol.org/pages/5091>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414867 langual:B4867)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414867 "Pseudoplatystoma"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414867 "Pseudoplatystoma Bleeker, 1862")
AnnotationAssertion(rdfs:label obo:FOODON_03414867 "sorubim catfish"@en)
SubClassOf(obo:FOODON_03414867 obo:FOODON_03411969)

# Class: obo:FOODON_03414872 (fish, synbranchiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414872 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414872 "Synbranchiformes is an order of ray-finned fishes that are eel-like but have spiny rays, indicating that they belong to the superorder *Acanthopterygii*. There are two suborders: *Synbranchoidei* and *Mastacembeloidei*, or *Opisthomi*. The *Synbranchoidei* has one family, the *Synbranchidae*, four genera, and 17 species. The *Mastacembeloidei* has two families: *Chaudhuriidae*, with four genera and five species, and *Mastacembelidae*, with three genera and about 26 species."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414872 wikipedia:Synbranchiformes)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414872 <http://eol.org/pages/5070>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414872 langual:B4872)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414872 "swamp eel"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414872 "chaudhuriidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414872 "mastacembelidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414872 "synbranchidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414872 "fish, synbranchiform"@en)
SubClassOf(obo:FOODON_03414872 obo:FOODON_03411365)

# Class: obo:FOODON_03414874 (fish, characiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414874 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414874 "An order of ray-finned fish, comprising the characins and their allies. Grouped in 18 recognized families, there are more than two thousand different species, including the well-known piranha and tetras."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414874 wikipedia:Characiformes)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414874 <http://eol.org/pages/6896>)
