AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414499 "PLANTS:RUAR6")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414499 "rumex arcticus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414499 "sourdock"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414499 "arctic dock plant"@en)
SubClassOf(obo:FOODON_03414499 obo:FOODON_03411641)
SubClassOf(obo:FOODON_03414499 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_395311))

# Class: obo:FOODON_03414500 (ground squirrel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414500 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414500 "Spermophilus is a genus of ground squirrels in the family *Sciuridae*. The majority of ground squirrel species, over 40 in total, are usually placed in this genus. However, *Spermophilus* in the broad sense has been found to be paraphyletic to the certainly distinct prairie dogs, marmots, and antelope squirrels, so it has been split into several genera by Kristofer Helgen and colleagues."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414500 "WIKIPEDIA:Spermophilus")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414500 <http://eol.org/pages/15104>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414500 langual:B4500)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414500 "spermophilus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414500 "ground squirrel"@en)
SubClassOf(obo:FOODON_03414500 obo:FOODON_03411389)

# Class: obo:FOODON_03414501 (arctic ground squirrel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414501 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414501 "The Arctic ground squirrel (*Urocitellus parryii*) is a species of ground squirrel native to the Arctic. People in Alaska, particularly around the Aleutians, refer to them as \"Parka\" (pronounced \"par'kee\") squirrels. probably because their pelt is good for making the fur edging on the hoods of Parka style jackets."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414501 "WIKIPEDIA:Spermophilus_parryii")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414501 <http://eol.org/pages/8703>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414501 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180146>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414501 langual:B4501)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414501 "Spermophilus parryii (Richardson, 1825)")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414501 "spermophilus parryii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414501 "urocitellus parryii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414501 "arctic ground squirrel"@en)
SubClassOf(obo:FOODON_03414501 obo:FOODON_03414500)

# Class: obo:FOODON_03414502 (tealeaf willow plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414502 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414502 "A species of flowering plant in the willow family, it is native to northern North America, where it occurs in Alaska, Yukon, the Northwest Territories, and Nunavut. The species is also found in northern British Columbia, and occurs in Russia."@en)
