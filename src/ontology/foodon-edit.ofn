# Class: obo:FOODON_03414819 (kangaroo vine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414819 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414819 "Cissus antarctica (synonym *Cissus oblongata*), called \"kangaroo vine\", is one of the best known species of the genus *Cissus* in the family of *Vitaceae*. It is a climbing plant, a vine, and comes from Australia.[https://en.wikipedia.org/wiki/Cissus_antarctica]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414819 <http://eol.org/pages/4382>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414819 langual:B4819)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414819 "USDA PLANTS:CIAN3")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414819 "Cissus antarctica Venten")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414819 "cissus antarctica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414819 "cissus oblongata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414819 "kangaroo ivy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414819 "kangaroo vine plant"@en)
SubClassOf(obo:FOODON_03414819 obo:FOODON_03414650)

# Class: obo:FOODON_03414820 (giant water vine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414820 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414820 "Cissus hypoglauca is a common Australian vine. It is one of the better known climbing plants of the genus *Cissus* in the grape family. A very common climber in moist areas of eastern Australia, it often colonises large areas after forest damage due to storms, fire or logging. Common names include jungle grape, water vine, giant water vine, five-leaf water vine, jungle vine, native grapes and billangai [https://en.wikipedia.org/wiki/Cissus_hypoglauca]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414820 <http://eol.org/pages/4382>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414820 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10614>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414820 langual:B4820)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414820 "Cissus hypoglauca A. Gray")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414820 "cissus hypoglauca"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414820 "giant water vine plant"@en)
SubClassOf(obo:FOODON_03414820 obo:FOODON_03414650)

