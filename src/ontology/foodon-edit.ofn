AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412793 "PLANTS:QUAM")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412793 "Amargo")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412793 "Quassia Wood")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412793 "mafourere"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412793 "quassia amara"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412793 "quassia-wood"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412793 "surinam quassia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412793 "bitterwood plant"@en)
SubClassOf(obo:FOODON_03412793 obo:FOODON_03411024)
