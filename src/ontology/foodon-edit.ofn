AnnotationAssertion(go:hasDbXref obo:FOODON_03412214 "CEC1993:1287")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03412214 "Portunus trituberculatus (Miers 1876)")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03412214 "Portunus trituberculatus (Miers, 1876)")
