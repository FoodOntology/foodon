AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510204 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510204 langual:P0204)
AnnotationAssertion(rdfs:comment obo:FOODON_03510204 "LanguaL curation note: A claim that a food is a natural source of vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 15% of the recommended daily allowance specified in the Annex of Council Directive 90/496/EEC per 100 g or 100 ml."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510204 "natural source of vitamins and or minerals claim"@en)
SubClassOf(obo:FOODON_03510204 obo:FOODON_03510210)

# Class: obo:FOODON_03510205 (source of fibre)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510205 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510205 "A claim that a food is a source of fibre, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 3 g of fibre per 100 g or at least 1,5 g of fibre per 100 kcal [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510205 langual:P0205)
AnnotationAssertion(rdfs:label obo:FOODON_03510205 "source of fibre"@en)
SubClassOf(obo:FOODON_03510205 obo:FOODON_03510049)

# Class: obo:FOODON_03510206 (source of protein)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510206 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510206 "A claim that a food is a source of protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 12 % of the energy value of the food is provided by protein. [REGULATION (EC) No 1924/2006 Corrigendum]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510206 langual:P0206)
AnnotationAssertion(rdfs:label obo:FOODON_03510206 "source of protein"@en)
SubClassOf(obo:FOODON_03510206 obo:FOODON_03510202)

# Class: obo:FOODON_03510207 (contains {name of the nutrient or other substance} nutrition claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510207 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510207 "A claim that a food contains a nutrient or another substance, for which specific conditions are not laid down in this Regulation, or any claim likely to have the same meaning for the consumer, may only be made where the product complies with all the applicable provisions of this Regulation, and in particular Article 5. For vitamins and minerals the conditions of the claim \"source of\" shall apply. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510207 langual:P0207)
AnnotationAssertion(rdfs:comment obo:FOODON_03510207 "LanguaL curation note: Used for claims like \"contains [name of the nutrient or other substance]\"."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03510207 "contains {name of the nutrient or other substance} nutrition claim"@en)
SubClassOf(obo:FOODON_03510207 obo:FOODON_03510095)

# Class: obo:FOODON_03510208 (increased {name of nutrient} nutrition claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510208 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510208 "A claim stating that the content in one or more nutrients, other than vitamins and minerals, has been increased, and any claim likely to have the same meaning for the consumer, may only be made where the product meets the conditions for the claim \"source of\" and the increase in content is at least 30 % compared to a similar product. [Forordning (EF) nr. 1924/2006 Berigtigelse 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510208 langual:P0208)
AnnotationAssertion(rdfs:label obo:FOODON_03510208 "increased {name of nutrient} nutrition claim"@en)
SubClassOf(obo:FOODON_03510208 obo:FOODON_03510095)

# Class: obo:FOODON_03510209 ("naturally/natural" label claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510209 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510209 "Where a food naturally meets the condition(s) laid down in this Annex for the use of a nutritional claim, the term \"naturally/natural\" may be used as a prefix to the claim [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510209 langual:P0209)
AnnotationAssertion(rdfs:label obo:FOODON_03510209 "\"naturally/natural\" label claim"@en)
SubClassOf(obo:FOODON_03510209 obo:FOODON_03510059)

# Class: obo:FOODON_03510210 (source of {name of vitamin/s}  and/or {name of mineral/s} nutrition claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510210 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510210 "A claim that a food is a source of vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least a significant amount as defined in the Annex to Directive 90/496/EEC or an amount provided for by derogations granted according to Article 6 of Regulation (EC) No 1925/2006 of the European Parliament and of the Council of 20 December 2006 on the addition of vitamins and minerals and of certain other substances to foods [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510210 langual:P0210)
AnnotationAssertion(rdfs:label obo:FOODON_03510210 "source of {name of vitamin/s}  and/or {name of mineral/s} nutrition claim"@en)
SubClassOf(obo:FOODON_03510210 obo:FOODON_03510095)

# Class: obo:FOODON_03510211 (high {name of vitamin/s} and/or {name of mineral/s} nutrition claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510211 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510211 "A claim that a food is high in vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least twice the value of \"source of [NAME OF VITAMIN/S] and/or [NAME OF MINERAL/S]\" [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510211 langual:P0211)
AnnotationAssertion(rdfs:label obo:FOODON_03510211 "high {name of vitamin/s} and/or {name of mineral/s} nutrition claim"@en)
SubClassOf(obo:FOODON_03510211 obo:FOODON_03510095)

# Class: obo:FOODON_03510212 (reduced {name of nutrient} nutrition claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510212 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03510212 "A claim stating that the content in one or more nutrients has been reduced, and any claim likely to have the same meaning for the consumer, may only be made where the reduction in content is at least 30 % compared to a similar product, except for micronutrients, where a 10 % difference in the reference values as set in Directive 90/496/EEC shall be acceptable, and for sodium, or the equivalent value for salt, where a 25 % difference shall be acceptable. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18]."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03510212 langual:P0212)
AnnotationAssertion(rdfs:label obo:FOODON_03510212 "reduced {name of nutrient} nutrition claim"@en)
SubClassOf(obo:FOODON_03510212 obo:FOODON_03510095)

