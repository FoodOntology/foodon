AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412942 "MANSFELD:31979")
AnnotationAssertion(rdfs:label obo:FOODON_03412942 "broadleaved endive plant"@en)
SubClassOf(obo:FOODON_03412942 obo:NCBITaxon_114280)

