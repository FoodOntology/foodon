# Class: obo:FOODON_03411898 (bergamot orange plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411898 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411898 "Citrus bergamia, the bergamot orange, is a fragrant citrus fruit the size of an orange, with a yellow or green color similar to a lime, depending on ripeness. 
 The fruit of the bergamot orange is edible.An essence extracted from the aromatic skin of this sour fruit is used to flavour Earl Grey and Lady Grey teas, as well as confectionery (including Turkish delight). It is often used to make marmalade, particularly in Italy. [https://en.wikipedia.org/wiki/Bergamot_orange]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 <http://eol.org/pages/4414>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10698>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=524859>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 langual:B1898)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 "MANSFELD:7666")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411898 "PLANTS:CIAUB")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411898 "Citrus aurantium ssp. bergamia (Risso & Poit.) Wight & Arn. ex Engler")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411898 "Citrus bergamia Risso & Poit.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411898 "Citrus ×aurantium L. ssp. bergamia (Risso & Poit.) Wight & Arn. ex Engl.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411898 "citrus aurantium bergamia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411898 "citrus bergamia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411898 "citrus ×aurantium"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411898 "bergamot orange plant"@en)
SubClassOf(obo:FOODON_03411898 obo:FOODON_03411193)

# Class: obo:FOODON_03411901 (labyrinth catfish family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411901 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411901 "Airbreathing catfishes are fishes comprising the family *Clariidae* of order Siluriformes. About 14 genera and about 116 species of clariids are described. All the clariids are freshwater species. [https://en.wikipedia.org/wiki/Airbreathing_catfish]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411901 <http://eol.org/pages/5106>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411901 langual:B1901)
