AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43700 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=166697>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43700 langual:B4873)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_43700 asfis:flt)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_43700 "Monopterus albus"@en)
