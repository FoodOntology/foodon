AnnotationAssertion(go:hasDbXref obo:NCBITaxon_7962 asfis:fcp)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_7962 "CEC1993:326")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_7962 "Cyprinus carpio")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_7962 "chub (carp)"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_7962 "cyprinus carpio"@en)
