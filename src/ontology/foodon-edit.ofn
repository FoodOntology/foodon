# Class: <http://purl.obolibrary.org/obo/FOODON_00002457> (food (fresh))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_00002457> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002457> "Fresh food is food that has not been subjected to food preservation processes (including freezing) that alter its harvested state significantly."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00002457> "Damion Dooley"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_00002457> "https://en.wikipedia.org/wiki/Fresh_food"^^xsd:anyURI)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_00002457> "Wikipedia defines fresh food as:\"food which has not been preserved and has not spoiled yet. For vegetables and fruits, this means that they have been recently harvested and treated properly postharvest; for meat, it has recently been slaughtered and butchered; for fish, it has been recently caught or harvested and kept cold.\""@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002457> "food (fresh)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002457> <http://purl.obolibrary.org/obo/FOODON_03311126>)

