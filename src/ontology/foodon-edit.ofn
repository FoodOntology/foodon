SubClassOf(obo:FOODON_03414277 obo:FOODON_02020805)

# Class: obo:FOODON_03414278 (swamp taro plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414278 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414278 "Iaraj (*Cyrtosperma chamissonis - Araceae*). This large, cultivated \"hard\" or \"swamp\" taro has been a very important starchy, staple food source. It reaches heights up to 4-6 m (15-20 ft) and produces huge green to yellowish-green, heart-shaped leaves with tips that point upward.
 Iaraj is an aroid \"root crop\" species probably native to Southeast Asia or wetern Melanesia. Early settlers brought it by canoe to many islands of the tropical Pacific, including the Marshall Islands, in prehistoric times.[http://www.hawaii.edu/cpis/MI/plants/iaraj.html]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414278 <http://eol.org/pages/8191>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414278 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506753>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414278 langual:B4278)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414278 "PLANTS:CYCH7")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414278 "Cyrtosperma chamissonis (Schott) Merr.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414278 "cyrtosperma chamissonis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414278 "swamp taro plant"@en)
SubClassOf(obo:FOODON_03414278 obo:FOODON_03411018)

# Class: obo:FOODON_03414279 (pulaka plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414279 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414279 "Pulaka (*Cyrtosperma merkusii*), or swamp taro, is a crop grown in Oceania (especially Tuvalu) and an important source of carbohydrates for the area's inhabitants. It is a \"swamp crop\" similar to taro, but \"with bigger leaves and larger, coarser roots.\" Pulaka roots need to be cooked for hours to reduce toxicity in the corms, but are rich in nutrients, especially calcium. Pulaka is an important part of Tuvalu cultural and culinary tradition, now under threat from rising sea level and displacement from the growing use of imported food products."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414279 <http://eol.org/pages/1094951>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414279 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12943>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414279 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506754>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414279 langual:B4279)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414279 "PLANTS:CYME10")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414279 "giant swamp taro")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414279 "cyrtosperma merkusii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414279 "giant swamp taro"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414279 "pulaka plant"@en)
SubClassOf(obo:FOODON_03414279 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03414279 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_39292))

