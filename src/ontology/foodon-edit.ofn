AnnotationAssertion(go:hasDbXref obo:FOODON_03411552 "MANSFELD:31967")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411552 "PLANTS:CIIN")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411552 "Cichorium intybus L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411552 "belgian endive"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411552 "cichorium intybus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411552 "monk's beard"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411552 "witloof chicory"@en)
