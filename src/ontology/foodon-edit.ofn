AnnotationAssertion(go:hasDbXref obo:FOODON_03415057 "PLANTS:RUAR")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415057 "Rubus arcticus L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415057 "arctic blackberry"@en)
