# Class: obo:NCBITaxon_4120 (Ipomoea batatas)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_4120 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_4120 "The sweet potato (*Ipomoea batatas*) is a dicotyledonous plant that belongs to the bindweed or morning glory family, *Convolvulaceae*. Its large, starchy, sweet-tasting, tuberous roots are a root vegetable. The young leaves and shoots are sometimes eaten as greens. The sweet potato is only distantly related to the potato (*Solanum tuberosum*) and does not belong to the nightshade family, *Solanaceae*, but both families belong to the same taxonomic order, the Solanales.[https://en.wikipedia.org/wiki/Sweet_potato]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_4120 "sweet potato plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 <http://eol.org/pages/580962>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20142>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=30764>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 langual:B1106)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 "MANSFELD:21565")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4120 "PLANTS:IPBA2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4120 "Ipomoea batatas (L.) Lam.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4120 "Ipomoea batatas (L.) Poiret")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4120 "ipomoea batatas"@en)
SubClassOf(obo:NCBITaxon_4120 obo:FOODON_03411018)
SubClassOf(obo:NCBITaxon_4120 obo:FOODON_03414741)

