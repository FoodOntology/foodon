# Class: obo:NCBITaxon_9014 (Colinus virginianus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9014 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9014 "The Northern Bobwhite, Virginia Quail or (in its home range) Bobwhite Quail (*Colinus virginianus*) is a ground-dwelling bird native to the United States, Mexico, and the Caribbean. It is a member of the group of species known as New World quails (*Odontophoridae*). They were initially placed with the Old World quails in the pheasant family (*Phasianidae*), but are not particularly closely related. The name \"bobwhite\" derives from its characteristic whistling call."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9014 "northern bobwhite"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9014 "WIKIPEDIA:Bobwhite_Quail")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9014 <http://eol.org/pages/1049187>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9014 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175863>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9014 langual:B4364)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9014 "Colinus virginianus (Linnaeus, 1758)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9014 "bobwhite quail"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9014 "colinus virginianus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9014 "virginia quail"@en)
SubClassOf(obo:NCBITaxon_9014 obo:FOODON_03411346)

# Class: obo:NCBITaxon_90675 (Camelina sativa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_90675 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_90675 "*Camelina sativa*, usually known in English as camelina, gold-of-pleasure, or false flax, also occasionally wild flax, linseed dodder, German sesame, and Siberian oilseed, is a flowering plant in the family *Brassicaceae*. It has been traditionally cultivated as an oilseed crop to produce vegetable oil and animal feed. The crop is now being researched due to its exceptionally high levels (up to 45%) of omega-3 fatty acids, which is uncommon in vegetable sources."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_90675 "gold-of-pleasure plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_90675 "WIKIPEDIA:Camelina_sativa")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 <http://eol.org/pages/584191>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8700>)
