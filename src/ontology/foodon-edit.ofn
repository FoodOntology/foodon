AnnotationAssertion(go:hasSynonym obo:NCBITaxon_54703 "woodland angelica"@en)
SubClassOf(obo:NCBITaxon_54703 obo:FOODON_03411377)

# Class: obo:NCBITaxon_548163 (obo:NCBITaxon_548163)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_548163 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_548163 "The smooth leatherjacket or velvet leatherjacket, *Meuschenia scaber*, is a filefish of the family *Monacanthidae*, found off eastern Australia and all around New Zealand to depths of about 100 m, on rocky weedy reef areas. Its length is between 25 and 35 cm. In New Zealand it is simply known as leatherjacket as it is the only fish of this family commonly found there."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_548163 "velvet leatherjacket"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_548163 "WIKIPEDIA:Velvet_Leatherjacket")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_548163 <http://eol.org/pages/217899>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_548163 langual:B4290)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_548163 asfis:pkb)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_548163 <https://www.frdc.com.au/knowledge-hub/standards/37465005>)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_548163 "Meuschenia scaber")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_548163 "Parika scaber (Forster, 1801)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_548163 "meuschenia scaber"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_548163 "new zealand leatherjacket"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_548163 "parika scaber"@en)
SubClassOf(obo:NCBITaxon_548163 obo:FOODON_03412132)

# Class: obo:NCBITaxon_54904 (Hiodon alosoides)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_54904 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_54904 "The goldeye, *Hiodon alosoides*, is a species of fish in the mooneye family (Hiodontidae). It occurs from as far down the Mackenzie River as Aklavik in the north to Mississippi in the south, and from Alberta in the west to Ohio south of the Great Lakes, with an isolated population south of James Bay. It is notable for a conspicuous golden iris in the eyes."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_54904 "goldeye"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_54904 "WIKIPEDIA:Goldeye")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_54904 <http://eol.org/pages/994821>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_54904 langual:B4561)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_54904 "Hiodon alosoides")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_54904 "laquaiche aux yeux d'or"@en)
SubClassOf(obo:NCBITaxon_54904 obo:FOODON_03414560)

