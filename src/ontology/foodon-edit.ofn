# Class: <http://purl.obolibrary.org/obo/FOODON_03460850> (Glucuronolactone)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03460850> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03460850> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460850> "Glucuronolactone is a naturally occurring substance that is an important structural component of nearly all connective tissues. Glucuronolactone is also found in many plant gums."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/FOODON_03460850> "d-glucurono-gamma-lactone"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03460850> "https://en.wikipedia.org/wiki/Glucuronolactone"^^xsd:anyURI)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460850> <http://www.langual.org/langual_thesaurus.asp?termid=H0850>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460850> "Glucuronolactone"@en)
