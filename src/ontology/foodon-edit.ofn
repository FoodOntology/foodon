AnnotationAssertion(go:hasDbXref obo:FOODON_03411377 "MANSFELD:1655")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411377 "PLANTS:ANGEL")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411377 "Angelica")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411377 "Angelica L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411377 "Angelica archangelica L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411377 "Angelica spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411377 "angelica archangelica"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411377 "angelica spp"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411377 "angelica plant"@en)
