# Class: obo:FOODON_00002557 (black pudding)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002557 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002557 "Black pudding is a type of blood sausage originating in Great Britain and Ireland. It is made from pork blood, with pork fat or beef suet, and a cereal, usually oatmeal, oat groats or barley groats. The high proportion of cereal, along with the use of certain herbs such as pennyroyal, serves to distinguish black pudding from blood sausages eaten in other parts of the world."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002557 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002557 "https://en.wikipedia.org/wiki/Black_pudding"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002557 "2019-04-09T14:05:09Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002557 "black pudding"@en)
SubClassOf(obo:FOODON_00002557 obo:FOODON_03316919)

# Class: obo:FOODON_00002559 (Red Delicious apple tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002559 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002559 "The Red Delicious is a clone of apple cultigen, now comprising more than 50 cultivars, first recognized in Madison County, Iowa, in 1880"@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002559 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002559 "https://en.wikipedia.org/wiki/Red_Delicious"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002559 "2019-04-13T16:47:39Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002559 "Red Delicious apple tree"@en)
SubClassOf(obo:FOODON_00002559 obo:FOODON_03411245)

