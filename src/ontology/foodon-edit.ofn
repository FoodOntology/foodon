# Class: obo:FOODON_03415091 (cowslip plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415091 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415091 "Primula veris (cowslip, common cowslip, cowslip primrose; syn. *Primula officinalis* Hill) is a herbaceous perennial flowering plant in the primrose family *Primulaceae*. Cowslip leaves have been traditionally used in Spanish cooking as a salad green. Uses in English cookery include using the flowers to flavor country wine and vinegars; sugaring to be a sweet or eaten as part of a composed salad [https://en.wikipedia.org/wiki/Primula_veris]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415091 <http://eol.org/pages/584034>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415091 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?400303>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415091 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24035>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415091 langual:B5091)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415091 "PLANTS:PRVE2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415091 "cowslip")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415091 "primula officinalis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415091 "primula veris"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415091 "cowslip plant"@en)
SubClassOf(obo:FOODON_03415091 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03415091 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_170927))

# Class: obo:FOODON_03415092 (siberian ginseng plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415092 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415092 "Eleutherococcus senticosus is a species of small, woody shrub in the family Araliaceae native to Northeastern Asia.  *E. senticosus* has a history of use in folklore and traditional Chinese medicine. Root extracts of E. senticosus are sold as a dietary supplement or cosmetic, usually under the name Siberian ginseng. [https://en.wikipedia.org/wiki/Eleutherococcus_senticosus]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415092 <http://eol.org/pages/1145576>)
