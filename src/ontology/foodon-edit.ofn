AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415172 langual:B5172)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415172 "PLANTS:QUSA4")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415172 "quillaja saponaria"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415172 "soap-bark tree"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415172 "soapbark plant"@en)
SubClassOf(obo:FOODON_03415172 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415172 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32244))

# Class: obo:FOODON_03415173 (european goldenrod plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415173 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415173 "Solidago virgaurea (European goldenrod or woundwort) is an herbaceous perennial plant of the family *Asteraceae*. This plant was cultivated in the Arab world, who used it in their medical system. In the fifteenth and sixteenth centuries it was used in Europe to heal wounds. It has astringent, diuretic, antiseptic and other properties. [https://en.wikipedia.org/wiki/Solidago_virgaurea]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415173 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?34927>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415173 langual:B5173)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415173 "Solidago virgaurea L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415173 "solidago virgaurea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415173 "european goldenrod plant"@en)
SubClassOf(obo:FOODON_03415173 obo:FOODON_03413359)

# Class: obo:FOODON_03415174 (uzazi fruit)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415174 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415174 "The term Uziza refers to the dried fruit of the West African deciduous shrub *Zanthoxylum tessmannii* (syn.), syn. *Fagara tessmannii*, a member of the 'prickly ash' *Zanthoxylum* family. [https://en.wikipedia.org/wiki/Uzazi] 
 *Zanthoxylum gilletii*, the East African satin wood, is a tree species in the genus *Zanthoxylum* found in Africa. The fruits are used to produce the spice uzazi. [https://en.wikipedia.org/wiki/Zanthoxylum_gilletii]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415174 <http://eol.org/pages/4414>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415174 langual:B5174)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415174 "fagara tessmannii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415174 "zanthoxylum gilletii"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415174 "zanthoxylum tessmannii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415174 "uzazi fruit"@en)
SubClassOf(obo:FOODON_03415174 obo:FOODON_03412295)

# Class: obo:FOODON_03415175 (chinese white pear plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415175 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415175 "Pyrus × bretschneideri (or *Pyrus ×bretschneideri*), the ya pear or pearple or Chinese white pear, is an interspecific hybrid species of pear native to North China, where it is widely grown for its edible fruit. 
 Along with cultivars of *P. pyrifolia* and *P. ussuriensis*, the fruit is also called the nashi pear. These very juicy, white to light yellow pears, unlike the round Nashi pears (*P. pyrifolia*) that are also grown in eastern Asia, are shaped more like the European pear (*Pyrus communis*), narrow towards the stem end. [https://en.wikipedia.org/wiki/Pyrus_×_bretschneideri]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415175 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30462>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415175 langual:B5175)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415175 "Pyrus x bretschneideri Rehder")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415175 "pyrus x bretschneideri"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415175 "ya pear"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415175 "chinese white pear plant"@en)
SubClassOf(obo:FOODON_03415175 obo:FOODON_03411344)

# Class: obo:FOODON_03415176 (dracontomelon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415176 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415176 "Dracontomelon is a genus of flowering plants in the family *Anacardiaceae*. The most commonly eaten species is *Dracontomelon duperreanum*, which produces an edible fruit that is eaten in Cambodia, Vietnam and China. [https://en.wikipedia.org/wiki/Dracontomelon]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415176 <http://eol.org/pages/61091>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415176 langual:B5176)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415176 "dracontomelon spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415176 "dracontomelon plant"@en)
SubClassOf(obo:FOODON_03415176 obo:FOODON_03413387)

# Class: obo:FOODON_03415177 (actinidia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415177 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415177 "A plant of the genus Actinidia."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415177 <http://eol.org/pages/49128>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415177 langual:B5177)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415177 "MANSFELD:26714")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415177 "actinidia spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415177 "kiwifruit"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03415177 "\"The fruit is a large berry containing numerous small seeds; in most species, the fruit is edible. In particular, this genus is known for the species *Actinidia deliciosa*, the kiwifruit or Chinese gooseberry, and for the hardy ornamental Actinidia kolomikta. [...] 
Kiwifruit (often abbreviated as kiwi) or Chinese gooseberry is the edible berry of several species of woody vines in the genus *Actinidia*. The most common cultivar group of kiwifruit is oval, about the size of a large hen's egg. It has a fibrous, dull greenish-brown skin and bright green or golden flesh with rows of tiny, black, edible seeds. [...] 
The most common kiwifruit is the fuzzy kiwifruit, from the species *Actinidia deliciosa*. Other species that are commonly eaten include golden kiwifruit (*Actinidia chinensis*), Chinese egg gooseberry (*Actinidia coriacea*), hardy kiwifruit (*Actinidia arguta*), Arctic kiwifruit (*Actinidia kolomikta*), purple kiwifruit (*Actinidia melanandra*), silver vine (*Actinidia polygama*), hearty red kiwifruit (*Actinidia purpurea*).\" - https://en.wikipedia.org/wiki/Kiwifruit"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415177 "actinidia plant"@en)
SubClassOf(obo:FOODON_03415177 obo:FOODON_03411231)

# Class: obo:FOODON_03415178 (kiwifruit plant (A. deliciosa))

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415178 "Actinidia deliciosa, fuzzy kiwifruit or mangüeyo is a fruiting vine native to southern China, the fruit of which has been declared the national fruit of that country."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415178 "Chinese gooseberry")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415178 "kiwifruit")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415178 "chinese gooseberry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415178 "fuzzy kiwifruit"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415178 "kiwi"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415178 "strawberry peach"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415178 "kiwifruit plant (A. deliciosa)"@en)
SubClassOf(obo:FOODON_03415178 obo:FOODON_03415177)
SubClassOf(obo:FOODON_03415178 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3627))

# Class: obo:FOODON_03415179 (tarovine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415179 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415179 "Monstera deliciosa is a species of flowering plant native to tropical forests of southern Mexico. Common names include fruit salad plant, fruit salad tree (in reference to its edible fruit, which tastes similar to a fruit salad), ceriman, Swiss cheese plant (or just cheese plant), monster fruit, monsterio delicio, monstereo, Mexican breadfruit, windowleaf, balazo, and Penglai banana. 
 The fruit of *Monstera deliciosa* is up to 25 cm long and 3-4 cm diameter, looking like a green ear of maize covered with hexagonal scales.
[https://en.wikipedia.org/wiki/Monstera_deliciosa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415179 <http://eol.org/pages/1138107>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415179 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24556>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415179 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503872>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415179 langual:B5179)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415179 "PLANTS:MODE")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415179 "Swiss cheese plant")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415179 "cut-leaf-philodendron")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415179 "tarovine")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415179 "mexican-breadfruit"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415179 "monstera deliciosa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415179 "tarovine plant"@en)
SubClassOf(obo:FOODON_03415179 obo:FOODON_03413391)
SubClassOf(obo:FOODON_03415179 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_174217))

# Class: obo:FOODON_03415180 (saguaro plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415180 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415180 "The saguaro (*Carnegiea gigantea*) is an arborescent (tree-like) cactus species in the monotypic genus *Carnegiea*, which can grow to be over 40 feet (12 m) tall. It is native to the Sonoran Desert in Arizona, the Mexican State of Sonora, and the Whipple Mountains and Imperial County areas of California. 
 The ruby red fruits are 2.4 to 3.5 inches (6 to 9 cm) long and ripen in June. Each fruit contains around 2,000 seeds plus sweet fleshy connective tissue. The fruits are edible and prized by local people. [https://en.wikipedia.org/wiki/Saguaro]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415180 <http://eol.org/pages/483624>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415180 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?310457>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415180 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506151>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415180 langual:B5180)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415180 "PLANTS:CAGI10")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415180 "saguaro")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415180 "carnegiea gigantea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415180 "saguaro plant"@en)
SubClassOf(obo:FOODON_03415180 obo:FOODON_03412241)
SubClassOf(obo:FOODON_03415180 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_171969))

