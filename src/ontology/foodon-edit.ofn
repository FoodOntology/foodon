# Class: obo:NCBITaxon_82096 (Eleutherococcus senticosus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_82096 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_82096 "*Eleutherococcus senticosus* is a species of small, woody shrub in the family Araliaceae native to Northeastern Asia.  *E. senticosus* has a history of use in folklore and traditional Chinese medicine. Root extracts of E. senticosus are sold as a dietary supplement or cosmetic, usually under the name Siberian ginseng. [https://en.wikipedia.org/wiki/Eleutherococcus_senticosus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_82096 "siberian ginseng plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82096 <http://eol.org/pages/1145576>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82096 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?15004>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82096 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505934>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82096 langual:B5092)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_82096 "PLANTS:ELSE5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_82096 "Eleutherococcus senticosus (Rupr. & Maxim.) Maxim.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_82096 "eleutherococcus senticosus"@en)
SubClassOf(obo:NCBITaxon_82096 obo:FOODON_03411673)

