AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414326 "Valerianella P. Mill.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414326 "Valerianella sp.")
AnnotationAssertion(rdfs:label obo:FOODON_03414326 "cornsalad plant"@en)
