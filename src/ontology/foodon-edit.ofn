AnnotationAssertion(go:hasDbXref obo:FOODON_03414953 langual:B4953)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414953 "Aronia X prunifolia (Marshall) Rehder (pro sp.)")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414953 "Aronia x prunifolia (Marshall) Rehder")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414953 "aronia prunifolia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414953 "purple chokeberry plant"@en)
SubClassOf(obo:FOODON_03414953 obo:FOODON_03414951)

# Class: obo:FOODON_03414954 (jostaberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414954 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414954 "The jostaberry is a complex-cross fruit bush in the *Ribes* genus, involving three original species, the black currant *R. nigrum*, the North American coastal black gooseberry *R. divaricatum*, and the European gooseberry *R. uva-crispa* [https://en.wikipedia.org/wiki/Jostaberry]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414954 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?318352>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414954 langual:B4954)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414954 "jostaberry"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414954 "Ribes x nidigrolaria Rud. Bauer & A. Bauer")
AnnotationAssertion(rdfs:label obo:FOODON_03414954 "jostaberry plant"@en)
SubClassOf(obo:FOODON_03414954 obo:FOODON_03411159)

# Class: obo:FOODON_03414957 (native currant plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414957 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414957 "Acrotriche depressa, commonly known as native currant or wiry ground-berry, is a dwarf evergreen perennial shrub native to southern Australia, occurring naturally in sandy or heavy clay moist soils. The fruits are eaten out-of-hand, or used in jams and jellies. [https://en.wikipedia.org/wiki/Acrotriche_depressa]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414957 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?1380>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414957 langual:B4957)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414957 "Acrotriche depressa R. Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414957 "acrotriche depressa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414957 "wiry ground-berry"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414957 "native currant plant"@en)
SubClassOf(obo:FOODON_03414957 obo:FOODON_03411231)

# Class: obo:FOODON_03414963 (Myrica)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414963 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414963 "Myrica is a genus of about 35-50 species of small trees and shrubs in the family *Myricaceae*, order *Fagales*. The genus has a wide distribution, including Africa, Asia, Europe, North America and South America, and missing only from Australia. Common names include bayberry, bay-rum tree, candleberry, sweet gale, and wax-myrtle. The wax coating on the fruit of several species, known as bayberry wax, has been used traditionally to make candles. The fruit of *Myrica rubra* is an economically important crop in China, sold fresh, dried, canned, for juice, and for alcoholic beverages. *Myrica* is used to spice beer and snaps in Denmark. [https://en.wikipedia.org/wiki/Myrica]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414963 <http://eol.org/pages/4327>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414963 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402433>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414963 langual:B4963)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414963 "PLANTS:MOREL2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414963 "Morella")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414963 "Morella Lour.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414963 "Morella rubra Lour.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414963 "morella"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414963 "Myrica"@en)
SubClassOf(obo:FOODON_03414963 obo:FOODON_03411231)

# Class: obo:FOODON_03414964 (buffaloberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414964 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414964 "Shepherdia, commonly called buffaloberry or bullberry, is a genus of small shrubs in the *Elaeagnaceae* family. The plants are native to northern and western North America. The berry is recognizable by being a dark shade of red, with little white dots on them. They are rough to the touch, and are found on both trees and shrubs. Buffaloberries are sour and can be made into jam, pie, jelly, syrup, soups, or prepared like cranberry sauce with sugar added. [https://en.wikipedia.org/wiki/Shepherdia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414964 <http://eol.org/pages/4380>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414964 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33863>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414964 langual:B4964)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414964 "PLANTS:SHEPH")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414964 "Shepherdia Nutt.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414964 "Shepherdia argentea (Pursh) Nutt.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414964 "shepherdia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414964 "buffaloberry plant"@en)
SubClassOf(obo:FOODON_03414964 obo:FOODON_03411231)

# Class: obo:FOODON_03414965 (plumcot plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414965 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414965 "Pluots, apriums, apriplums, or plumcots, are some of the hybrids between different *Prunus* species that are also called interspecific plums. Whereas plumcots and apriplums are first-generation hybrids between a plum parent (*P. salicina* or *P. cerasifera* or their hybrids), and an apricot (*P. armeniaca*), pluots and apriums are later-generations. Both names \"plumcot\" and \"apriplum\" have been used for trees derived from a plum seed parent, and are therefore equivalent. [https://en.wikipedia.org/wiki/Pluot]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414965 langual:B4965)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414965 "apriplum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414965 "aprium"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414965 "pluot"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414965 "prunus hybrid"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414965 "plumcot plant"@en)
SubClassOf(obo:FOODON_03414965 obo:FOODON_03411539)

# Class: obo:FOODON_03414967 (silverberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414967 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414967 "Elaeagnus, silverberry or oleaster, is a genus of about 50-70 species of flowering plants in the family *Elaeagnaceae*. The vast majority of the species are native to temperate and subtropical regions of Asia. The fruit is a fleshy drupe containing a single seed; it is edible in many species. Several species are cultivated for their fruit, including *E. angustifolia, E. umbellata* and *E. multiflora* (gumi). [https://en.wikipedia.org/wiki/Elaeagnus]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414967 <http://eol.org/pages/4380>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414967 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?315350>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414967 langual:B4967)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414967 "PLANTS:ELAEA")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414967 "elaeagnus; oleaster"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414967 "silverberry plant"@en)
SubClassOf(obo:FOODON_03414967 obo:FOODON_03411539)

# Class: obo:FOODON_03414968 (gandaria plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414968 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414968 "Bouea macrophylla, commonly known as gandaria in english, is a species of flowering plant native to Southeast Asia. The tree belongs to the *Anacardiaceae* family which also includes mango and cashew. The fruit (resembling a mango) are green in colour and mature to an orange/yellow, with the seed being pink. Both the leaves and fruit from the tree can be eaten. [https://en.wikipedia.org/wiki/Bouea_macrophylla]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414968 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7510>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414968 langual:B4968)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414968 "Bouea macrophylla Griff.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414968 "bouea macrophylla"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414968 "gandaria plant"@en)
SubClassOf(obo:FOODON_03414968 obo:FOODON_03413387)

# Class: obo:FOODON_03414969 (camu-camu plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414969 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414969 "Myrciaria dubia, commonly known as camu camu, camucamu, cacari, or camocamo, is a small bushy riverside tree from the Amazon rainforest in Peru and Brazil, which grows to a height of 3-5 m (9.8-16.4 ft) and bears a red/purple cherry-like fruit. It is a close relative of the jabuticaba (*Myrciaria cauliflora*) and the guavaberry or rumberry (*Myrciaria floribunda*). [https://en.wikipedia.org/wiki/Myrciaria_dubia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414969 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?401456>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414969 langual:B4969)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414969 "Myrciaria dubia (Kunth) McVaugh")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414969 "myrciaria dubia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414969 "camu-camu plant"@en)
SubClassOf(obo:FOODON_03414969 obo:FOODON_03413387)

# Class: obo:FOODON_03414971 (oroblanco plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414971 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414971 "An oroblanco, oro blanco (white gold) or sweetie (*Citrus grandis* Osbeck × *C. paradisi* Macf.) is a sweet seedless citrus hybrid fruit similar to grapefruit. It is often referred to as oroblanco grapefruit. [https://en.wikipedia.org/wiki/Oroblanco]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414971 langual:B4971)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414971 "sweetie"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414971 "oroblanco plant"@en)
SubClassOf(obo:FOODON_03414971 obo:FOODON_03411139)

# Class: obo:FOODON_03414972 (custard apple family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414972 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414972 "The *Annonaceae* are a family, the custard apple family, of flowering plants consisting of trees, shrubs, or rarely lianas. With 108 accepted genera and about 2400 known species, it is the largest family in the *Magnoliales*. Several genera produce edible fruit, most notably *Annona, Anonidium, Asimina, Rollinia*, and *Uvaria*. The family is concentrated in the tropics, with few species found in temperate regions. [https://en.wikipedia.org/wiki/Annonaceae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414972 langual:B4972)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414972 "annonaceae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414972 "custard apple family"@en)
SubClassOf(obo:FOODON_03414972 obo:FOODON_03413357)

# Class: obo:FOODON_03414976 (palestine sweet lime plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414976 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414976 "Citrus limettioides, Palestinian sweet lime or Indian sweet lime or common sweet lime, alternatively considered a cultivar of *Citrus × limon* 'Indian Lime', is a low acid lime that has been used in Palestine for food, juice and rootstock. [https://en.wikipedia.org/wiki/Palestinian_sweet_lime]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414976 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312652>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414976 langual:B4976)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414976 "Citrus limettioides Tanaka")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414976 "citrus limettioides"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414976 "indian sweet lime"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414976 "palestine sweet lime plant"@en)
SubClassOf(obo:FOODON_03414976 obo:FOODON_03411067)

# Class: obo:FOODON_03414978 (melientha plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414978 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414978 "Melientha is a genus of plants in the family *Opiliaceae* described as a genus in 1888. The genus contains only one known species, *Melientha suavis*, native to Southeast Asia. [https://en.wikipedia.org/wiki/Melientha] 
 The young shoots, leaves, inflorescences and young fruits are widely consumed as a vegetable after boiling. The ripe fruits are also edible (juicy mesocarp) and in Vietnam the seeds are eaten in the same way as groundnut after boiling or frying. [http://uses.plantnet-project.org/en/Melientha_suavis_(PROSEA)]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414978 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?405776>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414978 langual:B4978)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414978 "Melientha suavis Pierre")
AnnotationAssertion(rdfs:label obo:FOODON_03414978 "melientha plant"@en)
SubClassOf(obo:FOODON_03414978 obo:FOODON_03411058)

