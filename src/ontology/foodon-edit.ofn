# Class: obo:FOODON_03430101 (medium ground and sifted form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430101 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430101 "A characteristic of ground food material which is larger than finely ground material but has been sifted to remove larger parts, specifically portions of germ or bran."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430101 langual:E0101)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430101 "bolted"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430101 "sifted (bolted)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430101 "Traditionally in flour milling a mesh of \"bolting cloth\" was used to filter out larger bran and germ components. [https://en.wiktionary.org/wiki/bolting_cloth]"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430101 "medium ground and sifted form (sensu food)"@en)
SubClassOf(obo:FOODON_03430101 obo:FOODON_03430117)

# Class: obo:FOODON_03430102 (food (liquid, high viscosity))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430102 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430102 "A liquid that flows slowly at room temperature."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430102 langual:E0102)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430102 "thick liquid"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430102 "Examples are: some heavy liqueurs, evaporated milk, vegetable oil, molasses and honey. The range of high viscosity liquids spans sucrose solutions between 45 and 70% solids (viscosity range from 10 to 500 centipoise). Prefer 'solid pieces' factor term to 'small particles' if both appear in the food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430102 "food (liquid, high viscosity)"@en)
EquivalentClasses(obo:FOODON_03430102 ObjectIntersectionOf(obo:FOODON_03430130 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001693)))
SubClassOf(obo:FOODON_03430102 obo:FOODON_03430130)
DisjointClasses(obo:FOODON_03430102 obo:FOODON_03430109)

