# Class: <http://purl.obolibrary.org/obo/FOODON_03411755> (Carangidae family)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411755> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411755> "The Carangidae are a family of fish which includes the jacks, pompanos, jack mackerels, runners, and scads. They are marine fishes found in the Atlantic, Indian and Pacific Oceans. Most species are fast-swimming predatory fishes that hunt in the waters above reefs and in the open sea; some dig in the sea floor for invertebrates."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411755> <https://www.clovegarden.com/ingred/seafishv.html>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_03411755> "Common names within family Carangidae are very disorderly, including Jacks, Amberjacks, Pompanos, Trevally, Bumpers and Scads, without clear deliniation as to which are which.[https://www.clovegarden.com/ingred/seafishv.html]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411755> <http://eol.org/pages/5361>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411755> <http://www.langual.org/langual_thesaurus.asp?termid=B1755>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411755> "jack family"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411755> "scad family"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411755> "carangidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411755> "Carangidae family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411755> <http://purl.obolibrary.org/obo/FOODON_03411581>)

