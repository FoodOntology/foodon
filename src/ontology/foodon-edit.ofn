# Class: obo:FOODON_03415101 (couch grass plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415101 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415101 "Elymus repens, commonly known as couch grass, is a very common perennial species of grass native to most of Europe, Asia, the Arctic biome, and northwest Africa. It has been brought into other mild northern climates for forage or erosion control, but is often considered a weed. Other names include common couch, twitch, quick grass, quitch grass (also just quitch), dog grass, quackgrass, scutch grass, and witchgrass. [https://en.wikipedia.org/wiki/Elymus_repens]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415101 <http://eol.org/pages/1115777>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415101 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?102069>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415101 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=512839>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415101 langual:B5101)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415101 "PLANTS:ELRE4")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415101 "elymus repens"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415101 "couch grass plant"@en)
SubClassOf(obo:FOODON_03415101 obo:FOODON_03413378)
SubClassOf(obo:FOODON_03415101 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_52152))

# Class: obo:FOODON_03415102 (cestrum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415102 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415102 "Cestrum is a genus of - depending on authority - 150-250 species of flowering plants in the family *Solanaceae*. They are native to warm temperate to tropical regions of the Americas. They are colloquially known as cestrums or jessamines (from \"jasmine\", due to their fragrant flowers). 
 All parts of the plants are toxic, causing severe gastroenteritis if eaten. [https://en.wikipedia.org/wiki/Cestrum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415102 <http://eol.org/pages/4437>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415102 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?403889>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415102 langual:B5102)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415102 "PLANTS:CESTR")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415102 "Cestrum")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415102 "Cestrum L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415102 "Cestrum spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415102 "cestrums"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415102 "jessamines"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415102 "cestrum plant"@en)
SubClassOf(obo:FOODON_03415102 obo:FOODON_03414934)

