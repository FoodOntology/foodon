# Class: obo:FOODON_03414967 (silverberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414967 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414967 "Elaeagnus, silverberry or oleaster, is a genus of about 50-70 species of flowering plants in the family *Elaeagnaceae*. The vast majority of the species are native to temperate and subtropical regions of Asia. The fruit is a fleshy drupe containing a single seed; it is edible in many species. Several species are cultivated for their fruit, including *E. angustifolia, E. umbellata* and *E. multiflora* (gumi). [https://en.wikipedia.org/wiki/Elaeagnus]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414967 <http://eol.org/pages/4380>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414967 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?315350>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414967 langual:B4967)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414967 "PLANTS:ELAEA")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414967 "Elaeagnus spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414967 "elaeagnus; oleaster"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414967 "silverberry plant"@en)
SubClassOf(obo:FOODON_03414967 obo:FOODON_03411539)

# Class: obo:FOODON_03414968 (gandaria plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414968 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414968 "Bouea macrophylla, commonly known as gandaria in english, is a species of flowering plant native to Southeast Asia. The tree belongs to the *Anacardiaceae* family which also includes mango and cashew. The fruit (resembling a mango) are green in colour and mature to an orange/yellow, with the seed being pink. Both the leaves and fruit from the tree can be eaten. [https://en.wikipedia.org/wiki/Bouea_macrophylla]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414968 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7510>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414968 langual:B4968)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414968 "Bouea macrophylla Griff.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414968 "bouea macrophylla"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414968 "gandaria plant"@en)
SubClassOf(obo:FOODON_03414968 obo:FOODON_03413387)

# Class: obo:FOODON_03414969 (camu-camu plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414969 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414969 "Myrciaria dubia, commonly known as camu camu, camucamu, cacari, or camocamo, is a small bushy riverside tree from the Amazon rainforest in Peru and Brazil, which grows to a height of 3-5 m (9.8-16.4 ft) and bears a red/purple cherry-like fruit. It is a close relative of the jabuticaba (*Myrciaria cauliflora*) and the guavaberry or rumberry (*Myrciaria floribunda*). [https://en.wikipedia.org/wiki/Myrciaria_dubia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414969 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?401456>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414969 langual:B4969)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414969 "Myrciaria dubia (Kunth) McVaugh")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414969 "myrciaria dubia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414969 "camu-camu plant"@en)
SubClassOf(obo:FOODON_03414969 obo:FOODON_03413387)

# Class: obo:FOODON_03414970 (langsat plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414970 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414970 "Lansium parasiticum, also known as langsat or lanzones, is a species of tree in the Mahogany family. *L. parasiticum* is cultivated mainly for its fruit, which can be eaten raw. [https://en.wikipedia.org/wiki/Lansium_parasiticum]"@en)
