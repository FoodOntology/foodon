AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415019 "flowering ash")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415019 "manna ash")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415019 "flowering ash"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415019 "fraxinus ornus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415019 "manna ash plant"@en)
SubClassOf(obo:FOODON_03415019 obo:FOODON_03411012)
SubClassOf(obo:FOODON_03415019 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_38874))

# Class: obo:FOODON_03415020 (chile cocopalm plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415020 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415020 "Jubaea is a genus of palms (family *Arecaceae*) with one species, *Jubaea chilensis*, or *J. spectabilis*, the Chilean wine palm or Chile cocopalm. The common name refers to the past use of the sap from the trunk of this palm to produce a fermented beverage. The sap is also boiled down into a syrup and sold locally as miel de palma. The tree also produces small round fruits that are about 2-3 centimetres (0.79-1.18 in) in diameter. The fruit has a very hard outer shell and whitish meat on the inside, like a miniature coconut. [https://en.wikipedia.org/wiki/Jubaea]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415020 <http://eol.org/pages/1142626>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415020 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?20718>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415020 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506726>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415020 langual:B5020)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415020 "PLANTS:JUCH3")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415020 "chilean coco palm"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415020 "chilean wine palm"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415020 "jubaea chilensis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415020 "jubaea spectabilis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415020 "chile cocopalm plant"@en)
SubClassOf(obo:FOODON_03415020 obo:FOODON_03411485)
SubClassOf(obo:FOODON_03415020 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_290260))

# Class: obo:FOODON_03415021 (american chestnut tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415021 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415021 "The American chestnut (*Castanea dentata*) is a large, monoecious deciduous tree of the beech family native to eastern North America. The nuts were once an important economic resource in North America, being sold on the streets of towns and cities, as they sometimes still are during the Christmas season [https://en.wikipedia.org/wiki/American_chestnut]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415021 <http://eol.org/pages/1148514>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415021 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=19454>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415021 langual:B5021)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415021 "PLANTS:CADE12")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415021 "American chestnut")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415021 "castanea dentata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415021 "american chestnut tree"@en)
SubClassOf(obo:FOODON_03415021 obo:FOODON_03411544)
SubClassOf(obo:FOODON_03415021 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_134033))

# Class: obo:FOODON_03415022 (common hazel plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415022 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415022 "Corylus avellana, the common hazel, is a species of hazel native to Europe and western Asia. Common hazel is cultivated for its nuts. The name hazelnut applies to the nuts of any of the species of the genus *Corylus*. This hazelnut or cob nut, the kernel of the seed, is edible and used raw or roasted, or ground into a paste. The cob is round, compared with the longer filbert nut. [https://en.wikipedia.org/wiki/Corylus_avellana]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415022 <http://eol.org/pages/1147599>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415022 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?11643>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415022 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=501642>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415022 langual:B5022)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415022 "PLANTS:COAV80")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415022 "Corylus avellana L.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415022 "European hazelnut")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415022 "cobnut"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415022 "corylus avellana"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415022 "common hazel plant"@en)
SubClassOf(obo:FOODON_03415022 obo:FOODON_03411533)
SubClassOf(obo:FOODON_03415022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_13451))

# Class: obo:FOODON_03415023 (filbert plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415023 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415023 "Corylus maxima, the filbert, is a species of hazel native to southeastern Europe and southwestern Asia, from the Balkans to Ordu in Turkey. The filbert is similar to the related common hazel, *C. avellana*, differing in having the nut more fully enclosed by the tubular involucre. This feature is shared by the beaked hazel *C. cornuta* of North America, and the Asian beaked hazel *C. sieboldiana* of eastern Asia. [https://en.wikipedia.org/wiki/Corylus_maxima]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415023 <http://eol.org/pages/5528>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415023 langual:B5023)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415023 "PLANTS:COMA18")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415023 "corylus maxima"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415023 "european filbert"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415023 "giant filbert"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415023 "Corylus maxima Mill.")
AnnotationAssertion(rdfs:label obo:FOODON_03415023 "filbert plant"@en)
SubClassOf(obo:FOODON_03415023 obo:FOODON_03411533)

