AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_203582 "hedge mustard"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_203582 "hedge-mustard"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_203582 "sisymbrium officinale"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_203582 "Sisymbrium officinale (L.) Scop.")
SubClassOf(obo:NCBITaxon_203582 obo:FOODON_03411179)

# Class: obo:NCBITaxon_204141 (Ocimum americanum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_204141 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_204141 "*Ocimum americanum*, known as American basil or \"hoary basil\", is an annual herb with white or lavender flowers. It is used for medicinal purposes. Despite the misleading name, it is native to Africa, the Indian Subcontinent, China, Southeast Asia. The species is naturalized in Queensland, Christmas Island, and parts of tropical America. [https://en.wikipedia.org/wiki/Ocimum_americanum]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_204141 "hoary basil plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204141 <http://eol.org/pages/483863>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204141 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402305>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204141 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=517628>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204141 langual:B5117)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_204141 "Ocimum americanum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204141 "american basil"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204141 "ocimum americanum"@en)
SubClassOf(obo:NCBITaxon_204141 obo:FOODON_03413359)

# Class: obo:NCBITaxon_204149 (Ocimum tenuiflorum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_204149 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_204149 "*Ocimum tenuiflorum* (synonym *Ocimum sanctum*), commonly known as holy basil, tulasi (sometimes spelled thulasi) or tulsi, is an aromatic perennial plant in the family *Lamiaceae*. It is native to the Indian subcontinent and widespread as a cultivated plant throughout the Southeast Asian tropics. [https://en.wikipedia.org/wiki/Ocimum_tenuiflorum]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_204149 "holy basil plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204149 <http://eol.org/pages/480298>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204149 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?25491>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204149 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=507863>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204149 langual:B5008)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_204149 "PLANTS:OCTE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_204149 "Ocimum tenuiflorum L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204149 "brush-leaf-tea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204149 "holy basil"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204149 "ocimum sanctum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_204149 "ocimum tenuiflorum"@en)
SubClassOf(obo:NCBITaxon_204149 obo:FOODON_03411179)

