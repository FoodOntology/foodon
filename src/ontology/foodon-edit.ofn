# Class: obo:NCBITaxon_4270 (Byrsonima crassifolia)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_4270 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_4270 "*Byrsonima crassifolia* is a species of flowering plant in the acerola family, *Malpighiaceae*, that is native to tropical America. It is valued for its small, sweet, yellow fruit, which are strongly scented. Common names include nanche, nance, chacunga, changunga, craboo, kraabu, savanna serrette (or savanna serret) and golden spoon."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_4270 "golden-spoon plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_4270 "WIKIPEDIA:Byrsonima_crassifolia")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4270 <http://eol.org/pages/592366>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4270 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8222>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4270 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=29263>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4270 langual:B4461)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4270 "PLANTS:BYCR")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_4270 "byrsonima crassifolia"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_4270 "craboo"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_4270 "maricao cimun"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_4270 "nance"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4270 "Byrsonima crassifolia (L.) Kunth")
SubClassOf(obo:NCBITaxon_4270 obo:FOODON_03411024)

