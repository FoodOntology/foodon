AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411588 "black lentil"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411588 "matpe bean"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411588 "minapa pappu"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411588 "mungo bean"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411588 "urad"@en)
