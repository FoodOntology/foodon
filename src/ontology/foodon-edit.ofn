AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13363 "PLANTS:BOOF")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_13363 "Borago officinalis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13363 "borago officinalis"@en)
