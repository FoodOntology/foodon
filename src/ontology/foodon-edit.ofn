AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411674 "MANSFELD:7662")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411674 "PLANTS:URDI")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411674 "great nettle")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411674 "stinging nettle")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411674 "stinging nettle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411674 "urtica spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411674 "nettle plant"@en)
