# Class: obo:FOODON_03412736 (japanese plum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412736 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412736 "Prunus salicina (syn. *Prunus triflora* or *Prunus thibetica*), commonly called the Japanese plum or Chinese plum, is a small deciduous tree native to China. It is now also grown in fruit orchards in Korea, Japan, the United States, and Australia. 
 The fruit is a drupe 4-7 cm in diameter with yellow-pink flesh; it can be harvested in the summer. When fully ripe it can be eaten raw. [https://en.wikipedia.org/wiki/Prunus_salicina]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 <http://eol.org/pages/231338>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30091>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506232>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 langual:B2736)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 "MANSFELD:9360")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412736 "PLANTS:PRSA3")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412736 "Japanese plum")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412736 "su-momo")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412736 "prunus salicina"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412736 "susina"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412736 "japanese plum plant"@en)
SubClassOf(obo:FOODON_03412736 obo:FOODON_03411206)
SubClassOf(obo:FOODON_03412736 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_88123))

