# Class: obo:NCBITaxon_170927 (Primula veris)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_170927 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_170927 "* Primula veris* (cowslip, common cowslip, cowslip primrose; syn. *Primula officinalis* Hill) is a herbaceous perennial flowering plant in the primrose family *Primulaceae*. Cowslip leaves have been traditionally used in Spanish cooking as a salad green. Uses in English cookery include using the flowers to flavor country wine and vinegars; sugaring to be a sweet or eaten as part of a composed salad [https://en.wikipedia.org/wiki/Primula_veris]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_170927 "cowslip plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170927 <http://eol.org/pages/584034>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170927 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?400303>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170927 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24035>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170927 langual:B5091)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_170927 "PLANTS:PRVE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_170927 "Primula veris L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_170927 "primula officinalis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_170927 "primula veris"@en)
SubClassOf(obo:NCBITaxon_170927 obo:FOODON_03411566)

# Class: obo:NCBITaxon_170989 (Citrus hystrix)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_170989 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_170989 "The kaffir lime (*Citrus × hystrix*, *Rutaceae*) is also known as combava, kieffer lime, limau purut, jeruk purut or makrut lime, Kabuyao (Cabuyao). It is a lime native to Indochinese and Malesian ecoregions in India, Laos, Indonesia, Malaysia and Thailand, and adjacent countries. It is used in Southeast Asian cuisine."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_170989 "kaffir lime plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_170989 "WIKIPEDIA:Citrus_hystrix")
