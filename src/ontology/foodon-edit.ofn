# Class: obo:FOODON_03414852 (japanese quail)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414852 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414852 "A species of Old World quail found in East Asia. First considered a subspecies of the common quail, it was distinguished as its own species in 1983. As the Japanese quail is easily managed, fast growing, small in size, and can produce eggs at a high rate, it has been farmed in large quantities across the globe."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414852 <http://eol.org/pages/1049255>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414852 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=176013>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414852 langual:B4852)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414852 "Coturnix japonica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414852 "japanese quail"@en)
