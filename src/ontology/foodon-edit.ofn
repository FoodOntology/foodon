# Class: obo:NCBITaxon_51239 (Vanilla planifolia)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_51239 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_51239 "*Vanilla planifolia* is a species of vanilla orchid. It is native to Mexico and Central America, and is one of the primary sources for vanilla flavouring, due to its high vanillin content. Common names are flat-leaved vanilla, Tahitian vanilla, and West Indian vanilla (also used for the Pompona vanilla, *V. pompona*). Often, it is simply referred to as \"the vanilla\". [https://en.wikipedia.org/wiki/Vanilla_planifolia]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_51239 "bourbon vanilla plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51239 <http://eol.org/pages/1127948>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51239 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?41111>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51239 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=43719>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51239 langual:B5045)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51239 "PLANTS:VAPL2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_51239 "Vanilla planifolia Andrews")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_51239 "Vanilla planifolia Jacks.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_51239 "flat-leaved vanilla"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_51239 "vanilla"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_51239 "vanilla fragrans"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_51239 "vanilla planifolia"@en)
SubClassOf(obo:NCBITaxon_51239 obo:FOODON_03411355)

# Class: obo:NCBITaxon_513163 (Xanthosoma brasiliense)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_513163 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_513163 "*Xanthosoma brasiliense* (Desf.) Engl. This particular taro was developed for its yield of edible leaves and stems rather than its roots. Food: the leaves and leaf stems are eaten as a cooked, green vegetable; the stems are widely used as a celery substitute in tropical areas. [http://greenharvest.com.au/Plants/Information/TahitianSpinach.html]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_513163 "tahitian spinach plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_513163 <http://eol.org/pages/1127778>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_513163 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?42083>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_513163 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42583>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_513163 langual:B4504)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_513163 "PLANTS:XABR")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_513163 "Xanthosoma brasiliense (Desf.) Engl.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_513163 "tahitian taro"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_513163 "xanthosoma brasiliense"@en)
SubClassOf(obo:NCBITaxon_513163 obo:FOODON_03411057)

