# Class: <http://purl.obolibrary.org/obo/FOODON_03415001> (signet marigold plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03415001> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03415001> "Tagetes tenuifolia, the signet marigold or golden marigold, is a species of the wild marigold in the daisy family (*Asteraceae*). It is widespread across most of Mexico as well as Central America, Colombia, and Peru. The plant's edible flowers can be used as a garnish. [https://en.wikipedia.org/wiki/Tagetes_tenuifolia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03415001> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?36205>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03415001> <http://www.langual.org/langual_thesaurus.asp?termid=B5001>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03415001> "Tagetes tenuifolia Cav.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03415001> "slender-leaf marigold"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03415001> "tagetes tenuifolia"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03415001> "signet marigold plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03415001> <http://purl.obolibrary.org/obo/FOODON_03414999>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03415002> (nasturtium plant)

