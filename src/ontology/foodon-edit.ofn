AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_122119> <http://www.langual.org/langual_thesaurus.asp?termid=B2743>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_122119> "PLANTS:PRAN3")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_122119> "PLANTS:PRANA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_122119> "PLANTS:PRANW")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_122119> "Prunus angustifolia Marsh.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_122119> "prunus angustifolia"@en)
SubClassOf(<http://purl.obolibrary.org/obo/NCBITaxon_122119> <http://purl.obolibrary.org/obo/FOODON_03411206>)

