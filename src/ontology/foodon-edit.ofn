AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3888 langual:B3484)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3888 "PLANTS:PISA6")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3888 "dry pea plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3888 "english pea plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3888 "garden pea plant"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3888 "Pisum sativum L.")
AnnotationAssertion(rdfs:comment obo:NCBITaxon_3888 "Green \"garden\" peas, eaten immature and fresh, were an innovative luxury of Early Modern Europe. In England, the distinction between \"field peas\" and \"garden peas\" dates from the early 17th century."@en)
AnnotationAssertion(rdfs:seeAlso obo:NCBITaxon_3888 <https://hort.purdue.edu/newcrop/CropFactSheets/pea.html>)
SubClassOf(obo:NCBITaxon_3888 obo:FOODON_03411338)

# Class: obo:NCBITaxon_3891 (Psophocarpus tetragonolobus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3891 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3891 "The winged bean (Psophocarpus tetragonolobus) is a tropical legume plant native to New Guinea. It grows abundantly in the hot, humid equatorial countries of South and Southeast Asia."@en)
