SubClassOf(obo:NCBITaxon_119488 obo:FOODON_03411184)

# Class: obo:NCBITaxon_1195127 (Selenicereus megalanthus)

AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_1195127 "*Hylocereus megalanthus* is a cactus species in the genus *Hylocereus* that is native to northern South America, where it is known, along with its fruit, by the name of Pitahaya. The yellow fruit has thorns, unlike the red dragon fruits (*H. undatus, H. polyrhizus, H. costaricensis*), and is commonly known as \"yellow dragon fruit\", \"yellow pitahaya\" or \"yellow pitaya\". [https://en.wikipedia.org/wiki/Hylocereus_megalanthus]"@en)
AnnotationAssertion(dcterms:date obo:NCBITaxon_1195127 "2023-06-19T01:50:46Z"^^xsd:dateTime)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_1195127 "Hylocereus megalanthus (K. Schum. ex Vaupel) Ralf Bauer")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_1195127 "Hylocereus megalanthus"@en)
SubClassOf(obo:NCBITaxon_1195127 obo:FOODON_03412781)

