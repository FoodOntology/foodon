# Class: obo:FOODON_03413936 (round goby)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413936 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413936 "The round goby (Neogobius melanostomus) is a euryhaline bottom-dwelling goby of the family Gobiidae, native to central Eurasia including the Black Sea and the Caspian Sea. Round gobies have established large non-native populations in the Baltic Sea, several major Eurasian rivers, and the North American Great Lakes."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413936 langual:B3936)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413936 <https://eol.org/pages/46575276>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413936 asfis:nbu)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03413936 "itis:172072")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413936 "Black spotted goby"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413936 "Caspian round goby"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413936 "Ginger goby"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413936 "round goby"@en)
SubClassOf(obo:FOODON_03413936 obo:FOODON_03413934)
SubClassOf(obo:FOODON_03413936 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_47308))

