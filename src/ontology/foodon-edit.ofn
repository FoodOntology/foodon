AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412063 "MANSFELD:6836")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412063 "PLANTS:PACU7")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412063 "brazilian cocoa"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412063 "guarana")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412063 "paullinia cupana"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412063 "uabano"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412063 "guarana plant"@en)
SubClassOf(obo:FOODON_03412063 obo:FOODON_03411047)
SubClassOf(obo:FOODON_03412063 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_392747))

