# Class: obo:NCBITaxon_52969 (Ascophyllum nodosum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_52969 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_52969 "Ascophyllum nodosum is a large, common brown alga (*Phaeophyceae*) in the family *Fucaceae*, being the only species in the genus *Ascophyllum*. It is seaweed of the northern Atlantic Ocean, also known as rockweed, Norwegian kelp, knotted kelp, knotted wrack or egg wrack. [https://en.wikipedia.org/wiki/Ascophyllu]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_52969 "north atlantic rockweed"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 <http://eol.org/pages/902587>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11331>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11332>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 langual:B4596)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 asfis:asn)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_52969 "EC:No 1637/2001 ASN")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_52969 "Ascophyllum nodosum")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52969 "ascophyllum nodosum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52969 "egg wrack"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52969 "knotted kelp"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_52969 "norwegian kelp"@en)
SubClassOf(obo:NCBITaxon_52969 obo:FOODON_03414510)

# Class: obo:NCBITaxon_53159 (Lamium album)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_53159 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_53159 "*Lamium album*, commonly called white nettle or white dead-nettle, is a flowering plant in the family *Lamiaceae*. The young leaves are edible, and can be used in salads or cooked as a vegetable. Bees, especially bumble bees are attracted to the flowers which are a good source of early nectar and pollen, hence the plant is sometimes called the bee nettle. [https://en.wikipedia.org/wiki/Lamium_album]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_53159 "white deadnettle plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53159 <http://eol.org/pages/579590>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53159 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314991>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53159 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32538>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53159 langual:B5083)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_53159 "PLANTS:LAAL")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_53159 "Lamium album L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_53159 "lamium album"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_53159 "white-nettle"@en)
SubClassOf(obo:NCBITaxon_53159 obo:FOODON_03411566)

