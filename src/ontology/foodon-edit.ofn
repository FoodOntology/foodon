AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415129 langual:B5129)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415129 "PLANTS:EQAR")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415129 "common horsetail")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415129 "field horsetail")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415129 "common horsetail"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415129 "equisetum arvense"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415129 "filed horsetail plant"@en)
SubClassOf(obo:FOODON_03415129 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415129 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3258))

# Class: obo:FOODON_03415130 (common fumitory plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415130 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415130 "Fumaria officinalis (common fumitory, drug fumitory or earth smoke) is a herbaceous annual flowering plant in the poppy family *Papaveraceae*. It is the most common species of the genus *Fumaria* in Western and Central Europe. [https://en.wikipedia.org/wiki/Fumaria_officinalis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415130 <http://eol.org/pages/590512>)
