AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414710 "saw-sedge"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414710 "sawsedge plant"@en)
SubClassOf(obo:FOODON_03414710 obo:FOODON_03414707)

# Class: obo:FOODON_03414711 (rocklily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414711 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414711 "Arthropodium is a genus of herbaceous perennial plants in the subfamily *Lomandroideae* of the family *Asparagaceae*. It is native to Australia, New Zealand, New Caledonia and Madagascar. The rhizomes of some species can be eaten as root vegetables, including *Arthropodium cirratum*, *Arthropodium milleflorum*, *Arthropodium minus*, and *Arthropodium strictum*. [https://en.wikipedia.org/wiki/Arthropodium]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414711 <http://eol.org/pages/80109>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414711 langual:B4711)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414711 "Asparagaceae")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414711 "arthropodium spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414711 "rocklily plant"@en)
SubClassOf(obo:FOODON_03414711 obo:FOODON_03411018)

# Class: obo:FOODON_03414712 (bulbine-lily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414712 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414712 "Bulbine bulbosa, commonly known as bulbine lily, is a flowering plant in the genus *Bulbine*. It is endemic to Australia. The corms of mature plants are nutritious, containing calcium and iron, and were used as food by the Aborigines. [https://en.wikipedia.org/wiki/Bulbine_bulbosa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414712 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8116>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414712 langual:B4712)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414712 "Bulbine bulbosa (R. Br.) Haw.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414712 "Xanthorrhoeaceae")
AnnotationAssertion(rdfs:label obo:FOODON_03414712 "bulbine-lily plant"@en)
SubClassOf(obo:FOODON_03414712 obo:FOODON_03411018)

# Class: obo:FOODON_03414713 (native turmeric plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414713 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414713 "Curcuma australasica, Native Turmeric, or Cape York Lily, is a rhizomatous herbaceous perennial plant of the *Zingiberaceae* or ginger family. It occurs on Cape York Peninsula, a few areas in the Northern Territory, Australia, and in Papua New Guinea. Aboriginal people in Cape York Peninsula used to roast and eat the roots of this plant. [https://en.wikipedia.org/wiki/Curcuma_australasica]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414713 <http://eol.org/pages/1122341>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414713 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=817991>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414713 langual:B4713)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414713 "PLANTS:CUAU2")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414713 "cape york lily"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414713 "curcuma australasica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414713 "native turmeric plant"@en)
SubClassOf(obo:FOODON_03414713 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03414713 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_378008))

# Class: obo:FOODON_03414714 (wombat berry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414714 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414714 "Eustrephus is a monotypic genus in the family *Asparagaceae*, subfamily *Lomandroideae*. *Eustrephus latifolius*, commonly named wombat berry, is the sole species of evergreen vines which grow naturally in Malesia, the Pacific Islands and eastern Australia. The tubers are eaten baked, and have an earthy sweet flavour. [https://en.wikipedia.org/wiki/Eustrephus]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414714 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?16466>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414714 langual:B4714)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414714 "Asparagaceae")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414714 "Eustrephus latifolius R. Br.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414714 "eustrephus latifolius"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414714 "orangevine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414714 "wombat berry plant"@en)
SubClassOf(obo:FOODON_03414714 obo:FOODON_03411018)

# Class: obo:FOODON_03414715 (wild parsnip plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414715 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414715 "Trachymene incisa, wild parsnip, is a perennial herb native to eastern Australia growing in sclerophyll forest and cleared areas, with a preference for sandy soils and rock crevices. The roots are a traditional Aboriginal bushfood, and are eaten after baking in campfire coals or in earth ovens. [https://en.wikipedia.org/wiki/Trachymene_incisa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414715 langual:B4715)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414715 "Araliaceae")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414715 "trachymene incisa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414715 "wild parsnip plant"@en)
SubClassOf(obo:FOODON_03414715 obo:FOODON_03411018)

# Class: obo:FOODON_03414716 (polynesian arrowrrot plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414716 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414716 "Tacca leontopetaloides is a species of flowering plant in the yam family *Dioscoreaceae*, that is native to tropical Africa, South Asia, Southeast Asia, northern Australia, New Guinea, Samoa, Micronesia, and Fiji. The tubers of Polynesian arrowroot contain starch, making it an important food source for many Pacific Island cultures, primarily for the inhabitants of low islands and atolls. [https://en.wikipedia.org/wiki/Tacca_leontopetaloides]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414716 <http://eol.org/pages/345447>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414716 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?70775>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414716 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=43334>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414716 langual:B4716)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414716 "PLANTS:TALE2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414716 "Polynesian arrowroot")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414716 "seashore bat lily")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414716 "tacca leontopetaloides"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414716 "polynesian arrowrrot plant"@en)
SubClassOf(obo:FOODON_03414716 obo:FOODON_03411016)
SubClassOf(obo:FOODON_03414716 obo:FOODON_03413396)
SubClassOf(obo:FOODON_03414716 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_72648))

# Class: obo:FOODON_03414718 (long yam plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414718 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414718 "Dioscorea transversa, Pencil yam, is a vine of eastern and northern Australia. The tubers are a staple food of Australian Aboriginals and are eaten after cooking, usually in ground ovens. [https://en.wikipedia.org/wiki/Dioscorea_transversa]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414718 <http://eol.org/pages/8214>)
