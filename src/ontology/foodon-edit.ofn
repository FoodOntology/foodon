AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510134> <http://www.langual.org/langual_thesaurus.asp?termid=P0134>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "contains label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "contains, label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "good source of label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "good source of, label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "provides label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "provides, label claim"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03510134> "source of, label claim"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510134> "LanguaL curation note: The amount customarily consumed contains 10% to 19% of the daily nutritional value. May be used on meals or main dishes to indicate that product contains a food that meets the definition."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510134> "\"source of\" label claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510134> <http://purl.obolibrary.org/obo/FOODON_03510059>)

