AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28702 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=177029>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_28702 langual:B4295)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_28702 "Fratercula corniculata (Naumann, 1821)")
