# Class: obo:FOODON_03414864 (bagrid catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414864 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414864 "The *Bagridae* are a family of catfish that are native to Africa (*Bagrus*) and Asia (all other genera) from Japan to Borneo. It includes about 245 species. These fish are commonly known as naked catfishes or bagrid catfishes. Large bagrids are important as food fish. Some species are kept as aquarium fishes. [https://en.wikipedia.org/wiki/Bagridae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414864 <http://eol.org/pages/5110>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414864 langual:B4864)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414864 "bagridae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414864 "naked catfish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414864 "bagrid catfish"@en)
SubClassOf(obo:FOODON_03414864 obo:FOODON_03411598)

# Class: obo:FOODON_03414865 (longsnout catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414865 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414865 "A genus of bagrid catfishes found mostly in Southeast Asia with some species occurring in China. This genus has a confused taxonomy and there is uncertainty surrounding the number of valid species. The members of Leiocassis have an elongate narrow head and a prominently protruding snout."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414865 wikipedia:Leiocassis)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414865 <http://eol.org/pages/5110>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414865 langual:B4865)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414865 "Leiocassis"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414865 "Leiocassis Bleeker, 1857")
AnnotationAssertion(rdfs:label obo:FOODON_03414865 "longsnout catfish"@en)
SubClassOf(obo:FOODON_03414865 obo:FOODON_03414864)

# Class: obo:FOODON_03414866 (yellow catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414866 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414866 "A species of bagrid catfish found in eastern Asia from Siberia to China, Korea, Vietnam, and Laos, where it can be found in lakes and river channels. It can reach a maximum length of 34.5 cm, weighing 3 kg, though it is much more commonly found to a length of 8 cm. It is a minor component of commercial fisheries."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414866 <http://eol.org/pages/613220>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414866 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=681061>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414866 langual:B4866)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414866 asfis:ych)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414866 "Korean bullhead"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414866 "Pelteobagrus fulvidraco"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414866 "Tachysurus fulvidraco"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414866 "yellow catfish"@en)
SubClassOf(obo:FOODON_03414866 obo:FOODON_03414864)
SubClassOf(obo:FOODON_03414866 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_1234273))

# Class: obo:FOODON_03414867 (sorubim catfish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414867 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414867 "A genus of several South American catfish species of family Pimelodidae. The species are known by a number of different common names. They typically inhabit major rivers where they prefer the main channels and tend to stay at maximum depth, but some species can also be seen in lakes, flooded forests, and other freshwater habitats. They have robust bodies, and are important food fish."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414867 wikipedia:Pseudoplatystoma)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414867 <http://eol.org/pages/5091>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414867 langual:B4867)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414867 "Pseudoplatystoma"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414867 "Pseudoplatystoma Bleeker, 1862")
AnnotationAssertion(rdfs:label obo:FOODON_03414867 "sorubim catfish"@en)
SubClassOf(obo:FOODON_03414867 obo:FOODON_03411969)

# Class: obo:FOODON_03414868 (mandarin fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414868 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414868 "A species of temperate perch native to the Amur and Yangtze basins, and other rivers and lakes in China. The mandarin fish is a commercially important species, as it is a popular food fish and has been widely farmed in its native range since the 20th century."@en)
