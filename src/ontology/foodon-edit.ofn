AnnotationAssertion(go:hasDbXref obo:NCBITaxon_219897 "PLANTS:SYPA7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_219897 "Syzygium paniculatum Gaertn.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219897 "magenta cherry"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219897 "magenta lilli-pilly"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219897 "syzygium paniculatum"@en)
