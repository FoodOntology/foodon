AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414343 "Persicaria odorata (Lour.) Sojak")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "cambodian mint"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "hot mint"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "persicaria odorata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "vietnamese cilantro"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "vietnamese mint"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414343 "vietnamese mint palm"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414343 "vietnamese coriander plant"@en)
SubClassOf(obo:FOODON_03414343 obo:FOODON_03411179)

# Class: obo:FOODON_03414344 (white ginger plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414344 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414344 "The White ginger lily (*Hedychium coronarium*) is originally from the Himalayas region of Nepal and India where it is known as dolan champa."@en)
