# Class: obo:FOODON_03412554 (guajillo pepper plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412554 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412554 "A guajillo chili or guajillo chile is a variety of chile pepper of the species *Capsicum annuum* which is widely used in the cuisine of Mexico. Its heat (rating 2,500 to 5,000 on the Scoville scale) is considered mild to medium. [https://en.wikipedia.org/wiki/Guajillo_chili]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412554 langual:B2554)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412554 "pepper, guajillo"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412554 "guajillo pepper plant"@en)
SubClassOf(obo:FOODON_03412554 obo:FOODON_03411643)

