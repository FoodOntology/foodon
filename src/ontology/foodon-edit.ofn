AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414882 "Limnothrissa miodon"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414882 "Limnothrissa Regan, 1917")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414882 "limnothrissa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414882 "kapenta"@en)
