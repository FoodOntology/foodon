AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414508 "cotton-grass"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414508 "cottonsedge"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414508 "eriophorum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414508 "mouse nuts"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414508 "cottongrass plant"@en)
SubClassOf(obo:FOODON_03414508 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03414508 obo:FOODON_03411047)

# Class: obo:FOODON_03414509 (oarweed)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414509 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414509 "Laminaria digitata is a large brown alga in the family Laminariaceae*, also known by the common name Oarweed. It is a tough, leathery, dark brown seaweed that grows to two or three metres. The holdfast which anchors it to the rock is conical and has a number of spreading root-like protrusions called rhizoids.*Laminaria digitata* occurs in the north west Atlantic from Greenland south to Cape Cod and in the north east Atlantic from northern Russia and Iceland south to France. It is common round the coasts of the British Isles except for much of the east coast of England."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414509 <http://eol.org/pages/919354>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414509 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11228>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414509 langual:B4509)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414509 asfis:lqd)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414509 "atlantic kombu"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414509 "laminaria digitata"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414509 "sea tangle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414509 "tangle"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414509 "oarweed"@en)
SubClassOf(obo:FOODON_03414509 obo:FOODON_03411744)
SubClassOf(obo:FOODON_03414509 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_80365))

