# Class: <http://purl.obolibrary.org/obo/FOODON_03414964> (buffaloberry plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414964> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414964> "Shepherdia, commonly called buffaloberry or bullberry, is a genus of small shrubs in the *Elaeagnaceae* family. The plants are native to northern and western North America. The berry is recognizable by being a dark shade of red, with little white dots on them. They are rough to the touch, and are found on both trees and shrubs. Buffaloberries are sour and can be made into jam, pie, jelly, syrup, soups, or prepared like cranberry sauce with sugar added. [https://en.wikipedia.org/wiki/Shepherdia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414964> <http://eol.org/pages/4380>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414964> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33863>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414964> <http://www.langual.org/langual_thesaurus.asp?termid=B4964>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414964> "PLANTS:SHEPH")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414964> "Shepherdia Nutt.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414964> "Shepherdia argentea (Pursh) Nutt.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414964> "shepherdia"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414964> "buffaloberry plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414964> <http://purl.obolibrary.org/obo/FOODON_03411231>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414965> (plumcot plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414965> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414965> "Pluots, apriums, apriplums, or plumcots, are some of the hybrids between different *Prunus* species that are also called interspecific plums. Whereas plumcots and apriplums are first-generation hybrids between a plum parent (*P. salicina* or *P. cerasifera* or their hybrids), and an apricot (*P. armeniaca*), pluots and apriums are later-generations. Both names \"plumcot\" and \"apriplum\" have been used for trees derived from a plum seed parent, and are therefore equivalent. [https://en.wikipedia.org/wiki/Pluot]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414965> <http://www.langual.org/langual_thesaurus.asp?termid=B4965>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414965> "apriplum"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414965> "aprium"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414965> "pluot"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414965> "prunus hybrid"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414965> "plumcot plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414965> <http://purl.obolibrary.org/obo/FOODON_03411539>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414967> (silverberry plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414967> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414967> "Elaeagnus, silverberry or oleaster, is a genus of about 50-70 species of flowering plants in the family *Elaeagnaceae*. The vast majority of the species are native to temperate and subtropical regions of Asia. The fruit is a fleshy drupe containing a single seed; it is edible in many species. Several species are cultivated for their fruit, including *E. angustifolia, E. umbellata* and *E. multiflora* (gumi). [https://en.wikipedia.org/wiki/Elaeagnus]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414967> <http://eol.org/pages/4380>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414967> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?315350>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414967> <http://www.langual.org/langual_thesaurus.asp?termid=B4967>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414967> "PLANTS:ELAEA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414967> "Elaeagnus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414967> "Elaeagnus L.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414967> "Elaeagnus spp.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414967> "elaeagnus; oleaster"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414967> "silverberry plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414967> <http://purl.obolibrary.org/obo/FOODON_03411539>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414968> (gandaria plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414968> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414968> "Bouea macrophylla, commonly known as gandaria in english, is a species of flowering plant native to Southeast Asia. The tree belongs to the *Anacardiaceae* family which also includes mango and cashew. The fruit (resembling a mango) are green in colour and mature to an orange/yellow, with the seed being pink. Both the leaves and fruit from the tree can be eaten. [https://en.wikipedia.org/wiki/Bouea_macrophylla]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414968> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7510>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414968> <http://www.langual.org/langual_thesaurus.asp?termid=B4968>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414968> "Bouea macrophylla Griff.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414968> "bouea macrophylla"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414968> "gandaria plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414968> <http://purl.obolibrary.org/obo/FOODON_03413387>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414969> (camu-camu plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414969> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414969> "Myrciaria dubia, commonly known as camu camu, camucamu, cacari, or camocamo, is a small bushy riverside tree from the Amazon rainforest in Peru and Brazil, which grows to a height of 3-5 m (9.8-16.4 ft) and bears a red/purple cherry-like fruit. It is a close relative of the jabuticaba (*Myrciaria cauliflora*) and the guavaberry or rumberry (*Myrciaria floribunda*). [https://en.wikipedia.org/wiki/Myrciaria_dubia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414969> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?401456>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414969> <http://www.langual.org/langual_thesaurus.asp?termid=B4969>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414969> "Myrciaria dubia (Kunth) McVaugh")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414969> "myrciaria dubia"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414969> "camu-camu plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414969> <http://purl.obolibrary.org/obo/FOODON_03413387>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414971> (oroblanco plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414971> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414971> "An oroblanco, oro blanco (white gold) or sweetie (*Citrus grandis* Osbeck × *C. paradisi* Macf.) is a sweet seedless citrus hybrid fruit similar to grapefruit. It is often referred to as oroblanco grapefruit. [https://en.wikipedia.org/wiki/Oroblanco]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414971> <http://www.langual.org/langual_thesaurus.asp?termid=B4971>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414971> "sweetie"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414971> "oroblanco plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414971> <http://purl.obolibrary.org/obo/FOODON_03411139>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414972> (custard apple family)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414972> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414972> "The *Annonaceae* are a family, the custard apple family, of flowering plants consisting of trees, shrubs, or rarely lianas. With 108 accepted genera and about 2400 known species, it is the largest family in the *Magnoliales*. Several genera produce edible fruit, most notably *Annona, Anonidium, Asimina, Rollinia*, and *Uvaria*. The family is concentrated in the tropics, with few species found in temperate regions. [https://en.wikipedia.org/wiki/Annonaceae]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414972> <http://www.langual.org/langual_thesaurus.asp?termid=B4972>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414972> "annonaceae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414972> "custard apple family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414972> <http://purl.obolibrary.org/obo/FOODON_03413357>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414976> (palestine sweet lime plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414976> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414976> "Citrus limettioides, Palestinian sweet lime or Indian sweet lime or common sweet lime, alternatively considered a cultivar of *Citrus × limon* 'Indian Lime', is a low acid lime that has been used in Palestine for food, juice and rootstock. [https://en.wikipedia.org/wiki/Palestinian_sweet_lime]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414976> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312652>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414976> <http://www.langual.org/langual_thesaurus.asp?termid=B4976>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414976> "Citrus limettioides Tanaka")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414976> "citrus limettioides"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414976> "indian sweet lime"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414976> "palestine sweet lime plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414976> <http://purl.obolibrary.org/obo/FOODON_03411067>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414978> (melientha plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414978> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414978> "Melientha is a genus of plants in the family *Opiliaceae* described as a genus in 1888. The genus contains only one known species, *Melientha suavis*, native to Southeast Asia. [https://en.wikipedia.org/wiki/Melientha] 
 The young shoots, leaves, inflorescences and young fruits are widely consumed as a vegetable after boiling. The ripe fruits are also edible (juicy mesocarp) and in Vietnam the seeds are eaten in the same way as groundnut after boiling or frying. [http://uses.plantnet-project.org/en/Melientha_suavis_(PROSEA)]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414978> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?405776>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414978> <http://www.langual.org/langual_thesaurus.asp?termid=B4978>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414978> "Melientha suavis Pierre")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414978> "melientha plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414978> <http://purl.obolibrary.org/obo/FOODON_03411058>)

