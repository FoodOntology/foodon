AnnotationAssertion(go:hasDbXref obo:NCBITaxon_458363 "PLANTS:PEES")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_458363 "breadroot"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_458363 "pediomelum esculentum"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_458363 "prairie turnip"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_458363 "prairie-turnip"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_458363 "psoralea esculenta"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_458363 "Pediomelum esculentum (Pursh) Rydb.")
