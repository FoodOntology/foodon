AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414367 "duck")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414367 "mallard duck")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414367 "mallard ducks")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414367 "anas platyrhynchos"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414367 "duck, wild"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414367 "wild duck"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414367 "mallard"@en)
SubClassOf(obo:FOODON_03414367 obo:FOODON_03411316)
SubClassOf(obo:FOODON_03414367 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_8839))

# Class: obo:FOODON_03414368 (muscovy duck)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414368 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414368 "The Muscovy Duck (*Cairina moschata*) is a large duck native to Mexico, Central, and South America. Small wild and feral breeding populations have established themselves in the United States, particularly in the lower Rio Grande Valley of Texas, as well as in many other parts of North America, including southern Canada. Feral Muscovy Ducks have also been reported in parts of Europe."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414368 <http://eol.org/pages/1048537>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414368 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=175246>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414368 langual:B4368)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414368 "Muscovy Duck (domestic type)")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414368 "muscovy")
