# Class: obo:FOODON_03411309 (beet plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411309 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411309 "The beet (*Beta vulgaris*) is a plant in the Chenopodiaceae family which is now included in *Amaranthaceae* family. It is best known in its numerous cultivated varieties, the most well known of which is the root vegetable known as the beetroot or garden beet. However, other cultivated varieties include the leaf vegetables chard and spinach beet, as well as the root vegetables sugar beet, which is important in the production of table sugar, and mangelwurzel, which is a fodder crop. Three subspecies are typically recognised. All cultivated varieties fall into the subspecies *Beta vulgaris* subsp. *vulgaris*, while *Beta vulgaris* subsp. *maritima*, commonly known as the sea beet, is the wild ancestor of these, and is found throughout the Mediterranean, the Atlantic coast of Europe, the Near East, and India. A second wild subspecies, *Beta vulgaris* subsp. *adanensis*, occurs from Greece to Syria."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411309 "WIKIPEDIA:Beta_vulgaris")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 <http://eol.org/pages/585884>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 obo:NCBITaxon_161934)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300073>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=20681>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 langual:B1309)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411309 "PLANTS:BEVU2")
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411309 "common beet"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411309 "Beta vulgaris L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411309 "beetroot"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411309 "beta vulgaris"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411309 "beet plant"@en)
SubClassOf(obo:FOODON_03411309 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03411309 obo:FOODON_03411566)
