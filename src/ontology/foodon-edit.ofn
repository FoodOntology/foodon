AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4890 "plectascales"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4890 "protascales"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4890 "sac fungi"@en)
