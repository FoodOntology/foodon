# Class: obo:FOODON_03414622 (black snake)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414622 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414622 "The genus *Pseudechis* contains the group of elapids commonly referred to as the black snakes. These snakes are found in every Australian state with the exception of Tasmania and some species are found in Papua New Guinea. The most recognisable and widespread species in the genus are the red-bellied black snake (*Pseudechis porphyriacus*) and the Mulga snake (king brown) (*Pseudechis australis*)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414622 wikipedia:Pseudechis)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414622 <http://eol.org/pages/41193>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414622 langual:B4622)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414622 "pseudechis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414622 "black snake"@en)
SubClassOf(obo:FOODON_03414622 obo:FOODON_03411295)

# Class: obo:FOODON_03414623 (snake-necked turtle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414623 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414623 "Chelodina, collectively known as snake-necked turtles, is an ancient group of Chelid turtles native to Australia, New Guinea, the Indonesian Rote Island, and East Timor."@en)
