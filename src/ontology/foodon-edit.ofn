# Class: obo:FOODON_03411002 (archaeogastropod)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411002 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411002 "Archaeogastropoda (also known as *Aspidobranchia*) was a taxonomic order of sea snails used in older classifications of gastropods, i.e. snails and slugs. *Archeogastropoda* are marine prosobranch gastropod mollusks, mainly mainly herbivores, typically having two gills and a double-chambered heart, with the eggs and sperm discharged directly into the water. They were traditionally regarded as a relatively primitive group. 
[https://en.wikipedia.org/wiki/Archaeogastropoda]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411002 langual:B1002)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411002 "aspidobranchia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411002 "archaeogastropod"@en)
SubClassOf(obo:FOODON_03411002 obo:FOODON_00005713)
SubClassOf(obo:FOODON_03411002 obo:FOODON_03412111)

