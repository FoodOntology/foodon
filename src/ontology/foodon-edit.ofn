AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415133 "PLANTS:GLHE2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415133 "creeping charlie")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415133 "gill-over-the-ground")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415133 "ground ivy")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415133 "glechoma hederacea"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415133 "groundivy"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415133 "nepeta glechoma"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415133 "nepeta hederacea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415133 "ground ivy plant"@en)
