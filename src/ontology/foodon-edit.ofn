AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415093 "Archidendron jiringa (Jack) I.C.Nielsen")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415093 "archidendron jiringa"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415093 "archidendron pauciflorum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415093 "djenkol"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415093 "jengkol plant"@en)
SubClassOf(obo:FOODON_03415093 obo:FOODON_03411156)

# Class: obo:FOODON_03415094 (pine family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415094 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415094 "The *Pinaceae* (pine family) are trees or shrubs, including many of the well-known conifers of commercial importance such as cedars, firs, hemlocks, larches, pines and spruces. The family is included in the order Pinales, formerly known as Coniferales. [https://en.wikipedia.org/wiki/Pinaceae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415094 <http://eol.org/pages/6747>)
