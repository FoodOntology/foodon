AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00003229> "2019-11-04T04:33:29Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00003229> "absinthe"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00003229> <http://purl.obolibrary.org/obo/FOODON_00001817>)

