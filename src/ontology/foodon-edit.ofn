SubClassOf(obo:FOODON_03415041 obo:FOODON_03411179)

# Class: obo:FOODON_03415042 (tahitian vanilla plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415042 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415042 "Vanilla tahitensis is a vine that grows on trees for support. It has zig-zag stems, narrow elliptic leaves and yellowish-green flowers, which are followed by bunches of bean-like pods. As compared to the more widely grown Vanilla planifolia, the pods are shorter and broader, and its taste and fragrance are also distinctive. [https://en.wikipedia.org/wiki/Vanilla_tahitensis]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415042 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?403489>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415042 langual:B5042)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415042 "Vanilla tahitensis J. W. Moore")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415042 "vanilla tahitensis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415042 "tahitian vanilla plant"@en)
SubClassOf(obo:FOODON_03415042 obo:FOODON_03411355)

# Class: obo:FOODON_03415046 (persian lime plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415046 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415046 "Persian lime (*Citrus × latifolia*), also known by other common names such as seedless lime, Bearss lime and Tahiti lime, is a citrus fruit species of hybrid origin, known only in cultivation. The fruit is about 6 centimetres (2.4 in) in diameter, often with slightly nippled ends, and is usually sold while green, although it yellows as it reaches full ripeness. [https://en.wikipedia.org/wiki/Persian_lime]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415046 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?314291>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415046 langual:B5046)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415046 "Citrus latifolia (Yu. Tanaka) Tanaka")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415046 "bearss lime"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415046 "citrus latifolia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415046 "seedless lime"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415046 "tahiti lime"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415046 "persian lime plant"@en)
SubClassOf(obo:FOODON_03415046 obo:FOODON_03411067)

# Class: obo:FOODON_03415047 (mexican hawthorn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415047 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415047 "Crataegus mexicana is a species of hawthorn known by the common names tejocote, manzanita, tejocotera and Mexican hawthorn. The fruit is eaten in Mexico cooked, raw, or canned. It is a main ingredient used in ponche, the traditional Mexican hot fruit punch [https://en.wikipedia.org/wiki/Crataegus_mexicana]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415047 <http://eol.org/pages/8097>)
