AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411538 langual:B1538)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411538 "MANSFELD:110")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411538 "Allium cepa L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411538 "Allium cepa L. var. aggregatum G. Don")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411538 "Allium cepa L. var. aggregatum G.Don")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411538 "allium cepa var. aggregatum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411538 "shallot plant"@en)
