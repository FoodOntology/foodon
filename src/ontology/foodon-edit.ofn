# Class: obo:FOODON_03415142 (jiaogulan plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415142 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415142 "Gynostemma pentaphyllum, also called jiaogulan, is a dioecious, herbaceous climbing vine of the *family Cucurbitaceae* (cucumber or gourd family) indigenous to the southern reaches of China, northern Vietnam, southern Korea, and Japan. Jiaogulan is best known as an herbal medicine reputed to have powerful antioxidant and adaptogenic effects purported to increase longevity. [https://en.wikipedia.org/wiki/Gynostemma_pentaphyllum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415142 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?409268>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415142 langual:B5142)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415142 "Gynostemma pentaphyllum (Thunb.) Makino")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415142 "gynostemma pentaphyllum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415142 "jiaogulan plant"@en)
SubClassOf(obo:FOODON_03415142 obo:FOODON_03413359)

# Class: obo:FOODON_03415144 (lady's mantle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415144 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415144 "Alchemilla is a genus of herbaceous perennial plants in the family *Rosaceae*, with the common name \"lady's mantle\" applied generically as well as specifically to *Alchemilla mollis* when referred to as garden plant, the plant used as herbal tea or for medicinal usage such as gynaecological disorders is *Alchemilla xanthochlora* or in Middle Europe the so-called common lady's mantle *Alchemilla vulgaris*. [https://en.wikipedia.org/wiki/Alchemilla]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415144 <http://eol.org/pages/29928>)
