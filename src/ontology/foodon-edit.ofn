# Class: obo:FOODON_00002483 (ricefield rat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002483 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002483 "The ricefield rat (Rattus argentiventer) is a species of rat found throughout Southeast Asia. Although not a part of staple human diet in Cambodia, a growing market has developed there with most exports going to Vietnam"@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002483 "Damion Dooley"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002483 "rice-field rat"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00002483 "ricefield rat"@en)
SubClassOf(obo:FOODON_00002483 obo:FOODON_03414848)

# Class: obo:FOODON_00002505 (dairy cattle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002505 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002505 "Dairy cattle are a type of cattle bred for the ability to produce large quantities of milk, from which dairy products are made.  This class covers both male and female members of a dairy breed."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002505 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002505 "https://en.wikipedia.org/wiki/Dairy_cattle"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002505 "2019-01-26T22:49:27Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002505 "dairy cattle"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00002505 "https://en.wikipedia.org/wiki/List_of_dairy_cattle_breeds"^^xsd:anyURI)
SubClassOf(obo:FOODON_00002505 obo:FOODON_00002507)

# Class: obo:FOODON_00002507 (taurine cattle)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002507 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002507 "Taurine cattle (Bos taurus taurus), also called European cattle, are a subspecies of domesticated cattle originating in the Near East. Both taurine cattle and indicine cattle (zebus) are descended from the aurochs. Taurine cattle were originally considered a distinct species, but are now typically grouped with zebus and aurochs into one species, Bos taurus. Most modern breeds of cattle are taurine cattle."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002507 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002507 wikipedia:Taurine_cattle)
AnnotationAssertion(dcterms:date obo:FOODON_00002507 "2019-01-28T02:41:04Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_00002507 langual:B5186)
AnnotationAssertion(rdfs:label obo:FOODON_00002507 "taurine cattle"@en)
SubClassOf(obo:FOODON_00002507 obo:NCBITaxon_9913)

# Class: obo:FOODON_00002508 (navel orange plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002508 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002508 "Navel oranges are characterized by the growth of a second fruit at the apex, which protrudes slightly and resembles a human navel. They are primarily grown for human consumption for various reasons: their thicker skin makes them easy to peel, they are less juicy and their bitterness – a result of the high concentrations of limonin and other limonoids – renders them less suitable for juice."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002508 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002508 "https://en.wikipedia.org/wiki/Orange_(fruit)#Navel_oranges"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002508 "2019-01-28T04:42:04Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002508 "navel orange plant"@en)
SubClassOf(obo:FOODON_00002508 obo:FOODON_03411339)

# Class: obo:FOODON_00002517 (food packing medium compromised)

AnnotationAssertion(obo:IAO_0000112 obo:FOODON_00002517 "A can of chickpeas with a packing liquid that is colonized with a pathogen."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002517 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002517 "A compromised food packing medium is a gaseous, liquid, or solid medium that has been exposed to the environment due to a failure in integrity of the food packaging.  The packaging failure may be intentional, e.g. opening a bag, or unintentional, e.g. a tear."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002517 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002517 "http://orcid.org/0000-0001-8008-8249")
AnnotationAssertion(dcterms:date obo:FOODON_00002517 "2019-02-13T21:04:31Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002517 "food packing medium compromised"@en)
SubClassOf(obo:FOODON_00002517 obo:FOODON_03530218)

