# Class: obo:FOODON_03412748 (sea buckthorn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412748 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412748 "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia. It is a spiny deciduous shrub. 
 *H. rhamnoides* is a very versatile plant and the fruits as well as the leaves can be used. The fruits are processed and then used in the food industry, in traditional medicine, as part of drugs or in the cosmetic industry. The leaves can be used as feed, particularly for ruminants. [https://en.wikipedia.org/wiki/Hippophae_rhamnoides]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412748 <http://eol.org/pages/488204>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412748 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?19177>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412748 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=503044>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412748 langual:B2748)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412748 "PLANTS:HIRH80")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412748 "hippophae rhamnoides"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412748 "sallowthorn")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412748 "sea buckthorn")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412748 "sea-buckthorn")
AnnotationAssertion(rdfs:label obo:FOODON_03412748 "sea buckthorn plant"@en)
SubClassOf(obo:FOODON_03412748 obo:FOODON_03411539)
SubClassOf(obo:FOODON_03412748 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_193516))

