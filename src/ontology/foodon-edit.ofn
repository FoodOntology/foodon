AnnotationAssertion(rdfs:label obo:FOODON_03414954 "jostaberry plant"@en)
SubClassOf(obo:FOODON_03414954 obo:FOODON_03411159)

# Class: obo:FOODON_03414955 (golden currant plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414955 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414955 "The golden currant plant (Ribes aureum) is a species in the genus Ribes, native to Canada, most of the United States (except the southeast) and northern Mexico. The berries were used for food, and other plant parts for medicine, by various Native American groups across its range in North America."@en)
