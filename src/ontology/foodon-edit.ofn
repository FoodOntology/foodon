# Class: obo:FOODON_03412209 (king crab family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412209 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412209 "King crabs are a taxon of crab-like decapod crustaceans chiefly found in cold seas. Because of their large size and the taste of their meat, many species are widely caught and sold as food, the most common being the red king crab (*Paralithodes camtschaticus*). [https://en.wikipedia.org/wiki/King_crab]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412209 <http://eol.org/pages/7152>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412209 langual:B2209)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03412209 "Lithodidae Samouelle, 1819")
AnnotationAssertion(go:hasSynonym obo:FOODON_03412209 "king crabs"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412209 "lithodidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412209 "king crab family"@en)
SubClassOf(obo:FOODON_03412209 obo:FOODON_02021446)

# Class: obo:FOODON_03412212 (swimming crab family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412212 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412212 "Portunidae is a family of crabs which contains the swimming crabs. Its members include many well-known shoreline crabs, such as the European shore crab (*Carcinus maenas*), blue crab (*Callinectes sapidus*), velvet crab (*Necora puber*) and lady crab (*Ovalipes ocellatus*). Two genera in the family are contrastingly named *Scylla* and *Charybdis*; the former contains the economically important species black crab (*Scylla serrata*) and *Scylla paramamosain*. [https://en.wikipedia.org/wiki/Portunidae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412212 <http://eol.org/pages/2604866>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412212 langual:B2212)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412212 "portunidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412212 "swimming crabs"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412212 "swimming crab family"@en)
SubClassOf(obo:FOODON_03412212 obo:FOODON_02021446)

