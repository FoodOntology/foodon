AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415080 langual:B5080)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415080 "PLANTS:CABU2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415080 "shepherd's purse")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415080 "capsella bursa-pastoris"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415080 "shepherd's-purse"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415080 "shepherd's purse plant"@en)
SubClassOf(obo:FOODON_03415080 obo:FOODON_03413372)
SubClassOf(obo:FOODON_03415080 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3719))

# Class: obo:FOODON_03415081 (sweet-tea plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415081 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415081 "Chinese sweet tea is a traditional Chinese herbal tea, made from the leaves of Chinese Blackberry (*Rubus suavissimus*). These leaves contain a natural sweetener, called rubusoside, which is 200 times as sweet as cane sugar. The tea has long been used to alleviate kidney symptoms, and a recent Japanese study also indicates that it has anti-inflammatory effects and helps against allergies. [https://en.wikipedia.org/wiki/Chinese_sweet_tea]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415081 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402703>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415081 langual:B5081)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415081 "Rubus suavissimus S. K. Lee")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415081 "chinese blackberry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415081 "rubus suavissimus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415081 "sweet-tea plant"@en)
SubClassOf(obo:FOODON_03415081 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415081 obo:FOODON_03414206)

# Class: obo:FOODON_03415082 (blue fenugreek plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415082 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415082 "Trigonella caerulea (blue fenugreek) is an annual herb in the family *Fabaceae*. Blue fenugreek is widely used in Georgian cuisine, where it is one of the ingredients of the Georgian spice mix. In Switzerland it is used for flavouring the traditional schabziger cheese. [https://en.wikipedia.org/wiki/Trigonella_caerulea]"@en)
