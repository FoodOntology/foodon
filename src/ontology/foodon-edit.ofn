AnnotationAssertion(go:hasDbXref obo:NCBITaxon_289767 langual:B2517)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_289767 "PLANTS:SEAN7")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_289767 "Semecarpus anacardium L. f.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_289767 "markingnut tree"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_289767 "semecarpus anacardium"@en)
SubClassOf(obo:NCBITaxon_289767 obo:FOODON_03411022)

