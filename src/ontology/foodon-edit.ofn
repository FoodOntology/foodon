AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430106 "pulverized"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430106 "finely ground form (sensu food)"@en)
SubClassOf(obo:FOODON_03430106 obo:FOODON_03430136)

# Class: obo:FOODON_03430107 (divided into one or more segments or wedges)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430107 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430107 langual:E0107)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430107 "segmented"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430107 "wedge-shaped"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430107 "LanguaL curation note: Used for solid products that are divided into more than four pieces each of which is the same shape (e.g., wedge of cheese)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430107 "divided into one or more segments or wedges"@en)
SubClassOf(obo:FOODON_03430107 obo:FOODON_03430133)

