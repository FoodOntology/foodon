AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411225 "Rosa spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411225 "rosa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411225 "rosaceae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411225 "rosae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411225 "rose plant"@en)
SubClassOf(obo:FOODON_03411225 obo:FOODON_03411179)

