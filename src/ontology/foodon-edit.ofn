AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_33125> "pepperwort"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_33125> "poor man's pepper"@en)
SubClassOf(<http://purl.obolibrary.org/obo/NCBITaxon_33125> <http://purl.obolibrary.org/obo/FOODON_03411566>)
