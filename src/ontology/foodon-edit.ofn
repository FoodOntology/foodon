# Class: obo:FOODON_03411969 (long whiskered catfish family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411969 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411969 "The *Pimelodidae*, commonly known as the long-whiskered catfishes, are a family of catfishes (order Siluriformes). All species of Pimelodidae are found in South America and the lower Isthmian region. Their range reaches from South America and Panama north to southernmost Mexico. [https://en.wikipedia.org/wiki/Pimelodidae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411969 <http://eol.org/pages/5091>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411969 langual:B1969)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411969 "pimelodidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411969 "long whiskered catfish family"@en)
SubClassOf(obo:FOODON_03411969 obo:FOODON_03411598)

