# Class: obo:NCBITaxon_203015 (Rhodiola rosea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_203015 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_203015 "*Rhodiola rosea* (commonly golden root, rose root, roseroot, Aaron's rod, Arctic root, king's crown, lignum rhodium, orpin rose) is a perennial flowering plant in the family *Crassulaceae*. The leaves and shoots are eaten raw, having a bitter flavor, or cooked like spinach, and are sometimes added to salads. In Russia and Scandinavia, *Rhodiola rosea* has been used for centuries to cope with the cold Siberian climate and stressful life. [https://en.wikipedia.org/wiki/Rhodiola_rosea]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_203015 "roseroot stonecrop plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203015 <http://eol.org/pages/406574>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203015 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?31156>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203015 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=520045>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203015 langual:B5132)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_203015 "PLANTS:RHRO3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_203015 "Rhodiola rosea L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "aaron's rod"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "arctic root"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "golden root"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "king's crown"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "lignum rhodium"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "orpin rhodium"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "rhodiola rosea"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "rose root"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_203015 "roseroot"@en)
SubClassOf(obo:NCBITaxon_203015 obo:FOODON_03413359)

