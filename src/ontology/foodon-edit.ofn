AnnotationAssertion(rdfs:label obo:FOODON_03415098 "locust tree"@en)
SubClassOf(obo:FOODON_03415098 obo:FOODON_03413359)

# Class: obo:FOODON_03415102 (cestrum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415102 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415102 "Cestrum is a genus of - depending on authority - 150-250 species of flowering plants in the family *Solanaceae*. They are native to warm temperate to tropical regions of the Americas. They are colloquially known as cestrums or jessamines (from \"jasmine\", due to their fragrant flowers). 
 All parts of the plants are toxic, causing severe gastroenteritis if eaten. [https://en.wikipedia.org/wiki/Cestrum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415102 <http://eol.org/pages/4437>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415102 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?403889>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415102 langual:B5102)
AnnotationAssertion(go:hasDbXref obo:FOODON_03415102 "PLANTS:CESTR")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415102 "Cestrum")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415102 "Cestrum L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03415102 "Cestrum spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03415102 "cestrums"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03415102 "jessamines"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415102 "cestrum plant"@en)
SubClassOf(obo:FOODON_03415102 obo:FOODON_03414934)

# Class: obo:FOODON_03415103 (lycium plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415103 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415103 "Lycium is a genus of flowering plants in the nightshade family, *Solanaceae*. 
 Common names for the genus include box-thorn, desert-thorn, wolfberry [https://en.wikipedia.org/wiki/Lycium]"@en)
