# Class: obo:FOODON_03415104 (solanum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415104 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415104 "Solanum is a large and diverse genus of flowering plants, which include two food crops of high economic importance, the potato and the tomato. It also contains the nightshades and horse nettles, as well as numerous plants cultivated for their ornamental flowers and fruit. 
 *Solanum* species show a wide range of growing habits, such as annual and perennials, vines, subshrubs, shrubs, and small trees. Many formerly independent genera like *Lycopersicon* (the tomatoes) and *Cyphomandra* are now included in *Solanum* as subgenera or sections. Thus, the genus today contains roughly 1,500-2,000 species."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03415104 wikipedia:Solanum)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415104 <http://eol.org/pages/4437>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415104 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300568>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415104 langual:B5104)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415104 "PLANTS:SOLAN")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415104 "Solanum")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415104 "Solanum L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415104 "Solanum spp.")
AnnotationAssertion(rdfs:label obo:FOODON_03415104 "solanum plant"@en)
SubClassOf(obo:FOODON_03415104 obo:FOODON_03414934)

