AnnotationAssertion(go:hasDbXref obo:NCBITaxon_405322 "PLANTS:PICU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_405322 "Piper cubeba L. f.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_405322 "Piper cubeba L. fil.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_405322 "java pepper"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_405322 "piper cubeba"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_405322 "tailed pepper"@en)
SubClassOf(obo:NCBITaxon_405322 obo:FOODON_03411179)

