AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412967 "PLANTS:TIPL")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412967 "broad-leaved lime")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412967 "tilia platyphyllos"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412967 "bigleaf linden plant"@en)
SubClassOf(obo:FOODON_03412967 obo:FOODON_03412051)
SubClassOf(obo:FOODON_03412967 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_82423))

