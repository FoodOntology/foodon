# Class: obo:NCBITaxon_3908 (Vicia sativa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_3908 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_3908 "*Vicia sativa*, known as the Common Vetch, Tare or simply \"the vetch\", is a nitrogen fixing leguminous plant. Although considered a weed when found growing in a cultivated grainfield, this hardy plant is often grown as green manure or livestock fodder."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3908 "common vetch plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3908 "WIKIPEDIA:Vicia_sativa")
