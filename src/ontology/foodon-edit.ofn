AnnotationAssertion(go:hasDbXref obo:NCBITaxon_4505 "PLANTS:COLA")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_4505 "Coix lacryma-jobi L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_4505 "coix lacryma-jobi"@en)
SubClassOf(obo:NCBITaxon_4505 obo:FOODON_03411047)

