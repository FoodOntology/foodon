AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414958 langual:B4958)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414958 "PLANTS:GASH")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414958 "salal")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414958 "shallon")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414958 "gaultheria shallon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414958 "shallon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414958 "salal plant"@en)
SubClassOf(obo:FOODON_03414958 obo:FOODON_03411231)
SubClassOf(obo:FOODON_03414958 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_73102))

