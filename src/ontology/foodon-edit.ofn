AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414925> "Daemonorops jenkinsiana (Griff.) Mart.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414925> "daemonorops jenkinsiana"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414925> "devil rattan plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414925> <http://purl.obolibrary.org/obo/FOODON_03411286>)

