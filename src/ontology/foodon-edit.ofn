AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414479 "Melanitta fusca deglandi (Bonaparte, 1850)")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414479 "melanitta deglandi"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414479 "melanitta fusca deglandi"@en)
