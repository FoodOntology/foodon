# Class: obo:FOODON_03430144 (food (semisolid))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430144 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430144 "Food material which is in a physical state between a solid and a liquid."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430144 langual:E0144)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "plastic (state)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "pseudoplastic (state)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "quasi-solid"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "semiplastic (state)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "slush"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03430144 "thixotropic (state)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03430144 "LanguaL curation note: Used for soft food products that are formable or spreadable but not pourable. The product may be smooth or contain discrete particles."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430144 "food (semisolid)"@en)
SubClassOf(obo:FOODON_03430144 obo:FOODON_00002454)

