AnnotationAssertion(rdfs:label obo:FOODON_03430176 "gummy"@en)
SubClassOf(obo:FOODON_03430176 obo:FOODON_03430154)

# Class: obo:FOODON_03440003 (not heat-treated)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440003 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440003 langual:F0003)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440003 "not cooked or raw"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440003 "raw or uncooked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440003 "uncooked or raw"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03440003 "LanguaL curation note: Used when no heat treatment was applied or, if the extent of heat applied did not result in significant changes in the food."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440003 "not heat-treated"@en)
SubClassOf(obo:FOODON_03440003 obo:FOODON_03440011)
DisjointClasses(obo:FOODON_03440003 obo:FOODON_03440022)

# Class: obo:FOODON_03440011 (extent of food heat treatment)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440011 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03440011 "Used to broadly characterize a food product based on the extent of heat applied. Heat treatment affects the flavor and textural characteristics of a food and thus consumer preparation time. Heat treatment causes chemical changes and/or reduction of enzyme and of microbial activity and thus affects food safety and shelflife. Specifics of preparation are covered by *G. COOKING METHOD* and *H. TREATMENT APPLIED*. [FDA CFSAN 1995]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440011 langual:F0011)
AnnotationAssertion(rdfs:label obo:FOODON_03440011 "extent of food heat treatment"@en)
SubClassOf(obo:FOODON_03440011 obo:FOODON_00002470)

# Class: obo:FOODON_03440014 (fully heat-treated)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440014 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440014 langual:F0014)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440014 "cooked, fully"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440014 "fully cooked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440014 "ready to eat (cooked)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03440014 "LanguaL curation note: Used when heat was applied to a food product for a time sufficient to fully change its flavor and textural characteristics and to cause significant chemical changes and/or destruction of enzyme and microbial activity. The product can be consumed without further cooking."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440014 "fully heat-treated"@en)
SubClassOf(obo:FOODON_03440014 obo:FOODON_03440022)
DisjointClasses(obo:FOODON_03440014 obo:FOODON_03440018)

# Class: obo:FOODON_03440018 (partially heat-treated)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440018 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440018 langual:F0018)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "brown and serve"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "cooked, partially"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "heat and serve"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "partially baked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "partially cooked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "prebaked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "precooked"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440018 "quick cooking"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03440018 "LanguaL curation note: Used when heat was applied to a food product for a time sufficient to partially change its flavor and textural characteristics and to cause some chemical changes and/or some reduction in enzyme and microbial activity. The product can be readied for consumption in a shortened cooking time. Products labeled 'quick cooking' are often partially heat treated. Some products are consumed partially heat-treated, e.g., pasteurized milk, blanched broccoli, or rare beef."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440018 "partially heat-treated"@en)
SubClassOf(obo:FOODON_03440018 obo:FOODON_03440022)

# Class: obo:FOODON_03440022 (heat-treated)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440022 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440022 langual:F0022)
AnnotationAssertion(rdfs:label obo:FOODON_03440022 "heat-treated"@en)
EquivalentClasses(obo:FOODON_03440022 ObjectUnionOf(obo:FOODON_03440014 obo:FOODON_03440018))
SubClassOf(obo:FOODON_03440022 obo:FOODON_03440011)

# Class: obo:FOODON_03440023 (heat-treated, multiple components, different degrees of treatment)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03440023 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03440023 langual:F0023)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03440023 "multiple heat treatments"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03440023 "LanguaL curation note: Used for foods containing several different components, each of which may have had a different *EXTENT OF HEAT TREATMENT*. An example would be a cheeseburger with a fully cooked bun and meat but a partially cooked slice of cheese and possibly raw tomato and lettuce."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03440023 "heat-treated, multiple components, different degrees of treatment"@en)
SubClassOf(obo:FOODON_03440023 obo:FOODON_03440011)

# Class: obo:FOODON_03460100 (flavoring or spice extract or concentrate)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460100 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000118 obo:FOODON_03460100 "flavoring or spice extract or concentrate added"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460100 langual:H0100)
AnnotationAssertion(rdfs:label obo:FOODON_03460100 "flavoring or spice extract or concentrate"@en)
SubClassOf(obo:FOODON_03460100 obo:FOODON_03460229)

# Class: obo:FOODON_03460110 (smoke concentrate)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460110 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460110 "In modern times, almost all smoking is carried out for its flavor. This flavoring can be purchased as a liquid in most supermarkets to mimic the flavor of smokingnot its preservative qualitieswithout the actual cooking process... Liquid smoke is often used in the processing of bacon, and is one of the main flavors in the curing solution used for bacon. It is also used to flavor jerky and tofu. Liquid smoke is also used in some soft cheeses and tempeh. [Wikipedia]
Liquid smoke is also a common ingredient in many barbecue sauces and meat marinades."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460110 langual:H0110)
AnnotationAssertion(rdfs:label obo:FOODON_03460110 "smoke concentrate"@en)
SubClassOf(obo:FOODON_03460110 obo:FOODON_03460117)

# Class: obo:FOODON_03460117 (flavor or taste ingredient)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460117 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000118 obo:FOODON_03460117 "flavor or taste ingredient added"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460117 langual:H0117)
AnnotationAssertion(rdfs:comment obo:FOODON_03460117 "LanguaL curation note: Used when such an ingredient is added for the purpose of imparting flavor or taste. Processes such as salting and smoking are also used for preservation. If one of these is used as the primary preservation method, the appropriate factor value from *J. PRESERVATION METHOD* (e.g., *preservation by SALTING*) should also be applied."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460117 "flavor or taste ingredient"@en)
SubClassOf(obo:FOODON_03460117 obo:FOODON_03412972)

# Class: obo:FOODON_03460144 (sodium added claim)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03460144 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460144 "A claim that sodium has been added to an edible product."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460144 langual:H0144)
AnnotationAssertion(rdfs:label obo:FOODON_03460144 "sodium added claim"@en)
SubClassOf(obo:FOODON_03460144 obo:FOODON_03460159)

