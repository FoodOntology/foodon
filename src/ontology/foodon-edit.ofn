AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_50174 "Ximenia americana L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "sea lemon"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "tallownut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "tallowwood"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "ximenia americana"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "ximenia citrifolia"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50174 "yellow-plum"@en)
SubClassOf(obo:NCBITaxon_50174 obo:FOODON_03414676)

# Class: obo:NCBITaxon_50193 (Sonchus asper)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_50193 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_50193 "*Sonchus asper* (Sharp-fringed Sow Thistle, Prickly Sow Thistle, Spiny Sow Thistle, or Spiny-leaved Sow Thistle) is an annual plant with spiny leaves and yellow flowers resembling those of the dandelion. The leaves are bluish-green, simple, lanceolate, with wavy and sometimes lobed margins, covered in spines on both the margins and beneath. The base of the leaf surrounds the stem. The plant can reach 180 cm (6 ft) in height. The leaves and stems emit a milky sap when cut. The flowers grow in clusters and the end of the stems.
This plant is native to Europe, but is also a common weed in North American roadsides, landscapes, and pastures. Its edible leaves make a palatable and nutritious leaf vegetable."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_50193 "spinu sowthistle plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_50193 "WIKIPEDIA:Sonchus_asper")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50193 <http://eol.org/pages/492388>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50193 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?34933>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50193 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=38424>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50193 langual:B4299)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_50193 "PLANTS:SOAS")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_50193 "Sonchus asper (L.) Hill")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "prickly sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "rough sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "sharp-fringed sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "sonchus asper"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "spiny leaved sow thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_50193 "spiny-leaf sow thistle"@en)
