AnnotationAssertion(go:hasSynonym obo:FOODON_03414180 "Panellus serotinus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414180 "late fall oyster"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414180 "mukitake"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414180 "A species of fungus in the family Mycenaceae. Fruit bodies grow as overlapping fan- or oyster-shaped caps on the wood of both coniferous and deciduous trees. The gills on the underside are closely spaced, bright orange yellow, and have an adnate attachment to the stipe."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414181 obo:IAO_0000122)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414181 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=148667>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414181 langual:B4181)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414181 "Coprinus comatus (O.F. Müll.) Pers., 1797")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414181 "lawyer's wig"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414181 "sasakurehitoyotake"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414181 "A common fungus often seen growing on lawns, along gravel roads and waste areas. The young fruit bodies first appear as white cylinders emerging from the ground, then the bell-shaped caps open out. The caps are white, and covered with scale."@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414182 obo:IAO_0000122)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414182 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=120231>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414182 langual:B4182)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414182 "Hericium coralloides (Scop.) Pers., 1794")
AnnotationAssertion(rdfs:comment obo:FOODON_03414182 "A saprotrophic fungus, commonly known as the coral tooth fungus. It grows on dead hardwood trees. The species is edible and good when young, but as it ages the branches and hanging spines become brittle and turn a light shade of yellowish brown.[Wikipedia]"@en)
AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414183 obo:IAO_0000122)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414183 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=154470>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414183 langual:B4183)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414183 "witches' butter"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414183 "Tremella mesenterica Retz., 1769")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414183 "koganenikawatake"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414183 "A common jelly fungus in the family Tremellaceae. It is most frequently found on dead but attached and on recently fallen branches, especially of angiosperms, as a parasite of wood decay fungi in the genus Peniophora."@en)
