AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415078 "PLANTS:FIUL")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415078 "filipendula ulmaria"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415078 "queen of the meadow"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415078 "meadowsweet plant"@en)
SubClassOf(obo:FOODON_03415078 obo:FOODON_03413359)
SubClassOf(obo:FOODON_03415078 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_57917))

# Class: obo:FOODON_03415079 (ribwort plantain plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415079 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415079 "Plantago lanceolata is a species of flowering plant in the plantain family *Plantaginaceae*. It is known by the common names ribwort plantain, narrowleaf plantain, English plantain, ribleaf and lamb's tongue. *Plantago lanceolata* is used frequently in herbal teas and other herbal remedies. [https://en.wikipedia.org/wiki/Plantago_lanceolata]"@en)
