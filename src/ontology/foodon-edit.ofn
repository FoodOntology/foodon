AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03414627> "parastacidae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414627> "southern hemisphere crayfish family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414627> <http://purl.obolibrary.org/obo/FOODON_03412686>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414628> (cherax)

