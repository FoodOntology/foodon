AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414275 "itis:166156")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414275 "alfonsin a casta"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414275 "beryx splendens"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414275 "splendid alfonsino"@en)
SubClassOf(obo:FOODON_03414275 obo:FOODON_03412883)
SubClassOf(obo:FOODON_03414275 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_88663))

# Class: obo:FOODON_03414276 (timor deer)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414276 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414276 "The Javan Rusa or Sunda Sambar (*Rusa timorensis*) is a deer native to the islands of Java, Bali and Timor (shared with East Timor) in Indonesia. It is also an introduced species in Irian Jaya, Borneo (Kalimantan), the Lesser Sunda Islands, Maluku, Sulawesi, Australia, Mauritius, New Caledonia, New Zealand, Papua New Guinea, and Réunion."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414276 "WIKIPEDIA:Cervus_timorensis")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414276 <http://eol.org/pages/7685>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414276 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=625050>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414276 langual:B4276)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414276 "Cervus timorensis Blainville, 1822")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414276 "cervus timorensis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414276 "rusa deer"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414276 "timor deer"@en)
SubClassOf(obo:FOODON_03414276 obo:FOODON_03411583)

# Class: obo:FOODON_03414277 (southern queen scallop)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414277 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414277 "A small pectinid species is distributed on the outer continental shelf along the east coast of the South Island, from Kaikoura down to Macquarie Island. There are nine other species in the genus, none of which have attracted commercial interest, probably because of their small size."@en)
