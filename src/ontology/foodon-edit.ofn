# Class: obo:NCBITaxon_392747 (Paullinia cupana)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_392747 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_392747 "Guarana (*Paullinia cupana*, syn. *P. crysan*, *P. sorbilis*) is a climbing plant in the maple family, *Sapindaceae*, native to the Amazon basin and especially common in Brazil. Guarana features large leaves and clusters of flowers, and is best known for its fruit, which is about the size of a coffee bean. As a dietary supplement, guarana is an effective stimulant] it contains about twice the caffeine found in coffee beans (about 2 to 4.5% caffeine in guarana seeds compared to 1 to 2% for coffee beans).."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_392747 "guarana plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_392747 "WIKIPEDIA:Guarana")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 <http://eol.org/pages/483644>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?27031>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506078>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 langual:B2063)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 "MANSFELD:6836")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_392747 "PLANTS:PACU7")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_392747 "brazilian cocoa"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_392747 "paullinia cupana"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_392747 "uabano"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_392747 "Paullinia cupana Kunth")
SubClassOf(obo:NCBITaxon_392747 obo:FOODON_03411047)

# Class: obo:NCBITaxon_39292 (Cyrtosperma merkusii)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_39292 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_39292 "Pulaka (*Cyrtosperma merkusii*), or swamp taro, is a crop grown in Oceania (especially Tuvalu) and an important source of carbohydrates for the area's inhabitants. It is a \"swamp crop\" similar to taro, but \"with bigger leaves and larger, coarser roots.\" Pulaka roots need to be cooked for hours to reduce toxicity in the corms, but are rich in nutrients, especially calcium. Pulaka is an important part of Tuvalu cultural and culinary tradition, now under threat from rising sea level and displacement from the growing use of imported food products."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_39292 "pulaka plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_39292 "WIKIPEDIA:Pulaka")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39292 <http://eol.org/pages/1094951>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39292 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12943>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39292 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506754>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39292 langual:B4279)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_39292 "PLANTS:CYME10")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_39292 "Cyrtosperma merkusii (Hassk.) Schott")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39292 "cyrtosperma merkusii"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39292 "giant swamp taro"@en)
SubClassOf(obo:NCBITaxon_39292 obo:FOODON_03411018)

