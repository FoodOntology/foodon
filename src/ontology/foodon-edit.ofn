AnnotationAssertion(go:hasDbXref obo:NCBITaxon_75356 "CEC1993:341")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_75356 "Mylopharyngodon piceus"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_75356 "black Chinese roach"@en)
