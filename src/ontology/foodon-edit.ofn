AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414669 "stinking passionflower"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414669 "wild maracuja"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414669 "wild watermelon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414669 "fetid passionflower"@en)
