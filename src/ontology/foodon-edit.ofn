SubClassOf(obo:FOODON_03414347 obo:FOODON_03411179)

# Class: obo:FOODON_03414348 (peruvian peppertree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414348 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414348 "Peruvian Pepper (*Schinus molle*, also known as American pepper, Peruvian peppertree, escobilla, false pepper, molle del Peru, pepper tree, peppercorn tree, Californian pepper tree, pirul and Peruvian mastic) is an evergreen tree that grows to 15 meters (50 feet). It is native to the Peruvian Andes. The bright pink fruits of Schinus molle are often sold as \"pink peppercorns\" although S. molle is unrelated to true pepper (Piper nigrum).

Although not related to commercial pepper (*Piper nigrum*) the pink/red berries, like the berries of its close relative the Brazilian pepper (*Schinus terebinthifolius*), are sold as pink peppercorns and often blended with commercial pepper."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414348 <http://eol.org/pages/582275>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414348 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?70668>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414348 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=28811>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414348 langual:B4348)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414348 "PLANTS:SCMO")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414348 "schinus molle"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414348 "peruvian peppertree"@en)
SubClassOf(obo:FOODON_03414348 obo:FOODON_03414347)
SubClassOf(obo:FOODON_03414348 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_43851))

# Class: obo:FOODON_03414349 (west african pebber plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414349 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414349 "West African Pepper, also known as Ashanti Pepper, Benin Pepper, False Cubeb, Guinea Cubeb, Uziza Pepper or (ambiguously) \"Guinea pepper\", called locally kale, kukauabe, masoro, sasema and soro wisa, is a West African spice that corresponds to the dried fruit of *Piper guineense*."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414349 <http://eol.org/pages/402261>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414349 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?28582>)
