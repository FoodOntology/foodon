AnnotationAssertion(rdfs:label obo:FOODON_03412941 "curled endive plant"@en)
SubClassOf(obo:FOODON_03412941 obo:NCBITaxon_114280)

# Class: obo:FOODON_03412942 (broadleaved endive plant)

AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412942 "Escarole, or broad-leaved endive (var *latifolia*), has broad, pale green leaves and is less bitter than the other varieties. Varieties or names include broad-leaved endive, Bavarian endive, Batavian endive, grumolo, scarola, and scarole. It is eaten like other greens, sauteed, chopped into soups and stews, or as part of a green salad."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412942 "https://en.wikipedia.org/wiki/Endive"@en)
