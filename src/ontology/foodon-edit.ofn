AnnotationAssertion(go:hasDbXref obo:FOODON_03411136 langual:B1136)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411136 "MSW3:14200054")
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411136 "porcine"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411136 "sus domesticus"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411136 "sus scrofa"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411136 "sus scrofa domesticus"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411136 "Sus scrofa Linnaeus, 1758")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411136 "hog"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411136 "pig"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411136 "swine"@en)
