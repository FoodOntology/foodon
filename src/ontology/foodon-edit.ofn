AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414051 langual:B4051)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414051 "charr"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414051 "salvelinus spp."@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414051 "Salvelinus Richardson, 1836")
AnnotationAssertion(rdfs:label obo:FOODON_03414051 "char"@en)
SubClassOf(obo:FOODON_03414051 obo:FOODON_03413807)

