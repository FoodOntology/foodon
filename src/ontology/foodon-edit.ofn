AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_48042 "Levisticum officinale W.D.J. Koch")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_48042 "garden lovage"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_48042 "levisticum officinale"@en)
