AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002861> "2019-08-07T20:35:58Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002861> "Fuji apple tree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002861> <http://purl.obolibrary.org/obo/FOODON_03411245>)

