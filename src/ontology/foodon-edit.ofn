# Class: <http://purl.obolibrary.org/obo/FOODON_03414278> (swamp taro plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414278> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414278> "Iaraj (*Cyrtosperma chamissonis - Araceae*). This large, cultivated \"hard\" or \"swamp\" taro has been a very important starchy, staple food source. It reaches heights up to 4-6 m (15-20 ft) and produces huge green to yellowish-green, heart-shaped leaves with tips that point upward.
 Iaraj is an aroid \"root crop\" species probably native to Southeast Asia or wetern Melanesia. Early settlers brought it by canoe to many islands of the tropical Pacific, including the Marshall Islands, in prehistoric times.[http://www.hawaii.edu/cpis/MI/plants/iaraj.html]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414278> <http://eol.org/pages/8191>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414278> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506753>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414278> <http://www.langual.org/langual_thesaurus.asp?termid=B4278>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414278> "PLANTS:CYCH7")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414278> "Cyrtosperma chamissonis (Schott) Merr.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414278> "cyrtosperma chamissonis"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414278> "swamp taro plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414278> <http://purl.obolibrary.org/obo/FOODON_03411018>)

