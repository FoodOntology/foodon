AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03430125> "cut into large pieces"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430125> "divided into pieces, thickness more than 1.5 cm."@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430125> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_03430152> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/FOODON_00002410>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430125> <http://purl.obolibrary.org/obo/FOODON_03430152>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430130> (food (liquid))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430130> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430130> "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of the container."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FOODON_03430130> "fluid"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430130> <http://www.langual.org/langual_thesaurus.asp?termid=E0130>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430130> "Liquids range from water to honey, corresponding to a range in viscosity (or apparent viscosity) from 1 to 500 centipoise (viscosity is a measure of a liquid's resistance to flow). Products that are pourable but have a higher viscosity are *SEMILIQUID*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430130> "food (liquid)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_00002454> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001548>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430130> <http://purl.obolibrary.org/obo/FOODON_00002454>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430131> (whole)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430131> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430131> "Refers to natural or formed shape as appropriate, regardless of size, which may vary from very large (e.g., beef carcass) to very small (e.g., poppy seed, yeast cell)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430131> <http://www.langual.org/langual_thesaurus.asp?termid=E0131>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430131> "whole"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430131> <http://purl.obolibrary.org/obo/FOODON_03430113>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430133> (divided into halves, quarters or segments)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430133> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430133> "Divided into pieces whose shape is defined in relation to the shape of the whole, i.e., halves, quarters, or segments. It is used regardless of the size of the whole."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430133> <http://www.langual.org/langual_thesaurus.asp?termid=E0133>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430133> "divided into halves, quarters or segments"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430133> <http://purl.obolibrary.org/obo/FOODON_03430122>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430134> (semisolid with solid pieces)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430134> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430134> <http://www.langual.org/langual_thesaurus.asp?termid=E0134>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430134> "LanguaL curation note: Used for semisolid products that contain medium or small particles. The particles may be natural or formed whole shapes or may have been produced by dividing or disintegrating solids. Also included are products consisting of medium or small particles that are joined into a semisolid mass by naturally present or added oil, water, or other binding agents. The same particles without the binding agents would be indexed by the appropriate narrower term under *SOLID*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430134> "semisolid with solid pieces"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430134> <http://purl.obolibrary.org/obo/FOODON_03430144>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430135> (semiliquid with smooth consistency)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03430135> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430135> <http://www.langual.org/langual_thesaurus.asp?termid=E0135>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430135> "semiliquid with smooth consistency"@en)
