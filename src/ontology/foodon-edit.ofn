# Class: obo:NCBITaxon_558553 (obo:NCBITaxon_558553)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_558553 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_558553 "A species of oyster found in the southwest Iberian Peninsula, closely related to the Pacific oyster. Although first identified as a native European species, genetic studies have suggested the Portuguese oyster originated from the Pacific coast of Asia and was introduced to Europe by Portuguese trading ships in the 16th century."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_558553 "portuguese oyster"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_558553 wikipedia:Portuguese_oyster)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_558553 <http://eol.org/pages/449553>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_558553 langual:B4898)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_558553 "Crassostrea angulate"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_558553 "Crassostrea angulata")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_558553 "portuguese cupped oyster"@en)
SubClassOf(obo:NCBITaxon_558553 obo:FOODON_03411224)

# Class: obo:NCBITaxon_56268 (Bubo virginianus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_56268 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_56268 "The Great Horned Owl, (*Bubo virginianus*), also known as the Tiger Owl, is a large owl native to the Americas. It is an adaptable bird with a vast range and is the most widely distributed true owl in the Americas."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_56268 "great horned owl"@en)
