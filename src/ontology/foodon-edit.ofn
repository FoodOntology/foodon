# Class: obo:FOODON_02020038 (frog)

AnnotationAssertion(obo:IAO_0000600 obo:FOODON_02020038 "A frog is any member of a diverse and largely carnivorous group of short-bodied, tailless amphibians composing the order *Anura*. The use of the common names \"frog\" and \"toad\" has no taxonomic justification. From a classification perspective, all members of the order *Anura* are frogs, but only members of the family *Bufonidae* are considered \"true toads\". The use of the term \"frog\" in common names usually refers to species that are aquatic or semi-aquatic and have smooth, moist skins; the term \"toad\" generally refers to species that are terrestrial with dry, warty skins. [https://en.wikipedia.org/wiki/Frog]"@en)
AnnotationAssertion(dcterms:date obo:FOODON_02020038 "2024-03-25T01:09:56Z"^^xsd:dateTime)
AnnotationAssertion(go:hasDbXref obo:FOODON_02020038 <http://eol.org/pages/1553>)
AnnotationAssertion(go:hasDbXref obo:FOODON_02020038 langual:B1252)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "anura"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana catesbiana"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana esculenta"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana japonica"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana nigromaculata"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana pipiens"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "rana sylvatica"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "ranidae"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "salientia"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_02020038 "toad"@en)

