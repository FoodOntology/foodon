# Class: obo:NCBITaxon_58933 (Triticum spelta)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_58933 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_58933 "Spelt (*Triticum spelta; Triticum dicoccum*), also known as dinkel wheat or hulled wheat, is a species of wheat cultivated since approximately 5000 BC."@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_58933 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_58933 "spelt plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_58933 wikipedia:Spelt)
AnnotationAssertion(obo:IAO_0000600 obo:NCBITaxon_58933 "Spelt was an important staple in parts of Europe from the Bronze Age to medieval times; it now survives as a relict crop in Central Europe and northern Spain, and has also found a new market as a 'health food'.  Spelt is sometimes considered a subspecies of the closely related species common wheat (*Triticum aestivum*), in which case its botanical name is considered to be *Triticum aestivum* subsp. *spelta*. It is a hexaploid wheat, which means it has six sets of chromosomes.[wikipedia]"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 <http://eol.org/pages/1115243>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?406903>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=42243>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 langual:B2917)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 "MANSFELD:34190")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58933 "PLANTS:TRSP3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_58933 "Triticum aestivum subsp. spelta (L.) Thell.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_58933 "Triticum spelta L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58933 "german wheat"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58933 "triticum aestivum subsp. spelta"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58933 "triticum aestivum, spelta group"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58933 "triticum spelta"@en)
SubClassOf(obo:NCBITaxon_58933 obo:FOODON_03411312)

