AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414369 "anas platyrhynchos dom."@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414369 "long island duck"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414369 "american pekin duck"@en)
SubClassOf(obo:FOODON_03414369 obo:FOODON_03411316)
SubClassOf(obo:FOODON_03414369 ObjectSomeValuesFrom(obo:RO_0001000 obo:NCBITaxon_8839))

# Class: obo:FOODON_03414370 (mulard duck)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414370 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414370 "The Mulard (or Moulard) is a hybrid variety of domestic duck produced by crossing a female Pekin with a male Muscovy Duck. Since the domestic Pekin is descended from the Mallard Duck (*Anas platyrhynchos*) and the Muscovy (*Cairina moschata*) is a separate species, all Mulards are sterile F1 hybrids. Most are bred through artificial insemination, and are sometimes also called \"mule ducks\"."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414370 "WIKIPEDIA:Mulard_duck")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414370 langual:B4370)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414370 "mule duck"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414370 "mulard duck"@en)
SubClassOf(obo:FOODON_03414370 obo:FOODON_03411316)

# Class: obo:FOODON_03414374 (bovine)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414374 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414374 "The biological subfamily *Bovinae* includes a diverse group of 10 genera of medium- to large-sized ungulates, including domestic cattle, the bison, African buffalo, the water buffalo, the yak, and the four-horned and spiral-horned antelopes. The evolutionary relationship between the members of the group is obscure, and their classification into loose tribes rather than formal subgroups reflects this uncertainty. General characteristics include cloven hoofs and usually at least one of the sexes of a species having true horns."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414374 "WIKIPEDIA:Bovinae")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414374 <http://eol.org/pages/2851454>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414374 langual:B4374)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414374 "bovinae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414374 "bovine"@en)
SubClassOf(obo:FOODON_03414374 obo:FOODON_03414381)

