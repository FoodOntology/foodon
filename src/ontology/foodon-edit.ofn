AnnotationAssertion(go:hasDbXref obo:FOODON_03430136 langual:E0136)
AnnotationAssertion(rdfs:comment obo:FOODON_03430136 "LanguaL curation note: Used when particle size is below 0.2 cm."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430136 "disintegrated or ground"@en)
SubClassOf(obo:FOODON_03430136 obo:FOODON_03430122)

