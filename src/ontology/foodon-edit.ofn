# Class: obo:NCBITaxon_51089 (Myristica fragrans)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_51089 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_51089 "The nutmeg tree is any of several species of trees in genus *Myristica*. The most important commercial species is *Myristica fragrans*, an evergreen tree indigenous to the Banda Islands in the Moluccas (or Spice Islands) of Indonesia. The nutmeg tree is important for two spices derived from the fruit: nutmeg and mace. Nutmeg is the actual seed of the tree, while mace is the dried \"lacy\" reddish covering or aril of the seed."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_51089 "nutmeg plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_51089 "WIKIPEDIA:Nutmeg")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 <http://eol.org/pages/596922>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24855>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=18125>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 langual:B1214)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 "MANSFELD:12036")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_51089 "PLANTS:MYFR3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_51089 "Myristica fragrans Houtt.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_51089 "myristica fragrans"@en)
AnnotationAssertion(rdfs:comment obo:NCBITaxon_51089 "LanguaL curation note: When indexing the spice mace made from nutmeg, use *NUTMEG [B1214]* and *ARIL [C0287]*."@en)
SubClassOf(obo:NCBITaxon_51089 obo:FOODON_03411179)

# Class: obo:NCBITaxon_511543 (Piper guineense)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_511543 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_511543 "West African Pepper, also known as Ashanti Pepper, Benin Pepper, False Cubeb, Guinea Cubeb, Uziza Pepper or (ambiguously) \"Guinea pepper\", called locally kale, kukauabe, masoro, sasema and soro wisa, is a West African spice that corresponds to the dried fruit of *Piper guineense*."@en)
