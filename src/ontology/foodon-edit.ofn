# Class: obo:NCBITaxon_9837 (Camelus bactrianus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9837 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9837 "The Bactrian camel (*Camelus bactrianus*) is a large, even-toed ungulate native to the steppes of central Asia. The Bactrian camel has two humps on its back, in contrast to the single-humped dromedary camel."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9837 "bactrian camel"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9837 "WIKIPEDIA:Camelus_bactrianus")
