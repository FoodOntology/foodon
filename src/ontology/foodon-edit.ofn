AnnotationAssertion(go:hasDbXref obo:FOODON_03414827 "APNI:114587")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414827 "Persoonia pinifolia R. Br.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414827 "Persoonia pinifolia R.Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414827 "persoonia pinifoli"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414827 "pine-leaved geebung plant"@en)
SubClassOf(obo:FOODON_03414827 obo:FOODON_03414671)

