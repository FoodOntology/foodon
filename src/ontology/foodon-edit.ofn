AnnotationAssertion(go:hasDbXref obo:NCBITaxon_979180 "CEC1993:1228")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_979180 "Acetes japonicus"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_979180 "Acetes japonicus Kishinouye, 1905")
