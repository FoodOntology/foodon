AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414257 "PLANTS:CASAA")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414257 "PLANTS:CASAS2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414257 "false flax")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414257 "gold-of-pleasure")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414257 "big-seed"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414257 "camelina"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414257 "camelina sativa"@en)
