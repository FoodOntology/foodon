AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58041 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506605>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58041 langual:B5029)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_58041 "PLANTS:PICE2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_58041 "Pinus cembra L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58041 "arolla pine"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58041 "pinus cembra"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_58041 "swiss stone pine"@en)
SubClassOf(obo:NCBITaxon_58041 obo:FOODON_03411083)

