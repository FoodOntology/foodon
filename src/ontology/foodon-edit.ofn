AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414719 "cycadopsida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414719 "cycad plant"@en)
SubClassOf(obo:FOODON_03414719 obo:FOODON_03411058)

# Class: obo:FOODON_03414720 (bowenia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414720 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414720 "Bowenia, genus of two extant and two extinct species of palmlike cycads (family *Stangeriaceae*, not accepted, should be *Zamiaceae*). The genus is endemic to Australia, and both living species are found in Queensland. Both the Byfield fern (*Bowenia serrulata*) and *Bowenia spectabilis* are sometimes cultivated as ornamentals in greenhouses and outdoors in warmer climates.https://global.britannica.com/plant/Bowenia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414720 <http://eol.org/pages/75719>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414720 langual:B4720)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414720 "bovenia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414720 "bowenia plant"@en)
SubClassOf(obo:FOODON_03414720 obo:FOODON_03414719)

# Class: obo:FOODON_03414721 (burrawong plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414721 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414721 "Macrozamia is a genus of 38-40 species of cycads, in the family *Zamiaceae*, all endemic to Australia. The common name burrawang, originally referring to *Macrozamia communis* in the Daruk Australian Aboriginal language, is often used for all the species in the genus. [https://en.wikipedia.org/wiki/Macrozamia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414721 <http://eol.org/pages/30050>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414721 langual:B4721)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414721 "burrawang"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414721 "macrozamia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414721 "burrawong plant"@en)
SubClassOf(obo:FOODON_03414721 obo:FOODON_03414719)

# Class: obo:FOODON_03414722 (cycas plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414722 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414722 "Cycas is the type genus and the only genus recognised in the family *Cycadaceae*. About 113 species are accepted. [https://en.wikipedia.org/wiki/Cycas]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414722 <http://eol.org/pages/53639>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414722 langual:B4722)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414722 "cycas spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414722 "cycas plant"@en)
SubClassOf(obo:FOODON_03414722 obo:FOODON_03414719)

# Class: obo:FOODON_03414723 (lepidozamia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414723 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414723 "Lepidozamia is a genus of two species of cycad, both endemic to Australia. *Lepidozamia hopei* (W.Hill) Regel - northern Queensland; *Lepidozamia peroffskyana* Regel - southeastern Queensland, northeastern New South Wales [https://en.wikipedia.org/wiki/Lepidozamia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414723 <http://eol.org/pages/75720>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414723 langual:B4723)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414723 "lepidozamia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414723 "lepidozamia plant"@en)
SubClassOf(obo:FOODON_03414723 obo:FOODON_03414719)

# Class: obo:FOODON_03414724 (parakeelya plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414724 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414724 "Calandrinia balonensis, commonly known as Parakeelya, is succulent herb native to central Australia. Aborigines traditionally eat the leaves raw or steamed, and roots steamed. The seeds are also ground and eaten as a paste. [https://en.wikipedia.org/wiki/Calandrinia_balonensis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414724 <http://eol.org/pages/6360216>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414724 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?417775>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414724 langual:B4724)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414724 "Parakeelya balonensis (Lindl.) Hershk.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414724 "calandrinia balonensis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414724 "parakeelya balonensis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414724 "parakeelya plant"@en)
SubClassOf(obo:FOODON_03414724 obo:FOODON_03411058)

# Class: obo:FOODON_03414725 (bush banana plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414725 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414725 "Marsdenia australis, commonly known as the bush banana, silky pear or green vine is an Australian native plant. It is found in Central Australia and throughout Western Australia. It is a bush tucker food used by Indigenous Australians. All parts of the bush banana plant are still eaten in the desert today. [https://en.wikipedia.org/wiki/Marsdenia_australis]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414725 <http://eol.org/pages/4280>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414725 langual:B4725)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414725 "leichhardtia australis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414725 "marsdenia australis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414725 "bush banana plant"@en)
SubClassOf(obo:FOODON_03414725 obo:FOODON_03411058)

# Class: obo:FOODON_03414726 (yam daisy plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414726 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414726 "Microseris scapigera is a yellow flowered daisy, perennial, herb, found in New Zealand. It's in a group of plant species, *Cichorieae* (tribe) having milky sap, which includes Chicory and Dandelion. [https://en.wikipedia.org/wiki/Microseris_scapigera]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414726 <http://eol.org/pages/4206>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414726 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24273>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414726 langual:B4726)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414726 "Microseris scapigera (Sol. ex A. Cunn.) Sch. Bip.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414726 "microseris scapigera"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414726 "yam daisy plant"@en)
SubClassOf(obo:FOODON_03414726 obo:FOODON_03411058)

# Class: obo:FOODON_03414727 (waterlily plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414727 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414727 "Nymphaea is a genus of hardy and tender aquatic plants in the family *Nymphaeaceae*. Plants of the genus are known commonly as water lilies. Water lilies have several edible parts. The young leaves and unopened flower buds can be boiled and served as a vegetable. The seeds, high in starch, protein, and oil, may be popped, parched, or ground into flour. Potato-like tubers can be collected from the species Nymphaea tuberosa. [https://en.wikipedia.org/wiki/Nymphaea]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414727 <http://eol.org/pages/60384>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414727 langual:B4727)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414727 "nymphaea spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414727 "nymphaea tuberosa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414727 "water lily"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414727 "waterlily plant"@en)
SubClassOf(obo:FOODON_03414727 obo:FOODON_03411058)

