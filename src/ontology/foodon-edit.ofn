AnnotationAssertion(rdfs:label obo:FOODON_03411129 "trout and salmon family"@en)
SubClassOf(obo:FOODON_03411129 obo:FOODON_03411592)

# Class: obo:FOODON_03411133 (persian melon plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411133 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411133 "Persian melon, binomial name *Cucumis melo*, is a type of melon. It is orange in color and has a strongly netted, unridged rind. It is also known as the \"Patelquat\"."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411133 "WIKIPEDIA:Persian_melon")
