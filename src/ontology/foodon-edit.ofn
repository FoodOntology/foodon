AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412442 "PLANTS:CEAS")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412442 "Asiatic pennywort")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412442 "gotu kola")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412442 "ji xue cao")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412442 "sheep-rot")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412442 "centella asiatica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412442 "hydrocotyle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412442 "hydrocotyle asiatica"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412442 "indian pennywort"@en)
