AnnotationAssertion(go:hasSynonym obo:FOODON_03414160 "odocoileus spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414160 "odocoileus deer"@en)
SubClassOf(obo:FOODON_03414160 obo:FOODON_03411500)

