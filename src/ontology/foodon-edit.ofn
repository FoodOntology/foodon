# Class: obo:FOODON_03415098 (locust tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415098 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415098 "Robinia is a genus of flowering plants in the family Fabaceae, subfamily *Faboideae*, native to North America and northern Mexico. Commonly known as locusts, they are deciduous trees and shrubs growing 4-25 metres (13-82 ft) tall. The flowers are used as tea, and in pancakes. *Robinia flowers* are consumed as fritters in many parts of Europe. [https://en.wikipedia.org/wiki/Robinia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415098 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415098 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?310088>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415098 langual:B5098)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415098 "PLANTS:ROBIN")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415098 "Robinia")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415098 "Robinia L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415098 "Robinia spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415098 "robinia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415098 "robinia pseudoacacia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415098 "locust tree"@en)
SubClassOf(obo:FOODON_03415098 obo:FOODON_03413359)

