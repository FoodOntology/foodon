AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_48106 "Centella asiatica (L.) Urb.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_48106 "Centella asiatica (L.) Urban")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_48106 "centella asiatica"@en)
