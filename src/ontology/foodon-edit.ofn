AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415063 "che berry"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415063 "maclura tricuspidata"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415063 "zhe berry plant"@en)
