AnnotationAssertion(go:hasDbXref obo:NCBITaxon_72446 asfis:ctt)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_72446 "Gibelion catla"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_72446 "major Indian carp"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_72446 "major carp"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_72446 "Catla catla (Hamilton, 1822)")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_72446 "Gibelion catla")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_72446 "catla catla"@en)
