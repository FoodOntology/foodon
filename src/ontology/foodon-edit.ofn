AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411136 "sus scrofa"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411136 "sus scrofa domesticus"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411136 "Sus scrofa Linnaeus, 1758")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411136 "hog"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411136 "pig"@en)
