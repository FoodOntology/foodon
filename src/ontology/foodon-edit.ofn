AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411379 "PLANTS:ZEMAM2")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411379 "Zea mays L. ssp. mays")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411379 "Zea mays L. subsp. mays")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411379 "Zea mays ssp. mays L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "corn, field"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "dent corn"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "flint corn"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "maize"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "podcorn"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "zea mays var. indentata (not acc.)"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411379 "zea mays var. indurata (not acc.)"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411379 "Field corn is a general term used in North America for corn varieties other than sweet corn, popcorn, yellow food grade corn used for yellow corn meal or flour and corn starch, and white food-grade corn used for white meal or flour and corn starch. Source: https://en.wikipedia.org/wiki/Field_corn

LanguaL curation note: Searching note--use 'field corn' for any breakfast cereal or snack food having 'corn' as the first ingredient."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411379 "field corn plant"@en)
