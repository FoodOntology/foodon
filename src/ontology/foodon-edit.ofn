AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03510193 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03510193 langual:P0193)
AnnotationAssertion(rdfs:label obo:FOODON_03510193 "low alcohol claim"@en)
SubClassOf(obo:FOODON_03510193 obo:FOODON_03510115)

