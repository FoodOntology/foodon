# Class: obo:FOODON_03414346 (tucum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414346 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414346 "Astrocaryum vulgare (common names Tucum or Tucumã-do-Pará in Brazil, Aouara in French Guiana, Wara awara in Guyana, awarra in Suriname, Chontilla in Ecuador) is a palm native to Amazon Rainforest vegetation, typical of the Pará state in Brazil. This plant has edible fruit, which are also used for biodiesel production. This plant is cited in Flora Brasiliensis by Carl Friedrich Philipp von Martius.[]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414346 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?5941>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414346 langual:B4346)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414346 "Astrocaryum vulgare Mart.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414346 "astrocaryum vulgare"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414346 "awarra palm"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414346 "tucuma"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414346 "tucum plant"@en)
SubClassOf(obo:FOODON_03414346 obo:FOODON_03411017)

# Class: obo:FOODON_03414347 (peppertree plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414347 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414347 "Schinus is a genus of flowering trees and tall shrubs in the sumac family, *Anacardiaceae*. Members of the genus are commonly known as pepper trees."@en)
