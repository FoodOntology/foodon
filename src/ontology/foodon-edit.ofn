# Class: obo:FOODON_03411247 (caper plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411247 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411247 "Capparis spinosa, the caper bush, also called Flinders rose, is a perennial plant that bears rounded, fleshy leaves and large white to pinkish-white flowers.  The plant is best known for the edible flower buds (capers), often used as a seasoning, and the fruit (caper berries), both of which are usually consumed pickled."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03411247 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411247 wikipedia:Caper)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411247 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8897>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411247 langual:B1247)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411247 "MANSFELD:24347")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411247 "Capparis spinosa L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411247 "capparis spinosa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411247 "caper plant"@en)
SubClassOf(obo:FOODON_03411247 obo:FOODON_03414695)

# Class: obo:FOODON_03411248 (rapeseed plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411248 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411248 "Rapeseed (*Brassica napus*), also known as rape, oilseed rape, charlock (and, in the case of one particular group of cultivars, canola), is a bright-yellow flowering member of the family *Brassicaceae* (mustard or cabbage family), cultivated mainly for its oil-rich seed. It is the third-largest source of vegetable oil in the world. [https://en.wikipedia.org/wiki/Rapeseed]"@en)
