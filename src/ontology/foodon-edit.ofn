AnnotationAssertion(go:hasSynonym obo:FOODON_03415155 "oswego tea"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415155 "beebalm plant"@en)
SubClassOf(obo:FOODON_03415155 obo:FOODON_03413359)

# Class: obo:FOODON_03415156 (pussytoes plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415156 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415156 "Antennaria is a genus of herbaceous perennial plants in the family *Asteraceae*, native to temperate regions of the Northern Hemisphere. Common names include catsfoot or cat's-foot, pussytoes and everlasting.
[https://en.wikipedia.org/wiki/Antennaria]"@en)
