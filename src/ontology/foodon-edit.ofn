# Class: obo:FOODON_03411322 (rice plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411322 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411322 "Oryza sativa, commonly known as Asian rice, is the plant species most commonly referred to in English as rice.  *Oryza sativa* contains two major subspecies: the sticky, short-grained *japonica* or *sinica* variety, and the nonsticky, long-grained *indica* variety."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 <http://eol.org/pages/1115098>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?26077>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=41976>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 langual:B1322)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 "MANSFELD:20986")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411322 "PLANTS:ORSA")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411322 "lowland rice"@en)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411322 "upland rice"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03411322 "Rice occurs in a variety of colors, including white, brown, black, purple, and red rices. Black rice (also known as purple rice) is a range of rice types, some of which are glutinous rice. Varieties include Indonesian black rice and Thai jasmine black rice."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411322 "rice plant"@en)
SubClassOf(obo:FOODON_03411322 obo:FOODON_03411324)
SubClassOf(obo:FOODON_03411322 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4530))

