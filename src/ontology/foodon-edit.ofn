AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414915 "Limonium Mill.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414915 "Limonium spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414915 "limonium"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414915 "sealavender"@en)
