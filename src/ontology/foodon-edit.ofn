SubClassOf(obo:FOODON_03412214 obo:FOODON_03412106)

# Class: obo:FOODON_03412215 (mud crab family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412215 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412215 "Mud crab may refer to any crab that lives in or near mud, such as: species from family *Portunidae*, such as *Scylla serrata*; *Scylla tranquebarica*; *Scylla paramamosain*; members of the family *Panopeidae*, such as *Panopeus herbstii*; members of the family *Xanthidae*; *Helice crassa*, the tunnelling mud crab. [https://en.wikipedia.org/wiki/Mud_crab]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412215 <http://eol.org/pages/7194>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412215 langual:B2215)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "mud crabs"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "panopeidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "pebble crabs"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "portunidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "rubble crabs"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "scylla spp."@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412215 "xanthidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412215 "mud crab family"@en)
SubClassOf(obo:FOODON_03412215 obo:FOODON_02021446)

# Class: obo:FOODON_03412218 (coconut crab family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412218 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412218 "Coenobitidae are the family of terrestrial hermit crabs, widely known for their land-living habits. They are found in coastal tropical regions around the world and require access to the ocean to breed. There are 17 species in two genera: Coenobita Latreille, 1829; Birgus Leach, 1816. [https://en.wikipedia.org/wiki/Coenobitidae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412218 <http://eol.org/pages/2604272>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03412218 langual:B2218)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412218 "coenobitidae"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03412218 "land hermit crabs"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412218 "coconut crab family"@en)
SubClassOf(obo:FOODON_03412218 obo:FOODON_02021446)

