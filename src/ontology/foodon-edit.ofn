AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414258 "Crataegus azarolus L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414258 "crataegus azarolus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414258 "mediterranean-medlar"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414258 "azarole plant"@en)
SubClassOf(obo:FOODON_03414258 obo:FOODON_03411708)

# Class: obo:FOODON_03414259 (salmonberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414259 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414259 "Rubus spectabilis (Salmonberry) is a species of *Rubus* native to the west coast of North America from west central Alaska to California. Salmonberries are edible and share the fruit structure of the raspberry, with the fruit pulling away from its receptacle. Books often call the fruit \"insipid\", but depending on ripeness and site, they are good eaten raw and when processed into jam, candy, jelly and wine. They were an important food for indigenous peoples. Traditionally, the berries were eaten with salmon or mixed with oolichan grease or salmon roe. They were not dried because of their high moisture content."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414259 <http://eol.org/pages/244454>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414259 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32449>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414259 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25051>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414259 langual:B4259)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414259 "PLANTS:RUSP")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414259 "rubus spectabilis"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414259 "salmonberry plant"@en)
SubClassOf(obo:FOODON_03414259 obo:FOODON_03411121)
SubClassOf(obo:FOODON_03414259 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_59499))

# Class: obo:FOODON_03414260 (thimbleberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414260 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414260 "Rubus parviflorus, commonly called thimbleberry or salmonberry, is a species of *Rubus*, native to western and northern North America.  Thimbleberry fruits are larger, flatter, and softer than raspberries, and have many small seeds. Because the fruit is so soft, it does not pack or ship well, so thimbleberries are rarely cultivated commercially. However, wild thimbleberries make an excellent jam which is sold as a local delicacy. The fruits can be eaten raw or dried."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 <http://eol.org/pages/237187>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32408>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25007>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 langual:B4260)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 "PLANTS:RUPA")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 "PLANTS:RUPAP2")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414260 "PLANTS:RUPAV")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414260 "rubus parviflorus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414260 "salmonberry"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414260 "thimbleberry plant"@en)
SubClassOf(obo:FOODON_03414260 obo:FOODON_03411121)
SubClassOf(obo:FOODON_03414260 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_59496))

# Class: obo:FOODON_03414261 (wineberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414261 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414261 "Rubus phoenicolasius (Japanese Wineberry, Wineberry, or Wine Raspberry) is a species of raspberry (*Rubus* subgenus *Idaeobatus*) native to northern China, Japan, and Korea.  The species was introduced to Europe and North America as an ornamental plant and for its potential in breeding hybrid raspberries. It has subsequently escaped from cultivation and become naturalised and sometimes invasive in parts of Europe and eastern North America."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414261 <http://eol.org/pages/632717>)
