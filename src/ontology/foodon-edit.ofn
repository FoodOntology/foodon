AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430163 langual:E0163)
AnnotationAssertion(rdfs:comment obo:FOODON_03430163 "LanguaL curation note: Use to index granules for oral solution."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430163 "food supplement granules"@en)
SubClassOf(obo:FOODON_03430163 obo:FOODON_03430162)

