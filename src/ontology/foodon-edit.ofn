AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13385 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=23634>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13385 langual:B5137)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_13385 "PLANTS:CAVU")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_13385 "Calluna vulgaris (L.) Hull")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_13385 "calluna vulgaris"@en)
SubClassOf(obo:NCBITaxon_13385 obo:FOODON_03413359)

