# Class: <http://purl.obolibrary.org/obo/NCBITaxon_57926> (Argentina anserina)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_57926> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "*Argentina anserina* is a synonym of *Potentilla anserina* L., the accepted name of a perennial flowering plant in the rose family, *Rosaceae*. It is known by the common names \"silverweed\", common silverweed or silver cinquefoil. It was formerly believed to be useful for epilepsy, and that it could ward off witches and evil spirits. The plant has been cultivated as a food crop for its edible roots. [https://en.wikipedia.org/wiki/Argentina_anserina]"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "silverweed plant"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_57926> <http://eol.org/pages/301011>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_57926> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?29465>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_57926> <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24687>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_57926> <http://www.langual.org/langual_thesaurus.asp?termid=B5148>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "PLANTS:ARAN7")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "Argentina anserina (L.) Rydb.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "Potentilla anserina L.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "argentina anserine"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/NCBITaxon_57926> "potentilla anserina"@en)
