# Class: obo:NCBITaxon_119260 (Cinnamomum aromaticum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_119260 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_119260 "*Cinnamomum cassia*, called Chinese cassia or Chinese cinnamon, is an evergreen tree originating in southern China, and widely cultivated there and elsewhere in southern and eastern Asia. It is one of several species of *Cinnamomum* used primarily for their aromatic bark, which is used as a spice. In the United States, Chinese cassia is the most common type of cinnamon used. The buds are also used as a spice, especially in India, and were once used by the ancient Romans. [https://en.wikipedia.org/wiki/Cinnamomum_cassia]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_119260 "chinese cinnamon plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 <http://eol.org/pages/483593>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?70182>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=834866>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 langual:B1572)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 "MANSFELD:15074")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_119260 "PLANTS:CIAR8")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_119260 "chinese cinnamon"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_119260 "Cinnamomum aromaticum Nees")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_119260 "Cinnamomum cassia (L.) D. Don")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_119260 "cassia, chinese"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_119260 "cinnamomum aromaticum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_119260 "cinnamomum cassia"@en)
SubClassOf(obo:NCBITaxon_119260 obo:FOODON_03411472)

# Class: obo:NCBITaxon_1192867 (Chroicocephalus ridibundus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_1192867 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_1192867 "The black-headed gull (*Chroicocephalus ridibundus*) is a small gull which breeds in much of Europe and Asia, and also in coastal eastern Canada."@en)
