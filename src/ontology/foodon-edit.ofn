AnnotationAssertion(Annotation(dcterms:license <https://creativecommons.org/licenses/by/2.0>) Annotation(dcterms:rightsHolder "Daniel Jolivet") schema:image obo:FOODON_00002997 <https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Saint-Aignan_%28Loir-et-Cher%29._Okapi.jpg/640px-Saint-Aignan_%28Loir-et-Cher%29._Okapi.jpg>)
