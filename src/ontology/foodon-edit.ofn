AnnotationAssertion(go:hasDbXref obo:FOODON_03414495 langual:B4495)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414495 "PLANTS:POAL11")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414495 "Aconogonon alaskanum (Small) Sojak")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414495 "Polygonum alpinum All.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414495 "aconogonon alaskanum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414495 "polygonum alaskanum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414495 "alaska wild rhubarb plant"@en)
SubClassOf(obo:FOODON_03414495 obo:FOODON_03414494)

# Class: obo:FOODON_03414500 (ground squirrel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414500 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414500 "Spermophilus is a genus of ground squirrels in the family *Sciuridae*. The majority of ground squirrel species, over 40 in total, are usually placed in this genus. However, *Spermophilus* in the broad sense has been found to be paraphyletic to the certainly distinct prairie dogs, marmots, and antelope squirrels, so it has been split into several genera by Kristofer Helgen and colleagues."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414500 "WIKIPEDIA:Spermophilus")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414500 <http://eol.org/pages/15104>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414500 langual:B4500)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414500 "spermophilus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414500 "ground squirrel"@en)
SubClassOf(obo:FOODON_03414500 obo:FOODON_03411389)

# Class: obo:FOODON_03414501 (arctic ground squirrel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414501 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414501 "The Arctic ground squirrel (*Urocitellus parryii*) is a species of ground squirrel native to the Arctic. People in Alaska, particularly around the Aleutians, refer to them as \"Parka\" (pronounced \"par'kee\") squirrels. probably because their pelt is good for making the fur edging on the hoods of Parka style jackets."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414501 "WIKIPEDIA:Spermophilus_parryii")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414501 <http://eol.org/pages/8703>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414501 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180146>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414501 langual:B4501)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414501 "Spermophilus parryii (Richardson, 1825)")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414501 "spermophilus parryii"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414501 "urocitellus parryii"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414501 "arctic ground squirrel"@en)
SubClassOf(obo:FOODON_03414501 obo:FOODON_03414500)

# Class: obo:FOODON_03414505 (scallop squash plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414505 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414505 "Pattypan squash, sunburst squash, cibleme in Cajun French, white squash, scallopini or yellow squash in Australian English, is a summer squash (species *Cucurbita pepo*) notable for its small size, round and shallow shape, and scalloped edges, somewhat resembling a small toy top, or flying saucer."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414505 "WIKIPEDIA:Pattypan_squash")
AnnotationAssertion(go:hasDbXref obo:FOODON_03414505 langual:B4505)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414505 "pattypan squash plant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414505 "scallop squash plant"@en)
SubClassOf(obo:FOODON_03414505 obo:FOODON_03411190)

