# Class: <http://purl.obolibrary.org/obo/FOODON_03412553> (fish, lamniform)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03412553> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412553> "The Lamniformes are an order of sharks commonly known as mackerel sharks (which may also refer specifically to the family *Lamnidae*). It includes some of the most familiar species of sharks, such as the great white and extinct megalodon, as well as more unusual representatives, such as the goblin shark and megamouth shark. [https://en.wikipedia.org/wiki/Lamniformes]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412553> <http://eol.org/pages/1874>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412553> <http://www.langual.org/langual_thesaurus.asp?termid=B2553>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412553> "lamniformes"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412553> "mackerel shark"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412553> "fish, lamniform"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412553> <http://purl.obolibrary.org/obo/FOODON_03411007>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03412554> (guajillo pepper plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03412554> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412554> "A guajillo chili or guajillo chile is a variety of chile pepper of the species *Capsicum annuum* which is widely used in the cuisine of Mexico. Its heat (rating 2,500 to 5,000 on the Scoville scale) is considered mild to medium. [https://en.wikipedia.org/wiki/Guajillo_chili]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412554> <http://www.langual.org/langual_thesaurus.asp?termid=B2554>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412554> "pepper, guajillo"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412554> "guajillo pepper plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412554> <http://purl.obolibrary.org/obo/FOODON_03411643>)

