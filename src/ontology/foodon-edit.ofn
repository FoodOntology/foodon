AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_219879 "Syzygium eucalyptoides (F. Muell.) B. Hyland")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219879 "bush apple"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219879 "love apple"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_219879 "syzygium eucalyptoides"@en)
