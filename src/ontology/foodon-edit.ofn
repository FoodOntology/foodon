# Class: obo:FOODON_03414934 (solanaceae plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414934 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414934 "The *Solanaceae*, or nightshades, are an economically important family of flowering plants. Many members of the family contain potent alkaloids, and some are highly toxic, but many, including tomatoes, potatoes, eggplant, bell/chili peppers, and tobacco are widely used. The *Solanaceae* consists of about 98 genera and some 2,700 species, with a great diversity of habitats, morphology and ecology. [https://en.wikipedia.org/wiki/Solanaceae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414934 <http://eol.org/pages/4437>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414934 langual:B4934)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414934 "nightshade family"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414934 "solanaceae plant"@en)
SubClassOf(obo:FOODON_03414934 obo:FOODON_03413357)

# Class: obo:FOODON_03414935 (armenian cucumber plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414935 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414935 "The Armenian cucumber, *Cucumis melo* var. *flexuosus*, is a type of long, slender fruit which tastes like a cucumber and looks somewhat like a cucumber inside. It is actually a variety of muskmelon (*C. melo*), a species closely related to the cucumber (*C. sativus*). It is also known as the yard-long cucumber, snake cucumber, snake melon, and uri in Japan. It should not be confused with the snake gourds (*Trichosanthes* spp.). [https://en.wikipedia.org/wiki/Armenian_cucumber]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414935 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12569>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414935 langual:B4935)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414935 "Cucumis melo var. flexuosus (L.) Naudin")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414935 "cucumis melo flexuosus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414935 "serpent melon"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414935 "snake melon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414935 "armenian cucumber plant"@en)
SubClassOf(obo:FOODON_03414935 obo:FOODON_03414459)

# Class: obo:FOODON_03414936 (pointed gourd plant)

