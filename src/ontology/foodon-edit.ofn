# Class: obo:NCBITaxon_114287 (Scolymus hispanicus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_114287 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_114287 "*Scolymus hispanicus*, the common golden thistle or Spanish oyster thistle, is a flowering plant in the genus *Scolymus* in the family *Asteraceae*, native to southern and western Europe, north to northwestern France. Although it has been cultivated at times, currently most of the plant which is consumed comes from harvesting of wild plant. Very popular in almost every province of Spain, where it's usually eaten in stews during Spring time. It's also used in salads, soups and with scrambled eggs in Andalusia, Spain, where it is called \"tagarnina\". [https://en.wikipedia.org/wiki/Scolymus_hispanicus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_114287 "golden thistle plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114287 <http://eol.org/pages/485030>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114287 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33399>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114287 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505088>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114287 langual:B4940)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114287 "PLANTS:SCHI")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_114287 "Scolymus hispanicus L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_114287 "scolymus hispanicus"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_114287 "spanish oysterplant"@en)
SubClassOf(obo:NCBITaxon_114287 obo:FOODON_03411566)

# Class: obo:NCBITaxon_114289 (Pseudopodospermum hispanicum)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_114289 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_114289 "*Scorzonera hispanica*, black salsify or Spanish salsify, also known as black oyster plant, serpent root, viper's herb, viper's grass or simply scorzonera, is a perennial member of the genus Scorzonera in the sunflower family (*Asteraceae*), cultivated as a root vegetable in the same way as purple salsify (*Tragopogon porrifolius*), also in the sunflower family. [https://en.wikipedia.org/wiki/Scorzonera_hispanica]"@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_114289 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_114289 "black salsify plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 <http://eol.org/pages/485033>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33412>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505091>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 langual:B2962)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 "MANSFELD:32155")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114289 "PLANTS:SCHI2")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_114289 "scorzonera hispanica"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_114289 "spanish salsify"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_114289 "Scorzonera hispanica L.")
SubClassOf(obo:NCBITaxon_114289 obo:FOODON_03411551)

# Class: obo:NCBITaxon_114937 (Prunus spinosa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_114937 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_114937 "*Prunus spinosa* (blackthorn, or sloe) is a species of flowering plant in the rose family Rosaceae. It is native to Europe, western Asia, and locally in northwest Africa. It is also locally naturalised in New Zealand and eastern North America. 
 The fruit is similar to a small damson or plum, suitable for preserves, but rather tart and astringent for eating, unless it is picked after the first few days of autumn frost. The juice is used in the manufacture of fake port wine, and used as an adulterant to impart roughness to genuine port. In rural Britain a liqueur is made by infusing gin with sloes and sugar. [https://en.wikipedia.org/wiki/Prunus_spinosa]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_114937 "sloe plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114937 <http://eol.org/pages/632461>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114937 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30116>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114937 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24802>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114937 langual:B3325)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_114937 "PLANTS:PRSP")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_114937 "Prunus spinosa L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_114937 "blackthorn"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_114937 "prunus spinosa"@en)
SubClassOf(obo:NCBITaxon_114937 obo:FOODON_03411539)

