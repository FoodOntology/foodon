AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413709 "Flanders poppy")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413709 "common poppy")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413709 "corn poppy")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413709 "field poppy")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413709 "common poppy"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413709 "coquelicot"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413709 "field poppy"@en)
