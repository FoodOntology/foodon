AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414628 "Cherax spp. except Cherax quadricarinatus, Cherax cainii & Cherax tenuimanus")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414628 "yabby crayfish"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414628 "cherax"@en)
SubClassOf(obo:FOODON_03414628 obo:FOODON_03414627)

