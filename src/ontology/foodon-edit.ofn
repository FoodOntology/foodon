# Class: obo:FOODON_03411271 (bamboo plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411271 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411271 "The bamboos are evergreen perennial flowering plants in the subfamily *Bambusoideae* of the grass family *Poaceae*.  Although the shoots (new culms that come out of the ground) of bamboo contain a toxin taxiphyllin (a cyanogenic glycoside) that produces cyanide in the gut, proper processing renders them edible. They are used in numerous Asian dishes and broths, and are available in supermarkets in various sliced forms, in both fresh and canned versions. 
[https://en.wikipedia.org/wiki/Bamboo]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411271 <http://eol.org/pages/8223>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411271 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312261>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411271 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=193439>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411271 langual:B1271)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411271 "MANSFELD:18979")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411271 "Bambusa  Schreb.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411271 "Bambusa spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411271 "bambusa spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411271 "bamboo plant"@en)
SubClassOf(obo:FOODON_03411271 obo:FOODON_03411005)

