AnnotationAssertion(rdfs:label obo:FOODON_03413716 "broadleaf wild leek plant"@en)
SubClassOf(obo:FOODON_03413716 obo:NCBITaxon_4681)

# Class: obo:FOODON_03413717 (sea beet plant)

