AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430116> "LanguaL curation note: Used for solid products that are divided into two identical pieces (e.g., peach halves)."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430116> "divided into halves"@en)
