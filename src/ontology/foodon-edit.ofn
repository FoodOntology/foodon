AnnotationAssertion(go:hasDbXref obo:NCBITaxon_169607 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=38487>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_169607 langual:B5000)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_169607 "PLANTS:TAMI3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_169607 "Tagetes minuta L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_169607 "stinkweed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_169607 "tagetes minuta"@en)
SubClassOf(obo:NCBITaxon_169607 obo:FOODON_03414999)

# Class: obo:NCBITaxon_170351 (Mitragyna speciosa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_170351 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_170351 "Kratom  (Mitragyna speciosa) is a tropical evergreen tree in the coffee family native to Southeast Asia. M. speciosa is indigenous to Thailand, Indonesia, Malaysia, Myanmar, and Papua New Guinea, where it has been used in traditional medicines since at least the nineteenth century. Kratom has opioid properties and some stimulant-like effects."@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_170351 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_170351 "kratom"@en)
