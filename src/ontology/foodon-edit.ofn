AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414531 asfis:iot)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414531 "little cuttle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414531 "sepiola atlantica"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414531 "atlantic bobtail"@en)
