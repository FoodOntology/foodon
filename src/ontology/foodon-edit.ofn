AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3670 "Luffa aegyptiaca P. Mill.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3670 "dishcloth gourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3670 "dishrag gourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3670 "loofah"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3670 "luffa"@en)
