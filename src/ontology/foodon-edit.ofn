# Class: obo:NCBITaxon_78064 (Cetraria islandica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_78064 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_78064 "Iceland moss (*Cetraria islandica*) is a lichen whose erect or ascending foliaceous habit gives it something of the appearance of a moss, whence probably the name. It is often of a pale chestnut color, but varies considerably, being sometimes almost entirely greyish white; and grows to a height of from 3 to 4 in., the branches being channelled or rolled into tubes, which terminate in flattened lobes with fringed edges."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_78064 "iceland moss"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_78064 "WIKIPEDIA:Cetraria_islandica")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_78064 <http://eol.org/pages/2858645>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_78064 <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=382416>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_78064 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=190618>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_78064 langual:B2346)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_78064 "PLANTS:CEIS60")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_78064 "Cetraria islandica (L.) Ach.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_78064 "Cetraria islandica (L.) Ach., 1803")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_78064 "cetraria islandica"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_78064 "iceland lichen"@en)
SubClassOf(obo:NCBITaxon_78064 obo:FOODON_03412345)

