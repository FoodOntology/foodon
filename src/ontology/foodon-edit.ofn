AnnotationAssertion(rdfs:label obo:FOODON_03414662 "davidson plum plant"@en)
SubClassOf(obo:FOODON_03414662 obo:FOODON_03413387)

# Class: obo:FOODON_03414663 (elaeocarpus plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414663 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414663 "Elaeocarpus is a genus of tropical and subtropical evergreen trees and shrubs. The approximately 350 species are distributed from Madagascar in the west through India, Southeast Asia, Malaysia, southern China, and Japan, through Australia to New Zealand, Fiji, and Hawaii in the east. The islands of Borneo and New Guinea have the greatest concentration of species. These trees are well-known for their attractive, pearl-like fruit which are often colorful. [https://en.wikipedia.org/wiki/Elaeocarpus]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414663 <http://eol.org/pages/60894>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414663 langual:B4663)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414663 "elaeocarpus spp."@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414663 "quandong"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414663 "elaeocarpus plant"@en)
SubClassOf(obo:FOODON_03414663 obo:FOODON_03411024)

# Class: obo:FOODON_03414664 (quandong plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414664 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414664 "Santalum acuminatum, the desert quandong, is a hemiparasitic plant in the Sandalwood family *Santalaceae*, widely dispersed throughout the central deserts and southern areas of Australia. The species, especially its fruit, is also referred to as quandong or native peach. The use of the fruit as an exotic flavouring, one of the best known bushfoods, has led to the attempted domestication of the species.[https://en.wikipedia.org/wiki/Santalum_acuminatum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414664 <http://eol.org/pages/4406>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414664 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312969>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414664 langual:B4664)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414664 "Santalum acuminatum (R. Br.) A. DC.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "burn-burn"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "desert quandong"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "native peach"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "santalum acuminatum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "sweet ouandong"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "sweet quandong"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414664 "western quandong"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414664 "quandong plant"@en)
SubClassOf(obo:FOODON_03414664 obo:FOODON_03414786)

# Class: obo:FOODON_03414665 (blue quandong plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414665 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414665 "Elaeocarpus angustifolius is a rainforest tree in the *Elaeocarpaceae* family, bearing bitter edible fruit. It is commonly known as blue marble tree, and also as blue fig or blue quandong, although it is not closely related to figs. The junior synonym Elaeocarpus grandis, from a later description of the species by Ferdinand von Mueller, is also frequently found. A large tree up to 50 metres tall, usually with elaborate buttressed roots. It is found in the eastern Australian States Queensland and New South Wales and New Caledonia. The fruit of this species is round and blue, between 20 and 30 mm across, and has a seed with deep convolutions in its shell.[https://en.wikipedia.org/wiki/Elaeocarpus_angustifolius]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414665 <http://eol.org/pages/4322>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414665 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?14957>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414665 langual:B4665)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414665 "Elaeocarpus sphaericus (Gaertn.) K. Schum.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414665 "blue fig"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414665 "blue marble"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414665 "elaeocarpus angustifolius"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414665 "elaeocarpus grandis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414665 "elaeocarpus sphaericus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414665 "blue quandong plant"@en)
SubClassOf(obo:FOODON_03414665 obo:FOODON_03414663)

# Class: obo:FOODON_03414666 (flacourtia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414666 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414666 "Flacourtia is a genus of flowering plants in the willow family, *Salicaceae*. It contains 15 species of shrubs and small trees that are native to the African and Asian tropics and subtropics. Several species, especially *Flacourtia indica*, are cultivated as ornamentals and for their fruits. [https://en.wikipedia.org/wiki/Flacourtia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414666 <http://eol.org/pages/61150>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414666 langual:B4666)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414666 "flacourtia spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414666 "flacourtia plant"@en)
SubClassOf(obo:FOODON_03414666 obo:FOODON_03411024)

# Class: obo:FOODON_03414667 (caqui plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414667 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414667 "Manilkara kauki is a plant in the subfamily Sapotoideae*, and the tribe *Sapoteae* of the *Sapotaceae* family; and is the type species for the genus *Manilkara*. Throughout the world it is known generally by the name caqui, but in Australia it is called wongi. [https://en.wikipedia.org/wiki/Manilkara_kauki]"@en)
