# Class: <http://purl.obolibrary.org/obo/FOODON_03414712> (bulbine-lily plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414712> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414712> "Bulbine bulbosa, commonly known as bulbine lily, is a flowering plant in the genus *Bulbine*. It is endemic to Australia. The corms of mature plants are nutritious, containing calcium and iron, and were used as food by the Aborigines. [https://en.wikipedia.org/wiki/Bulbine_bulbosa]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414712> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?8116>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414712> <http://www.langual.org/langual_thesaurus.asp?termid=B4712>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414712> "Bulbine bulbosa (R. Br.) Haw.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414712> "Xanthorrhoeaceae")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414712> "bulbine-lily plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414712> <http://purl.obolibrary.org/obo/FOODON_03411018>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414714> (wombat berry plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414714> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414714> "Eustrephus is a monotypic genus in the family *Asparagaceae*, subfamily *Lomandroideae*. *Eustrephus latifolius*, commonly named wombat berry, is the sole species of evergreen vines which grow naturally in Malesia, the Pacific Islands and eastern Australia. The tubers are eaten baked, and have an earthy sweet flavour. [https://en.wikipedia.org/wiki/Eustrephus]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414714> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?16466>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414714> <http://www.langual.org/langual_thesaurus.asp?termid=B4714>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414714> "Asparagaceae")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414714> "Eustrephus latifolius R. Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414714> "eustrephus latifolius"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414714> "orangevine"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414714> "wombat berry plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414714> <http://purl.obolibrary.org/obo/FOODON_03411018>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414715> (wild parsnip plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414715> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414715> "Trachymene incisa, wild parsnip, is a perennial herb native to eastern Australia growing in sclerophyll forest and cleared areas, with a preference for sandy soils and rock crevices. The roots are a traditional Aboriginal bushfood, and are eaten after baking in campfire coals or in earth ovens. [https://en.wikipedia.org/wiki/Trachymene_incisa]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414715> <http://www.langual.org/langual_thesaurus.asp?termid=B4715>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414715> "Araliaceae")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414715> "trachymene incisa"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414715> "wild parsnip plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414715> <http://purl.obolibrary.org/obo/FOODON_03411018>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414718> (long yam plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414718> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414718> "Dioscorea transversa, Pencil yam, is a vine of eastern and northern Australia. The tubers are a staple food of Australian Aboriginals and are eaten after cooking, usually in ground ovens. [https://en.wikipedia.org/wiki/Dioscorea_transversa]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414718> <http://eol.org/pages/8214>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414718> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?14262>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414718> <http://www.langual.org/langual_thesaurus.asp?termid=B4718>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414718> "Dioscorea transversa R. Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414718> "dioscorea transversa"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414718> "pencil yam"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414718> "long yam plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414718> <http://purl.obolibrary.org/obo/FOODON_03413396>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414719> (cycad plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414719> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414719> "Cycads are widely distributed across the globe and have long been exploited by people as a source of food and medicine. They contain a large amount of starch in roots, stem, seeds as well as many bioactive compounds. [http://plantnet.rbgsyd.nsw.gov.au/PlantNet/cycad/ethn.html]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414719> <http://eol.org/pages/4236>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414719> <http://www.langual.org/langual_thesaurus.asp?termid=B4719>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414719> "cycadopsida"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414719> "cycad plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414719> <http://purl.obolibrary.org/obo/FOODON_03411058>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414720> (bowenia plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414720> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414720> "Bowenia, genus of two extant and two extinct species of palmlike cycads (family *Stangeriaceae*, not accepted, should be *Zamiaceae*). The genus is endemic to Australia, and both living species are found in Queensland. Both the Byfield fern (*Bowenia serrulata*) and *Bowenia spectabilis* are sometimes cultivated as ornamentals in greenhouses and outdoors in warmer climates.https://global.britannica.com/plant/Bowenia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414720> <http://eol.org/pages/75719>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414720> <http://www.langual.org/langual_thesaurus.asp?termid=B4720>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414720> "bovenia spp."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414720> "bowenia plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414720> <http://purl.obolibrary.org/obo/FOODON_03414719>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414721> (burrawong plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414721> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414721> "Macrozamia is a genus of 38-40 species of cycads, in the family *Zamiaceae*, all endemic to Australia. The common name burrawang, originally referring to *Macrozamia communis* in the Daruk Australian Aboriginal language, is often used for all the species in the genus. [https://en.wikipedia.org/wiki/Macrozamia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414721> <http://eol.org/pages/30050>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414721> <http://www.langual.org/langual_thesaurus.asp?termid=B4721>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414721> "burrawang"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414721> "macrozamia spp."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414721> "burrawong plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414721> <http://purl.obolibrary.org/obo/FOODON_03414719>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414722> (cycas plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414722> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414722> "Cycas is the type genus and the only genus recognised in the family *Cycadaceae*. About 113 species are accepted. [https://en.wikipedia.org/wiki/Cycas]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414722> <http://eol.org/pages/53639>)
