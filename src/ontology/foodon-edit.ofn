AnnotationAssertion(rdfs:label obo:FOODON_03414221 "true muskmelon plant"@en)
SubClassOf(obo:FOODON_03414221 obo:NCBITaxon_3656)

# Class: obo:FOODON_03414222 (north american cantaloupe plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414222 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414222 "The North American cantaloupe, common in the United States, Mexico, and in some parts of Canada, has a net-like (or reticulated) skin covering. It is a round melon with firm, orange, moderately sweet flesh and a thin, reticulated, light-brown rind. Varieties with redder and yellower flesh exist but are not common in the U.S. market."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414222 "WIKIPEDIA:Cantaloupe")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414222 langual:B4222)
AnnotationAssertion(rdfs:label obo:FOODON_03414222 "north american cantaloupe plant"@en)
SubClassOf(obo:FOODON_03414222 obo:FOODON_03414221)

