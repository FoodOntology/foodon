AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414667 "wongi"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414667 "wongi plum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414667 "caqui plant"@en)
