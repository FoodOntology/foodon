# Class: <http://purl.obolibrary.org/obo/FOODON_03414654> (small-leaved tamarind plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414654> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414654> "The Small-leaved Tamarind is a medium-sized, rainforest tree growing 18 to 30 m in height. The fruits are hairless, yellow-brown capsules, 3-5 cm in diameter, usually with two lobes. Each lobe contains a single, round seed surrounded by thick bright orange/red or yellow flesh. [http://www.environment.gov.au/cgi-bin/sprat/public/publicspecies.pl?taxon_id=21484]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414654> <http://eol.org/pages/4415>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414654> <http://www.langual.org/langual_thesaurus.asp?termid=B4654>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414654> "SPRAT:21484")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414654> "Diploglottis campbellii Cheel.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414654> "diploglottis campbellii"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414654> "small-leaved tamarind plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414654> <http://purl.obolibrary.org/obo/FOODON_03411024>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414655> (midgen berry plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414655> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414655> "Midgen Berry, Midyim, or *Austromyrtus dulcis* is a spreading heathland shrub native to eastern Australia. The berries are a popular traditional bushfood, eaten by indigenous Australians and non-indigenous people. [https://en.wikipedia.org/wiki/Austromyrtus_dulcis]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414655> <http://eol.org/pages/8095>)
