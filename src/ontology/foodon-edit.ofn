AnnotationAssertion(go:hasSynonym obo:FOODON_03414792 "water ribbon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414792 "arrowgrass plant"@en)
SubClassOf(obo:FOODON_03414792 obo:FOODON_03413359)

# Class: obo:FOODON_03414793 (tylophora plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414793 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414793 "Tylophora is a genus of climbing plant or vine, first described as a genus in 1810. It is native to tropical and subtropical Asia, Africa, and Australia. [https://en.wikipedia.org/wiki/Tylophora]"@en)
