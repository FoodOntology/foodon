# Class: obo:FOODON_03412212 (swimming crab family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412212 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412212 "Portunidae is a family of crabs which contains the swimming crabs. Its members include many well-known shoreline crabs, such as the European shore crab (*Carcinus maenas*), blue crab (*Callinectes sapidus*), velvet crab (*Necora puber*) and lady crab (*Ovalipes ocellatus*). Two genera in the family are contrastingly named *Scylla* and *Charybdis*; the former contains the economically important species black crab (*Scylla serrata*) and *Scylla paramamosain*. [https://en.wikipedia.org/wiki/Portunidae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412212 <http://eol.org/pages/2604866>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412212 langual:B2212)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412212 "portunidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412212 "swimming crabs"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412212 "swimming crab family"@en)
