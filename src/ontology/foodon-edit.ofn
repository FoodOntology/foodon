AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03310311 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03310311 "Food material which has been smoked."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03310311 "Damion Dooley")
AnnotationAssertion(dcterms:date obo:FOODON_03310311 "2019-06-20T03:03:53Z"^^xsd:dateTime)
AnnotationAssertion(go:hasDbXref obo:FOODON_03310311 langual:H0118)
AnnotationAssertion(go:hasDbXref obo:FOODON_03310311 siren:F10311)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03310311 "smoked"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03310311 "Note that this does not cover food having a smoke additive ingredient.
LanguaL curation note: Use when food is exposed it for long periods of time to the smoke from a wood fire. Index also *preservation by SMOKING* [J0106]. If smoking also includes heat treatment, index the proper heat treatment under *preservation by HEAT TREATMENT* [J0120]."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03310311 "food (smoked)"@en)
EquivalentClasses(obo:FOODON_03310311 ObjectIntersectionOf(obo:FOODON_00002645 ObjectSomeValuesFrom(obo:RO_0002353 obo:FOODON_03470106)))
