AnnotationAssertion(go:hasDbXref obo:NCBITaxon_88123 "PLANTS:PRSA3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_88123 "Prunus salicina Lindl.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_88123 "Prunus salicina Lindley")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_88123 "prunus salicina"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_88123 "susina"@en)
SubClassOf(obo:NCBITaxon_88123 obo:FOODON_03411206)

