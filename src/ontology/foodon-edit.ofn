AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/NCBITaxon_95602> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_95602> "A medium-sized burrowing crab that is named for its furry claws, which resemble mittens. It is native to rivers, estuaries and other coastal habitats of eastern Asia from Korea in the north to the Fujian province of China in the south. It has also been introduced to Europe and North America where it is considered an invasive species."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/NCBITaxon_95602> "chinese mitten crab"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/NCBITaxon_95602> <https://en.wikipedia.org/wiki/Chinese_mitten_crab>)
