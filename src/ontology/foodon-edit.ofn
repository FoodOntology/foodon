AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414601 "blackspot seabream")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414601 "blackspot seabream"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414601 "pagellus bogaraveo"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414601 "red seabream"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414601 "red sea bream"@en)
