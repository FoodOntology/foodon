# Class: obo:FOODON_03411747 (wakame kelp)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411747 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411747 "Wakame, *Undaria pinnatifida*, is a sea vegetable, or edible seaweed. It has a subtly sweet flavour and is most often served in soups and salads.

Sea-farmers have grown wakame for hundreds of years in Korea and Japan and it has been nominated as among 100 of the world's worst invasive species according to the Global Invasive Species Database."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411747 "WIKIPEDIA:Undaria_pinnatifida")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411747 langual:B1747)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411747 asfis:udp)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411747 "Undaria pinnatifida (Harvey) Suringar 1873")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411747 "japanese kelp"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411747 "sea mustard"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411747 "undaria pinnatifida"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411747 "wakame kelp"@en)
SubClassOf(obo:FOODON_03411747 obo:FOODON_03411744)

