# Class: obo:FOODON_03412938 (lesser galangal plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412938 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412938 "Alpinia officinarum, known as lesser galangal, is a plant in the ginger family, cultivated in Southeast Asia. The rhizomes, known as galangal, are valued for their sweet spicy flavor and aromatic scent. These are used throughout Asia in curries and perfumes, and were previously used widely in Europe. They are also used as an herbal remedy. [https://en.wikipedia.org/wiki/Alpinia_officinarum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 <http://eol.org/pages/1126822>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101035>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506514>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 langual:B2938)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 "MANSFELD:3440")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412938 "PLANTS:ALOF4")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412938 "Chinese-ginger")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412938 "lesser galangal")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412938 "alpinia officinarum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412938 "lesser galangal plant"@en)
SubClassOf(obo:FOODON_03412938 obo:FOODON_03412971)
SubClassOf(obo:FOODON_03412938 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_199623))

