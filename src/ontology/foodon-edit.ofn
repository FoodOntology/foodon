AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414616> <http://www.langual.org/langual_thesaurus.asp?termid=B4616>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414616> "Ardeotis australis (J. E. Gray, 1829)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414616> "ardeotis australis"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414616> "australian bustard"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414616> <http://purl.obolibrary.org/obo/FOODON_00002616>)

