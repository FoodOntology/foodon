# Class: obo:FOODON_03414872 (synbranchiform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414872 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414872 "Synbranchiformes is an order of ray-finned fishes that are eel-like but have spiny rays, indicating that they belong to the superorder *Acanthopterygii*. There are two suborders: *Synbranchoidei* and *Mastacembeloidei*, or *Opisthomi*. The *Synbranchoidei* has one family, the *Synbranchidae*, four genera, and 17 species. The *Mastacembeloidei* has two families: *Chaudhuriidae*, with four genera and five species, and *Mastacembelidae*, with three genera and about 26 species."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414872 wikipedia:Synbranchiformes)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414872 <http://eol.org/pages/5070>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414872 langual:B4872)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414872 "swamp eel"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414872 "chaudhuriidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414872 "mastacembelidae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414872 "synbranchidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414872 "synbranchiform fish"@en)
SubClassOf(obo:FOODON_03414872 obo:FOODON_03411365)

# Class: obo:FOODON_03414873 (asian swamp eel)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414873 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414873 "A commercially important, air-breathing species of fish in the Synbranchidae family. Originating in the waters of East and Southeast Asia, it has been identified as an invasive species in the North American Everglades."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414873 <http://eol.org/pages/211528>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414873 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=166697>)
