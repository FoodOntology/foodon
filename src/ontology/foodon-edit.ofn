AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413361 "Potamodromous fish migrate within fresh water only."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03413361 "WIKIPEDIA:Potamodromous")
