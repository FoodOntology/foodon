AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_39352 "Origanum vulgare L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39352 "european oregano"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_39352 "marjoram, wild"@en)
