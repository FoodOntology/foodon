AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9767 "CEC1993:1462")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9767 "MSW3:14300012")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9767 "Balaenoptera acutorostrata Lacepède, 1804")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9767 "Balaenoptera acutorostrata Lacépède, 1800")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9767 "Balaenoptera acutorostrata Lacépède, 1804")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9767 "balaenoptera acutorostrata"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9767 "common minke whale"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9767 "minke whale"@en)
