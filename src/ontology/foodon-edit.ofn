AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03460181 "A claim that iron has been added to an edible product."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03460181 langual:H0181)
AnnotationAssertion(rdfs:comment obo:FOODON_03460181 "LanguaL curation note: Used when iron is added at any level. Always use this term for enriched flour or rice, enriched bakery products, and enriched macaroni or noodle products. (21 CFR 137.610(a), 21 CFR 136.115(a)(1), and others."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03460181 "iron added claim"@en)
SubClassOf(obo:FOODON_03460181 obo:FOODON_03460159)

