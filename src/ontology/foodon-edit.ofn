# Class: obo:FOODON_03414908 (flint corn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414908 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414908 "Flint corn (*Zea mays* var. *indurata*; also known as Indian corn or sometimes calico corn) is a variant of maize, the same species as common corn. Because each kernel has a hard outer layer to protect the soft endosperm, it is likened to being hard as flint; hence the name [https://en.wikipedia.org/wiki/Flint_corn]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414908 langual:B4908)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414908 "indian corn"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414908 "zea mays indurate"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414908 "flint corn plant"@en)
SubClassOf(obo:FOODON_03414908 obo:FOODON_03411379)

# Class: obo:FOODON_03414910 (witloof plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414910 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414910 "Belgian endive is known in Dutch as witloof or witlof (\"white leaf\"), endive or (very rarely) witloof in the United States, indivia in Italy, endivias in Spain, chicory in the UK, as witlof in Australia, endive in France, and chicon in parts of northern France, in Wallonia and (in French) in Luxembourg. [https://en.wikipedia.org/wiki/Chicory#Cultivated]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414910 langual:B4910)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414910 "belgian endive"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414910 "cichorium intybus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414910 "witloof plant"@en)
SubClassOf(obo:FOODON_03414910 obo:FOODON_03411552)

# Class: obo:FOODON_03414911 (puntarelle plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414911 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414911 "Puntarelle or cicoria di catalogna or cicoria asparago is a variant of chicory. The heads are characterized by an elongated shape (about 40-50 cm), light green stems and dandelion shaped leaves. 'Puntarelle' shoots have a pleasantly bitter taste. [https://en.wikipedia.org/wiki/Puntarelle]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414911 langual:B4911)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414911 "cichorium intybus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414911 "puntarelle plant"@en)
SubClassOf(obo:FOODON_03414911 obo:FOODON_03411552)

# Class: obo:FOODON_03414912 (bitterleaf plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414912 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414912 "Vernonia is a genus of about 1000 species of forbs and shrubs in the family *Asteraceae*. Several species of *Vernonia*, including *V. calvoana, V. amygdalina* and *V. colorata*, are eaten as leaf vegetables. They are common in most West African and Central African countries. [https://en.wikipedia.org/wiki/Vernonia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414912 <http://eol.org/pages/4206>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414912 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300655>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414912 langual:B4912)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414912 "PLANTS:VERNO")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414912 "Vernonia Schreb.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414912 "Vernonia spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414912 "vernonia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414912 "bitterleaf plant"@en)
SubClassOf(obo:FOODON_03414912 obo:FOODON_03411566)

# Class: obo:FOODON_03414913 (rock samphire plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414913 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414913 "Crithmum is a genus of flowering plant with the sole species *Crithmum maritimum*, known as samphire, rock samphire, or sea fennel. [https://en.wikipedia.org/wiki/Crithmum]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414913 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402237>)
