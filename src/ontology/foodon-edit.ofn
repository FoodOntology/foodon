# Class: obo:FOODON_03414209 (cranberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414209 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414209 "Cranberries are a group of evergreen dwarf shrubs or trailing vines in the subgenus *Oxycoccus* of the genus *Vaccinium*. In some methods of classification, *Oxycoccus* is regarded as a genus in its own right. They can be found in acidic bogs throughout the cooler regions of the Northern Hemisphere."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414209 "WIKIPEDIA:Cranberry")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414209 <http://eol.org/pages/38372>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414209 langual:B4209)
AnnotationAssertion(rdfs:label obo:FOODON_03414209 "cranberry plant"@en)
SubClassOf(obo:FOODON_03414209 obo:FOODON_03411614)

