AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510125> "tooth decay-related claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510125> <http://purl.obolibrary.org/obo/FOODON_03510124>)

