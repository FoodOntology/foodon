AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_115715 "Voandzeia subterranea (L.) Thou.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115715 "bambara bean"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115715 "bambara nut"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_115715 "bambara-bean"@en)
