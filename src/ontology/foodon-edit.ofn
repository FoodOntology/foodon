# Class: obo:FOODON_03411081 (penaeid shrimp family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411081 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411081 "Penaeidae is a family of marine crustacean in the suborder *Dendrobranchiata*, which are often referred to as penaeid shrimp or penaeid prawn. It contains many species of economic importance, such as the tiger prawn, whiteleg shrimp, Atlantic white shrimp and Indian prawn. Many prawns are the subject of commercial fishery, and farming, both in marine settings, and in freshwater farms. [https://en.wikipedia.org/wiki/Penaeidae]"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411081 "WIKIPEDIA:Penaeus")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411081 <http://eol.org/pages/7184>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411081 langual:B1081)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411081 "EC:No 216/2009 DCP")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411081 "Dendrobranchiata Bate, 1888")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411081 "Natantia")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411081 "dendrobranchiata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411081 "natantia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411081 "natantian decapods"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411081 "penaeid shrimps"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411081 "penaeidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411081 "penaeid shrimp family"@en)
SubClassOf(obo:FOODON_03411081 obo:FOODON_03411237)

# Class: obo:FOODON_03411083 (pinus genus tree)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411083 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411083 "A pine is any conifer in the genus *Pinus*, of the family *Pinaceae*. Some species have large seeds, called pine nuts, that are harvested and sold for cooking and baking. The soft, moist, white inner bark (cambium) found clinging to the woody outer bark is edible and very high in vitamins A and C. A tea made by steeping young, green pine needles in boiling water (known as tallstrunt in Sweden) is high in vitamins A and C. [https://en.wikipedia.org/wiki/Pine]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411083 <http://eol.org/pages/6747>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411083 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300465>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411083 langual:B1083)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411083 "PLANTS:PINUS")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411083 "Pinus")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411083 "Pinus L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411083 "Pinus spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411083 "pinus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411083 "pinus genus tree"@en)
SubClassOf(obo:FOODON_03411083 obo:FOODON_03411015)
