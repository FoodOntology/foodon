# Class: obo:FOODON_03413421 (burnet plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413421 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413421 "Sanguisorba is a genus of flowering plants in the family *Rosaceae* native to the temperate regions of the Northern Hemisphere. The common name is burnet. 
There are about 30 species, including: *Sanguisorba annua* (annual burnet, prairie burnet, western burnet); *Sanguisorba canadensis* (Canadian burnet, white burnet); *Sanguisorba dodecandra* (Italian burnet); *Sanguisorba hakusanensis* (Hakusan burnet); *Sanguisorba menendezii* (Canary Islands burnet); *Sanguisorba minor* (salad burnet, garden burnet, little burnet); *Sanguisorba obtusa* (Japanese burnet); *Sanguisorba officinalis* (great burnet, burnet bloodwort); *Sanguisorba tenuifolia* (Asian burnet). [https://en.wikipedia.org/wiki/Sanguisorba]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413421 <http://eol.org/pages/8097>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413421 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300527>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413421 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?33026>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413421 langual:B3421)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413421 "PLANTS:SANGU2")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413421 "Great burnet (Sanguisorba officinalis L.; Poterium officinala A. Gray) ; Salad burnet (Sanguisorba minor Scop.; syn: Poterium sanguisorba L.)")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413421 "Sanguisorba spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413421 "sanguisorba"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413421 "burnet plant"@en)
SubClassOf(obo:FOODON_03413421 obo:FOODON_03411179)

