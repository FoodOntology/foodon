# Class: obo:FOODON_03414825 (coarse dodderlaurel plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414825 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414825 "Cassytha melantha is a parasitic vine. Common names include coarse dodder-laurel and large dodder-laurel. The fruits are about 10-15 millimetres (0.39-0.59 in) in diameter and are green, drying to black. These are edible and are harvested in the wild. The species occurs in the states of Western Australia, South Australia, Tasmania, Victoria and New South Wales in Australia.[https://en.wikipedia.org/wiki/Cassytha_melantha]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414825 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?450331>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414825 langual:B4825)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414825 "Cassytha melantha R. Br.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414825 "Lauraceae")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414825 "cassytha melantha"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414825 "coarse dodder-laurel"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414825 "large dodder-laurel"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414825 "coarse dodderlaurel plant"@en)
SubClassOf(obo:FOODON_03414825 obo:FOODON_03414659)

# Class: obo:FOODON_03414826 (nanchee plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414826 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414826 "Persoonia falcata grows as a woody shrub or small tree, anywhere from 1 to 9 m (3.3 to 29.5 ft) high. The thick dark grey bark is layered and flaky. The pale green-grey leaves are 8-35 cm (3.1-13.8 in) long and 0.4-3 cm (0.16-1.18 in) wide, and oblanceolate to linear-oblanceolate or falcate in shape. The yellow flowers appear from June to November. The yellow-green fruit, known as drupes, appear from October to February. Edible, they are eaten raw by local aborigines.[https://en.wikipedia.org/wiki/Persoonia_falcata]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414826 <http://eol.org/pages/4370>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414826 langual:B4826)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414826 "APNI:112478")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414826 "Persoonia falcata R.Br.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414826 "booral"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414826 "linkia falcata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414826 "milky plum"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414826 "persoonia falcata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414826 "tarpoon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414826 "nanchee plant"@en)
SubClassOf(obo:FOODON_03414826 obo:FOODON_03414671)

# Class: obo:FOODON_03414827 (pine-leaved geebung plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414827 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414827 "Persoonia pinifolia, or pine-leaved geebung, is a large shrub which is native to the Sydney region in New South Wales, Australia. It can reach up to 3 metres in both height and width. It has narrow linear leaves to 70 mm long and terminal flower racemes late winter to spring. These are followed by fleshy green fruits (drupes) that have the appearance of a bunch of grapes.[https://en.wikipedia.org/wiki/Persoonia_pinifolia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414827 <http://eol.org/pages/4370>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414827 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?27424>)
