AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414874 "Characiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414874 "fish, characiform"@en)
SubClassOf(obo:FOODON_03414874 obo:FOODON_03411365)

