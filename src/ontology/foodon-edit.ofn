# Class: obo:NCBITaxon_1071199 (Pterocarpus santalinus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_1071199 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_1071199 "*Pterocarpus santalinus*, with the common names red sanders, red sandalwood, and saunderswood, is a species of *Pterocarpus* endemic to the southern Eastern Ghats mountain range of South India. The tree is not to be confused with the aromatic *Santalum* sandalwood trees that grow natively in South India. *Pterocarpus santalinus* is used in traditional herbal medicine [https://en.wikipedia.org/wiki/Pterocarpus_santalinus]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_1071199 "red sandalwood plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_1071199 <http://eol.org/pages/643243>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_1071199 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30293>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_1071199 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506295>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_1071199 langual:B5171)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_1071199 "PLANTS:PTSA")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_1071199 "Pterocarpus santalinus L. f.")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_1071199 "Pterocarpus santalinus L. fil.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_1071199 "pterocarpus santalinus"@en)
SubClassOf(obo:NCBITaxon_1071199 obo:FOODON_03413359)

