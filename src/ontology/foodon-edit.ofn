AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_3886 "scarlet runner bean plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_3886 wikipedia:Phaseolus_coccineus)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3886 <http://eol.org/pages/645287>)
