AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415092 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505934>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415092 langual:B5092)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415092 "PLANTS:ELSE5")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415092 "eleutherococcus senticosus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415092 "siberian ginseng plant"@en)
SubClassOf(obo:FOODON_03415092 obo:FOODON_03411673)
SubClassOf(obo:FOODON_03415092 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_82096))

# Class: obo:FOODON_03415093 (jengkol plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415093 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415093 "Archidendron pauciflorum, commonly known as Djenkol, Jenkol or Jering is a species of flowering tree in the pea family, *Fabaceae*. It is native to Southeast Asia, where the seeds are a popular dish. The beans and leaves of the djenkol tree are traditionally used for medicinal purposes such as purifying the blood. [https://en.wikipedia.org/wiki/Archidendron_pauciflorum]"@en)
