AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415137 langual:B5137)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415137 "PLANTS:CAVU")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415137 "common heather")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03415137 "heather flower")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415137 "calluna vulgaris"@en)
