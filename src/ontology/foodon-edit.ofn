AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414191 "foetid cassia")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414191 "senna tora"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414191 "sickle pod"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414191 "sickle senna"@en)
