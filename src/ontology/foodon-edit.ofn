# Class: obo:FOODON_03413487 (tree onion plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03413487 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03413487 "Tree onions, also commonly called top onions or Egyptian onions, are a strong-growing onion with a bunch of bulblets where a normal onion would have flowers. In some varieties these bulblets will sprout and grow while still on the original stalk, which may bend down under the weight of the new growth, giving rise to the name, walking onion. [Source: Wikipedia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413487 <http://eol.org/pages/8187>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413487 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?404736>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03413487 langual:B3487)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03413487 "Allium ×proliferum (Moench) Schrad. ex Willd.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03413487 "beltsville bunching onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413487 "catawissa onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413487 "egyptian onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413487 "top onion"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03413487 "wakegi onion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03413487 "tree onion plant"@en)
SubClassOf(obo:FOODON_03413487 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03413487 obo:FOODON_03414302)

