# Class: obo:FOODON_03411487 (sweet pea plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411487 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411487 "Sweet pea (*Lathyrus odoratus*) is a flowering plant in the genus *Lathyrus* in the family *Fabaceae* (legumes), native to the eastern Mediterranean. Unlike the edible pea, there is evidence that seeds of members of the genus *Lathyrus* are toxic if ingested in quantity. A related species, *Lathyrus sativus*, is grown for human consumption but when it forms a major part of the diet it causes symptoms of toxicity called lathyrism."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411487 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411487 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21596>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411487 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=25864>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411487 langual:B1487)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411487 "PLANTS:LAOD")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411487 "sweet pea")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411487 "lathyrus odoratus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411487 "pea, sweet"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411487 "sweet pea plant"@en)
SubClassOf(obo:FOODON_03411487 obo:FOODON_03413483)
SubClassOf(obo:FOODON_03411487 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_3859))

