AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411429 "Citrus reticulata Blanco")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411429 "citrus deliciosa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411429 "citrus nobilus"@en)
