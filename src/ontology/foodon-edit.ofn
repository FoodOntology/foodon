# Class: <http://purl.obolibrary.org/obo/FOODON_03411590> (saigon cinnamon plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411590> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411590> "Saigon cinnamon (*Cinnamomum loureiroi*, also known as Vietnamese cinnamon or Vietnamese cassia) is an evergreen tree indigenous to mainland Southeast Asia. Despite its name, Saigon cinnamon is more closely related to cassia (*C. cassia*) than to cinnamon (*C. verum*, \"true cinnamon\", Ceylon cinnamon), though in the same genus as both. 
Saigon cinnamon is used primarily for its aromatic bark, which has a taste quite similar to that of *C. cassia*, but with a more pronounced and complex aroma. [https://en.wikipedia.org/wiki/Saigon_cinnamon]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411590> <http://eol.org/pages/4308>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411590> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10583>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411590> <http://www.langual.org/langual_thesaurus.asp?termid=B1590>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411590> "Cinnamomum loureiroi Nees")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411590> "cassia, saigon"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411590> "cinnamomum loureiroi"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411590> "cinnamomum lourieri"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411590> "saigon cinnamon plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411590> <http://purl.obolibrary.org/obo/FOODON_03411472>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03411591> (Rock Cornish game hen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03411591> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03411591> "An immature chicken younger than five weeks old (previously five to six weeks), of either sex, with a ready-to-cook carcass weight of two pounds or less."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03411591> "https://www.usda.gov/media/blog/2011/11/17/poultry-classifications-get-21st-century-upgrade"^^xsd:anyURI)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03411591> <http://www.langual.org/langual_thesaurus.asp?termid=B1591>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411591> "Cornish game hen"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411591> "Rock Cornish fowl"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411591> "rock cornish chicken"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03411591> "In the past Rock Cornish game hens had been classified as younger than six weeks old, but modern rearing practices have led to faster maturation."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411591> "Rock Cornish game hen"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411591> <http://purl.obolibrary.org/obo/FOODON_03411457>)

