# Class: obo:FOODON_03430130 (food (liquid))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430130 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430130 "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of the container."@en)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_03430130 "fluid"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430130 langual:E0130)
AnnotationAssertion(rdfs:comment obo:FOODON_03430130 "Liquids range from water to honey, corresponding to a range in viscosity (or apparent viscosity) from 1 to 500 centipoise (viscosity is a measure of a liquid's resistance to flow). Products that are pourable but have a higher viscosity are *SEMILIQUID*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430130 "food (liquid)"@en)
EquivalentClasses(obo:FOODON_03430130 ObjectIntersectionOf(obo:FOODON_00002454 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001548)))
SubClassOf(obo:FOODON_03430130 obo:FOODON_00002454)

# Class: obo:FOODON_03430131 (whole form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430131 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430131 "A solid form characteristic of food material which refers to a naturally shaped organism or organism part, or a fabrication of the same shape."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430131 langual:E0131)
AnnotationAssertion(rdfs:comment obo:FOODON_03430131 "LanguaL note: \"Refers to natural or formed shape as appropriate, regardless of size, which may vary from very large (e.g., beef carcass) to very small (e.g., poppy seed, yeast cell).\""@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430131 "whole form (sensu food)"@en)
SubClassOf(obo:FOODON_03430131 obo:FOODON_00005712)

# Class: obo:FOODON_03430133 (divided into one or more wedges or segments)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430133 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430133 "Divided into piece(s) whose shape is defined in relation to the shape of some whole food material form, i.e., halves, quarters, wedges or segments."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430133 langual:E0133)
AnnotationAssertion(rdfs:comment obo:FOODON_03430133 "LanguaL note:  It is used regardless of the size of the whole."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430133 "divided into one or more wedges or segments"@en)
SubClassOf(obo:FOODON_03430133 obo:FOODON_03430152)

# Class: obo:FOODON_03430134 (semisolid with solid pieces)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430134 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430134 langual:E0134)
AnnotationAssertion(rdfs:comment obo:FOODON_03430134 "LanguaL curation note: Used for semisolid products that contain medium or small particles. The particles may be natural or formed whole shapes or may have been produced by dividing or disintegrating solids. Also included are products consisting of medium or small particles that are joined into a semisolid mass by naturally present or added oil, water, or other binding agents. The same particles without the binding agents would be indexed by the appropriate narrower term under *SOLID*."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430134 "semisolid with solid pieces"@en)
SubClassOf(obo:FOODON_03430134 obo:FOODON_03430144)

# Class: obo:FOODON_03430135 (semiliquid with smooth consistency)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430135 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430135 langual:E0135)
AnnotationAssertion(rdfs:label obo:FOODON_03430135 "semiliquid with smooth consistency"@en)
SubClassOf(obo:FOODON_03430135 obo:FOODON_03430103)

# Class: obo:FOODON_03430136 (ground form (sensu food))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430136 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430136 "A solid food material form characteristic in which food material has undergone a food grinding (North American usage) or mincing (UK usage) process."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430136 langual:E0136)
AnnotationAssertion(rdfs:comment obo:FOODON_03430136 "LanguaL curation note: Used when particle size is below 0.2 cm."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430136 "ground form (sensu food)"@en)
SubClassOf(obo:FOODON_03430136 obo:FOODON_00005712)

# Class: obo:FOODON_03430137 (sliced)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430137 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430137 langual:E0137)
AnnotationAssertion(rdfs:comment obo:FOODON_03430137 "LanguaL curation note: Used for solid products that are divided into uniformly thin pieces (e.g., sliced bread)."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430137 "sliced"@en)
SubClassOf(obo:FOODON_03430137 obo:FOODON_03430115)
SubClassOf(obo:FOODON_03430137 ObjectSomeValuesFrom(obo:RO_0002353 obo:FOODON_00000071))

# Class: obo:FOODON_03430138 (food (liquid, high viscosity, with solid pieces))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430138 obo:IAO_0000428)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03430138 langual:E0138)
