# Class: obo:NCBITaxon_70193 (Sepiola atlantica)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_70193 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_70193 "*Sepiola atlantica*, also known as the Atlantic bobtail, is a species of bobtail squid native to the northeastern Atlantic Ocean (65ºN to 35ºN), from Iceland, the Faroe Islands and western Norway to the Moroccan coast. There is a single record of this species from the Mediterranean Sea."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_70193 "atlantic bobtail"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_70193 "WIKIPEDIA:Sepiola_atlantica")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_70193 <http://eol.org/pages/448833>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_70193 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=82357>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_70193 langual:B4531)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_70193 asfis:iot)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_70193 "Sepiola atlantica D'Orbigny, 1839-1842")
