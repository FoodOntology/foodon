SubClassOf(obo:FOODON_03430168 obo:FOODON_03430165)

# Class: obo:FOODON_03430169 (parenteral preparation)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430169 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430169 "Parenteral preparations are not dietary supplements per se, but are included in this classification because of their importance in nutrient intake.
Parenteral preparations are sterile, pyrogen-free liquids (solutions, emulsions, or suspensions) or solid dosage forms containing one or more active ingredients, packaged in either single-dose or multidose containers. There are four main forms of parenteral preparations: injections, intravenous infusions (large volume parenterals), powders for injections, and implants. [http://apps.who.int/phint/en/p/docf/]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430169 langual:E0169)
AnnotationAssertion(rdfs:label obo:FOODON_03430169 "parenteral preparation"@en)
SubClassOf(obo:FOODON_03430169 obo:FOODON_03430165)

# Class: obo:FOODON_03430170 (solution for injection)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430170 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430170 "Medicinal use, e.g. B12 injections. Injection means the act of forcing a liquid into the body by means of a needle and syringe."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430170 langual:E0170)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430170 "injection"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430170 "shot"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430170 "solution for injection"@en)
SubClassOf(obo:FOODON_03430170 obo:FOODON_03430169)

# Class: obo:FOODON_03430171 (solution for infusion)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430171 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03430171 "Infusion means the introduction of a substance, such as a fluid, electrolyte, nutrient, or drug, directly into a vein or interstitially by means of gravity flow."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430171 langual:E0171)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430171 "intravenous feeding"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430171 "intravenous infusion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03430171 "solution for infusion"@en)
SubClassOf(obo:FOODON_03430171 obo:FOODON_03430169)

