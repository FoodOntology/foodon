AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411375 "Zizania aquatica L.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411375 "rice, wild"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411375 "water oats"@en)
