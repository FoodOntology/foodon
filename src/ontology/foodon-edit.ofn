AnnotationAssertion(go:hasDbXref obo:NCBITaxon_56866 "PLANTS:LUAC2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_56866 "Luffa acutangula (L.) Roxb.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_56866 "chinese-okra"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_56866 "luffa acutangula"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_56866 "ribbed gourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_56866 "ribbed loofah"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_56866 "ridged gourd"@en)
