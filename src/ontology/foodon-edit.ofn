AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411081 "natantia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411081 "natantian decapods"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411081 "penaeid shrimps"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411081 "penaeidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411081 "penaeid shrimp family"@en)
SubClassOf(obo:FOODON_03411081 obo:FOODON_03411237)

