# Class: obo:NCBITaxon_9860 (Cervus elaphus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9860 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9860 "The red deer (*Cervus elaphus*) is one of the largest deer species. The red deer inhabits most of Europe, the Caucasus Mountains region, Asia Minor, parts of western Asia, and central Asia. It also inhabits the Atlas Mountains region between Morocco and Tunisia in northwestern Africa."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9860 "red deer"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9860 wikipedia:Red_deer)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9860 <http://eol.org/pages/328649>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9860 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180695>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9860 langual:B4371)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9860 "MSW3:14200352")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9860 "Cervus elaphus Linnaeus, 1758")
AnnotationAssertion(rdfs:comment obo:NCBITaxon_9860 "\"[it is] the only species of deer to inhabit Africa. Red deer have been introduced to other areas, including Australia, New Zealand and Argentina. In many parts of the world, the meat (venison) from red deer is used as a food source.\" - Wikipedia."@en)
SubClassOf(obo:NCBITaxon_9860 obo:FOODON_03411583)

