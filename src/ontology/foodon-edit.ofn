# Class: <http://purl.obolibrary.org/obo/FOODON_03414819> (kangaroo vine plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414819> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414819> "Cissus antarctica (synonym *Cissus oblongata*), called \"kangaroo vine\", is one of the best known species of the genus *Cissus* in the family of *Vitaceae*. It is a climbing plant, a vine, and comes from Australia.[https://en.wikipedia.org/wiki/Cissus_antarctica]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414819> <http://eol.org/pages/4382>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414819> <http://www.langual.org/langual_thesaurus.asp?termid=B4819>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414819> "USDA PLANTS:CIAN3")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414819> "Cissus antarctica Venten")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414819> "cissus antarctica"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414819> "cissus oblongata"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414819> "kangaroo ivy"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414819> "kangaroo vine plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414819> <http://purl.obolibrary.org/obo/FOODON_03414650>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414820> (giant water vine plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414820> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414820> "Cissus hypoglauca is a common Australian vine. It is one of the better known climbing plants of the genus *Cissus* in the grape family. A very common climber in moist areas of eastern Australia, it often colonises large areas after forest damage due to storms, fire or logging. Common names include jungle grape, water vine, giant water vine, five-leaf water vine, jungle vine, native grapes and billangai [https://en.wikipedia.org/wiki/Cissus_hypoglauca]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414820> <http://eol.org/pages/4382>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414820> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10614>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414820> <http://www.langual.org/langual_thesaurus.asp?termid=B4820>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414820> "Cissus hypoglauca A. Gray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414820> "cissus hypoglauca"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414820> "giant water vine plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414820> <http://purl.obolibrary.org/obo/FOODON_03414650>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414823> (green plum plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414823> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414823> "Buchanania obovata is a small to medium-sized understorey tree in woodlands native to northern Australia. Common names include green plum and wild mango. The fruit is traditionally eaten by Aborigines. The plant also has traditional medicinal uses. [https://en.wikipedia.org/wiki/Buchanania_obovata]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414823> <http://eol.org/pages/4410>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414823> <http://www.langual.org/langual_thesaurus.asp?termid=B4823>)
