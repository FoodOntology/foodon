AnnotationAssertion(go:hasDbXref obo:NCBITaxon_405322 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?28578>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_405322 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506521>)
