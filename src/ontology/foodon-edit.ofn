# Class: obo:NCBITaxon_45181 (Mitchella repens)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_45181 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_45181 "*Mitchella repens* (partridge berry or squaw vine) is the best known plant in the genus *Mitchella*. It is a creeping prostrate herbaceous woody shrub occurring in North America belonging to the madder family (Rubiaceae). The scarlet berries are edible but rather tasteless, with a faint flavour of wintergreen, resembling cranberries (to which they are not closely related). They are often confused with the Newfoundland \"partridgeberry\" which is actually a relative of the lingonberry. [https://en.wikipedia.org/wiki/Mitchella_repens]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_45181 "partridge berry plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_45181 <http://eol.org/pages/1107478>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_45181 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402637>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_45181 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=35063>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_45181 langual:B4960)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_45181 "PLANTS:MIRE")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_45181 "Mitchella repens L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_45181 "mitchella repens"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_45181 "squawvine"@en)
SubClassOf(obo:NCBITaxon_45181 obo:FOODON_03411231)

# Class: obo:NCBITaxon_452416 (Origanum onites)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_452416 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_452416 "*Origanum onites*, the Cretan oregano, Turkish oregano, pot marjoram, is a plant species in the genus Origanum found in Sicily, Greece and Turkey. It has similar flavors as oregano. [https://en.wikipedia.org/wiki/Origanum_onites]"@en)
