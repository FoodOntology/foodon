# Class: <http://purl.obolibrary.org/obo/FOODON_03414825> (coarse dodderlaurel plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414825> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414825> "Cassytha melantha is a parasitic vine. Common names include coarse dodder-laurel and large dodder-laurel. The fruits are about 10-15 millimetres (0.39-0.59 in) in diameter and are green, drying to black. These are edible and are harvested in the wild. The species occurs in the states of Western Australia, South Australia, Tasmania, Victoria and New South Wales in Australia.[https://en.wikipedia.org/wiki/Cassytha_melantha]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414825> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?450331>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414825> <http://www.langual.org/langual_thesaurus.asp?termid=B4825>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414825> "Cassytha melantha R. Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414825> "Lauraceae")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414825> "cassytha melantha"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414825> "coarse dodder-laurel"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414825> "large dodder-laurel"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414825> "coarse dodderlaurel plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414825> <http://purl.obolibrary.org/obo/FOODON_03414659>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414826> (nanchee plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414826> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414826> "Persoonia falcata grows as a woody shrub or small tree, anywhere from 1 to 9 m (3.3 to 29.5 ft) high. The thick dark grey bark is layered and flaky. The pale green-grey leaves are 8-35 cm (3.1-13.8 in) long and 0.4-3 cm (0.16-1.18 in) wide, and oblanceolate to linear-oblanceolate or falcate in shape. The yellow flowers appear from June to November. The yellow-green fruit, known as drupes, appear from October to February. Edible, they are eaten raw by local aborigines.[https://en.wikipedia.org/wiki/Persoonia_falcata]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414826> <http://eol.org/pages/4370>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414826> <http://www.langual.org/langual_thesaurus.asp?termid=B4826>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414826> "APNI:112478")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "Persoonia falcata R.Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "booral"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "linkia falcata"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "milky plum"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "persoonia falcata"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414826> "tarpoon"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414826> "nanchee plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414826> <http://purl.obolibrary.org/obo/FOODON_03414671>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414827> (pine-leaved geebung plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414827> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414827> "Persoonia pinifolia, or pine-leaved geebung, is a large shrub which is native to the Sydney region in New South Wales, Australia. It can reach up to 3 metres in both height and width. It has narrow linear leaves to 70 mm long and terminal flower racemes late winter to spring. These are followed by fleshy green fruits (drupes) that have the appearance of a bunch of grapes.[https://en.wikipedia.org/wiki/Persoonia_pinifolia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414827> <http://eol.org/pages/4370>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414827> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?27424>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414827> <http://www.langual.org/langual_thesaurus.asp?termid=B4827>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414827> "APNI:114587")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414827> "Persoonia pinifolia R. Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414827> "Persoonia pinifolia R.Br.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414827> "persoonia pinifoli"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414827> "pine-leaved geebung plant"@en)
