# Class: obo:FOODON_03414658 (pigface plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414658 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414658 "Carpobrotus, commonly known as pigface, ice plant, and Hottentot plant, is a genus of ground-creeping plants with succulent leaves and large daisy-like flowers. The name refers to the edible fruits. The genus includes some 12 to 20 accepted species. Most are South African, endemics, but there are at least four Australian species and one South American. [https://en.wikipedia.org/wiki/Carpobrotus"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414658 <http://eol.org/pages/60549>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414658 langual:B4658)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414658 "carpobrotus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414658 "fig-marigold"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414658 "hottentot fig"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414658 "hottentot plant"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414658 "ice plant"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414658 "pigface plant"@en)
SubClassOf(obo:FOODON_03414658 obo:FOODON_03411024)

# Class: obo:FOODON_03414659 (cassytha plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414659 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414659 "Cassytha is a genus of some two dozen species of obligately parasitic vines in the family *Lauraceae*. The fruit of various species are eaten, both by birds and by humans, and *Cassytha melantha* in particular has been documented as a wild-harvested Australian indigenous food. [https://en.wikipedia.org/wiki/Cassytha]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414659 <http://eol.org/pages/72879>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414659 langual:B4659)
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414659 "Lauraceae")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414659 "cassytha"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414659 "dodder-laurel"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414659 "dodderlaurel"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414659 "cassytha plant"@en)
SubClassOf(obo:FOODON_03414659 obo:FOODON_03411024)

# Class: obo:FOODON_03414660 (cordia plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414660 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414660 "Cordia is a genus of flowering plants in the borage family, *Boraginaceae. It contains about 300 species of shrubs and trees that are found worldwide, mostly in warmer regions. A number of the tropical species have edible fruits  [https://en.wikipedia.org/wiki/Cordia]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414660 <http://eol.org/pages/60675>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414660 langual:B4660)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414660 "cordia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414660 "cordia plant"@en)
SubClassOf(obo:FOODON_03414660 obo:FOODON_03411024)

# Class: obo:FOODON_03414661 (assyrian plum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414661 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414661 "Cordia myxa is a species of flowering plant in the borage family, Boraginaceae. It is a medium-sized broad-leaved deciduous tree. Common names include Assyrian plum, lasura, pidar, panugeri, naruvilli, geduri, spistan, burgund dulu wanan and ntege.[https://en.wikipedia.org/wiki/Cordia_myxa]"@en)
