AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411552 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=36763>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411552 langual:B1552)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411552 "MANSFELD:31967")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411552 "PLANTS:CIIN")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411552 "Cichorium intybus L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411552 "belgian endive"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411552 "cichorium intybus"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411552 "monk's beard"@en)
