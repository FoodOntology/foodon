# Class: obo:FOODON_03420108 (sugar)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03420108 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03420108 "A broad term that includes the nutritive sweeteners dextrose, fructose, galactose, lactose, maltose and sucrose, which are simple carbohydrates with molecules composed of one or two saccharide units. Note that on a product label or in a recipe, 'sugar' means *SUCROSE* and should be so indexed. Use the broad term *SUGAR* only if the specific sugar used is not known or not listed in the vocabulary."@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03420108 langual:C0108)
AnnotationAssertion(rdfs:label obo:FOODON_03420108 "sugar"@en)
SubClassOf(obo:FOODON_03420108 obo:FOODON_03420152)

