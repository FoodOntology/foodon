# Class: obo:NCBITaxon_122119 (Prunus angustifolia)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_122119 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_122119 "*Prunus angustifolia*, known commonly as Chickasaw plum, Cherokee plum, Florida sand plum, sandhill plum, or sand plum, is a North American species of plum-bearing tree. It was originally cultivated by Native Americans before the arrival of Europeans.  While *Prunus* is the classical name for European plums, *angustifolia* refers to its narrow leaves. [https://en.wikipedia.org/wiki/Prunus_angustifolia]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_122119 "chickasaw plum plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 <http://eol.org/pages/231184>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=24768>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 langual:B2743)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 "PLANTS:PRAN3")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 "PLANTS:PRANA")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_122119 "PLANTS:PRANW")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_122119 "Prunus angustifolia Marsh.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_122119 "prunus angustifolia"@en)
SubClassOf(obo:NCBITaxon_122119 obo:FOODON_03411206)

