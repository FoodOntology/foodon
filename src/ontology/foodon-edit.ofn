# Class: obo:FOODON_03414508 (cottongrass plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414508 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414508 "Eriophorum (cottongrass, cotton-grass or cottonsedge) is a genus of about 25 species of flowering plants in the family *Cyperaceae*, the sedge family. They are found throughout the temperate Northern Hemisphere in acid bog habitats, being particularly abundant in Arctic tundra regions."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414508 "WIKIPEDIA:Cottongrass")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414508 <http://eol.org/pages/29149>)
