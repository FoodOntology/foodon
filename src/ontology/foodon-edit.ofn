# Class: obo:FOODON_03411214 (nutmeg plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411214 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411214 "The nutmeg tree is any of several species of trees in genus *Myristica*. The most important commercial species is *Myristica fragrans*, an evergreen tree indigenous to the Banda Islands in the Moluccas (or Spice Islands) of Indonesia. The nutmeg tree is important for two spices derived from the fruit: nutmeg and mace. Nutmeg is the actual seed of the tree, while mace is the dried \"lacy\" reddish covering or aril of the seed."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 <http://eol.org/pages/596922>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?24855>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=18125>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 langual:B1214)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 "MANSFELD:12036")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411214 "PLANTS:MYFR3")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411214 "mace")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411214 "nutmeg")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411214 "myristica fragrans"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411214 "nutmeg plant"@en)
SubClassOf(obo:FOODON_03411214 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03411214 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_51089))

