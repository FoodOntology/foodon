AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9838 "MSW3:14200115")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9838 "Camelus dromedarius Linnaeus, 1758")
