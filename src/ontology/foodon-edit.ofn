SubClassOf(obo:FOODON_03414915 obo:FOODON_03411566)

# Class: obo:FOODON_03414916 (waterclover plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414916 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414916 "Marsilea is a genus of approximately 65 species of aquatic ferns of the family *Marsileaceae*. These small plants are of unusual appearance and do not resemble common ferns. Common names include water clover and four-leaf clover because the long-stalked leaves have four clover-like lobes and are either held above water or submerged. Sporocarps of some Australian species such as *Marsilea drummondii* are edible and have been eaten by Aborigines and early white settlers, who knew it under the name ngardu or nardoo. The leaves of *Marsilea crenata* are part of the East Javanese cuisine of Indonesia, especially in the city of Surabaya. [https://en.wikipedia.org/wiki/Marsilea]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414916 <http://eol.org/pages/4498>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414916 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?403776>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414916 langual:B4916)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414916 "PLANTS:MARSI")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414916 "Marsilea")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414916 "Marsilea L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414916 "Marsilea crenata C. Presl")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414916 "marsilea"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414916 "nardoo"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414916 "waterclover plant"@en)
SubClassOf(obo:FOODON_03414916 obo:FOODON_03411566)

# Class: obo:FOODON_03414920 (jersey kale plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414920 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414920 "The Jersey cabbage (*Brassica oleracea longata*, also known as Jersey kale or cow cabbage, and by a variety of local names including giant cabbage, long jacks, tree cabbage and the French chour and chou à vacque. It is a variety of cabbage native to the Channel Islands that grows to a great height and was formerly commonly used there as livestock fodder and for making walking sticks. [https://en.wikipedia.org/wiki/Jersey_cabbage]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414920 <http://eol.org/pages/4219>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414920 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?319630>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414920 langual:B4920)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414920 "Brassica oleracea L. var. palmifolia DC.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414920 "Brassica oleracea var. palmifolia DC.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414920 "brassica oleracea longata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414920 "brassica oleracea palmifolia"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414920 "tree kale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414920 "jersey kale plant"@en)
SubClassOf(obo:FOODON_03414920 obo:FOODON_03411281)

# Class: obo:FOODON_03414921 (romanesco plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414921 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414921 "Romanesco broccoli, also known as Roman cauliflower, Broccolo Romanesco, Romanesque cauliflower or simply Romanesco is an edible flower bud of the species *Brassica oleracea*. First documented in Italy, it is chartreuse in color. Romanesco has a striking appearance because its form is a natural approximation of a fractal. [https://en.wikipedia.org/wiki/Romanesco_broccoli]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414921 langual:B4921)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414921 "roman cauliflower"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414921 "romanesco broccoli"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414921 "romanesco cauliflower"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414921 "romanesco plant"@en)
SubClassOf(obo:FOODON_03414921 obo:FOODON_03411094)

# Class: obo:FOODON_03414925 (devil rattan plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414925 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414925 "Daemonorops is a genus of rattan palms in the family *Arecaceae* found primarily in the tropics and subtropics of southeastern Asia with a few species extending into southern China and the Himalayas. [https://en.wikipedia.org/wiki/Daemonorops]"@en)
