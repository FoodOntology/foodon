AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411200 "PLANTS:VIUN")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411200 "Vigna unguiculata (L.) Walp.")
