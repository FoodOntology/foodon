# Class: obo:FOODON_03412270 (garden cress plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412270 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412270 "Cress (*Lepidium sativum*), sometimes referred to as garden cress to distinguish it from similar plants also referred to as cress (from old Germanic cresso which means sharp, spicy), is a rather fast-growing, edible herb. Garden cress is genetically related to watercress and mustard, sharing their peppery, tangy flavor and aroma. In some regions, garden cress is known as mustard and cress, garden pepper cress, pepperwort, pepper grass, or poor man's pepper.[https://en.wikipedia.org/wiki/Garden_cress]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 <http://eol.org/pages/585527>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?21769>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22978>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 langual:B2270)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 "MANSFELD:23709")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412270 "PLANTS:LESA2")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412270 "garden pepper cress"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412270 "lepidium sativum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412270 "peppergrass"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412270 "pepperwort"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412270 "poor man's pepper"@en)
