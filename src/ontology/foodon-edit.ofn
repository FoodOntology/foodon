# Class: obo:FOODON_03414702 (bush tomato plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414702 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414702 "The term bush tomato refers to the fruit or entire plants of certain nightshade (*Solanum*) species native to the more arid parts of Australia. Some of the edible species are: *Solanum aviculare*, *Solanum centrale*, *Solanum chippendalei*, *Solanum coactiliferum*, *Solanum diversiflorum*, *Solanum ellipticum*, *Solanum laciniatum*, *Solanum orbiculatum*, *Solanum phlomoides*, *Solanum vescum*. [https://en.wikipedia.org/wiki/Bush_tomato]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414702 <http://eol.org/pages/4437>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414702 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300568>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414702 langual:B4702)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414702 "PLANTS:SOLAN")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414702 "Solanum")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414702 "Solanum L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414702 "Solanum spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414702 "solanum spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414702 "bush tomato plant"@en)
SubClassOf(obo:FOODON_03414702 obo:FOODON_03411006)
SubClassOf(obo:FOODON_03414702 obo:FOODON_03415104)

# Class: obo:FOODON_03414703 (bush raisin plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414703 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414703 "Solanum centrale, the kutjera, or Australian desert raisin, is a plant native to the more arid parts of Australia. Like other \"bush tomatoes\", it has been used as a food source by Central Australia and Aboriginal groups for millennia."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414703 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=821426>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414703 langual:B4703)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414703 <https://eol.org/pages/52198634>)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414703 "australian desert raisin"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414703 "kutjera"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414703 "solanum centrale"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414703 "bush raisin plant"@en)
SubClassOf(obo:FOODON_03414703 obo:FOODON_03414702)
SubClassOf(obo:FOODON_03414703 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_400990))

# Class: obo:FOODON_03414704 (potato bush)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414704 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414704 "Solanum ellipticum is known as potato bush and under the more ambiguous name of \"bush tomato\". Native to Australia, the potato bush is a small fruiting shrub in the *Solanaceae* family. [https://en.wikipedia.org/wiki/Solanum_ellipticum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414704 <http://eol.org/pages/5696273>)
