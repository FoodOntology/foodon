AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414876 "black pacu")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414876 "tambaqui")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414876 "tambaqui"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414876 "colossoma macropomum"@en)
