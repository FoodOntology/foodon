AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414321 "kamut"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414321 "oriental wheat"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414321 "khorasan wheat plant"@en)
