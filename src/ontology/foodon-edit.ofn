# Class: obo:NCBITaxon_102107 (Prunus mume)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_102107 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_102107 "*Prunus mume* is an Asian tree species classified in the *Armeniaca* section of the genus *Prunus* subgenus *Prunus*. Its common names include Chinese plum and Japanese apricot. Although generally referred to as a plum in English, it is more closely related to the apricot. In Chinese, Japanese and Korean cooking, the fruit of the tree is used in juices, as a flavouring for alcohol, as a pickle and in sauces. It is also used in traditional medicine. [https://en.wikipedia.org/wiki/Prunus_mume]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_102107 "japanese apricot plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102107 <http://eol.org/pages/628584>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102107 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?30048>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102107 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=506231>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102107 langual:B5050)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102107 "PLANTS:PRMU5")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_102107 "Prunus mume Siebold & Zucc.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102107 "chinese plum"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102107 "prunus mume"@en)
SubClassOf(obo:NCBITaxon_102107 obo:FOODON_03411539)

# Class: obo:NCBITaxon_102211 (Benincasa hispida)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_102211 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_102211 "The winter melon, also called ash gourd, white gourd, wax gourd, winter gourd, tallow gourd, ash pumpkin, and Chinese preserving melon is a vine grown for its very large fruit, eaten as a vegetable when mature. It is the only member of the genus *Benincasa*. The fruit is fuzzy when young. The immature melon has thick white flesh that is sweet when eaten. By maturity, the fruit loses its hairs and develops a waxy coating, giving rise to the name wax gourd, and providing a long shelf life.[https://en.wikipedia.org/wiki/Winter_melon]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_102211 "fuzzy melon plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102211 <http://eol.org/pages/484058>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102211 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?6746>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102211 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=505894>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102211 langual:B2518)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_102211 "PLANTS:BEHI3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_102211 "Benincasa hispida (Thunb.) Cogn.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "benincasa hispida var."@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "chinese vegetable marrow"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "hairy melon"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "mogwa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "tallow gourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "waxgourd"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_102211 "winter melon"@en)
SubClassOf(obo:NCBITaxon_102211 obo:FOODON_03412091)

# Class: obo:NCBITaxon_102329 (Pinctada margaritifera)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_102329 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_102329 "*Pinctada margaritifera*, commonly known as the black-lip pearl oyster, is a species of pearl oyster, a saltwater clam, a marine bivalve mollusk in the family Pteriidae. This species is common in the Indo-Pacific within tropical coral reefs."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_102329 "blacklip pearl oyster"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_102329 wikipedia:Pinctada_margaritifera)
