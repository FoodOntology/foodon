# Class: obo:FOODON_03414848 (rat)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414848 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414848 "Rats are various medium-sized, long-tailed rodents of the superfamily *Muroidea*. \"True rats\" are members of the genus Rattus, the most important of which to humans are the black rat, Rattus rattus, and the brown rat, Rattus norvegicus. Many members of other rodent genera and families are also referred to as rats, and share many characteristics with true rats."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414848 wikipedia:Rat)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414848 <http://eol.org/pages/8698>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414848 langual:B4848)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414848 "MSW3:13001727")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414848 "Rattus Fischer, 1803")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414848 "Rattus G. Fischer, 1803")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414848 "rattus"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414848 "Rat meat is a food that, while taboo in some cultures, is a dietary staple in others."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414848 "rat"@en)
SubClassOf(obo:FOODON_03414848 obo:FOODON_03411134)

# Class: obo:FOODON_03414849 (equine animal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414849 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414849 "Equus is a genus of mammals in the family Equidae, which includes horses, asses, and zebras. Within Equidae, Equus is the only recognized extant genus, comprising seven living species. The term equine refers to any member of this genus, including horses."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414849 <https://en.wikipedia.org/wiki/Equus_(genus)>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414849 <http://eol.org/pages/1670>)
