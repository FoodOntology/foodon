AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414888 "Alopiidae"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414888 "Alopias Rafinesque, 1810")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414888 "alopias"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414888 "thresher shark"@en)
SubClassOf(obo:FOODON_03414888 obo:FOODON_03412553)

