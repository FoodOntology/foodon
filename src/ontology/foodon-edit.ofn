AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00000015 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00000015 "https://en.wikipedia.org/wiki/Cattle#Terminology"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00000015 "2019-02-21T03:01:03Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_00000015 "http://purl.obolibrary.org/obo/AGRO_00000119"@en)
