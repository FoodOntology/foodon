AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414912 "vernonia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414912 "bitterleaf plant"@en)
SubClassOf(obo:FOODON_03414912 obo:FOODON_03411566)

# Class: obo:FOODON_03414913 (rock samphire plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414913 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414913 "Crithmum is a genus of flowering plant with the sole species *Crithmum maritimum*, known as samphire, rock samphire, or sea fennel. [https://en.wikipedia.org/wiki/Crithmum]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414913 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?402237>)
