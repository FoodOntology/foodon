AnnotationAssertion(rdfs:label obo:FOODON_03414505 "scallop squash plant"@en)
SubClassOf(obo:FOODON_03414505 obo:FOODON_03411190)

# Class: obo:FOODON_03414506 (beaked hazel plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414506 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414506 "Corylus cornuta Marsh. is a deciduous shrubby hazel found in most of North America, from southern Canada south to Georgia and California. *Corylus cornuta* is named from its fruit, which is a nut enclosed in a husk with a tubular extension 2-4 cm (0.79-1.6 in) long that resembles a beak. Tiny filaments protrude from the husk and may stick into, and irritate, skin that contacts them. The spherical nuts, which are surrounded by a hard shell, are edible. There are two varieties: *Corylus cornuta* var. *cornuta* - Eastern Beaked Hazel; small shrub, 4 to 6 m tall; 'beak' longer, 3 cm or more. *Corylus cornuta* var. *californica* - Western Beaked Hazel or California Hazelnut; large shrub, 4 to 15 m tall; 'beak' shorter, usually less than 3 cm."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 <http://eol.org/pages/1147594>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=19507>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 langual:B4506)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 "PLANTS:COCO6")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 "PLANTS:COCOC")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414506 "PLANTS:COCOC2")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414506 "beaked hazelnut"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414506 "corylus cornuta"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414506 "western hazel"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414506 "beaked hazel plant"@en)
SubClassOf(obo:FOODON_03414506 obo:FOODON_03411533)
SubClassOf(obo:FOODON_03414506 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_13452))

# Class: obo:FOODON_03414507 (blue corn plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414507 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414507 "Blue corn is a variety of Flint maize grown in northern Mexico and the Southwestern United States, particularly in the states of Arizona and New Mexico."@en)
