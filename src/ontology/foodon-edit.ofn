# Class: <http://purl.obolibrary.org/obo/FOODON_03414218> (myrtle-leaf orange plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414218> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414218> "Citrus myrtifolia, the myrtle-leaved orange tree, is a species of Citrus with foliage similar to that of the common myrtle. The fruit of the tree resemble small oranges. They are sour or bitter and are commonly called by their Italian name, *chinotto*. They are an essential flavoring agent of most Italian amari, of the popular Campari apéritif, and of several brands of carbonated soft drinks that are generically called \"chinotto\". [https://en.wikipedia.org/wiki/Citrus_myrtifolia]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414218> <http://eol.org/pages/4414>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414218> <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10756>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414218> <http://www.langual.org/langual_thesaurus.asp?termid=B4218>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414218> "Citrus myrtifolia Raf.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414218> "citrus myrtifolia"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414218> "myrtle-leaf orange plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414218> <http://purl.obolibrary.org/obo/FOODON_03411139>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03414220> (galia melon plant)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03414220> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03414220> "The Galia is a type of hybrid melon originating from a cantaloupe-honeydew cross, larger than a cantaloupe, and with deep green flesh. The name Galia is the feminine form of the Israeli name Gal (meaning 'wave')."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03414220> "WIKIPEDIA:Galia_(melon)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414220> <http://www.langual.org/langual_thesaurus.asp?termid=B4220>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414220> "galia melon plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414220> <http://purl.obolibrary.org/obo/FOODON_03414221>)

