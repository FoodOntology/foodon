AnnotationAssertion(go:hasDbXref obo:FOODON_03430167 langual:E0167)
AnnotationAssertion(rdfs:label obo:FOODON_03430167 "syrup food supplement"@en)
SubClassOf(obo:FOODON_03430167 obo:FOODON_03430165)

