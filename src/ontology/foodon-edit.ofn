# Class: obo:FOODON_03414160 (odocoileus deer)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414160 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414160 "Odocoileus is a genus of medium-sized deer (family *Cervidae*) containing two species native to the Americas. The name is sometimes spelt odocoeleus; it is from a contraction of the roots odonto- and coelus meaning \"hollow-tooth\"."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414160 "WIKIPEDIA:Odocoileus")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414160 <http://eol.org/pages/34547>)
