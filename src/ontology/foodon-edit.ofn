AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414290 "new zealand leatherjacket"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414290 "parika scaber"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414290 "velvet leatherjacket"@en)
