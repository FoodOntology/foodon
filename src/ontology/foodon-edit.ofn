AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412264> "toadfish family"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412264> <http://purl.obolibrary.org/obo/FOODON_03412200>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03412265> (scorpaeniform fish)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03412265> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412265> "The Scorpaeniformes are a diverse order of ray-finned fish, including the well-known lionfish, but have also been called the Scleroparei. It is one of the five largest orders of bony fishes by number of species with over 1,320. [https://en.wikipedia.org/wiki/Scorpaeniformes]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412265> <http://eol.org/pages/5120>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412265> <http://www.langual.org/langual_thesaurus.asp?termid=B2265>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03412265> "scorpaeniformes"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412265> "scorpaeniform fish"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412265> <http://purl.obolibrary.org/obo/FOODON_03411365>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03412266> (seaweed)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03412266> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03412266> "A macroscopic, multicellular, marine algae (kingdom Protista) that belongs to one of several groups of multicellular algae: the red algae, green algae, and brown algae. As these three groups are not thought to have a common multicellular ancestor, the seaweeds are a polyphyletic group. In addition, some tuft-forming bluegreen algae (Cyanobacteria) are sometimes considered seaweed."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_03412266> "Damion Dooley"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03412266> <https://en.wikipedia.org/wiki/Seaweed>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_03412266> "Seaweed is a colloquial term and lacks a formal definition."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412266> <http://www.langual.org/langual_thesaurus.asp?termid=B2266>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03412266> "macroalgae"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412266> "seaweed"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412266> <http://purl.obolibrary.org/obo/FOODON_03411301>)

