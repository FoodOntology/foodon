# Class: <http://purl.obolibrary.org/obo/FOODON_03413792> (white truffle)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/FOODON_03413792> <http://purl.obolibrary.org/obo/IAO_0000428>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03413792> "The \"white truffle\" or \"trifola d'Alba\" (*Tuber magnatum*) comes from the Langhe and Montferrat areas of the Piedmont region in northern Italy and, most famously, in the countryside around the cities of Alba and Asti; in Italy it can also be found in Molise, Abruzzo, and in the hills around San Miniato, in Tuscany. It is also found on the Istria peninsula, in Croatia in the Motovun forest along the Mirna river, and in Slovenia along the Dragonja and Rizana river, as well as in the Drome area in France."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_03413792> "WIKIPEDIA:Truffle#White_truffle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03413792> <http://www.indexfungorum.org/names/NamesRecord.asp?RecordID=184470>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03413792> <http://www.langual.org/langual_thesaurus.asp?termid=B3792>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03413792> "Tuber magnatum Picco, 1788")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413792> "alba truffle"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413792> "italian white truffle"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03413792> "tuber magnatum"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03413792> "white truffle"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03413792> <http://purl.obolibrary.org/obo/FOODON_03411387>)

