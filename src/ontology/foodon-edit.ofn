AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412515 langual:B2515)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412515 "PLANTS:TRAM13")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "aiwain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "ajawain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "ajowan caraway"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "ajwain"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "ajwan"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "bishop's weed"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "carom"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "carum copticum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "ooman"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412515 "trachyspermum copticum"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412515 "ajowan plant"@en)
SubClassOf(obo:FOODON_03412515 obo:FOODON_03411179)
SubClassOf(obo:FOODON_03412515 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_52570))

