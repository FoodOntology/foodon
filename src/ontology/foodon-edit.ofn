# Class: obo:FOODON_03411227 (carrot plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411227 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411227 "The carrot (*Daucus carota* subsp. *sativus*) is a root vegetable, usually orange, purple, red, white, or yellow in colour, with a crisp texture when fresh. The edible part of a carrot is a taproot. It is a domesticated form of the wild carrot *Daucus carota*, native to Europe and southwestern Asia. It has been bred for its greatly enlarged and more palatable, less woody-textured edible taproot, but is still the same species. [Wikipedia]
\\n\\n*Daucus carota* (common names include wild carrot, (UK) bird's nest, bishop's lace, and (US) Queen Anne's lace) is a flowering plant in the family *Apiaceae*, native to temperate regions of Europe, southwest Asia and naturalised to northeast North America; domesticated carrots are cultivars of a subspecies, *Daucus carota* subsp. *sativus*. Like the cultivated carrot, the wild carrot root is edible while young, but quickly becomes too woody to consume. [Wikipedia]"@en)
AnnotationAssertion(go:hasBroadSynonym obo:FOODON_03411227 "daucus carota"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://eol.org/pages/581785>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 obo:NCBITaxon_4039)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?13337>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?300172>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?446682>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=29477>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=524845>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=524846>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 langual:B1227)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411227 "MANSFELD:1080")
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411227 "baby carrot plant"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411227 "bird's nest"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411227 "queen anne's lace"@en)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03411227 "wild carrot plant"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus carota L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus carota L. subsp. carota")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus carota L. subsp. sativus (Hoffm.) Arcang.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus carota ssp. carota L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411227 "Daucus carota ssp. sativus  (Hoffm.) Arcang.")
AnnotationAssertion(rdfs:comment obo:FOODON_03411227 "LanguaL curation note: Use for both wild and domesticated (garden) carrot. The is some disagreement concerning the scientific name."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411227 "carrot plant"@en)
