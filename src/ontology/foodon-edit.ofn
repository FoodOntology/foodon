# Class: obo:FOODON_03415055 (schisandra plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03415055 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03415055 "Schisandra (magnolia vine) is a genus of twining shrubnative to East Asia, and its dried fruit is sometimes used medicinally. The berries of *S. chinensis* are given the name wu wei zi in Chinese, which translates as \"five flavor fruit\" because they possess all five basic flavors in Chinese herbal medicine: salty, sweet, sour, pungent (spicy), and bitter.  [https://en.wikipedia.org/wiki/Schisandra]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415055 <http://eol.org/pages/4297>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415055 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?413956>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415055 langual:B5055)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03415055 "PLANTS:SCHIS2")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415055 "Schisandra Michx.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03415055 "Schisandra spp.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415055 "five-flavor-fruit"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03415055 "magnolia-vine"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415055 "schisandra plant"@en)
SubClassOf(obo:FOODON_03415055 obo:FOODON_03411179)

