# Class: obo:FOODON_00003334 (serving size)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003334 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003334 "A portion of a food product presented in the general context of daily a recommended intake of a food group."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003334 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003334 <https://www.fda.gov/food/new-nutrition-facts-label/serving-size-new-nutrition-facts-label>)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00003334 "The serving size is shown as a common household measure that is appropriate to the food (such as cup, tablespoon, piece, slice, or jar), followed by the metric amount in grams (g). ... By law, serving sizes must be based on the amount of food people typically consume, rather than how much they should consume. [FDA]"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00003334 "2020-04-11T00:09:40Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00003334 "serving size"@en)
AnnotationAssertion(rdfs:seeAlso obo:FOODON_00003334 <https://fns-prod.azureedge.net/sites/default/files/nutrition_insights_uploads/insight11.pdf>)
SubClassOf(obo:FOODON_00003334 obo:IAO_0000032)

# Class: obo:FOODON_00003335 (food label serving)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003335 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003335 "A specific amount of food that a food product's nutrition facts' listed nutrient quantities pertain to."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003335 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003335 <https://fns-prod.azureedge.net/sites/default/files/nutrition_insights_uploads/insight11.pdf>)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00003335 "The food label serving unit is specific for each product category and designed to help consumers compare nutrient information on a number of food products within a category. [USDA Center for Nutrition Policy and Promotion, 1999]"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00003335 "2020-04-11T00:18:46Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00003335 "food label serving"@en)
SubClassOf(obo:FOODON_00003335 obo:IAO_0000032)
SubClassOf(obo:FOODON_00003335 obo:OBI_0000679)

# Class: obo:FOODON_00003336 (food portion)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003336 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003336 "An amount of a specific food an individual eats for dinner, snack, or other eating occasion."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003336 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003336 <https://fns-prod.azureedge.net/sites/default/files/nutrition_insights_uploads/insight11.pdf>)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_00003336 "Portions can be bigger or smaller than the servings listed in daily intake recommendations or on a food label. Many factors affect food portions, such as the individual’s age, gender, activity level, and appetite and where and when the food is obtained and eaten. [USDA Center for Nutrition Policy and Promotion, 1999]"@en)
AnnotationAssertion(dcterms:date obo:FOODON_00003336 "2020-04-11T00:38:57Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:FOODON_00003336 "portion"@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003336 "food portion"@en)
SubClassOf(obo:FOODON_00003336 obo:IAO_0000032)

# Class: obo:FOODON_00003337 (percent daily value)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003337 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003337 "A percentage indicating how much a nutrient in a single serving of an individual packaged food or dietary supplement contributes to an individual's recommended daily value intake for that nutrient."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003337 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003337 <https://www.fda.gov/food/new-nutrition-facts-label/daily-value-new-nutrition-and-supplement-facts-labels>)
AnnotationAssertion(dcterms:date obo:FOODON_00003337 "2020-04-12T06:28:15Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00003337 "percent daily value"@en)
SubClassOf(obo:FOODON_00003337 obo:IAO_0000032)

# Class: obo:FOODON_00003338 (daily nutrient value)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003338 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003338 "A datum about a recommended amount of a nutrient for an individual to consume or not to exceed each day."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003338 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003338 <https://www.fda.gov/food/new-nutrition-facts-label/daily-value-new-nutrition-and-supplement-facts-labels>)
AnnotationAssertion(dcterms:date obo:FOODON_00003338 "2020-04-12T06:37:39Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00003338 "daily nutrient value"@en)
SubClassOf(obo:FOODON_00003338 obo:IAO_0000032)
SubClassOf(obo:FOODON_00003338 obo:OBI_0000679)

# Class: obo:FOODON_00003339 (food calorie datum)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00003339 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00003339 "A datum, measured in food calories, representing a potential amount of energy available in a food material to a consumer."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00003339 <http://orcid.org/0000-0002-8844-9165>)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00003339 wikipedia:Calorie)
AnnotationAssertion(dcterms:date obo:FOODON_00003339 "2020-04-12T06:54:43Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment obo:FOODON_00003339 "1 kilocalorie (kcal) = 1000 calories (cal). By convention in food science, the large calorie is commonly called calorie (with a capital C by some authors) to distinguish from the smaller unit."@en)
AnnotationAssertion(rdfs:label obo:FOODON_00003339 "food calorie datum"@en)
SubClassOf(obo:FOODON_00003339 obo:IAO_0000032)

