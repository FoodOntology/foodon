AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03430168 obo:IAO_0000428)
AnnotationAssertion(go:hasDbXref obo:FOODON_03430168 langual:E0168)
AnnotationAssertion(go:hasSynonym obo:FOODON_03430168 "oral spray"@en)
