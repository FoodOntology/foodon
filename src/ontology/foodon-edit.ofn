# Class: obo:NCBITaxon_979180 (Acetes japonicus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_979180 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_979180 "A genus of small shrimp that resemble krills, which is native throughout the seas of Asia. Several of its species are important for the production of shrimp paste in Southeast Asia, including *Acetes japonicus*, which is the world's most heavily fished species of wild shrimp or prawn in terms of total tonnage."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_979180 "akiami paste shrimp"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_979180 wikipedia:Acetes)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_979180 <http://eol.org/pages/1021517>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_979180 langual:B4895)
