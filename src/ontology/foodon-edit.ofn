# Class: obo:FOODON_00002581 (aquatic invertebrate)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002581 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002581 "An aquatic invertebrate may live entirely beneath the water, or may live upon its surface or on the plants surrounding it. Some breathe air, others breathe water. To move, they may walk, swim, float, skate, fly or glide on their bellies—or they may not move much at all."@en)
AnnotationAssertion(obo:IAO_0000116 obo:FOODON_00002581 "Because snails are members of gastropod, a subclass of molluscs, ... leading to aquatic invertebrates, we can't make aquatic invertebrates disjoint with terrestrial invertebrates."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002581 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002581 "https://nature.mdc.mo.gov/discover-nature/general-species-information/aquatic-invertebrate-facts"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002581 "2019-04-29T19:23:38Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:FOODON_00002581 "aquatic invertebrate"@en)
SubClassOf(obo:FOODON_00002581 obo:FOODON_00002452)
SubClassOf(obo:FOODON_00002581 obo:FOODON_00005683)

# Class: obo:FOODON_00002582 (giant water bug)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_00002582 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_00002582 "The giant water bug is well known as an edible species in a number of different Southeast Asian cuisines. The taste of the flight muscles is often compared to sweet scallops or shrimp. It is native to South and Southeast Asia, as well as southeast China, Korea, the Ryukyu Islands and New Guinea."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_00002582 "Damion Dooley")
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002582 "https://en.wikipedia.org/wiki/Lethocerus_indicus"^^xsd:anyURI)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_00002582 "https://www.eatingthaifood.com/how-to-eat-a-giant-water-bug-maeng-da-thailand/"^^xsd:anyURI)
AnnotationAssertion(dcterms:date obo:FOODON_00002582 "2019-04-29T20:28:32Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(dcterms:license <https://creativecommons.org/licenses/by-sa/3.0>) Annotation(dcterms:rightsHolder <https://en.wikipedia.org/wiki/vi:User:Viethavvh>) schema:image obo:FOODON_00002582 "https://upload.wikimedia.org/wikipedia/commons/thumb/5/53/Lethocerus_indicus.jpg/180px-Lethocerus_indicus.jpg"^^xsd:anyURI)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002582 "Lethocerus indicus"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_00002582 "cà cuống"@vi)
