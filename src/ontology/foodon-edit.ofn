# Class: obo:FOODON_03411608 (miniature tomato plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411608 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411608 "A cherry tomato is a small variety of tomato that has been cultivated since at least the early 1800s and thought to have originated in Peru and Northern Chile. Cherry tomatoes range in size from a thumbtip up to the size of a golf ball, and can range from being spherical to slightly oblong in shape. The more oblong ones often share characteristics with plum tomatoes, and are known as grape tomatoes. The cherry tomato is regarded as a botanical variety of the cultivated berry, *Solanum lycopersicum* var. *cerasiforme*."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03411608 "WIKIPEDIA:Cherry_tomato")
AnnotationAssertion(go:hasDbXref obo:FOODON_03411608 <http://eol.org/pages/4437>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411608 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?406486>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411608 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=566309>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411608 langual:B1608)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411608 "PLANTS:SOLYC")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411608 "Lycopersicon esculentum Mill.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411608 "Solanum lycopersicum L. var. cerasiforme (Dunal) Spooner, G.J. Anderson & R.K. Jansen")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411608 "Solanum lycopersicum var. cerasiforme (Alef.) Fosberg")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411608 "Solanum lycopersicum var. cerasiforme (Dunal) Spooner, J. Anderson & R.K. Jansen")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411608 "cherry tomato"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411608 "lycopersicon lycopersicum var. cerasiforme"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411608 "midget tomato"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411608 "miniature tomato plant"@en)
SubClassOf(obo:FOODON_03411608 obo:NCBITaxon_4081)

