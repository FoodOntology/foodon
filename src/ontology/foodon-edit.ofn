# Class: obo:FOODON_03414934 (solanaceae plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414934 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414934 "The *Solanaceae*, or nightshades, are an economically important family of flowering plants. Many members of the family contain potent alkaloids, and some are highly toxic, but many, including tomatoes, potatoes, eggplant, bell/chili peppers, and tobacco are widely used. The *Solanaceae* consists of about 98 genera and some 2,700 species, with a great diversity of habitats, morphology and ecology. [https://en.wikipedia.org/wiki/Solanaceae]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414934 <http://eol.org/pages/4437>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414934 langual:B4934)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414934 "nightshade family"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414934 "solanaceae plant"@en)
SubClassOf(obo:FOODON_03414934 obo:FOODON_03413357)

# Class: obo:FOODON_03414935 (armenian cucumber plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414935 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414935 "The Armenian cucumber, *Cucumis melo* var. *flexuosus*, is a type of long, slender fruit which tastes like a cucumber and looks somewhat like a cucumber inside. It is actually a variety of muskmelon (*C. melo*), a species closely related to the cucumber (*C. sativus*). It is also known as the yard-long cucumber, snake cucumber, snake melon, and uri in Japan. It should not be confused with the snake gourds (*Trichosanthes* spp.). [https://en.wikipedia.org/wiki/Armenian_cucumber]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414935 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?12569>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414935 langual:B4935)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414935 "Cucumis melo var. flexuosus (L.) Naudin")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414935 "cucumis melo flexuosus"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414935 "serpent melon"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414935 "snake melon"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414935 "armenian cucumber plant"@en)
SubClassOf(obo:FOODON_03414935 obo:FOODON_03414459)

# Class: obo:FOODON_03414941 (tuberous-root mustard plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414941 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414941 "This mustard relative develops a tuberous root, in appearance much like a globular turnip. Roots reach a diameter of 3 to 4 inches, and are similar to turnips in appearance, texture, flavor and culture. It is rarely grown in the U.S. The root, leaves and petioles are edible. [https://dev.hort.purdue.edu/newcrop/Crops/MustardTuberousRootedChine.html]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414941 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?461021>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414941 langual:B4941)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414941 "Brassica juncea subsp. napiformis (Pailleux & Bois) Gladis")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414941 "brassica juncea napiformis"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414941 "turnip-root mustard"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414941 "tuberous-root mustard plant"@en)
SubClassOf(obo:FOODON_03414941 obo:FOODON_03411092)

# Class: obo:FOODON_03414945 (broccolini plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414945 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414945 "Broccolini is a green vegetable similar to broccoli but with smaller florets and longer, thin stalks. It is a natural hybrid of broccoli and gai lan, both cultivar groups of *Brassica oleracea*. [https://en.wikipedia.org/wiki/Broccolini]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414945 langual:B4945)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414945 "bimi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414945 "broccolini plant"@en)
SubClassOf(obo:FOODON_03414945 obo:FOODON_03411443)

# Class: obo:FOODON_03414946 (batavia lettuce plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414946 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414946 "A lettuce which is midway between the crisphead and leaf types. These lettuces tend to be larger, bolt-resistant and well-flavored."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414946 <https://en.wikipedia.org/wiki/Lettuce#Cultivars>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414946 langual:B4946)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414946 "French crisp"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414946 "summercrisp lettuce"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414946 "batavia lettuce plant"@en)
SubClassOf(obo:FOODON_03414946 obo:FOODON_03411390)

# Class: obo:FOODON_03414951 (chokeberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414951 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414951 "Aronia is a genus of deciduous shrubs, the chokeberries, in the family *Rosaceae* native to eastern North America and most commonly found in wet woods and swamps. [https://en.wikipedia.org/wiki/Aronia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414951 <http://eol.org/pages/8097>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414951 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?313669>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414951 langual:B4951)
AnnotationAssertion(go:hasExactSynonym obo:FOODON_03414951 "Aronia"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414951 "chokeberry plant"@en)
SubClassOf(obo:FOODON_03414951 obo:FOODON_03411231)

# Class: obo:FOODON_03414953 (purple chokeberry plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414953 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414953 "Aronia prunifolia, called the purple chokeberry, is a North American species of shrubs in the rose family. Flowers are white or pink, producing purple fruits. Many people consider the fruits to be foul-tasting. [https://en.wikipedia.org/wiki/Aronia_prunifolia]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414953 <http://eol.org/pages/8097>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414953 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?104451>)
