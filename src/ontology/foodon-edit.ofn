AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_16752 "Houttuynia cordata Thunb.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_16752 "fish mint"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_16752 "houttuynia"@en)
SubClassOf(obo:NCBITaxon_16752 obo:FOODON_03411179)

