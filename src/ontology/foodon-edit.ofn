AnnotationAssertion(go:hasSynonym obo:FOODON_03414817 "psyllidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414817 "eucalyptus psyllid"@en)
SubClassOf(obo:FOODON_03414817 obo:FOODON_03414646)

# Class: obo:FOODON_03414819 (kangaroo vine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414819 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414819 "Cissus antarctica (synonym *Cissus oblongata*), called \"kangaroo vine\", is one of the best known species of the genus *Cissus* in the family of *Vitaceae*. It is a climbing plant, a vine, and comes from Australia.[https://en.wikipedia.org/wiki/Cissus_antarctica]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414819 <http://eol.org/pages/4382>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414819 langual:B4819)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414819 "USDA PLANTS:CIAN3")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414819 "Cissus antarctica Venten")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414819 "cissus antarctica"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414819 "cissus oblongata"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03414819 "kangaroo ivy"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414819 "kangaroo vine plant"@en)
SubClassOf(obo:FOODON_03414819 obo:FOODON_03414650)

# Class: obo:FOODON_03414820 (giant water vine plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414820 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414820 "Cissus hypoglauca is a common Australian vine. It is one of the better known climbing plants of the genus *Cissus* in the grape family. A very common climber in moist areas of eastern Australia, it often colonises large areas after forest damage due to storms, fire or logging. Common names include jungle grape, water vine, giant water vine, five-leaf water vine, jungle vine, native grapes and billangai [https://en.wikipedia.org/wiki/Cissus_hypoglauca]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414820 <http://eol.org/pages/4382>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414820 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?10614>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414820 langual:B4820)
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03414820 "Cissus hypoglauca A. Gray")
AnnotationAssertion(go:hasSynonym obo:FOODON_03414820 "cissus hypoglauca"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414820 "giant water vine plant"@en)
SubClassOf(obo:FOODON_03414820 obo:FOODON_03414650)

# Class: obo:FOODON_03414823 (green plum plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414823 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414823 "Buchanania obovata is a small to medium-sized understorey tree in woodlands native to northern Australia. Common names include green plum and wild mango. The fruit is traditionally eaten by Aborigines. The plant also has traditional medicinal uses. [https://en.wikipedia.org/wiki/Buchanania_obovata]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03414823 <http://eol.org/pages/4410>)
