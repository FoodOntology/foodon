# Class: obo:NCBITaxon_268884 (Origanum majorana)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_268884 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_268884 "Marjoram (*Origanum majorana*) is a somewhat cold-sensitive perennial herb or undershrub with sweet pine and citrus flavors. In some Middle Eastern countries, marjoram is synonymous with oregano, and there the names sweet marjoram and knotted marjoram are used to distinguish it from other plants of the genus *Origanum*. [https://en.wikipedia.org/wiki/Marjoram]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_268884 "sweet marjoram plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 <http://eol.org/pages/579365>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?25912>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32631>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 langual:B1609)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 "MANSFELD:16210")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268884 "PLANTS:ORMA")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_268884 "Origanum majorana L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268884 "marjoram"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268884 "marjoram, sweet"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268884 "origanum majorana"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_268884 "sweet marjoram"@en)
SubClassOf(obo:NCBITaxon_268884 obo:FOODON_03411179)

# Class: obo:NCBITaxon_268906 (Salvia fruticosa)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_268906 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_268906 "*Salvia fruticosa*, Greek oregano or Greek sage, is a perennial herb or sub-shrub native to the eastern Mediterranean, including southern Italy, the Canary Islands and North Africa. It is especially abundant in Israel. [https://en.wikipedia.org/wiki/Salvia_fruticosa]"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_268906 "greek sage plant"@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_268906 <http://eol.org/pages/6342166>)
