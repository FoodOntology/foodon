AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_28528 "Pinus mugo Turra")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28528 "dwarf mountainpine"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_28528 "pinus mugo"@en)
SubClassOf(obo:NCBITaxon_28528 obo:FOODON_03411083)

