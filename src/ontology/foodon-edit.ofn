AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412027 "MANSFELD:410")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412027 "PLANTS:CHQU")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412027 "quinoa")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412027 "chenopodium quinoa"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412027 "quinoa plant"@en)
SubClassOf(obo:FOODON_03412027 obo:FOODON_03411324)
SubClassOf(obo:FOODON_03412027 obo:FOODON_03414745)
SubClassOf(obo:FOODON_03412027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_63459))

# Class: obo:FOODON_03412028 (banana passionfruit plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412028 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412028 "Banana passionfruit is the fruit of several plants in the genus Passiflora, and are therefore related to the passion fruit. They look somewhat like a straight, small banana with rounded ends. It was given this name in New Zealand, where passionfruit are also prevalent. In Hawaii, it is called banana poka. In its Latin American homeland, it is known as curuba, curuba de Castilla, or curuba sabanera blanca (Colombia); taxo, tacso, tagso, tauso (Ecuador); parcha (Venezuela), tumbo or curuba (Bolivia); tacso, tumbo, tumbo del norte, trompos, or tintin (Peru)."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412028 "WIKIPEDIA:Banana_passionfruit")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412028 langual:B2028)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412028 "curuba"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412028 "passiflora spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412028 "banana passionfruit plant"@en)
SubClassOf(obo:FOODON_03412028 obo:FOODON_03414670)

