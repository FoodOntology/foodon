AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414266 langual:B4266)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414266 "PLANTS:MYCA9")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414266 "Myrciaria cauliflora (C. Martius) O. Berg")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414266 "Myrciaria cauliflora (Mart.) O. Berg")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414266 "brazilian grapetree"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414266 "myrciaria cauliflora"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414266 "jaboticaba plant"@en)
SubClassOf(obo:FOODON_03414266 obo:FOODON_03411024)
SubClassOf(obo:FOODON_03414266 obo:FOODON_03411231)

# Class: obo:FOODON_03414267 (carissa plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414267 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414267 "Carissa is a genus of about 20-30 species of shrubs or small trees native to tropical and subtropical regions of Africa, Australia and Asia. The fruit are edible but tart, and taste like a giant cranberry and rich in Vitamin C, calcium, magnesium and phosphorus. The fruit of *C. macrocarpa* is especially delicious and is used to make jelly. They are eagerly consumed by birds, which also distribute the seed. If eaten before fully ripe, a bitter, latex-like substance is released from the skin. Other than the fruit, the plant is poisonous."@en)
