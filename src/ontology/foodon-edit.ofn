AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03411416 "pistachio")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411416 "pistacia vera"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411416 "pistachio plant"@en)
SubClassOf(obo:FOODON_03411416 obo:FOODON_03411022)
SubClassOf(obo:FOODON_03411416 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_55513))

