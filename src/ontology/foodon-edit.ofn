# Class: obo:FOODON_03412262 (oregano, mexican (plant))

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412262 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412262 "Lippia graveolens, a species of flowering plant in the verbena family, *Verbenaceae*, is native to the southwestern United States (Texas and southern New Mexico), Mexico, and Central America as far south as Nicaragua. Common names include Mexican oregano, redbrush lippia, orégano Cimmaron, scented lippia, and scented matgrass. 
The essential oil of *Lippia graveolens* contains 0-81% thymol, 0-48% carvacrol, 3-30% para-cymene, and 0-15% eucalyptol. The first two components give the plant a flavor similar to oregano, and the leaves are widely used as an herb in Mexico and Central America [https://en.wikipedia.org/wiki/Lippia_graveolens]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412262 <http://eol.org/pages/4304>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412262 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?101142>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412262 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=32068>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412262 langual:B2262)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412262 "PLANTS:LIGR6")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03412262 "Lippia graveolens Kunth")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "lippia graveolens"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "mexican marjoram"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "mexican oregano"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "mexican sage"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "mexican sage, origan"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "mexican wild sage"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "oregano, lippia"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "oreganum"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "origan"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412262 "sage, mexican"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412262 "oregano, mexican (plant)"@en)
SubClassOf(obo:FOODON_03412262 obo:FOODON_03411179)

# Class: obo:FOODON_03412264 (toadfish family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412264 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412264 "Batrachoididae is the only family in the ray-finned fish order Batrachoidiformes. Members of this family are usually called toadfish, or \"frogfish\": both the English common name and scientific name refer to their toad-like appearance. [https://en.wikipedia.org/wiki/Batrachoididae]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412264 <http://eol.org/pages/8249>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412264 langual:B2264)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412264 "batrachoididae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412264 "toadfish family"@en)
SubClassOf(obo:FOODON_03412264 obo:FOODON_03412200)

# Class: obo:FOODON_03412265 (scorpaeniform fish)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412265 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412265 "The Scorpaeniformes are a diverse order of ray-finned fish, including the well-known lionfish, but have also been called the Scleroparei. It is one of the five largest orders of bony fishes by number of species with over 1,320. [https://en.wikipedia.org/wiki/Scorpaeniformes]"@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412265 <http://eol.org/pages/5120>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412265 langual:B2265)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03412265 "scorpaeniformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412265 "scorpaeniform fish"@en)
SubClassOf(obo:FOODON_03412265 obo:FOODON_03411365)

# Class: obo:FOODON_03412266 (seaweed)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03412266 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03412266 "A macroscopic, multicellular, marine algae (kingdom Protista) that belongs to one of several groups of multicellular algae: the red algae, green algae, and brown algae. As these three groups are not thought to have a common multicellular ancestor, the seaweeds are a polyphyletic group. In addition, some tuft-forming bluegreen algae (Cyanobacteria) are sometimes considered seaweed."@en)
AnnotationAssertion(obo:IAO_0000117 obo:FOODON_03412266 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03412266 wikipedia:Seaweed)
AnnotationAssertion(obo:IAO_0000600 obo:FOODON_03412266 "Seaweed is a colloquial term and lacks a formal definition."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03412266 langual:B2266)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03412266 "macroalgae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412266 "seaweed"@en)
SubClassOf(obo:FOODON_03412266 obo:FOODON_03411301)

