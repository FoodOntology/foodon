AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411281 langual:B1281)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411281 "MANSFELD:23870")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411281 "Brassica oleracea L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411281 "Brassica oleracea L. var. sabellica L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411281 "Brassica oleracea var. sabellica L.")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411281 "brassica oleracea"@en)
