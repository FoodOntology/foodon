# Class: obo:FOODON_03411894 (fish, semionotiformes)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411894 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411894 "Semionotiformes (\"flag-back form\") is an order of primitive, ray-finned, primarily freshwater fish from the Triassic to the Cretaceous. The best-known genus is *Semionotus* of Europe and North America. [https://en.wikipedia.org/wiki/Semionotiformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411894 <http://eol.org/pages/5467>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411894 langual:B1894)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411894 "gars"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411894 "lepisosteiformes"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411894 "semionotiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411894 "fish, semionotiformes"@en)
SubClassOf(obo:FOODON_03411894 obo:FOODON_03411365)

# Class: obo:FOODON_03411895 (fish, zeiform)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03411895 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411895 "The Zeiformes are a small order of marine ray-finned fishes most notable for the dories, a group of common food fish. The order consists of about 33 species in seven families, mostly deep-sea types. [https://en.wikipedia.org/wiki/Zeiformes]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411895 <http://eol.org/pages/1906>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411895 langual:B1895)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411895 "john dory"@en)
AnnotationAssertion(go:hasSynonym obo:FOODON_03411895 "zeiformes"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411895 "fish, zeiform"@en)
SubClassOf(obo:FOODON_03411895 obo:FOODON_03411365)

