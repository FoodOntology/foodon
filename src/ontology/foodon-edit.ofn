# Class: obo:NCBITaxon_669814 (Salix pulchra)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_669814 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_669814 "A species of flowering plant in the willow family, it is native to northern North America, where it occurs in Alaska, Yukon, the Northwest Territories, and Nunavut. The species is also found in northern British Columbia, and occurs in Russia."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_669814 "tealeaf willow plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_669814 "WIKIPEDIA:Salix_pulchra")
AnnotationAssertion(obo:IAO_0000600 obo:NCBITaxon_669814 "Salix pulchra* is one of the least bitter-tasting willows in Alaska, and in the springtime, young leaves may be harvested for human consumption. The leaves and shoots were eaten by the Eskimo raw and dried, or stored in seal oil for future use. The leaves were also used to brew tea and make soup. At Nunivak Island, parts of this plant were chewed to treat ailments such as mouth sores and pain. This willow also provides a good source of vitamin C."@en)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_669814 <http://eol.org/pages/585411>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_669814 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=22488>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_669814 langual:B4502)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_669814 "PLANTS:SAPU15")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_669814 "diamondleaf willow"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_669814 "salix pulchra"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_669814 "tealeaf willow"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_669814 "thin red willow"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_669814 "Salix pulchra Cham.")
SubClassOf(obo:NCBITaxon_669814 obo:FOODON_03411179)
SubClassOf(obo:NCBITaxon_669814 obo:FOODON_03411566)

