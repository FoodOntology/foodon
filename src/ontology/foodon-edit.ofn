# Class: obo:FOODON_03414487 (spotted seal)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414487 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414487 "The spotted seal (*Phoca largha*, *Phoca vitulina largha*), also known as the larga or largha seal, is a member of the family *Phocidae*, and is considered a \"true seal\". It inhabits ice floes and waters of the north Pacific Ocean and adjacent seas."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414487 <http://eol.org/pages/328628>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414487 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=180642>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414487 langual:B4487)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414487 asfis:sst)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414487 "MSW3:14001059")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414487 "larga seal"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414487 "phoca largha"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414487 "phoca vitulina largha"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414487 "spotted seal"@en)
SubClassOf(obo:FOODON_03414487 obo:FOODON_03411341)
SubClassOf(obo:FOODON_03414487 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_39090))

# Class: obo:FOODON_03414489 (owl)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414489 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414489 "WIKIPEDIA:Strigiformes")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414489 <http://eol.org/pages/696>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414489 langual:B4489)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414489 "strigiformes"@en)
AnnotationAssertion(rdfs:comment obo:FOODON_03414489 "Owls are a group of birds that belong to the order *Strigiformes*, constituting 200 extant bird of prey species. Most are solitary and nocturnal, with some exceptions (e.g., the Northern Hawk Owl). Owls hunt mostly small mammals, insects, and other birds, although a few species specialize in hunting fish. They are found in all regions of the Earth except Antarctica, most of Greenland and some remote islands. Though owls are typically solitary, the literary collective noun for a group of owls is a parliament. Owls are characterized by their small beaks and wide faces, and are divided into two families: the typical owls, *Strigidae*; and the barn-owls, *Tytonidae*."@en)
SubClassOf(obo:FOODON_03414489 obo:FOODON_02022495)

# Class: obo:FOODON_03414490 (typical owl family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414490 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414490 "True owl or Typical owl (family *Strigidae*) are one of the two generally accepted families of Owls, the other being the barn owls (*Tytonidae*). The Sibley-Ahlquist taxonomy unites the *Caprimulgiformes* with the owl order; here, the typical owls are a subfamily *Strigidae*. This is unsupported by more recent research (see *Cypselomorphae* for details), but the relationships of the owls in general are still unresolved. This large family comprises around 189 living species in 25 genera. The typical owls have a cosmopolitan distribution and are found on every continent except Antarctica."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414490 "WIKIPEDIA:Strigidae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414490 <http://eol.org/pages/8660>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414490 langual:B4490)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414490 "strigidae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414490 "typical owl family"@en)
SubClassOf(obo:FOODON_03414490 obo:FOODON_03414489)

# Class: obo:FOODON_03414491 (great horned owl)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414491 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414491 "The Great Horned Owl, (*Bubo virginianus*), also known as the Tiger Owl, is a large owl native to the Americas. It is an adaptable bird with a vast range and is the most widely distributed true owl in the Americas."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414491 <http://eol.org/pages/914958>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414491 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=177884>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414491 langual:B4491)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414491 "bubo virginianus"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414491 "great horned owl"@en)
SubClassOf(obo:FOODON_03414491 obo:FOODON_03414490)
SubClassOf(obo:FOODON_03414491 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_56268))

# Class: obo:FOODON_03414493 (prairie turnip plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414493 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414493 "Psoralea esculenta (prairie turnip) is an herbaceous perennial plant native to prairies and dry woodlands of central North America, which bears a starchy tuberous root edible as a root vegetable. The plant is also known as *Pediomelum esculenta*. English names for the plant include tipsin, teepsenee, breadroot, breadroot scurf pea, and pomme blanche. The prairie turnip was a staple food of the Plains Indians."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414493 <http://eol.org/pages/4277>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414493 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?312047>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414493 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=504177>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414493 langual:B4493)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414493 "PLANTS:PEES")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414493 "breadroot"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414493 "pediomelum esculentum"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414493 "prairie turnip"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414493 "prairie-turnip"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03414493 "psoralea esculenta"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414493 "prairie turnip plant"@en)
SubClassOf(obo:FOODON_03414493 obo:FOODON_03411018)
SubClassOf(obo:FOODON_03414493 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_458363))

# Class: obo:FOODON_03414494 (knotweed family)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414494 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414494 "The *Polygonaceae* are a family of flowering plants known informally as the knotweed family or smartweed-buckwheat family in the United States. The name is based on the genus *Polygonum*, and was first used by Antoine Laurent de Jussieu in 1789 in his book, Genera Plantarum. The name refers to the many swollen nodes the stems of some species have. It is derived from Greek; poly means many and goni means knee or joint."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414494 "WIKIPEDIA:Polygonaceae")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414494 <http://eol.org/pages/4364>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414494 langual:B4494)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414494 "polygonaceae"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414494 "smartweed-buckwheat family"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414494 "knotweed family"@en)
SubClassOf(obo:FOODON_03414494 obo:FOODON_03411140)
SubClassOf(obo:FOODON_03414494 obo:FOODON_03413357)

# Class: obo:FOODON_03414495 (alaska wild rhubarb plant)

