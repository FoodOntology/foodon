AnnotationAssertion(go:hasSynonym obo:FOODON_03411364 "rheum spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411364 "rhubarb plant"@en)
SubClassOf(obo:FOODON_03411364 obo:FOODON_03414494)

