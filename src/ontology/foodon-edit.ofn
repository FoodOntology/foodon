AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41496 "CCPR:")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_41496 "PLANTS:CAOF")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_41496 "Calendula officinalis L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41496 "calendula"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41496 "calendula officinalis"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41496 "ruddles"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_41496 "scottish-marigold"@en)
