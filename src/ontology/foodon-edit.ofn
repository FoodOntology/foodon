AnnotationAssertion(go:hasSynonym obo:FOODON_03412496 "caelifera"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03412496 "grasshopper"@en)
SubClassOf(obo:FOODON_03412496 obo:FOODON_03411220)

