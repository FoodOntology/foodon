AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414321 "PLANTS:TRTU3")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03414321 "Triticum turanicum Jakubz.")
