AnnotationAssertion(go:hasDbXref obo:NCBITaxon_3559 "PLANTS:CHAL7")
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3559 "lamb's quarter"@en)
AnnotationAssertion(go:hasExactSynonym obo:NCBITaxon_3559 "lambsquarters"@en)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_3559 "Chenopodium album L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "chenopodium album"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "fat-hen"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "goosefoot, white"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "melde"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "pigweed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_3559 "white goosefoot"@en)
SubClassOf(obo:NCBITaxon_3559 obo:FOODON_03411566)
SubClassOf(obo:NCBITaxon_3559 obo:FOODON_03414745)

# Class: obo:NCBITaxon_355939 (Salsola soda)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_355939 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_355939 "*Salsola soda*, more commonly known in English as Opposite Leaved Saltwort, Oppositeleaf Russian Thistle, or Barilla Plant, is a small (to 0.7 m tall), annual, succulent shrub that is native to the Mediterranean Basin. It is a halophyte (a salt-tolerant plant) that typically grows in coastal regions and can be irrigated with salt water. The Italian name agretti is commonly used in English to refer to the edible leaves of *Salsola soda*."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_355939 "agretti plant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_355939 "WIKIPEDIA:Salsola_soda")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_355939 <http://eol.org/pages/485330>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_355939 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?32815>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_355939 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=504989>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_355939 langual:B4330)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_355939 "PLANTS:SASO3")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_355939 "Salsola soda L.")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_355939 "barilla plant"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_355939 "opposite leaved saltwort"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_355939 "oppositeleaf russian thistle"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_355939 "salsola soda"@en)
SubClassOf(obo:NCBITaxon_355939 obo:FOODON_03411566)

