AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03411267 "Mentha is a genus of plants in the family *Lamiaceae* (mint family). It is estimated that 13 to 18 species exist, and the exact distinction between species is still unclear. Hybridization between some of the species occurs naturally. The genus has a subcosmopolitan distribution across Europe, Africa, Asia, Australia, and North America. Mints are aromatic, almost exclusively perennial, rarely annual herbs. [https://en.wikipedia.org/wiki/Mentha]"@en)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411267 <http://eol.org/pages/4302>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411267 <http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?313210>)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411267 langual:B1267)
AnnotationAssertion(go:hasDbXref obo:FOODON_03411267 "PLANTS:MENTH")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411267 "Mentha")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411267 "Mentha L.")
AnnotationAssertion(go:hasNarrowSynonym obo:FOODON_03411267 "Mentha spp.")
AnnotationAssertion(go:hasSynonym obo:FOODON_03411267 "mentha spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411267 "mint plant"@en)
SubClassOf(obo:FOODON_03411267 obo:FOODON_03411179)

