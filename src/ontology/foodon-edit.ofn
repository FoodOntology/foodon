# Class: obo:NCBITaxon_8912 (Larus marinus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8912 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8912 "The great black-backed gull (*Larus marinus*), also known as the greater black-backed gull or, informally, as the black-back, is the largest member of the gull family. It breeds on the European and North American coasts and islands of the North Atlantic and is fairly sedentary, though some black-backs move farther south or inland to large lakes or reservoirs."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8912 "great black-backed gull"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8912 "WIKIPEDIA:Great_black-backed_gull")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8912 <http://eol.org/pages/1049577>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8912 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=176815>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8912 langual:B4570)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_8912 asfis:lvu)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_8912 "Larus marinus Linnaeus, 1758")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8912 "greater black-backed gull"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_8912 "larus marinus"@en)
SubClassOf(obo:NCBITaxon_8912 obo:FOODON_03413503)

# Class: obo:NCBITaxon_8915 (Larus fuscus)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_8915 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_8915 "The lesser black-backed gull (*Larus fuscus*) is a large gull that breeds on the Atlantic coasts of Europe. It is migratory, wintering from the British Isles south to West Africa. It is a regular winter visitor to the east coast of North America, probably from the breeding population in Iceland."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_8915 "lesser black-backed gull"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_8915 "WIKIPEDIA:Lesser_black-backed_gull")
