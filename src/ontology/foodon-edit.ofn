AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411236 langual:B1236)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411236 "meleagris spp."@en)
AnnotationAssertion(rdfs:label obo:FOODON_03411236 "turkey (bird)"@en)
