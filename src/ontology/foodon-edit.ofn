AnnotationAssertion(oboInOwl:hasExactSynonym obo:FOODON_03413715 "common sow-thistle")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413715 "annual sow thistle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413715 "common sow thistle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413715 "common sowthistle"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03413715 "hare's lettuce"@en)
