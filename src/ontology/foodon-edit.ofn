AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/FOODON_00003123> "Edible Uses:  Root - raw or cooked. A pleasant nutty taste. The root can also be dried and stored for later use. [https://pfaf.org/user/Plant.aspx?LatinName=Perideridia+oregana]"@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00003123> "2019-08-25T15:26:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00003123> "eppaw"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00003123> "oregon yampa plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00003123> <http://purl.obolibrary.org/obo/FOODON_03411018>)

