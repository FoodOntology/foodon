AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 langual:B4257)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 "PLANTS:CASA2")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 "PLANTS:CASAA")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90675 "PLANTS:CASAS2")
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_90675 "Camelina sativa (L.) Crantz")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_90675 "big-seed"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_90675 "camelina"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_90675 "camelina sativa"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_90675 "false flax"@en)
SubClassOf(obo:NCBITaxon_90675 obo:FOODON_03411017)

# Class: obo:NCBITaxon_90893 (Laminaria hyperborea)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_90893 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_90893 "*Laminaria hyperborea* is a species of large brown alga, a kelp in the family *Laminariaceae*, also known by the common names of tangle and cuvie. It is found in the sublittoral zone of the northern Atlantic Ocean. A variety, *Laminaria hyperborea* f. *cucullata* (P.Svensden & J.M.Kain, 1971) is known from more wave sheltered areas in Scandinavia."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_90893 "north european kelp"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_90893 "WIKIPEDIA:Laminaria_hyperborea")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90893 <http://eol.org/pages/921870>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90893 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=11230>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90893 langual:B4511)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_90893 asfis:lah)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_90893 "Laminaria hyperborea")
SubClassOf(obo:NCBITaxon_90893 obo:FOODON_03411744)

# Class: obo:NCBITaxon_9091 (Coturnix coturnix)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9091 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9091 "The Common Quail, *Coturnix coturnix*, is a small bird in the pheasant family *Phasianidae*. It is widespread and is found in parts of Europe, (should not be confused with the domesticated Japanese Quail, *Coturnix japonica*, original from Asia that although visually similar have very distinct calls)."@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9091 "common quail"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9091 "WIKIPEDIA:Common_Quail")
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9091 <http://eol.org/pages/914847>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9091 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=553871>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9091 langual:B4366)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9091 "Coturnix coturnix (Linnaeus, 1758)")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9091 "coturnix coturnix"@en)
SubClassOf(obo:NCBITaxon_9091 obo:FOODON_03411346)

# Class: obo:NCBITaxon_9101 (Meleagris ocellata)

AnnotationAssertion(obo:IAO_0000114 obo:NCBITaxon_9101 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:NCBITaxon_9101 "The ocellated turkey (Meleagris ocellata) is a species of turkey residing primarily in the Yucatán Peninsula. A relative of the wild turkey (Meleagris gallopavo), it was sometimes previously treated in a genus of its own (Agriocharis), but the differences between the two turkeys are currently considered too small to justify generic segregation."@en)
AnnotationAssertion(obo:IAO_0000117 obo:NCBITaxon_9101 "Damion Dooley"@en)
AnnotationAssertion(obo:IAO_0000118 obo:NCBITaxon_9101 "ocellated turkey"@en)
AnnotationAssertion(obo:IAO_0000119 obo:NCBITaxon_9101 wikipedia:Ocellated_turkey)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9101 <http://eol.org/pages/915307>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9101 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=553897>)
AnnotationAssertion(go:hasDbXref obo:NCBITaxon_9101 langual:B4167)
AnnotationAssertion(go:hasNarrowSynonym obo:NCBITaxon_9101 "Meleagris ocellata Cuvier, 1820")
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_9101 "meleagris ocellata"@en)
SubClassOf(obo:NCBITaxon_9101 obo:FOODON_03411236)

