AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414514 "false pak-choi"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414514 "flowering white cabbage"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414514 "mock pak-choi"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414514 "choy sum plant"@en)
SubClassOf(obo:FOODON_03414514 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03414514 obo:FOODON_03413372)

# Class: obo:FOODON_03414515 (tatsoi plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414515 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414515 "Tatsoi (*Brassica narinosa* or *Brassica rapa* var. *rosularis*), also called Spinach mustard, Spoon mustard, or Rosette bok choy, is an Asian variety of *Brassica rapa* grown for greens. This plant has become popular in North American cuisine as well, and is now grown throughout the world."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414515 "WIKIPEDIA:Tatsoi")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03414515 langual:B4515)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414515 "brassica narinosa"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414515 "brassica rapa var. rosularis"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414515 "spinach mustard"@en)
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414515 "spoon mustard"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414515 "tatsoi plant"@en)
SubClassOf(obo:FOODON_03414515 obo:FOODON_03411566)
SubClassOf(obo:FOODON_03414515 obo:FOODON_03413372)

# Class: obo:FOODON_03414516 (buttercup squash plant)

AnnotationAssertion(obo:IAO_0000114 obo:FOODON_03414516 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:FOODON_03414516 "Buttercup squash is one of the most common varieties of this winter squash, with a turban shape (a flattish top and dark green skin), weighing three to five pounds, and normally heavy with dense, yellow-orange flesh."@en)
AnnotationAssertion(obo:IAO_0000119 obo:FOODON_03414516 "WIKIPEDIA:Cucurbita_maxima")
