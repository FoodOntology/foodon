# Class: <http://purl.obolibrary.org/obo/FOODON_00002531> (cattle steer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002531> "A cattle steer is an adult castrated male of a cattle species."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/FOODON_00002531> "Damion Dooley")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/FOODON_00002531> "https://en.wikipedia.org/wiki/Cattle#Terminology"@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002531> "2019-02-22T23:48:25Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002531> "steer"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_00002531> "bull"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00002531> "A steer is a younger animal that may not be trained, or may not be strong and mature enough for hard work. In the United States a steer is not considered an ox until it is four years old, by which time it is considered large enough and mature enough for any work required of it.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002531> "cattle steer"@en)
