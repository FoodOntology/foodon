AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03414300 "trachurus novaezelandiae"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03414300 "yellowtail horse mackerel"@en)
SubClassOf(obo:FOODON_03414300 obo:FOODON_03411090)
SubClassOf(obo:FOODON_03414300 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_271942))

