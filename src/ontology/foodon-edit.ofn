AnnotationAssertion(go:hasSynonym obo:FOODON_03415110 "oryza sativa x oryza glaberrima"@en)
AnnotationAssertion(rdfs:label obo:FOODON_03415110 "Nerica rice plant"@en)
SubClassOf(obo:FOODON_03415110 obo:FOODON_03411322)

