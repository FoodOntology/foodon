AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03414625> <http://www.langual.org/langual_thesaurus.asp?termid=B4625>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03414625> "Elseya Gray, 1867")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03414625> "elseya"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03414625> "australian snapping turtle"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03414625> <http://purl.obolibrary.org/obo/FOODON_03411242>)

