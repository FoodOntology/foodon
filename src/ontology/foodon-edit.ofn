AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43171 "linaria vulgaris"@en)
AnnotationAssertion(go:hasSynonym obo:NCBITaxon_43171 "yellow toadflax"@en)
SubClassOf(obo:NCBITaxon_43171 obo:FOODON_03413359)

