AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411999 <http://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=26857>)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411999 langual:B1999)
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411999 "MANSFELD:27559")
AnnotationAssertion(oboInOwl:hasDbXref obo:FOODON_03411999 "PLANTS:PHVU")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411999 "Phaseolus vulgaris L.")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:FOODON_03411999 "Phaseolus vulgaris var. vulgaris")
AnnotationAssertion(oboInOwl:hasSynonym obo:FOODON_03411999 "phaseolus vulgaris"@en)
