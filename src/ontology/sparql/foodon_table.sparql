# To execute this sparql query which by default outputs a "temp.tsv" tab-
# delimited fileview of the ontology, go to the /src/ontology/ folder, and run
# the robot command line tool:
#
# > robot query --input foodon-full.owl --query sparql/foodon_tabule.sparql temp.tsv --format TSV

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX oboInOwl:  <http://www.geneontology.org/formats/oboInOwl#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?id ?parent_id ?type ?label
WHERE {

	# Enter ontology term identifier here to start report with:
	# obo:BFO_0000001 entity includes every term in ontology
	# obo:BFO_0000040 material entity, including chemical food components and food products
	# obo:ENVO_00010483  environmental material terms, including food materials
	# obo:FOODON_00002403 food material terms, including all food products and additives
	BIND (obo:BFO_0000040 as ?search).

	# Retrieve term and all subclass terms.
	?id rdfs:subClassOf* ?search.

	{
		# Retrieve one or more explicit parents of given entity
		{ 
			?id rdfs:subClassOf ?parent_id.
			# Ignore blank node parent (subclass axiom)
			FILTER (!isBlank(?parent_id)) 
		}

		# Retrieve entity's label(s). Might be multilingual.
		UNION { 
			?id rdfs:label ?label.
			BIND ('label' as ?type).
		}

		UNION {
			?id obo:IAO_0000118 ?label.
			BIND ('label (alternative)' as ?type).
		}

		#Retrieve taxon
		UNION {
			?id rdfs:subClassOf ?restriction.
			?restriction owl:onProperty obo:RO_0002162. # in taxon
			?restriction owl:someValuesFrom ?label.
			FILTER (!isBlank(?label)). # FUTURE: retrieve disjunctions of taxa
			BIND ('taxon' as ?type).
		}
	}
}
ORDER BY ?id ?type
